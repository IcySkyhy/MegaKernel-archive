private def gateEmbedding (dir : String) (stream : Cuda.Stream) : IO Unit := do
  let table ← uploadF32 dir "embed_table.512x256" (vocab * hidden) stream
  let ids ← uploadIds dir "embed_ids.8" rows stream
  let output ← allocF32 (rows * hidden)
  let gather ← embeddingGatherF32 stream table ids output rows32 hidden32
  gather.waitChecked "embed-gather-f32"
  checkExactF32 "embed-gather-f32" (← output.copyTo stream)
    (← loadFixture dir "embed_out.8x256" (rows * hidden)) (rows * hidden)
  let tableB ← uploadBF16 dir "embed_table.512x256" (vocab * hidden) stream
  let outputB ← allocBF16 (rows * hidden)
  let gatherB ← embeddingGatherBF16 stream tableB ids outputB rows32 hidden32
  gatherB.waitChecked "embed-gather-bf16"
  -- Exactness holds against the BF16-rounded oracle: gather copies survive the round trip.
  let expected ← loadFixture dir "embed_out.8x256" (rows * hidden)
  let mut rounded := ByteArray.emptyWithCapacity (rows * hidden * 4)
  for i in [:rows * hidden] do
    rounded := pushUInt32 rounded
      ((Cuda.BFloat16.ofFloat32 (readFloat32 expected i)).toFloat32.toBits)
  checkExactBF16 "embed-gather-bf16" (← outputB.copyTo stream) rounded (rows * hidden)

private def gateCast (dir : String) (stream : Cuda.Stream) : IO Unit := do
  let count := rows * hidden
  let x ← uploadF32 dir "cast_x.8x256" count stream
  let narrowed ← allocBF16 count
  let toBF16 ← castF32ToBF16 stream x narrowed count.toUInt32
  toBF16.waitChecked "cast-f32-to-bf16"
  checkExactBF16 "cast-f32-to-bf16" (← narrowed.copyTo stream)
    (← loadFixture dir "cast_bf16.8x256" count) count
  let widened ← allocF32 count
  let toF32 ← castBF16ToF32 stream narrowed widened count.toUInt32
  toF32.waitChecked "cast-bf16-to-f32"
  checkExactF32 "cast-bf16-to-f32" (← widened.copyTo stream)
    (← loadFixture dir "cast_bf16.8x256" count) count

private def fixtureDirectory : IO String := do
  let some directory ← IO.getEnv "QWEN36_PRIMITIVE_FIXTURES"
    | LeanTest.fail "QWEN36_PRIMITIVE_FIXTURES is required"
  return directory

@[test]
def allDevicePrimitivesMatchReference : IO Unit := do
  let dir ← fixtureDirectory
  let stream ← Cuda.Stream.default
  gateRmsNormF32 dir stream
  gateRmsNormBF16 dir stream
  gateGatedRmsNormF32 dir stream
  gateGatedRmsNormBF16 dir stream
  gateRope dir stream
  gateConv dir stream
  gateL2Norm dir stream
  gateSilu dir stream
  gateSwiglu dir stream
  gateEmbedding dir stream
  gateCast dir stream

end Qwen36PrimitivesGate
