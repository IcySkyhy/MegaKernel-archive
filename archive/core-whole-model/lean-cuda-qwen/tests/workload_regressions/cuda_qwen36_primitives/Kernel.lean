  forward.waitChecked "silu-fwd-f32"
  checkF32 "silu-fwd-f32 y" (← y.copyTo stream)
    (← loadFixture dir "silu_y.8x256" count) count 1e-5
  let dx ← allocF32 count
  let backward ← siluBackwardF32 stream x dy dx count.toUInt32
  backward.waitChecked "silu-bwd-f32"
  checkF32 "silu-bwd-f32 dx" (← dx.copyTo stream)
