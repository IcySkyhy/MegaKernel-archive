private def gateRope (dir : String) (stream : Cuda.Stream) : IO Unit := do
  let invFreq ← allocF32 rotaryHalf
  let table ← ropeInvFreq stream invFreq rotaryHalf.toUInt32 rotaryDim.toUInt32 theta
  table.waitChecked "rope-invfreq"
  checkF32 "rope-invfreq" (← invFreq.copyTo stream)
    (← loadFixture dir "rope_invfreq.8" rotaryHalf) rotaryHalf 1e-5
  let q ← uploadF32 dir "rope_q.4x64" (heads * headDim) stream
  let k ← uploadF32 dir "rope_k.4x64" (heads * headDim) stream
  let qOut ← allocF32 (heads * headDim)
  let kOut ← allocF32 (heads * headDim)
  let forward ← ropeApplyForwardF32 stream q k invFreq qOut kOut heads32 headDim32
    rotaryHalf.toUInt32 ropePosition
  forward.waitChecked "rope-apply-fwd-f32"
  checkF32 "rope-apply-fwd-f32 q" (← qOut.copyTo stream)
    (← loadFixture dir "rope_q_out.4x64" (heads * headDim)) (heads * headDim) 1e-5
  checkF32 "rope-apply-fwd-f32 k" (← kOut.copyTo stream)
    (← loadFixture dir "rope_k_out.4x64" (heads * headDim)) (heads * headDim) 1e-5
  let dq ← uploadF32 dir "rope_dq.4x64" (heads * headDim) stream
  let dk ← uploadF32 dir "rope_dk.4x64" (heads * headDim) stream
  let dqPre ← allocF32 (heads * headDim)
  let dkPre ← allocF32 (heads * headDim)
  let backward ← ropeApplyBackwardF32 stream dq dk invFreq dqPre dkPre heads32
    headDim32 rotaryHalf.toUInt32 ropePosition
  backward.waitChecked "rope-apply-bwd-f32"
  checkF32 "rope-apply-bwd-f32 dq" (← dqPre.copyTo stream)
    (← loadFixture dir "rope_dq_pre.4x64" (heads * headDim)) (heads * headDim) 1e-5
  checkF32 "rope-apply-bwd-f32 dk" (← dkPre.copyTo stream)
    (← loadFixture dir "rope_dk_pre.4x64" (heads * headDim)) (heads * headDim) 1e-5

private def gateConv (dir : String) (stream : Cuda.Stream) : IO Unit := do
  let x ← uploadF32 dir "conv_x.8x256" (seqLen * hidden) stream
  let weight ← uploadF32 dir "conv_w.256x4" (hidden * 4) stream
  let dy ← uploadF32 dir "conv_dy.8x256" (seqLen * hidden) stream
  let output ← allocF32 (seqLen * hidden)
  let forward ← conv1dSiLUForwardF32 stream x weight output seqLen32 hidden32
  forward.waitChecked "conv-fwd-f32"
  checkF32 "conv-fwd-f32 y" (← output.copyTo stream)
    (← loadFixture dir "conv_y.8x256" (seqLen * hidden)) (seqLen * hidden) 1e-5
  let dx ← allocF32 (seqLen * hidden)
  let dw ← allocF32 (hidden * 4)
  let backInput ← conv1dSiLUBackwardInputF32 stream x weight dy dx seqLen32 hidden32
  backInput.waitChecked "conv-bwd-input-f32"
  let backWeight ← conv1dSiLUBackwardWeightF32 stream x weight dy dw seqLen32 hidden32
  backWeight.waitChecked "conv-bwd-weight-f32"
  checkF32 "conv-bwd-f32 dx" (← dx.copyTo stream)
    (← loadFixture dir "conv_dx.8x256" (seqLen * hidden)) (seqLen * hidden) 1e-5
  checkF32 "conv-bwd-f32 dw" (← dw.copyTo stream)
    (← loadFixture dir "conv_dw.256x4" (hidden * 4)) (hidden * 4) 1e-5
  let state ← uploadF32 dir "conv_state.3x256" (3 * hidden) stream
  let xt ← uploadF32 dir "conv_xt.256" hidden stream
  let yt ← allocF32 hidden
  let stateOut ← allocF32 (3 * hidden)
  let decodeFwd ← conv1dSiLUDecodeForwardF32 stream state xt weight yt stateOut
    hidden32
  decodeFwd.waitChecked "conv-decode-fwd-f32"
  checkF32 "conv-decode-fwd-f32 yt" (← yt.copyTo stream)
    (← loadFixture dir "conv_yt.256" hidden) hidden 1e-5
  checkF32 "conv-decode-fwd-f32 state" (← stateOut.copyTo stream)
    (← loadFixture dir "conv_state_out.3x256" (3 * hidden)) (3 * hidden) 1e-5
  -- The decode step at t = seq - 1 must reproduce the final full-sequence row.
  let fullY ← loadFixture dir "conv_y.8x256" (seqLen * hidden)
  let mut tail := ByteArray.emptyWithCapacity (hidden * 4)
  for i in [:hidden] do
    tail := pushUInt32 tail (readFloat32 fullY ((seqLen - 1) * hidden + i)).toBits
  checkF32 "conv-decode-vs-full yt" (← yt.copyTo stream) tail hidden 1e-5
  let dyt ← uploadF32 dir "conv_dyt.256" hidden stream
  let dxt ← allocF32 hidden
  let dstate ← allocF32 (3 * hidden)
  let dwStep ← allocF32 (hidden * 4)
  let decodeBwd ← conv1dSiLUDecodeBackwardF32 stream state xt weight dyt dxt dstate
    dwStep hidden32
  decodeBwd.waitChecked "conv-decode-bwd-f32"
  checkF32 "conv-decode-bwd-f32 dxt" (← dxt.copyTo stream)
    (← loadFixture dir "conv_dxt.256" hidden) hidden 1e-5
  checkF32 "conv-decode-bwd-f32 dstate" (← dstate.copyTo stream)
    (← loadFixture dir "conv_dstate.3x256" (3 * hidden)) (3 * hidden) 1e-5
  checkF32 "conv-decode-bwd-f32 dw-step" (← dwStep.copyTo stream)
    (← loadFixture dir "conv_dw_step.256x4" (hidden * 4)) (hidden * 4) 1e-5

