import LeanTest
import Cuda

/-!
# Qwen3.6 device-primitive gates vs NumPy fixtures

Drives every kernel of `LeanCudaQwen.Qwen36.Primitives` against the checked-in fixtures of
`fixtures/` (generated by `gen_fixtures.py`, tiny configuration: hidden 256, head 64, rotary 16,
seq 8). FP32 gates require max abs err ≤ 1e-5; BF16-storage gates require relative L2 ≤ 2e-2
against the same FP32 oracle; gathers and casts are bit-exact. The conv decode step is
additionally cross-checked against the final row of the full-sequence gate.

Invocation: `cuda_qwen36_primitives_test <fixtures-dir>`.
-/

namespace Qwen36PrimitivesGate

open Cuda.Qwen36.Primitives

private def rows : Nat := 8
private def hidden : Nat := 256
private def headDim : Nat := 64
private def heads : Nat := 4
private def rotaryHalf : Nat := 8
private def rotaryDim : Nat := 16
private def seqLen : Nat := 8
private def vocab : Nat := 512

private def rows32 : UInt32 := 8
private def hidden32 : UInt32 := 256
private def headDim32 : UInt32 := 64
private def heads32 : UInt32 := 4
private def seqLen32 : UInt32 := 8
private def eps : Float32 := 1e-6
private def theta : Float32 := 1e7
private def ropePosition : Float32 := 5

private def pushUInt16 (bytes : ByteArray) (value : UInt16) : ByteArray :=
  (bytes.push value.toUInt8).push (value >>> 8).toUInt8

private def pushUInt32 (bytes : ByteArray) (value : UInt32) : ByteArray :=
  (((bytes.push value.toUInt8).push (value >>> 8).toUInt8).push
    (value >>> 16).toUInt8).push (value >>> 24).toUInt8

private def readUInt16 (bytes : ByteArray) (index : Nat) : UInt16 :=
  let offset := index * 2
  bytes[offset]!.toUInt16 ||| (bytes[offset + 1]!.toUInt16 <<< 8)

private def readFloat32 (bytes : ByteArray) (index : Nat) : Float32 :=
  let offset := index * 4
  Float32.ofBits <| bytes[offset]!.toUInt32 |||
    (bytes[offset + 1]!.toUInt32 <<< 8) |||
    (bytes[offset + 2]!.toUInt32 <<< 16) ||| (bytes[offset + 3]!.toUInt32 <<< 24)

private def loadFixture (dir : String) (name : String) (count : Nat) : IO ByteArray := do
  let bytes ← IO.FS.readBinFile (dir ++ "/" ++ name ++ ".f32.bin")
  unless bytes.size == count * 4 do
    throw <| IO.userError s!"fixture {name}: expected {count * 4} bytes, found {bytes.size}"
  return bytes

private def allocF32 (count : Nat) : IO (Cuda.Buffer Float32) :=
  Cuda.Buffer.alloc Float32 count.toUSize

private def allocBF16 (count : Nat) : IO (Cuda.Buffer Cuda.BFloat16) :=
  Cuda.Buffer.alloc Cuda.BFloat16 count.toUSize

private def uploadF32 (dir : String) (name : String) (count : Nat) (stream : Cuda.Stream) :
    IO (Cuda.Buffer Float32) := do
  let bytes ← loadFixture dir name count
  let buffer ← allocF32 count
  buffer.copyFrom bytes stream
  return buffer

private def uploadBF16 (dir : String) (name : String) (count : Nat) (stream : Cuda.Stream) :
    IO (Cuda.Buffer Cuda.BFloat16) := do
  let bytes ← loadFixture dir name count
  let mut packed := ByteArray.emptyWithCapacity (count * 2)
  for i in [:count] do
    packed := pushUInt16 packed (Cuda.BFloat16.ofFloat32 (readFloat32 bytes i)).bits
  let buffer ← allocBF16 count
  buffer.copyFrom packed stream
  return buffer

private def uploadIds (dir : String) (name : String) (count : Nat) (stream : Cuda.Stream) :
    IO (Cuda.Buffer UInt32) := do
  let bytes ← loadFixture dir name count
  let mut packed := ByteArray.emptyWithCapacity (count * 4)
  for i in [:count] do
    packed := pushUInt32 packed (readFloat32 bytes i).toUInt32
  let buffer ← Cuda.Buffer.alloc UInt32 count.toUSize
  buffer.copyFrom packed stream
  return buffer

/-- Max-abs-err comparison for FP32 tensors against the oracle. -/
private def checkF32 (label : String) (actual expected : ByteArray) (count : Nat)
    (tol : Float32) : IO Unit := do
  let mut worst : Float32 := 0
  let mut worstAt : Nat := 0
  for i in [:count] do
    let err := Float32.abs (readFloat32 actual i - readFloat32 expected i)
    if err > worst then
      worst := err
      worstAt := i
  unless worst ≤ tol do
    LeanTest.fail (s!"{label}: max abs err {worst} at {worstAt} exceeds {tol} " ++
      s!"(actual {readFloat32 actual worstAt}, expected {readFloat32 expected worstAt})")

/-- Relative-L2 comparison for FP32 tensors (used for row scalars of BF16 runs). -/
private def checkRelL2F32 (label : String) (actual expected : ByteArray) (count : Nat)
    (tol : Float32) : IO Unit := do
  let mut num : Float32 := 0
  let mut den : Float32 := 0
  for i in [:count] do
    let d := readFloat32 actual i - readFloat32 expected i
    let e := readFloat32 expected i
    num := num + d * d
    den := den + e * e
  let rel := Float32.sqrt (num / den)
  unless rel ≤ tol do
    LeanTest.fail s!"{label}: rel L2 {rel} exceeds {tol}"

/-- Relative-L2 comparison for BF16 tensors against the FP32 oracle. -/
private def checkRelL2BF16 (label : String) (actual expected : ByteArray) (count : Nat)
    (tol : Float32) : IO Unit := do
  let mut num : Float32 := 0
  let mut den : Float32 := 0
  for i in [:count] do
    let a := (BFloat16.ofBits (readUInt16 actual i)).toFloat32
    let e := readFloat32 expected i
    num := num + (a - e) * (a - e)
    den := den + e * e
  let rel := Float32.sqrt (num / den)
  unless rel ≤ tol do
    LeanTest.fail s!"{label}: rel L2 {rel} exceeds {tol}"

/-- Bit-exact comparison for FP32 tensors (copies and exact widenings). -/
private def checkExactF32 (label : String) (actual expected : ByteArray) (count : Nat) :
    IO Unit := do
  for i in [:count] do
    unless (readFloat32 actual i).toBits == (readFloat32 expected i).toBits do
      LeanTest.fail (s!"{label}: mismatch at {i} " ++
        s!"(actual {readFloat32 actual i}, expected {readFloat32 expected i})")

/-- Exact comparison for BF16 tensors via their FP32 images. -/
private def checkExactBF16 (label : String) (actual expected : ByteArray) (count : Nat) :
    IO Unit := do
  for i in [:count] do
    let a := (BFloat16.ofBits (readUInt16 actual i)).toFloat32
    unless a.toBits == (readFloat32 expected i).toBits do
      LeanTest.fail (s!"{label}: mismatch at {i} " ++
        s!"(actual {a}, expected {readFloat32 expected i})")

private def gateRmsNormF32 (dir : String) (stream : Cuda.Stream) : IO Unit := do
  let x ← uploadF32 dir "rms_x.8x256" (rows * hidden) stream
  let weight ← uploadF32 dir "rms_w.256" hidden stream
  let dy ← uploadF32 dir "rms_dy.8x256" (rows * hidden) stream
  let output ← allocF32 (rows * hidden)
  let inverseRms ← allocF32 rows
  let handle ← rmsNormForwardF32 stream x weight output inverseRms rows32 hidden32 eps
  handle.waitChecked "rmsnorm-fwd-f32"
  checkF32 "rmsnorm-fwd-f32 y" (← output.copyTo stream)
    (← loadFixture dir "rms_y.8x256" (rows * hidden)) (rows * hidden) 1e-5
  checkF32 "rmsnorm-fwd-f32 inv" (← inverseRms.copyTo stream)
    (← loadFixture dir "rms_inv.8" rows) rows 1e-5
  let dx ← allocF32 (rows * hidden)
  let dw ← allocF32 hidden
  let backInput ← rmsNormBackwardInputF32 stream x weight dy dx inverseRms rows32
    hidden32
  backInput.waitChecked "rmsnorm-bwd-input-f32"
  let backWeight ← rmsNormBackwardWeightF32 stream x dy inverseRms dw rows32 hidden32
  backWeight.waitChecked "rmsnorm-bwd-weight-f32"
  checkF32 "rmsnorm-bwd-f32 dx" (← dx.copyTo stream)
    (← loadFixture dir "rms_dx.8x256" (rows * hidden)) (rows * hidden) 1e-5
  checkF32 "rmsnorm-bwd-f32 dw" (← dw.copyTo stream)
    (← loadFixture dir "rms_dw.256" hidden) hidden 1e-5

private def gateRmsNormBF16 (dir : String) (stream : Cuda.Stream) : IO Unit := do
  let x ← uploadBF16 dir "rms_x.8x256" (rows * hidden) stream
  let weight ← uploadBF16 dir "rms_w.256" hidden stream
  let dy ← uploadBF16 dir "rms_dy.8x256" (rows * hidden) stream
  let output ← allocBF16 (rows * hidden)
  let inverseRms ← allocF32 rows
  let handle ← rmsNormForwardBF16 stream x weight output inverseRms rows32 hidden32
    eps
  handle.waitChecked "rmsnorm-fwd-bf16"
  checkRelL2BF16 "rmsnorm-fwd-bf16 y" (← output.copyTo stream)
    (← loadFixture dir "rms_y.8x256" (rows * hidden)) (rows * hidden) 2e-2
  checkRelL2F32 "rmsnorm-fwd-bf16 inv" (← inverseRms.copyTo stream)
    (← loadFixture dir "rms_inv.8" rows) rows 2e-2
  let dx ← allocBF16 (rows * hidden)
  let dw ← allocBF16 hidden
  let backInput ← rmsNormBackwardInputBF16 stream x weight dy dx inverseRms rows32
    hidden32
  backInput.waitChecked "rmsnorm-bwd-input-bf16"
  let backWeight ← rmsNormBackwardWeightBF16 stream x dy inverseRms dw rows32 hidden32
  backWeight.waitChecked "rmsnorm-bwd-weight-bf16"
  checkRelL2BF16 "rmsnorm-bwd-bf16 dx" (← dx.copyTo stream)
    (← loadFixture dir "rms_dx.8x256" (rows * hidden)) (rows * hidden) 2e-2
  checkRelL2BF16 "rmsnorm-bwd-bf16 dw" (← dw.copyTo stream)
    (← loadFixture dir "rms_dw.256" hidden) hidden 2e-2

