/**
 * m12_rmsnorm_gated.asc —— Mega kernel M12：GDN 输出 RMSNormGated（纯 AIV 核）
 *
 * vllm 语义（逐字段对齐，证据链）：
 *   qwen_gdn_linear_attn.py:486-497  self.norm = RMSNormGated(head_v_dim, eps=
 *     config.rms_norm_eps, group_size=None, norm_before_gate=True, activation=
 *     config.output_gate_type)   # 本模型 config.json:105 = "sigmoid"
 *   qwen_gdn_linear_attn.py:855    core_attn_out = self.norm(core_attn_out, z)
 *     调用点形状：o [m,48,128]、z [m,48,128]（z  reshape 自 in_proj bf16 段）
 *   layernorm.py:216-317 forward_static（group_size=None 路径）：
 *     x=z? 否——norm_before_gate=True：先 norm(x) 后乘 gate；
 *     variance = x.pow(2).mean(dim=-1)     # dim=-1 = head_v_dim = 128，
 *                                            即 per-head（48 组）norm，非整行 6144
 *     x_normed = x * rsqrt(variance + eps) # eps 先进 rsqrt（base.py:38 eps=rms_norm_eps，
 *                                            config.json:114 = 1e-6）
 *     out      = x_normed * weight         # weight [128]，48 头共享
 *     out      = out * sigmoid(z)          # act=sigmoid
 *     return out.to(orig_dtype)            # 出口 bf16（RNE）
 *   vllm-ascend ops/layernorm.py 的 RMSNormGated 直接复用上述 native 实现，语义一致。
 *
 * 本核输入契约（mega kernel GDN 链：m4 递推出口 o 为 fp32，z 为 in_proj bf16 段）：
 *     o     fp32 [m, 6144]（m 运行时逐行循环，无编译期上界；设备实测档见 README）
 *     z     bf16 [m, 6144]
 *     gamma bf16 [128]（vllm norm.weight 形状，48 头共享）
 *     out   bf16 [m, 6144] = bf16( ((o·rstd)·gamma) · sigmoid(z) )，RNE
 *   每行 48 个 head 各自 128 维 RMSNorm（vllm dim=-1），fp32 全程。
 *
 * donor：m6_rmsnorm/（main 已合并）——NormDonor 积木（norm_common
 *   reduce_common_regbase*.h 的 RegBase lift：CalculateSquareReduceSum 三分支 +
 *   ComputeRstdNewtonRaphson NR rsqrt）逐字复用；门控 sigmoid 用 m5_swiglu_quant
 *   实证排布（Muls(-1)/Exp/Adds(+1)/Div）。donor 被禁点仅 wrapper 的 TPipe/TQue
 *   （EnQue/DeQue → BufferID）；本工程同样只用 BufferID（GetBufInternal/
 *   RlsBufInternal，release 用阻塞释放 mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK），
 *   不用 set_flag/wait_flag。
 *
 * 数据通路（全部基础 API，无 TPipe / TBuf / TQue / AllocTensor / 高阶 API）：
 *   GM --DataCopy(MTE2, 显式 DataCopyParams)--> UB(o 行 fp32 / z 行 bf16)
 *   UB(o) --Reg 二分 fold 平方和(128/head)--> UB(sumSq) --NR rsqrt--> UB(rstd)
 *   UB(o,rstd,gammaF32,z) --Reg Mul/Exp/Div/Cast--> UB(out bf16)
 *   UB --DataCopy(MTE3, 显式 DataCopyParams)--> GM(out)
 *
 * 3510 quirk 遵守（docs/05 §6）：
 *   - AIV-only 核必须 __vector__ __global__；
 *   - 一律显式 DataCopyParams（M16 实测元素计数重载栈垃圾未初始化；blockCount=1
 *     规避 NZ 重排）；UB 偏移全 32B 对齐（M9 实测非对齐 UB→GM DataCopy 异常）；
 *   - 无相邻 Cast（M10 实测连续 Cast 错乱）：每 chunk 仅 bf16→fp32 一次（z）+
 *     fp32→bf16 一次（out），之间隔 sigmoid/乘法序列；gamma 预转 fp32 的各次
 *     Cast 之间隔 StoreAlign+LoadAlign；
 *   - Reg LoadAlign 地址 32B 对齐（M16）：rstd 恒在 UB 偏移 0（per-head 流水，
 *     与 m6 实证排布一致），DIST_BRC_B32 广播。
 *   - LocalMemBar 仅在 donor Common 分支内（__VEC_SCOPE__ 中）；本核 128/head
 *     走 LessThanTwoVL 分支，无 LocalMemBar。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cmath>

// ============================================================
// 编译期常量与静态资源表（UB 偏移 / BufferID 全部编译期静态分配）
// ============================================================

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t HEADS = 48;            // value head 数（num_v_heads）
constexpr uint32_t HEAD = 128;            // head_v_dim：RMSNorm 维度（vllm dim=-1）
constexpr uint32_t HIDDEN = HEADS * HEAD; // 6144
constexpr uint32_t VL_F32 = 64;           // 256B 向量寄存器 fp32 lane 数（donor V_LENGTH）
constexpr uint16_t CHUNK_PER_HEAD = HEAD / VL_F32;  // 每 head 64-lane chunk 数 = 2（无尾块）
constexpr float EPS = 1e-6f;              // RMSNormGated eps = config.rms_norm_eps
constexpr float AVG_FACTOR = 1.0f / static_cast<float>(HEAD);  // mean = sum/128（2 的幂，精确）
constexpr uint32_t FOLD_POINT = HEAD / 2; // 二分 fold 点（Common 分支用；本核走 LessThanTwoVL）
constexpr uint32_t REDUCE_TMP_STRIDE = 24;  // ceil(foldLoops/BLK_B32)*8（Common 分支用）

// ---- UB 静态布局（字节偏移；VECCALC 空间 248KB 内；偏移 32B 对齐，供 DataCopy）----
constexpr uint32_t UB_O = 0;                        // fp32 [6144] = 24576B（o 行）
constexpr uint32_t UB_Z = UB_O + 4 * HIDDEN;        // bf16 [6144] = 12288B（z 行）
constexpr uint32_t UB_Y = UB_Z + 2 * HIDDEN;        // bf16 [6144] = 12288B（out 行）
constexpr uint32_t UB_GB = UB_Y + 2 * HIDDEN;       // bf16 [128] = 256B（gamma 原始）
constexpr uint32_t UB_GF = UB_GB + 256;             // fp32 [128] = 512B（gamma 预转 fp32）
constexpr uint32_t UB_TMP = UB_GF + 512;            // fp32 [64] = 256B（reduce 二分 partials，备用）
constexpr uint32_t UB_RED = UB_TMP + 256;           // fp32 [64] = 256B（每 head sumSq）
constexpr uint32_t UB_RSTD = UB_RED + 256;          // fp32 [64] = 256B（每 head rstd）
static_assert(UB_RSTD + 256 <= 248 * 1024, "UB footprint exceeds 248KB");

// ---- BufferID（每核用户可用 0-27，静态分配）----
constexpr AscendC::MutexID BUF_X = 0;    // o/z 行: MTE2 -> V
constexpr AscendC::MutexID BUF_OUT = 1;  // out 行: V -> MTE3
constexpr AscendC::MutexID BUF_G = 2;    // gamma: MTE2 -> V（kernel 开头一次）

// BufferID 语义封装：acquire 立即获取；release 用阻塞模式（mode=false = CANN 默认
// ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射访存落地，对跨 pipe 消费者可见。
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// ============================================================
// Donor 计算核心 lift（与 m6_rmsnorm 同一来源：ops-nn norm/norm_common/
// op_kernel/reduce_common_regbase*.h，arch35 add_rms_norm_regbase.h 的 RegBase
// 函数；裸指针 __ubuf__，无 TPipe/TQue；已适配 CANN 9.1.0 Reg API 原样保留）
// ============================================================

namespace NormDonor {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t V_LENGTH = VL_F32;  // donor V_LENGTH（256B/4B）
constexpr uint16_t DICHOTOMY_ADD_COEFF = 2;

constexpr AscendC::Reg::CastTrait castTraitB162B32 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::UNKNOWN,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::UNKNOWN};
constexpr AscendC::Reg::CastTrait castTraitB322B16 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::NO_SAT,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::CAST_RINT};

template <typename T, LoadDist FLOAT_LOAD_DIST = LoadDist::DIST_NORM,
          LoadDist NON_FLOAT_LOAD_DIST = LoadDist::DIST_UNPACK_B16>
__aicore__ inline void LoadRegForDtype(__ubuf__ T* src, RegTensor<float>& dst, MaskReg& preg, uint32_t offset)
{
    if constexpr (IsSameType<T, float>::value) {
        LoadAlign<T, FLOAT_LOAD_DIST>(dst, src + offset);
    } else {
        RegTensor<T> srcReg;
        LoadAlign<T, NON_FLOAT_LOAD_DIST>(srcReg, src + offset);
        Cast<float, T, castTraitB162B32>(dst, srcReg, preg);
    }
}

template <typename T, StoreDist FLOAT_STORE_DIST = StoreDist::DIST_NORM,
          StoreDist NON_FLOAT_STORE_DIST = StoreDist::DIST_PACK_B32>
__aicore__ inline void StoreRegForDtype(__ubuf__ T* dst, RegTensor<float>& src, MaskReg& preg, uint32_t offset)
{
    if constexpr (IsSameType<T, float>::value) {
        StoreAlign<T, FLOAT_STORE_DIST>(dst + offset, src, preg);
    } else {
        RegTensor<T> dstReg;
        Cast<T, float, castTraitB322B16>(dstReg, src, preg);
        StoreAlign<T, NON_FLOAT_STORE_DIST>(dst + offset, dstReg, preg);
    }
}

// ---- 平方和二分 fold（reduce_common_regbase_part2.h，float 输入路径逐字 lift）----

template <typename T>
__aicore__ inline void CalculateSquareReduceSumLessThanVL(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                          uint16_t rows, uint32_t rowStride, uint32_t reduceNum)
{
    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> sumReg;
        MaskReg pregLoop = UpdateMask<float>(reduceNum);
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        for (uint16_t i = 0; i < rows; ++i) {
            LoadRegForDtype<T>(xPtr, xReg, pregLoop, static_cast<uint32_t>(i) * rowStride);
            Mul(xReg, xReg, xReg, pregLoop);
            Reduce<ReduceType::SUM>(sumReg, xReg, pregLoop);
            StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, sumReg, pregOne);
        }
    }
}

template <typename T>
__aicore__ inline void CalculateSquareReduceSumLessThanTwoVL(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                             uint16_t rows, uint32_t rowStride,
                                                             uint32_t reduceNum)
{
    uint32_t tailLen = reduceNum - V_LENGTH;
    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> xFoldReg;
        RegTensor<float> sumReg;
        RegTensor<float> reduceReg;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        MaskReg pregTail = UpdateMask<float>(tailLen);
        for (uint16_t i = 0; i < rows; ++i) {
            uint32_t baseOffset = static_cast<uint32_t>(i) * rowStride;
            LoadRegForDtype<T>(xPtr, xReg, pregFull, baseOffset);
            LoadRegForDtype<T>(xPtr + V_LENGTH, xFoldReg, pregTail, baseOffset);
            Mul(xReg, xReg, xReg, pregFull);
            Mul(xFoldReg, xFoldReg, xFoldReg, pregTail);
            ShiftLefts((RegTensor<uint32_t>&)xFoldReg, (RegTensor<uint32_t>&)xFoldReg, static_cast<int16_t>(0),
                       pregTail);
            Add(sumReg, xReg, xFoldReg, pregFull);
            Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
            StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
        }
    }
}

template <typename T, int32_t LAST_LOOP_NUMS>
__aicore__ inline void CalculateSquareReduceSumCommon(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                      __ubuf__ float* tmpPtr, uint16_t rows, uint32_t rowStride,
                                                      uint32_t reduceNum, uint32_t foldPoint, uint32_t tmpStride)
{
    uint16_t foldLoops = static_cast<uint16_t>((foldPoint + V_LENGTH - 1) / V_LENGTH);
    uint32_t lastNum = foldPoint / V_LENGTH;
    uint32_t tail = (reduceNum > foldPoint) ? reduceNum - foldPoint : 0;
    uint16_t tailCeilLoops = static_cast<uint16_t>((tail + V_LENGTH - 1) / V_LENGTH);
    uint16_t firstFlodWithOutAddLoops = static_cast<uint16_t>(foldLoops - tailCeilLoops);

    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> xFoldReg;
        RegTensor<float> sumReg;
        RegTensor<float> reduceReg;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        MaskReg pregLoop;

        for (uint16_t i = 0; i < rows; ++i) {
            uint32_t baseOffset = static_cast<uint32_t>(i) * rowStride;
            uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
            uint32_t sregTail = tail;
            for (uint16_t j = 0; j < tailCeilLoops; ++j) {
                pregLoop = UpdateMask<float>(sregTail);
                uint32_t offset = static_cast<uint32_t>(j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                LoadRegForDtype<T>(xPtr + foldPoint, xFoldReg, pregFull, offset);
                Mul(xFoldReg, xFoldReg, xFoldReg, pregLoop);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + j, reduceReg, pregOne);
            }
            for (uint16_t j = 0; j < firstFlodWithOutAddLoops; ++j) {
                uint32_t offset = static_cast<uint32_t>(tailCeilLoops + j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + tailCeilLoops + j,
                                                                     reduceReg, pregOne);
            }
        }
        LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        if constexpr (LAST_LOOP_NUMS == 1) {
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                LoadAlign<float>(xReg, tmpPtr + static_cast<uint32_t>(i) * tmpStride);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregLast);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        } else if constexpr (LAST_LOOP_NUMS == DICHOTOMY_ADD_COEFF) {
            lastNum -= V_LENGTH;
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
                LoadAlign<float>(xReg, tmpPtr + tmpOffset);
                LoadAlign<float>(xFoldReg, tmpPtr + tmpOffset + V_LENGTH);
                ShiftLefts((RegTensor<uint32_t>&)xFoldReg, (RegTensor<uint32_t>&)xFoldReg, static_cast<int16_t>(0),
                           pregLast);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        }
    }
}

template <typename T>
// Squares input values inside this function, then reduces each row.
__aicore__ inline void CalculateSquareReduceSum(__ubuf__ T* xPtr, __ubuf__ float* dstPtr, __ubuf__ float* tmpPtr,
                                                uint16_t rows, uint32_t rowStride, uint32_t reduceNum,
                                                uint32_t foldPoint, uint32_t tmpStride, uint32_t branchNum = 0)
{
    uint32_t reduceBranchNum = branchNum == 0 ? reduceNum : branchNum;
    if (reduceBranchNum <= V_LENGTH) {
        CalculateSquareReduceSumLessThanVL<T>(xPtr, dstPtr, rows, rowStride, reduceNum);
    } else if (reduceBranchNum <= V_LENGTH + V_LENGTH) {
        CalculateSquareReduceSumLessThanTwoVL<T>(xPtr, dstPtr, rows, rowStride, reduceNum);
    } else if (reduceBranchNum <= V_LENGTH * V_LENGTH * DICHOTOMY_ADD_COEFF) {
        CalculateSquareReduceSumCommon<T, 1>(xPtr, dstPtr, tmpPtr, rows, rowStride, reduceNum, foldPoint, tmpStride);
    } else {
        CalculateSquareReduceSumCommon<T, DICHOTOMY_ADD_COEFF>(xPtr, dstPtr, tmpPtr, rows, rowStride, reduceNum,
                                                               foldPoint, tmpStride);
    }
}

// ---- NR rsqrt（reduce_common_regbase_part1.h，逐字 lift，Mula→Mul+Add）----

template <bool NEED_MAX = true>
__aicore__ inline void ComputeRstdNewtonRaphsonReg(RegTensor<float>& var, RegTensor<float>& rstd, MaskReg& preg,
                                                   float epsilon)
{
    static constexpr float POS_INF = 3.40282366920938E+38;
    static constexpr float SCALAR1 = -0.5;
    static constexpr float SCALAR2 = 1.5;
    static constexpr float SCALAR3 = 0.5;
    static constexpr float SCALAR0 = -99.99;

    RegTensor<float> r;
    RegTensor<float> y;
    RegTensor<float> s;
    RegTensor<float> t;
    RegTensor<float> one;
    RegTensor<float> scalar1;
    RegTensor<float> t1;
    RegTensor<float> t3;
    RegTensor<float> t4;
    RegTensor<float> scalarInf;
    RegTensor<float> scalarZero;
    RegTensor<float> tmp;
    MaskReg cmpRegZero;
    MaskReg cmpRegInf;

    Duplicate(scalarInf, POS_INF, preg);
    Duplicate(scalarZero, float(0.0), preg);
    Duplicate(one, float(1.0), preg);
    Duplicate(scalar1, SCALAR3, preg);
    Duplicate(t1, SCALAR2, preg);
    Duplicate(s, float(1.0), preg);

    Adds(var, var, epsilon, preg);
    if constexpr (NEED_MAX) {
        Maxs(var, var, SCALAR0, preg);
    }
    Div(r, one, var, preg);
    Sqrt(y, r, preg);
    Muls(t, var, SCALAR1, preg);
    Mul(t, t, y, preg);
    Mul(tmp, t, y, preg);
    Add(t1, t1, tmp, preg);   // t1 = 1.5 + t*y（donor Mula）
    Mul(rstd, y, t1, preg);
    Muls(t3, var, float(-1.0), preg);
    Mul(tmp, t3, r, preg);
    Add(s, s, tmp, preg);     // s = 1 + (-var)*r（donor Mula）
    Muls(t4, rstd, float(-1.0), preg);
    Mul(tmp, t4, rstd, preg);
    Add(r, r, tmp, preg);     // r = r + (-rstd)*rstd（donor Mula）
    Mul(tmp, var, r, preg);
    Add(s, s, tmp, preg);     // s = s + var*r（donor Mula）
    Mul(s, s, rstd, preg);
    Mul(tmp, s, scalar1, preg);
    Add(rstd, rstd, tmp, preg);  // rstd = rstd + s*0.5（donor Mula）
    Compares(cmpRegZero, var, POS_INF, preg);
    Select(rstd, scalarZero, rstd, cmpRegZero);
    Compares(cmpRegInf, var, float(0.0), preg);
    Select(rstd, scalarInf, rstd, cmpRegInf);
}

template <bool NEED_MAX = true, bool NEED_AVG_FACTOR = false>
__aicore__ inline void ComputeRstdNewtonRaphson(__ubuf__ float* src, __ubuf__ float* dst, uint32_t rowCount,
                                                float epsilon, float avgFactor, uint32_t vectorLen)
{
    uint16_t loopRows = static_cast<uint16_t>((rowCount + vectorLen - 1) / vectorLen);
    __VEC_SCOPE__
    {
        RegTensor<float> var;
        RegTensor<float> rstd;
        MaskReg pregLoop;

        uint32_t sreg = rowCount;
        for (uint16_t i = 0; i < loopRows; ++i) {
            pregLoop = UpdateMask<float>(sreg);
            LoadAlign<float>(var, src + i * vectorLen);
            if constexpr (NEED_AVG_FACTOR) {
                Muls(var, var, avgFactor, pregLoop);
            }
            ComputeRstdNewtonRaphsonReg<NEED_MAX>(var, rstd, pregLoop, epsilon);
            StoreAlign<float>(dst + i * vectorLen, rstd, pregLoop);
        }
    }
}

} // namespace NormDonor

// ============================================================
// Kernel 实现
// ============================================================

class RmsNormGatedKernel {
public:
    __aicore__ inline RmsNormGatedKernel() {}

    __aicore__ inline void Init(GM_ADDR o, GM_ADDR z, GM_ADDR gamma, GM_ADDR out, uint32_t m)
    {
        M = m;
        oGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(o), static_cast<uint64_t>(M) * HIDDEN);
        zGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(z), static_cast<uint64_t>(M) * HIDDEN);
        gammaGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(gamma), HEAD);
        outGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(out), static_cast<uint64_t>(M) * HIDDEN);
    }

    __aicore__ inline void Process()
    {
        PrecomputeGammaF32();
        // m 运行时逐行循环（无编译期上界；设备实测 m∈{1,2,17,64,256,257,4097}，见 README）
        // 行间无依赖；行内 48 head 各自 SquareReduce→NR→GateY 串行，rstd 恒在
        // rstdUb[0]，LoadAlign 32B 对齐）
        for (uint32_t row = 0; row < M; ++row) {
            CopyInRow(row);
            ComputeRow();
            CopyOutRow(row);
        }
    }

private:
    // gamma bf16 → fp32 预转换（整个 kernel 只做一次；每 chunk 一次 Cast、
    // 与下一 chunk 的 Cast 之间隔 StoreAlign+LoadAlign，规避连续 Cast bug）
    __aicore__ inline void PrecomputeGammaF32()
    {
        LocalTensor<bfloat16_t> gbL(TPosition::VECCALC, UB_GB, HEAD);
        LocalTensor<float> gfL(TPosition::VECCALC, UB_GF, HEAD);
        __ubuf__ bfloat16_t* gbUb = reinterpret_cast<__ubuf__ bfloat16_t*>(gbL.GetPhyAddr());
        __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(gfL.GetPhyAddr());

        const AscendC::DataCopyParams cpGamma{1, 256 / 32, 0, 0};  // 128 bf16 = 256B 单块
        BufAcquire<PIPE_MTE2>(BUF_G);
        DataCopy(gbL, gammaGm, cpGamma);
        BufRelease<PIPE_MTE2>(BUF_G);

        BufAcquire<PIPE_V>(BUF_G);
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> gB16;
            RegTensor<float> gF;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < CHUNK_PER_HEAD; ++i) {
                uint32_t offset = i * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(gB16, gbUb + offset);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(gF, gB16, maskAll);
                StoreAlign<float, StoreDist::DIST_NORM_B32>(gfUb + offset, gF, maskAll);
            }
        }
        BufRelease<PIPE_V>(BUF_G);
    }

    __aicore__ inline void CopyInRow(uint32_t row)
    {
        LocalTensor<float> oL(TPosition::VECCALC, UB_O, HIDDEN);
        LocalTensor<bfloat16_t> zL(TPosition::VECCALC, UB_Z, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        // 显式 DataCopyParams（M16 实测元素计数重载栈垃圾未初始化；blockCount=1
        // 规避 NZ 重排）：o 24576B = 768×32B；z 12288B = 384×32B
        const AscendC::DataCopyParams cpO{1, 24576 / 32, 0, 0};
        const AscendC::DataCopyParams cpZ{1, 12288 / 32, 0, 0};
        BufAcquire<PIPE_MTE2>(BUF_X);   // 挡上一行的 V 消费
        DataCopy(oL, oGm[off], cpO);
        DataCopy(zL, zGm[off], cpZ);
        BufRelease<PIPE_MTE2>(BUF_X);
    }

    // 门控输出：out = ((o·rstd)·gamma) · sigmoid(z) → bf16（vllm 乘法次序：
    // x_normed*weight 先、乘 act(z) 后；sigmoid = 1/(1+exp(-z)) fp32，m5 实证排布）。
    // 每 chunk 一次 bf16→fp32 Cast（z）与一次 fp32→bf16 Cast（out），中间隔
    // sigmoid 四元组 + 三次 Mul，无相邻 Cast。
    __aicore__ inline void CalculateGateY(__ubuf__ float* oUb, __ubuf__ bfloat16_t* zUb, __ubuf__ float* gfUb,
                                          __ubuf__ bfloat16_t* yUb, __ubuf__ float* rstdUb)
    {
        __VEC_SCOPE__
        {
            RegTensor<float> oReg;
            RegTensor<float> gReg;
            RegTensor<float> rstdReg;
            RegTensor<float> zReg;
            RegTensor<float> vReg;
            RegTensor<float> tReg;
            RegTensor<float> yReg;
            RegTensor<float> oneReg;
            RegTensor<bfloat16_t> zB16;
            RegTensor<bfloat16_t> yB16;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            Duplicate(oneReg, 1.0f, maskAll);
            // rstd 恒在 rstdUb[0]（per-head 流水），DIST_BRC_B32 广播到全 lane
            LoadAlign<float, LoadDist::DIST_BRC_B32>(rstdReg, rstdUb);
            for (uint16_t c = 0; c < CHUNK_PER_HEAD; ++c) {
                uint32_t offset = c * VL_F32;
                LoadAlign<float>(oReg, oUb + offset);
                LoadAlign<float>(gReg, gfUb + offset);
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(zB16, zUb + offset);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(zReg, zB16, maskAll);
                Muls(vReg, zReg, -1.0f, maskAll);
                Exp(vReg, vReg, maskAll);
                Adds(vReg, vReg, 1.0f, maskAll);
                Div(vReg, oneReg, vReg, maskAll);  // sigmoid(z)
                Mul(tReg, oReg, rstdReg, maskAll);
                Mul(tReg, tReg, gReg, maskAll);
                Mul(yReg, tReg, vReg, maskAll);
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yB16, yReg, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(yUb + offset, yB16, maskAll);
            }
        }
    }

    __aicore__ inline void ComputeRow()
    {
        LocalTensor<float> oL(TPosition::VECCALC, UB_O, HIDDEN);
        LocalTensor<bfloat16_t> zL(TPosition::VECCALC, UB_Z, HIDDEN);
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_Y, HIDDEN);
        LocalTensor<float> gfL(TPosition::VECCALC, UB_GF, HEAD);
        LocalTensor<float> tmpL(TPosition::VECCALC, UB_TMP, 64);
        LocalTensor<float> redL(TPosition::VECCALC, UB_RED, 64);
        LocalTensor<float> rstdL(TPosition::VECCALC, UB_RSTD, 64);
        __ubuf__ float* oUb = reinterpret_cast<__ubuf__ float*>(oL.GetPhyAddr());
        __ubuf__ bfloat16_t* zUb = reinterpret_cast<__ubuf__ bfloat16_t*>(zL.GetPhyAddr());
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(yL.GetPhyAddr());
        __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(gfL.GetPhyAddr());
        __ubuf__ float* tmpUb = reinterpret_cast<__ubuf__ float*>(tmpL.GetPhyAddr());
        __ubuf__ float* redUb = reinterpret_cast<__ubuf__ float*>(redL.GetPhyAddr());
        __ubuf__ float* rstdUb = reinterpret_cast<__ubuf__ float*>(rstdL.GetPhyAddr());

        BufAcquire<PIPE_V>(BUF_X);    // 等 o/z 行就位
        BufAcquire<PIPE_V>(BUF_OUT);  // 等上一行 MTE3 读完 out 缓冲
        // 每 head（128 维 = vllm dim=-1 的 RMSNorm 组）：donor ② 二分 fold 平方和
        //（128 ≤ 2×VL → LessThanTwoVL 分支）→ donor ③ NR rstd（mean = sum/128）
        // → 门控输出。sumSq/rstd 恒在 UB 偏移 0，全程 32B 对齐（m6 实证排布）。
        for (uint32_t h = 0; h < HEADS; ++h) {
            __ubuf__ float* headO = oUb + h * HEAD;
            NormDonor::CalculateSquareReduceSum<float>(headO, redUb, tmpUb, 1, HEAD, HEAD, FOLD_POINT,
                                                       REDUCE_TMP_STRIDE);
            NormDonor::ComputeRstdNewtonRaphson<true, true>(redUb, rstdUb, 1, EPS, AVG_FACTOR, VL_F32);
            CalculateGateY(headO, zUb + h * HEAD, gfUb, yUb + h * HEAD, rstdUb);
        }
        BufRelease<PIPE_V>(BUF_X);    // o/z 消费完，MTE2 可复用
        BufRelease<PIPE_V>(BUF_OUT);  // out 写完且 drain，MTE3 可读
    }

    __aicore__ inline void CopyOutRow(uint32_t row)
    {
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_Y, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        const AscendC::DataCopyParams cpY{1, 12288 / 32, 0, 0};  // out 12288B = 384×32B
        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(outGm[off], yL, cpY);
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    uint32_t M;
    GlobalTensor<float> oGm;
    GlobalTensor<bfloat16_t> zGm;
    GlobalTensor<bfloat16_t> gammaGm;
    GlobalTensor<bfloat16_t> outGm;
};

} // namespace

__vector__ __global__ void rmsnorm_gated_kernel(GM_ADDR o, GM_ADDR z, GM_ADDR gamma, GM_ADDR out, uint32_t m)
{
    RmsNormGatedKernel op;
    op.Init(o, z, gamma, out, m);
    op.Process();
}

// ============================================================
// Host 侧：确定性输入生成 + numpy 语义 fp32 参考（内建 C 版）+ 读回校验
// ============================================================

// ---- bf16 编解码（RNE；host 全位操作，与 tools/golden/moe_block_ref.py 一致）----
static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// ---- 确定性输入生成 ----
// o fp32 [m,6144]：元素符号/尾数随机，指数域 e ∈ [77,177]（值域 2^-50..2^50，
//   平方后 2^-100..2^100，×128 累加不溢出/不过小）；特殊行：
//   i%11==7 全零行（var=0 → rstd=1/sqrt(eps)=1000，out=0 路径）；
//   i%11==5 全行同值（均匀平方和）。
// z bf16 [m,6144]：默认 e ∈ [120,130]（|z| ∈ [2^-7,8]；sigmoid ∈ [3e-7,1]，
//   全程 fp32 正规数——3510 向量单元对次正规结果 FTZ 冲零，深尾区不生成）；
//   特殊行：
//   i%7==3  全行大正数（e=140 → 8192，sigmoid 饱和 1.0）；
//   i%7==5  全行大负数（-8192，exp 上溢 → sigmoid 精确 0.0）；
//   i%13==4 全行 0（sigmoid=0.5 精确中点）。
//   （|z|∈[17,88] 的深尾带两侧舍入不同：sigmoid 结果落 fp32 次正规区，
//     NPU FTZ=0、host 保次正规——语义无意义区，生成规避，见 README 已知限制。）
// gamma bf16 [128]：j=0/1/2 = 1.0/-1.0/2.0 精确幂；j%16==0 精确幂+尾数；其余
//   e ∈ [120,134] 随机尾数部分取负（≈±0.5..4）。
static void GenTensors(float* o, uint16_t* z, uint16_t* gamma, uint32_t m, uint32_t seed)
{
    for (uint32_t j = 0; j < HEAD; ++j) {
        const uint32_t h = Hash3(0, j, seed + 77);
        if (j == 0) {
            gamma[j] = 0x3F80;  // 1.0
        } else if (j == 1) {
            gamma[j] = 0xBF80;  // -1.0
        } else if (j == 2) {
            gamma[j] = 0x4000;  // 2.0
        } else if (j % 16 == 0) {
            gamma[j] = static_cast<uint16_t>(0x3F80 | ((h >> 8) & 0x7F));  // [1,2) 精确幂+尾数
        } else {
            const uint32_t e = 120 + h % 15;
            gamma[j] = static_cast<uint16_t>((((h >> 8) & 1) << 15) | (e << 7) | ((h >> 9) & 0x7F));
        }
    }
    for (uint32_t i = 0; i < m; ++i) {
        const bool zeroRow = (i % 11 == 7);
        const bool constRow = (i % 11 == 5);
        const uint32_t hC = Hash3(i, 0, seed + 5);
        // o 常量行值：指数域 [100,125)（≈2^-27..2^-2，平方和远离上下限）
        const uint32_t constExp = 100 + hC % 25;
        const uint32_t constMant = (hC >> 9) & 0x7FFFFF;
        const bool zSatPos = (i % 7 == 3);
        const bool zSatNeg = (i % 7 == 5);
        const bool zZero = (i % 13 == 4);
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const uint32_t h = Hash3(i, j, seed);
            // o：fp32 位模式 = sign | exp[30:23] | mant[22:0]
            if (zeroRow) {
                uint32_t bits = 0;
                __builtin_memcpy(&o[i * HIDDEN + j], &bits, 4);
            } else if (constRow) {
                const uint32_t bits = (constExp << 23) | constMant;
                __builtin_memcpy(&o[i * HIDDEN + j], &bits, 4);
            } else {
                const uint32_t e = 77 + h % 101;  // 2^-50 .. 2^50
                const uint32_t bits = ((((h >> 8) & 1) << 31) | (e << 23) | ((h >> 9) & 0x7FFFFF));
                __builtin_memcpy(&o[i * HIDDEN + j], &bits, 4);
            }
            // z：bf16 位模式
            if (zSatPos) {
                z[i * HIDDEN + j] = static_cast<uint16_t>(140 << 7);  // +8192，sigmoid→1.0
            } else if (zSatNeg) {
                z[i * HIDDEN + j] = static_cast<uint16_t>((1 << 15) | (140 << 7));  // -8192，sigmoid→0.0
            } else if (zZero) {
                z[i * HIDDEN + j] = 0;  // sigmoid=0.5
            } else {
                const uint32_t e = 120 + h % 11;  // |z| ∈ [2^-7, 8]，sigmoid 全 fp32 正规数
                z[i * HIDDEN + j] =
                    static_cast<uint16_t>(((((h >> 11) & 1)) << 15) | (e << 7) | ((h >> 12) & 0x7F));
            }
        }
    }
}

// ---- numpy 语义参考的 C 移植（fp32 累加；与 check_ref.py 逐公式对应）----
// per head（48×128）：var = Σo²/128；rstd = 1/sqrt(var+1e-6)；
// out = bf16( ((o·rstd)·gamma) · sigmoid(z) )，sigmoid = 1/(1+exp(-z)) fp32。
static void RefRmsNormGated(const float* o, const uint16_t* z, const uint16_t* gamma, uint16_t* out, uint32_t m)
{
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t h = 0; h < HEADS; ++h) {
            float sq = 0.0f;
            for (uint32_t j = 0; j < HEAD; ++j) {
                const float a = o[i * HIDDEN + h * HEAD + j];
                sq += a * a;  // fp32 累加
            }
            const float mean = sq / static_cast<float>(HEAD);
            const float rstd = 1.0f / sqrtf(mean + 1e-6f);
            for (uint32_t j = 0; j < HEAD; ++j) {
                const uint32_t idx = i * HIDDEN + h * HEAD + j;
                const float zf = Bf16ToF32(z[idx]);
                const float sig = 1.0f / (1.0f + expf(-zf));
                float t = o[idx] * rstd;
                t = t * Bf16ToF32(gamma[j]);  // (o·rstd)·gamma
                t = t * sig;                  // · sigmoid(z)
                out[idx] = F32ToBf16(t);      // RNE
            }
        }
    }
}

// ---- 可选：dump 模式（与 check_ref.py numpy 参考交叉验证用）----
static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// out 比较：容差 bf16 网格 1e-2 相对（ref 为 0 时要求 got 也为 0）；逐行一致。
// writeRef=true（dump 模式）时除 device 输出外还落盘 o/z/gamma 输入与 C 参考 out，
// 供 check_ref.py 对拍（接口同 m11：一次启动即在设备上跑该 m 档）。
static bool RunCase(aclrtStream stream, uint32_t m, uint32_t seed, bool writeRef = false)
{
    const size_t b16Bytes = static_cast<size_t>(m) * HIDDEN * 2;
    const size_t f32Bytes = static_cast<size_t>(m) * HIDDEN * 4;

    float *oHost = nullptr;
    uint16_t *zHost = nullptr, *gammaHost = nullptr, *outHost = nullptr;
    float* oDev = nullptr;
    uint16_t *zDev = nullptr, *gammaDev = nullptr, *outDev = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&oHost), f32Bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&zHost), b16Bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&gammaHost), HEAD * 2);
    aclrtMallocHost(reinterpret_cast<void**>(&outHost), b16Bytes);
    aclrtMalloc(reinterpret_cast<void**>(&oDev), f32Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&zDev), b16Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&gammaDev), HEAD * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&outDev), b16Bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    GenTensors(oHost, zHost, gammaHost, m, seed);
    aclrtMemcpy(oDev, f32Bytes, oHost, f32Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(zDev, b16Bytes, zHost, b16Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(gammaDev, HEAD * 2, gammaHost, HEAD * 2, ACL_MEMCPY_HOST_TO_DEVICE);

    rmsnorm_gated_kernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(oDev), reinterpret_cast<uint8_t*>(zDev),
        reinterpret_cast<uint8_t*>(gammaDev), reinterpret_cast<uint8_t*>(outDev), m);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M12][FAIL] m=%u seed=%u kernel launch/sync error %d\n", m, seed, (int)launchErr);
        return false;
    }
    aclrtMemcpy(outHost, b16Bytes, outDev, b16Bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    uint16_t* refOut = new uint16_t[static_cast<size_t>(m) * HIDDEN];
    RefRmsNormGated(oHost, zHost, gammaHost, refOut, m);

    // 落盘：M12_DUMP=1 或 dump 模式（writeRef=true）时保存输入与 device 输出；
    // dump 模式另存 C 参考 out（check_ref.py 需要 *_y.bin）。
    if (writeRef || getenv("M12_DUMP") != nullptr) {
        char name[80];
        snprintf(name, sizeof(name), "m%u_s%u_o.bin", m, seed);        WriteBin(name, oHost, f32Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_z.bin", m, seed);        WriteBin(name, zHost, b16Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_gamma.bin", m, seed);    WriteBin(name, gammaHost, HEAD * 2);
        snprintf(name, sizeof(name), "m%u_s%u_y_device.bin", m, seed); WriteBin(name, outHost, b16Bytes);
        if (writeRef) {
            snprintf(name, sizeof(name), "m%u_s%u_y.bin", m, seed);    WriteBin(name, refOut, b16Bytes);
        }
    }

    // ---- out 逐行一致（bf16 网格 1e-2 相对）----
    double worstRowRel = 0.0;
    uint32_t worstRow = 0;
    uint32_t outFail = 0;
    for (uint32_t i = 0; i < m; ++i) {
        double rowWorst = 0.0;
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const size_t idx = static_cast<size_t>(i) * HIDDEN + j;
            const float got = Bf16ToF32(outHost[idx]);
            const float exp = Bf16ToF32(refOut[idx]);
            double rel;
            if (exp == 0.0f) {
                rel = (got == 0.0f) ? 0.0 : 1.0;
            } else {
                rel = static_cast<double>(fabsf(got - exp)) / static_cast<double>(fabsf(exp));
            }
            if (rel > rowWorst) rowWorst = rel;
            if (rel > 1e-2 && outFail < 5) {
                printf("[M12][FAIL] m=%u seed=%u out[%u][%u] got %.6g expect %.6g rel %.3g\n", m, seed, i, j, got,
                       exp, rel);
                ++outFail;
            }
        }
        if (rowWorst > worstRowRel) {
            worstRowRel = rowWorst;
            worstRow = i;
        }
    }
    const bool pass = (outFail == 0);
    printf("[M12] m=%-3u seed=%u : %s (out worst row rel %.3g @row %u)\n", m, seed, pass ? "PASS" : "FAIL",
           worstRowRel, worstRow);

    delete[] refOut;
    aclrtFree(oDev); aclrtFreeHost(oHost);
    aclrtFree(zDev); aclrtFreeHost(zHost);
    aclrtFree(gammaDev); aclrtFreeHost(gammaHost);
    aclrtFree(outDev); aclrtFreeHost(outHost);
    return pass;
}

int32_t main(int32_t argc, char* argv[])
{
    // dump 模式：./m12_rmsnorm_gated dump <m> <seed>
    // 在设备上按该 m 档单次启动 kernel，落盘 o/z/gamma 输入、C 参考 y 与 device
    // 输出 y_device（供 check_ref.py 对拍），并打印 device vs C 参考的 PASS/FAIL。
    // 逐档各自一次启动（不遍历默认 ms[]），便于按 m 档独立取证。
    if (argc >= 4 && argv[1][0] == 'd') {
        const uint32_t m = static_cast<uint32_t>(atoi(argv[2]));
        const uint32_t seed = static_cast<uint32_t>(atoi(argv[3]));
        aclInit(nullptr);
        aclrtSetDevice(0);
        aclrtStream stream = nullptr;
        aclrtCreateStream(&stream);
        const bool ok = RunCase(stream, m, seed, /*writeRef=*/true);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return ok ? 0 : 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 覆盖：任务书 GDN decode m=1 + 动态 m 路径（多组随机种子）
    const uint32_t ms[] = {1, 2, 17, 64, 256};
    const uint32_t seeds[] = {0, 1, 2, 3, 4};

    bool allOk = true;
    for (uint32_t seed : seeds) {
        for (uint32_t m : ms) {
            allOk &= RunCase(stream, m, seed);
        }
    }
    printf("[M12] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
