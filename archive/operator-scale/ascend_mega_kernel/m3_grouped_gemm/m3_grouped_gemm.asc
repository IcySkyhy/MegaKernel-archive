/**
 * m3_grouped_gemm.asc —— Mega kernel M3：多核 grouped MXFP4 GEMM（MoE 纵向切片的 GEMM×2 + SwiGLU 段）
 * （设计约束见 docs/05-megakernel-design.md §5；GEMM 数据通路抄改自本仓库 m1_mxfp4_gemm，单核链路已实测逐位一致）
 *
 * 数据流（一次 mix(1,2) 启动内完成，全部产出经 GM 交接）：
 *
 *   phase 1 (AIC)  grouped gate_up GEMM：8 专家槽位 × N 列块静态切到全部 AIC
 *                  GU[e] = MXFP4(A_e) @ MXFP4(Wgu_e)^T  → GM (bf16)
 *   phase 2 (AIV)  SwiGLU + MXFP4 重量化（按专家槽位行重排的 round-robin 行切分）
 *                  H[e] = quant(silu(GU[e][:, :640]) * GU[e][:, 640:])  → GM (MXFP4 + e8m0)
 *   phase 3 (AIC)  grouped down GEMM：H[e] @ MXFP4(Wdn_e)^T  → GM (bf16)
 *
 * 静态 schedule：work item = (专家槽位, N 列块)，按 item = coreId + i*numBlocks 轮转分派；
 * K 维不切（避免跨核归约）；m（每槽位 token 数）运行时 1..64，单 M tile + curM mask。
 *
 * 核间同步（CrossCore，Set 侧一律不用 PIPE_S，Wait 挂窄 pipe PIPE_MTE2）：
 *   flagId 0  mode 0  全体 AIC barrier        AIC: gate_up 全部写 GM 后（set 挂 PIPE_FIX）
 *   flagId 1  mode 2  AIC -> 配对 2 AIV       AIC: barrier 后通知 AIV 可读 GU
 *   flagId 2  mode 2  AIV -> 配对 AIC         AIV: H 全部写 GM 后（set 挂 PIPE_MTE3）
 *   flagId 3  mode 0  全体 AIC barrier        AIC: 收齐本组 AIV 后再 all-AIC 对齐 -> 可读 H
 * 相邻同步点 flagId 各不相同；mode 2 双向配对（1 set AIC 配 2 wait AIV；2 set AIV 配 1 wait AIC）。
 *
 * 核内同步只用 BufferID（BufAcquire/BufRelease = GetBufInternal/RlsBufInternal），release 用
 *   阻塞释放（mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK）：阻塞到本 pipe 已发射的
 *   UB 写落地，V pipe 的写才对 MTE3 可见；资源全部编译期静态（常量表）。
 *
 * AIV 计算路径（phase 2）全部在 __VEC_SCOPE__ 内用寄存器算子（docs/05 §6.1）：
 *   整行 1280 bf16 → 10 次迭代 ×（gate|up 各 64 bf16 → Reg::Cast → silu 五元组 → Mul）
 *   → 每迭代 2 个 32 元素 scale 组：组 amax（Reduce<MAX>）→ fp32 位域算 e8m0 字节（floor/OCP）→
 *   halfScale = 2^(127-byte) 缩放 → e2m1 CAST_ROUND 编码（平局远离零、饱和到 ±6）→
 *   拼 nibble 落 UB（DIST_PACK4_B32）。位级影响面、T3 ε 推导、自检判据见 README §5/§6。
 *
 * 量化约定（floor/OCP 权威规范，见 README「重量化规范」）：本文件与 m13_moe_layer 的
 *   VecQuantStage::MxQuantComputeScale/MxQuantComputeDataFP4、tools/golden 的 quantize_ocp
 *   同一规范（官方 ops-nn 序列，M26 裁决 floor/OCP 为 default and authoritative）：
 *   · group=32 沿 K；e8m0 byte = clip(E - 2, 0, 254)（E = amax 的 fp32 指数域；E <= 2 -> 0，
 *     ±Inf/NaN 组 -> 0xFF），即官方 shared = maxexp - emax 的 shared >> 7（emax = 0x0100）。
 *   · data = cast_e2m1(h × 2^(127-byte), CAST_ROUND)：平局远离零、饱和到 ±6、保留 -0、
 *     NaN -> 0；byte 0（退化组）halfScale = 0、byte 0xFF（非有限组）halfScale = NaN。
 *   · h 仍为 fp32（silu 五元组在 fp32 域）：官方量化器的输入域是 bf16，本文件不额外把 h
 *     舍入到 bf16（会与 host 镜像的 double silu 参考产生 ≤2 ulp 差 → 破坏 T1 逐字节判据）。
 *     该输入域差异是收敛后的**唯一**遗留差异，量化器本身（scale/rounding/halfScale）与
 *     m13 逐位一致（同一份 bf16 网格输入的逐字节对拍见 README §5.4）。
 *   · M47（AIV 全量 VF 化，位级不变）与 M54（本 mission：ceil -> floor/OCP 语义重基线）分工见 README。
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <cstdlib>
#include <string>
#include <vector>

// ============================================================
// 编译期常量：形状 / 静态 schedule / 静态资源表
// ============================================================

__aicore__ __inline__ constexpr uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ __inline__ constexpr uint32_t AlignUp(uint32_t a, uint32_t b) { return CeilDiv(a, b) * b; }

constexpr uint32_t CUBE_BLOCK = 16;    // cube 分形边长
constexpr uint32_t SCALE_GROUP = 32;   // MXFP4 K 方向 group
constexpr uint32_t BASE_M = 64;        // M 方向 tile（m ∈ [1,64] 单 tile，curM mask）
constexpr uint32_t BASE_K = 128;       // K 方向 tile
constexpr uint32_t BASE_N = 256;       // N 方向 tile

constexpr uint32_t E_SLOTS = 8;        // 专家槽位数（layer0_e0-8 权重切片）
constexpr uint32_t MAXM = 64;          // 每槽位 GM buffer 行数（按 max(m,2) 分配）

// gate_up：K=2560, N=1280
constexpr uint32_t GU_K = 2560;
constexpr uint32_t GU_N = 1280;
constexpr uint32_t GU_NBLK = GU_N / BASE_N;              // 5
constexpr uint32_t GU_ITEMS = E_SLOTS * GU_NBLK;         // 40
// down：K=640, N=2560
constexpr uint32_t DN_K = 640;
constexpr uint32_t DN_N = 2560;
constexpr uint32_t DN_NBLK = DN_N / BASE_N;              // 10
constexpr uint32_t DN_ITEMS = E_SLOTS * DN_NBLK;         // 80

// ---- L1 静态布局（字节偏移；A 区 [0,8.5KB)，B 区 [256KB,290KB)，其余空闲）----
constexpr uint32_t L1_A_DATA = BASE_M * (BASE_K / 2);    // A 数据大包 64×64 = 4KB
constexpr uint32_t L1_A_SCAL = BASE_M * (BASE_K / SCALE_GROUP);  // A scale 大包 256B
constexpr uint32_t L1_OFF_A0 = 0;
constexpr uint32_t L1_OFF_A1 = L1_A_DATA;
constexpr uint32_t L1_OFF_AS0 = 2 * L1_A_DATA;
constexpr uint32_t L1_OFF_AS1 = L1_OFF_AS0 + L1_A_SCAL;
constexpr uint32_t L1_B_DATA = BASE_K * BASE_N / 2;      // B 数据大包 128×256/2 = 16KB
constexpr uint32_t L1_B_SCAL = BASE_N * (BASE_K / SCALE_GROUP);  // B scale 大包 1KB
constexpr uint32_t L1_B_REGION = 256 * 1024;
constexpr uint32_t L1_OFF_B0 = L1_B_REGION;
constexpr uint32_t L1_OFF_B1 = L1_B_REGION + L1_B_DATA;
constexpr uint32_t L1_OFF_BS0 = L1_B_REGION + 2 * L1_B_DATA;
constexpr uint32_t L1_OFF_BS1 = L1_OFF_BS0 + L1_B_SCAL;
static_assert(L1_OFF_BS1 + L1_B_SCAL <= 512 * 1024, "L1 footprint exceeds 512KB");

// ---- L0 静态布局（与 m1 相同：ping/pong 各 32KB）----
constexpr uint32_t L0_PP_BYTES = 32 * 1024;
constexpr uint32_t L0_OFF_0 = 0;
constexpr uint32_t L0_OFF_1 = L0_PP_BYTES;

// ---- BufferID（AIC 核内：与 m1 同款 0..6）----
constexpr AscendC::MutexID BUF_A0 = 0;
constexpr AscendC::MutexID BUF_A1 = 1;
constexpr AscendC::MutexID BUF_B0 = 2;
constexpr AscendC::MutexID BUF_B1 = 3;
constexpr AscendC::MutexID BUF_L0_0 = 4;
constexpr AscendC::MutexID BUF_L0_1 = 5;
constexpr AscendC::MutexID BUF_L0C = 6;
// ---- BufferID（AIV 核内：0 = GM->V 的 GU 行，1 = V->S->MTE3 的 H 行）----
constexpr AscendC::MutexID BUF_GU_ROW = 0;
constexpr AscendC::MutexID BUF_H_ROW = 1;

// ---- CrossCore flagId（相邻同步点不同 id）----
constexpr uint16_t F_BAR_GU = 0;    // mode 0：全体 AIC，gate_up 产出就绪
constexpr uint16_t F_GU_RDY = 1;    // mode 2：AIC -> 配对 AIV
constexpr uint16_t F_H_RDY = 2;     // mode 2：AIV -> 配对 AIC
constexpr uint16_t F_BAR_DN = 3;    // mode 0：全体 AIC，H 产出就绪

// ---- AIV UB 静态布局（字节偏移；全部 32B 对齐，供 DataCopy 与寄存器 store）----
// 一行 GU(1280 bf16 = gate 640 | up 640) 整行 DataCopy 进 guRaw，之后整行留在寄存器里做完
// SwiGLU + MXFP4 重量化（无 fp32 中间量落 UB）；量化结果 nibble 落 packB、scale 落 scalB。
constexpr uint32_t UB_OFF_GU_RAW = 0;                        // 1280 bf16 = 2560B
constexpr uint32_t UB_OFF_H_SCRATCH = UB_OFF_GU_RAW + 2 * GU_N;  // 2560，640 f32 = 2560B（自检/dump 用）
constexpr uint32_t UB_OFF_PACK = UB_OFF_H_SCRATCH + 4 * DN_K;    // 5120（320B）
constexpr uint32_t UB_OFF_SCAL = UB_OFF_PACK + DN_K / 2;         // 5440（32B：20 有效 + 12 pad）
constexpr uint32_t UB_BYTES_TOTAL = UB_OFF_SCAL + 32;            // 5472 « 248KB

// ---- AIV VF 常量与 cast traits（traits 抄 m5_swiglu_quant.asc 的 castTraitB162B32Even 等定义）----
// 本文件不使用 `using namespace AscendC::Reg`（避免影响 AIC 段的经典 API 解析），
// 仅在 VF 函数体内局部引入。
constexpr AscendC::Reg::CastTrait M3_CT_B16_B32 = {
    AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::UNKNOWN,
    AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::UNKNOWN};
constexpr AscendC::Reg::CastTrait M3_CT_F32_I32 = {
    AscendC::Reg::RegLayout::ZERO, AscendC::Reg::SatMode::NO_SAT,
    AscendC::Reg::MaskMergeMode::ZEROING, AscendC::RoundMode::CAST_RINT};
// BufferID 语义封装（逐字抄 m12_rmsnorm_gated.asc / m5_swiglu_quant.asc 的 BufAcquire/BufRelease）：
// acquire 立即获取；release 用阻塞模式（mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK），
// 阻塞至本 pipe 已发射的 UB 写落地，对跨 pipe 消费者可见（公开 Mutex::Lock/Unlock 的 mode 硬编码 0）。
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

constexpr uint32_t VF_LANE_F32 = 64;             // 一个 fp32 向量寄存器 lane 数（256B / 4B）
constexpr uint32_t VF_ITER = DN_K / VF_LANE_F32; // 640/64 = 10 迭代（每迭代 2 个 32 元素 scale 组）

// ---- silu 段（VF 五元组）的 T3 相对界 ε = 2^-21（docs/17 §1.1 T3，逐项推导见 README）----
//   硬件规格（官方 Reg 矢量计算精度表「基础算术 / Exp」「基础算术 / Div」行，Ascend 950PR&950DT）：Exp = 1 ulp、Div = 1 ulp；
//   加减乘为 IEEE 正确舍入（0.5 ulp = 2^-24 相对）。逐项：
//     ① Exp(-g)：1 ulp ⇒ 相对 ≤ 2^-23（归一化输出；FTZ/下溢角落见 README）
//     ② t = 1 + Exp_c：一次加舍入 ≤ 2^-24（相对 t）
//     ③ s = g / t：Div 1 ulp（2^-23）+ t 的相对误差传递（≤ 2^-23 + 2^-24）⇒ ≤ 2.5·2^-23
//     ④ h = s * u：一次乘舍入 ≤ 2^-24 ⇒ 设备侧 ≤ 2.5·2^-23 + 2^-24 = 6·2^-24
//     ⑤ 参考侧：fp32(double silu) * u 两次舍入 ≤ 2·2^-24，另加 host 参考自身的
//        double 级数截断（ExpD 的 10 项泰勒，相对 ~2^-37，远小于 2^-24，量级可不单列）
//   ⇒ ε ≤ 8·2^-24 = 2^-21 = 4.768e-7（Σ|terms| = |silu(gate)|·|up| = |h|）
constexpr double M3_VF_SILU_EPS = 0x1p-21;

// ============================================================
// AIV VF 计算路径（SwiGLU + MXFP4 重量化）：全部在 __VEC_SCOPE__ 内的寄存器算子
// （docs/05 §6.1「计算类一律 VEC_SCOPE/register-based，禁 memory-based vector API」）
//   · 数值语义 = 被替换的经典实现逐位相同：
//     ① silu 五元组（donor：m5_swiglu_quant.asc 的 SwigluComputeTile / m13_moe_layer.asc 的
//        VecQuantStage::SwigluComputeTile）：silu(g) = g/(1+exp(-g))
//        —— 与经典 AscendC::Silu 的近似不同 ⇒ 该段按 docs/17 T3 判（ε 推导见 README）；
//     ② 量化已收敛到 floor/OCP 权威规范（M54）：e8m0 byte = E-2 的 clamp 形式、halfScale =
//        2^(127-byte)、e2m1 CAST_ROUND（平局远离零、保留 -0、NaN -> 0），h 保持 fp32；
//        与 host 镜像 QuantRowH/E2M1CodeH/QuantScaleByteH 逐位等价（T1 不降档）。
//        h 的 fp32 输入域是与 m13（bf16 输入域）的**唯一**遗留差异，见 README「重量化规范」。
//   · 生产路径与自检 kernel（m3_vf_probe_kernel）调用同一份函数 ⇒ 自检覆盖的就是生产代码。
// ============================================================

// acc += (a <cmp> thr) ? one : zero（逐元素；等价 host 的 `c += (...)` 计数）
template <AscendC::CMPMODE cmpmode>
__aicore__ inline void M3VfCmpAccum(AscendC::Reg::RegTensor<float>& acc, AscendC::Reg::RegTensor<float>& a,
                                    float thr, AscendC::Reg::RegTensor<float>& one,
                                    AscendC::Reg::RegTensor<float>& zero, AscendC::Reg::MaskReg& maskAll)
{
    using namespace AscendC::Reg;
    RegTensor<float> sel;
    MaskReg mTmp;
    Compares<float, cmpmode>(mTmp, a, thr, maskAll);
    Select(sel, one, zero, mTmp);
    Add(acc, acc, sel, maskAll);
}

// amax（lane0 有效）-> e8m0 scale byte（lane0 有效）；floor/OCP 规范，逐位等价 host QuantScaleByteH
//   = 官方 MxQuantComputeScale 的 (maxexp - emax) >> 7（emax = FP4_E2M1_BF16_MAX_EXP = 0x0100）：
//   byte = E - 2（E = amax 的 fp32 指数域）；官方 :402-403 clamp 下界 ⇒ E <= 2 -> byte 0（含零/
//   次正规/退化组）；官方 :401/:406 ⇒ E == 255（±Inf/NaN）-> byte 0xFF。
//   注：amax 由 |h| 的 Reduce<MAX> 得来，符号位恒 0，故 E 即指数域。
__aicore__ inline void M3VfAmaxToScaleByte(AscendC::Reg::RegTensor<float>& amaxF,
                                           AscendC::Reg::RegTensor<uint32_t>& byteR,
                                           AscendC::Reg::MaskReg& maskAll)
{
    using namespace AscendC::Reg;
    RegTensor<uint32_t> e, zeroU, fullU, negTwoU;
    MaskReg mTmp;
    Duplicate(zeroU, static_cast<uint32_t>(0));
    Duplicate(fullU, static_cast<uint32_t>(0xFFu));
    Duplicate(negTwoU, static_cast<uint32_t>(0xFFFFFFFEu));   // uint32 下的 -2（= host 的 uint32 环绕减法）
    ShiftRights(e, (RegTensor<uint32_t>&)amaxF, static_cast<int16_t>(23), maskAll);
    Add(byteR, e, negTwoU, maskAll);                                        // E - 2
    Compares<uint32_t, AscendC::CMPMODE::LE>(mTmp, e, static_cast<uint32_t>(2), maskAll);
    Select(byteR, zeroU, byteR, mTmp);                                     // E <= 2 -> 0（官方 clamp 下界）
    Compares<uint32_t, AscendC::CMPMODE::EQ>(mTmp, e, static_cast<uint32_t>(255), maskAll);
    Select(byteR, fullU, byteR, mTmp);                                     // E == 255 -> 0xFF（±Inf/NaN）
}

// scale byte（lane0 有效）-> halfScale = 2^(127 - byte)（fp32 位域 = (254 - byte) << 23）；
//   官方 halfScale = 0x7F00 - shared 的 fp32 等价位域（shared = (E-2) << 7），即 1/scale。
//   byte 0（退化组）-> 0.0（官方 :414 zeroMask），byte 0xFF（非有限组）-> NaN（官方 :413 的 0x7F81）。
__aicore__ inline void M3VfByteToHalfScale(AscendC::Reg::RegTensor<uint32_t>& byteR,
                                           AscendC::Reg::RegTensor<uint32_t>& mulR,
                                           AscendC::Reg::MaskReg& maskAll)
{
    using namespace AscendC::Reg;
    RegTensor<uint32_t> e, zeroU, nanU;
    MaskReg mTmp;
    Duplicate(zeroU, static_cast<uint32_t>(0));
    Duplicate(nanU, static_cast<uint32_t>(0x7FC00000u));   // 静默 NaN
    Duplicate(e, static_cast<uint32_t>(254));
    Sub(e, e, byteR, maskAll);                                             // 254 - byte
    ShiftLefts(mulR, e, static_cast<int16_t>(23), maskAll);                // 2^(127-byte)
    Compares<uint32_t, AscendC::CMPMODE::EQ>(mTmp, byteR, static_cast<uint32_t>(0), maskAll);
    Select(mulR, zeroU, mulR, mTmp);                                       // byte 0 -> 0
    Compares<uint32_t, AscendC::CMPMODE::EQ>(mTmp, byteR, static_cast<uint32_t>(0xFFu), maskAll);
    Select(mulR, nanU, mulR, mTmp);                                        // byte 0xFF -> NaN
}

// 64 lane fp32 h（= 2 个 32 元素组）-> 32B nibble（低半字节=偶元素、高半字节=奇元素）+ 2B scale
//   floor/OCP + 官方 CAST_ROUND（平局远离零、饱和到 ±6、保留 -0、NaN -> 0）。
__aicore__ inline void M3VfQuantTwoGroups(AscendC::Reg::RegTensor<float>& hF, __ubuf__ int8_t* packUb,
                                          __ubuf__ uint8_t* scalUb, AscendC::Reg::MaskReg& maskAll,
                                          AscendC::Reg::MaskReg& maskLo)
{
    using namespace AscendC::Reg;
    RegTensor<uint32_t> absMask, expMask, byteMask, nibMask, signMask, zeroU;
    RegTensor<uint32_t> absBits, byteL, byteH, byteL8, byteH8, byteHs8, pairB, cI, byteR;
    RegTensor<uint32_t> mulL, mulH, mulLd, mulHd, mul, signU, cev, cod, cod4;
    RegTensor<int32_t> cI32;
    RegTensor<float> amaxL, amaxH, vF, cF, oneF, zeroF, absLo, absHi;
    MaskReg mNaN;

    Duplicate(absMask, static_cast<uint32_t>(0x7FFFFFFFu));
    Duplicate(expMask, static_cast<uint32_t>(0x7F800000u));
    Duplicate(byteMask, static_cast<uint32_t>(0xFFu));
    Duplicate(nibMask, static_cast<uint32_t>(0xFu));
    Duplicate(signMask, static_cast<uint32_t>(0x80000000u));
    Duplicate(zeroU, static_cast<uint32_t>(0));
    Duplicate(zeroF, 0.0f);

    // ---- 1) 组 amax：**指数域**的 32 lane 最大（与 m13 VecQuantStage::MxQuantComputeScale 的
    //     And 0x7F80 + Max + ReduceDataBlock<MAX> 同域：fp32 用 And 0x7F800000 掩出指数域），
    //     结果落在 lane0。指数域的 bitwise max 即 max|h| 的指数域（floor 规范只需指数），
    //     且 ±Inf/NaN 被归一到 E = 255 -> byte 0xFF（与官方 :401/:406 一致）。
    //     注：MaskPattern::H 实测 = 低半区（= VL32），不能选高半区；因此把另半区 Select 置 0 后
    //     各做一次整寄存器 Reduce<MAX>（置 0 用 Select 而非乘 0，避免 inf*0 = NaN 污染）
    And(absBits, (RegTensor<uint32_t>&)hF, expMask, maskAll);
    Select(absLo, (RegTensor<float>&)absBits, zeroF, maskLo);
    Select(absHi, zeroF, (RegTensor<float>&)absBits, maskLo);
    Reduce<ReduceType::MAX>(amaxL, absLo, maskAll);
    Reduce<ReduceType::MAX>(amaxH, absHi, maskAll);

    // ---- 2) e8m0 scale byte（floor/OCP，逐位 = host QuantScaleByteH，只有 lane0 有效）----
    M3VfAmaxToScaleByte(amaxL, byteL, maskAll);
    M3VfAmaxToScaleByte(amaxH, byteH, maskAll);

    // ---- 3) 两个 scale 字节拼在 lane0 低 16 位 -> 一次 2B store ----
    And(byteL8, byteL, byteMask, maskAll);
    And(byteH8, byteH, byteMask, maskAll);
    ShiftLefts(byteHs8, byteH8, static_cast<int16_t>(8), maskAll);
    Or(pairB, byteL8, byteHs8, maskAll);
    Store<uint8_t>(scalUb, (RegTensor<uint8_t>&)pairB, 2);

    // ---- 4) halfScale = 2^(127-byte)（= 1/scale），广播到全 lane 后按半区选回 ----
    M3VfByteToHalfScale(byteL8, mulL, maskAll);
    M3VfByteToHalfScale(byteH8, mulH, maskAll);
    Duplicate<uint32_t, HighLowPart::LOWEST>(mulLd, mulL, maskAll);
    Duplicate<uint32_t, HighLowPart::LOWEST>(mulHd, mulH, maskAll);
    Select(mul, mulLd, mulHd, maskLo);
    Mul(vF, hF, (RegTensor<float>&)mul, maskAll);

    // ---- 5) e2m1 CAST_ROUND：平局远离零（阈值比较用 >=）、饱和到 ±6；
    //         符号位取自乘积的符号位（保留 -0，与 Cast<fp4> / m13 参考的 signbit 一致）；
    //         乘积为 NaN（非有限组）-> code 0（与 Cast<fp4>(NaN)=0 / m13 参考 isnan->0 一致）----
    And(absBits, (RegTensor<uint32_t>&)vF, absMask, maskAll);
    Duplicate(cF, 0.0f);
    Duplicate(oneF, 1.0f);
    Duplicate(zeroF, 0.0f);
    M3VfCmpAccum<AscendC::CMPMODE::GE>(cF, (RegTensor<float>&)absBits, 0.25f, oneF, zeroF, maskAll);
    M3VfCmpAccum<AscendC::CMPMODE::GE>(cF, (RegTensor<float>&)absBits, 0.75f, oneF, zeroF, maskAll);
    M3VfCmpAccum<AscendC::CMPMODE::GE>(cF, (RegTensor<float>&)absBits, 1.25f, oneF, zeroF, maskAll);
    M3VfCmpAccum<AscendC::CMPMODE::GE>(cF, (RegTensor<float>&)absBits, 1.75f, oneF, zeroF, maskAll);
    M3VfCmpAccum<AscendC::CMPMODE::GE>(cF, (RegTensor<float>&)absBits, 2.5f, oneF, zeroF, maskAll);
    M3VfCmpAccum<AscendC::CMPMODE::GE>(cF, (RegTensor<float>&)absBits, 3.5f, oneF, zeroF, maskAll);
    M3VfCmpAccum<AscendC::CMPMODE::GE>(cF, (RegTensor<float>&)absBits, 5.0f, oneF, zeroF, maskAll);
    Cast<int32_t, float, M3_CT_F32_I32>(cI32, cF, maskAll);
    And(cI, (RegTensor<uint32_t>&)cI32, nibMask, maskAll);
    And(signU, (RegTensor<uint32_t>&)vF, signMask, maskAll);
    ShiftRights(signU, signU, static_cast<int16_t>(28), maskAll);   // 0x80000000 -> 0x8，其余 0
    Or(cI, cI, signU, maskAll);
    Compares<uint32_t, AscendC::CMPMODE::GT>(mNaN, absBits, static_cast<uint32_t>(0x7F800000u), maskAll);   // NaN 判定
    Select(cI, zeroU, cI, mNaN);

    // ---- 6) nibble 落盘：偶元素 code -> 低半字节，奇元素 code -> 高半字节 ----
    //    DeInterleave(同源双出) 实测把偶/奇 lane 分到两个寄存器的低 32 lane；
    //    DIST_PACK4_B32 实测按「每 32bit lane 落 1 字节（取低字节）」写，故先用 Or 自己拼字节，
    //    再用 VL32 掩码（32 个有效 lane -> 32 字节）落盘（地址 32B 对齐）。
    DeInterleave(cev, cod, cI, cI);
    ShiftLefts(cod4, cod, static_cast<int16_t>(4), maskAll);
    Or(byteR, cev, cod4, maskAll);
    StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
        packUb, (RegTensor<int8_t>&)byteR, SCALE_GROUP, maskLo);
}

// 一行 GU（gate 640 | up 640，bf16）-> h = silu(gate)*up -> 重量化（整行 10 个 VL，h 不落 UB）
__aicore__ inline void M3VfSwiGluQuantRow(__ubuf__ bfloat16_t* guRawUb, __ubuf__ int8_t* packUb,
                                          __ubuf__ uint8_t* scalUb)
{
    using namespace AscendC::Reg;
    __VEC_SCOPE__
    {
        RegTensor<bfloat16_t> tgB;
        RegTensor<bfloat16_t> tuB;
        RegTensor<float> gF, uF, sF, hF;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskLo = CreateMask<float, MaskPattern::VL32>();   // lane 0..31
        for (uint16_t it = 0; it < static_cast<uint16_t>(VF_ITER); ++it) {
            // gate|up 各 64 bf16（DIST_UNPACK_B16：每元素落 32bit lane 低半）→ fp32
            LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tgB, guRawUb + it * VF_LANE_F32);
            LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tuB, guRawUb + DN_K + it * VF_LANE_F32);
            Cast<float, bfloat16_t, M3_CT_B16_B32>(gF, tgB, maskAll);
            Cast<float, bfloat16_t, M3_CT_B16_B32>(uF, tuB, maskAll);
            Muls(sF, gF, -1.0f, maskAll);
            Exp(sF, sF, maskAll);
            Adds(sF, sF, 1.0f, maskAll);
            Div(sF, gF, sF, maskAll);
            Mul(hF, sF, uF, maskAll);   // h = silu(gate) * up（fp32，不落 UB）
            M3VfQuantTwoGroups(hF, packUb + it * SCALE_GROUP, scalUb + 2 * it, maskAll, maskLo);
        }
    }
}

// 诊断（loop 落盘异常最小复现器）：只做 UNPACK_B16 加载 + Cast + 单 VL 落 64 个 fp32，
// 10 次迭代（每 VF 一次循环）。实测只有前 5 次迭代的数据落到 UB（见 README 与 tower finding）。
__aicore__ inline void M3VfCastOnlyRow(__ubuf__ bfloat16_t* guRawUb, __ubuf__ float* hUb)
{
    using namespace AscendC::Reg;
    __VEC_SCOPE__
    {
        RegTensor<bfloat16_t> tgB;
        RegTensor<float> gF;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        for (uint16_t it = 0; it < static_cast<uint16_t>(VF_ITER); ++it) {
            LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tgB, guRawUb + it * VF_LANE_F32);
            Cast<float, bfloat16_t, M3_CT_B16_B32>(gF, tgB, maskAll);
            Store<float>(hUb + it * VF_LANE_F32, gF, VF_LANE_F32);
        }
    }
}

// 单 VL 版（T3 自检用）：只处理 [itBase, itBase+64) 这一个 VL，故 VF 内只有 1 次 256B 落盘
__aicore__ inline void M3VfSiluOneVl(__ubuf__ bfloat16_t* guRawUb, __ubuf__ float* hUb, __ubuf__ int8_t* packUb,
                                     __ubuf__ uint8_t* scalUb, uint32_t itBase)
{
    using namespace AscendC::Reg;
    __VEC_SCOPE__
    {
        RegTensor<bfloat16_t> tgB, tuB;
        RegTensor<float> gF, uF, sF, hF;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskLo = CreateMask<float, MaskPattern::VL32>();
        LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tgB, guRawUb + itBase);
        LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tuB, guRawUb + DN_K + itBase);
        Cast<float, bfloat16_t, M3_CT_B16_B32>(gF, tgB, maskAll);
        Cast<float, bfloat16_t, M3_CT_B16_B32>(uF, tuB, maskAll);
        Muls(sF, gF, -1.0f, maskAll);
        Exp(sF, sF, maskAll);
        Adds(sF, sF, 1.0f, maskAll);
        Div(sF, gF, sF, maskAll);
        Mul(hF, sF, uF, maskAll);
        Store<float>(hUb + itBase, hF, VF_LANE_F32);
        M3VfQuantTwoGroups(hF, packUb + (itBase / VF_LANE_F32) * SCALE_GROUP,
                           scalUb + 2 * (itBase / VF_LANE_F32), maskAll, maskLo);
    }
}

// 一行 h（fp32，640）-> 重量化（自检用：amax 端点/规则对拍的直接入口）
__aicore__ inline void M3VfQuantRowUb(__ubuf__ float* hUb, __ubuf__ int8_t* packUb, __ubuf__ uint8_t* scalUb)
{
    using namespace AscendC::Reg;
    __VEC_SCOPE__
    {
        RegTensor<float> hF;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskLo = CreateMask<float, MaskPattern::VL32>();
        for (uint16_t it = 0; it < static_cast<uint16_t>(VF_ITER); ++it) {
            LoadAlign<float>(hF, hUb + it * VF_LANE_F32);
            M3VfQuantTwoGroups(hF, packUb + it * SCALE_GROUP, scalUb + 2 * it, maskAll, maskLo);
        }
    }
}

// ============================================================
// AIC：grouped MXFP4 GEMM（单 work item = 一个 (slot, nBlock)，m1 数据通路）
// ============================================================

template <uint32_t K, uint32_t N, uint32_t A_SCAL_STRIDE>
class MXFP4GemmItem {
    static constexpr uint32_t PACKED_K = K / 2;                       // A/B 数据行字节数
    static constexpr uint32_t SCALE_K = K / SCALE_GROUP;              // scale 有效字节/行
    static_assert(K % BASE_K == 0, "K must be divisible by BASE_K");
    static_assert(N % BASE_N == 0, "N must be divisible by BASE_N");

public:
    __aicore__ inline MXFP4GemmItem() {}

    // 每个 work item 调用：设置该专家槽位的 GM 基址
    __aicore__ inline void SetItem(
        __gm__ uint8_t* a, __gm__ uint8_t* as, __gm__ uint8_t* b, __gm__ uint8_t* bs, __gm__ uint8_t* c)
    {
        aGM.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)a);
        asGM.SetGlobalBuffer((__gm__ fp8_e8m0_t*)as);
        bGM.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)b);
        bsGM.SetGlobalBuffer((__gm__ fp8_e8m0_t*)bs);
        cGM.SetGlobalBuffer((__gm__ bfloat16_t*)c);
    }

    // 计算一个 (nBlock, curM) tile：k 循环累加 L0C -> Fixpipe 写 GM
    __aicore__ inline void Run(uint32_t nBlock, uint32_t curM)
    {
        const uint32_t curMAlign = AlignUp(curM, CUBE_BLOCK);
        // 3510 quirk（同 m1）：Nd2Nz/Dn2Nz 行数=1 退化，计算侧提升为 >=2 行，仅 Fixpipe 按 curM 写出
        const uint32_t calcM = curM < 2 ? 2 : curM;
        const uint32_t kLoop = K / BASE_K;

        AscendC::LocalTensor<fp4x2_e2m1_t> a1Ping(AscendC::TPosition::A1, L1_OFF_A0, L1_A_DATA);
        AscendC::LocalTensor<fp4x2_e2m1_t> a1Pong(AscendC::TPosition::A1, L1_OFF_A1, L1_A_DATA);
        AscendC::LocalTensor<fp8_e8m0_t> as1Ping(AscendC::TPosition::A1, L1_OFF_AS0, L1_A_SCAL);
        AscendC::LocalTensor<fp8_e8m0_t> as1Pong(AscendC::TPosition::A1, L1_OFF_AS1, L1_A_SCAL);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Ping(AscendC::TPosition::B1, L1_OFF_B0, L1_B_DATA);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Pong(AscendC::TPosition::B1, L1_OFF_B1, L1_B_DATA);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Ping(AscendC::TPosition::B1, L1_OFF_BS0, L1_B_SCAL);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Pong(AscendC::TPosition::B1, L1_OFF_BS1, L1_B_SCAL);
        AscendC::LocalTensor<fp4x2_e2m1_t> a2Ping(AscendC::TPosition::A2, L0_OFF_0, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> a2Pong(AscendC::TPosition::A2, L0_OFF_1, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Ping(AscendC::TPosition::B2, L0_OFF_0, BASE_K * BASE_N / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Pong(AscendC::TPosition::B2, L0_OFF_1, BASE_K * BASE_N / 2);
        AscendC::LocalTensor<float> cL0C(AscendC::TPosition::CO1, 0, BASE_M * BASE_N);

        AscendC::Mutex::Lock<PIPE_M>(BUF_L0C);   // 挡住上一 item 的 Fixpipe 读，允许本 tile 累加
        for (uint32_t kBlock = 0; kBlock < kLoop; ++kBlock) {
            const uint32_t p = kBlock & 1;
            const AscendC::MutexID bufA = p ? BUF_A1 : BUF_A0;
            const AscendC::MutexID bufB = p ? BUF_B1 : BUF_B0;
            const AscendC::MutexID bufL0 = p ? BUF_L0_1 : BUF_L0_0;
            AscendC::LocalTensor<fp4x2_e2m1_t> a1 = p ? a1Pong : a1Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> b1 = p ? b1Pong : b1Ping;
            AscendC::LocalTensor<fp8_e8m0_t> as1 = p ? as1Pong : as1Ping;
            AscendC::LocalTensor<fp8_e8m0_t> bs1 = p ? bs1Pong : bs1Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> a2 = p ? a2Pong : a2Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> b2 = p ? b2Pong : b2Ping;

            AscendC::Mutex::Lock<PIPE_MTE2>(bufA);
            CopyInA(a1, as1, kBlock, calcM);
            AscendC::Mutex::Unlock<PIPE_MTE2>(bufA);
            AscendC::Mutex::Lock<PIPE_MTE2>(bufB);
            CopyInB(b1, bs1, kBlock, nBlock);
            AscendC::Mutex::Unlock<PIPE_MTE2>(bufB);

            AscendC::Mutex::Lock<PIPE_MTE1>(bufL0);
            AscendC::Mutex::Lock<PIPE_MTE1>(bufA);
            AscendC::Mutex::Lock<PIPE_MTE1>(bufB);
            LoadA(a1, as1, a2, curMAlign);
            LoadB(b1, bs1, b2);
            AscendC::Mutex::Unlock<PIPE_MTE1>(bufA);
            AscendC::Mutex::Unlock<PIPE_MTE1>(bufB);
            AscendC::Mutex::Unlock<PIPE_MTE1>(bufL0);

            AscendC::Mutex::Lock<PIPE_M>(bufL0);
            AscendC::MmadParams mmadParams;
            mmadParams.m = calcM;
            mmadParams.n = BASE_N;
            mmadParams.k = BASE_K;
            mmadParams.cmatrixInitVal = (kBlock == 0);
            AscendC::MmadMx(cL0C, a2, b2, mmadParams);
            AscendC::Mutex::Unlock<PIPE_M>(bufL0);
        }
        AscendC::Mutex::Unlock<PIPE_M>(BUF_L0C);   // L0C 累加结果就绪
        AscendC::Mutex::Lock<PIPE_FIX>(BUF_L0C);
        CopyOut(cL0C, nBlock, curM, curMAlign);
        AscendC::Mutex::Unlock<PIPE_FIX>(BUF_L0C);
    }

private:
    // GM -> L1：A 的一个 baseK 大包（calcM 行 × BASE_K fp4）+ scale（Dn2Nz，b16 视图）
    __aicore__ inline void CopyInA(
        AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
        uint32_t kBlock, uint32_t curM)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = curM;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_M;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, aGM[kBlock * BASE_K], par);   // 偏移按 fp4 元素（4bit）计

        constexpr uint32_t stepScaleK = BASE_K / SCALE_GROUP;
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = curM;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = A_SCAL_STRIDE / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> asGMB16;
        asGMB16.SetGlobalBuffer(((__gm__ half*)asGM.GetPhyAddr()) + scaleOffHalf, curM * (A_SCAL_STRIDE / 2));
        AscendC::DataCopy(as1.ReinterpretCast<half>(), asGMB16, sp);
    }

    // GM -> L1：B 按 [N, K] 原始 layout 搬 baseN 行 × BASE_K fp4 + scale
    __aicore__ inline void CopyInB(
        AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
        uint32_t kBlock, uint32_t nBlock)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = BASE_N;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_N;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, bGM[kBlock * BASE_K + nBlock * BASE_N * K], par);

        constexpr uint32_t stepScaleK = BASE_K / SCALE_GROUP;
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = BASE_N;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = SCALE_K / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (nBlock * BASE_N * SCALE_K + kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> bsGMB16;
        bsGMB16.SetGlobalBuffer(((__gm__ half*)bsGM.GetPhyAddr()) + scaleOffHalf, BASE_N * (SCALE_K / 2));
        AscendC::DataCopy(bs1.ReinterpretCast<half>(), bsGMB16, sp);
    }

    __aicore__ inline void LoadA(
        AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
        AscendC::LocalTensor<fp4x2_e2m1_t>& a2, uint32_t curMAlign)
    {
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = curMAlign / CUBE_BLOCK;
        lp.kStep = BASE_K / 64;
        lp.srcStride = BASE_M / CUBE_BLOCK;
        lp.dstStride = curMAlign / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = curMAlign / CUBE_BLOCK;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(a2, a1[0], as1[0], lp, mx);
    }

    __aicore__ inline void LoadB(
        AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
        AscendC::LocalTensor<fp4x2_e2m1_t>& b2)
    {
        constexpr uint32_t nFracs = BASE_N / CUBE_BLOCK;
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = nFracs;
        lp.kStep = BASE_K / 64;
        lp.srcStride = BASE_N / CUBE_BLOCK;
        lp.dstStride = nFracs;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = nFracs;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(b2, b1[0], bs1[0], lp, mx);
    }

    __aicore__ inline void CopyOut(
        AscendC::LocalTensor<float>& cL0C, uint32_t nBlock, uint32_t curM, uint32_t curMAlign)
    {
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp;
        fp.nSize = BASE_N;
        fp.mSize = curM;
        fp.srcStride = curMAlign;
        fp.dstStride = N;
        fp.quantPre = QuantMode_t::F322BF16;
        AscendC::Fixpipe(cGM[nBlock * BASE_N], cL0C, fp);
    }

private:
    AscendC::GlobalTensor<fp4x2_e2m1_t> aGM;
    AscendC::GlobalTensor<fp8_e8m0_t> asGM;
    AscendC::GlobalTensor<fp4x2_e2m1_t> bGM;
    AscendC::GlobalTensor<fp8_e8m0_t> bsGM;
    AscendC::GlobalTensor<bfloat16_t> cGM;
};

// ============================================================
// mix kernel：AIC 侧静态 schedule + CrossCore 序列，AIV 侧 SwiGLU+量化
// ============================================================

class M3GroupedGemm {
public:
    __aicore__ inline M3GroupedGemm() {}

    __aicore__ inline void Init(
        __gm__ uint8_t* act, __gm__ uint8_t* actS,      // [E][MAXM][GU_K/2] / [E][MAXM][80]
        __gm__ uint8_t* wgu, __gm__ uint8_t* wguS,      // [E][GU_N][GU_K/2] / [E][GU_N][80]
        __gm__ uint8_t* wdn, __gm__ uint8_t* wdnS,      // [E][DN_N][DN_K/2] / [E][DN_N][20]
        __gm__ uint32_t* counts,                        // [E] 每槽位 token 数
        __gm__ uint8_t* guOut,                          // [E][MAXM][GU_N] bf16
        __gm__ uint8_t* hPacked, __gm__ uint8_t* hS,    // [E][MAXM][DN_K/2] / [E][MAXM][32]
        __gm__ uint8_t* yOut)                           // [E][MAXM][DN_N] bf16
    {
        actGM = act; actSGM = actS;
        wguGM = wgu; wguSGM = wguS;
        wdnGM = wdn; wdnSGM = wdnS;
        countsGM.SetGlobalBuffer(counts);
        guOutGM16.SetGlobalBuffer((__gm__ bfloat16_t*)guOut);
        guOutRaw = guOut;
        hPackedGM.SetGlobalBuffer(hPacked);
        hSGM.SetGlobalBuffer(hS);
        hPackedRaw = hPacked; hSRaw = hS;
        yOutGM = yOut;
    }

    // ---------------- AIC ----------------
    __aicore__ inline void ProcessAic()
    {
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t numBlocks = AscendC::GetBlockNum();

        // ---- phase 1：grouped gate_up GEMM（静态 schedule：item = (slot, nBlock) 轮转）----
        for (uint32_t item = bid; item < GU_ITEMS; item += numBlocks) {
            const uint32_t slot = item / GU_NBLK;
            const uint32_t nb = item % GU_NBLK;
            const uint32_t t = countsGM.GetValue(slot);
            gemmGu.SetItem(
                actGM + slot * MAXM * (GU_K / 2), actSGM + slot * MAXM * (GU_K / SCALE_GROUP),
                wguGM + slot * GU_N * (GU_K / 2), wguSGM + slot * GU_N * (GU_K / SCALE_GROUP),
                guOutRaw + slot * MAXM * GU_N * 2);
            gemmGu.Run(nb, t);
        }
        // GU 全部写 GM -> 全体 AIC 对齐 -> 通知配对 AIV
        // 注：CrossCoreSet 是"挂在 pipe 上"的 drain 触发（不是 pipe FIFO 序），
        // 因此 wait 之后的 set 不能把次序寄托在同 pipe 排队上——gate 后续 set 的 wait 一律挂 PIPE_S
        // （阻塞 scalar 下发，CANN SyncAllImpl 同款用法）；AIV 侧的等待仍挂 PIPE_MTE2 以保留预取旁路。
        AscendC::CrossCoreSetFlag<0x0, PIPE_FIX>(F_BAR_GU);
        AscendC::CrossCoreWaitFlag<0x0, PIPE_S>(F_BAR_GU);
        AscendC::CrossCoreSetFlag<0x2, PIPE_MTE2>(F_GU_RDY);

        // ---- phase 3：grouped down GEMM（消费 AIV 重量化的 H）----
        AscendC::CrossCoreWaitFlag<0x2, PIPE_S>(F_H_RDY);   // 本组 2 个 AIV 的 H 就绪
        AscendC::CrossCoreSetFlag<0x0, PIPE_MTE2>(F_BAR_DN);   // 全体 AIC 再对齐 -> 全部 H 就绪
        AscendC::CrossCoreWaitFlag<0x0, PIPE_S>(F_BAR_DN);
        for (uint32_t item = bid; item < DN_ITEMS; item += numBlocks) {
            const uint32_t slot = item / DN_NBLK;
            const uint32_t nb = item % DN_NBLK;
            const uint32_t t = countsGM.GetValue(slot);
            gemmDn.SetItem(
                hPackedRaw + slot * MAXM * (DN_K / 2), hSRaw + slot * MAXM * 32,
                wdnGM + slot * DN_N * (DN_K / 2), wdnSGM + slot * DN_N * (DN_K / SCALE_GROUP),
                yOutGM + slot * MAXM * DN_N * 2);
            gemmDn.Run(nb, t);
        }
    }

    // ---------------- AIV ----------------
    __aicore__ inline void ProcessAiv()
    {
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t numAiv = AscendC::GetBlockNum() * 2;   // AIV 视角 GetBlockNum = AIC 数

        // 读每槽位 token 数（值依赖，PIPE_S 同步合法），构造行前缀和
        uint32_t startOff[E_SLOTS + 1];
        startOff[0] = 0;
        for (uint32_t s = 0; s < E_SLOTS; ++s) {
            startOff[s + 1] = startOff[s] + countsGM.GetValue(s);
        }
        const uint32_t totalRows = startOff[E_SLOTS];

        AscendC::CrossCoreWaitFlag<0x2, PIPE_MTE2>(F_GU_RDY);  // 配对 AIC 已通知（隐含全体 AIC 完成）

        AscendC::LocalTensor<bfloat16_t> guRaw(
            AscendC::TPosition::VECCALC, UB_OFF_GU_RAW / 2, GU_N);
        AscendC::LocalTensor<uint8_t> packB(
            AscendC::TPosition::VECCALC, UB_OFF_PACK, DN_K / 2);
        AscendC::LocalTensor<uint8_t> scalB(
            AscendC::TPosition::VECCALC, UB_OFF_SCAL, 32);
        __ubuf__ bfloat16_t* guRawUb = reinterpret_cast<__ubuf__ bfloat16_t*>(guRaw.GetPhyAddr());
        __ubuf__ int8_t* packUb = reinterpret_cast<__ubuf__ int8_t*>(packB.GetPhyAddr());
        __ubuf__ uint8_t* scalUb = reinterpret_cast<__ubuf__ uint8_t*>(scalB.GetPhyAddr());

        // 显式 DataCopyParams（docs/12 §6「小改清单 A」/ m9_gdn_prolog.asc 的 CopyInGating 写法）：元素计数重载的 blockCount/srcGap/dstGap
        // 是未初始化栈垃圾（M16 实测踩雷：复制块数随机翻倍），本路径一律显式传块数
        const AscendC::DataCopyParams cpGuRow{1, GU_N * 2 / 32, 0, 0};       // 2560B
        const AscendC::DataCopyParams cpHPack{1, DN_K / 2 / 32, 0, 0};       // 320B
        const AscendC::DataCopyParams cpHScal{1, 1, 0, 0};                    // 32B

        // 行级 round-robin：AIV r 处理行 r, r+numAiv, ...
        for (uint32_t r = bid; r < totalRows; r += numAiv) {
            uint32_t slot = 0;
            while (slot < E_SLOTS - 1 && r >= startOff[slot + 1]) ++slot;
            const uint32_t lr = r - startOff[slot];

            // GM -> UB：一整行 GU（1280 bf16 = gate|up）；guOut 布局 [slot][MAXM][GU_N]
            const uint32_t guRowOff = (slot * MAXM + lr) * GU_N;
            BufAcquire<PIPE_MTE2>(BUF_GU_ROW);
            AscendC::DataCopy(guRaw, guOutGM16[guRowOff], cpGuRow);
            BufRelease<PIPE_MTE2>(BUF_GU_ROW);

            // V：整行 VF（silu 五元组 + 重量化全部在 __VEC_SCOPE__ 内）
            BufAcquire<PIPE_V>(BUF_GU_ROW);
            BufAcquire<PIPE_V>(BUF_H_ROW);                     // pack/scal 缓冲空闲（首轮即得，之后等 MTE3）
            M3VfSwiGluQuantRow(guRawUb, packUb, scalUb);
            BufRelease<PIPE_V>(BUF_H_ROW);                     // drain 后 pack/scal 对 MTE3 可见
            BufRelease<PIPE_V>(BUF_GU_ROW);                    // guRaw 消费完，交还 MTE2

            BufAcquire<PIPE_MTE3>(BUF_H_ROW);
            AscendC::DataCopy(hPackedGM[(slot * MAXM + lr) * (DN_K / 2)], packB, cpHPack);
            AscendC::DataCopy(hSGM[(slot * MAXM + lr) * 32], scalB, cpHScal);
            BufRelease<PIPE_MTE3>(BUF_H_ROW);
        }
        AscendC::CrossCoreSetFlag<0x2, PIPE_MTE3>(F_H_RDY);    // 本核 H 行全部落 GM
    }

private:
    __gm__ uint8_t* actGM;
    __gm__ uint8_t* actSGM;
    __gm__ uint8_t* wguGM;
    __gm__ uint8_t* wguSGM;
    __gm__ uint8_t* wdnGM;
    __gm__ uint8_t* wdnSGM;
    AscendC::GlobalTensor<uint32_t> countsGM;
    AscendC::GlobalTensor<bfloat16_t> guOutGM16;
    __gm__ uint8_t* guOutRaw;
    AscendC::GlobalTensor<uint8_t> hPackedGM;
    AscendC::GlobalTensor<uint8_t> hSGM;
    __gm__ uint8_t* hPackedRaw;
    __gm__ uint8_t* hSRaw;
    __gm__ uint8_t* yOutGM;
    MXFP4GemmItem<GU_K, GU_N, GU_K / SCALE_GROUP> gemmGu;   // A scale 行距 80B
    MXFP4GemmItem<DN_K, DN_N, 32> gemmDn;                   // H scale 行距 32B（padded）
};

__global__ __mix__(1, 2) void m3_grouped_gemm_kernel(
    __gm__ uint8_t* act, __gm__ uint8_t* actS,
    __gm__ uint8_t* wgu, __gm__ uint8_t* wguS,
    __gm__ uint8_t* wdn, __gm__ uint8_t* wdnS,
    __gm__ uint32_t* counts,
    __gm__ uint8_t* guOut, __gm__ uint8_t* hPacked, __gm__ uint8_t* hS, __gm__ uint8_t* yOut)
{
    AscendC::InitSocState();
    M3GroupedGemm op;
    op.Init(act, actS, wgu, wguS, wdn, wdnS, counts, guOut, hPacked, hS, yOut);
    if ASCEND_IS_AIV {
        op.ProcessAiv();
    }
    if ASCEND_IS_AIC {
        op.ProcessAic();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// AIV VF 自检 kernel（复用生产路径同一份 VF 函数；单 AIV，行序确定）
//   mode 0：in = [rows][GU_N] bf16（gate|up）-> h(f32) + pack(DN_K/2 B) + scal(32B)
//   mode 1：in = [rows][DN_K] fp32（h）      -> pack(DN_K/2 B) + scal(32B)
//   行距：pack = DN_K/2 字节、scal = 32 字节、h = DN_K*4 字节（与生产 GM 布局同）
// ============================================================
class M3VfProbe {
public:
    __aicore__ inline void Init(__gm__ uint8_t* in, __gm__ uint8_t* hOut, __gm__ uint8_t* packOut,
                                __gm__ uint8_t* scalOut, uint32_t rows, uint32_t mode, uint32_t itBase)
    {
        itBase_ = itBase;
        inB16GM.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(in));
        inF32GM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(in));
        hGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(hOut));
        packGM.SetGlobalBuffer(packOut);
        scalGM.SetGlobalBuffer(scalOut);
        rows_ = rows;
        mode_ = mode;
    }

    __aicore__ inline void Run()
    {
        AscendC::LocalTensor<bfloat16_t> inB16(AscendC::TPosition::VECCALC, UB_OFF_GU_RAW / 2, GU_N);
        AscendC::LocalTensor<float> inF32(AscendC::TPosition::VECCALC, UB_OFF_GU_RAW / 4, DN_K);
        AscendC::LocalTensor<float> hScratch(AscendC::TPosition::VECCALC, UB_OFF_H_SCRATCH / 4, DN_K);
        AscendC::LocalTensor<uint8_t> packB(AscendC::TPosition::VECCALC, UB_OFF_PACK, DN_K / 2);
        AscendC::LocalTensor<uint8_t> scalB(AscendC::TPosition::VECCALC, UB_OFF_SCAL, 32);
        __ubuf__ bfloat16_t* inB16Ub = reinterpret_cast<__ubuf__ bfloat16_t*>(inB16.GetPhyAddr());
        __ubuf__ float* inF32Ub = reinterpret_cast<__ubuf__ float*>(inF32.GetPhyAddr());
        __ubuf__ float* hScratchUb = reinterpret_cast<__ubuf__ float*>(hScratch.GetPhyAddr());
        __ubuf__ int8_t* packUb = reinterpret_cast<__ubuf__ int8_t*>(packB.GetPhyAddr());
        __ubuf__ uint8_t* scalUb = reinterpret_cast<__ubuf__ uint8_t*>(scalB.GetPhyAddr());

        const AscendC::DataCopyParams cpB16Row{1, GU_N * 2 / 32, 0, 0};   // 1280 bf16 = 2560B
        const AscendC::DataCopyParams cpF32Row{1, DN_K * 4 / 32, 0, 0};   // 640 f32 = 2560B
        const AscendC::DataCopyParams cpPackRow{1, DN_K / 2 / 32, 0, 0};  // 320B
        const AscendC::DataCopyParams cpScalRow{1, 1, 0, 0};              // 32B

        // 跨 pipe 的 UB 交接用 BufferID + 阻塞释放（与生产 AIV 路径同款）
        for (uint32_t r = 0; r < rows_; ++r) {
            BufAcquire<PIPE_MTE2>(BUF_GU_ROW);
            if (mode_ != 1) {
                AscendC::DataCopy(inB16, inB16GM[r * GU_N], cpB16Row);
            } else {
                AscendC::DataCopy(inF32, inF32GM[r * DN_K], cpF32Row);
            }
            BufRelease<PIPE_MTE2>(BUF_GU_ROW);
            BufAcquire<PIPE_V>(BUF_GU_ROW);
            BufAcquire<PIPE_V>(BUF_H_ROW);
            if (mode_ == 0) {          // 生产同一份 VF（整行）
                M3VfSwiGluQuantRow(inB16Ub, packUb, scalUb);
            } else if (mode_ == 6) {   // loop 落盘异常最小复现器
                M3VfCastOnlyRow(inB16Ub, hScratchUb);
            } else if (mode_ == 9) {   // 单 VL：silu + 重量化（T3 判据与生产对拍用）
                M3VfSiluOneVl(inB16Ub, hScratchUb, packUb, scalUb, itBase_);
            } else {                   // 1：仅重量化（h 由 GM 给）
                M3VfQuantRowUb(inF32Ub, packUb, scalUb);
            }
            BufRelease<PIPE_V>(BUF_H_ROW);
            BufRelease<PIPE_V>(BUF_GU_ROW);
            BufAcquire<PIPE_MTE3>(BUF_H_ROW);
            if (mode_ == 6 || mode_ == 9) {
                AscendC::DataCopy(hGM[r * DN_K], hScratch, cpF32Row);
            }
            AscendC::DataCopy(packGM[r * (DN_K / 2)], packB, cpPackRow);
            AscendC::DataCopy(scalGM[r * 32], scalB, cpScalRow);
            BufRelease<PIPE_MTE3>(BUF_H_ROW);
        }
    }

private:
    AscendC::GlobalTensor<bfloat16_t> inB16GM;
    AscendC::GlobalTensor<float> inF32GM;
    AscendC::GlobalTensor<float> hGM;
    AscendC::GlobalTensor<uint8_t> packGM;
    AscendC::GlobalTensor<uint8_t> scalGM;
    uint32_t rows_ = 0;
    uint32_t mode_ = 0;
    uint32_t itBase_ = 0;
};

__vector__ __global__ void m3_vf_probe_kernel(__gm__ uint8_t* in, __gm__ uint8_t* hOut, __gm__ uint8_t* packOut,
                                              __gm__ uint8_t* scalOut, uint32_t rows, uint32_t mode, uint32_t itBase)
{
    AscendC::InitSocState();
    M3VfProbe op;
    op.Init(in, hOut, packOut, scalOut, rows, mode, itBase);
    op.Run();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ---- mode 2：VF 原语语义实测（诊断用；dump 到 hOut/packOut/scalOut）----
//   hOut[0..64)   = LoadAlign<DIST_DINTLV_B32> 的 dst0（读 128 元素）
//   hOut[64..128) = 同上的 dst1
//   hOut[128..192)= Reduce<MAX> maskALL 的结果寄存器
//   hOut[192..256)= Reduce<MAX> maskVL32
//   hOut[256..320)= Reduce<MAX> maskH
//   hOut[320..384)= Select(1.0, 2.0, maskVL32)
//   hOut[384..448)= Duplicate<LOWEST>(src=lane0=7,lane1=9,...) 的广播结果
//   packOut[0..32)= Arange&0xF 的 64 lane 经 DIST_PACK4_B32 落盘
//   scalOut[0..4) = u32 lane0 = 0x00000201 经 Store<uint8_t>(.,.,2) 落盘
class M3VfPrimProbe {
public:
    __aicore__ inline void Init(__gm__ uint8_t* in, __gm__ uint8_t* hOut, __gm__ uint8_t* packOut,
                                __gm__ uint8_t* scalOut)
    {
        inGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(in));
        hGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(hOut));
        packGM.SetGlobalBuffer(packOut);
        scalGM.SetGlobalBuffer(scalOut);
    }

    __aicore__ inline void Run()
    {
        AscendC::LocalTensor<float> inL(AscendC::TPosition::VECCALC, UB_OFF_GU_RAW / 4, 128);
        AscendC::LocalTensor<float> hL(AscendC::TPosition::VECCALC, UB_OFF_H_SCRATCH / 4, 448);
        AscendC::LocalTensor<uint8_t> packL(AscendC::TPosition::VECCALC, UB_OFF_PACK, 64);
        AscendC::LocalTensor<uint8_t> scalL(AscendC::TPosition::VECCALC, UB_OFF_SCAL, 32);
        BufAcquire<PIPE_MTE2>(BUF_GU_ROW);
        const AscendC::DataCopyParams cpIn{1, 128 * 4 / 32, 0, 0};    // 512B
        const AscendC::DataCopyParams cpPack{1, 2, 0, 0};             // 64B
        const AscendC::DataCopyParams cpScal{1, 1, 0, 0};             // 32B
        const AscendC::DataCopyParams cpH{1, 448 * 4 / 32, 0, 0};     // 1792B
        AscendC::DataCopy(inL, inGM, cpIn);
        AscendC::DataCopy(packL, packGM, cpPack);
        AscendC::DataCopy(scalL, scalGM, cpScal);
        BufRelease<PIPE_MTE2>(BUF_GU_ROW);
        using namespace AscendC::Reg;
        RegTensor<float> ramp, ev, od, r0, r1, r2, selA, srcD, dstD;
        RegTensor<float> oneF, twoF, sevenF, nineF;
        RegTensor<uint32_t> dupM;
        RegTensor<int32_t> idxI, codeI, fifteenI;
        __ubuf__ float* inUb = reinterpret_cast<__ubuf__ float*>(inL.GetPhyAddr());
        __ubuf__ float* hUb = reinterpret_cast<__ubuf__ float*>(hL.GetPhyAddr());
        __ubuf__ int8_t* packUb = reinterpret_cast<__ubuf__ int8_t*>(packL.GetPhyAddr());
        __ubuf__ uint8_t* scalUb = reinterpret_cast<__ubuf__ uint8_t*>(scalL.GetPhyAddr());
        BufAcquire<PIPE_V>(BUF_GU_ROW);
        BufAcquire<PIPE_V>(BUF_H_ROW);
        __VEC_SCOPE__
        {
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            MaskReg maskLo = CreateMask<float, MaskPattern::VL32>();
            MaskReg maskH = CreateMask<float, MaskPattern::H>();
            MaskReg maskLane0 = CreateMask<float, MaskPattern::VL1>();
            LoadAlign<float>(ramp, inUb);
            LoadAlign<float, LoadDist::DIST_DINTLV_B32>(ev, od, inUb);
            StoreAlign<float, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_NORM>(hUb, ev, 64, maskAll);
            StoreAlign<float, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_NORM>(hUb, od, 64, maskAll);
            Reduce<ReduceType::MAX>(r0, ramp, maskAll);
            StoreAlign<float, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_NORM>(hUb, r0, 64, maskAll);
            Reduce<ReduceType::MAX>(r1, ramp, maskLo);
            StoreAlign<float, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_NORM>(hUb, r1, 64, maskAll);
            Reduce<ReduceType::MAX>(r2, ramp, maskH);
            StoreAlign<float, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_NORM>(hUb, r2, 64, maskAll);
            Duplicate(oneF, 1.0f);
            Duplicate(twoF, 2.0f);
            Select(selA, oneF, twoF, maskLo);
            StoreAlign<float, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_NORM>(hUb, selA, 64, maskAll);
            // 只置 lane0 的源寄存器（7.0），其余 lane = 9.0 -> Duplicate<LOWEST> 应全 lane 广播 7.0
            Duplicate(sevenF, 7.0f);
            Duplicate(nineF, 9.0f);
            Select(srcD, sevenF, nineF, maskLane0);
            Duplicate<float, HighLowPart::LOWEST>(dstD, srcD, maskAll);
            StoreAlign<float, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_NORM>(hUb, dstD, 64, maskAll);
            // code = lane % 16 -> DIST_PACK4_B32 落 32 字节
            Duplicate(dupM, static_cast<uint32_t>(15u));
            Arange<int32_t>(idxI, 0);
            And(codeI, (RegTensor<int32_t>&)idxI, (RegTensor<int32_t>&)dupM, maskAll);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                packUb, (RegTensor<int8_t>&)codeI, 32, maskAll);
            // u32 lane0 = 0x00000201 -> Store<uint8_t>(.,.,2) 应写 2 字节 0x01,0x02
            RegTensor<uint32_t> pairU;
            Duplicate(pairU, static_cast<uint32_t>(0x00000201u));
            Store<uint8_t>(scalUb, (RegTensor<uint8_t>&)pairU, 2);
        }
        BufRelease<PIPE_V>(BUF_H_ROW);
        BufRelease<PIPE_V>(BUF_GU_ROW);
        BufAcquire<PIPE_MTE3>(BUF_H_ROW);
        AscendC::DataCopy(hGM, hL, cpH);
        AscendC::DataCopy(packGM, packL, cpPack);
        AscendC::DataCopy(scalGM, scalL, cpScal);
        BufRelease<PIPE_MTE3>(BUF_H_ROW);
    }

private:
    AscendC::GlobalTensor<float> inGM;
    AscendC::GlobalTensor<float> hGM;
    AscendC::GlobalTensor<uint8_t> packGM;
    AscendC::GlobalTensor<uint8_t> scalGM;
};

__vector__ __global__ void m3_vf_prim_kernel(__gm__ uint8_t* in, __gm__ uint8_t* hOut, __gm__ uint8_t* packOut,
                                             __gm__ uint8_t* scalOut)
{
    AscendC::InitSocState();
    M3VfPrimProbe op;
    op.Init(in, hOut, packOut, scalOut);
    op.Run();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧：真实权重读取 + 确定性激活 + CPU golden 校验
// ============================================================

static const char* kDataDir = "tools/weights/data/layer0_e0-8";

// ---- golden 数值约定（与 tools/golden/moe_block_ref.py 一致）----
// e2m1 code 0..7 = 0,0.5,1,1.5,2,3,4,6.0（code 7 按 6.0 处理，moe_block_ref 的有限值约定）
static double E2M1ToF(uint8_t code)
{
    static const double kVal[8] = {0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0};
    const bool neg = (code & 0x8) != 0;
    const double v = kVal[code & 0x7];
    return neg ? -v : v;
}
// e8m0 bias 127：byte b = 2^(b-127)
static double E8M0ToF(uint8_t b)
{
    return ldexp(1.0, (int)b - 127);
}

// ---- bf16 RNE（m1 同款）----
static uint16_t FloatToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return (uint16_t)((x + roundingBias) >> 16);
}
static float Bf16ToFloat(uint16_t h)
{
    uint32_t x = ((uint32_t)h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

// ---- 无 libm 的 double exp（silu 用；范围规约 + 泰勒，~1e-13 相对精度）----
static double FloorD(double x)
{
    const int64_t i = (int64_t)x;
    const double f = (double)i;
    return (f > x) ? f - 1.0 : f;
}
static double LdexpD(double m, int e)
{
    union { double d; uint64_t u; } v;
    v.d = m;
    int exp = (int)((v.u >> 52) & 0x7FF);
    if (exp == 0) return m;                       // 0 / 次正规：直接返回
    exp += e;
    if (exp >= 0x7FF) {
        v.u = (v.u & 0x8000000000000000ull) | 0x7FF0000000000000ull;
        return v.d;                               // overflow -> inf
    }
    if (exp <= 0) return (v.u >> 63) ? -0.0 : 0.0; // underflow -> 0
    v.u = (v.u & 0x800FFFFFFFFFFFFFull) | ((uint64_t)exp << 52);
    return v.d;
}
static double ExpD(double x)
{
    const double LN2 = 6.931471805599453094e-01;
    const double INV_LN2 = 1.4426950408889634074;
    const double k = FloorD(x * INV_LN2 + 0.5);
    const double r = x - k * LN2;                 // r in [-ln2/2, ln2/2]
    const double p = 1.0 + r * (1.0 + r * (0.5 + r * (1.0 / 6 + r * (1.0 / 24 + r * (1.0 / 120 +
        r * (1.0 / 720 + r * (1.0 / 5040 + r * (1.0 / 40320 + r * (1.0 / 362880)))))))));
    return LdexpD(p, (int)k);
}
static double SiluD(double v)
{
    return v / (1.0 + ExpD(-v));
}

// ---- 确定性伪随机（m1 同款 Hash3）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// 生成一个槽位的 MXFP4 激活（MAXM 行全生成；scale 2^-1..2^2；避开 NaN code）
static void GenActSlot(uint8_t* data, uint8_t* scales, uint32_t slot)
{
    const uint32_t kg = GU_K / SCALE_GROUP;   // 80
    for (uint32_t i = 0; i < MAXM; ++i) {
        const uint32_t salt = 0xA500u + slot * 131u;
        for (uint32_t g = 0; g < kg; ++g) {
            scales[i * kg + g] = (uint8_t)(126 + (Hash3(i, g, salt + 7) % 4));
        }
        for (uint32_t kk = 0; kk < GU_K; kk += 2) {
            uint8_t lo = (uint8_t)(Hash3(i, kk, salt) & 0xF);
            uint8_t hi = (uint8_t)(Hash3(i, kk + 1, salt) & 0xF);
            if ((lo & 0x7) == 0x7) lo &= 0xE;
            if ((hi & 0x7) == 0x7) hi &= 0xE;
            data[i * (GU_K / 2) + kk / 2] = (uint8_t)(lo | (hi << 4));
        }
    }
}

// ---- AIV 重量化规范的 host 镜像（floor/OCP；算法与 kernel 内完全一致）----
// E8M0 byte -> 2^(byte-127)（反量化用；自检读数）
static float ScaleByteToFloatH(uint8_t b)
{
    union { uint32_t u; float f; } v;
    v.u = (uint32_t)b << 23;
    return v.f;
}
// halfScale = 2^(127-byte)（= 1/scale）：官方 halfScale = 0x7F00 - shared 的 fp32 等价位域。
// byte 0（退化组）-> 0（官方 :414 zeroMask），byte 0xFF（非有限组）-> NaN（官方 :413 的 0x7F81）。
static float HalfScaleOfByteH(uint8_t b)
{
    if (b == 0u) return 0.0f;
    if (b == 0xFFu) { union { uint32_t u; float f; } v; v.u = 0x7FC00000u; return v.f; }
    union { uint32_t u; float f; } v;
    v.u = (uint32_t)(254u - (uint32_t)b) << 23;
    return v.f;
}
// floor/OCP e8m0 字节：E <= 2 -> 0（零/次正规/退化，官方 clamp 下界），E == 255（±Inf/NaN）-> 0xFF，其余 E-2
static uint8_t QuantScaleByteH(float amax)
{
    union { float f; uint32_t u; } v;
    v.f = amax;
    const uint32_t e = (v.u >> 23) & 0xFFu;
    if (e <= 2u) return 0u;
    if (e == 255u) return 0xFFu;
    return (uint8_t)(e - 2u);
}
// CAST_ROUND 的幅度码（平局远离零、饱和到 code 7 = 6.0）；入参为 |v|
static uint32_t E2M1CodeH(float a)
{
    uint32_t c = 0;
    c += (a >= 0.25f) ? 1u : 0u;
    c += (a >= 0.75f) ? 1u : 0u;
    c += (a >= 1.25f) ? 1u : 0u;
    c += (a >= 1.75f) ? 1u : 0u;
    c += (a >= 2.5f) ? 1u : 0u;
    c += (a >= 3.5f) ? 1u : 0u;
    c += (a >= 5.0f) ? 1u : 0u;
    return c;
}
// floor/OCP 字节（exponent 域）：expBits 为 fp32 指数域（0x7F800000 掩出），E <= 2 -> 0，E == 255 -> 0xFF
static uint8_t ScaleByteOfExpBitsH(uint32_t expBits)
{
    const uint32_t e = expBits >> 23;
    if (e <= 2u) return 0u;
    if (e == 255u) return 0xFFu;
    return (uint8_t)(e - 2u);
}
// h: 640 fp32 -> pack 320B + scale 32B（20 有效）；floor/OCP + CAST_ROUND
// 组 amax 取**指数域**最大（与 device 的 And 0x7F800000 + Reduce<MAX> 同域 ⇒ ±Inf/NaN 组一致；
// 有限输入下与 max|h| 的指数域相同）
static void QuantRowH(const float* h, uint8_t* pack, uint8_t* scal)
{
    for (uint32_t g = 0; g < DN_K / SCALE_GROUP; ++g) {
        uint32_t maxExp = 0;
        for (uint32_t j = 0; j < SCALE_GROUP; ++j) {
            union { float f; uint32_t u; } x;
            x.f = h[g * SCALE_GROUP + j];
            const uint32_t e = x.u & 0x7F800000u;
            maxExp = e > maxExp ? e : maxExp;
        }
        const uint8_t sByte = ScaleByteOfExpBitsH(maxExp);
        scal[g] = sByte;
        const float mul = HalfScaleOfByteH(sByte);
        for (uint32_t j = 0; j < SCALE_GROUP; j += 2) {
            const float v0 = h[g * SCALE_GROUP + j] * mul;
            const float v1 = h[g * SCALE_GROUP + j + 1] * mul;
            const float a0 = v0 < 0 ? -v0 : v0;
            const float a1 = v1 < 0 ? -v1 : v1;
            uint32_t c0 = E2M1CodeH(a0);
            uint32_t c1 = E2M1CodeH(a1);
            if (std::signbit(v0)) c0 |= 8u;   // 保留 -0（与 Cast<fp4> / device 的符号位语义一致）
            if (std::signbit(v1)) c1 |= 8u;
            if (std::isnan(v0)) c0 = 0u;      // Cast<fp4>(NaN) = 0（非有限组，官方 :413 的 NaN halfScale）
            if (std::isnan(v1)) c1 = 0u;
            pack[g * (SCALE_GROUP / 2) + j / 2] = (uint8_t)(c0 | (c1 << 4));
        }
    }
}

// ---- bin 读取 ----
static uint8_t* LoadBin(const char* path, size_t expectBytes)
{
    FILE* f = fopen(path, "rb");
    if (!f) {
        printf("[M3][FAIL] cannot open %s\n", path);
        exit(2);
    }
    fseek(f, 0, SEEK_END);
    const long n = ftell(f);
    fseek(f, 0, SEEK_SET);
    if ((size_t)n != expectBytes) {
        printf("[M3][FAIL] %s size %ld != expect %zu\n", path, n, expectBytes);
        exit(2);
    }
    uint8_t* buf = (uint8_t*)malloc(expectBytes);
    if (fread(buf, 1, expectBytes, f) != expectBytes) {
        printf("[M3][FAIL] read %s truncated\n", path);
        exit(2);
    }
    fclose(f);
    return buf;
}

static uint32_t SlotTokens(uint32_t m, uint32_t slot)
{
    return m > 4 * slot ? m - 4 * slot : 1;
}

// ---- 解包一张 MXFP4 权重表 [rows, K] -> double（行主序）----
static void UnpackWeights(const uint8_t* packed, const uint8_t* scales, uint32_t rows, uint32_t k, double* out)
{
    const uint32_t kg = k / SCALE_GROUP;
    for (uint32_t n = 0; n < rows; ++n) {
        for (uint32_t kk = 0; kk < k; ++kk) {
            const uint8_t byte = packed[n * (k / 2) + kk / 2];
            const uint8_t code = (kk & 1) ? (byte >> 4) : (byte & 0xF);
            out[(size_t)n * k + kk] = E2M1ToF(code) * E8M0ToF(scales[n * kg + kk / SCALE_GROUP]);
        }
    }
}

// ---- 校验一个输出块（bf16 网格化 double 参考，m1 容差公式）----
static bool CheckBlock(const char* tag, uint32_t m, uint32_t slot, const uint16_t* got,
                       const double* expect, uint32_t rows, uint32_t cols, double sqrtK,
                       const double* rowMaxA, const double* rowMaxB)
{
    const double absTolBase = 1e-3 * sqrtK;
    bool pass = true;
    uint32_t failCount = 0;
    double maxRelDiff = 0.0;
    for (uint32_t i = 0; i < rows && failCount < 5; ++i) {
        for (uint32_t j = 0; j < cols; ++j) {
            const float expF = Bf16ToFloat(FloatToBf16((float)expect[(size_t)i * cols + j]));
            const float gotF = Bf16ToFloat(got[(size_t)i * cols + j]);
            const double tol = 1e-2 * fabs(expF) + absTolBase * rowMaxA[i] * rowMaxB[j];
            const double relDiff = fabs(gotF - expF) / (fabs(expF) > 1.0 ? fabs(expF) : 1.0);
            if (relDiff > maxRelDiff) maxRelDiff = relDiff;
            if (fabs(gotF - expF) > tol) {
                printf("[M3][FAIL] %s m=%u slot=%u [%u][%u] got %f expect %f (tol %f)\n",
                    tag, m, slot, i, j, gotF, expF, tol);
                pass = false;
                if (++failCount >= 5) break;
            }
        }
    }
    printf("[M3] %s m=%-2u slot=%u rows=%u cols=%u : %s (maxRelDiff %.2e)\n",
        tag, m, slot, rows, cols, pass ? "PASS" : "FAIL", maxRelDiff);
    return pass;
}

// ---- 每槽位校验：gate_up 输出、H 重量化、down 输出 ----
static bool ValidateSlot(
    uint32_t m, uint32_t slot, uint32_t t,
    const uint8_t* actPacked, const uint8_t* actScales,
    const uint16_t* guDev, const uint8_t* hDevPack, const uint8_t* hDevScal, const uint16_t* yDev,
    const double* wguD, const double* rowMaxGu, const double* wdnD, const double* rowMaxDn)
{
    bool ok = true;

    // ---- gate_up golden：A_e @ Wgu_e^T ----
    double* aD = (double*)malloc(sizeof(double) * (size_t)t * GU_K);
    double* rowMaxA = (double*)malloc(sizeof(double) * t);
    UnpackWeights(actPacked, actScales, t, GU_K, aD);
    for (uint32_t i = 0; i < t; ++i) {
        double mx = 0.0;
        for (uint32_t k = 0; k < GU_K; ++k) {
            const double a = fabs(aD[(size_t)i * GU_K + k]);
            mx = a > mx ? a : mx;
        }
        rowMaxA[i] = mx;
    }
    double* guRef = (double*)malloc(sizeof(double) * (size_t)t * GU_N);
    for (uint32_t i = 0; i < t; ++i) {
        for (uint32_t j = 0; j < GU_N; ++j) {
            const double* aRow = aD + (size_t)i * GU_K;
            const double* wRow = wguD + (size_t)j * GU_K;
            double acc = 0.0;
            for (uint32_t k = 0; k < GU_K; ++k) acc += aRow[k] * wRow[k];
            guRef[(size_t)i * GU_N + j] = acc;
        }
    }
    ok &= CheckBlock("gate_up", m, slot, guDev + (size_t)slot * MAXM * GU_N, guRef,
        t, GU_N, 50.59644260968681, rowMaxA, rowMaxGu);

    // ---- H golden：由 device GU(bf16) 计算 silu(gate)*up 并重量化（与 AIV 同规范）----
    double* hD = (double*)malloc(sizeof(double) * (size_t)t * DN_K);
    double* rowMaxH = (double*)malloc(sizeof(double) * t);
    uint32_t packMis = 0, scalMis = 0;
    for (uint32_t i = 0; i < t; ++i) {
        const uint16_t* guRow = guDev + ((size_t)slot * MAXM + i) * GU_N;
        float h[DN_K];
        for (uint32_t j = 0; j < DN_K; ++j) {
            const float g = Bf16ToFloat(guRow[j]);
            const float u = Bf16ToFloat(guRow[DN_K + j]);
            const float sil = (float)SiluD((double)g);
            h[j] = sil * u;   // fp32 语义（double 积后舍入 = fp32 乘法）
        }
        uint8_t packR[DN_K / 2];
        uint8_t scalR[32];
        memset(scalR, 0, sizeof(scalR));
        QuantRowH(h, packR, scalR);
        const uint8_t* devPack = hDevPack + ((size_t)slot * MAXM + i) * (DN_K / 2);
        const uint8_t* devScal = hDevScal + ((size_t)slot * MAXM + i) * 32;
        for (uint32_t b = 0; b < DN_K / 2; ++b) packMis += (packR[b] != devPack[b]) ? 1u : 0u;
        for (uint32_t b = 0; b < DN_K / SCALE_GROUP; ++b) scalMis += (scalR[b] != devScal[b]) ? 1u : 0u;
        // 反量化 H_ref 供 down golden 使用
        for (uint32_t k = 0; k < DN_K; ++k) {
            const uint8_t byte = packR[k / 2];
            const uint8_t code = (k & 1) ? (byte >> 4) : (byte & 0xF);
            hD[(size_t)i * DN_K + k] = E2M1ToF(code) * E8M0ToF(scalR[k / SCALE_GROUP]);
        }
        double mx = 0.0;
        for (uint32_t k = 0; k < DN_K; ++k) {
            const double a = fabs(hD[(size_t)i * DN_K + k]);
            mx = a > mx ? a : mx;
        }
        rowMaxH[i] = mx;
    }
    printf("[M3] h_quant m=%-2u slot=%u : packed byte mismatch %u/%zu, scale byte mismatch %u/%u : %s\n",
        m, slot, packMis, (size_t)t * (DN_K / 2), scalMis, DN_K / SCALE_GROUP,
        (packMis == 0 && scalMis == 0) ? "PASS (T1 逐字节 vs host 镜像)" : "FAIL (T1 逐字节 vs host 镜像)");
    ok &= (packMis == 0 && scalMis == 0);

    // ---- down golden：H_e @ Wdn_e^T ----
    double* yRef = (double*)malloc(sizeof(double) * (size_t)t * DN_N);
    for (uint32_t i = 0; i < t; ++i) {
        for (uint32_t j = 0; j < DN_N; ++j) {
            const double* hRow = hD + (size_t)i * DN_K;
            const double* wRow = wdnD + (size_t)j * DN_K;
            double acc = 0.0;
            for (uint32_t k = 0; k < DN_K; ++k) acc += hRow[k] * wRow[k];
            yRef[(size_t)i * DN_N + j] = acc;
        }
    }
    ok &= CheckBlock("down   ", m, slot, yDev + (size_t)slot * MAXM * DN_N, yRef,
        t, DN_N, 25.298221281347036, rowMaxH, rowMaxDn);

    free(aD); free(rowMaxA); free(guRef); free(hD); free(rowMaxH); free(yRef);
    return ok;
}

// ============================================================
// AIV VF 自检（host）：构造输入 -> m3_vf_probe_kernel（复用生产 VF 函数）-> 判据
//   判定项（打印 `[M3-VF] <tag> : PASS (...)`，口径见 README）：
//   判定项共 9 条（口径与实测值见 README §6，那里是与印刷数字同源的清单）：
//     quant-pack / quant-scale   (T1) 合成 amax 网格的 nibble / scale 字节 vs host 镜像（floor/OCP）
//     scale-same / scale-diverge / scale-corner (T1) device 与 floor 一致、与 legacy ceil 的分歧对拍
//     e2m1-threshold             (T1) 阈值/平局/边界用例逐字节 + 16 个 code 全覆盖（CAST_ROUND 平局远离零）
//     scale-endpoint             (T1) 区间端点实测读数与解析分类一致
//     nonfinite                  (T1) ±Inf/NaN 组 -> byte 0xFF、code 全 0（官方 :401/:406/:413）
//     silu-t3                        逐元素 |h_dev - h_ref| <= eps*|h_ref| + 0.5*ulp(h_dev)
//   报告项（非判定）：silu(VL) 实测最大 ulp 与 T3 界占用、非有限元素数、同解/分歧/corner 组数
//   与 e2m1 code 覆盖集、mode 6 loop 落盘异常读数（mode 0 整行一次性 VF 的 h 落盘不可靠，
//   故不作判据；原因见 README §5.5）
// ============================================================

struct Dh {
    void* h;
    void* d;
};
static Dh allocDh(size_t bytes)
{
    Dh b{nullptr, nullptr};
    aclrtMallocHost(&b.h, bytes);
    aclrtMalloc(&b.d, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    return b;
}
static void freeDh(Dh& b)
{
    if (b.h != nullptr) aclrtFreeHost(b.h);
    if (b.d != nullptr) aclrtFree(b.d);
    b.h = nullptr;
    b.d = nullptr;
}

// ---- 主机侧浮点工具（不用 libm：本工程 host 段只链接编译期 builtin，见 README）----
static float Pow2F(int k)
{
    union { float f; uint32_t u; } v;
    v.u = (uint32_t)(k + 127) << 23;
    return v.f;
}
static float FAbsF(float x)
{
    union { float f; uint32_t u; } v;
    v.f = x;
    v.u &= 0x7FFFFFFFu;
    return v.f;
}
static bool IsFiniteF(float x)
{
    union { float f; uint32_t u; } v;
    v.f = x;
    return (v.u & 0x7F800000u) != 0x7F800000u;
}
static float NextUpF(float x)      // 仅对 x > 0 使用
{
    union { float f; uint32_t u; } v;
    v.f = x;
    v.u += 1u;
    return v.f;
}
static float NextDownF(float x)    // 仅对 x > 0 使用
{
    union { float f; uint32_t u; } v;
    v.f = x;
    v.u -= 1u;
    return v.f;
}
static float UlpF(float x)         // 正数 x 的 ulp（= 下一个可表示值 - x）
{
    return NextUpF(x) - x;
}

// legacy ceil 规范（M26 裁决前的 m3 标称规则 = tools/golden 的 quantize_ceil_legacy 的字节规则）：
// byte = E - 2 + (M > 0x400000)。仅用于自检对「device 已收敛到 floor」的对照分类，不参与 device 编码。
static uint8_t ScaleByteCeilOfAmax(float amax)
{
    if (!(amax > 0.0f)) return 0;
    union { float f; uint32_t u; } v;
    v.f = amax;
    return (uint8_t)((v.u >> 23) - 2u + ((v.u & 0x7FFFFFu) > 0x400000u ? 1u : 0u));
}

// floor/OCP 规范（device 现役 = m13/m5/m2 = 官方 ops-nn OCP）：byte = clip(E - 2, 0, 254)，E==255 -> 0xFF
// （= QuantScaleByteH；此处等价定义供自检的两规范分类使用，自检断言二者逐位一致）
static uint8_t ScaleByteFloorOfAmax(float amax) { return QuantScaleByteH(amax); }

// 同解区间解析判据：归一化且偏置指数 >= 129 时 ⟺ mantissa m = amax / 2^floor(log2 amax) <= 1.5
// ⟺ amax ∈ [4·2^k, 6·2^k]（含两端点）；偏置指数 < 129（amax < 4）或次正规/非有限时，ceil 的
// uint8 环绕与 floor 的 clamp 下界互相作用，改由「两条解析规范的字节比较」判定（仍与 device 无关）。
static bool RulesAgreeAnalytic(float amax)
{
    if (!(amax > 0.0f)) return true;                             // 0 组：两规范都给 0
    union { float f; uint32_t u; } v;
    v.f = amax;
    const uint32_t e = (v.u >> 23) & 0xFFu;
    if (e == 255u) {                                             // ±Inf/NaN：ceil 的环绕 vs floor 的 0xFF
        return ScaleByteCeilOfAmax(amax) == ScaleByteFloorOfAmax(amax);
    }
    if ((v.u & 0x7F800000u) == 0u || e < 129u) {                 // 次正规 / amax < 4
        return ScaleByteCeilOfAmax(amax) == ScaleByteFloorOfAmax(amax);
    }
    return ((v.u & 0x7FFFFFu) <= 0x400000u);
}

struct VfDump {
    std::vector<uint8_t> pack;   // [rows][DN_K/2]
    std::vector<uint8_t> scal;   // [rows][32]
    std::vector<float> h;        // [rows][DN_K]（mode 0 的 h dump）
    std::vector<uint8_t> b16;    // mode 0 输入：gate|up bf16
    std::vector<float> hIn;      // mode 1 输入：h fp32
    uint32_t rows = 0;
    uint32_t mode = 0;
};

static bool VfProbeRun(aclrtStream stream, const VfDump& in, VfDump& out, uint32_t itBase = 0)
{
    out.rows = in.rows;
    out.mode = in.mode;
    out.pack.assign((size_t)in.rows * (DN_K / 2), 0);
    out.scal.assign((size_t)in.rows * 32, 0);
    out.h.assign((size_t)in.rows * DN_K, 0.0f);
    const bool inIsB16 = (in.mode != 1);   // mode 0/3/4/5/6 输入是 gate|up bf16；mode 1 输入是 h fp32
    const size_t inBytes = inIsB16 ? (size_t)in.rows * GU_N * 2 : (size_t)in.rows * DN_K * 4;
    const size_t hBytes = (size_t)in.rows * DN_K * sizeof(float);
    Dh inD = allocDh(inBytes > 0 ? inBytes : 32);
    Dh hD = allocDh(hBytes > 0 ? hBytes : 32);
    Dh pD = allocDh(out.pack.size() > 0 ? out.pack.size() : 32);
    Dh sD = allocDh(out.scal.size() > 0 ? out.scal.size() : 32);
    if (inIsB16) {
        aclrtMemcpy(inD.d, inBytes, in.b16.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    } else {
        aclrtMemcpy(inD.d, inBytes, in.hIn.data(), inBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    }
    m3_vf_probe_kernel<<<1, nullptr, stream>>>((uint8_t*)inD.d, (uint8_t*)hD.d, (uint8_t*)pD.d, (uint8_t*)sD.d,
                                               in.rows, in.mode, itBase);
    const aclError err = aclrtSynchronizeStream(stream);
    bool ok = true;
    if (err != ACL_SUCCESS) {
        printf("[M3-VF][FAIL] probe launch/sync error %d (rows=%u mode=%u)\n", (int)err, in.rows, in.mode);
        ok = false;
    } else {
        aclrtMemcpy(out.pack.data(), out.pack.size(), pD.d, out.pack.size(), ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(out.scal.data(), out.scal.size(), sD.d, out.scal.size(), ACL_MEMCPY_DEVICE_TO_HOST);
        if (inIsB16 && hBytes > 0) {
            aclrtMemcpy(out.h.data(), hBytes, hD.d, hBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        }
    }
    freeDh(inD); freeDh(hD); freeDh(pD); freeDh(sD);
    return ok;
}

// ---- mode 1 输入：amax 网格（scale 规则 / 同解区间 / 端点）----
static std::vector<float> VfAmaxGrid()
{
    std::vector<float> g;
    const int ks[] = {0, -4, 4, -16, 16, 20};
    for (int ki = 0; ki < 6; ++ki) {
        const float p = Pow2F(ks[ki]);
        g.push_back(4.0f * p);                         // 同解区间左端点（m = 1.0）
        g.push_back(5.0f * p);                         // 同解区间内（m = 1.25）
        g.push_back(6.0f * p);                         // 同解区间右端点（m = 1.5，含等号）
        g.push_back(NextUpF(6.0f * p));   // 分歧区间起点（m > 1.5）
        g.push_back(7.0f * p);                         // 分歧区间内
        g.push_back(NextDownF(8.0f * p));       // 分歧区间终点（贴 8·2^k）
        g.push_back(8.0f * p);                         // 下一个同解区间左端点（m = 1.0）
        g.push_back(11.0f * p);                        // 同解区间内（m = 1.375）
        g.push_back(12.0f * p);                        // 同解区间右端点（m = 1.5）
        g.push_back(NextUpF(12.0f * p)); // 分歧区间起点
    }
    g.push_back(0.0f);           // 零组
    g.push_back(0x1p-130f);      // 次正规（E = 0）
    g.push_back(0x1p-126f);      // 最小正规（E = 1，官方 clamp 下界 -> byte 0）
    g.push_back(0x1p-40f);       // 小正常数
    g.push_back(3.0f);
    g.push_back(1.0f);
    g.push_back(2.5f);           // 尾数一般的值
    return g;
}

// 一行 20 组：组 g 的 amax 由 grid 决定，其余 31 个元素取 amax 的固定比例（覆盖正负/零/一般尾数）
static void VfBuildAmaxRow(std::vector<float>& row, const std::vector<float>& grid, size_t base, uint32_t seed)
{
    const uint32_t groups = DN_K / SCALE_GROUP;
    for (uint32_t g = 0; g < groups; ++g) {
        const float amax = grid[(base + g) % grid.size()];
        for (uint32_t j = 0; j < SCALE_GROUP; ++j) {
            const float frac = ((float)((Hash3(seed, j, 7u) % 16u) + 1u)) / 16.0f;
            float v = amax * frac;
            if ((Hash3(seed, j, 11u) & 1u) != 0u) v = -v;
            row[g * SCALE_GROUP + j] = v;
        }
        row[g * SCALE_GROUP] = amax;   // 组内 |max| 精确等于 amax
    }
}

// ---- mode 1 输入：e2m1 阈值/平局/边界用例（组 amax = 6.0 ⇒ scale byte 127 ⇒ halfScale = 2^0 = 1.0）----
static std::vector<float> VfThresholdValues()
{
    std::vector<float> v;
    const float thr[7] = {0.25f, 0.75f, 1.25f, 1.75f, 2.5f, 3.5f, 5.0f};
    for (int i = 0; i < 7; ++i) {
        v.push_back(thr[i]);
        v.push_back(NextDownF(thr[i]));   // 阈值下半 ulp -> 较小 code
        v.push_back(NextUpF(thr[i]));     // 阈值上半 ulp -> 较大 code
        v.push_back(-thr[i]);             // 负号侧：覆盖带符号 code（8..15）
        v.push_back(-NextDownF(thr[i]));
    }
    v.push_back(0.0f);
    v.push_back(-0.0f);
    v.push_back(6.0f);                            // e2m1 最大有限值（== 组 amax）
    v.push_back(-6.0f);                           // 负饱和端（|v| = 6 -> code 15）
    v.push_back(NextDownF(6.0f));
    v.push_back(0x1p-20f);                        // 近零 -> code 0
    v.push_back(-0x1p-20f);
    return v;
}

// ============================================================
// VF 自检主流程
// ============================================================
static bool H_RunVfSelfTest(aclrtStream stream)
{
    bool ok = true;
    const uint32_t groups = DN_K / SCALE_GROUP;

    // ---------- mode 1：amax 网格（quant-pack / quant-scale / scale-same / scale-diverge）----------
    {
        const uint32_t rows = 8;
        VfDump in;
        in.rows = rows;
        in.mode = 1;
        in.hIn.assign((size_t)rows * DN_K, 0.0f);
        std::vector<float> grid = VfAmaxGrid();
        std::vector<float> row(DN_K, 0.0f);
        for (uint32_t r = 0; r < rows; ++r) {
            VfBuildAmaxRow(row, grid, (size_t)r * groups, r + 1u);
            memcpy(&in.hIn[(size_t)r * DN_K], row.data(), DN_K * sizeof(float));
        }
        VfDump out;
        ok &= VfProbeRun(stream, in, out);

        uint32_t packMis = 0, scalMis = 0, nSame = 0, nDiverge = 0, nCorner = 0, nZeroGroup = 0;
        uint32_t classMis = 0, sameMis = 0, divMis = 0, cornerMis = 0;
        for (uint32_t r = 0; r < rows; ++r) {
            const float* h = &in.hIn[(size_t)r * DN_K];
            uint8_t packRef[DN_K / 2];
            uint8_t scalRef[32];
            memset(scalRef, 0, sizeof(scalRef));
            QuantRowH(h, packRef, scalRef);   // host 镜像（floor/OCP + CAST_ROUND）
            for (uint32_t b = 0; b < DN_K / 2; ++b) {
                if (packRef[b] != out.pack[(size_t)r * (DN_K / 2) + b]) ++packMis;
            }
            for (uint32_t g = 0; g < groups; ++g) {
                const uint8_t got = out.scal[(size_t)r * 32 + g];
                if (scalRef[g] != got) ++scalMis;
                float amax = 0.0f;
                for (uint32_t j = 0; j < SCALE_GROUP; ++j) {
                    const float a = FAbsF(h[g * SCALE_GROUP + j]);
                    amax = a > amax ? a : amax;
                }
                if (amax == 0.0f) ++nZeroGroup;
                // 自检一致性：exponent 域 floor（device/QuantRowH 用）与值域 floor 必须逐位一致（有限输入）
                uint32_t maxExp = 0;
                for (uint32_t j = 0; j < SCALE_GROUP; ++j) {
                    union { float f; uint32_t u; } x;
                    x.f = h[g * SCALE_GROUP + j];
                    const uint32_t e = x.u & 0x7F800000u;
                    maxExp = e > maxExp ? e : maxExp;
                }
                const uint8_t floorB = ScaleByteFloorOfAmax(amax);
                if (ScaleByteOfExpBitsH(maxExp) != floorB) {
                    printf("[M3-VF][FAIL] 镜像内部不一致: 值域 floor != exponent 域 floor amax=%a\n", (double)amax);
                    ++classMis;
                }
                const uint8_t ceilB = ScaleByteCeilOfAmax(amax);
                const bool agree = RulesAgreeAnalytic(amax);
                if (agree != (ceilB == floorB)) {
                    if (classMis < 4) {
                        printf("[M3-VF][FAIL] 解析分类 != 规范字节分类 r=%u g=%u amax=%a ceil=%u floor=%u\n",
                               r, g, (double)amax, ceilB, floorB);
                    }
                    ++classMis;
                }
                const bool same = (ceilB == floorB);
                const bool div1 = (!same) && ((uint32_t)ceilB == (uint32_t)floorB + 1u);
                if (same) {
                    ++nSame;
                    if (got != floorB) {
                        if (sameMis < 4) {
                            printf("[M3-VF][FAIL] 同解区间 device != floor(==ceil) r=%u g=%u amax=%a got=%u ceil=%u floor=%u\n",
                                   r, g, (double)amax, got, ceilB, floorB);
                        }
                        ++sameMis;
                    }
                } else if (div1) {
                    ++nDiverge;
                    if (got != floorB) {
                        if (divMis < 4) {
                            printf("[M3-VF][FAIL] 分歧区间 device != floor(==ceil-1) r=%u g=%u amax=%a got=%u ceil=%u floor=%u\n",
                                   r, g, (double)amax, got, ceilB, floorB);
                        }
                        ++divMis;
                    }
                } else {   // clamp 角落（次正规 / E <= 2 / 非有限）：ceil 的 uint8 环绕 vs floor 的 clamp/0xFF
                    ++nCorner;
                    if (got != floorB) {
                        if (cornerMis < 4) {
                            printf("[M3-VF][FAIL] clamp 角落 device != floor r=%u g=%u amax=%a got=%u ceil=%u floor=%u\n",
                                   r, g, (double)amax, got, ceilB, floorB);
                        }
                        ++cornerMis;
                    }
                }
            }
        }
        const bool p1 = (packMis == 0), p2 = (scalMis == 0), p4 = (sameMis == 0 && classMis == 0),
                   p5 = (divMis == 0), p6 = (cornerMis == 0);
        printf("[M3-VF] quant-pack     : %s (%u/%zu 字节不符)\n", p1 ? "PASS" : "FAIL", packMis,
               (size_t)rows * (DN_K / 2));
        printf("[M3-VF] quant-scale    : %s (%u/%u 字节不符)\n", p2 ? "PASS" : "FAIL", scalMis, rows * groups);
        printf("[M3-VF] scale-same     : %s (%u 组同解区间 device == floor == ceil)\n", p4 ? "PASS" : "FAIL", nSame);
        printf("[M3-VF] scale-diverge  : %s (%u 组分歧区间 device == floor == ceil-1)\n", p5 ? "PASS" : "FAIL", nDiverge);
        printf("[M3-VF] scale-corner   : %s (%u 组 clamp 角落 device == floor)\n", p6 ? "PASS" : "FAIL", nCorner);
        printf("[M3-VF] 报告项: 同解组 %u / 分歧组 %u / clamp 角落 %u / 零组 %u（共 %u 组）\n", nSame, nDiverge,
               nCorner, nZeroGroup, rows * groups);
        ok &= p1 && p2 && p4 && p5 && p6;
    }

    // ---------- mode 1：e2m1 阈值/平局（e2m1-threshold）----------
    {
        std::vector<float> thrVals = VfThresholdValues();
        const uint32_t perRow = groups * (SCALE_GROUP - 1);
        const uint32_t rows = (uint32_t)((thrVals.size() + perRow - 1) / perRow);
        VfDump in;
        in.rows = rows;
        in.mode = 1;
        in.hIn.assign((size_t)rows * DN_K, 0.0f);
        for (uint32_t r = 0; r < rows; ++r) {
            for (uint32_t g = 0; g < groups; ++g) {
                in.hIn[(size_t)r * DN_K + g * SCALE_GROUP] = 6.0f;   // 组 amax = 6.0
            }
        }
        // lane0 保持 6.0（组 amax），crafted 值放 lane 1..31（不得 >= 7，否则改组 amax）
        for (size_t i = 0; i < thrVals.size(); ++i) {
            const uint32_t r = (uint32_t)(i / (groups * (SCALE_GROUP - 1)));
            const uint32_t rem = (uint32_t)(i % (groups * (SCALE_GROUP - 1)));
            const uint32_t g = rem / (SCALE_GROUP - 1);
            const uint32_t j = 1u + rem % (SCALE_GROUP - 1);
            in.hIn[(size_t)r * DN_K + g * SCALE_GROUP + j] = thrVals[i];
        }
        VfDump out;
        ok &= VfProbeRun(stream, in, out);
        uint32_t mis = 0;
        for (uint32_t r = 0; r < rows; ++r) {
            uint8_t packRef[DN_K / 2];
            uint8_t scalRef[32];
            memset(scalRef, 0, sizeof(scalRef));
            QuantRowH(&in.hIn[(size_t)r * DN_K], packRef, scalRef);
            for (uint32_t b = 0; b < DN_K / 2; ++b) {
                if (packRef[b] != out.pack[(size_t)r * (DN_K / 2) + b]) ++mis;
            }
            for (uint32_t b = 0; b < groups; ++b) {
                if (scalRef[b] != out.scal[(size_t)r * 32 + b]) ++mis;
            }
        }
        uint32_t codeSeen = 0;
        std::string codeList;
        for (uint32_t c = 0; c < 16; ++c) {
            bool seen = false;
            for (size_t b = 0; b < out.pack.size() && !seen; ++b) {
                if ((uint32_t)(out.pack[b] & 0xFu) == c || (uint32_t)(out.pack[b] >> 4) == c) seen = true;
            }
            if (seen) { ++codeSeen; codeList += std::to_string(c) + " "; }
        }
        printf("[M3-VF] 报告项: e2m1 code 覆盖集 = {%s}\n", codeList.c_str());
        const bool pass = (mis == 0 && codeSeen == 16);
        printf("[M3-VF] e2m1-threshold : %s (%u 字节不符, code 覆盖 %u/16)\n", pass ? "PASS" : "FAIL", mis, codeSeen);
        ok &= pass;
    }

    // ---------- mode 1：区间端点实测（scale-endpoint）----------
    {
        std::vector<const char*> names;
        std::vector<float> amaxs;
        const int ks[] = {0, -8, 8, 20};
        for (int i = 0; i < 4; ++i) {
            const float p = Pow2F(ks[i]);
            names.push_back("4*2^k");      amaxs.push_back(4.0f * p);
            names.push_back("5*2^k");      amaxs.push_back(5.0f * p);
            names.push_back("6*2^k");      amaxs.push_back(6.0f * p);
            names.push_back("6*2^k+1ulp"); amaxs.push_back(NextUpF(6.0f * p));
            names.push_back("7*2^k");      amaxs.push_back(7.0f * p);
            names.push_back("8*2^k-1ulp"); amaxs.push_back(NextDownF(8.0f * p));
            names.push_back("8*2^k");      amaxs.push_back(8.0f * p);
        }
        const uint32_t rows = (uint32_t)amaxs.size();
        VfDump in;
        in.rows = rows;
        in.mode = 1;
        in.hIn.assign((size_t)rows * DN_K, 0.0f);
        for (uint32_t r = 0; r < rows; ++r) {
            for (uint32_t g = 0; g < groups; ++g) {
                in.hIn[(size_t)r * DN_K + g * SCALE_GROUP] = amaxs[r];   // 组 amax 精确 = 端点值
            }
        }
        VfDump out;
        ok &= VfProbeRun(stream, in, out);
        uint32_t bad = 0;
        printf("[M3-VF] scale-endpoint 实测读数（k = %d/%d/%d/%d；device / floor / ceil / 解析分类）:\n",
               ks[0], ks[1], ks[2], ks[3]);
        for (uint32_t r = 0; r < rows; ++r) {
            const uint8_t got = out.scal[(size_t)r * 32];   // 20 组 amax 相同，取第 0 组
            const uint8_t ceilB = ScaleByteCeilOfAmax(amaxs[r]);
            const uint8_t floorB = ScaleByteFloorOfAmax(amaxs[r]);
            const bool agree = RulesAgreeAnalytic(amaxs[r]);
            const bool rowOk = (got == floorB) && (agree == (ceilB == floorB));
            if (!rowOk) ++bad;
            printf("  [M3-VF] %-12s amax=%a device=%3u floor=%3u ceil=%3u 解析=%s %s\n", names[r],
                   (double)amaxs[r], got, floorB, ceilB, agree ? "同解" : "分歧", rowOk ? "OK" : "MISMATCH");
        }
        printf("[M3-VF] scale-endpoint  : %s (%u/%u 端点读数与解析分类一致)\n", bad == 0 ? "PASS" : "FAIL",
               rows - bad, rows);
        ok &= (bad == 0);
    }

    // ---------- mode 1：非有限组（nonfinite）：±Inf/NaN 组 -> byte 0xFF、code 全 0 ----------
    {
        const uint32_t rows = 4;
        const float kNaN = [] { union { uint32_t u; float f; } v; v.u = 0x7FC00000u; return v.f; }();
        const float kNegNaN = [] { union { uint32_t u; float f; } v; v.u = 0xFFC00000u; return v.f; }();
        VfDump in;
        in.rows = rows;
        in.mode = 1;
        in.hIn.assign((size_t)rows * DN_K, 0.0f);
        for (uint32_t g = 0; g < groups; ++g) {
            for (uint32_t j = 0; j < SCALE_GROUP; ++j) {
                in.hIn[(size_t)0 * DN_K + g * SCALE_GROUP + j] = INFINITY;                       // 整组 +Inf
                in.hIn[(size_t)1 * DN_K + g * SCALE_GROUP + j] = (j == 0) ? INFINITY : 0.5f;     // 组内混 +Inf
                in.hIn[(size_t)2 * DN_K + g * SCALE_GROUP + j] = (j & 1u) ? kNaN : kNegNaN;      // ±NaN
                in.hIn[(size_t)3 * DN_K + g * SCALE_GROUP + j] = (j == 0) ? -INFINITY : -0.25f;  // 组内混 -Inf
            }
        }
        VfDump out;
        ok &= VfProbeRun(stream, in, out);
        uint32_t misPack = 0, misScal = 0, badByte = 0, badCode = 0;
        for (uint32_t r = 0; r < rows; ++r) {
            uint8_t packRef[DN_K / 2];
            uint8_t scalRef[32];
            memset(scalRef, 0, sizeof(scalRef));
            QuantRowH(&in.hIn[(size_t)r * DN_K], packRef, scalRef);
            for (uint32_t b = 0; b < DN_K / 2; ++b) {
                if (packRef[b] != out.pack[(size_t)r * (DN_K / 2) + b]) ++misPack;
                if (out.pack[(size_t)r * (DN_K / 2) + b] != 0u) ++badCode;
            }
            for (uint32_t g = 0; g < groups; ++g) {
                const uint8_t got = out.scal[(size_t)r * 32 + g];
                if (scalRef[g] != got) ++misScal;
                if (got != 0xFFu) ++badByte;
            }
        }
        const bool pass = (misPack == 0 && misScal == 0 && badByte == 0 && badCode == 0);
        printf("[M3-VF] nonfinite      : %s (%u/%u scale 字节!=0xFF, %u/%zu nibble 字节!=0, "
               "pack %u / scale %u 与镜像不符)\n",
               pass ? "PASS" : "FAIL", badByte, rows * groups, badCode, (size_t)rows * (DN_K / 2),
               misPack, misScal);
        ok &= pass;
    }

    // ---------- silu 路：T3 逐元素（mode 9 单 VL） + 整行 loop 落盘异常报告 ----------
    {
        const uint32_t rows = 16;
        const float gScale[8] = {1.0f, 20.0f, 0.01f, 60.0f, 5.0f, 0.2f, 2.0f, 40.0f};
        const float uScale[8] = {1.0f, 8.0f, 0.01f, 0.5f, 2.0f, 0.05f, 16.0f, 0.3f};
        VfDump in;
        in.rows = rows;
        in.mode = 9;
        in.b16.assign((size_t)rows * GU_N * 2, 0);
        std::vector<float> gateF((size_t)rows * DN_K, 0.0f), upF((size_t)rows * DN_K, 0.0f);
        for (uint32_t r = 0; r < rows; ++r) {
            const uint32_t fl = r % 8u;
            for (uint32_t j = 0; j < DN_K; ++j) {
                const int32_t gi = (int32_t)(Hash3(r + 1u, j, 3u) % 2001u) - 1000;
                const int32_t ui = (int32_t)(Hash3(r + 1u, j, 5u) % 2001u) - 1000;
                const float g = (float)gi / 1000.0f * gScale[fl];
                const float u = (float)ui / 1000.0f * uScale[fl];
                const uint16_t gb = FloatToBf16(g), ub = FloatToBf16(u);
                in.b16[(size_t)r * GU_N * 2 + j * 2] = (uint8_t)(gb & 0xFFu);
                in.b16[(size_t)r * GU_N * 2 + j * 2 + 1] = (uint8_t)(gb >> 8);
                in.b16[(size_t)r * GU_N * 2 + (DN_K + j) * 2] = (uint8_t)(ub & 0xFFu);
                in.b16[(size_t)r * GU_N * 2 + (DN_K + j) * 2 + 1] = (uint8_t)(ub >> 8);
                gateF[(size_t)r * DN_K + j] = Bf16ToFloat(gb);
                upF[(size_t)r * DN_K + j] = Bf16ToFloat(ub);
            }
        }
        // ---- T3（判定项）：逐 VL 独立发射（mode 9）覆盖全部 10×16 个 VL 的 h ----
        //  说明：整行一次 VF 落盘在 >5 次 256B 落盘时会丢尾部（见 README「VF 落盘 loop 异常」），
        //  故 T3 逐元素检查改用「一个 VF 只落一个 VL」的等价形式（指令序列与生产路径逐条相同）。
        uint32_t nOut9 = 0, nElem9 = 0, nNonFin9 = 0;
        double maxUlp9 = 0.0, maxOcc9 = 0.0;
        {
            VfDump in9 = in;
            in9.mode = 9;
            for (uint32_t it = 0; it < VF_ITER; ++it) {
                VfDump out9;
                if (!VfProbeRun(stream, in9, out9, it * VF_LANE_F32)) { ok = false; break; }
                for (uint32_t r = 0; r < rows; ++r) {
                    for (uint32_t j = it * VF_LANE_F32; j < (it + 1) * VF_LANE_F32; ++j) {
                        const float g = gateF[(size_t)r * DN_K + j];
                        const float u = upF[(size_t)r * DN_K + j];
                        float silu = (float)SiluD((double)g);
                        if (!IsFiniteF(silu)) silu = (g > 0.0f) ? g : 0.0f;
                        const float hr = silu * u;
                        const float hd = out9.h[(size_t)r * DN_K + j];
                        if (!IsFiniteF(hd) || !IsFiniteF(hr)) {
                            ++nNonFin9;
                            continue;
                        }
                        ++nElem9;
                        const double bound = M3_VF_SILU_EPS * (double)FAbsF(hr) +
                                             0.5 * (double)UlpF(FAbsF(hd));
                        const double dev = fabs((double)hd - (double)hr);
                        if (dev > bound) {
                            if (nOut9 < 8) {
                                printf("[M3-VF][FAIL] silu-t3(VL) r=%u j=%u gate=%a up=%a h_dev=%a h_ref=%a |d|=%.3e bound=%.3e\n",
                                       r, j, (double)g, (double)u, (double)hd, (double)hr, dev, bound);
                            }
                            ++nOut9;
                        }
                        if (bound > 0.0) {
                            const double occ = dev / bound;
                            if (occ > maxOcc9) maxOcc9 = occ;
                        }
                        const double ulp = (double)UlpF(FAbsF(hr));
                        if (ulp > 0.0) {
                            const double uu = fabs((double)hd - (double)hr) / ulp;
                            if (uu > maxUlp9) maxUlp9 = uu;
                        }
                    }
                }
            }
        }
        const bool p7 = (nOut9 == 0);
        printf("[M3-VF] silu-t3(VL)    : %s (ε=2^-21=%.6e；%u/%u 元素超界)\n", p7 ? "PASS" : "FAIL", M3_VF_SILU_EPS,
               nOut9, nElem9);
        printf("[M3-VF] 报告项: silu(VL) max |Δ| = %.3f ulp、T3 界最大占用 %.3f、非有限元素 %u\n", maxUlp9, maxOcc9,
               nNonFin9);
        // 报告项：§5.5 的 VF 落盘 loop 异常最小复现（mode 6 = 仅 load+cast+落 256B，10 次迭代）
        {
            VfDump in6 = in;
            in6.mode = 6;
            VfDump out6;
            if (VfProbeRun(stream, in6, out6)) {
                uint32_t landed = 0;
                for (uint32_t it = 0; it < VF_ITER; ++it) {
                    bool all = true;
                    for (uint32_t j = it * VF_LANE_F32; j < (it + 1) * VF_LANE_F32; ++j) {
                        if (out6.h[j] != gateF[j]) { all = false; break; }
                    }
                    if (all) ++landed;
                }
                printf("[M3-VF] 报告项: mode 6（仅 load+cast+落 64 fp32）10 次迭代中前 %u 次逐位可见"
                       "（尾部未落到 UB，见 README §5.5 / tower finding）\n", landed);
            }
        }
        ok &= p7;
    }
    return ok;
}

// ---- mode 2 驱动：VF 原语语义实测（诊断，不参与判定）----
static void H_RunVfPrimProbe(aclrtStream stream)
{
    const uint32_t NH = 448, NP = 64, NS = 32;
    std::vector<float> in(128);
    for (uint32_t i = 0; i < 128; ++i) in[i] = (float)i;
    std::vector<float> h(NH, -1.0f);
    std::vector<uint8_t> pack(NP, 0xEEu), scal(NS, 0xEEu);

    Dh inD = allocDh(128 * sizeof(float));
    Dh hD = allocDh(NH * sizeof(float));
    Dh pD = allocDh(NP);
    Dh sD = allocDh(NS);
    aclrtMemcpy(inD.d, 128 * sizeof(float), in.data(), 128 * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(hD.d, NH * sizeof(float), h.data(), NH * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(pD.d, NP, pack.data(), NP, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(sD.d, NS, scal.data(), NS, ACL_MEMCPY_HOST_TO_DEVICE);
    m3_vf_prim_kernel<<<1, nullptr, stream>>>((uint8_t*)inD.d, (uint8_t*)hD.d, (uint8_t*)pD.d, (uint8_t*)sD.d);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("[M3-VF][FAIL] prim probe launch/sync error %d\n", (int)err);
        freeDh(inD); freeDh(hD); freeDh(pD); freeDh(sD);
        return;
    }
    aclrtMemcpy(h.data(), NH * sizeof(float), hD.d, NH * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(pack.data(), NP, pD.d, NP, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(scal.data(), NS, sD.d, NS, ACL_MEMCPY_DEVICE_TO_HOST);
    freeDh(inD); freeDh(hD); freeDh(pD); freeDh(sD);

    printf("[M3-VF] prim: 输入 ramp = 0..127\n");
    printf("[M3-VF] prim: DIST_DINTLV_B32 dst0[0..7] = ");
    for (int i = 0; i < 8; ++i) printf("%.0f ", (double)h[i]);
    printf("  dst1[0..7] = ");
    for (int i = 0; i < 8; ++i) printf("%.0f ", (double)h[64 + i]);
    printf("\n");
    printf("[M3-VF] prim: Reduce<MAX> lane0: ALL=%.0f VL32=%.0f H=%.0f （期望 63 / 31 / 32或63）\n",
           (double)h[128], (double)h[192], (double)h[256]);
    printf("[M3-VF] prim: Select(1.0,2.0,VL32) lane0=%.0f lane31=%.0f lane32=%.0f lane63=%.0f\n",
           (double)h[320], (double)h[320 + 31], (double)h[320 + 32], (double)h[320 + 63]);
    printf("[M3-VF] prim: Duplicate<LOWEST> lane0=%.0f lane1=%.0f lane63=%.0f （期望 7 7 7）\n",
           (double)h[384], (double)h[385], (double)h[384 + 63]);
    printf("[M3-VF] prim: DIST_PACK4_B32(code=lane%%16) 前 16 字节 = ");
    for (int i = 0; i < 16; ++i) printf("%02x ", pack[i]);
    printf("（若 lane2i->低半字节 则 10 32 54 76 98 ba dc fe ...）\n");
    printf("[M3-VF] prim: Store<uint8_t>(u32 lane0=0x201, count=2) 前 4 字节 = %02x %02x %02x %02x （期望 01 02 ee ee）\n",
           scal[0], scal[1], scal[2], scal[3]);
}


static bool H_VfProbeVsProduction(aclrtStream stream, uint32_t m, const uint8_t* guH, const uint8_t* hpH,
                                  const uint8_t* hsH, const uint32_t* cnt)
{
    uint32_t rows = 0, misPack = 0, misScal = 0;
    for (uint32_t s = 0; s < E_SLOTS; ++s) {
        const uint32_t t = cnt[s];
        if (t == 0) continue;
        rows += t;
        VfDump in;
        in.rows = t;
        in.mode = 9;                      // 单 VL 一发射（与生产同一份 VF 函数，逐 VL 组装）
        in.b16.assign((size_t)t * GU_N * 2, 0);
        memcpy(in.b16.data(), guH + (size_t)s * MAXM * GU_N * 2, (size_t)t * GU_N * 2);
        std::vector<uint8_t> packAsm((size_t)t * (DN_K / 2), 0), scalAsm((size_t)t * 32, 0);
        for (uint32_t it = 0; it < VF_ITER; ++it) {
            VfDump out;
            if (!VfProbeRun(stream, in, out, it * VF_LANE_F32)) return false;
            for (uint32_t r = 0; r < t; ++r) {
                for (uint32_t b = 0; b < SCALE_GROUP; ++b) {   // 每 VL 32B
                    packAsm[(size_t)r * (DN_K / 2) + it * SCALE_GROUP + b] =
                        out.pack[(size_t)r * (DN_K / 2) + it * SCALE_GROUP + b];
                }
                scalAsm[(size_t)r * 32 + 2 * it] = out.scal[(size_t)r * 32 + 2 * it];
                scalAsm[(size_t)r * 32 + 2 * it + 1] = out.scal[(size_t)r * 32 + 2 * it + 1];
            }
        }
        for (uint32_t r = 0; r < t; ++r) {
            for (uint32_t b = 0; b < DN_K / 2; ++b) {
                const uint8_t got = packAsm[(size_t)r * (DN_K / 2) + b];
                const uint8_t ref = hpH[((size_t)s * MAXM + r) * (DN_K / 2) + b];
                if (got != ref) ++misPack;
            }
            for (uint32_t b = 0; b < DN_K / SCALE_GROUP; ++b) {
                const uint8_t got = scalAsm[(size_t)r * 32 + b];
                const uint8_t ref = hsH[((size_t)s * MAXM + r) * 32 + b];
                if (got != ref) ++misScal;
            }
        }
    }
    const bool pass = (misPack == 0 && misScal == 0);
    printf("[M3-VF] probe==production (m=%u, %u 行): %s (%u pack / %u scale 字节不符)\n", m, rows,
           pass ? "PASS" : "FAIL", misPack, misScal);
    return pass;
}

// ---- 子命令 vf-dump <dir>：把「生产同一份 VF 量化器」的 device 输出落盘，供 offline 与
//      m13_moe_layer/check_ref.py 的 quant_mxfp4_hw、tools/golden 的 quantize_ocp（独立见证）
//      逐字节对拍（脚本 m3_grouped_gemm/check_m13_cross.py）。
//      输入全部是 bf16 网格值（量化器输入域；官方量化器输入为 bf16），并有端点/退化/非有限用例。
static int32_t H_RunQuantDump(aclrtStream stream, const char* dir)
{
    const uint32_t rows = 128;
    const uint32_t groups = DN_K / SCALE_GROUP;
    std::vector<float> h((size_t)rows * DN_K, 0.0f);
    const float kNaN = [] { union { uint32_t u; float f; } v; v.u = 0x7FC00000u; return v.f; }();
    const float kNegNaN = [] { union { uint32_t u; float f; } v; v.u = 0xFFC00000u; return v.f; }();

    // 1) 行 0..63：确定性 bf16 网格随机值（指数档 120..139，随机符号/尾数）
    for (uint32_t r = 0; r < 64; ++r) {
        for (uint32_t j = 0; j < DN_K; ++j) {
            const uint32_t hv = Hash3(r, j, 0x51u);
            uint32_t bits = ((120u + (hv % 20u)) << 23) | ((hv >> 8) & 0x7FFFFFu);
            if ((hv & 1u) != 0u) bits |= 0x80000000u;
            float f;
            __builtin_memcpy(&f, &bits, 4);
            h[(size_t)r * DN_K + j] = Bf16ToFloat(FloatToBf16(f));
        }
    }
    // 2) 行 64..79：逐组端点（4/5/6/6+1ulp/7/8-1ulp/8 · 2^k），组 amax 精确命中
    {
        std::vector<float> vals;
        const int ks[] = {0, -8, 8, 20, -4};
        for (int ki = 0; ki < 5; ++ki) {
            const float p = Pow2F(ks[ki]);
            vals.push_back(4.0f * p); vals.push_back(5.0f * p); vals.push_back(6.0f * p);
            vals.push_back(NextUpF(6.0f * p)); vals.push_back(7.0f * p);
            vals.push_back(NextDownF(8.0f * p)); vals.push_back(8.0f * p);
        }
        for (uint32_t r = 0; r < 16; ++r) {
            for (uint32_t g = 0; g < groups; ++g) {
                const float amax = vals[(r * groups + g) % vals.size()];
                for (uint32_t j = 0; j < SCALE_GROUP; ++j) {
                    const float frac = ((float)((Hash3(r + 1u, j, 7u) % 16u) + 1u)) / 16.0f;
                    float v = amax * frac;
                    if ((Hash3(r + 1u, j, 11u) & 1u) != 0u) v = -v;
                    h[(size_t)(64 + r) * DN_K + g * SCALE_GROUP + j] = Bf16ToFloat(FloatToBf16(v));
                }
                h[(size_t)(64 + r) * DN_K + g * SCALE_GROUP] = Bf16ToFloat(FloatToBf16(amax));
            }
        }
    }
    // 3) 行 80..95：退化 / 非有限 / -0 用例（每行一种组 amax）
    {
        const float specials[16] = {0.0f, -0.0f, 0x1p-130f, 0x1p-126f, INFINITY, -INFINITY, kNaN, kNegNaN,
                                    1.0f, 1.0f, 6.0f, 0.5f, -0.0f, 2.0f, -1.0f, 0.0f};
        for (uint32_t r = 0; r < 16; ++r) {
            const uint32_t rr = 80 + r;
            const float amax = specials[r];
            for (uint32_t g = 0; g < groups; ++g) {
                for (uint32_t j = 0; j < SCALE_GROUP; ++j) {
                    float v = amax;
                    if (r == 8 || r == 9) v = (j == 0) ? INFINITY : 0.5f;          // 组内混 Inf + 正规
                    if (r == 10 || r == 11) v = (j == 0) ? -INFINITY : 0.25f;      // 组内混 -Inf + 正规
                    if (r == 12) v = (j & 1u) ? -0.0f : 0.0f;                      // ±0 混合
                    if (r == 13) v = (j & 1u) ? kNaN : kNegNaN;                    // ±NaN
                    if (r == 14 && j != 0) v = -v;
                    if ((Hash3(rr, j, 13u) & 1u) != 0u && amax == 0.0f && (r == 0 || r == 15)) v = -v; // -0 组
                    h[(size_t)rr * DN_K + g * SCALE_GROUP + j] = v;
                }
            }
        }
    }
    // 4) 行 96..127：另一批 bf16 网格随机值（独立 salt，覆盖更高指数档）
    for (uint32_t r = 96; r < 128; ++r) {
        for (uint32_t j = 0; j < DN_K; ++j) {
            const uint32_t hv = Hash3(r, j, 0x77u);
            uint32_t bits = ((124u + (hv % 12u)) << 23) | ((hv >> 9) & 0x7FFFFFu);
            if ((hv & 1u) != 0u) bits |= 0x80000000u;
            float f;
            __builtin_memcpy(&f, &bits, 4);
            h[(size_t)r * DN_K + j] = Bf16ToFloat(FloatToBf16(f));
        }
    }

    VfDump in;
    in.rows = rows;
    in.mode = 1;
    in.hIn = h;
    VfDump out;
    if (!VfProbeRun(stream, in, out)) {
        printf("[M3-VF][FAIL] vf-dump probe run failed\n");
        return 1;
    }

    char path[512];
    auto writeFile = [&](const char* name, const void* data, size_t bytes) -> bool {
        snprintf(path, sizeof(path), "%s/%s", dir, name);
        FILE* f = fopen(path, "wb");
        if (!f) { printf("[M3-VF][FAIL] cannot write %s\n", path); return false; }
        const bool okW = (fwrite(data, 1, bytes, f) == bytes);
        fclose(f);
        return okW;
    };
    // scale 只落**有效 groups 字节/行**：device 行缓冲是 32B（20 有效），尾部 padding 是陈旧 UB，
    // 落盘就不确定 ⇒ 只落有效字节，使产物（含 sha256）可复现；比较脚本也从 meta 读 scale_row_stride。
    std::vector<uint8_t> scalCompact((size_t)rows * groups);
    for (uint32_t r = 0; r < rows; ++r) {
        memcpy(&scalCompact[(size_t)r * groups], &out.scal[(size_t)r * 32], groups);
    }
    bool w = true;
    w &= writeFile("h.bin", h.data(), h.size() * sizeof(float));
    w &= writeFile("pack_dev.bin", out.pack.data(), out.pack.size());
    w &= writeFile("scale_dev.bin", scalCompact.data(), scalCompact.size());
    snprintf(path, sizeof(path), "%s/meta.txt", dir);
    FILE* fm = fopen(path, "w");
    if (fm) {
        fprintf(fm, "rows=%u\nk=%u\ngroup=%u\npack_row_stride=%u\nscale_row_stride=%u\n",
                rows, DN_K, SCALE_GROUP, DN_K / 2, groups);
        fclose(fm);
    } else {
        w = false;
    }
    printf("[M3-VF] vf-dump: %s（rows=%u，k=%u）；pack/scale 取自生产同一份 VF 量化器\n",
           w ? "OK" : "FAIL", rows, DN_K);
    return w ? 0 : 1;
}

int32_t main(int32_t argc, char** argv)
{
    int64_t aicNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("[M3] aclrtGetDeviceInfo(AICORE_CORE_NUM) failed, fallback 28\n");
        aicNum = 28;
    }
    const uint32_t numBlocks = (uint32_t)aicNum;
    printf("[M3] numBlocks(AIC) = %u\n", numBlocks);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // ---- 子命令 vf-probe：只跑 AIV VF 自检（不需要数据集，秒级）----
    if (argc >= 2 && std::string(argv[1]) == "vf-prim") {
        H_RunVfPrimProbe(stream);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return 0;
    }
    if (argc >= 2 && std::string(argv[1]) == "vf-probe") {
        const bool vfOk = H_RunVfSelfTest(stream);
        printf("[M3] ===== VF SELFTEST %s =====\n", vfOk ? "ALL PASS" : "FAILURES PRESENT");
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return vfOk ? 0 : 1;
    }
    // ---- 子命令 vf-dump <dir>：落盘合成输入的 device 量化输出（供 check_m13_cross.py 对拍）----
    if (argc >= 2 && std::string(argv[1]) == "vf-dump") {
        const char* dir = (argc >= 3) ? argv[2] : "m3_grouped_gemm/evidence/quant_cross";
        const int32_t rc = H_RunQuantDump(stream, dir);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return rc;
    }

    // ---- 权重（真实 checkpoint 切片）----
    char path[512];
    auto loadW = [&](const char* name, size_t bytes) {
        snprintf(path, sizeof(path), "%s/%s.bin", kDataDir, name);
        return LoadBin(path, bytes);
    };
    uint8_t* wguH = loadW("experts.gate_up_proj", (size_t)E_SLOTS * GU_N * (GU_K / 2));
    uint8_t* wguSH = loadW("experts.gate_up_proj.weight_scale", (size_t)E_SLOTS * GU_N * (GU_K / SCALE_GROUP));
    uint8_t* wdnH = loadW("experts.down_proj", (size_t)E_SLOTS * DN_N * (DN_K / 2));
    uint8_t* wdnSH = loadW("experts.down_proj.weight_scale", (size_t)E_SLOTS * DN_N * (DN_K / SCALE_GROUP));

    // ---- device buffer ----
    const size_t actBytes = (size_t)E_SLOTS * MAXM * (GU_K / 2);
    const size_t actSBytes = (size_t)E_SLOTS * MAXM * (GU_K / SCALE_GROUP);
    const size_t guBytes = (size_t)E_SLOTS * MAXM * GU_N * 2;
    const size_t hpBytes = (size_t)E_SLOTS * MAXM * (DN_K / 2);
    const size_t hsBytes = (size_t)E_SLOTS * MAXM * 32;
    const size_t yBytes = (size_t)E_SLOTS * MAXM * DN_N * 2;
    const size_t wguBytes = (size_t)E_SLOTS * GU_N * (GU_K / 2);
    const size_t wguSBytes = (size_t)E_SLOTS * GU_N * (GU_K / SCALE_GROUP);
    const size_t wdnBytes = (size_t)E_SLOTS * DN_N * (DN_K / 2);
    const size_t wdnSBytes = (size_t)E_SLOTS * DN_N * (DN_K / SCALE_GROUP);

    Dh act = allocDh(actBytes), actS = allocDh(actSBytes), counts = allocDh(E_SLOTS * 4);
    Dh gu = allocDh(guBytes), hp = allocDh(hpBytes), hs = allocDh(hsBytes), y = allocDh(yBytes);
    Dh wgu = allocDh(wguBytes), wguS = allocDh(wguSBytes), wdn = allocDh(wdnBytes), wdnS = allocDh(wdnSBytes);

    aclrtMemcpy(wgu.d, wguBytes, wguH, wguBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wguS.d, wguSBytes, wguSH, wguSBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wdn.d, wdnBytes, wdnH, wdnBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wdnS.d, wdnSBytes, wdnSH, wdnSBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    // ---- 权重 dequant 缓存 + 行最大值（容差用）----
    double* wguD[E_SLOTS]; double* rowMaxGu[E_SLOTS];
    double* wdnD[E_SLOTS]; double* rowMaxDn[E_SLOTS];
    for (uint32_t s = 0; s < E_SLOTS; ++s) {
        wguD[s] = (double*)malloc(sizeof(double) * (size_t)GU_N * GU_K);
        rowMaxGu[s] = (double*)malloc(sizeof(double) * GU_N);
        UnpackWeights(wguH + (size_t)s * GU_N * (GU_K / 2), wguSH + (size_t)s * GU_N * (GU_K / SCALE_GROUP),
            GU_N, GU_K, wguD[s]);
        for (uint32_t j = 0; j < GU_N; ++j) {
            double mx = 0.0;
            for (uint32_t k = 0; k < GU_K; ++k) {
                const double a = fabs(wguD[s][(size_t)j * GU_K + k]);
                mx = a > mx ? a : mx;
            }
            rowMaxGu[s][j] = mx;
        }
        wdnD[s] = (double*)malloc(sizeof(double) * (size_t)DN_N * DN_K);
        rowMaxDn[s] = (double*)malloc(sizeof(double) * DN_N);
        UnpackWeights(wdnH + (size_t)s * DN_N * (DN_K / 2), wdnSH + (size_t)s * DN_N * (DN_K / SCALE_GROUP),
            DN_N, DN_K, wdnD[s]);
        for (uint32_t j = 0; j < DN_N; ++j) {
            double mx = 0.0;
            for (uint32_t k = 0; k < DN_K; ++k) {
                const double a = fabs(wdnD[s][(size_t)j * DN_K + k]);
                mx = a > mx ? a : mx;
            }
            rowMaxDn[s][j] = mx;
        }
    }
    printf("[M3] weights dequantized (8 experts, gate_up 1280x2560 + down 2560x640)\n");

    // ---- 两组验收：m=1（decode）、m=33（奇数 m + tile 尾块）----
    const uint32_t ms[] = {1, 33};
    bool allOk = true;
    for (uint32_t mi = 0; mi < 2; ++mi) {
        const uint32_t m = ms[mi];
        uint32_t* cnt = (uint32_t*)counts.h;
        for (uint32_t s = 0; s < E_SLOTS; ++s) cnt[s] = SlotTokens(m, s);
        for (uint32_t s = 0; s < E_SLOTS; ++s) {
            GenActSlot((uint8_t*)act.h + (size_t)s * MAXM * (GU_K / 2),
                (uint8_t*)actS.h + (size_t)s * MAXM * (GU_K / SCALE_GROUP), s);
        }
        aclrtMemcpy(counts.d, E_SLOTS * 4, counts.h, E_SLOTS * 4, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(act.d, actBytes, act.h, actBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(actS.d, actSBytes, actS.h, actSBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        m3_grouped_gemm_kernel<<<numBlocks, 0, stream>>>(
            (uint8_t*)act.d, (uint8_t*)actS.d,
            (uint8_t*)wgu.d, (uint8_t*)wguS.d, (uint8_t*)wdn.d, (uint8_t*)wdnS.d,
            (uint32_t*)counts.d, (uint8_t*)gu.d, (uint8_t*)hp.d, (uint8_t*)hs.d, (uint8_t*)y.d);
        const aclError launchErr = aclrtSynchronizeStream(stream);
        if (launchErr != ACL_SUCCESS) {
            printf("[M3][FAIL] m=%u kernel launch/sync error %d\n", m, (int)launchErr);
            allOk = false;
            continue;
        }
        aclrtMemcpy(gu.h, guBytes, gu.d, guBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(hp.h, hpBytes, hp.d, hpBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(hs.h, hsBytes, hs.d, hsBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(y.h, yBytes, y.d, yBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        for (uint32_t s = 0; s < E_SLOTS; ++s) {
            const uint32_t t = SlotTokens(m, s);
            allOk &= ValidateSlot(m, s, t,
                (uint8_t*)act.h + (size_t)s * MAXM * (GU_K / 2),
                (uint8_t*)actS.h + (size_t)s * MAXM * (GU_K / SCALE_GROUP),
                (uint16_t*)gu.h, (uint8_t*)hp.h, (uint8_t*)hs.h, (uint16_t*)y.h,
                wguD[s], rowMaxGu[s], wdnD[s], rowMaxDn[s]);
        }
        // VF 自检与生产路径在同一次运行里的 GU 行上逐字节对拍（T4 结构性判据）：
        // 自检用「单 VL 一发射」形式（生产同一份 VF 函数），故不受整行落盘 loop 异常影响
        allOk &= H_VfProbeVsProduction(stream, m, (const uint8_t*)gu.h, (const uint8_t*)hp.h,
                                       (const uint8_t*)hs.h, cnt);
    }

    printf("[M3] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    for (uint32_t s = 0; s < E_SLOTS; ++s) {
        free(wguD[s]); free(rowMaxGu[s]); free(wdnD[s]); free(rowMaxDn[s]);
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
