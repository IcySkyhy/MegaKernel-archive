/**
 * m2_mxfp4_quant.asc —— Mega kernel M2：MXFP4 激活量化（纯 AIV 核）
 * （设计约束见 docs/05-megakernel-design.md；donor：vllm-ascend
 *  csrc/online_mxfp4_gemm/src/online_mxfp4_quant.asc（MxQuantComputeScaleFused /
 *  MxQuantComputeDataFP4），语义 bit-exact 对标 torch_npu.npu_dynamic_mx_quant
 *  (dst_type=fp4x2_e2m1, round_mode="round", scale_alg=0/OCP, group=32)，
 *  CPU 参考为 test/quant_ref.py（host 侧已逐行移植）。
 *
 * 功能：单 AIV 核将 bf16 激活 x [m, K] 量化为 MXFP4：
 *   - qx    [m, K/2]  uint8：e2m1 nibble 打包，byte = lo | (hi << 4)，lo=偶数 k
 *   - scale [m, K/32] uint8：E8M0（bias-127），每 32 个 K 元素共享 1 个 scale；
 *           kernel 内部按 uint16 对（2 个相邻 group 打包）经 DataCopyPad 写出，
 *           字节序与 [m, K/32] 展完全一致（低字节=偶数 group）。
 *   - m 为运行时参数（1..256），逐行循环处理；K 为编译期模板（模型两形状 640/2560）。
 *
 * 量化语义（OCP，按 quant_ref.py）：
 *   maxexp  = max(bf16 bits & 0x7F80)  per 32-group   （最大指数域，含尾数高位无关）
 *   shared  = max(maxexp, 0x0100) - 0x0100            (= (floor(log2(amax)) - 2 + 127) << 7)
 *   scale   = shared >> 7                              (E8M0 字节；bf16 Inf/NaN 组 -> 0xFF)
 *   halfSc  = (shared == 0) ? 0 : (组 maxexp==0x7F80 ? 0x7F81(NaN) : 0x7F00 - shared)
 *                                                      (bf16 bits，x * halfScale 即 x / scale 的 2 的幂缩放；
 *                                                       非有限组的 NaN 覆盖见官方 :413，本核同源)
 *   xs      = RNE_bf16(x * halfScale)                  （bf16 乘法，RNE）
 *   q       = e2m1 CAST_ROUND(xs)                      （四舍五入远离零，0.25/0.75/...  tie 向上）
 *
 * 数据通路（全部基础 API，无高阶 API / TPipe / TBuf / TQue）：
 *   GM --DataCopy(MTE2)--> UB(x) --Reg::LoadAlign/Mul/Cast(VEC)--> 寄存器
 *      --Reg::StoreAlign(VEC)--> UB(out/scale) --DataCopy/DataCopyPad(MTE3)--> GM
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal，= get_buf/rls_buf），
 *   不用 set_flag/wait_flag，不挂 PIPE_S。生产者 release 用阻塞释放（mode=false，
 *   = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK；本仓统一用阻塞释放），保证 UB 写对跨 pipe 读可见）：
 *     BUF_X (id 0) : MTE2 生产 x -> V 消费
 *     BUF_O (id 1) : V 生产 out/scale -> MTE3 消费
 *
 * 3510 Nd2Nz 行数=1 quirk（docs/05 §6）：本核按行 1D 连续拷贝（每行每 tile 512B），
 *   不使用 Nd2Nz/Dn2Nz，quirk 天然规避。
 *
 * K=640 尾 tile 处理：TILE=256，640 = 256+256+128，最后一个 tile 采用与前一 tile
 *   重叠 128 元素的回退窗口 [384, 640)（group 对齐，重叠区两次量化结果逐位一致），
 *   避免 donor 的 len/256==0 尾块漏洞，且不越界读、不需要 mask。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>

// ============================================================
// 编译期常量与静态资源表（UB 偏移 / BufferID 全部编译期静态分配）
// ============================================================

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr int64_t DIGIT_TWO = 2;
constexpr uint16_t MAX_EXP_FOR_BF16 = 0x7f80;
constexpr uint16_t MAX_EXP_FOR_FP8 = 0x00ff;
constexpr uint16_t NAN_CUSTOMIZATION = 0x7f81;   // 官方同名常量，见下 halfScale 覆盖
constexpr int16_t SHR_NUM_FOR_BF16 = 7;
constexpr uint16_t BF16_EXP_BIAS = 0x7f00;
constexpr uint16_t FP4_E2M1_BF16_MAX_EXP = 0x0100;
constexpr uint32_t VL_B16 = 128;   // 每 256B 向量寄存器 bf16 lane 数

constexpr CastTrait castTraitRM_Round = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                         RoundMode::CAST_ROUND};

constexpr uint32_t GROUP = 32;     // MXFP4: K 方向每 32 个元素共享 1 个 scale
constexpr uint32_t TILE = 256;     // 每 tile bf16 元素数（8 组）

// ---- UB 静态布局（字节偏移；VECCALC 空间 248KB 内；偏移 32B 对齐，供 DataCopy）----
constexpr uint32_t UB_X = 4 * 1024;                 // bf16 [256] = 512B
constexpr uint32_t UB_SCALE = UB_X + 512;           // uint16 [4]（8 个 E8M0 打包）= 8B
constexpr uint32_t UB_HALF = UB_SCALE + 32;         // uint16 [8]（bf16 halfScale）= 16B
constexpr uint32_t UB_OUT = UB_HALF + 32;           // int8 [128]（256 个 fp4 打包）= 128B
static_assert(UB_OUT + TILE / 2 <= 248 * 1024, "UB footprint exceeds 248KB");

// ---- BufferID（每核用户可用 0-27，静态分配）----
constexpr AscendC::MutexID BUF_X = 0;   // x: MTE2 -> V
constexpr AscendC::MutexID BUF_O = 1;   // out/scale: V -> MTE3

// BufferID 语义封装：acquire 立即获取；release 用阻塞模式（mode=false = CANN 默认
// ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射访存落地，对跨 pipe 消费者可见。
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// ============================================================
// Kernel 实现
// ============================================================

template <uint32_t K>
class Mxfp4Quant {
    static constexpr uint32_t PACKED_K = K / 2;   // 每行打包字节数
    static constexpr uint32_t GP = K / 64;        // 每行 scale uint16 对数
    static constexpr uint32_t FULL_TILES = K / TILE;
    static constexpr uint32_t NTILES = FULL_TILES + (K % TILE ? 1 : 0);  // 尾块重叠窗口
    static_assert(K % 128 == 0, "K must be a multiple of 128");
    static_assert(K >= TILE, "K must be >= TILE");

public:
    __aicore__ inline Mxfp4Quant() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR qx, GM_ADDR scale, uint32_t m)
    {
        M = m;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M) * K);
        qxGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(qx), static_cast<uint64_t>(M) * PACKED_K);
        scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(scale), static_cast<uint64_t>(M) * GP);
    }

    __aicore__ inline void Process()
    {
        // m 运行时 1..256：逐行循环（行间无依赖，行内逐 tile）
        for (uint32_t row = 0; row < M; ++row) {
            for (uint32_t t = 0; t < NTILES; ++t) {
                // 尾块（K%256==128，如 K=640）取回退窗口 [K-256, K)，与前一 tile 重叠
                // 128 元素；group 对齐（128%32==0），重叠区量化结果逐位一致。
                const uint32_t t0 = (t < FULL_TILES) ? t * TILE : K - TILE;
                ProcessTile(row, t0);
            }
        }
    }

private:
    __aicore__ inline void ProcessTile(uint32_t row, uint32_t t0)
    {
        const uint64_t xOff = static_cast<uint64_t>(row) * K + t0;
        const uint64_t qxOff = static_cast<uint64_t>(row) * PACKED_K + t0 / 2;
        const uint64_t sOff = static_cast<uint64_t>(row) * GP + t0 / 64;  // uint16 单位

        // UB 静态 tensor（position + 字节偏移 + 大小，自管理地址）
        LocalTensor<bfloat16_t> xL(TPosition::VECCALC, UB_X, TILE);
        LocalTensor<uint16_t> scaleL(TPosition::VECCALC, UB_SCALE, TILE / GROUP / 2);
        LocalTensor<uint16_t> halfL(TPosition::VECCALC, UB_HALF, TILE / GROUP);
        LocalTensor<int8_t> outL(TPosition::VECCALC, UB_OUT, TILE / 2);

        __ubuf__ bfloat16_t* xUb = reinterpret_cast<__ubuf__ bfloat16_t*>(xL.GetPhyAddr());
        __ubuf__ uint16_t* scaleUb = reinterpret_cast<__ubuf__ uint16_t*>(scaleL.GetPhyAddr());
        __ubuf__ uint16_t* halfUb = reinterpret_cast<__ubuf__ uint16_t*>(halfL.GetPhyAddr());
        __ubuf__ int8_t* outUb = reinterpret_cast<__ubuf__ int8_t*>(outL.GetPhyAddr());

        // ---- MTE2：GM -> UB（ acquire 挡上一 tile 的 V 消费，阻塞释放保证落地）----
        BufAcquire<PIPE_MTE2>(BUF_X);
        DataCopy(xL, xGm[xOff], TILE);
        BufRelease<PIPE_MTE2>(BUF_X);

        // ---- V：scale + 数据量化（maxexp 全程在寄存器，不回写 UB）----
        BufAcquire<PIPE_V>(BUF_X);   // 等 x 就位
        BufAcquire<PIPE_V>(BUF_O);   // 等上一 tile 的 MTE3 读走 out/scale
        MxQuantComputeScale(xUb, scaleUb, halfUb);
        MxQuantComputeDataFP4(xUb, halfUb, outUb);
        BufRelease<PIPE_V>(BUF_X);   // x 读完，MTE2 可复用
        BufRelease<PIPE_V>(BUF_O);   // out/scale 写完且 drain，MTE3 可读

        // ---- MTE3：UB -> GM（qx 128B 普通拷贝；scale 8B 走 DataCopyPad 紧凑拷贝）----
        BufAcquire<PIPE_MTE3>(BUF_O);
        DataCopy(qxGm[qxOff], outL, TILE / 2);
        DataCopyExtParams scaleCopyParams{1, (TILE / GROUP / 2) * static_cast<uint32_t>(sizeof(uint16_t)), 0, 0, 0};
        DataCopyPad<uint16_t, PaddingMode::Compact>(scaleGm[sOff], scaleL, scaleCopyParams);
        BufRelease<PIPE_MTE3>(BUF_O);
    }

    // 每 32-group max bf16 指数域（ReduceDataBlock）-> E8M0 scale + bf16 halfScale，
    // 全部在寄存器完成（3510 上 reduced maxExp 经 UB 回读不相干，见 donor 注释），
    // 只把 scale/halfScale 两个结果写 UB。一个 256-bf16 tile = 8 组。
    __aicore__ inline void MxQuantComputeScale(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* mxScaleLocalAddr,
                                               __ubuf__ uint16_t* halfScaleLocalAddr)
    {
        constexpr uint32_t groups = TILE / GROUP;  // 8
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<uint16_t> vdExpExtract0;
            RegTensor<uint16_t> vdExpExtract1;
            RegTensor<uint16_t> expMaskBF16;
            Duplicate(expMaskBF16, MAX_EXP_FOR_BF16);
            RegTensor<uint16_t> vdMaxExp;
            MaskReg Mask = CreateMask<uint16_t, MaskPattern::ALL>();
            MaskReg cmpResult;
            MaskReg zeroMask;
            MaskReg preMaskScale;
            RegTensor<uint16_t> maxExpValue;
            Duplicate(maxExpValue, FP4_E2M1_BF16_MAX_EXP);
            RegTensor<uint16_t> sharedExp;
            RegTensor<uint16_t> scaleValue;
            RegTensor<uint16_t> scaleBias;
            Duplicate(scaleBias, BF16_EXP_BIAS);
            RegTensor<uint16_t> halfScale;
            RegTensor<uint16_t> fp8NanRegTensor;
            Duplicate(fp8NanRegTensor, MAX_EXP_FOR_FP8);
            RegTensor<uint16_t> nanRegTensor;
            Duplicate(nanRegTensor, NAN_CUSTOMIZATION);
            RegTensor<uint16_t> zeroRegTensor;
            Duplicate(zeroRegTensor, 0);

            uint32_t nGroups = groups;
            preMaskScale = UpdateMask<uint16_t>(nGroups);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            And(vdExpExtract0, (RegTensor<uint16_t>&)vdExp0, expMaskBF16, Mask);
            And(vdExpExtract1, (RegTensor<uint16_t>&)vdExp1, expMaskBF16, Mask);
            Max(vdMaxExp, vdExpExtract0, vdExpExtract1, Mask);
            ReduceDataBlock<AscendC::Reg::ReduceType::MAX>(vdMaxExp, vdMaxExp, Mask);

            // E8M0 scale + bf16 halfScale（reduced register 直接派生）
            Compare<uint16_t, CMPMODE::NE>(cmpResult, vdMaxExp, expMaskBF16, preMaskScale);
            Compare<uint16_t, CMPMODE::LE>(zeroMask, vdMaxExp, maxExpValue, preMaskScale);
            Select<uint16_t>(vdMaxExp, maxExpValue, vdMaxExp, zeroMask);
            Sub(sharedExp, vdMaxExp, maxExpValue, preMaskScale);
            ShiftRights(scaleValue, sharedExp, SHR_NUM_FOR_BF16, preMaskScale);
            Select<uint16_t>(scaleValue, scaleValue, fp8NanRegTensor, cmpResult);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK_B16>(
                mxScaleLocalAddr, scaleValue, nGroups / 2, preMaskScale);
            Compare<uint16_t, CMPMODE::NE>(zeroMask, sharedExp, zeroRegTensor, preMaskScale);
            Sub(halfScale, scaleBias, sharedExp, preMaskScale);
            // 官方 add_rms_norm_dynamic_mx_quant_common.h:412-413 同源：组内非有限（±Inf/NaN）
            // 时把 halfScale 覆盖成 NAN_CUSTOMIZATION=0x7F81（bf16 NaN），使后续 Mul(±Inf, NaN)=NaN
            // -> Cast<fp4> = 0.0；否则 Mul(±Inf, 2^-126)=±Inf -> Cast 饱和成 ±6。
            // 官方 :401 Compare<uint16_t, CMPMODE::NE>(cmpResult, vdMaxExp, expMask=0x7F80) 得到的
            // mask 在此复用（置位取 src0=halfScale，清位取 src1=nanRegTensor）。
            Select<uint16_t>(halfScale, halfScale, nanRegTensor, cmpResult);
            Select<uint16_t>(halfScale, halfScale, zeroRegTensor, zeroMask);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE>(halfScaleLocalAddr, halfScale, nGroups, preMaskScale);
        }
    }

    // bf16 * halfScale -> fp4 打包（round_mode=round，即 CAST_ROUND 远离零舍入）
    __aicore__ inline void MxQuantComputeDataFP4(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* halfScaleLocalAddr,
                                                 __ubuf__ int8_t* outLocalAddr)
    {
        __VEC_SCOPE__
        {
            MaskReg dataMask1;
            RegTensor<uint16_t> halfScaleForMul;
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<fp4x2_e2m1_t> vdExp0FP4;
            RegTensor<fp4x2_e2m1_t> vdExp1FP4;
            uint32_t totalCount = TILE;
            dataMask1 = UpdateMask<bfloat16_t>(totalCount);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            LoadAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_E2B_B16>(
                halfScaleForMul, halfScaleLocalAddr, TILE / GROUP);
            Mul(vdExp0, vdExp0, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Mul(vdExp1, vdExp1, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Interleave(vdExp0, vdExp1, vdExp0, vdExp1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp0FP4, vdExp0, dataMask1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp1FP4, vdExp1, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp0FP4, 64, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp1FP4, 64, dataMask1);
        }
    }

private:
    uint32_t M;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<int8_t> qxGm;
    GlobalTensor<uint16_t> scaleGm;
};

} // namespace

template <uint32_t K>
__vector__ __global__ void mxfp4_quant_kernel(GM_ADDR x, GM_ADDR qx, GM_ADDR scale, uint32_t m)
{
    Mxfp4Quant<K> op;
    op.Init(x, qx, scale, m);
    op.Process();
}

// ============================================================
// Host 侧：确定性随机输入生成 + quant_ref.py 逐行移植的 CPU 位精确参考 + 校验
// ============================================================

// ---- bf16 编解码（RNE；host 无 libm，全部为位操作 + 单精度乘）----
static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

// ---- e2m1 编码（正档 {0,.5,1,1.5,2,3,4,6}，四舍五入远离零；
//      端口 quant_ref.py 的 np.digitize：tie 归上一档；符号位取 xs < 0）----
static uint8_t F32ToE2M1Code(float xs)
{
    static const float kMids[7] = {0.25f, 0.75f, 1.25f, 1.75f, 2.5f, 3.5f, 5.0f};
    const bool neg = xs < 0.0f;
    float a = neg ? -xs : xs;
    uint8_t idx = 0;
    while (idx < 7 && a >= kMids[idx]) ++idx;
    return static_cast<uint8_t>(neg ? (idx | 0x8) : idx);
}

// ---- quant_ref.py ocp_dynamic_mx_quant 的 C 移植：x [m,K] bf16 bits ->
//      qx [m,K/2] u8（lohi）+ scale [m,K/32] u8（E8M0）----
static void RefQuantMxfp4(const uint16_t* x, uint8_t* qx, uint8_t* scale, uint32_t m, uint32_t k)
{
    const uint32_t g = k / 32;
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t grp = 0; grp < g; ++grp) {
            const uint16_t* xp = x + static_cast<size_t>(i) * k + grp * 32;
            uint16_t maxexp = 0;
            for (uint32_t j = 0; j < 32; ++j) {
                const uint16_t e = xp[j] & 0x7F80;
                if (e > maxexp) maxexp = e;
            }
            const bool isInf = (maxexp == 0x7F80);
            uint32_t me = maxexp;
            if (me < 0x0100u) me = 0x0100u;
            const uint32_t shared = me - 0x0100u;
            uint8_t sb = static_cast<uint8_t>(shared >> 7);
            if (isInf) sb = 0xFF;
            scale[static_cast<size_t>(i) * g + grp] = sb;
            uint16_t hs = static_cast<uint16_t>(0x7F00u - shared);
            if (shared == 0) hs = 0;
            if (isInf) hs = 0x7F81;
            const float hsF = Bf16ToF32(hs);
            for (uint32_t j = 0; j < 32; j += 2) {
                const float xs0 = Bf16ToF32(xp[j]) * hsF;
                const float xs1 = Bf16ToF32(xp[j + 1]) * hsF;
                const uint8_t lo = F32ToE2M1Code(Bf16ToF32(F32ToBf16(xs0)));
                const uint8_t hi = F32ToE2M1Code(Bf16ToF32(F32ToBf16(xs1)));
                qx[static_cast<size_t>(i) * (k / 2) + (grp * 32 + j) / 2] =
                    static_cast<uint8_t>(lo | (hi << 4));
            }
        }
    }
}

// ---- 确定性伪随机（与 m1 的 Hash3 同风格：纯公式，无 rand 状态）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// ---- 确定性 bf16 激活生成 ----
// 每个 32-group 按 Hash3(row, grp, seed)%16 选模式：
//   0 : 全 +0.0（零组，走 shared==0 -> halfScale=0 -> scale=0 路径）
//   1 : 正 tie 组：amax=4.0(e=2, hs=0.5)，元素 {4,0.5,1.5,2.5,3.5,0.75,1.75} -> xs 命中
//       2.0 精确档与 0.25/0.75/1.25/1.75 tie（远离零上舍入）
//   2 : 负 tie 组：amax=4.0，元素 {-4,-0.5,-1.5,-3.5} -> 负档精确值与负 tie
//   其他 : 组内指数窗口 [e-31, e] 随机（e 为组 amax 指数），尾数/符号随机；
//       覆盖 xs ∈ [4,8) 饱和区、[6,8) 越界档、宽动态范围，且杜绝 -0/次正规乘积
static void GenActivations(uint16_t* x, uint32_t m, uint32_t k, uint32_t seed)
{
    const uint32_t g = k / 32;
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t grp = 0; grp < g; ++grp) {
            const uint32_t mode = Hash3(i, grp, seed) % 16;
            uint16_t* xp = x + static_cast<size_t>(i) * k + grp * 32;
            if (mode == 0) {
                for (uint32_t j = 0; j < 32; ++j) xp[j] = 0x0000;
                continue;
            }
            if (mode == 1) {
                static const uint16_t kPat[7] = {0x4080, 0x3F00, 0x3FC0, 0x4020, 0x4060, 0x3F40, 0x3FE0};
                for (uint32_t j = 0; j < 7; ++j) xp[j] = kPat[j];
                for (uint32_t j = 7; j < 32; ++j) {
                    const uint32_t h = Hash3(i * 32 + j, grp, seed + 5);
                    xp[j] = static_cast<uint16_t>(((h & 1) << 15) | (1u << 7) | ((h >> 1) & 0x7F));
                }
                continue;
            }
            if (mode == 2) {
                static const uint16_t kPat[4] = {0xC080, 0xBF00, 0xBFC0, 0xC060};
                for (uint32_t j = 0; j < 4; ++j) xp[j] = kPat[j];
                for (uint32_t j = 4; j < 32; ++j) {
                    const uint32_t h = Hash3(i * 32 + j, grp, seed + 6);
                    xp[j] = static_cast<uint16_t>(((h & 1) << 15) | (1u << 7) | ((h >> 1) & 0x7F));
                }
                continue;
            }
            // 组内指数窗 [max(1, e-sub), e]，e 为组 amax 的 bf16 指数域（bias 后），
            // 取 3..126：保证组 maxexp > 0x100 -> shared>0 -> halfScale!=0，
            // 杜绝 -0/次正规乘积（Cast(-0) 给 -0 与 quant_ref 的 xs<0 取符号规则不同，
            // 该角落仅全零/全次正规组可达，真实激活不可达，与 quant_ref 验证策略一致避开）。
            // j==0 固定为组内最大元素，确保组 maxexp 域恰为 e。
            const uint32_t e = 3 + Hash3(i, grp, seed + 1) % 124;
            for (uint32_t j = 0; j < 32; ++j) {
                const uint32_t h = Hash3(i * 32 + j, grp, seed + 2);
                const uint32_t sub = (j == 0) ? 0 : (h % 32);
                const uint32_t exp = (e > sub) ? (e - sub) : 1;
                x[static_cast<size_t>(i) * k + grp * 32 + j] =
                    static_cast<uint16_t>((((h >> 8) & 1) << 15) | (exp << 7) | ((h >> 9) & 0x7F));
            }
        }
    }
}

// ---- 非有限（±Inf / NaN）注入：在既有确定性激活之上按 group 覆盖（M32 用例）----
//   kind 0：不注入（基线，与既有 50 组用例完全相同）
//   kind 1：整组 amax=+Inf —— 注入组 32 个元素全 +Inf
//   kind 2：组内部分元素 Inf —— 注入组恰有 +Inf 与 -Inf 各一个（位置按 Hash 变化），其余为正常值
//   kind 3：NaN 组 —— 注入组全为 bf16 NaN（0x7FC0 / 0xFFC0 交替）
// 注入组固定 grp%4==1（行内每 4 组 1 组），其余组保持 kind 0 的正常取值：一次运行同时
// 覆盖「非有限组」与「相邻正常组」，验证修复不外溢到正常组。bf16 的 ±Inf/NaN 指数域都是
// 0x7F80（& 0x7F80 后），因此三种 kind 都让组 maxexp==0x7F80，走官方 :401 的非有限分支。
static constexpr uint16_t BF16_POS_INF = 0x7F80;
static constexpr uint16_t BF16_NEG_INF = 0xFF80;
static constexpr uint16_t BF16_NAN_P = 0x7FC0;
static constexpr uint16_t BF16_NAN_N = 0xFFC0;

static void InjectInf(uint16_t* x, uint32_t m, uint32_t k, uint32_t seed, uint32_t kind)
{
    if (kind == 0) return;
    const uint32_t g = k / 32;
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t grp = 1; grp < g; grp += 4) {
            uint16_t* xp = x + static_cast<size_t>(i) * k + grp * 32;
            if (kind == 1) {
                for (uint32_t j = 0; j < 32; ++j) xp[j] = BF16_POS_INF;
            } else if (kind == 2) {
                const uint32_t p0 = Hash3(i, grp, seed + 11) % 32;
                const uint32_t p1 = (p0 + 1 + Hash3(i, grp, seed + 12) % 31) % 32;   // 保证 p1 != p0
                xp[p0] = BF16_POS_INF;
                xp[p1] = BF16_NEG_INF;
            } else {
                for (uint32_t j = 0; j < 32; ++j) xp[j] = (j & 1) ? BF16_NAN_P : BF16_NAN_N;
            }
        }
    }
}

// ---- 可选：dump 模式（与 quant_ref.py Python 参考交叉验证用）----
static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// 校验一个 (K, m, seed, infKind) 组合；返回 true = PASS
// infKind != 0 时按 InjectInf 覆盖部分 group 为 ±Inf/NaN（任务 M32 的 ①②③ 三类用例）
static bool RunCase(aclrtStream stream, uint32_t k, uint32_t m, uint32_t seed, uint32_t infKind = 0)
{
    const size_t xBytes = static_cast<size_t>(m) * k * 2;
    const size_t qxBytes = static_cast<size_t>(m) * (k / 2);
    const size_t sBytes = static_cast<size_t>(m) * (k / 32);

    uint16_t* xHost = nullptr;
    uint8_t *qxHost = nullptr, *sHost = nullptr;
    uint8_t *xDev = nullptr, *qxDev = nullptr, *sDev = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&xHost), xBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&qxHost), qxBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&sHost), sBytes);
    aclrtMalloc(reinterpret_cast<void**>(&xDev), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&qxDev), qxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&sDev), sBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    GenActivations(xHost, m, k, seed);
    InjectInf(xHost, m, k, seed, infKind);
    aclrtMemcpy(xDev, xBytes, xHost, xBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    if (k == 640) {
        mxfp4_quant_kernel<640><<<1, 0, stream>>>(xDev, qxDev, sDev, m);
    } else {
        mxfp4_quant_kernel<2560><<<1, 0, stream>>>(xDev, qxDev, sDev, m);
    }
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M2][FAIL] K=%u m=%u seed=%u inf=%u kernel launch/sync error %d\n", k, m, seed, infKind,
               (int)launchErr);
        return false;
    }
    aclrtMemcpy(qxHost, qxBytes, qxDev, qxBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(sHost, sBytes, sDev, sBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    // 调试：M2_DUMP=1 时保存 device 输出（交叉验证/定位用）
    if (getenv("M2_DUMP") != nullptr) {
        char name[80];
        snprintf(name, sizeof(name), "K%u_m%u_s%u_i%u_x.bin", k, m, seed, infKind); WriteBin(name, xHost, xBytes);
        snprintf(name, sizeof(name), "K%u_m%u_s%u_i%u_qx_device.bin", k, m, seed, infKind);
        WriteBin(name, qxHost, qxBytes);
        snprintf(name, sizeof(name), "K%u_m%u_s%u_i%u_scale_device.bin", k, m, seed, infKind);
        WriteBin(name, sHost, sBytes);
    }

    // ---- host 位精确参考（quant_ref.py 移植，含官方 :413 的非有限 halfScale 覆盖）逐字节比对 ----
    uint8_t* refQx = new uint8_t[qxBytes];
    uint8_t* refS = new uint8_t[sBytes];
    RefQuantMxfp4(xHost, refQx, refS, m, k);

    uint32_t failCount = 0;
    for (size_t i = 0; i < qxBytes && failCount < 5; ++i) {
        if (qxHost[i] != refQx[i]) {
            printf("[M2][FAIL] K=%u m=%u seed=%u inf=%u qx[%zu] got 0x%02x expect 0x%02x\n",
                k, m, seed, infKind, i, qxHost[i], refQx[i]);
            ++failCount;
        }
    }
    for (size_t i = 0; i < sBytes && failCount < 5; ++i) {
        if (sHost[i] != refS[i]) {
            printf("[M2][FAIL] K=%u m=%u seed=%u inf=%u scale[%zu] got 0x%02x expect 0x%02x\n",
                k, m, seed, infKind, i, sHost[i], refS[i]);
            ++failCount;
        }
    }
    const bool pass = (failCount == 0);
    printf("[M2] K=%-4u m=%-3u seed=%u inf=%u : %s (qx %zu B, scale %zu B, bit-exact)\n",
        k, m, seed, infKind, pass ? "PASS" : "FAIL", qxBytes, sBytes);

    // 非有限用例附加见证：注入组数、device 侧 0xFF scale 数、注入组 nibble 非零数
    //（修复后应为 0：整组被 NaN halfScale 打成 0；修复前是 ±6 饱和码 0x7/0xF）
    if (infKind != 0) {
        const uint32_t g = k / 32;
        size_t injGroups = 0, sFF = 0, refFF = 0, nibNonZero = 0, nibNonZeroRef = 0;
        for (uint32_t i = 0; i < m; ++i) {
            for (uint32_t grp = 1; grp < g; grp += 4) {
                ++injGroups;
                if (sHost[static_cast<size_t>(i) * g + grp] == 0xFF) ++sFF;
                if (refS[static_cast<size_t>(i) * g + grp] == 0xFF) ++refFF;
                for (uint32_t j = 0; j < 32; ++j) {
                    const size_t byte = static_cast<size_t>(i) * (k / 2) + (grp * 32 + j) / 2;
                    const uint8_t nib = (j & 1) ? (qxHost[byte] >> 4) : (qxHost[byte] & 0x0F);
                    const uint8_t nibRef = (j & 1) ? (refQx[byte] >> 4) : (refQx[byte] & 0x0F);
                    if (nib != 0) ++nibNonZero;
                    if (nibRef != 0) ++nibNonZeroRef;
                }
            }
        }
        printf("[M2]   inf=%u 注入组=%zu/组总=%u device scale=0xFF %zu 组（参考 %zu），"
               "注入组 nibble 非零 %zu/%zu（参考 %zu；修复前应为 ±6 饱和码）\n",
               infKind, injGroups, m * g, sFF, refFF, nibNonZero, injGroups * 32, nibNonZeroRef);
    }

    delete[] refQx;
    delete[] refS;
    aclrtFree(xDev); aclrtFreeHost(xHost);
    aclrtFree(qxDev); aclrtFreeHost(qxHost);
    aclrtFree(sDev); aclrtFreeHost(sHost);
    return pass;
}

int32_t main(int32_t argc, char* argv[])
{
    // dump 模式：./m2_mxfp4_quant dump <K> <m> <seed> [infKind] 写出 x.bin/qx.bin/scale.bin
    //（infKind 1/2/3 = 整组 +Inf / 组内部分 ±Inf / NaN 组，供含非有限输入的交叉验证）
    if (argc >= 5 && argv[1][0] == 'd') {
        const uint32_t k = static_cast<uint32_t>(atoi(argv[2]));
        const uint32_t m = static_cast<uint32_t>(atoi(argv[3]));
        const uint32_t seed = static_cast<uint32_t>(atoi(argv[4]));
        const uint32_t infKind = (argc >= 6) ? static_cast<uint32_t>(atoi(argv[5])) : 0u;
        const size_t xBytes = static_cast<size_t>(m) * k * 2;
        const size_t qxBytes = static_cast<size_t>(m) * (k / 2);
        const size_t sBytes = static_cast<size_t>(m) * (k / 32);
        uint16_t* xHost = new uint16_t[xBytes / 2];
        uint8_t* qxHost = new uint8_t[qxBytes];
        uint8_t* sHost = new uint8_t[sBytes];
        GenActivations(xHost, m, k, seed);
        InjectInf(xHost, m, k, seed, infKind);
        RefQuantMxfp4(xHost, qxHost, sHost, m, k);
        bool ok = WriteBin("x.bin", xHost, xBytes) && WriteBin("qx.bin", qxHost, qxBytes) &&
                  WriteBin("scale.bin", sHost, sBytes);
        printf("[M2] dump K=%u m=%u seed=%u inf=%u -> %s\n", k, m, seed, infKind, ok ? "ok" : "write failed");
        delete[] xHost; delete[] qxHost; delete[] sHost;
        return ok ? 0 : 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 覆盖：任务书要求 m=1 与 m=256（多组随机种子）；补充中间 m 验证动态 m 路径
    const uint32_t ks[] = {640, 2560};
    const uint32_t ms[] = {1, 2, 17, 128, 256};
    const uint32_t seeds[] = {0, 1, 2, 3, 4};

    bool allOk = true;
    for (uint32_t k : ks) {
        for (uint32_t seed : seeds) {
            for (uint32_t m : ms) {
                allOk &= RunCase(stream, k, m, seed);
            }
        }
    }

    // ---- 非有限（±Inf / NaN）用例（任务 M32）：与 host 参考（官方语义）逐位一致 ----
    // 三类：1=整组 amax=+Inf；2=组内只有部分元素 Inf；3=NaN 组；m 取 1/17/256，seed 0..2
    const uint32_t infMs[] = {1, 17, 256};
    for (uint32_t infKind = 1; infKind <= 3; ++infKind) {
        for (uint32_t k : ks) {
            for (uint32_t seed = 0; seed < 3; ++seed) {
                for (uint32_t m : infMs) {
                    allOk &= RunCase(stream, k, m, seed, infKind);
                }
            }
        }
    }
    printf("[M2] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
