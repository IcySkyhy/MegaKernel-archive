/**
 * m15_attn_core.asc —— M101：attention 核心段的**独立设备验证路**（自己的 target / 自己的 main）
 *
 * 本文件只做三件事，不含任何算法：
 *   ① `__global__` 入口壳（薄壳，把分核调度交给抽取件里的 `M15AC::AttnCoreBody`）；
 *   ② host 侧的 `main()`（模式分派 + 环境变量），实现在 `m15_attn_core_host.h`；
 *   ③ include 顺序与 donor 对齐（donor 是 `acl/acl.h` + `kernel_operator.h` + 三个 libc 头）。
 *
 * **本 mission 第三步的判据口径**：数据生成与落盘文件名**逐字复刻 donor host**
 * （`m10_attn_decode.asc:1120-1339`），于是 donor 的 `m10_attn_decode/check_ref.py` 可以**原样**
 * 在本目录跑（判据脚本不被复制 ⇒ 判据与被测实现真正独立，也不会出现两份判据漂移）。
 * 抽取等价性的直接见证 = 与 `m10_attn_decode/data/` 的归档 dump **逐字节**对拍（`M15AC_REFDIR`）。
 *
 * 构建（仓库根目录）：
 *   source /usr/local/Ascend/ascend-toolkit/set_env.sh
 *   cmake -B m15_layer_loop/build -S m15_layer_loop -DCMAKE_BUILD_TYPE=Release
 *   cmake --build m15_layer_loop/build -j4 --target m15_attn_core
 * 运行（dump 写 cwd；建议在 evidence/attn_core/out/ 下跑）：
 *   ./m15_layer_loop/build/m15_attn_core [core|negkv]        # 默认 core；negkv = 负向对照
 * 环境变量：
 *   M15AC_CASES="256,4096"   只跑指定 seq（默认 256,300,4096）
 *   M15AC_OUT=<dir>          先 chdir 到该目录再落盘
 *   M15AC_REFDIR=<dir>       与归档 dump 逐字节对拍（如 m10_attn_decode/data）
 *   M15AC_L0CFG="..."        donor 的 L1→L0 装载参数覆盖（调试用，逐字保留）
 */
#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <cstdlib>
#include <unistd.h>

#include "m15_attn_core.h"
#include "m15_attn_oproj.h"

// ============================================================
// 入口壳：与 donor 的 `__global__ __mix__(1,2) m10_attn_decode_kernel` 逐参数相同，
// 只把函数体换成抽取件的 `M15AC::AttnCoreBody`（donor 的函数体只有分核调度 + PipeBarrier）。
// ============================================================
__global__ __mix__(1, 2) void m15_attn_core_kernel(__gm__ uint8_t* q, __gm__ uint8_t* k, __gm__ uint8_t* v,
                                                   __gm__ uint8_t* out, __gm__ uint32_t* seq,
                                                   __gm__ uint8_t* wsAcc, __gm__ uint8_t* wsM,
                                                   __gm__ uint8_t* wsS, __gm__ float* maskCol,
                                                   __gm__ uint8_t* dbgS, __gm__ uint8_t* dbgP,
                                                   __gm__ uint8_t* dbgC, __gm__ uint32_t* cfg,
                                                   __gm__ uint8_t* dbgC2, __gm__ uint8_t* gP)
{
    AscendC::InitSocState();
    M15AC::AttnCoreBody(q, k, v, out, seq, wsAcc, wsM, wsS, maskCol, dbgS, dbgP, dbgC, cfg, dbgC2, gP);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// o_proj 段的两半（M101 第四步）：AIV 段用 mix(1,2) 启动（`GetBlockNum()` 在 mix 核上 = AIC 数，
// 与 m15_ple.asc 同款；AIC 侧直接返回），AIC 段用 donor m11 的 `__cube__` + blockDim=1 形态。
__global__ __mix__(1, 2) void m15_attn_gate_kernel(__gm__ uint8_t* attn, __gm__ uint8_t* gate,
                                                   __gm__ uint8_t* t, uint32_t m, uint32_t mode)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIV {
        M15OP::GateMulAiv(attn, gate, t, m, mode);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

__global__ __cube__ void m15_attn_oproj_kernel(__gm__ uint8_t* t, __gm__ uint8_t* w, __gm__ uint8_t* y,
                                               uint32_t m, uint32_t mode)
{
    AscendC::InitSocState();
    M15OP::OProjGemmAic(t, w, y, m, mode);
    AscendC::PipeBarrier<PIPE_ALL>();
}

#include "m15_attn_core_host.h"

int32_t main(int32_t argc, char** argv)
{
    const char* mode = (argc >= 2) ? argv[1] : "core";
    const char* cases = getenv("M15AC_CASES");
    const char* outDir = getenv("M15AC_OUT");
    const char* refDir = getenv("M15AC_REFDIR");
    printf("[M101] mode=%s\n", mode);

    if (strcmp(mode, "core") == 0) {
        return M15ACHost::detail::CoreMain(cases, outDir, refDir, /*swapKv=*/false);
    }
    if (strcmp(mode, "negkv") == 0) {
        // 负向对照：调用点把 K/V 实参互换 ⇒ 判据 **A/C/E/F** 必须变红
        // （D 是结构性的、不咬数据内容 ⇒ 本 mission 的 negkv 档里它仍 PASS，README §3.3 如实记账）
        return M15ACHost::detail::CoreMain(cases, outDir, refDir, /*swapKv=*/true);
    }
    if (strcmp(mode, "oproj") == 0) {
        // 第四步：o_proj + ×sigmoid(gate) 的独立判据（含负向对照档，由 OProjMain 内部按 mode 跑）
        return M15ACHost::detail::OProjMain(cases, outDir);
    }
    printf("[M101][FAIL] 未知 mode '%s'（可用：core / negkv / oproj）\n", mode);
    return 1;
}
