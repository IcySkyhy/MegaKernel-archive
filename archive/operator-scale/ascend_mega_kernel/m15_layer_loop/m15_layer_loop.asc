// ============================================================
// m15_layer_loop.asc —— M25：48 层循环骨架（host 循环，aclgraph 后补）
//
// 层类型按真实 checkpoint config（3:1 交替：每 4 层前 3 层 GDN、第 4 层 full attention）：
//   - GDN 层    = m14_gdn_layer 的整层 kernel（S1→S7，114+103 判据已验）复制改造 → m15_gdn_layer.h
//   - attention 层 = **占位直通**（y = x，QSA 未通，待替换）→ m15_attn_layer.h
// 两次 kernel 都用 __mix__(1,2) + blockDim = AIC 数启动，每层一次启动；层间只通过 GM 上的
// bf16 残差流（[1,2560]）交接；每层的 conv_state[3,10240]bf16 与 ssm_state[48,128,128]fp32
// 常驻 GM，跨 token 复用（kernel 内 in-place RMW）。
//
// 三个验证（mission task 2/3/4）：
//   A 层间组合正确性：同一输入分别跑「单层 kernel 直接调用」与「48 层循环中对应层」，
//     逐层逐字节比对（含 ws 内全部中间张量）；另验残差流交接 y[L] == x[L+1] 与占位层直通。
//   B 多 token / 状态连续性：连续 3 个 token 逐层跑，对比 host 参考（m14 的 double 参考链，
//     以设备 qkvzba 为 bf16 锚点）的 state 演化：conv_state 位级、ssm_state 1e-5 相对 + 位级统计；
//     另验 device 侧 conv_state 的移位自洽（跨 token 续上）与「状态确实在演化」的非空洞性。
//   C 开销基线：host 计时给出「48 次启动的 host 下发总耗时 vs 48 层 kernel 设备执行总耗时」
//     （msprof 侧用 parse_msprof.py 解析），为 aclgraph 与跨层预取定基线。
//
// 用法：
//   source /usr/local/Ascend/ascend-toolkit/set_env.sh
//   cmake -B m15_layer_loop/build -S m15_layer_loop -DCMAKE_BUILD_TYPE=Release
//   cmake --build m15_layer_loop/build -j4
//   ./m15_layer_loop/build/m15_layer_loop m15_layer_loop/weights_manifest.txt all
//       参数 2 = 运行集：all | a | b | c | m | h | chain(=x) | kv（默认 all）
//                 kv = M82：attention 三套 cache + packed indices 的布局判据（容量自检 + device 探针
//                      逐字节 + 两条负向对照）；不跑任何层链，秒级
//   env: M15_SYNTH=1        → 不读 checkpoint，层级权重合成（bring-up / 无 checkpoint 环境）
//        M15_LAYERS=n       → 只跑前 n 层（默认 48；bring-up 定位用）
//        M15_STEPS=n        → Ver B 的 token 数（默认 3）
//        M15_REPS=n         → Ver C 每项重复次数（默认 10）
//        M15_DUMP=1         → 落盘供 check_ref.py（默认关）
//        M15_DUMP_SSM=a,b   → ssm_state 落盘的层号（默认 "0,1,35"；全 36 层 = 113MB/次）
//
// 说明（哪些是复制来的、哪些是新写的）：
//   m15_gdn_layer.h / m15_gdn_resources.h / m15_layer_ref.h = 复制改造自 m14_gdn_layer
//     （namespace M14→M15G、日志 tag、入口签名、参考链参数化；**段序/同步/算件逻辑零改动**）。
//   m15_attn_layer.h / m15_loop_layout.h / 本文件 = 新写（层循环骨架 + 三验证 + 权重装载）。
// ============================================================

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <algorithm>
#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <atomic>
#include <map>
#include <string>
#include <sys/mman.h>
#include <sys/stat.h>
#include <cerrno>
#include <thread>
#include <vector>

#include "m15_gdn_layer.h"     // 层 kernel（复制改造自 m14）+ 其资源表
#include "m15_hc_layer.h"      // hc 边界段 device 代码（复制改造自 m20，见 lift_hc_segment.py）
// ---- M132（Wave C）：prefill 三条段的 device 段头（段体不自带 main()；挂载点见 m15_layer_kernel.h）----
// B1（GDN，M115）依赖 m15_gdn_resources.h；B5（hc，M119）依赖 m15_hc_layer.h 的 M15H::HyperConnOp
// 与 m15_hc_resources.h；两者都必须在各自的供体头（上一行/上一行）之后。
#include "m15_gdn_prefill.h"   // B1：GDN prefill 段（M15GP::GdnPrefillAiv/AicEntry）
#include "m15_hc_prefill.h"    // B5：hc prefill 的 m-tile 段（M15H::HcPF::MakePlan/Body）
// ---- M151：prefill prolog 链路（S2 in_proj + S3 conv1d/l2norm/gating）的段体抽取 ----
// M15PM = m9 `gdn_prolog_mt_kernel` 的 device 段体逐字抽取（外层命名空间）；另含 S2 薄壳
// `m15_pf_inproj_gemm_kernel`（复用 M15OP::OProjGemm<2560,16480>）与 S3 薄壳
// `m15_pf_gdn_prolog_kernel`。契约见 evidence/m151_prefill_prolog_wiring/CONTRACT.md。
#include "m15_prefill_prolog.h"
// ---- M164：prefill epilog 链路（transpose + S5 RMSNormGated + S6 out_proj）的段体抽取 ----
// M15PE::Trans / M15PE::Chain = m28_gdn_epilog.asc / m28_epilog_chain.asc 的 device 段**逐字抽取**
// （外层命名空间是唯一包裹），入口壳 `m15_pf_epilog_{transpose,s5,s6,s6_mut}_kernel` 在文件尾。
// 契约见 evidence/m164_epilog_mount/CONTRACT.md；lift 见证 evidence/m164_epilog_mount/verify_lift.py。
#include "m15_prefill_epilog.h"
// ---- M100：PLE 段的 device 段（**机械抽取**，见 evidence/ple_wire/lift_ple_device_segment.py）----
// `m15_ple_wire.h` 是从 `m15_ple.asc` 逐字抽出的 `namespace M85P`（**不含** `main()`、
// 匿名 namespace、system 头、AscendC 头），由 `--check` 保证与 `m15_ple.asc` 逐字节一致；
// `m15_ple.asc` 一字未动，它的独立 target 与 13 条判据继续作同一条 device 逻辑的验证路。
// **曾试过**直接 `#include "m15_ple.asc"`（零副本）：`runs=all` 出现 36 条 `M.moews.*` FAIL
// （MoE 段 `WS_OFFSETS+32` 的 4 字节）⇒ 改为抽取形态，`runs=all` 干净。见 WITNESS.md §6。
// 本文件不自带 include ⇒ 必须放在 `m15_hc_layer.h` 之后（它提供 M15H::NormDonor/BarrierAiv/…）。
#include "m15_ple_wire.h"
#include "m15_attn_layer.h"    // attention 占位直通
#include "m15_loop_layout.h"   // 48 层循环 GM 平面图
#include "m15_attn_kv.h"           // M82：attention 三套 cache + packed indices 的物理布局（唯一权威）
#include "m15_attn_kv_probe.h"     // M82：布局/paged 契约/off-by-one 门控的 device 探针
#include "m15_attn_prolog.h"       // M88：attention 前端 prolog 的形状/权重平面/UB/flag 登记
#include "m15_attn_prolog_probe.h" // M88：prolog 的 device 探针（AIC 4 个 GEMM + AIV norm/rope）
#include "m15_layer_resources.h"   // 融合资源登记表（M40 两相位 → M58 四相位）
#include "m15_moe_layer.h"         // MoE 段 device 代码（复制改造自 m13，见 lift_moe_segment.py）
#include "m15_moe_prefill.h"       // M132（Wave C）B4：MoE prefill 段（M15MP::MoePrefillChain）
#include "m15_layer_kernel.h"      // 融合入口符号（含 M58 的四相位 *_hc 与 hc 单边界对照入口）
#include "m15_layer_ref.h"     // host 参考 + 判据工具（复制改造自 m14 host 段）

// M151：跨文件把 m15_layer_resources.h §3c-bis 的 prolog 峰值登记与设备头里的实际常量**逐一钉死**
// （数字漂了就编不过，和 m15_layer_kernel.h 对 PF_*_GDN 的做法同款）。
static_assert(M15PM::MT_END == M15L::PF_PROLOG_UB_BYTES,
              "M151：S3 prolog 的 UB 峰值（M15PM::MT_END）与登记表 PF_PROLOG_UB_BYTES 不一致");
static_assert(M15OP::L1_OFF_B1 + M15OP::L1_B_ELEMS * 2u == M15L::PF_INPROJ_L1_BYTES,
              "M151：S2 in_proj 的 L1 峰值与登记表 PF_INPROJ_L1_BYTES 不一致");

// M164：把 m15_layer_resources.h §3c-ter 的 epilog 峰值登记与设备头里的实际常量**逐一钉死**
// （数字漂了就编不过；与 M151 的 §3c-bis 同款跨文件机器见证）。
static_assert(M15PE::Trans::UB_Z + M15PE::Trans::UB_Z_BYTES == M15L::PF_EPILOG_TRANS_UB_BYTES,
              "M164：epilog 转位段的 UB 峰值（M15PE::Trans）与登记表 PF_EPILOG_TRANS_UB_BYTES 不一致");
static_assert(M15PE::Chain::UB_S5_RSTD + 256u == M15L::PF_EPILOG_S5_UB_BYTES,
              "M164：S5 的 UB 峰值（M15PE::Chain::UB_S5_RSTD+256）与登记表 PF_EPILOG_S5_UB_BYTES 不一致");
static_assert(M15PE::Chain::S6::L1_B_REGION + 2u * M15PE::Chain::S6::L1_B_ELEMS * 2u ==
                  M15L::PF_EPILOG_S6_L1_BYTES,
              "M164：S6 的 L1 峰值与登记表 PF_EPILOG_S6_L1_BYTES 不一致");
static_assert(M15PE::Chain::S6::BASE_M * M15PE::Chain::S6::BASE_N * 4u == M15L::PF_EPILOG_S6_L0C_BYTES,
              "M164：S6 的 L0C 峰值与登记表 PF_EPILOG_S6_L0C_BYTES 不一致");

// ============================================================
// 0. 全局开关（host 侧）
// ============================================================

namespace M15Run {

constexpr uint32_t NL = M15Loop::NL;
constexpr uint32_t NO_SLOT = M15Loop::NO_SLOT;

struct Opts {
    uint32_t nLayers = NL;      // M15_LAYERS
    uint32_t steps = 3;         // M15_STEPS（Ver B token 数）
    uint32_t reps = 10;         // M15_REPS（Ver C 重复次数）
    uint32_t topk = 2;          // M15_TOPK（MoE 段 top-k；缩形档 = golden 的 2）
    bool synth = false;         // M15_SYNTH
    bool dump = false;          // M15_DUMP
    std::vector<uint32_t> ssmDumpLayers = {0u, 1u, 35u};
    std::vector<uint32_t> moeDumpLayers = {0u, 1u, 2u, 3u};   // M15_DUMP_MOE（MoE 段整块 ws 落盘的层号）
    // M58：验证 H（四相位 hc 融合形态）的层表与 token 数。默认 {0, 1} 是 GDN 层（层 0 的 attn
    // 边界走 mix-only、层 1 走 combine_and_mix），{3} 是 attention 层 —— 三种口径各覆盖一次。
    std::vector<uint32_t> hcLayers = {0u, 1u, 3u};   // M15_HC_LAYERS
    uint32_t hcM = 1;                                // M15_HC_M（≤ M_MAX=64）
    // M65：48 层链的 token 数（decode 档 = 1；结构判据对任意 m 成立，但 m>1 时 GDN 的状态语义
    // 是「多行共用一个序列状态」，只作结构/字节判据用）
    uint32_t chainM = 1;                             // M15_CHAIN_M（≤ M_MAX=64）
    uint32_t chainPle = 1;                           // M15_CHAIN_PLE（1 = 层 1 走打断点；0 只用于 msprof A/B）
    // ---- M100：PLE 段的接线档（`runs=plewire`）----
    uint32_t pleWire = 0;        // M15_PLE_WIRE（1 = 接线开；0 = 同一断点结构上空操作）
    uint32_t pleLayer = 1;       // M15_PLE_LAYER（0-based；PLE 只挂这一层）
    uint32_t pleTok = 1;         // M15_PLE_TOK
    uint32_t pleNReq = 1;        // 请求数（本档恒 1）
    uint32_t pleToken = 1234;    // M15_PLE_TOKEN（input_ids[0]）
    uint32_t pleShard = 0;       // M15_PLE_SHARD（窗口落在哪个表分片）
    uint32_t pleWinBase = 0;     // M15_PLE_WIN_BASE（片内起始行）
    uint32_t pleWinRows = 65536; // M15_PLE_WIN_ROWS（窗口行数）
    uint32_t pleStageMask = 31;  // M15_PLE_STAGE（bit4 = ①、bit0..3 = ②③④⑤，必须是前缀）
    uint32_t pleNegMask = 0;     // M15_PLE_NEG（透传给 M85P 的变异掩码）
    uint32_t pleMiswire = 0;     // M15_PLE_MISWIRE（负向对照：1 = 表基址接错；2 = 行基址偏 1）
    uint32_t pleStateCarry = 1;  // M15_PLE_STATECARRY（M191：1 = 跨 step 搬 S_STOUT→S_STIN；0 = 负向对照）
    uint32_t pleVocabReal = 0;   // M15_PLE_VOCAB=real ⇒ 用 checkpoint 的原始词表标量
    uint32_t pleReduced = 4096;  // M15_PLE_REDUCED（缩减词表的每头词表量）
    // ---- M110：prefill 的契约与挂载点档（`runs=prefill`）----
    // 判据的 m 列表**默认含 1 与 4097**（人类原话：「prefill 和decode都要照顾到，测试m=1和4097」）
    std::vector<uint32_t> pfMs = {1u, M15Loop::M_PREFILL};   // M15_PREFILL_M（逗号列表）
    uint32_t pfWire = 0;         // M15_PREFILL_WIRE（缺省 0 = 结构占位；1 = 段体挂载点）
    uint32_t pfKinds = 3;        // M15_PREFILL_KIND：1 = 只跑 GDN 入口；2 = 只跑 attn；3 = 两个都跑
    uint32_t pfMutant = 0;       // M15_PREFILL_MUTANT：负向对照（把行循环截到 M_MAX）
    // M140：prefill 四相位的**相位掩码**（`LAYER_KERNEL::PF_STAGE_*` 的按位或）。
    // 缺省 = 只开相位 A（与 M136 的既有读数一字不差）；`M15_PREFILL_PHASES=15` 开全四相位。
    uint32_t pfPhases = 2u;      // M15_PREFILL_PHASES（1=H1 / 2=A / 4=H2 / 8=B）
    // M140 r2：**单变量 A/B 的控制位** —— 置 1 时**跳过** MoE 输入面（`pfHcBlk1`）尾块 pad 行的置零，
    // 其余代码/分配尺寸逐字节不动（复审 r2 要求的干净 A/B：r1 那条实验同时改了分配尺寸，不算单变量）。
    uint32_t pfNoPad = 0u;       // M15_PREFILL_NO_PAD
    // M140 r2 的更紧的控制：pad 行的**内容**（默认 0x00 = 0.0bf16；0x3C 的每个 16bit lane = bf16 1.0）。
    // 与 NO_PAD 的区别：**memset 的尺寸完全一样、只有内容不同** ⇒ 能把"pad 的内容是否流进 router 的
    // logits"与"多一次 memset 带来的时序/缓存效应"分开。
    uint32_t pfPadByte = 0u;     // M15_PREFILL_PAD_BYTE
    // ---- M151：prefill prolog 链路（S2 in_proj + S3 conv1d/l2norm/gating）----
    // `pfProlog=1`：相位 A 的 q/k/v/g/β 改由**设备** S2+S3 产出（宿主合成路径保留为对照）。
    // `pfPrologMut`：0=干净 / 1=S3 不交接 conv_state（noShift）/ 2=S3 不写 q/k pad 行（noPad）。
    // `pfPrologScale`：透传 S3 的 `qScaleOn`（0=相位 A 契约；1=m9 历史，仅 q 乘 1/√128）。
    uint32_t pfProlog = 0u;      // M15_PREFILL_PROLOG
    uint32_t pfPrologMut = 0u;   // M15_PREFILL_PROLOG_MUT
    uint32_t pfPrologScale = 0u; // M15_PREFILL_PROLOG_SCALE
    // ---- M164：prefill epilog 链路（transpose + S5 RMSNormGated + S6 out_proj）----
    // `pfEpilog=1`：把相位 A 出口 wsO 经「转位 → S5 → S6」落成 H2 的 bo（`pfHcAttnOutDev`），
    // 使 H2 的 combine 吃到**设备产出**而非宿主合成 bo。依赖 prolog（z 源 `pfQkvzbaDev` 是 S2 产出）。
    // `pfEpilogMut`：0=干净 / 1=转位 headstride 错（只 m>1 暴露）/ 2=S5 gamma 未生效
    //                / 3=S5 全部 head 用 head0 的 z / 4=S6 GEMM K−1（第二类负向对照）。
    // **只有 0..4 有定义**。M175：越界值（>4）过去被 `& 7u` 静默折成 clean ⇒ 报无辜的 ALL PASS；
    // 现在解析时响亮 WARN 并取 0，同时记 `pfEpilogMutOor`，由挂 epilog 的档计成失败。
    uint32_t pfEpilog = 0u;      // M15_PREFILL_EPILOG
    uint32_t pfEpilogMut = 0u;   // M15_PREFILL_EPILOG_MUT
    uint32_t pfEpilogMutOor = 0u; // M175：越界的原始 M15_PREFILL_EPILOG_MUT（0 = 未越界）
    // M136（Wave D）：M132 的 `M15_PREFILL_WIRE_NEG` 开关已退役（那条"nil 指针响亮失败"的对照
    // 由 H_RunPrefill 的 `Pf.gdn_mut1`（段体真产出的负向对照）取代）⇒ 字段与解析一并删除。
};

static uint32_t H_EnvU32(const char* name, uint32_t dflt)
{
    const char* v = getenv(name);
    if (v == nullptr || v[0] == '\0') {
        return dflt;
    }
    return static_cast<uint32_t>(atoi(v));
}

static void H_ParseOpts(Opts& O)
{
    O.nLayers = H_EnvU32("M15_LAYERS", NL);
    if (O.nLayers > NL) {
        O.nLayers = NL;
    }
    O.steps = H_EnvU32("M15_STEPS", 3u);
    if (O.steps == 0) {
        O.steps = 1;
    }
    O.reps = H_EnvU32("M15_REPS", 10u);
    if (O.reps == 0) {
        O.reps = 1;
    }
    O.topk = H_EnvU32("M15_TOPK", 2u);
    if (O.topk == 0u || O.topk > M15M::TOPK_MAX) {
        printf("[m15][WARN] M15_TOPK=%u 越界（模板上界 %u）→ 取 2\n", O.topk, M15M::TOPK_MAX);
        O.topk = 2u;
    }
    if (getenv("M15_DUMP_MOE") != nullptr) {
        O.moeDumpLayers.clear();
        std::string s(getenv("M15_DUMP_MOE"));
        size_t p2 = 0;
        while (p2 < s.size()) {
            const size_t q = s.find(',', p2);
            const std::string tok = s.substr(p2, (q == std::string::npos) ? std::string::npos : q - p2);
            if (!tok.empty()) {
                O.moeDumpLayers.push_back(static_cast<uint32_t>(atoi(tok.c_str())));
            }
            if (q == std::string::npos) {
                break;
            }
            p2 = q + 1;
        }
    }
    // ---- M58：hc 段的验证层表与 token 数 ----
    O.hcM = H_EnvU32("M15_HC_M", 1u);
    if (O.hcM == 0u || O.hcM > M15H::M_MAX) {
        O.hcM = 1u;
    }
    if (getenv("M15_HC_LAYERS") != nullptr) {
        O.hcLayers.clear();
        std::string s(getenv("M15_HC_LAYERS"));
        size_t p2 = 0;
        while (p2 < s.size()) {
            const size_t q = s.find(',', p2);
            const std::string tok = s.substr(p2, (q == std::string::npos) ? std::string::npos : q - p2);
            if (!tok.empty()) {
                O.hcLayers.push_back(static_cast<uint32_t>(atoi(tok.c_str())));
            }
            if (q == std::string::npos) {
                break;
            }
            p2 = q + 1;
        }
    }
    O.synth = (getenv("M15_SYNTH") != nullptr);
    O.dump = (getenv("M15_DUMP") != nullptr);
    O.chainPle = (H_EnvU32("M15_CHAIN_PLE", 1u) != 0u) ? 1u : 0u;
    // ---- M100：PLE 接线档 ----
    O.pleWire = (H_EnvU32("M15_PLE_WIRE", 0u) != 0u) ? 1u : 0u;
    O.pleLayer = H_EnvU32("M15_PLE_LAYER", 1u);
    O.pleTok = H_EnvU32("M15_PLE_TOK", 1u);
    if (O.pleTok == 0u || O.pleTok > M15L::PLEW::T_MAX) {
        printf("[m15][WARN] M15_PLE_TOK=%u 越界（1..%u）→ 取 1\n", O.pleTok, M15L::PLEW::T_MAX);
        O.pleTok = 1u;
    }
    O.pleNReq = 1u;
    O.pleToken = H_EnvU32("M15_PLE_TOKEN", 1234u);
    O.pleShard = H_EnvU32("M15_PLE_SHARD", 0u);
    O.pleWinBase = H_EnvU32("M15_PLE_WIN_BASE", 0u);
    O.pleWinRows = H_EnvU32("M15_PLE_WIN_ROWS", 65536u);
    O.pleStageMask = H_EnvU32("M15_PLE_STAGE", 31u);
    O.pleNegMask = H_EnvU32("M15_PLE_NEG", 0u);
    O.pleMiswire = H_EnvU32("M15_PLE_MISWIRE", 0u);
    O.pleStateCarry = (H_EnvU32("M15_PLE_STATECARRY", 1u) != 0u) ? 1u : 0u;
    O.pleVocabReal = (H_EnvU32("M15_PLE_VOCAB_REAL", 0u) != 0u) ? 1u : 0u;
    O.pleReduced = H_EnvU32("M15_PLE_REDUCED", 4096u);
    // ---- M110：prefill 档 ----
    O.pfWire = (H_EnvU32("M15_PREFILL_WIRE", 0u) != 0u) ? 1u : 0u;
    O.pfMutant = H_EnvU32("M15_PREFILL_MUTANT", 0u);
    O.pfKinds = H_EnvU32("M15_PREFILL_KIND", 3u);
    // M140：相位掩码。位与 `M15L::PF_STAGE_{H1,A,H2,B}` 一致（1/2/4/8）；0 也读成"全开"
    // （与 kernel 内 `pfStageMask == 0 → PF_STAGE_ALL` 的语义对齐）。
    O.pfPhases = H_EnvU32("M15_PREFILL_PHASES", M15L::PF_STAGE_A);
    O.pfNoPad = (H_EnvU32("M15_PREFILL_NO_PAD", 0u) != 0u) ? 1u : 0u;
    O.pfPadByte = H_EnvU32("M15_PREFILL_PAD_BYTE", 0u) & 0xFFu;
    O.pfProlog = (H_EnvU32("M15_PREFILL_PROLOG", 0u) != 0u) ? 1u : 0u;
    O.pfPrologMut = H_EnvU32("M15_PREFILL_PROLOG_MUT", 0u) & 3u;
    O.pfPrologScale = (H_EnvU32("M15_PREFILL_PROLOG_SCALE", 0u) != 0u) ? 1u : 0u;
    O.pfEpilog = (H_EnvU32("M15_PREFILL_EPILOG", 0u) != 0u) ? 1u : 0u;
    // M175：越界（>4）不再被 `& 7u` 静默折成 clean —— 照 `M15_PREFILL_PHASES` 的形态：响亮 WARN + 取 0，
    // 并记下原始越界值（`pfEpilogMutOor`），由挂 epilog 的档计入失败（见 H_PfGdnWired）。
    {
        const uint32_t epiMutRaw = H_EnvU32("M15_PREFILL_EPILOG_MUT", 0u);
        if (epiMutRaw > 4u) {
            printf("[m15][WARN] M15_PREFILL_EPILOG_MUT=%u 越界（只有 0..4 有定义：0=干净 / 1=转位 / "
                   "2,3=S5 / 4=S6）→ 取 0；挂 epilog 的档将计为失败\n", epiMutRaw);
            O.pfEpilogMut = 0u;
            O.pfEpilogMutOor = epiMutRaw;
        } else {
            O.pfEpilogMut = epiMutRaw;
            O.pfEpilogMutOor = 0u;
        }
    }
    if (O.pfPhases > M15L::PF_STAGE_ALL) {
        printf("[m15][WARN] M15_PREFILL_PHASES=%u 越界（≤%u）→ 取 %u\n", O.pfPhases, M15L::PF_STAGE_ALL,
               M15L::PF_STAGE_A);
        O.pfPhases = M15L::PF_STAGE_A;
    }
    if (O.pfKinds == 0u || O.pfKinds > 3u) {
        printf("[m15][WARN] M15_PREFILL_KIND=%u 越界（1=gdn/2=attn/3=both）→ 取 3\n", O.pfKinds);
        O.pfKinds = 3u;
    }
    if (getenv("M15_PREFILL_M") != nullptr) {
        O.pfMs.clear();
        std::string s(getenv("M15_PREFILL_M"));
        size_t p3 = 0;
        while (p3 < s.size()) {
            const size_t q = s.find(',', p3);
            const std::string tok = s.substr(p3, (q == std::string::npos) ? std::string::npos : q - p3);
            if (!tok.empty()) {
                const uint32_t v = static_cast<uint32_t>(atoi(tok.c_str()));
                if (v == 0u || v > M15Loop::M_PREFILL) {
                    printf("[m15][WARN] M15_PREFILL_M 里的 %u 越界（1..%u）→ 跳过\n", v, M15Loop::M_PREFILL);
                } else {
                    O.pfMs.push_back(v);
                }
            }
            if (q == std::string::npos) {
                break;
            }
            p3 = q + 1;
        }
        if (O.pfMs.empty()) {
            printf("[m15][WARN] M15_PREFILL_M 解析后为空 → 取默认 {1, %u}\n", M15Loop::M_PREFILL);
            O.pfMs = {1u, M15Loop::M_PREFILL};
        }
    }
    O.chainM = H_EnvU32("M15_CHAIN_M", 1u);
    if (O.chainM == 0u || O.chainM > M15H::M_MAX) {
        printf("[m15][WARN] M15_CHAIN_M=%u 越界（1..%u）→ 取 1\n", O.chainM, M15H::M_MAX);
        O.chainM = 1u;
    }
    if (getenv("M15_DUMP_SSM") != nullptr) {
        O.ssmDumpLayers.clear();
        std::string s(getenv("M15_DUMP_SSM"));
        size_t p = 0;
        while (p < s.size()) {
            const size_t q = s.find(',', p);
            const std::string tok = s.substr(p, (q == std::string::npos) ? std::string::npos : q - p);
            if (!tok.empty()) {
                O.ssmDumpLayers.push_back(static_cast<uint32_t>(atoi(tok.c_str())));
            }
            if (q == std::string::npos) {
                break;
            }
            p = q + 1;
        }
    }
}

// ============================================================
// 1. 权重 manifest（slice_layer_manifest.py 生成；纯 key=value 行，便于 C++ 直接解析）
// ============================================================
//
//   model_dir=/workspace/Qwen3.8-Flash-Next-MXFP4
//   num_layers=48
//   layer_kinds=linear_attention,linear_attention,linear_attention,full_attention,...
//   tensor layer=0 role=in_proj_qkv file=model-00001-of-00131.safetensors offset=26950216
//          bytes=52428800 dtype=BF16 rows=10240 cols=2560
//
// 只给 GDN 层（attention 层无 linear_attn 张量 → 该层没有被切片的权重）。

struct M15Tensor {
    uint32_t layer = 0;
    std::string role;
    std::string file;
    uint64_t offset = 0;
    uint64_t bytes = 0;
    std::string dtype;
    uint32_t rows = 0;
    uint32_t cols = 0;
};

struct M15Manifest {
    std::string modelDir;
    uint32_t numLayers = 0;
    std::vector<std::string> kinds;
    std::vector<M15Tensor> tensors;
};

static bool H_Kv(const std::string& line, const std::string& key, std::string& out)
{
    const std::string pat = key + "=";
    size_t p = line.find(pat);
    if (p == std::string::npos) {
        return false;
    }
    p += pat.size();
    size_t e = line.find(' ', p);
    out = line.substr(p, (e == std::string::npos) ? std::string::npos : e - p);
    return true;
}

static uint64_t H_KvU64(const std::string& line, const std::string& key, uint64_t dflt = 0)
{
    std::string s;
    if (!H_Kv(line, key, s)) {
        return dflt;
    }
    return static_cast<uint64_t>(strtoull(s.c_str(), nullptr, 10));
}

static bool H_LoadManifest(const char* path, M15Manifest& M)
{
    FILE* f = fopen(path, "rb");
    if (f == nullptr) {
        return false;
    }
    std::string text;
    char buf[4096];
    size_t n = 0;
    while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
        text.append(buf, n);
    }
    fclose(f);

    size_t p = 0;
    while (p <= text.size()) {
        size_t e = text.find('\n', p);
        if (e == std::string::npos) {
            e = text.size();
        }
        const std::string line = text.substr(p, e - p);
        p = e + 1;
        if (line.empty() || line[0] == '#') {
            continue;
        }
        if (line.rfind("model_dir=", 0) == 0) {
            M.modelDir = line.substr(10);
        } else if (line.rfind("num_layers=", 0) == 0) {
            M.numLayers = static_cast<uint32_t>(H_KvU64(line, "num_layers"));
        } else if (line.rfind("layer_kinds=", 0) == 0) {
            const std::string s = line.substr(12);
            size_t q = 0;
            while (q <= s.size()) {
                const size_t r = s.find(',', q);
                const std::string tok = s.substr(q, (r == std::string::npos) ? std::string::npos : r - q);
                if (!tok.empty()) {
                    M.kinds.push_back(tok);
                }
                if (r == std::string::npos) {
                    break;
                }
                q = r + 1;
            }
        } else if (line.rfind("tensor ", 0) == 0) {
            M15Tensor T;
            T.layer = static_cast<uint32_t>(H_KvU64(line, "layer"));
            H_Kv(line, "role", T.role);
            H_Kv(line, "file", T.file);
            T.offset = H_KvU64(line, "offset");
            T.bytes = H_KvU64(line, "bytes");
            H_Kv(line, "dtype", T.dtype);
            T.rows = static_cast<uint32_t>(H_KvU64(line, "rows"));
            T.cols = static_cast<uint32_t>(H_KvU64(line, "cols"));
            M.tensors.push_back(T);
        }
    }
    return M.numLayers > 0 && !M.modelDir.empty();
}

static const M15Tensor* H_FindTensor(const M15Manifest& M, uint32_t layer, const char* role)
{
    for (const M15Tensor& T : M.tensors) {
        if (T.layer == layer && T.role == role) {
            return &T;
        }
    }
    return nullptr;
}

// 从 checkpoint 分片里 pread 一段（返回目标字节数）
static bool H_ReadTensor(const M15Manifest& M, const M15Tensor& T, std::vector<uint8_t>& dst, std::string& err)
{
    const std::string path = M.modelDir + "/" + T.file;
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) {
        err = "cannot open " + path;
        return false;
    }
    dst.resize(static_cast<size_t>(T.bytes));
    if (fseek(f, static_cast<long>(T.offset), SEEK_SET) != 0) {
        fclose(f);
        err = "fseek failed in " + path;
        return false;
    }
    const size_t got = fread(dst.data(), 1, dst.size(), f);
    fclose(f);
    if (got != dst.size()) {
        char b[160];
        snprintf(b, sizeof(b), "short read %zu/%zu in %s (offset %llu)", got, dst.size(), path.c_str(),
                 static_cast<unsigned long long>(T.offset));
        err = b;
        return false;
    }
    return true;
}

// ============================================================
// 2. host 侧权重：小权重（参考链/判据要用的）常驻 host，大权重（in_proj/out_proj）流式 H2D
// ============================================================

// 单个 GDN 层权重装载（真实 checkpoint → W 的小权重字段；大权重的装载见 H_StreamBigW）
static bool H_LoadSmallW(const M15Manifest& M, uint32_t layer, M15LayerW& W, std::string& err)
{
    using namespace M15G;
    W.layer = layer;
    W.real = true;
    std::vector<uint8_t> raw;
    auto readRole = [&](const char* role, std::vector<uint8_t>& out) -> bool {
        const M15Tensor* T = H_FindTensor(M, layer, role);
        if (T == nullptr) {
            err = std::string("manifest 缺 role=") + role + " (layer " + std::to_string(layer) + ")";
            return false;
        }
        return H_ReadTensor(M, *T, out, err);
    };

    // conv1d：ckpt [CH,1,KW] → 目标 [KW,CH]（索引保持：ckpt[ch][0][j] → convW[j*CH+ch]）
    {
        std::vector<uint8_t> ck;
        if (!readRole("conv1d", ck)) {
            return false;
        }
        const size_t need = static_cast<size_t>(CH) * KW * 2;
        if (ck.size() != need) {
            err = "conv1d 字节数不符";
            return false;
        }
        const uint16_t* src = reinterpret_cast<const uint16_t*>(ck.data());
        W.convW.assign(static_cast<size_t>(KW) * CH, 0);
        for (uint32_t ch = 0; ch < CH; ++ch) {
            for (uint32_t j = 0; j < KW; ++j) {
                W.convW[static_cast<size_t>(j) * CH + ch] = src[static_cast<size_t>(ch) * KW + j];
            }
        }
    }
    // conv bias：checkpoint 无此张量（config attention_bias=false）→ 全零
    W.convBias.assign(CH, 0);
    // A_log / dt_bias：ckpt bf16[48] → fp32[64]（48 有效 + 尾零，m9 donor 契约）
    {
        std::vector<uint8_t> a;
        if (!readRole("A_log", a)) {
            return false;
        }
        if (a.size() != HEADS * 2) {
            err = "A_log 字节数不符";
            return false;
        }
        const uint16_t* s = reinterpret_cast<const uint16_t*>(a.data());
        W.aLog.assign(64, 0.0f);
        for (uint32_t h = 0; h < HEADS; ++h) {
            W.aLog[h] = H_Bf16ToF32(s[h]);
        }
    }
    {
        std::vector<uint8_t> a;
        if (!readRole("dt_bias", a)) {
            return false;
        }
        if (a.size() != HEADS * 2) {
            err = "dt_bias 字节数不符";
            return false;
        }
        const uint16_t* s = reinterpret_cast<const uint16_t*>(a.data());
        W.dtBias.assign(64, 0.0f);
        for (uint32_t h = 0; h < HEADS; ++h) {
            W.dtBias[h] = H_Bf16ToF32(s[h]);
        }
    }
    // gammaG = linear_attn.norm.weight [HEAD_D]
    {
        std::vector<uint8_t> a;
        if (!readRole("norm", a)) {
            return false;
        }
        if (a.size() != static_cast<size_t>(HEAD_D) * 2) {
            err = "norm 字节数不符";
            return false;
        }
        W.gammaG.assign(HEAD_D, 0);
        __builtin_memcpy(W.gammaG.data(), a.data(), a.size());
    }
    // gamma1/gamma2（层输入 / 层出口 RMSNorm 的 gamma [HIDDEN]）：**checkpoint 里没有**
    // 该形状的层级 norm（该模型把归一化放在 hyper-connection 模块里，hc_norm.weight 是
    // [4×HIDDEN]，见 README §「缺口」）→ 按层号确定性合成 ∈[0.5,1.5]（m13 同款处置）。
    W.gamma1.assign(HIDDEN, 0);
    W.gamma2.assign(HIDDEN, 0);
    H_GenBf16(W.gamma1, 5000u + layer, 0.5f);
    H_GenBf16(W.gamma2, 6000u + layer, 0.5f);
    for (size_t k = 0; k < W.gamma1.size(); k += 97) {
        W.gamma1[k] = H_F32ToBf16(1.0f);
    }
    for (size_t k = 0; k < W.gamma2.size(); k += 89) {
        W.gamma2[k] = H_F32ToBf16(1.0f);
    }
    return true;
}

// 大权重（in_proj/out_proj）装配到 host 缓冲：
//   real 模式：in_proj = ckpt qkv|z|b|a 四个张量**按行拼接**（各自 row-major [N,2560]，
//              直接顺序拷贝字节即得 [16480,2560]）；out_proj 直接拷贝。
//   synth 模式：按层号加盐合成（层间不同）——但 84MB×36 的合成太慢，默认退化为**全局共享**
//              一份（见 README：synth 模式只用于 bring-up 冒烟，不承担「层间权重可区分」的判据）。
static bool H_AssembleBigW(const M15Manifest& M, uint32_t layer, bool real, const uint16_t* synthWIn,
                           const uint16_t* synthWOut, std::vector<uint16_t>& wIn, std::vector<uint16_t>& wOut,
                           std::string& err)
{
    using namespace M15G;
    if (!real) {
        wIn.assign(synthWIn, synthWIn + static_cast<size_t>(IN_N) * HIDDEN);
        wOut.assign(synthWOut, synthWOut + static_cast<size_t>(OUT_N) * OUT_K);
        return true;
    }
    wIn.resize(static_cast<size_t>(IN_N) * HIDDEN);
    static const char* kRoles[4] = {"in_proj_qkv", "in_proj_z", "in_proj_b", "in_proj_a"};
    size_t elems = 0;
    for (const char* role : kRoles) {
        const M15Tensor* T = H_FindTensor(M, layer, role);
        if (T == nullptr) {
            err = std::string("manifest 缺 role=") + role;
            return false;
        }
        std::vector<uint8_t> raw;
        if (!H_ReadTensor(M, *T, raw, err)) {
            return false;
        }
        if (raw.size() % 2 != 0 || elems + raw.size() / 2 > wIn.size()) {
            err = std::string("in_proj 拼接越界 role=") + role;
            return false;
        }
        __builtin_memcpy(wIn.data() + elems, raw.data(), raw.size());
        elems += raw.size() / 2;
    }
    if (elems != wIn.size()) {
        err = "in_proj 拼接行数不符（qkv|z|b|a != 16480）";
        return false;
    }
    const M15Tensor* T = H_FindTensor(M, layer, "out_proj");
    if (T == nullptr) {
        err = "manifest 缺 role=out_proj";
        return false;
    }
    std::vector<uint8_t> raw;
    if (!H_ReadTensor(M, *T, raw, err)) {
        return false;
    }
    if (raw.size() != static_cast<size_t>(OUT_N) * OUT_K * 2) {
        err = "out_proj 字节数不符";
        return false;
    }
    wOut.assign(reinterpret_cast<const uint16_t*>(raw.data()),
                reinterpret_cast<const uint16_t*>(raw.data()) + raw.size() / 2);
    return true;
}

}  // namespace M15Run
// ============================================================
// 3. device 侧上下文 / 分配 / 启动 / 状态
// ============================================================

namespace M15Run {

struct Ctx {
    aclrtStream stream = nullptr;
    uint32_t numBlocks = 0;      // AIC 数（mix(1,2) 的 blockDim）
    Opts O;
    M15Manifest M;
    bool real = false;

    std::vector<M15LayerW> W;    // NL 层的小权重（attention 层为空表）
    std::vector<H_Ref> R;        // GDN 层参考状态（按 slot 索引）

    uint32_t topk = 2;           // MoE 段运行期 top-k（缩形档：golden 数据集 10 → 2）

    // ---- M40 融合形态的设备缓冲 ----
    void* moeWDev = nullptr;     // 48 × MOE_W_STRIDE（每层 MoE 段权重；attention 层也有）
    void* wsFusedDev = nullptr;  // 融合 ws（GDN 段 @0 + MoE 段 @WS_MOE_OFF）
    void* wsGdnDev = nullptr;    // 「段间零串扰」对照路：独立 GDN/attn 段的 ws
    void* wsMoeDev = nullptr;    // 「段间零串扰」对照路：独立 MoE 段的 ws（MoE 段基址）
    void* xFusedDev = nullptr;   // 融合路层输入
    void* yFusedDev = nullptr;   // 融合路层输出
    void* ySubDev = nullptr;     // 独立子层段输出
    void* xMoeDev = nullptr;     // 独立 MoE 段输入
    void* yMoeDev = nullptr;     // 独立 MoE 段输出
    std::vector<uint8_t> moeArena;    // MoE 权重 host 期望镜像（与设备槽同布局）
    std::vector<uint8_t> moeDevBackup;  // MoE 权重槽回读
    std::vector<uint8_t> hcArena;     // M58：hc 权重 host 期望镜像（与设备槽同布局）

    void* wsDev = nullptr;           // 48 层循环共用的层 workspace
    void* wsDirectDev = nullptr;     // 「单层直接调用」用的层 workspace
    void* wDev = nullptr;            // N_GDN × W_STRIDE（权重区）
    void* stDev = nullptr;           // N_GDN × ST_STRIDE（状态区，跨 token 常驻）
    void* hDev[2] = {nullptr, nullptr};   // 残差流双缓冲（只用行 0）
    void* resZeroDev = nullptr;      // S1 的零残差输入
    void* xDirectDev = nullptr;      // 直接调用的层输入（行 0 = h_in）
    void* yDirectDev = nullptr;      // 直接调用的层输出（行 0）
    void* csDirectDev = nullptr;     // 直接调用的 conv_state 快照
    void* ssmDirectDev = nullptr;    // 直接调用的 ssm_state 快照

    // 权重来源校验用（review P2-1）：与设备权重区**同布局**的 host 期望镜像 + 设备回读
    std::vector<uint8_t> hostArena;
    std::vector<uint8_t> devBackup;

    std::vector<uint16_t> csInit;    // [ST*CH] bf16
    std::vector<float> ssmInit;      // [HEADS*128*128] fp32
    std::vector<uint16_t> h0[8];     // 每个 token 的层输入（只用 steps 个）

    // ---- M58：hc 段（四相位融合形态）----
    void* hcWDev = nullptr;        // 48 × HC_LAYER_W_STRIDE（每层两个边界：attn_hc / mlp_hc）
    void* hcWsDev = nullptr;       // (NL + 3) × HC_WS_LAYER_STRIDE（每层两块 + 3 块验证 H 用的 scratch）
    void* hcHDev = nullptr;        // [M_MAX, HYPER] 层输入（4 路多流残差）
    void* hcBoDev = nullptr;       // [M_MAX, HIDDEN] pending block output（上一层 mlp_out）
    void* hcIjDev = nullptr;       // [M_MAX, IJ_STRIDE] pending injection logits（前 4 列有效）
    void* hcAttnOutDev = nullptr;  // [M_MAX, HIDDEN] 子层段出口（= hc(mlp) 的 BO）

    // ---- M100：PLE 段的 device 平面（层 1 的打断点；尺寸来自 M15L::PLEW）----
    void* pleWDev = nullptr;         // 权重 slab：wcat | wtap | nk | nq | ncw
    void* pleScrDev = nullptr;       // scratch slab（ids/emb/kv/gated/normed/sidx/fail/exp64/hmBad/st）
    void* pleIdsDev = nullptr;       // [T] int32
    void* pleQslDev = nullptr;       // [2] int32
    void* pleCtxDev = nullptr;       // [NC] int32
    void* pleMDev = nullptr;         // [3] int64
    void* pleSzDev = nullptr;        // [16] int64
    void* pleOfDev = nullptr;        // [16] int64
    void* pleTableDev = nullptr;     // host-mapped 窗口的 device 指针（M92 的 ACL 链路）
    void* pleTableHost = nullptr;    // 窗口的 host 地址（注册/解注册）
    size_t pleTableBytes = 0;
    uint64_t pleTableOff = 0;        // 窗口首行在分片文件里的绝对偏移（见证用）
    std::string pleTableFile;        // 窗口来自哪个分片文件
    std::vector<uint8_t> pleWinHost;  // 窗口字节的 host 副本（② 判据的比对源）

    // ---- M65：48 层链 ----
    void* chainBoDev = nullptr;    // CH_BO_PLANES × [M_MAX, HIDDEN]：pending BO 的双缓冲平面
                                   //（层 L 的 mlp_out → 层 L+1 的 hc(attn) combine 负载）

    // ---- M110：prefill 的契约与挂载点档（按 **真实 m** 定尺，不是 M_MAX）----
    // x / y 平面各 `M15Loop::H_ROWS_BYTES_PF` = 4097×2560×2 = 20,976,640 B；pos 表 u32[4097]
    void* pfXDev = nullptr;        // bf16[M_PREFILL, HIDDEN] 层输入（行头 8 字节 = 行标记）
    void* pfYDev = nullptr;        // bf16[M_PREFILL, HIDDEN] 层输出（host 预填毒值 0xA5）
    void* pfPosDev = nullptr;      // u32[M_PREFILL] per-row 位置表
    std::vector<uint8_t> pfXHost;  // host 侧 x（判据的比对面之一）
    std::vector<uint8_t> pfYHost;  // host 读回的 y
    std::vector<int32_t> pfPosHost;  // host 侧位置表（= 行号；单请求连续契约的见证）
    uint32_t phasePf = 0;          // M110：验证 Pf 的判定项数

    // ---- M136（Wave D）：prefill 段体的**真指针平面**（只在 `M15_PREFILL_WIRE=1` 时分配）----
    // 尺寸口径见 `H_PfSegAlloc`；几何与 m23 的 dump/参考契约同一套（Tp = m + PF_GDN_QK_PAD_ROWS）。
    void* pfGdnQDev = nullptr;       // [NK, Tp, 128] fp32（pad 行置零）
    void* pfGdnKDev = nullptr;       // 同 q
    void* pfGdnVDev = nullptr;       // [48, m, 128] fp32
    void* pfGdnGDev = nullptr;       // [48, tp=align8(m)] fp32
    void* pfGdnBetaDev = nullptr;    // [48, tp] fp32
    void* pfGdnODev = nullptr;       // [48, m, 128] fp32 段出口
    void* pfGdnStateDev = nullptr;   // [48,128,128] fp32：h0 入 / ht 出（in-place）
    void* pfGdnScratchDev = nullptr; // [nAic, GP_SLOT_BYTES] 段私有 GM 工作区
    void* pfMoeWsDev = nullptr;      // WS_MOE_OFF + M15PFR::PWS_BYTES（B4 的 ws）
    void* pfMoeRouterWPadDev = nullptr;  // [E_PAD=640, 2560] bf16（host 组板）
    void* pfHcArena0Dev = nullptr;   // B5 边界 #1 arena（≥ M15H::HcPF::ArenaBytes(M_PREFILL)）
    void* pfHcArena1Dev = nullptr;   // B5 边界 #2 arena
    void* pfHcBlk0Dev = nullptr;     // [m, HID] bf16（BLK 平铺面）
    void* pfHcBlk1Dev = nullptr;
    void* pfHcIj0Dev = nullptr;      // [(m + M_MAX) * 32 B]（ij handoff 平铺面）
    std::vector<float> pfGdnQHost;   // host 侧干净副本（dump / 参考的输入面）
    std::vector<float> pfGdnKHost;
    std::vector<float> pfGdnVHost;
    std::vector<float> pfGdnGHost;
    std::vector<float> pfGdnBetaHost;
    std::vector<float> pfGdnH0Host;
    std::vector<float> pfGdnOHost;   // device 回读
    std::vector<float> pfGdnHtHost;
    std::string pfDumpDir;           // m23 兼容 dump 目录（M15_PREFILL_DUMPDIR）

    // ---- M140：hc 四相位（H1/A/H2/B）的 prefill 平面 + 真实 shape（E=512）的 MoE 权重区 ----
    // 只 `M15_PREFILL_WIRE=1` 且相位掩码含 H1/H2/B 时分配（见 `H_PfSegAlloc`）；decode 路径零占用。
    void* pfHcHDev = nullptr;        // [m, HYPER=10240] bf16：H1 的 hIn（层输入多流残差）
    void* pfHcBoDev = nullptr;       // [m, HID=2560] bf16：H1 的 bo（pending block output）
    void* pfHcIjDev = nullptr;       // [m, 16] bf16：H1 的 ij（pending injection logits）
    void* pfHcAttnOutDev = nullptr;  // [m, HID] bf16：H2 的 bo（子层段出口；**生产者缺口**见 evidence）
    void* pfMoeWPrefillDev = nullptr;// E=512 的 MoE 权重区（每层 MOE_W_PREFILL_STRIDE）
    std::vector<uint8_t> pfHcHH, pfHcBoH, pfHcIjH, pfHcAttnOutH;   // host 侧合成输入（判据的输入面）
    std::vector<uint8_t> pfHcArena0H, pfHcArena1H, pfHcBlk0H, pfHcBlk1H, pfHcIj0H, pfMoeYH;  // device 回读
    std::vector<uint8_t> pfMoeRouter512H, pfMoeSgate512H;          // E=512 router/sgate 的 host 副本（组板用）
    std::vector<uint8_t> pfMoe512Host;                             // E=512 MoE 权重区的 host 镜像（1.34 GB/层）
    bool pfMoe512Loaded = false;                                   // 幂等装载标记（多档复用同一次 H2D）
    void* pfMoeInDev = nullptr;                                    // 相位 B **实际**用的输入面（H2 开 ⇒ pfHcBlk1Dev；否则 pfXDev）

    // ---- M197（B2 挂载）：attention 前端在**真实层路径**里的 5 个 scratch 平面 + w/cs ----
    // 只 `M15_PREFILL_WIRE=1` 时分配（见 `H_PfSegAlloc`）；decode 路径零占用。
    // 尺寸 = `m24_attn_prefill/README.md` §5.2（与 m15_layer_kernel.h 的 static_assert 同一组）。
    void* pfattnY0Dev = nullptr;      // [PF_ROWS=128, PF_Y0_STRIDE=13952] bf16 = 3,571,712 B
    void* pfattnOutDev = nullptr;     // [PF_ROWS, PF_OUT_STRIDE=13952] bf16 = 3,571,712 B
    void* pfattnInDev = nullptr;      // AC_IN_BYTES = 299,264 B
    void* pfattnPooledDev = nullptr;  // AC_POOLED_BYTES = 8,192 B
    void* pfattnFlagDev = nullptr;    // AC_FLAG_LANES(8) × 4 = 32 B
    void* pfattnWDev = nullptr;       // M15AP::W_BYTES（attention 8 role 权重平面）
    void* pfattnCsDev = nullptr;      // M15AP::AP_CS_BYTES（cos/sin 表）
    std::vector<uint8_t> pfattnWHost, pfattnCsHost, pfattnPackHost;  // host 侧确定性输入面
    std::vector<uint8_t> pfattnY0H, pfattnOutH, pfattnInH;           // device 回读（判据的比对面）

    // ---- M151：prefill prolog 链路（S2 in_proj + S3 conv1d/l2norm/gating）----
    // 只 `M15_PREFILL_PROLOG=1` 时分配；decode/H1-A 路径零占用。契约见 evidence/m151_prefill_prolog_wiring/CONTRACT.md。
    void* pfQkvzbaDev = nullptr;    // [M_PREFILL, 16480] bf16：S2（in_proj）输出 = S3 的 x 输入
    void* pfConvStateDev = nullptr; // [3, 10240] bf16：S3 的 conv_state（in-place RMW）
    std::vector<uint8_t> pfQkvzbaH;         // host 读回（S2 出，供 m11 对拍）
    std::vector<uint8_t> pfConvStateInitH;  // conv_state 初值（host 副本，供参考）
    std::vector<uint8_t> pfConvStateOutH;   // conv_state 出口（device 读回）

    // ---- M164：prefill epilog 链路（transpose + S5 RMSNormGated + S6 out_proj）----
    // 只 `M15_PREFILL_EPILOG=1` 且 prolog 开时分配；decode/H1-A 路径零占用。
    // 契约见 evidence/m164_epilog_mount/CONTRACT.md。
    void* pfOTokDev = nullptr;      // [M_PREFILL, 6144] fp32：转位后 token-major o（S5 的 o 输入）
    void* pfZTokDev = nullptr;      // [M_PREFILL, 6144] bf16：z 压实（S5 的 z 输入）
    void* pfYTokDev = nullptr;      // [M_PREFILL, 6144] bf16：S5 出 = S6 的 A 面（转位/S5 之间的 GM 面）
    std::vector<uint8_t> pfOTokH;       // device 读回（dump / 段级判据）
    std::vector<uint8_t> pfZTokH;
    std::vector<uint8_t> pfYTokH;
    std::vector<uint8_t> pfEpiAttnOutH; // epilog 出口回读（[0,m) 行；0xCD 残渣 / 非零 / 有限判据）

    // ---- M82：attention 侧**三套 cache + packed indices**（跨 12 个 attention 层长寿；
    //      按「第 k 个 attention 层」编址，k = 0..11 ↔ 0-based 层号 3,7,…,47 = `AttnSlot()`）----
    // 物理字节布局的唯一权威 = `m15_attn_kv.h`（每层 stride / 平面字节数都在那里，本结构体只持指针）
    void* attnKvDev = nullptr;        // N_ATTN × KV_LAYER_STRIDE = 50,528,256 B（257 页/层 × 16,384 B）
    void* attnCompDev = nullptr;      // N_ATTN × COMP_LAYER_STRIDE = 3,158,016 B（1,028 行/层 × 256 B）
    void* attnRingDev = nullptr;      // N_ATTN × RING_LAYER_STRIDE = 13,440 B（4 行/层 × 280 B）
    void* attnPackDev = nullptr;      // PACK_PLANE_BYTES = 33,628,176 B（**层间复用一块**：12 层流内串行）
    void* attnTblDev = nullptr;       // int32[KV_TBL_ELEMS]：单请求 block_table（恒等 / 负向对照两档）
    void* attnSeedDev = nullptr;      // 探针输入平面（kv 512 | ring 140 | comp 128，三段对齐）
    void* attnPackSeedDev = nullptr;  // packed 两行的**期望内容**（host 生成 ⇒ 逐字节判据在 host 闭合）
    void* attnProbeOutDev = nullptr;  // 探针读回缓冲（区段偏移见 m15_attn_kv_probe.h）
    std::vector<uint8_t> attnSeed;        // host 侧副本（判据的比对面）
    std::vector<uint8_t> attnPackSeed;    // host 侧副本
    std::vector<uint8_t> attnProbeOut;    // host 读回
    std::vector<int32_t> attnTbl;         // host 侧 block_table
    uint32_t phaseKv = 0;                 // M82：验证 Kv 的判定项数

    // ---- M88：attention 前端 prolog（**单层探针档**；见 m15_attn_prolog_host.h）----
    // 层号固定 3（任务口径「先只接 1 层（层 3）」；它是 attention 序列的第 0 个，
    // 对应 `m15_loop_layout.h` 的 `AttnSlot(3) == 0`）
    void* apWDev = nullptr;       // M15AP::W_BYTES：8 个 role 的权重平面（512 B 对齐）
    void* apXDev = nullptr;       // 2 行 × HIDDEN bf16（行 0/1 = x0/x1；AIC 侧 Nd2Nz 的 2 行契约）
    void* apCsDev = nullptr;      // M15AP::AP_CS_BYTES：host 预生成的 cos/sin 表（bf16）
    void* apY0Dev = nullptr;      // Y0_N bf16：4 个 GEMM 的原始输出
    void* apOutDev = nullptr;     // OUT_N bf16：prolog 的输出
    std::vector<uint8_t> apW;         // host 侧权重平面
    std::vector<uint8_t> apWRole;     // 单个 role 的 pread 暂存
    std::vector<uint8_t> apIn;        // 输入面（2 行）
    std::vector<uint8_t> apCs;        // cos/sin 表
    std::vector<uint8_t> apY0;        // device 读回
    std::vector<uint8_t> apOut;       // device 读回
    std::vector<uint8_t> apExpY0[2];  // 期望（x0 / x1）
    std::vector<uint8_t> apExpOut[2];
    std::vector<uint8_t> apNormOnly[2];   // 诊断：oracle 的「norm 后 / rope 前」（区分 norm 错 vs rope 错）
    std::vector<float> apExactY0[2];  // GEMM 的 fp64 精确值（落 fp32）＋ Σ|terms|，T2′ 用
    std::vector<float> apTermsY0[2];
    std::vector<float> apTermsOut[2];
    uint32_t phaseProlog = 0;         // M88：验证 prolog 的判定项数
    uint32_t phaseAttnWire = 0;       // M97：验证 AttnWire（融合 kernel 的 attention 相位 A）的判定项数
    std::string manifestPath;         // 数据目录以 manifest 为锚点（不随 cwd 漂）

    // 判据统计：checks = 实质判定项（逐字节/容差/网格比对，会计入失败）；
    //           guards = 恒真守护（如「参考链锚点非空」的前置断言，不打印 PASS、不计入判定项）
    uint32_t checks = 0;
    uint32_t guards = 0;
    uint32_t phaseA = 0;
    uint32_t phaseB = 0;
    uint32_t phaseC = 0;
    uint32_t phaseW = 0;
    uint32_t phaseMw = 0;    // M40：MoE 权重来源判据
    uint32_t phaseMm = 0;    // M40：验证 M1（段间零串扰）
    uint32_t phaseM2 = 0;    // M40：验证 M2（多 token 融合形态）
    uint32_t phaseWh = 0;    // M58：hc 权重来源判据
    uint32_t phaseMh = 0;    // M58：验证 H（四相位融合形态）
    uint32_t phaseCh = 0;    // M65：验证 Ch（48 层链 + PLE 打断点 + 末层 mixer）
    uint32_t phasePw = 0;    // M100：验证 Pw（PLE 段接进融合 kernel 的真实挂接路径）
    // guard 的**分类计数**（review r1 的 P2-1b：guard 汇总行必须写出真实分解，不许把全部
    // guard 都叫「参考链锚点非空」）
    uint32_t guardsSha = 0;  // sha256 工具自检（1 条）
    uint32_t guardsHc = 0;   // M58：hc 权重槽的注入行 [4,16) 全零见证（每层 1 条）
    uint32_t guardsRef = 0;  // 参考链锚点非空（Ver B 逐层逐 token）
    uint32_t guardsCh = 0;   // M65：验证 Ch 的结构性 guard（接线地址、M39 对拍落盘前提等）
    size_t gbPadDiffBytes = 0;   // 报告项：g/β padding 车道差异字节数（不计入判定项）
    uint32_t gbPadDiffMax = 0;
    uint32_t fails = 0;
    std::vector<std::string> dumpLines;
};

static double H_NowMs()
{
    using namespace std::chrono;
    return duration<double, std::milli>(steady_clock::now().time_since_epoch()).count();
}

static void H_H2D(Ctx& C, void* dev, const void* host, size_t bytes, const char* tag)
{
    const aclError e = aclrtMemcpy(dev, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    if (e != ACL_SUCCESS) {
        printf("[m15][FAIL] H2D %s failed (err %d, %zu bytes)\n", tag, static_cast<int>(e), bytes);
        C.fails++;
    }
}

static void H_D2H(Ctx& C, void* host, const void* dev, size_t bytes, const char* tag)
{
    const aclError e = aclrtMemcpy(host, bytes, dev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (e != ACL_SUCCESS) {
        printf("[m15][FAIL] D2H %s failed (err %d, %zu bytes)\n", tag, static_cast<int>(e), bytes);
        C.fails++;
    }
}

static bool H_Sync(Ctx& C, const char* tag)
{
    const aclError e = aclrtSynchronizeStream(C.stream);
    if (e != ACL_SUCCESS) {
        printf("[m15][FAIL] sync after %s failed (err %d): %s\n", tag, static_cast<int>(e), aclGetRecentErrMsg());
        C.fails++;
        return false;
    }
    return true;
}

static uint8_t* H_W(Ctx& C, uint32_t layer, uint32_t off)
{
    const uint32_t slot = M15Loop::LayerSlot(layer);
    return reinterpret_cast<uint8_t*>(C.wDev) + static_cast<size_t>(slot) * M15Loop::W_STRIDE + off;
}

static uint8_t* H_ST(Ctx& C, uint32_t layer, uint32_t off)
{
    const uint32_t slot = M15Loop::LayerSlot(layer);
    return reinterpret_cast<uint8_t*>(C.stDev) + static_cast<size_t>(slot) * M15Loop::ST_STRIDE + off;
}

static void* H_H(Ctx& C, uint32_t idx)
{
    return C.hDev[idx & 1u];
}

// 每层一次 kernel 启动：GDN 层 → m15_gdn_layer_kernel；attention 层 → 占位直通 kernel
static void H_Launch(Ctx& C, uint32_t layer, void* ws, void* xDev, void* yDev, void* csDev, void* ssmDev)
{
    using namespace M15G;
    if (M15Loop::KindOf(layer) == M15Loop::KIND_ATTN) {
        m15_attn_placeholder_kernel<<<C.numBlocks, 0, C.stream>>>(reinterpret_cast<uint8_t*>(xDev),
                                                                  reinterpret_cast<uint8_t*>(yDev),
                                                                  M15Loop::H_BYTES);
        return;
    }
    m15_gdn_layer_kernel<<<C.numBlocks, 0, C.stream>>>(
        reinterpret_cast<uint8_t*>(ws), reinterpret_cast<uint8_t*>(xDev),
        reinterpret_cast<uint8_t*>(C.resZeroDev), reinterpret_cast<uint8_t*>(yDev),
        H_W(C, layer, M15Loop::W_G1_OFF), H_W(C, layer, M15Loop::W_G2_OFF),
        H_W(C, layer, M15Loop::W_GG_OFF), H_W(C, layer, M15Loop::W_IN_OFF),
        H_W(C, layer, M15Loop::W_OUT_OFF), H_W(C, layer, M15Loop::W_CONV_OFF),
        H_W(C, layer, M15Loop::W_CONVB_OFF), H_W(C, layer, M15Loop::W_ALOG_OFF),
        H_W(C, layer, M15Loop::W_DTB_OFF), reinterpret_cast<uint8_t*>(csDev),
        reinterpret_cast<uint8_t*>(ssmDev));
}

// 状态回到初值（每个验证 run 独立起跑；参考状态同步复位）
static void H_ResetStates(Ctx& C)
{
    for (uint32_t L = 0; L < NL; ++L) {
        if (M15Loop::KindOf(L) != M15Loop::KIND_GDN) {
            continue;
        }
        H_H2D(C, H_ST(C, L, 0), C.csInit.data(), M15Loop::CS_BYTES, "cs_init");
        H_H2D(C, H_ST(C, L, M15Loop::SSM_OFF), C.ssmInit.data(), M15Loop::SSM_BYTES, "ssm_init");
        H_Ref& R = C.R[M15Loop::LayerSlot(L)];
        R.cs = C.csInit;
        R.ssm = C.ssmInit;
    }
}

// 残差流回到「本 token 的输入」（hDev[0] 行 0 = h0[token]；两个缓冲其余字节恒为 0）
static void H_ResetH(Ctx& C, uint32_t token)
{
    for (uint32_t i = 0; i < 2; ++i) {
        const aclError e = aclrtMemset(C.hDev[i], M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
        if (e != ACL_SUCCESS) {
            printf("[m15][FAIL] memset h[%u] failed\n", i);
            C.fails++;
        }
    }
    H_H2D(C, C.hDev[0], C.h0[token].data(), M15Loop::H_BYTES, "h0");
}

static bool H_InList(const std::vector<uint32_t>& v, uint32_t x)
{
    for (uint32_t e : v) {
        if (e == x) {
            return true;
        }
    }
    return false;
}

// ---- 判据包装（计数 + 打印）----
static bool H_CmpBytes(Ctx& C, const char* tag, const void* got, const void* exp, size_t n)
{
    C.checks++;
    const uint8_t* a = reinterpret_cast<const uint8_t*>(got);
    const uint8_t* b = reinterpret_cast<const uint8_t*>(exp);
    if (__builtin_memcmp(a, b, n) == 0) {
        printf("[m15]   %-30s PASS (逐字节一致, n=%zu)\n", tag, n);
        return true;
    }
    size_t bad = 0;
    size_t first = 0;
    for (size_t i = 0; i < n; ++i) {
        if (a[i] != b[i]) {
            if (bad == 0) {
                first = i;
            }
            ++bad;
        }
    }
    printf("[m15]   %-30s FAIL (%zu/%zu 字节不同; first off %zu got 0x%02x exp 0x%02x)\n", tag, bad, n, first, a[first],
           b[first]);
    C.fails++;
    return false;
}

static bool H_CmpOk(Ctx& C, bool r)
{
    C.checks++;
    if (!r) {
        C.fails++;
    }
    return r;
}

// guard：恒真的前置断言（例如「参考链锚点非空」）——**不计入判定项**，失败仍计入 fails。
// review P2-3 指出：把这类恒真调用记成判定项会让 checks 数字虚高且不可失败，故单列 guards。
static bool H_Guard(Ctx& C, bool r)
{
    C.guards++;
    if (!r) {
        C.fails++;
    }
    return r;
}

// ============================================================
// 4. dump（M15_DUMP=1；供 check_ref.py 独立复算）
// ============================================================

static void H_Dump(Ctx& C, const std::string& name, const void* buf, size_t bytes, const char* dtype,
                   const char* shape, const char* extra = "")
{
    if (!C.O.dump) {
        return;
    }
    const std::string path = name + ".bin";
    if (!H_WriteBin(path.c_str(), buf, bytes)) {
        printf("[m15][FAIL] dump 写盘失败 %s\n", path.c_str());
        C.fails++;
        return;
    }
    char line[320];
    snprintf(line, sizeof(line), "tensor=%s bytes=%zu dtype=%s shape=%s %s\n", name.c_str(), bytes, dtype, shape, extra);
    C.dumpLines.emplace_back(line);
}

// ws 内的张量只 dump 行 0（m=1；ws 按 M_MAX 行分配，行 0 即本 token）
static void H_DumpWsRow(Ctx& C, const char* prefix, const std::vector<uint8_t>& ws, uint32_t off, uint32_t rowBytes,
                        const char* dtype, const char* shape)
{
    if (!C.O.dump) {
        return;
    }
    if (off + rowBytes > ws.size()) {
        printf("[m15][FAIL] dump ws 越界 %s off=%u\n", prefix, off);
        C.fails++;
        return;
    }
    char extra[96];
    snprintf(extra, sizeof(extra), "ws_off=%u row=0", off);
    H_Dump(C, prefix, ws.data() + off, rowBytes, dtype, shape, extra);
}

// ============================================================
// M40：MoE 段 权装载 / 来源校验 / 验证 M（实现在 m15_moe_host.h，见该文件头）
// ============================================================
#include "m15_moe_host.h"

// ============================================================
// 4b. M58：hc 段 权装载 / 来源校验 / 验证 H（实现在 m15_hc_host.h，见该文件头）
// ============================================================
#include "m15_hc_host.h"

// ============================================================
// 4c. M65：48 层链（四相位入口）+ PLE 打断点 + 末层全局 mixer（实现在 m15_chain_host.h）
// ============================================================
#include "m15_chain_host.h"

// ============================================================
// 4d. M82：attention 三套 cache 的布局判据 + 容量自检（实现在 m15_attn_kv_host.h）
// ============================================================
#include "m15_attn_kv_host.h"

// ============================================================
// 4e. M88：attention 前端 prolog 的判据 + 负向对照（实现在 m15_attn_prolog_host.h）
// ============================================================
#include "m15_attn_prolog_host.h"

// ============================================================
// 4f. M97：attention 相位 A 接进融合 kernel 的**接线见证**（新档 `runs=attnwire`）
// ============================================================
// 与 `runs=prolog`（M88）的区别：那一档走**独立探针入口** `m15_attn_prolog_probe_kernel`；
// 本档走**融合 kernel 的真实路径** `m15_layer_kernel_attn_hc`（`M15L_FusedBody<KIND_ATTN, true>`）：
//   hc(attn) → **attention 相位 A（W5/W6 的接线）** → hc(mlp) → MoE 段
// 它见证的是「接线之后，attention 臂在真实路径上产出的 y0/out 是否仍满足 M88 的判据」。
//
// 判据全部**沿用 M88 的同一套函数**（`H_ApCmpAll` / `H_ApNonVacuity` / 毒化），口径不变：
//   · `Ap.y0.*` 4 段 T2′；`Ap.out.q/.k/.qidx` T3；`Ap.copy.*` T1 逐字节 vs 设备自己的 y0；
//     `Ap.out.gate/.v/.kraw` T2′；
//   · 非空洞性：毒化 0xCD 之后平面仍被写出、改输入改输出、改 pos 改输出；
//   · 确定性：同配置重跑逐字节相同；
//   · 负向（规则方向）三档 + 变异（把被测对象弄坏）两档 + **接线级**两档，**每一档都必须让判据变红**。
static bool H_RunAttnWire(Ctx& C)
{
    using namespace M15G;
    const uint32_t L = H_ApLayer();          // 3（attention 序列的第 0 个）
    const uint32_t m = 1u;

    printf("\n[m15] ===== 验证 AttnWire（M97）：attention 相位 A 接进融合 kernel 后的 device 见证 =====\n");
    printf("[m15]   入口 = `%s`（四相位融合形态），层 = %u（KindOf=%u）\n", M15L::ENTRY_ATTN_HC, L,
           M15Loop::KindOf(L));
    printf("[m15]   与前档 `runs=prolog` 的差别：那档是**独立探针**入口；本档是**融合 kernel 的相位 A**。\n");
    if (M15Loop::KindOf(L) != M15Loop::KIND_ATTN) {
        printf("[m15][FAIL] 层 %u 不是 attention 层\n", L);
        return false;
    }

    const uint32_t checkBase = C.checks;
    const uint32_t guardBase = C.guards;
    bool ok = true;
    std::string err;
    ok = H_ApLoadWeights(C, L, err) && ok;
    ok = H_ApLoadData(C, err) && ok;
    if (!ok) {
        printf("[m15] 验证 AttnWire：前置（权重/输入/期望）失败\n");
        return false;
    }
    ok = H_ApNonVacuity(C, C.apExpOut[0], C.apExpY0[0], "x0") && ok;
    ok = H_ApNonVacuity(C, C.apExpOut[1], C.apExpY0[1], "x1") && ok;

    // 层界输入（确定性；与验证 H 同一套公式，salt 用本档专用值）
    std::vector<uint16_t> hin(static_cast<size_t>(M_MAX) * M15H::HYPER);
    std::vector<uint16_t> bo(static_cast<size_t>(M_MAX) * HIDDEN);
    std::vector<uint16_t> ij(static_cast<size_t>(M_MAX) * M15H::IJ_STRIDE);
    H_GenBf16(hin, 97001u, 1.0f);
    H_GenBf16(bo, 97002u, 0.8f);
    H_GenBf16(ij, 97003u, 1.5f);
    H_H2D(C, C.hcHDev, hin.data(), hin.size() * 2u, "aw_hin");
    H_H2D(C, C.hcBoDev, bo.data(), bo.size() * 2u, "aw_bo");
    H_H2D(C, C.hcIjDev, ij.data(), ij.size() * 2u, "aw_ij");

    // 一次融合启动。三个**接线级**的可错位量都是显式参数，负向对照靠它们：
    //   apWPtr    = 权重平面基址（nullptr ⇒ 接线关掉，kernel 回退占位直通）
    //   launchRow = A 操作数落在 x 的哪一行（0 = x0、1 = x1）
    //   cmpIdx    = 判据拿哪一份期望（0 = x0、1 = x1）——与 launchRow 错开即「实参错位」
    // 返回：本次的 FAIL 条数；`H_Sync` 失败返回 0xFFFFFFFF。
    auto runOnce = [&](void* apWPtr, uint32_t launchRow, uint32_t cmpIdx, uint32_t pos, uint32_t apMode,
                       bool counted, bool verbose, bool cmpOut) -> uint32_t {
        // **毒化承重**：两块读回平面每次 launch 前毒成 0xCD。不毒化时「本次什么都没写」会读到
        // 上一次的正确值而照常 PASS（假绿）；M88 r4 复审已独立复现过这一点。
        const size_t y0b = static_cast<size_t>(M15AP::Y0_N) * 2u;
        const size_t ob = static_cast<size_t>(M15AP::AP_OUT_N) * 2u;
        aclrtMemset(C.apY0Dev, y0b, 0xCD, y0b);
        aclrtMemset(C.apOutDev, ob, 0xCD, ob);
        uint8_t* hcw = reinterpret_cast<uint8_t*>(C.hcWsDev) + static_cast<size_t>(L) * M15L::HC_WS_LAYER_STRIDE;
        aclrtMemset(hcw, M15L::HC_WS_LAYER_STRIDE, 0xCD, M15L::HC_WS_LAYER_STRIDE);
        aclrtMemset(C.hcAttnOutDev, static_cast<size_t>(M_MAX) * HIDDEN * 2u, 0xCD,
                    static_cast<size_t>(M_MAX) * HIDDEN * 2u);
        aclrtMemset(C.yFusedDev, M15Loop::H_ROWS_BYTES, 0xCD, M15Loop::H_ROWS_BYTES);
        H_LaunchLayerHc(C, L, C.wsFusedDev, C.yFusedDev, nullptr, nullptr, C.hcHDev, C.hcBoDev, C.hcIjDev,
                        M15H::HC_IJ_STRIDE_PLANE, 0u, M15H::MODE_COMBINE_MIX, M15H::MODE_COMBINE_MIX, m, apWPtr,
                        reinterpret_cast<uint8_t*>(C.apXDev) +
                            static_cast<size_t>(launchRow) * M15AP::AP_HIDDEN * 2u,
                        C.apCsDev, C.apY0Dev, C.apOutDev, pos, apMode);
        if (!H_Sync(C, "aw_sync")) {
            return 0xFFFFFFFFu;
        }
        H_D2H(C, C.apY0.data(), C.apY0Dev, C.apY0.size(), "aw_y0");
        H_D2H(C, C.apOut.data(), C.apOutDev, C.apOut.size(), "aw_out");
        return H_ApCmpAll(C, C.apY0.data(), C.apOut.data(), cmpIdx, counted && cmpOut, verbose && cmpOut, cmpOut);
    };

    // ---- ① 契约档：x0 / x1，pos = 4096（计数 + 逐段打印）----
    const uint32_t f0 = runOnce(C.apWDev, 0u, 0u, 4096u, M15AP::AP_MODE_CONTRACT, true, true, true);
    if (f0 == 0xFFFFFFFFu) {
        return false;
    }
    const std::vector<uint8_t> y0X0 = C.apY0;
    const std::vector<uint8_t> outX0 = C.apOut;
    ok = H_Guard(C, f0 == 0u) && ok;

    // 非空洞性：毒化之后两块平面**本次真被写出**（非零元素过半）
    {
        uint32_t nzY0 = 0;
        uint32_t nzOut = 0;
        for (size_t i = 0; i + 1u < y0X0.size(); i += 2u) {
            if (y0X0[i] != 0u || y0X0[i + 1u] != 0u) {
                ++nzY0;
            }
        }
        for (size_t i = 0; i + 1u < C.apOut.size(); i += 2u) {
            if (C.apOut[i] != 0u || C.apOut[i + 1u] != 0u) {
                ++nzOut;
            }
        }
        printf("[m15]   Ap.wire.nonvac     报告项  毒化 0xCD 之后设备写出的非零：y0 %u/%u、out %u/%u\n", nzY0,
               M15AP::Y0_N, nzOut, M15AP::AP_OUT_N);
        ok = H_Guard(C, nzY0 > M15AP::Y0_N / 2u && nzOut > M15AP::AP_OUT_N / 2u) && ok;
    }

    const uint32_t f1 = runOnce(C.apWDev, 1u, 1u, 4096u, M15AP::AP_MODE_CONTRACT, true, true, true);
    if (f1 == 0xFFFFFFFFu) {
        return false;
    }
    const std::vector<uint8_t> outX1 = C.apOut;
    ok = H_Guard(C, f1 == 0u) && ok;
    ok = H_CmpMustDiffer(C, "Ap.wire.sens", outX0.data() + OUT_Q * 2u, outX1.data() + OUT_Q * 2u, QW * 2u) && ok;

    // ---- ② 确定性：同配置重跑，两块平面逐字节 ----
    const uint32_t fRep = runOnce(C.apWDev, 0u, 0u, 4096u, M15AP::AP_MODE_CONTRACT, true, false, true);
    if (fRep == 0xFFFFFFFFu) {
        return false;
    }
    {
        const uint32_t dY0 = H_ApCountDiff(C.apY0.data(), y0X0.data(), M15AP::Y0_N);
        const uint32_t dOut = H_ApCountDiff(C.apOut.data(), outX0.data(), M15AP::AP_OUT_N);
        printf("[m15]   Ap.wire.repeat      报告项  重跑与首次的不同元素：y0 %u/%u、out %u/%u\n", dY0, M15AP::Y0_N,
               dOut, M15AP::AP_OUT_N);
        ok = H_Guard(C, fRep == 0u && dY0 == 0u && dOut == 0u) && ok;
    }

    // ---- ③ pos 敏感性：pos=0 只比与 pos 无关的 y0 段，out 必须与 pos=4096 不同 ----
    const uint32_t fPos = runOnce(C.apWDev, 0u, 0u, 0u, M15AP::AP_MODE_CONTRACT, false, false, false);
    if (fPos == 0xFFFFFFFFu) {
        return false;
    }
    ok = H_Guard(C, fPos == 0u) && ok;
    ok = H_CmpMustDiffer(C, "Ap.wire.pos", outX0.data() + OUT_Q * 2u, C.apOut.data() + OUT_Q * 2u, QW * 2u) && ok;

    // ---- ④ 负向对照（规则**方向级**改错）：三档各必须至少一条判据 FAIL ----
    {
        const uint32_t modes[] = {AP_MODE_PLAIN_NORM, AP_MODE_ROPE_SIGN, AP_MODE_NO_ROPE};
        const char* nm[] = {"PLAIN_NORM", "ROPE_SIGN", "NO_ROPE"};
        uint32_t negOk = 0;
        for (uint32_t i = 0; i < 3u; ++i) {
            const uint32_t f = runOnce(C.apWDev, 0u, 0u, 4096u, modes[i], false, false, true);
            if (f == 0xFFFFFFFFu) {
                return false;
            }
            printf("[m15]   Ap.wire.neg mode=%u(%-10s)：被打破的判据 %u 条\n", modes[i], nm[i], f);
            if (f > 0u) {
                ++negOk;
            }
        }
        ok = H_Guard(C, negOk == 3u) && ok;
    }

    // ---- ⑤ 变异对照（**把被测对象弄坏**，M88 的两个档）----
    {
        const uint32_t muts[] = {AP_MODE_NO_COPY, AP_MODE_NO_GEMM};
        const char* mn[] = {"NO_COPY", "NO_GEMM"};
        for (uint32_t i = 0; i < 2u; ++i) {
            const uint32_t f = runOnce(C.apWDev, 0u, 0u, 4096u, muts[i], false, false, true);
            if (f == 0xFFFFFFFFu) {
                return false;
            }
            printf("[m15]   Ap.wire.mut mode=%u(%-8s)：被打破的判据 %u 条\n", muts[i], mn[i], f);
            ok = H_Guard(C, f > 0u) && ok;
        }
    }

    // ---- ⑥ **接线级**负向对照（打的是 W2-W6 那层接线本身）----
    //  (a) 实参错位：A 操作数喂 x1（launchRow=1）而判据按 x0（cmpIdx=0）;
    //  (b) 把接线关掉：apW = nullptr ⇒ 融合 body 回退到占位直通，y0/out **从不被写**。
    //      这一档是「判据确实盯着接线后的那段」的直接证据：关掉接线就必须全红。
    {
        const uint32_t fMis = runOnce(C.apWDev, 1u, 0u, 4096u, M15AP::AP_MODE_CONTRACT, false, false, true);
        if (fMis == 0xFFFFFFFFu) {
            return false;
        }
        printf("[m15]   Ap.wire.miswire(a) 实参错位（喂 x1 / 按 x0 判）：被打破的判据 %u 条\n", fMis);
        ok = H_Guard(C, fMis > 0u) && ok;

        const uint32_t fOff = runOnce(nullptr, 0u, 0u, 4096u, M15AP::AP_MODE_CONTRACT, false, false, true);
        if (fOff == 0xFFFFFFFFu) {
            return false;
        }
        printf("[m15]   Ap.wire.miswire(b) 接线关掉（apW=nullptr）：被打破的判据 %u 条\n", fOff);
        ok = H_Guard(C, fOff > 0u) && ok;
    }

    C.phaseAttnWire = C.checks - checkBase;
    printf("[m15] 验证 AttnWire：本段判定项 %u 条 + guard %u 条（累计 checks %u / guards %u / fails %u）\n",
           C.phaseAttnWire, C.guards - guardBase, C.checks, C.guards, C.fails);
    printf("[m15]   覆盖交代：本段只覆盖**相位 A 的 attention 前端**在融合 kernel 里的接线；不覆盖"
           "打分/topk/expand、attention 核心、`o_proj`、层 4..11 的铺设（见 evidence/attn_wire/README.md）。\n");
    return ok;
}


// ============================================================
// 5. 验证 A：层间组合正确性（循环中的第 L 层 == 单层直接调用）
// ============================================================

static bool H_RunA(Ctx& C)
{
    using namespace M15G;
    const uint32_t n = C.O.nLayers;
    printf("\n[m15] ===== 验证 A：层间组合正确性（%u 层循环 vs 单层直接调用，逐字节）=====\n", C.O.nLayers);
    H_ResetStates(C);
    H_ResetH(C, 0u);

    std::vector<uint8_t> wsLoop(WS_BYTES);
    std::vector<uint8_t> wsDirect(WS_BYTES);
    std::vector<uint8_t> hIn(M15Loop::H_BYTES);
    std::vector<uint8_t> hOut(M15Loop::H_BYTES);
    std::vector<uint8_t> tmp(M15Loop::H_BYTES);
    std::vector<uint8_t> yDirect(M15Loop::H_BYTES);
    std::vector<uint16_t> csBefore(M15Loop::CS_BYTES / 2);
    std::vector<uint16_t> csLoop(M15Loop::CS_BYTES / 2);
    std::vector<uint16_t> csDirect(M15Loop::CS_BYTES / 2);
    std::vector<float> ssmBefore(M15Loop::SSM_BYTES / 4);
    std::vector<float> ssmLoop(M15Loop::SSM_BYTES / 4);
    std::vector<float> ssmDirect(M15Loop::SSM_BYTES / 4);

    bool ok = true;

    __builtin_memcpy(hIn.data(), C.h0[0].data(), M15Loop::H_BYTES);   // 第 0 层输入 = 循环入口
    for (uint32_t L = 0; L < n; ++L) {
        const bool isGdn = (M15Loop::KindOf(L) == M15Loop::KIND_GDN);
        void* xBuf = H_H(C, L);
        void* yBuf = H_H(C, L + 1);

        // ---- 残差流交接检查：本层输入 == 上一层输出（逐字节）----
        H_D2H(C, tmp.data(), xBuf, M15Loop::H_BYTES, "h_in");
        {
            char tag[64];
            snprintf(tag, sizeof(tag), "A.handoff.L%02u", L);
            ok &= H_CmpBytes(C, tag, tmp.data(), hIn.data(), M15Loop::H_BYTES);
        }

        // ---- 循环中的第 L 层 ----
        if (isGdn) {
            H_D2H(C, csBefore.data(), H_ST(C, L, 0), M15Loop::CS_BYTES, "cs_before");
            H_D2H(C, ssmBefore.data(), H_ST(C, L, M15Loop::SSM_OFF), M15Loop::SSM_BYTES, "ssm_before");
        }
        H_Launch(C, L, C.wsDev, xBuf, yBuf, isGdn ? H_ST(C, L, 0) : nullptr,
                 isGdn ? H_ST(C, L, M15Loop::SSM_OFF) : nullptr);
        if (!H_Sync(C, "loop layer")) {
            return false;
        }
        H_D2H(C, hOut.data(), yBuf, M15Loop::H_BYTES, "h_out");
        if (isGdn) {
            H_D2H(C, wsLoop.data(), C.wsDev, WS_BYTES, "ws_loop");
            H_D2H(C, csLoop.data(), H_ST(C, L, 0), M15Loop::CS_BYTES, "cs_loop");
            H_D2H(C, ssmLoop.data(), H_ST(C, L, M15Loop::SSM_OFF), M15Loop::SSM_BYTES, "ssm_loop");
        }

        // ---- 同一输入、同一状态的「单层直接调用」----
        H_H2D(C, C.xDirectDev, hIn.data(), M15Loop::H_BYTES, "x_direct");
        if (isGdn) {
            H_H2D(C, C.csDirectDev, csBefore.data(), M15Loop::CS_BYTES, "cs_direct");
            H_H2D(C, C.ssmDirectDev, ssmBefore.data(), M15Loop::SSM_BYTES, "ssm_direct");
        }
        H_Launch(C, L, C.wsDirectDev, C.xDirectDev, C.yDirectDev, C.csDirectDev, C.ssmDirectDev);
        if (!H_Sync(C, "direct layer")) {
            return false;
        }
        H_D2H(C, yDirect.data(), C.yDirectDev, M15Loop::H_BYTES, "y_direct");
        {
            char tag[64];
            snprintf(tag, sizeof(tag), "A.direct_y.L%02u", L);
            ok &= H_CmpBytes(C, tag, yDirect.data(), hOut.data(), M15Loop::H_BYTES);
        }
        if (isGdn) {
            char tag[64];
            H_D2H(C, wsDirect.data(), C.wsDirectDev, WS_BYTES, "ws_direct");
            // 逐字节，但**排除 g/β 的 [h][1..7] padding 车道**——与验证 M1 的 M.gdnws 同一处置
            // （理由见 README §5.2：该 7 个 float 由 UB 残留内容决定、消费方按 stride-8 契约只读
            // 槽位首元素；la[0] 仍在比较范围内）。不加这一条时本判据会**跨运行抖动**：
            // 实测 2026-09-26 的一次 runs=all 里 L00 差 701 B、L14 差 2077 B，全部落在 padding 内，
            // 并连带把 Ver C 的 no-sync 复核截断（H_RunCPath 返回 C.fails == 0）。
            snprintf(tag, sizeof(tag), "A.direct_ws.L%02u", L);
            size_t gbPadA = 0;
            static std::vector<SkipRange> gbSkipA;
            if (gbSkipA.empty()) {
                H_GbPaddingRanges(gbSkipA);
            }
            ok &= H_CmpBytesSkipping(C, tag, wsDirect.data(), wsLoop.data(), WS_BYTES, gbSkipA, &gbPadA);
            C.gbPadDiffBytes += gbPadA;
            C.gbPadDiffMax = (gbPadA > C.gbPadDiffMax) ? static_cast<uint32_t>(gbPadA) : C.gbPadDiffMax;
            H_D2H(C, csDirect.data(), C.csDirectDev, M15Loop::CS_BYTES, "cs_direct_out");
            snprintf(tag, sizeof(tag), "A.direct_cs.L%02u", L);
            ok &= H_CmpBytes(C, tag, csDirect.data(), csLoop.data(), M15Loop::CS_BYTES);
            H_D2H(C, ssmDirect.data(), C.ssmDirectDev, M15Loop::SSM_BYTES, "ssm_direct_out");
            snprintf(tag, sizeof(tag), "A.direct_ssm.L%02u", L);
            ok &= H_CmpBytes(C, tag, ssmDirect.data(), ssmLoop.data(), M15Loop::SSM_BYTES);
        } else {
            // 占位直通层：层输出必须逐字节等于层输入
            char tag[64];
            snprintf(tag, sizeof(tag), "A.attn_passthru.L%02u", L);
            ok &= H_CmpBytes(C, tag, hOut.data(), hIn.data(), M15Loop::H_BYTES);
        }

        // ---- dump（供 check_ref.py：h 轨迹全量；GDN 层另落关键中间张量行 0）----
        if (C.O.dump) {
            char nm[96];
            snprintf(nm, sizeof(nm), "L%02u_hin", L);
            H_Dump(C, nm, hIn.data(), M15Loop::H_BYTES, "BF16", "1x2560", "role=layer_input");
            snprintf(nm, sizeof(nm), "L%02u_hout", L);
            H_Dump(C, nm, hOut.data(), M15Loop::H_BYTES, "BF16", "1x2560",
                   isGdn ? "role=layer_output" : "role=attn_passthru");
            if (isGdn) {
                snprintf(nm, sizeof(nm), "L%02u_qkvzba", L);
                H_DumpWsRow(C, nm, wsLoop, WS_QKVZBA, static_cast<uint32_t>(IN_N) * 2, "BF16", "1x16480");
                snprintf(nm, sizeof(nm), "L%02u_xnorm", L);
                H_DumpWsRow(C, nm, wsLoop, WS_XNORM, static_cast<uint32_t>(HIDDEN) * 2, "BF16", "1x2560");
                snprintf(nm, sizeof(nm), "L%02u_opin", L);
                H_DumpWsRow(C, nm, wsLoop, WS_OPIN, static_cast<uint32_t>(V_DIM) * 2, "BF16", "1x6144");
                snprintf(nm, sizeof(nm), "L%02u_opout", L);
                H_DumpWsRow(C, nm, wsLoop, WS_OPOUT, static_cast<uint32_t>(HIDDEN) * 2, "BF16", "1x2560");
                snprintf(nm, sizeof(nm), "L%02u_res1", L);
                H_DumpWsRow(C, nm, wsLoop, WS_RES1, static_cast<uint32_t>(HIDDEN) * 4, "F32", "1x2560");
                snprintf(nm, sizeof(nm), "L%02u_res2", L);
                H_DumpWsRow(C, nm, wsLoop, WS_RES2, static_cast<uint32_t>(HIDDEN) * 4, "F32", "1x2560");
                snprintf(nm, sizeof(nm), "L%02u_cs", L);
                H_Dump(C, nm, csLoop.data(), M15Loop::CS_BYTES, "BF16", "3x10240", "role=conv_state_after");
                if (H_InList(C.O.ssmDumpLayers, L)) {
                    snprintf(nm, sizeof(nm), "L%02u_ssm", L);
                    H_Dump(C, nm, ssmLoop.data(), M15Loop::SSM_BYTES, "F32", "48x128x128",
                           "role=ssm_state_after");
                }
            }
        }

        __builtin_memcpy(hIn.data(), hOut.data(), M15Loop::H_BYTES);
    }
    C.phaseA = C.checks - C.phaseW - C.phaseWh;
    printf("[m15] 验证 A：%u 层逐字节比对结束，本段判定项 %u 条（累计 %u），FAIL %u 条\n", n, C.phaseA, C.checks,
           C.fails);
    return ok;
}

}  // namespace M15Run
// ============================================================
namespace M15Run {

// 6. 验证 B：多 token / 状态连续性（device state 演化 vs host 参考）
// ============================================================

static bool H_RunB(Ctx& C)
{
    using namespace M15G;
    const uint32_t n = C.O.nLayers;
    const uint32_t steps = C.O.steps;
    printf("\n[m15] ===== 验证 B：多 token 状态连续性（%u token × %u 层；conv_state 位级 / ssm_state "
           "1e-5 相对）=====\n",
           steps, n);
    H_ResetStates(C);

    std::vector<uint8_t> ws(WS_BYTES);
    std::vector<uint8_t> hIn(M15Loop::H_BYTES);
    std::vector<uint8_t> hOut(M15Loop::H_BYTES);
    std::vector<uint8_t> qkv(static_cast<size_t>(IN_N) * 2);
    std::vector<uint16_t> cs(M15Loop::CS_BYTES / 2);
    std::vector<float> ssm(M15Loop::SSM_BYTES / 4);
    std::vector<std::vector<uint16_t>> csPrev(NL, std::vector<uint16_t>(M15Loop::CS_BYTES / 2));
    std::vector<uint16_t> csFirst(M15Loop::CS_BYTES / 2);
    std::vector<float> ssmFirst(M15Loop::SSM_BYTES / 4);
    std::vector<uint8_t> havePrev(NL, 0);
    std::vector<uint8_t> haveFirst(NL, 0);

    bool ok = true;
    uint32_t evolvedCs = 0;
    uint32_t evolvedSsm = 0;
    uint32_t gdnLayers = 0;   // 本次层范围内的 GDN 层数（非空洞性的分母）
    for (uint32_t L = 0; L < n; ++L) {
        if (M15Loop::KindOf(L) == M15Loop::KIND_GDN) {
            ++gdnLayers;
        }
    }

    for (uint32_t t = 0; t < steps; ++t) {
        H_ResetH(C, t);
        __builtin_memcpy(hIn.data(), C.h0[t].data(), M15Loop::H_BYTES);
        for (uint32_t L = 0; L < n; ++L) {
            const bool isGdn = (M15Loop::KindOf(L) == M15Loop::KIND_GDN);
            void* xBuf = H_H(C, L);
            void* yBuf = H_H(C, L + 1);
            H_Launch(C, L, C.wsDev, xBuf, yBuf, isGdn ? H_ST(C, L, 0) : nullptr,
                     isGdn ? H_ST(C, L, M15Loop::SSM_OFF) : nullptr);
            if (!H_Sync(C, "B layer")) {
                return false;
            }
            H_D2H(C, hOut.data(), yBuf, M15Loop::H_BYTES, "B h_out");

            char tag[80];
            if (!isGdn) {
                snprintf(tag, sizeof(tag), "B.t%u.attn_passthru.L%02u", t, L);
                ok &= H_CmpBytes(C, tag, hOut.data(), hIn.data(), M15Loop::H_BYTES);
            } else {
                // 设备字节：qkvzba 行 0（S3 的输入 / conv_state 新行）+ conv_state + ssm_state
                H_D2H(C, qkv.data(), reinterpret_cast<const uint8_t*>(C.wsDev) + WS_QKVZBA, qkv.size(), "B qkv");
                H_D2H(C, cs.data(), H_ST(C, L, 0), M15Loop::CS_BYTES, "B cs");
                H_D2H(C, ssm.data(), H_ST(C, L, M15Loop::SSM_OFF), M15Loop::SSM_BYTES, "B ssm");

                // ---- host 参考：以设备 qkvzba 为锚点推进该层的 conv/ssm 状态（状态自携带）----
                H_Ref& R = C.R[M15Loop::LayerSlot(L)];
                ok &= H_Guard(C, H_RefLayerStateStep(C.W[L], R, reinterpret_cast<const uint16_t*>(qkv.data())));
                C.guardsRef += 1u;   // review r1 P2-1b：guard 按来源分类计数
                snprintf(tag, sizeof(tag), "B.cs.L%02u.t%u", L, t);
                ok &= H_CmpOk(C, H_CmpU16Bit(tag, cs.data(), R.cs.data(), cs.size()));
                snprintf(tag, sizeof(tag), "B.ssm.L%02u.t%u", L, t);
                ok &= H_CmpOk(C, H_CmpF32Rel(tag, ssm.data(), R.ssm.data(), ssm.size()));
                snprintf(tag, sizeof(tag), "B.ssm_ulp.L%02u.t%u", L, t);
                H_UlpReport(tag, ssm.data(), R.ssm.data(), ssm.size());

                // ---- 跨 token 连续性（device 侧自洽，不依赖参考）----
                //   ① conv_state 移位自洽：new[0]=old[1]、new[1]=old[2]、new[2]=qkvzba[q|k|v]
                snprintf(tag, sizeof(tag), "B.cs_shift.L%02u.t%u", L, t);
                if (havePrev[L] != 0) {
                    ok &= H_CmpBytes(C, tag, cs.data(), csPrev[L].data() + CH, static_cast<size_t>(CH) * 2);
                    snprintf(tag, sizeof(tag), "B.cs_shift2.L%02u.t%u", L, t);
                    ok &= H_CmpBytes(C, tag, cs.data() + CH, csPrev[L].data() + 2u * CH,
                                     static_cast<size_t>(CH) * 2);
                }
                snprintf(tag, sizeof(tag), "B.cs_cur.L%02u.t%u", L, t);
                ok &= H_CmpBytes(C, tag, cs.data() + 2u * CH, qkv.data(), static_cast<size_t>(CH) * 2);

                //   ② 非空洞性：状态确实跨 token 在演化（与首个 token 的状态有差异）
                if (haveFirst[L] == 0) {
                    csFirst.assign(cs.begin(), cs.end());
                    ssmFirst.assign(ssm.begin(), ssm.end());
                    haveFirst[L] = 1;
                } else if (t + 1 == steps) {
                    // 只在该层跑完最后一个 token 时判一次（每层一条判据，1 次/层）
                    if (__builtin_memcmp(cs.data(), csFirst.data(), M15Loop::CS_BYTES) != 0) {
                        ++evolvedCs;
                    }
                    if (__builtin_memcmp(ssm.data(), ssmFirst.data(), M15Loop::SSM_BYTES) != 0) {
                        ++evolvedSsm;
                    }
                }
                csPrev[L].assign(cs.begin(), cs.end());
                havePrev[L] = 1;

                if (C.O.dump) {
                    char nm[96];
                    snprintf(nm, sizeof(nm), "B_t%u_L%02u_qkvzba", t, L);
                    H_Dump(C, nm, qkv.data(), qkv.size(), "BF16", "1x16480", "row=0");
                    snprintf(nm, sizeof(nm), "B_t%u_L%02u_cs", t, L);
                    H_Dump(C, nm, cs.data(), M15Loop::CS_BYTES, "BF16", "3x10240", "role=conv_state_after");
                    if (H_InList(C.O.ssmDumpLayers, L)) {
                        snprintf(nm, sizeof(nm), "B_t%u_L%02u_ssm", t, L);
                        H_Dump(C, nm, ssm.data(), M15Loop::SSM_BYTES, "F32", "48x128x128",
                               "role=ssm_state_after");
                    }
                }
            }
            if (C.O.dump) {
                char nm[96];
                snprintf(nm, sizeof(nm), "B_t%u_L%02u_hin", t, L);
                H_Dump(C, nm, hIn.data(), M15Loop::H_BYTES, "BF16", "1x2560", "role=layer_input");
                snprintf(nm, sizeof(nm), "B_t%u_L%02u_hout", t, L);
                H_Dump(C, nm, hOut.data(), M15Loop::H_BYTES, "BF16", "1x2560", "role=layer_output");
            }
            __builtin_memcpy(hIn.data(), hOut.data(), M15Loop::H_BYTES);
        }
    }
    printf("[m15] 验证 B：%u 层 × %u token；非空洞性：cs 演化 %u/%u，ssm 演化 %u/%u（应 = 层数）\n", n, steps,
           evolvedCs, gdnLayers, evolvedSsm, gdnLayers);
    for (int kind = 0; kind < 2; ++kind) {
        const uint32_t got = (kind == 0) ? evolvedCs : evolvedSsm;
        const char* tag = (kind == 0) ? "B.cs_evolved" : "B.ssm_evolved";
        C.checks++;
        if (got != gdnLayers) {
            printf("[m15]   %-34s FAIL (%u/%u 层状态未随 token 演化 → 该段判据空洞)\n", tag, got, gdnLayers);
            C.fails++;
            ok = false;
        } else {
            printf("[m15]   %-34s PASS (所有 %u 个 GDN 层的%s都随 token 变化)\n", tag, gdnLayers,
                   (kind == 0) ? " conv_state " : " ssm_state ");
        }
    }
    C.phaseB = C.checks - (C.phaseA + C.phaseW + C.phaseWh);
    return ok;
}

// ============================================================
// 7. 验证 C：开销基线（48 次启动的 host 下发 vs 设备执行）
// ============================================================

static double H_Median(std::vector<double> v)
{
    if (v.empty()) {
        return 0.0;
    }
    std::sort(v.begin(), v.end());
    const size_t m = v.size() / 2;
    return (v.size() % 2 == 1) ? v[m] : 0.5 * (v[m - 1] + v[m]);
}

// 三组数据比较用的聚合判据：一条判据覆盖多个张量，失败时打印前几个不符者（口径见 README §3.3）
struct Blob {
    std::string name;
    const uint8_t* a;
    const uint8_t* b;
    size_t bytes;
};

static bool H_CmpBlobSet(Ctx& C, const char* tag, const std::vector<Blob>& blobs)
{
    C.checks++;
    size_t bad = 0;
    std::string firstBad;
    for (const Blob& bl : blobs) {
        if (__builtin_memcmp(bl.a, bl.b, bl.bytes) != 0) {
            if (bad == 0) {
                size_t off = 0;
                while (off < bl.bytes && bl.a[off] == bl.b[off]) {
                    ++off;
                }
                firstBad = bl.name + " (first off " + std::to_string(off) + ")";
            }
            ++bad;
        }
    }
    if (bad == 0) {
        printf("[m15]   %-34s PASS (%zu 个张量逐字节一致)\n", tag, blobs.size());
        return true;
    }
    printf("[m15]   %-34s FAIL (%zu/%zu 个张量不同; 首个 %s)\n", tag, bad, blobs.size(), firstBad.c_str());
    C.fails++;
    return false;
}

// 跑一条完整 48 层 pass 并回读末层 h 与全部 GDN 层 state
static bool H_RunCPath(Ctx& C, bool perLayerSync, std::vector<uint8_t>& hLast, std::vector<uint16_t>& csAll,
                       std::vector<float>& ssmAll)
{
    using namespace M15G;
    H_ResetStates(C);
    H_ResetH(C, 0u);
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        const bool isGdn = (M15Loop::KindOf(L) == M15Loop::KIND_GDN);
        H_Launch(C, L, C.wsDev, H_H(C, L), H_H(C, L + 1), isGdn ? H_ST(C, L, 0) : nullptr,
                 isGdn ? H_ST(C, L, M15Loop::SSM_OFF) : nullptr);
        if (perLayerSync && !H_Sync(C, "C.psync layer")) {
            return false;
        }
    }
    if (!perLayerSync && !H_Sync(C, "C.nosync tail")) {
        return false;
    }
    hLast.resize(M15Loop::H_BYTES);
    H_D2H(C, hLast.data(), H_H(C, C.O.nLayers), M15Loop::H_BYTES, "C h_last");
    csAll.resize(static_cast<size_t>(M15Loop::N_GDN) * M15Loop::CS_BYTES / 2);
    ssmAll.resize(static_cast<size_t>(M15Loop::N_GDN) * M15Loop::SSM_BYTES / 4);
    uint32_t k = 0;
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        if (M15Loop::KindOf(L) != M15Loop::KIND_GDN) {
            continue;
        }
        H_D2H(C, csAll.data() + static_cast<size_t>(k) * M15Loop::CS_BYTES / 2, H_ST(C, L, 0), M15Loop::CS_BYTES,
              "C cs");
        H_D2H(C, ssmAll.data() + static_cast<size_t>(k) * M15Loop::SSM_BYTES / 4, H_ST(C, L, M15Loop::SSM_OFF),
              M15Loop::SSM_BYTES, "C ssm");
        ++k;
    }
    return C.fails == 0;
}

static bool H_RunCNoSyncCheck(Ctx& C)
{
    using namespace M15G;
    printf("[m15]   ---- 生产形态数据复核（无中间 sync 的 48 次连发）----\n");
    std::vector<uint8_t> h1, h2, h3;
    std::vector<uint16_t> cs1, cs2, cs3;
    std::vector<float> ssm1, ssm2, ssm3;
    if (!H_RunCPath(C, true, h1, cs1, ssm1)) {      // P1：逐层 sync（= Ver A/B 的验证配置）
        return false;
    }
    if (!H_RunCPath(C, false, h2, cs2, ssm2)) {     // P2：无 sync 连发（= 交付配置）
        return false;
    }
    if (!H_RunCPath(C, false, h3, cs3, ssm3)) {     // P3：无 sync 连发再跑（竞态检测）
        return false;
    }
    auto blobs = [&](const std::vector<uint8_t>& ha, const std::vector<uint16_t>& csa,
                     const std::vector<float>& ssma, const std::vector<uint8_t>& hb,
                     const std::vector<uint16_t>& csb, const std::vector<float>& ssmb) {
        std::vector<Blob> v;
        v.push_back({"h_last", ha.data(), hb.data(), ha.size()});
        uint32_t k = 0;
        for (uint32_t L = 0; L < C.O.nLayers; ++L) {
            if (M15Loop::KindOf(L) != M15Loop::KIND_GDN) {
                continue;
            }
            const size_t co = static_cast<size_t>(k) * M15Loop::CS_BYTES / 2;
            const size_t so = static_cast<size_t>(k) * M15Loop::SSM_BYTES / 4;
            v.push_back({"cs.L" + std::to_string(L), reinterpret_cast<const uint8_t*>(csa.data() + co),
                         reinterpret_cast<const uint8_t*>(csb.data() + co), M15Loop::CS_BYTES});
            v.push_back({"ssm.L" + std::to_string(L), reinterpret_cast<const uint8_t*>(ssma.data() + so),
                         reinterpret_cast<const uint8_t*>(ssmb.data() + so), M15Loop::SSM_BYTES});
            ++k;
        }
        return v;
    };
    bool ok = true;
    ok &= H_CmpBlobSet(C, "C.nosync_vs_sync(h/cs/ssm)", blobs(h1, cs1, ssm1, h2, cs2, ssm2));
    ok &= H_CmpBlobSet(C, "C.nosync_repeat(h/cs/ssm)", blobs(h2, cs2, ssm2, h3, cs3, ssm3));
    return ok;
}

static bool H_RunC(Ctx& C)
{
    const uint32_t n = C.O.nLayers;
    const uint32_t reps = C.O.reps;
    printf("\n[m15] ===== 验证 C：开销基线（%u 层 × %u 次重复；host 计时）=====\n", n, reps);

    std::vector<double> tOne;       // 单层「启动 + sync」往返
    std::vector<double> tIssue;     // n 次启动的 host 下发（不含 sync）
    std::vector<double> tStep;      // n 次启动 + 尾部一次 sync
    std::vector<double> tSyncEach;  // n 次启动、每次启动后 sync

    for (uint32_t r = 0; r < reps; ++r) {
        // (1) 单层直接调用（第 0 层）往返
        {
            const double d0 = H_NowMs();
            H_Launch(C, 0u, C.wsDirectDev, C.xDirectDev, C.yDirectDev, C.csDirectDev, C.ssmDirectDev);
            H_Sync(C, "C single");
            tOne.push_back(H_NowMs() - d0);
        }
        // (2) n 层循环：host 下发（不 sync）→ 下发完计时，再尾部 sync
        {
            const double d0 = H_NowMs();
            for (uint32_t L = 0; L < n; ++L) {
                const bool isGdn = (M15Loop::KindOf(L) == M15Loop::KIND_GDN);
                H_Launch(C, L, C.wsDev, H_H(C, L), H_H(C, L + 1), isGdn ? H_ST(C, L, 0) : nullptr,
                         isGdn ? H_ST(C, L, M15Loop::SSM_OFF) : nullptr);
            }
            const double d1 = H_NowMs();
            tIssue.push_back(d1 - d0);
            H_Sync(C, "C step tail");
            tStep.push_back(H_NowMs() - d0);
        }
        // (3) 逐层 sync（同步粒度对总时长的影响）
        {
            const double d0 = H_NowMs();
            for (uint32_t L = 0; L < n; ++L) {
                const bool isGdn = (M15Loop::KindOf(L) == M15Loop::KIND_GDN);
                H_Launch(C, L, C.wsDev, H_H(C, L), H_H(C, L + 1), isGdn ? H_ST(C, L, 0) : nullptr,
                         isGdn ? H_ST(C, L, M15Loop::SSM_OFF) : nullptr);
                if (!H_Sync(C, "C per-layer")) {
                    return false;
                }
            }
            tSyncEach.push_back(H_NowMs() - d0);
        }
    }

    const double oneMs = H_Median(tOne);
    const double issueMs = H_Median(tIssue);
    const double stepMs = H_Median(tStep);
    const double eachMs = H_Median(tSyncEach);
    const double perLaunchUs = issueMs * 1000.0 / static_cast<double>(n);
    const double devEstMs = stepMs - issueMs;

    printf("[m15]   单层「启动+sync」往返          中位 %.3f ms\n", oneMs);
    printf("[m15]   %u 次启动 host 下发（无 sync） 中位 %.3f ms → 每次启动 %.2f us\n", n, issueMs, perLaunchUs);
    printf("[m15]   %u 层 step（下发 + 尾部 sync） 中位 %.3f ms\n", n, stepMs);
    // 逐层 sync 与「只 sync 一次」的差 = (n−1) 次额外同步的代价（step 档已含 1 次尾部 sync）
    const double extraPerSyncUs = ((eachMs - stepMs) > 0.0 && n > 1)
                                      ? (eachMs - stepMs) * 1000.0 / static_cast<double>(n - 1)
                                      : 0.0;
    printf("[m15]   %u 次「逐层 sync」            中位 %.3f ms → 相对 step 多花 %.3f ms（≈ 每次额外 sync %.2f us）\n",
           n, eachMs, eachMs - stepMs, extraPerSyncUs);
    printf("[m15]   设备执行估计（step − 下发）    %.3f ms（准确值见 msprof，parse_msprof.py 汇总）\n",
           devEstMs);
    printf("[m15]   host 下发占 step wall 的        %.2f%%\n", 100.0 * issueMs / stepMs);
    printf("[m15]   （aclgraph 上限收益 ~ 该占比；跨层预取的收益不在此列）\n");
    C.checks++;
    if (issueMs <= 0.0 || stepMs <= 0.0) {
        printf("[m15]   C.timing                   FAIL (计时异常)\n");
        C.fails++;
        return false;
    }
    printf("[m15]   C.timing                   PASS\n");

    // ---- 数据面复核（review P2-2）：把「层间无需 CrossCore」从计时前提变成实测结论 ----
    // Ver A/B 每层后都插了 host sync（验证配置），只有本档按**生产形态**（48 次连发、无中间
    // sync）跑；三条路同输入同初值：P1 逐层 sync（参考）、P2 无 sync 连发、P3 无 sync 再跑一次
    // （竞态检测）。比较末层 h 与全部 GDN 层 conv_state/ssm_state —— 逐字节。
    if (!H_RunCNoSyncCheck(C)) {
        return false;
    }
    C.phaseC = C.checks - (C.phaseA + C.phaseW + C.phaseWh + C.phaseB);
    return true;
}

// ============================================================
// 8. 参数 dump（权重小件 + state 初值 + 每 token 的层输入）
// ============================================================

static void H_DumpParams(Ctx& C)
{
    if (!C.O.dump) {
        return;
    }
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        if (M15Loop::KindOf(L) != M15Loop::KIND_GDN) {
            continue;
        }
        const M15LayerW& W = C.W[L];
        char nm[96];
        snprintf(nm, sizeof(nm), "W_L%02u_convw", L);
        H_Dump(C, nm, W.convW.data(), W.convW.size() * 2, "BF16", "4x10240");
        snprintf(nm, sizeof(nm), "W_L%02u_convb", L);
        H_Dump(C, nm, W.convBias.data(), W.convBias.size() * 2, "BF16", "10240");
        snprintf(nm, sizeof(nm), "W_L%02u_alog", L);
        H_Dump(C, nm, W.aLog.data(), W.aLog.size() * 4, "F32", "64");
        snprintf(nm, sizeof(nm), "W_L%02u_dtb", L);
        H_Dump(C, nm, W.dtBias.data(), W.dtBias.size() * 4, "F32", "64");
        snprintf(nm, sizeof(nm), "W_L%02u_g1", L);
        H_Dump(C, nm, W.gamma1.data(), W.gamma1.size() * 2, "BF16", "2560");
        snprintf(nm, sizeof(nm), "W_L%02u_g2", L);
        H_Dump(C, nm, W.gamma2.data(), W.gamma2.size() * 2, "BF16", "2560");
        snprintf(nm, sizeof(nm), "W_L%02u_gg", L);
        H_Dump(C, nm, W.gammaG.data(), W.gammaG.size() * 2, "BF16", "128");
    }
    H_Dump(C, "state_cs_init", C.csInit.data(), M15Loop::CS_BYTES, "BF16", "3x10240");
    H_Dump(C, "state_ssm_init", C.ssmInit.data(), M15Loop::SSM_BYTES, "F32", "48x128x128");
    for (uint32_t t = 0; t < C.O.steps; ++t) {
        char nm[64];
        snprintf(nm, sizeof(nm), "h0_t%u", t);
        H_Dump(C, nm, C.h0[t].data(), M15Loop::H_BYTES, "BF16", "1x2560", "row=0");
    }
}

}  // namespace M15Run
// ============================================================
// 9. 资源分配 / 权重装载 / 主流程
// ============================================================

namespace M15Run {

// ---- M136（Wave D）：prefill GDN 段体的几何（host 侧与 m23 的 dump/参考契约同一口径）----
// q/k 每 head 行数 = m + PF_GDN_QK_PAD_ROWS（= Tp，与 `m23_gdn_prefill/check_ref.py` 的 `Tp=T+64` 一致）；
// g/beta 每 head 行数 = align8(m)（= tp，设备侧行距）。NK = value 头数 / 3。
struct PfGdnGeom {
    uint32_t m = 0;
    uint32_t nk = 0;
    uint32_t h = 0;
    uint32_t Tp = 0;
    uint32_t tp = 0;
};
static PfGdnGeom H_PfGdnGeom(uint32_t m)
{
    PfGdnGeom g;
    g.m = m;
    g.nk = M15G::HEADS / 3u;
    g.h = M15G::HEADS;
    g.Tp = m + M15L::PF_GDN_QK_PAD_ROWS;
    g.tp = (m + 7u) / 8u * 8u;
    return g;
}

// `M15_PREFILL_WIRE=1` 时分配 prefill 段体平面（全部按 M_PREFILL 定尺；decode 路径零占用）。
// B4 的 ws 用 `WS_MOE_OFF + PWS_BYTES`（decode 的 `WS_MOE_BYTES` 装不下 prefill 的 `PWS_BYTES`，
// 见 `m15_layer_kernel.h` 里 `mp.ws` 的宿主契约注释）。
static bool H_PfSegAlloc(Ctx& C)
{
    if (C.O.pfWire == 0u) {
        return true;
    }
    const uint32_t mMax = M15Loop::M_PREFILL;
    const PfGdnGeom g = H_PfGdnGeom(mMax);
    const size_t qkB = static_cast<size_t>(g.nk) * g.Tp * 128u * 4u;
    const size_t vB = static_cast<size_t>(g.h) * mMax * 128u * 4u;
    const size_t gbB = static_cast<size_t>(g.h) * g.tp * 4u;
    const size_t hB = static_cast<size_t>(g.h) * 128u * 128u * 4u;
    const size_t scB = static_cast<size_t>(C.numBlocks) * M15G::GP_SLOT_BYTES;
    const size_t moeWsB = static_cast<size_t>(M15L::WS_MOE_OFF) + M15PFR::PWS_BYTES;
    const size_t rwB = static_cast<size_t>(M15PFR::E_PAD) * M15PFR::HIDDEN * 2u;
    const size_t arenaB = static_cast<size_t>(M15H::HcPF::ArenaBytes(mMax));
    const size_t blkB = static_cast<size_t>(mMax) * M15H::HID * 2u;
    const size_t ijB = (static_cast<size_t>(mMax) + M15H::M_MAX) * M15H::IJ_STRIDE * 2u;
    // M140 复审 r1（相位 B 归因的 in-scope 候选）：MoE 的输入面按链的 `MT = 64` 行分块读取 ⇒
    // `pfHcBlk1` 必须覆盖**整块**（最后一块也要能读到 `MT` 行）。相位 A 对 q/k 用的是同一类修法
    // （`PF_GDN_QK_PAD_ROWS`）。多出来的 pad 行由 host 在每次起 kernel 前置零（见 H_PfGdnWired）。
    const size_t blkTileRows = (static_cast<size_t>(mMax) + M15PFR::MT - 1u) / M15PFR::MT * M15PFR::MT;
    const size_t blk1B = blkTileRows * M15H::HID * 2u;
    // ---- M140：hc 四相位的激活平面（按 M_PREFILL 定尺）+ E=512 的 MoE 权重区 ----
    const size_t hcHB = static_cast<size_t>(mMax) * M15H::HYPER * 2u;
    const size_t hcBoB = static_cast<size_t>(mMax) * M15H::HID * 2u;
    const size_t hcIjB = (static_cast<size_t>(mMax) + M15H::M_MAX) * M15H::IJ_STRIDE * 2u;
    const size_t hcAttnOutB = static_cast<size_t>(mMax) * M15H::HID * 2u;
    // E=512 的 MoE 权重区：只在本 run 的层数上分配（`M15_LAYERS=1` ⇒ 1 槽 = 1.34 GB）。
    const size_t moe512B = static_cast<size_t>(C.O.nLayers) * M15L::MOE_W_PREFILL_STRIDE;
    // ---- M151：prefill prolog 的平面（S2 出 = S3 入；conv_state 常驻）----
    // 只在 `M15_PREFILL_PROLOG=1` 时分配（`pfQkvzbaDev` 非零即"开"）；否则零占用。
    const bool prologOn = (C.O.pfProlog != 0u);
    const size_t qkvzbaB = static_cast<size_t>(mMax) * M15G::IN_N * 2u;   // [M_PREFILL, 16480] bf16
    const size_t convStateB = static_cast<size_t>(M15Loop::CS_BYTES);    // [3, 10240] bf16 = 61,440 B
    // ---- M164：prefill epilog 的平面（转位后 token-major o、压实 z、S5 出 y）----
    // epilog 的 z 源是 prolog S2 的 `pfQkvzbaDev` ⇒ 只有 prolog 开时才可能挂 epilog。
    // `y`（S5 出 = S6 的 A 面）是 M159 §2.2 未列的第三个 GM 中间面：S5 与 S6 是两次独立 launch，
    // 该面必须有自己的生命周期（详见 evidence/m164_epilog_mount/CONTRACT.md §2）。
    const bool epilogOn = (C.O.pfEpilog != 0u) && prologOn;
    const size_t oTokB = static_cast<size_t>(mMax) * M15PE::PF_EPI_HIDDEN * 4u;   // [M_PREFILL,6144] fp32
    const size_t zTokB = static_cast<size_t>(mMax) * M15PE::PF_EPI_HIDDEN * 2u;   // [M_PREFILL,6144] bf16
    // ---- M197：attention 前端（B2）的 5 个 scratch + w/cs（只在 wire=1 且走 H_PfAttnWired 时用）----
    const size_t attnY0B = static_cast<size_t>(M15PF::PF_ROWS) * M15PF::PF_Y0_STRIDE * 2u;    // 3,571,712
    const size_t attnOutB = static_cast<size_t>(M15PF::PF_ROWS) * M15PF::PF_OUT_STRIDE * 2u;  // 3,571,712
    const size_t attnInB = static_cast<size_t>(M15AC::AC_IN_BYTES);                           // 299,264
    const size_t attnPooledB = static_cast<size_t>(M15AC::AC_POOLED_BYTES);                   // 8,192
    const size_t attnFlagB = static_cast<size_t>(M15AC::AC_FLAG_LANES) * 4u;                  // 32
    const size_t attnWB = static_cast<size_t>(M15AP::W_BYTES);                                // 71,435,776
    const size_t attnCsB = static_cast<size_t>(M15AP::AP_CS_BYTES);                           // 524,416
    struct Item {
        void** p;
        size_t bytes;
        const char* tag;
    };
    const Item items[] = {
        {&C.pfGdnQDev, qkB, "pf_gdn_q"},          {&C.pfGdnKDev, qkB, "pf_gdn_k"},
        {&C.pfGdnVDev, vB, "pf_gdn_v"},           {&C.pfGdnGDev, gbB, "pf_gdn_g"},
        {&C.pfGdnBetaDev, gbB, "pf_gdn_beta"},    {&C.pfGdnODev, vB, "pf_gdn_o"},
        {&C.pfGdnStateDev, hB, "pf_gdn_state"},   {&C.pfGdnScratchDev, scB, "pf_gdn_scratch"},
        {&C.pfMoeWsDev, moeWsB, "pf_moe_ws"},     {&C.pfMoeRouterWPadDev, rwB, "pf_moe_router_wpad"},
        {&C.pfHcArena0Dev, arenaB, "pf_hc_arena0"}, {&C.pfHcArena1Dev, arenaB, "pf_hc_arena1"},
        {&C.pfHcBlk0Dev, blkB, "pf_hc_blk0"},     {&C.pfHcBlk1Dev, blk1B, "pf_hc_blk1"},
        {&C.pfHcIj0Dev, ijB, "pf_hc_ij0"},
        {&C.pfHcHDev, hcHB, "pf_hc_h"},           {&C.pfHcBoDev, hcBoB, "pf_hc_bo"},
        {&C.pfHcIjDev, hcIjB, "pf_hc_ij"},        {&C.pfHcAttnOutDev, hcAttnOutB, "pf_hc_attnout"},
        {&C.pfMoeWPrefillDev, moe512B, "pf_moe_w512"},
        // M197：attention 前端（B2）的 5 个 scratch + 权重/cos-sin 平面
        {&C.pfattnY0Dev, attnY0B, "pf_attn_y0"},  {&C.pfattnOutDev, attnOutB, "pf_attn_out"},
        {&C.pfattnInDev, attnInB, "pf_attn_in"},  {&C.pfattnPooledDev, attnPooledB, "pf_attn_pooled"},
        {&C.pfattnFlagDev, attnFlagB, "pf_attn_flag"},
        {&C.pfattnWDev, attnWB, "pf_attn_w"},     {&C.pfattnCsDev, attnCsB, "pf_attn_cs"},
    };
    size_t total = 0;
    for (const Item& it : items) {
        total += it.bytes;
        if (aclrtMalloc(it.p, it.bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || *it.p == nullptr) {
            printf("[m15][FAIL] aclrtMalloc(%s, %zu B) failed\n", it.tag, it.bytes);
            return false;
        }
    }
    // M151：prolog 的两个平面（按需分配 ⇒ 不接 prolog 时零占用）。
    if (prologOn) {
        if (aclrtMalloc(&C.pfQkvzbaDev, qkvzbaB, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
            C.pfQkvzbaDev == nullptr) {
            printf("[m15][FAIL] aclrtMalloc(pf_qkvzba, %zu B) failed\n", qkvzbaB);
            return false;
        }
        if (aclrtMalloc(&C.pfConvStateDev, convStateB, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
            C.pfConvStateDev == nullptr) {
            printf("[m15][FAIL] aclrtMalloc(pf_conv_state, %zu B) failed\n", convStateB);
            return false;
        }
        total += qkvzbaB + convStateB;
    }
    // M164：epilog 的三个平面（按需分配 ⇒ 不挂 epilog 时零占用）。
    if (epilogOn) {
        if (aclrtMalloc(&C.pfOTokDev, oTokB, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || C.pfOTokDev == nullptr) {
            printf("[m15][FAIL] aclrtMalloc(pf_epilog_otok, %zu B) failed\n", oTokB);
            return false;
        }
        if (aclrtMalloc(&C.pfZTokDev, zTokB, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || C.pfZTokDev == nullptr) {
            printf("[m15][FAIL] aclrtMalloc(pf_epilog_ztok, %zu B) failed\n", zTokB);
            return false;
        }
        if (aclrtMalloc(&C.pfYTokDev, zTokB, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || C.pfYTokDev == nullptr) {
            printf("[m15][FAIL] aclrtMalloc(pf_epilog_ytok, %zu B) failed\n", zTokB);
            return false;
        }
        total += oTokB + zTokB + zTokB;
    }
    // MoE prefill ws / hc arena / blk：污染（未写区不得看起来是合法数据）；scratch / ij / 出口清零
    aclrtMemset(C.pfMoeWsDev, moeWsB, 0xCD, moeWsB);
    aclrtMemset(C.pfHcArena0Dev, arenaB, 0xCD, arenaB);
    aclrtMemset(C.pfHcArena1Dev, arenaB, 0xCD, arenaB);
    aclrtMemset(C.pfHcBlk0Dev, blkB, 0xCD, blkB);
    aclrtMemset(C.pfHcBlk1Dev, blkB, 0xCD, blkB);
    aclrtMemset(C.pfHcIj0Dev, ijB, 0, ijB);
    aclrtMemset(C.pfGdnScratchDev, scB, 0, scB);
    aclrtMemset(C.pfGdnODev, vB, 0, vB);
    // M140：hc 四相位的平面 —— hcH/hcBo/hcIj/attnOut 由宿主按相位掩码每档重填（这里先污染，
    // 让"未写区"不可能看起来像合法数据）；MoE E=512 权重区清零（后续 H_LoadMoeSlot512 填真权重）。
    aclrtMemset(C.pfHcHDev, hcHB, 0xCD, hcHB);
    aclrtMemset(C.pfHcBoDev, hcBoB, 0xCD, hcBoB);
    aclrtMemset(C.pfHcIjDev, hcIjB, 0xCD, hcIjB);
    aclrtMemset(C.pfHcAttnOutDev, hcAttnOutB, 0xCD, hcAttnOutB);
    aclrtMemset(C.pfMoeWPrefillDev, moe512B, 0, moe512B);
    if (prologOn) {
        aclrtMemset(C.pfQkvzbaDev, qkvzbaB, 0xCD, qkvzbaB);      // 未写区毒值
        aclrtMemset(C.pfConvStateDev, convStateB, 0, convStateB); // conv_state 起 0（随后 H2D 真初值）
    }
    // M164：epilog 的三个暂存面毒值 0xCD（未写区不得看起来像合法数据；[0,m) 行由 epilog 覆盖）。
    if (epilogOn) {
        aclrtMemset(C.pfOTokDev, oTokB, 0xCD, oTokB);
        aclrtMemset(C.pfZTokDev, zTokB, 0xCD, zTokB);
        aclrtMemset(C.pfYTokDev, zTokB, 0xCD, zTokB);
    }
    // M197：attention 前端（B2）的 5 个 scratch 初毒（0xCD）；每档 launch 前由 H_PfAttnWired 重毒。
    aclrtMemset(C.pfattnY0Dev, attnY0B, 0xCD, attnY0B);
    aclrtMemset(C.pfattnOutDev, attnOutB, 0xCD, attnOutB);
    aclrtMemset(C.pfattnInDev, attnInB, 0xCD, attnInB);
    aclrtMemset(C.pfattnPooledDev, attnPooledB, 0xCD, attnPooledB);
    aclrtMemset(C.pfattnFlagDev, attnFlagB, 0xCD, attnFlagB);
    printf("[m15] M197 attention 前端（B2）平面：y0 %zuB + out %zuB + in %zuB + pooled %zuB + flag %zuB"
           " + w %zuB + cs %zuB（%.1f MB）\n",
           attnY0B, attnOutB, attnInB, attnPooledB, attnFlagB, attnWB, attnCsB,
           static_cast<double>(attnY0B + attnOutB + attnInB + attnPooledB + attnFlagB + attnWB + attnCsB) / 1e6);
    printf("[m15] M136 prefill 段体平面：%.1f MB（q/k %zuB×2 + v/o %zuB×2 + g/β %zuB×2 + state %zuB"
           " + scratch %zuB + MoE ws %zuB + routerWPad %zuB + hc arena %zuB×2 + blk %zuB×2 + ij %zuB）\n",
           static_cast<double>(total) / 1e6, qkB, vB, gbB, hB, scB, moeWsB, rwB, arenaB, blkB, ijB);
    printf("[m15] M140 prefill 四相位平面：hcH %zuB + hcBo %zuB + hcIj %zuB + hcAttnOut %zuB + "
           "MoE(E=512) %zuB（%u 层 × %.2f MB）\n",
           hcHB, hcBoB, hcIjB, hcAttnOutB, moe512B, C.O.nLayers,
           static_cast<double>(M15L::MOE_W_PREFILL_STRIDE) / 1e6);
    if (epilogOn) {
        printf("[m15] M164 prefill epilog 平面：oTok %zuB + zTok %zuB + yTok %zuB（%.1f MB）\n", oTokB, zTokB,
               zTokB, static_cast<double>(oTokB + zTokB + zTokB) / 1e6);
    } else if (C.O.pfEpilog != 0u) {
        printf("[m15][WARN] M15_PREFILL_EPILOG=1 但 M15_PREFILL_PROLOG=0 ⇒ epilog 的 z 源（pfQkvzba）无生产者，"
               "本档不分配/不挂 epilog\n");
    }
    return true;
}

static bool H_Alloc(Ctx& C)
{
    using namespace M15G;
    struct Item {
        void** p;
        size_t bytes;
        const char* tag;
    };
    const size_t wTotal = static_cast<size_t>(M15Loop::N_GDN) * M15Loop::W_STRIDE;
    const size_t stTotal = static_cast<size_t>(M15Loop::N_GDN) * M15Loop::ST_STRIDE;
    const size_t moeWTotal = static_cast<size_t>(M15Loop::NL) * M15L::MOE_W_STRIDE;
    // M65 起：hc 权重区多一个槽（末层全局 mixer，`HC_W_SLOTS = 49`）、hc ws 多一块
    //（`HC_WS_SLOTS = 52`：48 层 + 3 块验证 H scratch + 1 块全局 mixer ws）
    const size_t hcWTotal = static_cast<size_t>(M15L::HC_W_SLOTS) * M15L::HC_LAYER_W_STRIDE;
    const size_t hcWsTotal = static_cast<size_t>(M15L::HC_WS_SLOTS) * M15L::HC_WS_LAYER_STRIDE;
    Item items[] = {
        {&C.wsDev, WS_BYTES, "ws"},
        {&C.wsDirectDev, WS_BYTES, "ws_direct"},
        {&C.wDev, wTotal, "weights"},
        {&C.stDev, stTotal, "states"},
        {&C.hDev[0], M15Loop::H_ROWS_BYTES, "h0"},
        {&C.hDev[1], M15Loop::H_ROWS_BYTES, "h1"},
        {&C.resZeroDev, M15Loop::H_ROWS_BYTES, "res_zero"},
        {&C.xDirectDev, M15Loop::H_ROWS_BYTES, "x_direct"},
        {&C.yDirectDev, M15Loop::H_ROWS_BYTES, "y_direct"},
        {&C.csDirectDev, M15Loop::CS_BYTES, "cs_direct"},
        {&C.ssmDirectDev, M15Loop::SSM_BYTES, "ssm_direct"},
        // ---- M40 融合形态 ----
        {&C.moeWDev, moeWTotal, "moe_weights"},
        {&C.wsFusedDev, M15L::WS_BYTES_TOTAL, "ws_fused"},
        {&C.wsGdnDev, M15L::WS_GDN_BYTES, "ws_gdn_ref"},
        {&C.wsMoeDev, M15L::WS_MOE_BYTES, "ws_moe_ref"},
        {&C.xFusedDev, M15Loop::H_ROWS_BYTES, "x_fused"},
        {&C.yFusedDev, M15Loop::H_ROWS_BYTES, "y_fused"},
        {&C.ySubDev, M15Loop::H_ROWS_BYTES, "y_sub"},
        {&C.xMoeDev, M15Loop::H_ROWS_BYTES, "x_moe"},
        {&C.yMoeDev, M15Loop::H_ROWS_BYTES, "y_moe"},
        // ---- M58 四相位 hc 形态 ----
        {&C.hcWDev, hcWTotal, "hc_weights"},
        {&C.hcWsDev, hcWsTotal, "hc_ws"},
        {&C.hcHDev, static_cast<size_t>(M15H::M_MAX) * M15H::HYPER * 2u, "hc_hin"},
        {&C.hcBoDev, M15Loop::H_ROWS_BYTES, "hc_bo"},
        {&C.hcIjDev, static_cast<size_t>(M15H::M_MAX) * M15H::IJ_STRIDE * 2u, "hc_ij"},
        {&C.hcAttnOutDev, M15Loop::H_ROWS_BYTES, "hc_attnout"},
        // ---- M65：层链的双缓冲 pending BO 平面 ----
        {&C.chainBoDev, static_cast<size_t>(CH_BO_PLANES) * M15Loop::H_ROWS_BYTES, "chain_bo"},
        // ---- M110：prefill 的契约与挂载点档（**按真实 m 定尺**：4097 行 × 2560 × 2 = 20,976,640 B/面）----
        {&C.pfXDev, M15Loop::H_ROWS_BYTES_PF, "pf_x"},
        {&C.pfYDev, M15Loop::H_ROWS_BYTES_PF, "pf_y"},
        {&C.pfPosDev, static_cast<size_t>(M15Loop::M_PREFILL) * 4u, "pf_pos"},
        // ---- M100：PLE 段（尺寸全部来自 m15_layer_kernel.h 的 M15L::PLEW）----
        {&C.pleWDev, M15L::PLEW::W_BYTES, "ple_weights"},
        {&C.pleScrDev, M15L::PLEW::S_BYTES, "ple_scratch"},
        {&C.pleIdsDev, static_cast<size_t>(M15L::PLEW::T_MAX) * 4u, "ple_ids"},
        {&C.pleQslDev, 2u * 4u, "ple_qsl"},
        {&C.pleCtxDev, 2u * 4u, "ple_ctx"},
        {&C.pleMDev, 24u, "ple_m"},
        {&C.pleSzDev, 128u, "ple_sz"},
        {&C.pleOfDev, 128u, "ple_of"},
        // ---- M82：attention 三套 cache + packed indices（跨 12 个 attention 层长寿）----
        // 尺寸全部来自 m15_attn_kv.h 的 `*_PLANE_BYTES`（不在本文件重算）
        {&C.attnKvDev, M15Kv::KV_PLANE_BYTES, "attn_main_kv"},
        {&C.attnCompDev, M15Kv::COMP_PLANE_BYTES, "attn_comp_key"},
        {&C.attnRingDev, M15Kv::RING_PLANE_BYTES, "attn_raw_ring"},
        {&C.attnPackDev, M15Kv::PACK_PLANE_BYTES, "attn_packed_idx"},
        {&C.attnTblDev, H_KvTblBytes(), "attn_block_table"},
        {&C.attnSeedDev, M15KvProbe::SEED_BYTES, "attn_seed"},
        {&C.attnPackSeedDev, M15KvProbe::OUT_PACK_ROWS * M15Kv::PACK_ROW_BYTES, "attn_pack_seed"},
        {&C.attnProbeOutDev, M15KvProbe::OUT_BYTES, "attn_probe_out"},
        // ---- M88：attention 前端 prolog（单层；尺寸全部来自 m15_attn_prolog.h）----
        {&C.apWDev, M15AP::W_BYTES, "attn_prolog_w"},
        {&C.apXDev, static_cast<size_t>(2u) * M15AP::AP_HIDDEN * 2u, "attn_prolog_x"},
        {&C.apCsDev, M15AP::AP_CS_BYTES, "attn_prolog_cs"},
        {&C.apY0Dev, static_cast<size_t>(M15AP::Y0_N) * 2u, "attn_prolog_y0"},
        {&C.apOutDev, static_cast<size_t>(M15AP::AP_OUT_N) * 2u, "attn_prolog_out"},
    };
    for (const Item& it : items) {
        if (aclrtMalloc(it.p, it.bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || *it.p == nullptr) {
            printf("[m15][FAIL] aclrtMalloc(%s, %zu B) failed\n", it.tag, it.bytes);
            return false;
        }
    }
    printf("[m15] device 缓冲：weights %.2f MB（%u 层 × %.2f MB）+ states %.1f MB + ws %.1f MB"
           " + MoE 权重 %.1f MB（%u 层 × %.2f MB）+ 融合 ws %.2f MB（GDN %.2f + MoE %.2f）\n",
           static_cast<double>(wTotal) / 1e6, M15Loop::N_GDN,
           static_cast<double>(M15Loop::W_STRIDE) / 1e6, static_cast<double>(stTotal) / 1e6,
           static_cast<double>(WS_BYTES) / 1e6, static_cast<double>(moeWTotal) / 1e6, M15Loop::NL,
           static_cast<double>(M15L::MOE_W_STRIDE) / 1e6, static_cast<double>(M15L::WS_BYTES_TOTAL) / 1e6,
           static_cast<double>(M15L::WS_GDN_BYTES) / 1e6, static_cast<double>(M15L::WS_MOE_BYTES) / 1e6);
    // 污染 ws / 直接调用出口（防「未写区看起来是合法数据」造成假 PASS；m13/m14 同款）
    aclrtMemset(C.wsDev, WS_BYTES, 0xCD, WS_BYTES);
    aclrtMemset(C.wsDirectDev, WS_BYTES, 0xCD, WS_BYTES);
    aclrtMemset(C.wsFusedDev, M15L::WS_BYTES_TOTAL, 0xCD, M15L::WS_BYTES_TOTAL);
    aclrtMemset(C.wsGdnDev, M15L::WS_GDN_BYTES, 0xCD, M15L::WS_GDN_BYTES);
    aclrtMemset(C.wsMoeDev, M15L::WS_MOE_BYTES, 0xCD, M15L::WS_MOE_BYTES);
    aclrtMemset(C.yDirectDev, M15Loop::H_ROWS_BYTES, 0xCD, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.yFusedDev, M15Loop::H_ROWS_BYTES, 0xCD, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.ySubDev, M15Loop::H_ROWS_BYTES, 0xCD, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.yMoeDev, M15Loop::H_ROWS_BYTES, 0xCD, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.moeWDev, moeWTotal, 0xCD, moeWTotal);
    // 零残差 / 直接调用输入：全零（行 0 每层单独写）
    aclrtMemset(C.resZeroDev, M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.xDirectDev, M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.xFusedDev, M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.xMoeDev, M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.hDev[0], M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.hDev[1], M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
    // ---- M58：hc 的权重区/ws 污染（防「未写区看起来是合法数据」），输入面带区清零 ----
    aclrtMemset(C.hcWDev, hcWTotal, 0xCD, hcWTotal);
    aclrtMemset(C.hcWsDev, hcWsTotal, 0xCD, hcWsTotal);
    aclrtMemset(C.hcHDev, static_cast<size_t>(M15H::M_MAX) * M15H::HYPER * 2u, 0xCD,
                static_cast<size_t>(M15H::M_MAX) * M15H::HYPER * 2u);
    aclrtMemset(C.hcBoDev, M15Loop::H_ROWS_BYTES, 0, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.hcIjDev, static_cast<size_t>(M15H::M_MAX) * M15H::IJ_STRIDE * 2u, 0,
                static_cast<size_t>(M15H::M_MAX) * M15H::IJ_STRIDE * 2u);
    aclrtMemset(C.hcAttnOutDev, M15Loop::H_ROWS_BYTES, 0xCD, M15Loop::H_ROWS_BYTES);
    aclrtMemset(C.chainBoDev, static_cast<size_t>(CH_BO_PLANES) * M15Loop::H_ROWS_BYTES, 0,
                static_cast<size_t>(CH_BO_PLANES) * M15Loop::H_ROWS_BYTES);
    // 口径（M65 r2 修 ①）：**每槽 = `HC_LAYER_W_STRIDE` = 26.91 MB**（一个「层槽」含 2 个边界子槽，
    // 每子槽 `HC_W_STRIDE` = 13.46 MB）—— 打印的每槽尺寸必须与「槽数 × 每槽 = 合计」自洽。
    printf("[m15] M58 hc 缓冲：权重 %.2f MB（%u 槽 × %.2f MB/槽；%u = %u 个层槽（每层 2 个边界子槽 × "
           "%.2f MB）+ 1 个全局 mixer 槽，该槽只用到 13.13 MB（norm+down+up），槽 stride 仍为 %.2f MB）"
           "+ hc ws %.2f MB（%u 槽 × %.2f MB/槽 = 每层 2 块 + 3 块 scratch + 1 块全局 mixer ws）\n",
           static_cast<double>(hcWTotal) / 1e6, M15L::HC_W_SLOTS,
           static_cast<double>(M15L::HC_LAYER_W_STRIDE) / 1e6, M15L::HC_W_SLOTS, M15Loop::NL,
           static_cast<double>(M15L::HC_W_STRIDE) / 1e6,
           static_cast<double>(M15L::HC_LAYER_W_STRIDE) / 1e6, static_cast<double>(hcWsTotal) / 1e6,
           M15L::HC_WS_SLOTS, static_cast<double>(M15L::HC_WS_LAYER_STRIDE) / 1e6);
    printf("[m15] M65 层链缓冲：pending BO 双缓冲 %.2f MB（%u 块 × %u B）；三态入口平面复用 hc_hin\n",
           static_cast<double>(CH_BO_PLANES) * M15Loop::H_ROWS_BYTES / 1e6, CH_BO_PLANES,
           M15Loop::H_ROWS_BYTES);
    // ---- M82：attention 三套 cache + packed indices（初值全零：它们是**跨 token 常驻的状态**）----
    aclrtMemset(C.attnKvDev, M15Kv::KV_PLANE_BYTES, 0, M15Kv::KV_PLANE_BYTES);
    aclrtMemset(C.attnCompDev, M15Kv::COMP_PLANE_BYTES, 0, M15Kv::COMP_PLANE_BYTES);
    aclrtMemset(C.attnRingDev, M15Kv::RING_PLANE_BYTES, 0, M15Kv::RING_PLANE_BYTES);
    aclrtMemset(C.attnPackDev, M15Kv::PACK_PLANE_BYTES, 0, M15Kv::PACK_PLANE_BYTES);
    aclrtMemset(C.attnProbeOutDev, M15KvProbe::OUT_BYTES, 0xCD, M15KvProbe::OUT_BYTES);
    printf("[m15] M82 attention cache 平面（跨 %u 个 attention 层长寿，按第 k 层编址 k=0..%u）："
           "主 KV %.2f MB（%u 层 × %.3f MB/层 = %u 页/层 × %u B）；compressed %.2f MB"
           "（%u 层 × %.3f MB/层 = %u 行/层 × %u B）；raw ring %.5f MB（%u 层 × %u B = %u 行/层 × %u B）；"
           "packed %.2f MB（%u 行 × %u B，**层间复用一块**）\n",
           M15Loop::N_ATTN, M15Loop::N_ATTN - 1u, static_cast<double>(M15Kv::KV_PLANE_BYTES) / 1e6,
           M15Loop::N_ATTN, static_cast<double>(M15Kv::KV_LAYER_STRIDE) / 1e6, M15Kv::PREFILL_BLOCKS,
           M15Kv::KV_BLOCK_BYTES, static_cast<double>(M15Kv::COMP_PLANE_BYTES) / 1e6, M15Loop::N_ATTN,
           static_cast<double>(M15Kv::COMP_LAYER_STRIDE) / 1e6, M15Kv::PREFILL_COMP_ROWS,
           M15Kv::COMP_ROW_BYTES, static_cast<double>(M15Kv::RING_PLANE_BYTES) / 1e6, M15Loop::N_ATTN,
           M15Kv::RING_LAYER_STRIDE, M15Kv::RING_ROWS_PER_BLOCK, M15Kv::RING_ROW_BYTES,
           static_cast<double>(M15Kv::PACK_PLANE_BYTES) / 1e6, M15Kv::PREFILL_M, M15Kv::PACK_ROW_BYTES);
    // ---- M136（Wave D）：prefill 段体平面（只在 wire=1 时分配；失败即硬失败）----
    if (!H_PfSegAlloc(C)) {
        return false;
    }
    return true;
}

static bool H_LoadWeights(Ctx& C)
{
    using namespace M15G;
    const double t0 = H_NowMs();
    std::string err;

    // host 期望镜像：与设备权重区同布局（同一 W_STRIDE 槽位表），装配完成后整槽 H2D；
    // 它同时是「权重来源校验」的比对面（见 H_WeightSourceCheck）。
    const size_t arenaBytes = static_cast<size_t>(M15Loop::N_GDN) * M15Loop::W_STRIDE;
    C.hostArena.assign(arenaBytes, 0);
    if (aclrtMemset(C.wDev, arenaBytes, 0, arenaBytes) != ACL_SUCCESS) {
        printf("[m15][FAIL] memset 权重区失败\n");
        return false;
    }

    // 合成模式下大权重（in_proj/out_proj）：生成一份共享（84MB×36 的逐层合成不划算；
    // synth 只用于 bring-up 冒烟，见 README §限制）
    std::vector<uint16_t> synthWIn;
    std::vector<uint16_t> synthWOut;
    if (!C.real) {
        synthWIn.resize(static_cast<size_t>(IN_N) * HIDDEN);
        synthWOut.resize(static_cast<size_t>(OUT_N) * OUT_K);
        H_GenBf16(synthWIn, 101u, 1.0f);
        H_GenBf16(synthWOut, 102u, 1.0f);
    }

    uint32_t loaded = 0;
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        if (M15Loop::KindOf(L) != M15Loop::KIND_GDN) {
            continue;
        }
        ++loaded;
        M15LayerW& W = C.W[L];
        H_AllocLayerW(W);
        if (C.real) {
            if (!H_LoadSmallW(C.M, L, W, err)) {
                printf("[m15][FAIL] 层 %u 小权重装载失败: %s\n", L, err.c_str());
                return false;
            }
        } else {
            H_GenLayerW(W, L);
        }
        uint8_t* dst = C.hostArena.data() + static_cast<size_t>(M15Loop::LayerSlot(L)) * M15Loop::W_STRIDE;
        auto put = [dst](uint32_t off, const void* src, size_t bytes) {
            __builtin_memcpy(dst + off, src, bytes);
        };
        put(M15Loop::W_CONV_OFF, W.convW.data(), W.convW.size() * 2);
        put(M15Loop::W_CONVB_OFF, W.convBias.data(), W.convBias.size() * 2);
        put(M15Loop::W_ALOG_OFF, W.aLog.data(), W.aLog.size() * 4);
        put(M15Loop::W_DTB_OFF, W.dtBias.data(), W.dtBias.size() * 4);
        put(M15Loop::W_G1_OFF, W.gamma1.data(), W.gamma1.size() * 2);
        put(M15Loop::W_G2_OFF, W.gamma2.data(), W.gamma2.size() * 2);
        put(M15Loop::W_GG_OFF, W.gammaG.data(), W.gammaG.size() * 2);
        {
            std::vector<uint16_t> wIn;
            std::vector<uint16_t> wOut;
            if (!H_AssembleBigW(C.M, L, C.real, synthWIn.data(), synthWOut.data(), wIn, wOut, err)) {
                printf("[m15][FAIL] 层 %u 大权重装配失败: %s\n", L, err.c_str());
                return false;
            }
            put(M15Loop::W_IN_OFF, wIn.data(), wIn.size() * 2);
            put(M15Loop::W_OUT_OFF, wOut.data(), wOut.size() * 2);
        }
    }

    // 逐槽 H2D（而非一次 4.17GB 整块：失败点带层号，便于定位）
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        if (M15Loop::KindOf(L) != M15Loop::KIND_GDN) {
            continue;
        }
        const size_t off = static_cast<size_t>(M15Loop::LayerSlot(L)) * M15Loop::W_STRIDE;
        H_H2D(C, reinterpret_cast<uint8_t*>(C.wDev) + off, C.hostArena.data() + off, M15Loop::W_STRIDE, "w_slot");
    }
    if (C.fails != 0) {
        return false;
    }
    printf("[m15] 权重装载完成（%s）：前 %u 层内 %u 个 GDN 层，%.2f MB → device，耗时 %.1f ms\n",
           C.real ? "真实 checkpoint 切片" : "合成", C.O.nLayers, loaded,
           static_cast<double>(arenaBytes) / 1e6, H_NowMs() - t0);

    // ---- M40：MoE 段权重（**48 层每层都有**，包括 attention 层）----
    // 角色清单见 M15L::MW_ROLE_*；真实档按 manifest 自己 pread（不做任何数值换算），
    // 合成档用确定性公式。**唯一 host 组板** = 共享专家的 gate||up 行拼接（m13 同款）。
    const double t1 = H_NowMs();
    const size_t moeArenaBytes = static_cast<size_t>(M15Loop::NL) * M15L::MOE_W_STRIDE;
    C.moeArena.assign(moeArenaBytes, 0);
    if (aclrtMemset(C.moeWDev, moeArenaBytes, 0, moeArenaBytes) != ACL_SUCCESS) {
        printf("[m15][FAIL] memset MoE 权重区失败\n");
        return false;
    }
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        M15MoeW W;
        H_MoeWAlloc(W);
        if (C.real) {
            if (!H_LoadMoeW(C.M, L, W, err)) {
                printf("[m15][FAIL] 层 %u MoE 权重装载失败: %s\n", L, err.c_str());
                return false;
            }
        } else {
            H_GenMoeW(W, L);
        }
        H_PutMoeSlot(C.moeArena, L, W);
    }
    // 逐槽 H2D（只装本 run 会启动的层；其余槽位保持 0 —— 它们不会被任何 kernel 读到，
    // 因为层循环只跑前 C.O.nLayers 层）
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        H_H2D(C, reinterpret_cast<uint8_t*>(C.moeWDev) + static_cast<size_t>(L) * M15L::MOE_W_STRIDE,
              C.moeArena.data() + static_cast<size_t>(L) * M15L::MOE_W_STRIDE, M15L::MOE_W_STRIDE, "moe_w_slot");
    }
    if (C.fails != 0) {
        return false;
    }
    printf("[m15] MoE 段权重装载完成（%s）：%u 层 × %.2f MB = %.1f MB → device，耗时 %.1f ms\n",
           C.real ? "真实 checkpoint 4 专家切片 + 真实共享专家" : "合成", C.O.nLayers,
           static_cast<double>(M15L::MOE_W_STRIDE) / 1e6,
           static_cast<double>(C.O.nLayers) * M15L::MOE_W_STRIDE / 1e6, H_NowMs() - t1);

    // ---- M58：hc 段权重（**每层都有两个边界**：attn_hc / mlp_hc）----
    // 角色清单见 M15L::HW_ROLE_*；真实档按 manifest 自己 pread（不做任何数值换算）。
    // **唯一 host 组板** = `block_inject_weight` 由 4 行补到 16 行、行 [4,16) 置零（资源表 §1b 的契约）。
    const double t2 = H_NowMs();
    const size_t hcArenaBytes = static_cast<size_t>(M15L::HC_W_SLOTS) * M15L::HC_LAYER_W_STRIDE;
    C.hcArena.assign(hcArenaBytes, 0);
    if (aclrtMemset(C.hcWDev, hcArenaBytes, 0, hcArenaBytes) != ACL_SUCCESS) {
        printf("[m15][FAIL] memset hc 权重区失败\n");
        return false;
    }
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        for (uint32_t which = 0; which < 2u; ++which) {
            M15HcW W;
            H_HcWAlloc(W);
            if (C.real) {
                if (!H_LoadHcW(C.M, L, (which == 0u) ? "attn_hc" : "mlp_hc", W, err)) {
                    printf("[m15][FAIL] 层 %u %s 权重装载失败: %s\n", L, (which == 0u) ? "attn_hc" : "mlp_hc",
                           err.c_str());
                    return false;
                }
            } else {
                H_GenHcW(W, L, which);
            }
            H_PutHcSlot(C.hcArena, L, which, W);
        }
    }
    // ---- M65：末层全局 mixer 的权重（第 49 个槽 = `HC_GMIX_LAYER_SLOT`）----
    // 3 个张量（norm/down/up），**没有** block_inject_weight ⇒ 注入区 16 行全零（`H_LoadGmW` 里落实）。
    {
        M15HcW G;
        H_HcWAlloc(G);
        if (C.real) {
            if (!H_LoadGmW(C.M, G, err)) {
                printf("[m15][FAIL] 全局 mixer 权重装载失败: %s\n", err.c_str());
                return false;
            }
        } else {
            H_GenGmW(G);
        }
        H_PutHcSlot(C.hcArena, M15L::HC_GMIX_LAYER_SLOT, 0u, G);   // 权重区的第 49 槽
    }
    // 逐层 H2D（只装本 run 会启动的层；其余槽位保持 0 —— 层循环只跑前 C.O.nLayers 层）
    // + 全局 mixer 槽**恒装**（链的末层 mixer 只用它，与 C.O.nLayers 无关）
    for (uint32_t L = 0; L <= M15L::HC_GMIX_LAYER_SLOT; ++L) {
        if (L < C.O.nLayers || L == M15L::HC_GMIX_LAYER_SLOT) {
            H_H2D(C, reinterpret_cast<uint8_t*>(C.hcWDev) + static_cast<size_t>(L) * M15L::HC_LAYER_W_STRIDE,
                  C.hcArena.data() + static_cast<size_t>(L) * M15L::HC_LAYER_W_STRIDE,
                  M15L::HC_LAYER_W_STRIDE, (L == M15L::HC_GMIX_LAYER_SLOT) ? "gm_w_slot" : "hc_w_slot");
        }
    }
    if (C.fails != 0) {
        return false;
    }
    // 口径（M65 r2 修 ①）：**H2D 的字节数 = (nLayers + 1) × 每槽 26.91 MB**（逐槽整块搬），
    // 与「每槽尺寸 × 槽数 = 合计」自洽；权重区**分配**是 49 槽 × 26.91 MB。
    const double loadedMB =
        static_cast<double>(C.O.nLayers + 1u) * M15L::HC_LAYER_W_STRIDE / 1e6;
    printf("[m15] hc 段权重装载完成（%s）：本 run H2D %u 槽 × %.2f MB/槽 = %.1f MB"
           "（%u 个层槽，每层 2 个边界子槽 × %.2f MB，+ 1 个全局 mixer 槽）；权重区分配 %u 槽 × %.2f MB/槽 "
           "= %.1f MB → device，耗时 %.1f ms\n",
           C.real ? "真实 checkpoint（hc 权重不量化、原样消费）" : "合成", C.O.nLayers + 1u,
           static_cast<double>(M15L::HC_LAYER_W_STRIDE) / 1e6, loadedMB, C.O.nLayers,
           static_cast<double>(M15L::HC_W_STRIDE) / 1e6, M15L::HC_W_SLOTS,
           static_cast<double>(M15L::HC_LAYER_W_STRIDE) / 1e6,
           static_cast<double>(M15L::HC_W_SLOTS) * M15L::HC_LAYER_W_STRIDE / 1e6, H_NowMs() - t2);
    return true;
}

// ============================================================
// 权重来源校验（review P2-1）：in_proj / out_proj 的**独立字节级来源判据**
//
// 为什么需要它：Ver A 的 direct 与 loop 两侧走同一个 H_W()/LayerSlot()（同一指针），**槽位↔层号
// 错位在 Ver A 里不可见**；Ver B 以设备 qkvzba 为锚点、参考链不重算 in_proj/out_proj，故
// 84.4MB/层 的 in_proj 与 31.5MB/层 的 out_proj 此前没有任何来源判据。
//
// 本检查**不复用装载器的装配路径**：自己按 manifest 的 `rows/cols/offset/bytes` pread 四个
// in_proj 张量（qkv|z|b|a）与 out_proj，用 **manifest 自己声明的 rows** 计算段偏移（与 kernel 的
// Q_DIM/Z_DIM/… 常量无关），与**设备槽位回读**逐段 memcmp，并打印两侧 sha256。
// 另把整槽（含小权重/合成 gamma）与 host 期望镜像逐字节比对。
// ============================================================

struct Sha256 {
    uint32_t h[8];
    uint64_t len = 0;
    uint8_t buf[64];
    size_t buflen = 0;
    Sha256() { init(); }
    void init()
    {
        static const uint32_t K[8] = {0x6a09e667u, 0xbb67ae85u, 0x3c6ef372u, 0xa54ff53au,
                                      0x510e527fu, 0x9b05688cu, 0x1f83d9abu, 0x5be0cd19u};
        for (int i = 0; i < 8; ++i) {
            h[i] = K[i];
        }
    }
    static uint32_t rotr(uint32_t x, uint32_t n) { return (x >> n) | (x << (32 - n)); }
    void block(const uint8_t* p)
    {
        static const uint32_t K[64] = {
            0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
            0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
            0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
            0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
            0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
            0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
            0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
            0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};
        uint32_t w[64];
        for (int i = 0; i < 16; ++i) {
            w[i] = (static_cast<uint32_t>(p[i * 4]) << 24) | (static_cast<uint32_t>(p[i * 4 + 1]) << 16) |
                   (static_cast<uint32_t>(p[i * 4 + 2]) << 8) | static_cast<uint32_t>(p[i * 4 + 3]);
        }
        for (int i = 16; i < 64; ++i) {
            const uint32_t s0 = rotr(w[i - 15], 7) ^ rotr(w[i - 15], 18) ^ (w[i - 15] >> 3);
            const uint32_t s1 = rotr(w[i - 2], 17) ^ rotr(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        }
        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
        for (int i = 0; i < 64; ++i) {
            const uint32_t S1 = rotr(e, 6) ^ rotr(e, 11) ^ rotr(e, 25);
            const uint32_t ch = (e & f) ^ ((~e) & g);
            const uint32_t t1 = hh + S1 + ch + K[i] + w[i];
            const uint32_t S0 = rotr(a, 2) ^ rotr(a, 13) ^ rotr(a, 22);
            const uint32_t maj = (a & b) ^ (a & c) ^ (b & c);
            const uint32_t t2 = S0 + maj;
            hh = g; g = f; f = e; e = d + t1; d = c; c = b; b = a; a = t1 + t2;
        }
        h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
    }
    void update(const uint8_t* p, size_t n)
    {
        len += n;
        while (n > 0) {
            const size_t take = (64 - buflen < n) ? (64 - buflen) : n;
            __builtin_memcpy(buf + buflen, p, take);
            buflen += take;
            p += take;
            n -= take;
            if (buflen == 64) {
                block(buf);
                buflen = 0;
            }
        }
    }
    void final(uint8_t out[32])
    {
        const uint64_t bits = len * 8;
        uint8_t pad = 0x80;
        update(&pad, 1);
        const uint8_t zero = 0;
        while (buflen != 56) {
            update(&zero, 1);
        }
        uint8_t lenb[8];
        for (int i = 0; i < 8; ++i) {
            lenb[i] = static_cast<uint8_t>((bits >> (56 - 8 * i)) & 0xffu);
        }
        update(lenb, 8);
        for (int i = 0; i < 8; ++i) {
            out[i * 4] = static_cast<uint8_t>(h[i] >> 24);
            out[i * 4 + 1] = static_cast<uint8_t>(h[i] >> 16);
            out[i * 4 + 2] = static_cast<uint8_t>(h[i] >> 8);
            out[i * 4 + 3] = static_cast<uint8_t>(h[i]);
        }
    }
};

static std::string H_Sha256Hex(const void* data, size_t n)
{
    Sha256 s;
    s.update(reinterpret_cast<const uint8_t*>(data), n);
    uint8_t d[32];
    s.final(d);
    char hex[65];
    for (int i = 0; i < 32; ++i) {
        snprintf(hex + i * 2, 3, "%02x", d[i]);
    }
    return std::string(hex, 64);
}

// 独立来源：按 manifest 自己声明的 rows/cols 逐张量 pread，拼成 in_proj（qkv|z|b|a）与 out_proj
static bool H_SourceInProj(const M15Manifest& M, uint32_t layer, std::vector<uint8_t>& in, std::string& err)
{
    using namespace M15G;
    static const char* kRoles[4] = {"in_proj_qkv", "in_proj_z", "in_proj_b", "in_proj_a"};
    in.clear();
    uint32_t rowsTotal = 0;
    for (const char* role : kRoles) {
        const M15Tensor* T = H_FindTensor(M, layer, role);
        if (T == nullptr) {
            err = std::string("manifest 缺 ") + role;
            return false;
        }
        if (T->cols != HIDDEN || T->dtype != "BF16") {
            err = std::string(role) + " 的 cols/dtype 与层 kernel 契约不符";
            return false;
        }
        std::vector<uint8_t> raw;
        if (!H_ReadTensor(M, *T, raw, err)) {
            return false;
        }
        if (raw.size() != static_cast<size_t>(T->rows) * HIDDEN * 2) {
            err = std::string(role) + " 字节数 != rows×HIDDEN×2";
            return false;
        }
        in.insert(in.end(), raw.begin(), raw.end());
        rowsTotal += T->rows;
    }
    if (rowsTotal != IN_N || in.size() != static_cast<size_t>(IN_N) * HIDDEN * 2) {
        err = "in_proj 段行数之和 != 16480（manifest rows 与 kernel 布局不符）";
        return false;
    }
    return true;
}

// sha256 工具自检（guard）：用 NIST 已知向量验证实现，避免「摘要算错但两侧一致」的假 PASS
static bool H_Sha256SelfTest(Ctx& C)
{
    const std::string a = H_Sha256Hex("abc", 3);
    const std::string big(1000000, 'a');
    const std::string b = H_Sha256Hex(big.data(), big.size());
    const char* kExpA = "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
    const char* kExpB = "cdc76e5c9914fb9281a1c7e284d73e67f1809a48a497200e046d39ccc7112cd0";
    const bool ok = (a == kExpA) && (b == kExpB);
    printf("[m15] sha256 自检（NIST 向量：\"abc\" 与 1e6\u00d7'a'）：%s\n", ok ? "PASS" : "FAIL");
    if (!ok) {
        printf("[m15][FAIL] sha256 got %s / %s\n", a.c_str(), b.c_str());
    }
    const bool g = H_Guard(C, ok);
    C.guardsSha += 1u;
    return g;
}

static bool H_WeightSourceCheck(Ctx& C)
{
    using namespace M15G;
    printf("\n[m15] ===== 权重来源校验（review P2-1：in_proj/out_proj 独立字节级来源）=====\n");
    const double t0 = H_NowMs();
    const size_t arenaBytes = static_cast<size_t>(M15Loop::N_GDN) * M15Loop::W_STRIDE;
    C.devBackup.resize(arenaBytes);
    const aclError e = aclrtMemcpy(C.devBackup.data(), arenaBytes, C.wDev, arenaBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    if (e != ACL_SUCCESS) {
        printf("[m15][FAIL] 权重区 D2H 失败 (err %d)\n", static_cast<int>(e));
        C.fails++;
        return false;
    }

    struct Res {
        bool slot = false;
        bool in = false;
        bool out = false;
        std::string inDev, inCk, outDev, outCk, note;
    };
    std::vector<Res> res(C.O.nLayers);
    std::vector<uint32_t> layers;
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        if (M15Loop::KindOf(L) == M15Loop::KIND_GDN) {
            layers.push_back(L);
        }
    }
    std::atomic<size_t> next{0};
    const uint32_t nThreads = 16;
    auto worker = [&]() {
        for (;;) {
            const size_t i = next.fetch_add(1);
            if (i >= layers.size()) {
                return;
            }
            const uint32_t L = layers[i];
            const size_t off = static_cast<size_t>(M15Loop::LayerSlot(L)) * M15Loop::W_STRIDE;
            const uint8_t* dev = C.devBackup.data() + off;
            const uint8_t* exp = C.hostArena.data() + off;
            Res& R = res[L];
            R.slot = (__builtin_memcmp(dev, exp, M15Loop::W_STRIDE) == 0);
            R.inDev = H_Sha256Hex(dev + M15Loop::W_IN_OFF, M15Loop::W_IN_BYTES);
            R.outDev = H_Sha256Hex(dev + M15Loop::W_OUT_OFF, M15Loop::W_OUT_BYTES);
            if (C.real) {
                std::vector<uint8_t> ckIn;
                std::string err;
                if (H_SourceInProj(C.M, L, ckIn, err)) {
                    R.in = (__builtin_memcmp(dev + M15Loop::W_IN_OFF, ckIn.data(), M15Loop::W_IN_BYTES) == 0);
                    R.inCk = H_Sha256Hex(ckIn.data(), ckIn.size());
                } else {
                    R.note = err;
                }
                const M15Tensor* T = H_FindTensor(C.M, L, "out_proj");
                std::vector<uint8_t> ckOut;
                if (T != nullptr && H_ReadTensor(C.M, *T, ckOut, err)) {
                    R.out = (__builtin_memcmp(dev + M15Loop::W_OUT_OFF, ckOut.data(), M15Loop::W_OUT_BYTES) == 0);
                    R.outCk = H_Sha256Hex(ckOut.data(), ckOut.size());
                } else {
                    R.note += " out_proj 读取失败";
                }
            } else {
                // 合成档无 checkpoint 来源：只做「设备槽位 == host 期望镜像」的摘要
                R.in = R.slot;
                R.out = R.slot;
                R.inCk = exp ? H_Sha256Hex(exp + M15Loop::W_IN_OFF, M15Loop::W_IN_BYTES) : "";
                R.outCk = exp ? H_Sha256Hex(exp + M15Loop::W_OUT_OFF, M15Loop::W_OUT_BYTES) : "";
            }
        }
    };
    std::vector<std::thread> pool;
    for (uint32_t t = 0; t < nThreads; ++t) {
        pool.emplace_back(worker);
    }
    for (std::thread& t : pool) {
        t.join();
    }

    uint32_t okSlot = 0;
    uint32_t okIn = 0;
    uint32_t okOut = 0;
    for (uint32_t L : layers) {
        const Res& R = res[L];
        C.checks++;
        const bool allOk = R.slot && R.in && R.out;
        if (allOk) {
            ++okSlot;
            ++okIn;
            ++okOut;
        } else {
            C.fails++;
        }
        printf("[m15]   W.src.L%02u %s (slot_ref=%s in_proj=%s out_proj=%s)\n", L, allOk ? "PASS" : "FAIL",
               R.slot ? "逐字节一致" : "不一致", R.in ? "逐字节一致" : "不一致", R.out ? "逐字节一致" : "不一致");
        // 真实档：ckpt-source = 独立 pread + 按 manifest rows 拼接的 checkpoint 字节；
        // 合成档无 checkpoint 来源，第二列是 host 期望镜像（已在 README 披露）
        const char* srcTag = C.real ? "ckpt-source" : "host-mirror";
        printf("[m15]        in_proj  slot sha256=%s  %s sha256=%s\n", R.inDev.c_str(), srcTag, R.inCk.c_str());
        printf("[m15]        out_proj slot sha256=%s  %s sha256=%s\n", R.outDev.c_str(), srcTag, R.outCk.c_str());
        if (!R.note.empty()) {
            printf("[m15]        note: %s\n", R.note.c_str());
        }
    }
    C.phaseW = C.checks;
    printf("[m15] 权重来源校验（%s）：%zu 个 GDN 层，slot 逐字节 %u / in_proj %u / out_proj %u；耗时 %.1f ms\n",
           C.real ? "对照 checkpoint 独立来源" : "对照 host 期望镜像（合成档）", layers.size(), okSlot, okIn, okOut,
           H_NowMs() - t0);
    C.devBackup.clear();
    C.devBackup.shrink_to_fit();
    return (okSlot == layers.size() && okIn == layers.size() && okOut == layers.size());
}

// ============================================================
// MoE 段权重的**独立来源判据**（M40；docs/17 §4「槽位/层号可区分」）
//
// 与上面 GDN 档同款思路、但**不复用装载路径**：自己按 manifest 的 role 重新 pread 12 个
// 张量（共享专家的 gate/up 自己再拼一次行），与**设备 MoE 权重槽回读**逐字节比对，
// 并打印两侧 sha256。它同时兜住三件事：
//   ① 层号 ↔ MoE 槽位错位（每层摘要互不相同）；
//   ② 共享专家 gate||up 的拼接方向（拼反了这条立刻红）；
//   ③ MXFP4 打包字节没被任何中间转换改动（本 mission 全程不做数值换算）。
// ============================================================

static bool H_MoeWeightSourceCheck(Ctx& C)
{
    using namespace M15L;
    printf("\n[m15] ===== MoE 段权重来源校验（独立 pread vs 设备槽位，逐字节 + sha256）=====\n");
    if (!C.real) {
        printf("[m15]   合成权重档：本项跳过（合成档不可作为验收证据，见 README §验收档口径）\n");
        printf("[m15]   说明：合成档下本项**不产生判定项**，因此 checks 总数会比验收档少 %u 条（README 分账行会标注）\n",
               C.O.nLayers);
        return true;
    }
    const uint32_t base = C.checks;
    const size_t slotBytes = MOE_W_STRIDE;
    std::vector<uint8_t> dev(slotBytes);
    std::vector<uint8_t> host(slotBytes, 0);
    for (uint32_t L = 0; L < C.O.nLayers; ++L) {
        M15MoeW W;
        H_MoeWAlloc(W);
        std::string err;
        char tag[64];
        snprintf(tag, sizeof(tag), "M.wsrc.L%02u", L);
        if (!H_LoadMoeW(C.M, L, W, err)) {
            C.checks++;
            C.fails++;
            printf("[m15]   %-30s FAIL（独立 pread 失败：%s）\n", tag, err.c_str());
            continue;
        }
        std::fill(host.begin(), host.end(), 0);
        H_PutMoeSlot(host, 0u, W);   // 单层镜像（层内偏移，不乘 slot）
        H_D2H(C, dev.data(), reinterpret_cast<uint8_t*>(C.moeWDev) + static_cast<size_t>(L) * slotBytes, slotBytes,
              "moe_w_slot");
        C.checks++;
        if (__builtin_memcmp(dev.data(), host.data(), slotBytes) == 0) {
            printf("[m15]   %-30s PASS  slot sha256 dev=%s ckpt=%s\n", tag, H_Sha256Hex(dev.data(), slotBytes).c_str(),
                   H_Sha256Hex(host.data(), slotBytes).c_str());
        } else {
            C.fails++;
            printf("[m15]   %-30s FAIL（设备 MoE 权重槽与 checkpoint 独立来源不一致）\n", tag);
        }
    }
    C.phaseMw = C.checks - base;
    C.phaseW = C.checks;   // 权重来源判据（GDN + MoE）合并计入 phaseW，供 Ver A/B/C 的基线沿用
    printf("[m15]   MoE 权重来源：%u 层逐字节一致（slot %.3f MB/层）\n", C.O.nLayers,
           static_cast<double>(slotBytes) / 1e6);
    return true;
}

// ============================================================
// 4g. M100：PLE 段接进融合 kernel 的**接线见证**（新档 `runs=plewire`）
// ============================================================
// 走的是**真实挂接路径**：`m15_layer_kernel_gdn_hc`（四相位入口）在 `M15_PLE_LAYER` 层的
// 打断点上跑 `M15L_PleIds`（①）→ `FLAG_PLE_IN_BOUND_AIV` → `M15L_PleBody`（②③④⑤）→
// `FLAG_PLE_OUT_BOUND_AIV` → mix-only。**不是**独立探针、**不是**独立 kernel。
//
// 判据两组：
//  ① 「接线真的生效」（非空洞性）：接线上/下的同一层入口态 `ws0+WS_HCP` 必须不同
//     （PLE 直接改 10240 宽的多流态）；关掉接线 / 实参错位 ⇒ 本组必红（负向对照给打破条数）。
//  ② 「段内产物对得上」：①ids 与 host 独立参考**逐位相同**（T1）；②gather 的 16 行与 host
//     从同一窗口读回的字节**逐字节相同**（T1）；设备侧行校验计数（M92 的 `Hd.row_fail` /
//     `Hd.miss`）与 ① 的值域计数全 0；conv 状态演化（T1 移位 + 非空洞）；连跑确定性。
//
// **未做**（显式未完成项，见 evidence/ple_wire/）：③④⑤ 的 T3 数值对拍（需要一份 host 侧的
// float64 PLE 参考链，本 mission 未写）；因此 `gated/normed/out` 只有关系类判据（见下）。
struct PleRunOut {
    std::vector<uint8_t> hcp;      // 层的入口多流态（接线开 = PLE 之后；关 = 物化后的 H'）
    std::vector<uint8_t> ids;      // [T,16] int64
    std::vector<uint8_t> emb;      // [T,2560] bf16
    std::vector<uint8_t> kv;       // [T,12800] bf16（M124：③ 的判据 `Pw.kv.T3` 的被判量）
    std::vector<uint8_t> gated, normed;
    std::vector<uint8_t> stout, stin;
    std::vector<uint8_t> faili, failb, hmbad;
    std::vector<uint8_t> hout;     // 层出口 H''（H2 的输出）
};

static uint8_t* H_PlePlane(Ctx& C, uint32_t off)
{
    return reinterpret_cast<uint8_t*>(C.pleScrDev) + off;
}

// 读回 PLE 段的全部产物（device → host）
static void H_PleReadBack(Ctx& C, uint32_t m, PleRunOut& O)
{
    const size_t hyb = static_cast<size_t>(m) * M15H::HYPER * 2u;
    const size_t tok = C.O.pleTok;
    auto get = [&](std::vector<uint8_t>& v, uint32_t off, size_t bytes, const char* tag) {
        v.resize(bytes);
        H_D2H(C, v.data(), H_PlePlane(C, off), bytes, tag);
    };
    get(O.ids, M15L::PLEW::S_IDS, tok * M15L::PLEW::NG * 8u, "ple_ids");
    get(O.emb, M15L::PLEW::S_EMB, tok * M15L::PLEW::HID * 2u, "ple_emb");
    get(O.kv, M15L::PLEW::S_KV, tok * M15L::PLEW::KVW * 2u, "ple_kv");   // M124：③ 的判据读它
    get(O.gated, M15L::PLEW::S_GATED, tok * M15L::PLEW::HYPER * 2u, "ple_gated");
    get(O.normed, M15L::PLEW::S_NORMED, tok * M15L::PLEW::HYPER * 2u, "ple_normed");
    get(O.stin, M15L::PLEW::S_STIN, static_cast<size_t>(M15L::PLEW::STLEN) * M15L::PLEW::HYPER * 2u, "ple_stin");
    get(O.stout, M15L::PLEW::S_STOUT, static_cast<size_t>(M15L::PLEW::STLEN) * M15L::PLEW::HYPER * 2u,
        "ple_stout");
    get(O.faili, M15L::PLEW::S_FAILI, M15L::PLEW::FAIL_SLOTS * 4u, "ple_faili");
    get(O.failb, M15L::PLEW::S_FAILB, M15L::PLEW::FAIL_SLOTS * 4u, "ple_failb");
    get(O.hmbad, M15L::PLEW::S_HMBAD, M15L::PLEW::FAIL_SLOTS * 8u * 4u, "ple_hmbad");
    O.hcp.resize(hyb);
    H_D2H(C, O.hcp.data(), H_ChWs0(C, C.O.pleLayer) + M15H::WS_HCP, hyb, "ple_hcp");
    H_Sync(C, "ple_readback");
}

// ---- M191：跨 step 的 short-conv 状态承接（`S_STOUT → S_STIN`）----
// 为什么需要它：PLE 的 ⑤（`M85P::PleConvItem`）把本 step 的新状态写在**出口平面** `stOut`
//   （`PLEW::S_STOUT`），读的是**入口平面** `stIn`（`PLEW::S_STIN`）—— 两个平面在 scratch slab 里
//   是不同区间（`m15_layer_kernel.h` 的 `S_STIN` / `S_STOUT`）。段体内**没有任何**把 stOut 搬回
//   stIn 的动作，也没有别的写入者 ⇒ 下一个 step 读到的仍是初值，**每 token 的状态演化没有序列承接**
//   （M158 survey G2 / `ple/README.md §7 U3`）。
// 它做什么：把出口平面的**活槽**逐字节搬回入口平面（`ple/PLE_SPEC.md §2 I6`：状态每请求一行）。
//   **活槽数的表达式与 device 定尺共用 `M15L_ACT_STATE_SLOTS(nreq, stateSlots)`** —— 两处边界
//   （`nreq == 0`、`nreq > stateSlots`）行为一致，不会出现「kernel 截到分配上界、host 按 nreq 越界搬」
//   的分叉；`H_PleArgsOf` 传的分配上界就是 `PLEW::T_MAX`。搬运是 device→device 的 DMA 拷贝，
//   不引入任何核内/核间同步原语（host 侧 `aclrtMemcpy` 在同一 stream 上按序完成）。
// 负向对照：`M15_PLE_STATECARRY=0` ⇒ 本函数不执行，下一 step 的 stIn 仍是初值 ⇒ `Pw.step2.*` 变红。
static bool H_PleCarryState(Ctx& C, const char* tag)
{
    const uint32_t slots = M15L_ACT_STATE_SLOTS(C.O.pleNReq, M15L::PLEW::T_MAX);
    const size_t bytes = static_cast<size_t>(slots) * M15L::PLEW::STLEN * M15L::PLEW::HYPER * 2u;
    void* dst = H_PlePlane(C, M15L::PLEW::S_STIN);
    const void* src = H_PlePlane(C, M15L::PLEW::S_STOUT);
    const aclError e = aclrtMemcpy(dst, bytes, src, bytes, ACL_MEMCPY_DEVICE_TO_DEVICE);
    if (e != ACL_SUCCESS) {
        printf("[m15][FAIL] D2D %s failed (err %d, %zu bytes)\n", tag, static_cast<int>(e), bytes);
        C.fails++;
        return false;
    }
    return true;
}

// host 侧独立参考 ①（T=1、单请求、c=0）：语义与算术逐条来自 `ple/PLE_SPEC.md §4.1 ①`
static int64_t H_PleRefIdsOne(uint32_t t, uint32_t nTok, const std::vector<int32_t>& idsIn,
                              const std::vector<int32_t>& ctx, const int64_t* M3, const int64_t* sz,
                              const int64_t* of, uint32_t g)
{
    const uint32_t NC2 = 2;
    const int64_t EOSv = 248044;
    const uint32_t r = 0;                                        // 单请求
    const uint32_t c = t;                                        // qsl[0] = 0 ⇒ c = t
    const int64_t cur = idsIn[t];
    const int64_t p1 = (c >= 1) ? static_cast<int64_t>(idsIn[t - 1])
                                : static_cast<int64_t>(ctx[r * NC2 + (NC2 - 1 + c)]);
    const int64_t p2raw = (c >= 2) ? static_cast<int64_t>(idsIn[t - 2])
                                   : static_cast<int64_t>(ctx[r * NC2 + (NC2 - 2 + c)]);
    const int64_t p2 = (p1 == EOSv) ? EOSv : p2raw;               // EOS 回退（"crossed" 累计位）
    const uint32_t order = g / M85P::P + 2u;
    uint64_t mixed = static_cast<uint64_t>(cur) * static_cast<uint64_t>(M3[0]);
    if (order > 1u) {
        mixed ^= (static_cast<uint64_t>(p1) * static_cast<uint64_t>(M3[1]));
    }
    if (order > 2u) {
        mixed ^= (static_cast<uint64_t>(p2) * static_cast<uint64_t>(M3[2]));
    }
    const int64_t mixedS = static_cast<int64_t>(mixed);           // int64 回绕（与 device 一致）
    const int64_t d = sz[g];
    int64_t rem = mixedS % d;
    if (rem < 0) {
        rem += d;
    }
    (void)nTok;
    return rem + of[g];
}

// 窗口准备：从真实分片的**真实行区间**搬进匿名窗口 → 一次注册 → 拿 device 指针（M92 §5.2）
static bool H_PleWindowSetup(Ctx& C)
{
    char role[64];
    snprintf(role, sizeof(role), "ple_tbl_shard_%03u", C.O.pleShard);
    const M15Tensor* T = H_FindTensor(C.M, C.O.pleLayer, role);
    if (T == nullptr) {
        printf("[m15][FAIL] plewire：manifest 里没有 %s（层 %u）\n", role, C.O.pleLayer);
        C.fails++;
        return false;
    }
    const uint64_t shardRows = T->rows;
    const uint64_t base = C.O.pleWinBase;
    const uint64_t rows = C.O.pleWinRows;
    if (rows == 0u || base + rows > shardRows) {
        printf("[m15][FAIL] plewire：窗口 [%llu,%llu) 越出分片 %u 的 %llu 行\n",
               static_cast<unsigned long long>(base), static_cast<unsigned long long>(base + rows),
               C.O.pleShard, static_cast<unsigned long long>(shardRows));
        C.fails++;
        return false;
    }
    const size_t rowBytes = static_cast<size_t>(M15L::PLEW::HDIM) * 2u;   // 320 B
    const size_t bytes = static_cast<size_t>(rows) * rowBytes;
    std::vector<uint8_t> hostWin(bytes);
    {
        const std::string path = C.M.modelDir + "/" + T->file;
        FILE* f = fopen(path.c_str(), "rb");
        if (f == nullptr) {
            printf("[m15][FAIL] plewire：打不开 %s\n", path.c_str());
            C.fails++;
            return false;
        }
        if (fseek(f, static_cast<long>(T->offset + base * rowBytes), SEEK_SET) != 0) {
            fclose(f);
            C.fails++;
            return false;
        }
        const size_t got = fread(hostWin.data(), 1, bytes, f);
        fclose(f);
        if (got != bytes) {
            printf("[m15][FAIL] plewire：短读 %zu/%zu（%s）\n", got, bytes, path.c_str());
            C.fails++;
            return false;
        }
    }
    void* win = ::mmap(nullptr, bytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
    if (win == MAP_FAILED) {
        printf("[m15][FAIL] plewire：mmap(anon) 失败\n");
        C.fails++;
        return false;
    }
    __builtin_memcpy(win, hostWin.data(), bytes);
    const aclError hr = aclrtHostRegisterV2(win, bytes, ACL_HOST_REG_MAPPED);
    void* dev = nullptr;
    const aclError gr = (hr == ACL_SUCCESS) ? aclrtHostGetDevicePointer(win, &dev, 0) : (aclError)-1;
    if (hr != ACL_SUCCESS || gr != ACL_SUCCESS || dev == nullptr) {
        printf("[m15][FAIL] plewire：主机内存注册失败 rc=%d/%d\n", static_cast<int>(hr), static_cast<int>(gr));
        ::munmap(win, bytes);
        C.fails++;
        return false;
    }
    C.pleTableHost = win;
    C.pleTableDev = dev;
    C.pleTableBytes = bytes;
    C.pleTableFile = T->file;
    C.pleTableOff = T->offset + base * rowBytes;
    C.pleWinHost = hostWin;                 // host 侧同一批字节（② 判据的比对源）
    C.O.pleWinBase = static_cast<uint32_t>(C.O.pleShard * shardRows + base);
    printf("[m15]   PLE 窗口：shard %u 行 [%llu,%llu) = %.2f MiB（%s @ %llu）→ host 注册 rc=%d、"
           "device=%p；winBase=%u winRows=%llu\n",
           C.O.pleShard, static_cast<unsigned long long>(base),
           static_cast<unsigned long long>(base + rows), static_cast<double>(bytes) / 1048576.0,
           T->file.c_str(), static_cast<unsigned long long>(C.pleTableOff), static_cast<int>(hr), dev,
           C.O.pleWinBase, static_cast<unsigned long long>(rows));
    return true;
}

static bool H_PleWireRun(Ctx& C);

// 一次链跑（层 0..1）——**接线开**时层 `pleLayer` 走 PLE 段；关时同一条断点结构上空操作。
// 返回该层的入口多流态（`ws0+WS_HCP`：PLE 直接改的那块 10240 态）与层出口。
static bool H_PleChainOnce(Ctx& C, PleRunOut& O)
{
    using namespace M15G;
    const uint32_t m = 1;
    const uint32_t hyb = m * M15H::HYPER * 2u;
    std::vector<uint8_t> hin(static_cast<size_t>(M15H::M_MAX) * M15H::HYPER * 2u, 0);
    {
        const uint16_t* h0 = C.h0[0].data();
        for (uint32_t s = 0; s < M15H::HC; ++s) {
            __builtin_memcpy(hin.data() + static_cast<size_t>(s) * HIDDEN * 2u, h0, HIDDEN * 2u);
        }
    }
    std::vector<ChLayerRec> rec;
    std::vector<uint8_t> mh(hyb), sh(m * HIDDEN * 2u);
    if (!H_ChRunOnce(C, hin, m, true, rec, mh, sh)) {
        return false;
    }
    const ChLayerRec& R = rec[C.O.pleLayer];
    O.hcp = R.b1.hcp;
    O.hout = R.hOut;
    H_PleReadBack(C, m, O);
    return true;
}

static bool H_PleWireRun(Ctx& C)
{
    using namespace M15G;
    const uint32_t L = C.O.pleLayer;
    printf("\n[m15] ===== 验证 Pw：PLE 段接进融合 kernel 的**真实挂接路径**（层 %u）=====\n", L);
    printf("[m15]   段序：hc(H1a combine-only) → ①ids → PLE_IN barrier → ②③④⑤ → PLE_OUT barrier → "
           "hc(H1b mix-only) → 子层段 → hc(H2) → MoE\n");
    printf("[m15]   M15_PLE_WIRE=%u（0 = 接线关：同一断点结构上空操作）M15_PLE_LAYER=%u "
           "M15_PLE_VOCAB=%s M15_PLE_STAGE=0x%X M15_PLE_NEG=0x%X M15_PLE_MISWIRE=%u\n",
           C.O.pleWire, L, (C.O.pleVocabReal != 0u) ? "real" : "reduced", C.O.pleStageMask,
           C.O.pleNegMask, C.O.pleMiswire);
    const uint32_t checkBase = C.checks;
    const uint32_t failBase = C.fails;
    C.O.nLayers = (L + 1u < 2u) ? 2u : (L + 1u);
    C.O.chainPle = 1u;

    // ---- 1. 权重：key/value/conv/norm + 3 个 int64 → 权重 slab（与 device 同一批 PLEW 常量）----
    auto loadRole = [&](const char* role, std::vector<uint8_t>& dst) {
        const M15Tensor* T = H_FindTensor(C.M, L, role);
        if (T == nullptr) {
            printf("[m15][FAIL] plewire：manifest 缺 role=%s（层 %u）\n", role, L);
            return false;
        }
        std::string err;
        if (!H_ReadTensor(C.M, *T, dst, err)) {
            printf("[m15][FAIL] plewire：读 %s 失败：%s\n", role, err.c_str());
            return false;
        }
        return true;
    };
    std::vector<uint8_t> key, val, conv, nk, nq, ncw, lmRaw, szRaw, ofRaw;
    if (!loadRole("ple_key_proj", key) || !loadRole("ple_value_proj", val) ||
        !loadRole("ple_conv1d", conv) || !loadRole("ple_norm_key", nk) || !loadRole("ple_norm_query", nq) ||
        !loadRole("ple_norm_conv", ncw) || !loadRole("ple_lm", lmRaw) || !loadRole("ple_sz", szRaw) ||
        !loadRole("ple_of", ofRaw)) {
        C.fails++;
        return false;
    }
    if (key.size() != static_cast<size_t>(M15L::PLEW::KVW - M15L::PLEW::HID) * M15L::PLEW::HID * 2u ||
        val.size() != static_cast<size_t>(M15L::PLEW::HID) * M15L::PLEW::HID * 2u ||
        conv.size() != static_cast<size_t>(M15L::PLEW::HYPER) * 4u * 2u || lmRaw.size() != 24u ||
        szRaw.size() != 128u || ofRaw.size() != 128u) {
        printf("[m15][FAIL] plewire：权重字节数不符（key %zu val %zu conv %zu lm %zu sz %zu of %zu）\n",
               key.size(), val.size(), conv.size(), lmRaw.size(), szRaw.size(), ofRaw.size());
        C.fails++;
        return false;
    }
    std::vector<uint8_t> wslab(M15L::PLEW::W_BYTES, 0);
    // wcat = [key_proj ; value_proj]（checkpoint 无 kv_proj，PLE_SPEC D1 的顺序不可反）
    __builtin_memcpy(wslab.data() + M15L::PLEW::W_CAT, key.data(), key.size());
    __builtin_memcpy(wslab.data() + M15L::PLEW::W_CAT + key.size(), val.data(), val.size());
    // wtap[k][c] = conv1d[c][0][k]（checkpoint 是 [10240,1,4] 行主序）
    {
        const uint16_t* src = reinterpret_cast<const uint16_t*>(conv.data());
        uint16_t* dst = reinterpret_cast<uint16_t*>(wslab.data() + M15L::PLEW::W_TAP);
        for (uint32_t c = 0; c < M15L::PLEW::HYPER; ++c) {
            for (uint32_t k = 0; k < 4u; ++k) {
                dst[k * M15L::PLEW::HYPER + c] = src[c * 4u + k];
            }
        }
    }
    __builtin_memcpy(wslab.data() + M15L::PLEW::W_NK, nk.data(), nk.size());
    __builtin_memcpy(wslab.data() + M15L::PLEW::W_NQ, nq.data(), nq.size());
    __builtin_memcpy(wslab.data() + M15L::PLEW::W_NCW, ncw.data(), ncw.size());
    H_H2D(C, C.pleWDev, wslab.data(), wslab.size(), "ple_w");

    // ---- 2. ① 的标量 buffer：real = checkpoint 原值；reduced = 缩减词表（让 id 落进窗口）----
    std::vector<int64_t> sz(16), of(16), M3(3);
    __builtin_memcpy(M3.data(), lmRaw.data(), 24);
    if (C.O.pleVocabReal != 0u) {
        __builtin_memcpy(sz.data(), szRaw.data(), 128);
        __builtin_memcpy(of.data(), ofRaw.data(), 128);
    } else {
        for (uint32_t g = 0; g < 16u; ++g) {
            sz[g] = C.O.pleReduced;
            of[g] = static_cast<int64_t>(g) * C.O.pleReduced;
        }
    }
    H_H2D(C, C.pleMDev, M3.data(), 24, "ple_m");
    H_H2D(C, C.pleSzDev, sz.data(), 128, "ple_sz");
    H_H2D(C, C.pleOfDev, of.data(), 128, "ple_of");

    // ---- 3. ids / qsl / ctx（单请求、T 个 token、c=0 起）----
    const uint32_t T = C.O.pleTok;
    std::vector<int32_t> idsIn(T), qsl(2), ctx(2);
    for (uint32_t t = 0; t < T; ++t) {
        idsIn[t] = static_cast<int32_t>(C.O.pleToken + t);
    }
    qsl[0] = 0;
    qsl[1] = static_cast<int32_t>(T);
    ctx[0] = 248044;   // computed-2（不足 ⇒ EOS）
    ctx[1] = 248044;   // computed-1
    H_H2D(C, C.pleIdsDev, idsIn.data(), T * 4u, "ple_ids_in");
    H_H2D(C, C.pleQslDev, qsl.data(), 8u, "ple_qsl");
    H_H2D(C, C.pleCtxDev, ctx.data(), 8u, "ple_ctx");

    // ---- 4. 窗口（host-mapped；M92 §5.2 的 ACL 链路）----
    if (!H_PleWindowSetup(C)) {
        return false;
    }
    // scratch 清零（免得上一档的残留让「非空洞」判据假绿）
    {
        std::vector<uint8_t> zero(M15L::PLEW::S_BYTES, 0);
        H_H2D(C, C.pleScrDev, zero.data(), zero.size(), "ple_scr_zero");
    }

    // ---- 4b. host 侧独立参考 ①（判据 & 无 ① 档的 ids 源）+ 设备侧期望行（`exp64`）----
    // `exp64` 从**分片文件**（不经窗口）读回，是 M92 §6.2 的「设备自己比一遍行」那条判据的输入。
    std::vector<int64_t> refIds(static_cast<size_t>(T) * 16u);
    for (uint32_t t = 0; t < T; ++t) {
        for (uint32_t g = 0; g < 16u; ++g) {
            refIds[static_cast<size_t>(t) * 16u + g] =
                H_PleRefIdsOne(t, T, idsIn, ctx, M3.data(), sz.data(), of.data(), g);
        }
    }
    {
        std::vector<int32_t> sidx(T, 0);
        H_H2D(C, H_PlePlane(C, M15L::PLEW::S_SIDX), sidx.data(), T * 4u, "ple_sidx");
    }
    {
        // exp64[idx*VL + j] = 该 idx 那一行在**分片文件**里的前 VL 个 bf16（id 越窗则填 0）
        std::vector<uint16_t> exp(static_cast<size_t>(T) * 16u * M15L::PLEW::VL, 0);
        const uint64_t winBase = C.O.pleWinBase;
        for (uint32_t t = 0; t < T; ++t) {
            for (uint32_t g = 0; g < 16u; ++g) {
                const int64_t id = refIds[static_cast<size_t>(t) * 16u + g];
                if (id < static_cast<int64_t>(winBase) ||
                    id >= static_cast<int64_t>(winBase + C.O.pleWinRows)) {
                    continue;
                }
                const size_t off = static_cast<size_t>(id - winBase) * M15L::PLEW::HDIM;
                for (uint32_t j = 0; j < M15L::PLEW::VL; ++j) {
                    exp[(static_cast<size_t>(t) * 16u + g) * M15L::PLEW::VL + j] =
                        reinterpret_cast<const uint16_t*>(C.pleWinHost.data())[off + j];
                }
            }
        }
        H_H2D(C, H_PlePlane(C, M15L::PLEW::S_EXP64), exp.data(), exp.size() * 2u, "ple_exp64");
    }
    if ((C.O.pleStageMask & M15L::PLEW::ST_IDS) == 0u) {
        // 「② 独跑」档：① 关，ids 由 host 参考给出（用来把「①→② 的落盘可见性」与「② 的取行」分开）
        H_H2D(C, H_PlePlane(C, M15L::PLEW::S_IDS), refIds.data(), refIds.size() * 8u, "ple_ids_ref");
        printf("[m15]   [档] M15_PLE_STAGE 不含 ① ⇒ ids 由 host 参考直接灌入 S_IDS（② 独跑）\n");
    }

    // ---- 5. 三次链跑：A = 接线开；B = 接线关（同一断点结构上空操作）；C = 接线开（确定性）----
    const uint32_t wireSave = C.O.pleWire;
    PleRunOut B;
    C.O.pleWire = 0u;
    if (!H_PleChainOnce(C, B)) {
        return false;
    }
    C.O.pleWire = wireSave;
    PleRunOut A1, A2;
    if (!H_PleChainOnce(C, A1)) {
        return false;
    }
    if (!H_PleChainOnce(C, A2)) {
        return false;
    }

    // ---- 5b. M191：**跨 step 状态承接** —— A2 = 第 1 步结束（stIn 仍是初值 ⇒ A1/A2 读到同一
    //      初值，确定性判据不受影响）→ 搬运 `S_STOUT → S_STIN` → A3 = 第 2 步（stIn = A2 的 stOut）。
    //      负向对照 `M15_PLE_STATECARRY=0` 跳过搬运 ⇒ A3 的 stIn 仍是初值 ⇒ `Pw.step2.*` 变红。
    if (C.O.pleStateCarry != 0u) {
        if (!H_PleCarryState(C, "ple_state_carry")) {
            return false;
        }
    }
    PleRunOut A3;
    if (!H_PleChainOnce(C, A3)) {
        return false;
    }

    // ---- 6. 判据 ----
    bool ok = true;
    char tag[96];
    auto count = [&](bool pass, const char* name, const char* detail) {
        C.checks++;
        if (pass) {
            printf("[m15]   %-30s PASS %s\n", name, detail);
        } else {
            C.fails++;
            ok = false;
            printf("[m15]   %-30s FAIL %s\n", name, detail);
        }
    };
    // (1) 非空洞性：接线真的改了 10240 宽的多流态
    count(__builtin_memcmp(A1.hcp.data(), B.hcp.data(), A1.hcp.size()) != 0, "Pw.wired.nonvac",
          "层入口多流态（ws0+WS_HCP）接线开 ≠ 关");
    snprintf(tag, sizeof(tag), "Pw.wired.finite");
    ok = H_CmpFiniteBf16(C, tag, A1.hcp.data(), static_cast<uint32_t>(A1.hcp.size())) && ok;
    // (2) ① ids：device vs host 独立参考（T1 逐位）
    {
        const int64_t* devIds = reinterpret_cast<const int64_t*>(A1.ids.data());
        uint32_t bad = 0;
        for (uint32_t t = 0; t < T; ++t) {
            for (uint32_t g = 0; g < 16u; ++g) {
                const int64_t want = H_PleRefIdsOne(t, T, idsIn, ctx, M3.data(), sz.data(), of.data(), g);
                if (devIds[t * 16u + g] != want) {
                    bad++;
                }
            }
        }
        snprintf(tag, sizeof(tag), "bad=%u/%u", bad, T * 16u);
        count(bad == 0u, "Pw.ids.T1", tag);
    }
    // (3) ② gather：device 的 16 行 emb 与 host 从**同一窗口**读回的字节逐字节相同（T1 逐字节）
    {
        const uint8_t* devEmb = A1.emb.data();
        const int64_t* devIds = reinterpret_cast<const int64_t*>(A1.ids.data());
        uint32_t bad = 0, miss = 0;
        for (uint32_t t = 0; t < T; ++t) {
            for (uint32_t g = 0; g < 16u; ++g) {
                const int64_t id = devIds[t * 16u + g];
                const int64_t row = id - static_cast<int64_t>(C.O.pleWinBase);
                if (row < 0 || row >= static_cast<int64_t>(C.O.pleWinRows)) {
                    miss++;
                    continue;
                }
                const uint8_t* want = C.pleWinHost.data() +
                                      static_cast<size_t>(row) * M15L::PLEW::HDIM * 2u;
                const uint8_t* got = devEmb + (static_cast<size_t>(t) * 16u + g) * M15L::PLEW::HDIM * 2u;
                if (__builtin_memcmp(want, got, M15L::PLEW::HDIM * 2u) != 0) {
                    bad++;
                }
            }
        }
        snprintf(tag, sizeof(tag), "bad=%u miss=%u/%u", bad, miss, T * 16u);
        count(bad == 0u && miss == 0u, "Pw.emb.T1", tag);
        // `M15_PLE_DBG=1` 的逐 item 诊断（**已入库**；U-A 的定位读数就是它产出的，见
        // evidence/ple_wire/WITNESS.md §4）：打印每个 item 的 id、窗口行号与前 4 个 bf16，
        // 与 host 从同一窗口读回的期望并排，用来把「①→② 的交接」与「② 的取行」分开。
        if (getenv("M15_PLE_DBG") != nullptr) {
            for (uint32_t g = 0; g < 16u; ++g) {
                const int64_t id = devIds[g];
                const int64_t row = id - static_cast<int64_t>(C.O.pleWinBase);
                const uint16_t* got = reinterpret_cast<const uint16_t*>(devEmb + static_cast<size_t>(g) * M15L::PLEW::HDIM * 2u);
                const uint16_t* want = reinterpret_cast<const uint16_t*>(
                    C.pleWinHost.data() + static_cast<size_t>(row) * M15L::PLEW::HDIM * 2u);
                printf("[dbg] g=%2u id=%6lld row=%6lld got=%04x %04x %04x %04x want=%04x %04x %04x %04x\n",
                       g, static_cast<long long>(id), static_cast<long long>(row), got[0], got[1], got[2],
                       got[3], want[0], want[1], want[2], want[3]);
            }
        }
    }
    // (3b) M124：**③ 的 kv 数值判据**（`Pw.kv.T3`）—— 层路径上「③ 真的被生产出来、而且值对」的判据。
    //   为什么要有它：`Pw.planes.nonvac` / `Pw.wired.finite` 判不了 kv 的**数值**（kv 全垃圾也
    //   "非常量、有限"）；`Pw.wired.delta` 只能证明「PLE 改动了多流态」（错但非零的 kv 照样非零）。
    //   **参考完全取自 host**（`docs/17 §1.3`）：窗口字节 `C.pleWinHost` + **host 的 ids 参考** `refIds`
    //   （与 `Pw.ids.T1` 用的是同一份）重建 `emb_ref`，再与 host 侧 `wcat`（`wslab` 的 `W_CAT` 段 ——
    //   与设备读的是同一批字节）在 **double** 下点乘。**不取任何设备产物当参考**。
    //   档位 = **T3**（`docs/17 §1.1` 触发条件③「含 mmad / cube 累加」），界 = `ε·Σ|terms| + 1.0·ulp(out)`，
    //   `ε = k·2^-24`（k = HE = 2560）—— 与独立 kernel 的 `m15_ple_check.py::B3.kv` 同一条推导式。
    //   只判「该 token 的 16 个 head 全在窗口内」的行（其余行的 emb 里有未落盘的 head，host 无法重建参考）。
    {
        const uint32_t HEw = M15L::PLEW::HID;
        const uint32_t KVWw = M15L::PLEW::KVW;
        const double epsKv = 2560.0 * std::pow(2.0, -24.0);
        const uint16_t* wcat = reinterpret_cast<const uint16_t*>(wslab.data() + M15L::PLEW::W_CAT);
        const uint16_t* win = reinterpret_cast<const uint16_t*>(C.pleWinHost.data());
        const uint16_t* devKv = reinterpret_cast<const uint16_t*>(A1.kv.data());
        std::vector<double> embRef(static_cast<size_t>(T) * HEw, 0.0);
        std::vector<uint8_t> tokIn(T, 0u);
        uint32_t nTokIn = 0u;
        for (uint32_t t = 0; t < T; ++t) {
            bool allIn = true;
            for (uint32_t g = 0; g < 16u && allIn; ++g) {
                const int64_t row = refIds[static_cast<size_t>(t) * 16u + g] -
                                    static_cast<int64_t>(C.O.pleWinBase);
                if (row < 0 || row >= static_cast<int64_t>(C.O.pleWinRows)) {
                    allIn = false;
                }
            }
            if (!allIn) {
                continue;
            }
            tokIn[t] = 1u;
            nTokIn++;
            for (uint32_t g = 0; g < 16u; ++g) {
                const size_t row = static_cast<size_t>(refIds[static_cast<size_t>(t) * 16u + g] -
                                                       static_cast<int64_t>(C.O.pleWinBase));
                for (uint32_t j = 0; j < M15L::PLEW::HDIM; ++j) {
                    embRef[static_cast<size_t>(t) * HEw + static_cast<size_t>(g) * M15L::PLEW::HDIM + j] =
                        static_cast<double>(H_Bf16ToF32(win[row * M15L::PLEW::HDIM + j]));
                }
            }
        }
        uint64_t nCmp = 0u, nBad = 0u, nRefNz = 0u, nIdent = 0u;
        double maxAbs = 0.0, maxRatio = 0.0;
        for (uint32_t t = 0; t < T; ++t) {
            if (tokIn[t] == 0u) {
                continue;
            }
            for (uint32_t j = 0; j < KVWw; ++j) {
                const uint16_t* wrow = wcat + static_cast<size_t>(j) * HEw;
                double acc = 0.0, terms = 0.0;
                for (uint32_t k = 0; k < HEw; ++k) {
                    const double wv = static_cast<double>(H_Bf16ToF32(wrow[k]));
                    const double ev = embRef[static_cast<size_t>(t) * HEw + k];
                    acc += wv * ev;
                    terms += std::fabs(wv * ev);
                }
                const double got = static_cast<double>(H_Bf16ToF32(devKv[static_cast<size_t>(t) * KVWw + j]));
                const double d = std::fabs(got - acc);
                // 1.0·ulp(out)：参考（与设备输出）都已量化到 bf16 格点，格点对格点的最大合法差就是 1 ulp
                const double mag = std::max(std::fabs(got), std::fabs(acc));
                const double ulp = (mag > 0.0) ? std::pow(2.0, std::floor(std::log2(mag)) - 7.0) : 0.0;
                if (d > epsKv * terms + ulp) {
                    nBad++;
                }
                if (d > maxAbs) {
                    maxAbs = d;
                }
                const double r = d / std::max(std::fabs(acc), 1e-30);
                if (r > maxRatio) {
                    maxRatio = r;
                }
                if (acc != 0.0) {
                    nRefNz++;
                }
                if (got == acc) {
                    nIdent++;
                }
                nCmp++;
            }
        }
        char tag[256];
        snprintf(tag, sizeof(tag),
                 "T3 ε=k·2^-24(k=2560)=%.3g：n=%llu bad=%llu maxAbs=%.3g maxRel=%.3g 逐位=%llu/%llu；"
                 "参与行=%u/%u（16 head 全在窗口内的 token）",
                 epsKv, static_cast<unsigned long long>(nCmp), static_cast<unsigned long long>(nBad), maxAbs,
                 maxRatio, static_cast<unsigned long long>(nIdent),
                 static_cast<unsigned long long>(nCmp), nTokIn, T);
        count(nBad == 0u && nCmp > 0u, "Pw.kv.T3", tag);
        snprintf(tag, sizeof(tag),
                 "参照面非零元素=%llu/%llu；参与行=%u/%u；窗口内 token=%u",
                 static_cast<unsigned long long>(nRefNz), static_cast<unsigned long long>(nCmp), nTokIn, T,
                 nTokIn);
        count(nTokIn > 0u && nCmp > 0u && nRefNz > 0u, "Pw.kv.nonvac", tag);
    }
    // (4) 设备侧计数（M92 的 `Hd.row_fail` / `Hd.miss`）在**这条路径上**仍成立
    {
        const float* hm = reinterpret_cast<const float*>(A1.hmbad.data());
        uint32_t rowFail = 0, miss = 0, cores = 0, nonvac = 0;
        for (uint32_t b = 0; b < M15L::PLEW::FAIL_SLOTS; ++b) {
            rowFail += static_cast<uint32_t>(hm[b * 8u + 0u]);
            miss += static_cast<uint32_t>(hm[b * 8u + 1u]);
            if (hm[b * 8u + 2u] > 0.0f) {
                cores++;
            }
            if (hm[b * 8u + 3u] > 0.0f) {
                nonvac++;
            }
        }
        snprintf(tag, sizeof(tag), "row_fail=%u miss=%u 非空洞核=%u 见窗核=%u", rowFail, miss, cores, nonvac);
        count(rowFail == 0u && miss == 0u && cores > 0u, "Pw.win.dev", tag);
        const uint32_t* fi = reinterpret_cast<const uint32_t*>(A1.faili.data());
        const uint32_t* fb = reinterpret_cast<const uint32_t*>(A1.failb.data());
        uint32_t si = 0, sb = 0;
        for (uint32_t b = 0; b < M15L::PLEW::FAIL_SLOTS; ++b) {
            si += fi[b];
            sb += fb[b];
        }
        snprintf(tag, sizeof(tag), "① 值域坏 id=%u、②③④⑤ 坏值=%u", si, sb);
        count(si == 0u && sb == 0u, "Pw.fail", tag);
    }
    // (5) conv 状态：演化非空洞（T4）+ 移位逐字节（T1：new[i]=old[i+1]、new[8]=当前卷积输入）
    // M191：移位判据提成 lambda ⇒ 单步（A1，既有读数不变）与跨 step（A2→A3）复用同一段逻辑。
    auto stateShiftOk = [](const std::vector<uint8_t>& in, const std::vector<uint8_t>& out,
                           const std::vector<uint8_t>& normed) -> bool {
        const size_t hb = M15L::PLEW::HYPER * 2u;
        for (uint32_t h = 0; h + 1u < M15L::PLEW::STLEN; ++h) {
            if (__builtin_memcmp(out.data() + static_cast<size_t>(h) * hb,
                                 in.data() + static_cast<size_t>(h + 1u) * hb, hb) != 0) {
                return false;
            }
        }
        return __builtin_memcmp(out.data() + static_cast<size_t>(M15L::PLEW::STLEN - 1u) * hb,
                                normed.data(), hb) == 0;
    };
    {
        const size_t stBytes = static_cast<size_t>(M15L::PLEW::STLEN) * M15L::PLEW::HYPER * 2u;
        count(A1.stout.size() == stBytes && __builtin_memcmp(A1.stout.data(), A1.stin.data(), stBytes) != 0,
              "Pw.state.evolve", "状态输出 ≠ 输入（活跃行确实演化）");
        count(stateShiftOk(A1.stin, A1.stout, A1.normed), "Pw.state.shift",
              "new[i]=old[i+1] 且 new[8]=normed 逐字节");
    }
    // (5b) M191：**跨 step 状态承接**（两 step 连跑；A2 = 第 1 步、A3 = 第 2 步，其间搬
    //      `S_STOUT → S_STIN`）。判据三条：
    //      · `Pw.step2.carry`  —— 第 2 步的 stIn 逐字节等于第 1 步的 stOut（承接保真；不搬 ⇒ 红）
    //      · `Pw.step2.evolve` —— 第 2 步结束状态 ≠ 第 1 步结束状态（跨 step 演化非空洞；不搬 ⇒ 红）
    //      · `Pw.step2.shift`  —— 第 2 步仍满足移位关系（复用上面的同一段逻辑）
    //      注：**多流态激活**（hcp）在本判据的 2 步跨度内**不变**——⑤ 的膨胀卷积 tap 只读状态行
    //      0/3/6（lag 9/6/3，见 `M85P::PleConvItem` 的 for-k 段），初始状态为零 ⇒ 首个 tap 要到
    //      第 4 步才非零。故跨 step 承接的判据落在**状态平面**上（这正是每 step 要承接的量），
    //      而不是激活平面。
    {
        const size_t stBytes = static_cast<size_t>(M15L::PLEW::STLEN) * M15L::PLEW::HYPER * 2u;
        size_t carryEq = 0, evolveDiff = 0;
        const bool carrySz = (A2.stout.size() == stBytes) && (A3.stin.size() == stBytes);
        const bool evoSz = (A3.stout.size() == stBytes) && (A2.stout.size() == stBytes);
        if (carrySz) {
            for (size_t i = 0; i < stBytes; ++i) {
                if (A3.stin[i] == A2.stout[i]) {
                    carryEq++;
                }
            }
        }
        if (evoSz) {
            for (size_t i = 0; i < stBytes; ++i) {
                if (A3.stout[i] != A2.stout[i]) {
                    evolveDiff++;
                }
            }
        }
        char d1[160];
        snprintf(d1, sizeof(d1), "第 2 步 stIn == 第 1 步 stOut：%zu/%zu 字节（活槽=%u、M15_PLE_STATECARRY=%u）",
                 carryEq, stBytes, (C.O.pleNReq != 0u) ? C.O.pleNReq : 1u, C.O.pleStateCarry);
        count(carrySz && carryEq == stBytes, "Pw.step2.carry", d1);
        char d2[160];
        snprintf(d2, sizeof(d2), "第 2 步结束状态 vs 第 1 步：差 %zu/%zu 字节", evolveDiff, stBytes);
        count(evoSz && evolveDiff != 0u, "Pw.step2.evolve", d2);
        count(A3.stout.size() == stBytes && A3.stin.size() == stBytes &&
                  stateShiftOk(A3.stin, A3.stout, A3.normed),
              "Pw.step2.shift", "第 2 步 new[i]=old[i+1] 且 new[8]=normed 逐字节");
    }
    // (6) 非空洞：gated / normed / kv 平面都被写出且非常量
    {
        auto nonconst = [](const std::vector<uint8_t>& v) {
            if (v.size() < 4u) {
                return false;
            }
            for (size_t i = 2; i < v.size(); i += 2) {
                if (__builtin_memcmp(v.data() + i, v.data(), 2u) != 0) {
                    return true;
                }
            }
            return false;
        };
        count(nonconst(A1.gated) && nonconst(A1.normed), "Pw.planes.nonvac", "gated/normed 非常量");
    }
    // (7) 确定性：同配置重跑，产物逐字节相同
    // **受判项与判据口径不变**（还是 ids/emb/hcp/stout/hmbad/failb 六项逐字节）；只是把
    // detail 改成**点名不相等的项** —— `E_miswire_winbase` 档出现过 run-to-run 跳变（同一二进制、
    // 同一 env，`Pw.det` 偶发红，见 WITNESS.md §3），当时 detail 只有一句"逐字节相同"，
    // 无法判断是哪一项在抖。下次再出现，这条 detail 直接给答案。
    {
        struct DetItem {
            const char* name;
            const std::vector<uint8_t>* a;
            const std::vector<uint8_t>* b;
        };
        const DetItem items[] = {{"ids", &A1.ids, &A2.ids},     {"emb", &A1.emb, &A2.emb},
                                 {"hcp", &A1.hcp, &A2.hcp},     {"stout", &A1.stout, &A2.stout},
                                 {"hmbad", &A1.hmbad, &A2.hmbad}, {"failb", &A1.failb, &A2.failb}};
        std::string diffItems;
        for (const DetItem& it : items) {
            if (*it.a != *it.b) {
                if (!diffItems.empty()) {
                    diffItems += ",";
                }
                diffItems += it.name;
            }
        }
        const bool det = diffItems.empty();
        char detDetail[160];
        if (det) {
            snprintf(detDetail, sizeof(detDetail), "两次接线跑逐字节相同（六项：ids/emb/hcp/stout/hmbad/failb）");
        } else {
            snprintf(detDetail, sizeof(detDetail), "两次接线跑**不等于**：不相等的项 = %s", diffItems.c_str());
        }
        count(det, "Pw.det", detDetail);
    }
    // (8) 读数：PLE 改了多少
    {
        const uint16_t* pa = reinterpret_cast<const uint16_t*>(A1.hcp.data());
        const uint16_t* pb = reinterpret_cast<const uint16_t*>(B.hcp.data());
        uint32_t changed = 0;
        float maxAbs = 0.0f;
        for (size_t i = 0; i < A1.hcp.size() / 2u; ++i) {
            if (pa[i] != pb[i]) {
                changed++;
            }
            const float d = H_Bf16ToF32(pa[i]) - H_Bf16ToF32(pb[i]);
            const float ad = (d < 0.0f) ? -d : d;
            if (ad > maxAbs) {
                maxAbs = ad;
            }
        }
        printf("[m15]   Pw.wired.delta           读数：%u/%zu 个 bf16 元素被 PLE 改动，max|Δ| = %.6g\n", changed,
               A1.hcp.size() / 2u, static_cast<double>(maxAbs));
    }
    C.O.pleWire = wireSave;
    C.phasePw = C.checks - checkBase;
    printf("[m15] 验证 Pw：判定项 %u 条 / FAIL %u 条（累计 checks %u / fails %u）\n", C.phasePw,
           C.fails - failBase, C.checks, C.fails);
    return ok && (C.fails == failBase);
}

static void H_Cleanup(Ctx& C)
{
    for (void* p : {C.wsDev, C.wsDirectDev, C.wDev, C.stDev, C.hDev[0], C.hDev[1], C.resZeroDev, C.xDirectDev,
                    C.yDirectDev, C.csDirectDev, C.ssmDirectDev, C.moeWDev, C.wsFusedDev, C.wsGdnDev, C.wsMoeDev,
                    C.xFusedDev, C.yFusedDev, C.ySubDev, C.xMoeDev, C.yMoeDev, C.hcWDev, C.hcWsDev, C.hcHDev,
                    C.hcBoDev, C.hcIjDev, C.hcAttnOutDev, C.chainBoDev, C.pleWDev, C.pleScrDev,
                    C.pleIdsDev, C.pleQslDev, C.pleCtxDev, C.pleMDev, C.pleSzDev, C.pleOfDev}) {
        if (p != nullptr) {
            aclrtFree(p);
        }
    }
    // M100：host-mapped 窗口要先解注册再 munmap
    if (C.pleTableHost != nullptr) {
        aclrtHostUnregister(C.pleTableHost);
        ::munmap(C.pleTableHost, C.pleTableBytes);
        C.pleTableHost = nullptr;
    }
}

// ============================================================
// 4h. M110：prefill 的**契约与挂载点档**（`runs=prefill`；**故意不进 `runs=all`**）
// ============================================================
// 走的是**真入口**：`m15_layer_resources.h` §6b 登记的两个 prefill 符号
// （`m15_layer_kernel_gdn_prefill` / `m15_layer_kernel_attn_prefill`），实参表 =
// `M15L_LAYER_PREFILL_ARGS_*`（基础 30 实参 + 13 个 prefill 项）。**不是探针、不是独立 kernel**。
//
// 本档证明四件事（**数学正确性不在其中** —— 段体未落地，这一点在判据的命名与打印里写死）：
//   ① **入口真的存在且能跑真 shape**：m ∈ {1, 4097}（人类原话「prefill 和decode都要照顾到，
//      测试m=1和4097」），x/y 平面按 4097 行定尺（20,976,640 B/面），一次搬完；
//   ② **行分派网格覆盖全部 m 行**（这是与 m=1 定尺的 `m15_attn_passthrough_body` 的关键差别：
//      后者每 AIV 固定 16 块、56 AIV 只够 5.6 行）：host 在 x 的**每行头 8 字节**写该行号
//      （u64 LE），y 预填毒值 0xA5；判据 = **逐行**标记命中 + **整面**逐字节相等
//      ⇒ 漏行 / 错行 / 错位都会红；
//   ③ **判据非空洞**：负向对照 `M15_PREFILL_MUTANT=1`（把行循环截到 `M15G::M_MAX`）⇒
//      必须恰有 (m − M_MAX) 行保持毒值（`docs/17 §4` 的非空洞性纪律）；
//   ④ **开关语义**：`M15_PREFILL_WIRE=1` ⇒ 进"段体挂载点"分支；段体未落地 ⇒ **什么都不写** ⇒
//      整面保持毒值（于是真实判据必然变红）。本档把它写成**正向断言**：
//      「m 行全是毒值」与「整面不与 x 相同」必须同时成立 —— 不许"开关开了却全绿"。
//
// **不判的事（显式划界）**：任何一个段的**数值正确性**（GDN / attention / MoE / hc 的段体都还没接）；
// 相位 H1/H2/B 的存在性（本 mission 的两个入口只有相位 A）；性能。
namespace M15Pf {

// 行标记：行号落在每行**头 8 字节**（u64 LE）。魔数只为可读性，判据只依赖行号那部分。
inline uint64_t H_PfRowTag(uint32_t row)
{
    return (static_cast<uint64_t>(0x5AFULL) << 40) | static_cast<uint64_t>(row);
}

// x 的确定性生成（无 rand 状态）：头 8 字节 = 行标记，其余 = 行号与字节位置的线性组合
inline void H_PfFillX(std::vector<uint8_t>& x, uint32_t m)
{
    const size_t rowBytes = M15L::PF::ROW_BYTES;
    x.assign(static_cast<size_t>(m) * rowBytes, 0u);
    for (uint32_t r = 0; r < m; ++r) {
        uint8_t* row = x.data() + static_cast<size_t>(r) * rowBytes;
        const uint64_t tag = H_PfRowTag(r);
        for (uint32_t b = 0; b < 8u; ++b) {
            row[b] = static_cast<uint8_t>((tag >> (8u * b)) & 0xFFu);
        }
        for (size_t i = 8u; i < rowBytes; ++i) {
            row[i] = static_cast<uint8_t>((r * 131u + static_cast<uint32_t>(i) * 7u) & 0xFFu);
        }
    }
}

struct PfJudge {
    uint32_t m = 0;
    uint32_t tagMiss = 0;      // 行标记不命中的行数
    uint32_t poisonRows = 0;   // **整行仍是毒值**的行数（= 从未被写过的行）
    uint32_t fullEqual = 0;    // y 与 x 逐字节相等的行数
    std::vector<uint32_t> firstOffenders;
};

inline PfJudge H_PfJudge(const std::vector<uint8_t>& x, const std::vector<uint8_t>& y, uint32_t m)
{
    PfJudge J;
    J.m = m;
    const size_t rowBytes = M15L::PF::ROW_BYTES;
    for (uint32_t r = 0; r < m; ++r) {
        const uint8_t* xr = x.data() + static_cast<size_t>(r) * rowBytes;
        const uint8_t* yr = y.data() + static_cast<size_t>(r) * rowBytes;
        const uint64_t tag = H_PfRowTag(r);
        bool tagOk = true;
        for (uint32_t b = 0; b < 8u; ++b) {
            if (yr[b] != static_cast<uint8_t>((tag >> (8u * b)) & 0xFFu)) {
                tagOk = false;
                break;
            }
        }
        if (!tagOk) {
            J.tagMiss++;
            if (J.firstOffenders.size() < 3u) {
                J.firstOffenders.push_back(r);
            }
        }
        bool allPoison = true;
        for (size_t i = 0; i < rowBytes; ++i) {
            if (yr[i] != 0xA5u) {
                allPoison = false;
                break;
            }
        }
        if (allPoison) {
            J.poisonRows++;
        }
        if (__builtin_memcmp(xr, yr, rowBytes) == 0) {
            J.fullEqual++;
        }
    }
    return J;
}

// 一个 arm：填 x → 毒 y → H2D → 起 prefill 入口 → D2H → 判
// ============================================================
// 4h-1. M136（Wave D）：prefill 入口的**实参对账表**（任务 1 的交付物）
// ============================================================
// 入口 = `m15_layer_kernel_gdn_prefill` / `m15_layer_kernel_attn_prefill`；实参表 =
// `M15L_LAYER_PREFILL_ARGS_*` = 基础 30（两相位）+ M110 的 13 + M132 段体的 13。
// 「现值」= M110/M132 时 H_PfArm 传的东西；「M136」= 本次 Wave D 的落点；「出处」= 取值权威。
//
//   参数（结构体字段）           现值(M110/M132)   M136 应填                            出处
//   ---------------------------  ----------------  ------------------------------------  -----------------------------
//   ws                           nil               pfMoeWsDev（WS_MOE_OFF+PWS_BYTES）    B4：mp.ws = A.ws + WS_MOE_OFF
//   xLayer / yLayer              pfXDev/pfYDev     pfXDev/pfYDev                         H_PfFillX 的行标记面
//   resLayer / resZero           nil / nil         resZeroDev（全零 bf16）               B4 S1 残差（MT*HIDDEN*2）
//   gamma1/gamma2/gammaG         nil               nil（相位 A 不吃）                    —
//   wIn/wOut/convW/…/dtBias      nil               nil（段体 B1 不吃；prolog 未接）      见「未接项」
//   convState                    nil               nil（无 P0–P3）                       —
//   ssmState                     nil               pfGdnStateDev（h0 入 / ht 出）        B1 状态（in-place）
//   moeRouter / moeSgate         nil               nil（B4 折进 routerWPad）             B4
//   moeWGu…moeSDnShd             nil               真实 MoE 权重槽（layer 0）            C.moeWDev（层槽 MOE_W_STRIDE）
//   moeGamma1 / moeGamma2        nil               真实槽（layer 0）                     C.moeWDev
//   m / topk                     m / 10            m / MOE_TOPK_PREFILL(=10)             人类口径 E=512/topk=10
//   pfKv/pfComp/pfRing/pfPack    nil               nil（KIND_GDN 不吃 KV）                —
//   pfPos                        pfPosDev          pfPosDev（第 r 行 = r）               pos 表
//   pfBlockTable/Counts/ExpertOffsets nil           nil（单请求恒等表；计数段内算）        —
//   pfPosBase / pfLayerK         0 / NONE          0 / PF_LAYER_K_NONE                    GDN 无 attention 序号
//   pfStageMask                  0（全开，nil 会崩） PF_STAGE_A（本轮只开相位 A）           见「能力边界」
//   pfWired / pfMutant           wired / 0         1（真段体）/ 0（mutant 档 = 1）       —
//   wsQ..wsBeta                  nil               pfGdnQ/K/V/G/BetaDev                  B1 的 6 个平面
//   wsO                          nil               pfGdnODev                             B1 出口 [48,m,128]
//   wsGdnPrefillScratch          nil               pfGdnScratchDev（nAic×GP_SLOT_BYTES） B1 段私有 scratch
//   pfMoeRouterWPad              nil               pfMoeRouterWPadDev（host 组板）       B4 唯一新字段
//   pfHcArena0/1, pfHcBlk0/1, pfHcIj0 nil           pfHc*Dev（已分配并传）                B5
//
// **未接项（逐条写明原因）**：
//   · `KIND_ATTN` 支：B2/B3 未接（B3/M101 未收敛）⇒ `M15_PREFILL_KIND=2|3` 在 wired=1 下判红。
//   · GDN 的 `wIn/wOut/convW/…`（in_proj / out_proj / conv1d / l2norm）：段体 B1 的输入契约就是
//     「已经过 prolog 的 q/k/v/g/β」（m23 `check_ref.py` 的边界声明）⇒ **本轮 q/k/v/g/β 由宿主合成**，
//     不是从真实 x 过 prolog 得到 ⇒ 数值判据覆盖到「扫描段」，不含 prolog。
//   · 四相位 H1/H2/B 的 hc 层界/权重：prefill 入口的实参表**没有** hc 字段（`M15L_LAYER_PREFILL_ARGS_*`
//     只有两相位基础 30 + 13 + 13）⇒ 本轮 GDN 只开相位 A（`pfStageMask = PF_STAGE_A`）；补全 hc 字段
//     与 B5 的实跑是后续 mission 的输入（见报告的对账）。
// ---- M136（Wave D）设备见证（真权重；`M15_LAYERS=1 M15_SKIP_WCHECK=1 M15_PREFILL_KIND=1 M15_PREFILL_WIRE=1`）----
// 设备槽：`flock -w 250 /tmp/npu0.lock`，进锁先 `npu-smi`，锁内 `timeout`（读数取到，未遇未取得读数的档）。
//   命令：`M15_PREFILL_M=<1|4097> M15_PREFILL_DUMPDIR=<dir> <bin> m15_layer_loop/weights_manifest.txt prefill`
//   m=1    rc=0：o 非有限 0、max|o|=2.1381e-02；ht 非有限 0、max|ht|=2.4824e-01；ALL PASS（checks=8, fails=0）
//   m=4097 rc=0：o 非有限 0、max|o|=6.7415e-02；ht 非有限 0、max|ht|=6.3126e-01；ALL PASS（checks=8, fails=0）
//   数值判据（m23 的 numpy float64 逐句参考，rtol 2e-3；参考从 dump 的干净输入复算）：
//     check_ref.py --dir <m=1 dir>    → `Pf.gdn PASS`（o 超界 0/6144；ht 超界 0/786432）
//     check_ref.py --dir <m=4097 dir> → `Pf.gdn PASS`（o 超界 0/25171968；ht 超界 0/786432）
//   负向对照（"有牙"）：`--mutant 1` → `Pf.gdn_mut1 FAIL`（m=1：o 4190/6144 超界；m=4097：o 130298/25171968 超界）✓
//   零回归：`M15_PREFILL_WIRE=0`（M=1,4097）→ ALL PASS（checks=17）——M110 的结构性（逐行 x→y）形态一字未变。
//   **限度（不许读成"prefill 已打通"）**：只到 KIND_GDN 的**相位 A（GDN 扫描段）**；q/k/v/g/β 由宿主合成
//   （prolog 的 in_proj/out_proj/conv/l2norm 未接）；H1/H2/B 未开（prefill 实参表缺 hc 层界/权重字段，
//   已立 finding）；attention 本轮不接。
inline float H_PfGdnHash(uint32_t a, uint32_t b, uint32_t c)
{
    uint32_t x = (a * 0x9E3779B1u) ^ (b * 0x85EBCA77u) ^ (c * 0xC2B2AE3Du);
    x ^= x >> 15;
    x *= 0x2545F491u;
    x ^= x >> 13;
    x *= 0x27D4EB2Fu;
    x ^= x >> 16;
    return (static_cast<float>(x & 0xFFFFu) / 65535.0f) * 2.0f - 1.0f;
}

// GDN prefill 的确定性输入（host 干净副本；设备副本另做 mutant，见 H_PfGdnWired）。
inline void H_PfGdnFillHost(Ctx& C, uint32_t m)
{
    const PfGdnGeom g = H_PfGdnGeom(m);
    C.pfGdnQHost.assign(static_cast<size_t>(g.nk) * g.Tp * 128u, 0.0f);
    C.pfGdnKHost.assign(static_cast<size_t>(g.nk) * g.Tp * 128u, 0.0f);
    // q/k 每行 **L2 归一**（= m23 `GenQk` 的口径）：GDN 的扫描对 `k·kᵀ` 的尺度敏感 ——
    // 不归一化（如直接取 ±0.5 原始值，行范数 ≈3.3）在 T=4097 上会让参考与设备一起炸到 1e91。
    for (uint32_t kh = 0; kh < g.nk; ++kh) {
        for (uint32_t t = 0; t < m; ++t) {
            float* qr = C.pfGdnQHost.data() + (static_cast<size_t>(kh) * g.Tp + t) * 128u;
            float* kr = C.pfGdnKHost.data() + (static_cast<size_t>(kh) * g.Tp + t) * 128u;
            double sq = 0.0, sk = 0.0;
            for (uint32_t i = 0; i < 128u; ++i) {
                qr[i] = H_PfGdnHash(t * 7u + kh, i, 0x5100u);
                kr[i] = H_PfGdnHash(t * 7u + kh, i, 0x5200u);
                sq += static_cast<double>(qr[i]) * static_cast<double>(qr[i]);
                sk += static_cast<double>(kr[i]) * static_cast<double>(kr[i]);
            }
            const double nq = 1.0 / std::sqrt(sq);
            const double nk = 1.0 / std::sqrt(sk);
            for (uint32_t i = 0; i < 128u; ++i) {
                qr[i] = static_cast<float>(static_cast<double>(qr[i]) * nq);
                kr[i] = static_cast<float>(static_cast<double>(kr[i]) * nk);
            }
        }
    }
    C.pfGdnVHost.assign(static_cast<size_t>(g.h) * m * 128u, 0.0f);
    for (uint32_t h = 0; h < g.h; ++h) {
        for (uint32_t t = 0; t < m; ++t) {
            for (uint32_t i = 0; i < 128u; ++i) {
                C.pfGdnVHost[(static_cast<size_t>(h) * m + t) * 128u + i] = H_PfGdnHash(i, t * 31u + h, 0x5300u);
            }
        }
    }
    C.pfGdnGHost.assign(static_cast<size_t>(g.h) * g.tp, 0.0f);
    C.pfGdnBetaHost.assign(static_cast<size_t>(g.h) * g.tp, 0.0f);
    for (uint32_t h = 0; h < g.h; ++h) {
        for (uint32_t t = 0; t < m; ++t) {
            const float u = H_PfGdnHash(t, h, 0x5400u) * 0.5f + 0.5f;
            const float b = H_PfGdnHash(t, h, 0x5500u) * 0.5f + 0.5f;
            C.pfGdnGHost[static_cast<size_t>(h) * g.tp + t] = -0.001f - u * 0.05f;   // 负衰减
            C.pfGdnBetaHost[static_cast<size_t>(h) * g.tp + t] = 0.05f + b * 0.9f;
        }
    }
    C.pfGdnH0Host.assign(static_cast<size_t>(g.h) * 128u * 128u, 0.0f);
    for (uint32_t h = 0; h < g.h; ++h) {
        for (uint32_t i = 0; i < 128u; ++i) {
            for (uint32_t j = 0; j < 128u; ++j) {
                C.pfGdnH0Host[(static_cast<size_t>(h) * 128u + i) * 128u + j] =
                    0.1f * H_PfGdnHash(i * 128u + j, h, 0x5600u);
            }
        }
    }
}

// B4 的 router pad 平面：[E_PAD, HIDDEN] bf16；行 0..E-1 = 专家，行 E = 共享门，行 E+1..E_PAD-1 = 复制行 E。
// M140：源改为**调用方给的** router（[E=512, HIDDEN] bf16）与 sgate（[HIDDEN] bf16）的 host 字节
// —— E=512 的真实 router 平面由 `H_LoadMoeSlot512` 从 checkpoint 的 `moe512_router_w` 取（M136
// 的旧实现从 decode 的 E=4 router 槽读 512 行，会越界读到槽外字节；相位 B 未开时没暴露）。
inline void H_PfGdnBuildRouterWPad(Ctx& C, const uint8_t* routerHost, const uint8_t* sgateHost)
{
    const size_t rowB = static_cast<size_t>(M15PFR::HIDDEN) * 2u;
    const size_t splitB = static_cast<size_t>(M15PFR::E) * rowB;
    std::vector<uint8_t> rw(static_cast<size_t>(M15PFR::E_PAD) * rowB, 0u);
    __builtin_memcpy(rw.data(), routerHost, splitB);
    __builtin_memcpy(rw.data() + splitB, sgateHost, rowB);
    for (uint32_t r = M15PFR::E + 1u; r < M15PFR::E_PAD; ++r) {
        __builtin_memcpy(rw.data() + static_cast<size_t>(r) * rowB, sgateHost, rowB);
    }
    H_H2D(C, C.pfMoeRouterWPadDev, rw.data(), rw.size(), "pfgdn_routerwpad");
}

// m23 兼容 dump（供 `m23_gdn_prefill/check_ref.py` 离线数值对拍；参考从 dump 的**干净输入**复算）。
inline bool H_PfGdnDump(Ctx& C, const char* tag, uint32_t m)
{
    const PfGdnGeom g = H_PfGdnGeom(m);
    char nm[400];
    auto W = [&](const char* what, const void* p, size_t n) -> bool {
        snprintf(nm, sizeof(nm), "%s/m23_%s_%s.bin", C.pfDumpDir.c_str(), tag, what);
        return H_WriteBin(nm, p, n);
    };
    bool ok = true;
    ok &= W("q", C.pfGdnQHost.data(), C.pfGdnQHost.size() * 4u);
    ok &= W("k", C.pfGdnKHost.data(), C.pfGdnKHost.size() * 4u);
    ok &= W("v", C.pfGdnVHost.data(), C.pfGdnVHost.size() * 4u);
    std::vector<float> gpk(static_cast<size_t>(g.h) * m), bpk(static_cast<size_t>(g.h) * m);
    for (uint32_t h = 0; h < g.h; ++h) {
        for (uint32_t t = 0; t < m; ++t) {
            gpk[static_cast<size_t>(h) * m + t] = C.pfGdnGHost[static_cast<size_t>(h) * g.tp + t];
            bpk[static_cast<size_t>(h) * m + t] = C.pfGdnBetaHost[static_cast<size_t>(h) * g.tp + t];
        }
    }
    ok &= W("g", gpk.data(), gpk.size() * 4u);
    ok &= W("beta", bpk.data(), bpk.size() * 4u);
    ok &= W("h0", C.pfGdnH0Host.data(), C.pfGdnH0Host.size() * 4u);
    ok &= W("o", C.pfGdnOHost.data(), C.pfGdnOHost.size() * 4u);
    ok &= W("ht", C.pfGdnHtHost.data(), C.pfGdnHtHost.size() * 4u);
    snprintf(nm, sizeof(nm), "%s/m23_%s_meta.txt", C.pfDumpDir.c_str(), tag);
    FILE* f = fopen(nm, "w");
    if (f == nullptr) {
        ok = false;
    } else {
        // M136 r1 复审 P2 的非阻塞观察：旧版只写一个 `TP` = `align8(m)`（g/β 的行距），与同目录
        // q/k.bin 的实际定尺（`Tp = m + 64`）不同 ⇒ 会误导读者。这里把两个口径**分开写全**。
        // `check_ref.py` 的 `read_meta` 只消费 H/T/NK/nAic/scale（且自算 `Tp = T + 64`）⇒ 新增键不
        // 影响对拍；`TP_qk` = q/k.bin 每 head 的行数（= `M15L::PF_GDN_QK_PAD_ROWS` 补齐后的定尺），
        // `TP_gb` = g/β 的每 head 行距。
        fprintf(f, "H %u\nT %u\nNK %u\nDK 128\nDV 128\nBT 64\nscale %.9g\nTP_qk %u\nTP_gb %u\nnAic %u\nnc %u\n",
                g.h, m, g.nk, 0.08838834764831845, g.Tp, g.tp, C.numBlocks, (m + 63u) / 64u);
        fclose(f);
    }
    return ok;
}

// ============================================================
// 4h-0b. M140：E=512（真 shape）的 MoE 权重装载 + hc 四相位的实参组装
// ============================================================
// 为什么需要它：相位 B（B4）的段体按 `E=512 / topk=10` 编译（`m15_moe_prefill_res.h`），设备侧的
// `wGu/sGu/wDn/sDn` 槽是 `MOE_W_PREFILL_STRIDE` = 1.34 GB/层（decode 槽的 102.52×）。M136 的
// prefill 档传的是 decode 的 E=4 槽（相位 B 未开 ⇒ 没暴露）。这里按 manifest 的 `moe512_*` 段
// （全 512 专家，M93 已入 manifest）逐段 pread 进设备槽，**不做任何数值换算**；共享专家的 4 项
// （gate/up 行拼接 + down）与 E 无关 ⇒ 复用 decode 的 role。
static bool H_PreadTensorInto(const M15Manifest& M, const M15Tensor& T, uint8_t* dst, size_t bytes,
                              std::string& err)
{
    if (static_cast<size_t>(T.bytes) != bytes) {
        char b[256];
        snprintf(b, sizeof(b), "role 字节数不符：manifest %llu，期望 %zu",
                 static_cast<unsigned long long>(T.bytes), bytes);
        err = b;
        return false;
    }
    const std::string path = M.modelDir + "/" + T.file;
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) {
        err = "cannot open " + path;
        return false;
    }
    if (fseek(f, static_cast<long>(T.offset), SEEK_SET) != 0) {
        fclose(f);
        err = "fseek failed in " + path;
        return false;
    }
    const size_t got = fread(dst, 1, bytes, f);
    fclose(f);
    if (got != bytes) {
        err = "short read in " + path;
        return false;
    }
    return true;
}

struct MoeWPrefillPtrs {
    uint8_t* router;
    uint8_t* sgate;
    uint8_t* wGu;
    uint8_t* sGu;
    uint8_t* wDn;
    uint8_t* sDn;
    uint8_t* wGuShd;
    uint8_t* sGuShd;
    uint8_t* wDnShd;
    uint8_t* sDnShd;
    uint8_t* g1;
    uint8_t* g2;
};

static MoeWPrefillPtrs H_MoeWPrefillPtrsOf(void* base, uint32_t layer)
{
    uint8_t* s = reinterpret_cast<uint8_t*>(base) + static_cast<size_t>(layer) * M15L::MOE_W_PREFILL_STRIDE;
    MoeWPrefillPtrs p;
    p.router = s + M15L::MWP_ROUTER_OFF;
    p.sgate = s + M15L::MWP_SGATE_OFF;
    p.wGu = s + M15L::MWP_WGU_OFF;
    p.sGu = s + M15L::MWP_SGU_OFF;
    p.wDn = s + M15L::MWP_WDN_OFF;
    p.sDn = s + M15L::MWP_SDN_OFF;
    p.wGuShd = s + M15L::MWP_WGUSHD_OFF;
    p.sGuShd = s + M15L::MWP_SGUSHD_OFF;
    p.wDnShd = s + M15L::MWP_WDNSHD_OFF;
    p.sDnShd = s + M15L::MWP_SDNSHD_OFF;
    p.g1 = s + M15L::MWP_G1_OFF;
    p.g2 = s + M15L::MWP_G2_OFF;
    return p;
}

// 把一层 E=512 的 MoE 权重装进 `arena` 的该层槽（顺序：manifest role → 槽偏移，无换算）。
static bool H_LoadMoeSlot512(const M15Manifest& M, uint32_t layer, std::vector<uint8_t>& arena,
                             std::vector<uint8_t>& routerOut, std::vector<uint8_t>& sgateOut,
                             std::string& err)
{
    uint8_t* d = arena.data() + static_cast<size_t>(layer) * M15L::MOE_W_PREFILL_STRIDE;
    auto rd = [&](const char* role, uint32_t off, size_t bytes) -> bool {
        const M15Tensor* T = H_FindTensor(M, layer, role);
        if (T == nullptr) {
            err = std::string("manifest 缺 role=") + role + " layer=" + std::to_string(layer);
            return false;
        }
        return H_PreadTensorInto(M, *T, d + off, bytes, err);
    };
    const size_t guHalf = M15L::MwWguShdBytes() / 2u;
    const size_t guSHalf = M15L::MwSguShdBytes() / 2u;
    if (!rd("moe512_router_w", M15L::MWP_ROUTER_OFF, M15L::MWP_ROUTER_BYTES) ||
        !rd("moe_sgate_w", M15L::MWP_SGATE_OFF, M15L::MWP_SGATE_BYTES) ||
        !rd("moe512_experts_gate_up", M15L::MWP_WGU_OFF, M15L::MWP_WGU_BYTES) ||
        !rd("moe512_experts_gate_up_scale", M15L::MWP_SGU_OFF, M15L::MWP_SGU_BYTES) ||
        !rd("moe512_experts_down", M15L::MWP_WDN_OFF, M15L::MWP_WDN_BYTES) ||
        !rd("moe512_experts_down_scale", M15L::MWP_SDN_OFF, M15L::MWP_SDN_BYTES) ||
        !rd("moe_shared_gate", M15L::MWP_WGUSHD_OFF, guHalf) ||
        !rd("moe_shared_up", M15L::MWP_WGUSHD_OFF + static_cast<uint32_t>(guHalf), guHalf) ||
        !rd("moe_shared_gate_scale", M15L::MWP_SGUSHD_OFF, guSHalf) ||
        !rd("moe_shared_up_scale", M15L::MWP_SGUSHD_OFF + static_cast<uint32_t>(guSHalf), guSHalf) ||
        !rd("moe_shared_down", M15L::MWP_WDNSHD_OFF, M15L::MW_WDNSHD_BYTES) ||
        !rd("moe_shared_down_scale", M15L::MWP_SDNSHD_OFF, M15L::MW_SDNSHD_BYTES)) {
        return false;
    }
    // 层级 norm：checkpoint 里没有该形状的 MoE 段 norm（同 decode 口径，确定性合成）
    std::vector<uint16_t> g1(M15G::HIDDEN), g2(M15G::HIDDEN);
    H_GenBf16(g1, 61000u + layer, 0.5f);
    H_GenBf16(g2, 62000u + layer, 0.5f);
    __builtin_memcpy(d + M15L::MWP_G1_OFF, g1.data(), g1.size() * 2u);
    __builtin_memcpy(d + M15L::MWP_G2_OFF, g2.data(), g2.size() * 2u);
    // router / sgate 的 host 副本（router pad 组板用，见 `H_PfGdnBuildRouterWPad`）
    routerOut.assign(d + M15L::MWP_ROUTER_OFF, d + M15L::MWP_ROUTER_OFF + M15L::MWP_ROUTER_BYTES);
    sgateOut.assign(d + M15L::MWP_SGATE_OFF, d + M15L::MWP_SGATE_OFF + M15L::MWP_SGATE_BYTES);
    return true;
}

// f32 → bf16 位型（截断；合成输入用，判据吃 dump 出来的同一批字节 ⇒ 舍入点不影响对拍）
static uint16_t H_F32ToBf16Bits(float f)
{
    uint32_t u;
    __builtin_memcpy(&u, &f, 4);
    return static_cast<uint16_t>(u >> 16);
}

// ---- M140：hc 四相位的**合成激活输入**（真权重 + 合成激活，口径与 M136 的 q/k/v/g/β 合成一致）----
// 三块平面都是逐 token 的独立面（hc 边界无位置依赖，见 m27 README §5(f)）：
//   hcH  = 层输入多流残差 H      [m, HYPER=10240] bf16
//   hcBo = pending block output  [m, HID=2560]    bf16
//   hcIj = pending injection logits [m, 16]       bf16（前 INJ_N=4 列有效）
//   hcAttnOut = 子层段出口        [m, HID]        bf16
// `mutant == 2` 时**只**把送设备的 hcH 翻倍（host 干净副本仍落盘）⇒ H1/H2 的参考吃干净、设备吃
// 搅动 ⇒ 判据必须变红（与 M136 的 mut1 同款口径）。
static void H_PfHcFillHost(Ctx& C, uint32_t m, uint32_t mutant)
{
    const size_t hpB = static_cast<size_t>(m) * M15H::HYPER * 2u;
    const size_t hidB = static_cast<size_t>(m) * M15H::HID * 2u;
    const size_t ijB = static_cast<size_t>(m) * M15H::IJ_STRIDE * 2u;
    C.pfHcHH.assign(hpB, 0u);
    C.pfHcBoH.assign(hidB, 0u);
    C.pfHcIjH.assign(ijB, 0u);
    C.pfHcAttnOutH.assign(hidB, 0u);
    auto wrBf16 = [](std::vector<uint8_t>& v, size_t elems, uint32_t seed, float scale) {
        for (size_t i = 0; i < elems; ++i) {
            const float f = scale * H_PfGdnHash(static_cast<uint32_t>(i) & 0xFFFFu,
                                                static_cast<uint32_t>(i >> 16) * 3u + seed, seed);
            const uint16_t b = H_F32ToBf16Bits(f);
            __builtin_memcpy(v.data() + i * 2u, &b, 2u);
        }
    };
    wrBf16(C.pfHcHH, static_cast<size_t>(m) * M15H::HYPER, 0x7001u, 1.0f);
    wrBf16(C.pfHcBoH, static_cast<size_t>(m) * M15H::HID, 0x7101u, 0.5f);
    wrBf16(C.pfHcAttnOutH, static_cast<size_t>(m) * M15H::HID, 0x7201u, 0.5f);
    // ij：只有前 INJ_N 列有效（其余列是 pad）；量级取 ~±4，让 injW = 2·sigmoid(IJ/4) 不饱和
    wrBf16(C.pfHcIjH, static_cast<size_t>(m) * M15H::IJ_STRIDE, 0x7301u, 4.0f);
    (void)mutant;
}

// 把 hc 的 4 块激活平面上 device（`devMutant != 0` 时 hcH 翻倍）
static void H_PfHcH2D(Ctx& C, uint32_t m, uint32_t devMutant)
{
    std::vector<uint8_t> hh(C.pfHcHH);
    if (devMutant != 0u) {
        for (size_t i = 0; i < hh.size(); i += 2u) {
            uint16_t b;
            __builtin_memcpy(&b, hh.data() + i, 2u);
            b = static_cast<uint16_t>(b + 0x0080u);   // bf16 指数 +1 ⇒ 近似 ×2
            __builtin_memcpy(hh.data() + i, &b, 2u);
        }
    }
    H_H2D(C, C.pfHcHDev, hh.data(), static_cast<size_t>(m) * M15H::HYPER * 2u, "pf_hc_h");
    H_H2D(C, C.pfHcBoDev, C.pfHcBoH.data(), static_cast<size_t>(m) * M15H::HID * 2u, "pf_hc_bo");
    H_H2D(C, C.pfHcIjDev, C.pfHcIjH.data(), static_cast<size_t>(m) * M15H::IJ_STRIDE * 2u, "pf_hc_ij");
    H_H2D(C, C.pfHcAttnOutDev, C.pfHcAttnOutH.data(), static_cast<size_t>(m) * M15H::HID * 2u, "pf_hc_attnout");
}

// M140 复审 r1 的实验件：给 `pfXDev` 填一块**确定性**的层输入面 —— 只被"相位 B 单独跑"的隔离档用到
// （那一档 `hcAny == false` ⇒ 相位 B 的输入退回 `A.xLayer`；不填的话它是未初始化平面）。
static void H_PfFillMoeIn(Ctx& C, uint32_t m)
{
    const size_t n = static_cast<size_t>(m) * M15G::HIDDEN;
    std::vector<uint8_t> v(n * 2u, 0u);
    for (size_t i = 0; i < n; ++i) {
        const float f = H_PfGdnHash(static_cast<uint32_t>(i) & 0xFFFFu,
                                    static_cast<uint32_t>(i >> 16) * 5u + 0x7501u, 0x7501u);
        const uint16_t b = H_F32ToBf16Bits(f);
        __builtin_memcpy(v.data() + i * 2u, &b, 2u);
    }
    H_H2D(C, C.pfXDev, v.data(), n * 2u, "pf_x_moein");
}

// ============================================================
// M151：prefill prolog 链路（S2 in_proj + S3 conv1d/l2norm/gating）
// ============================================================
// 数据流：H1 的 BLK（`pfHcBlk0`）→ S2 in_proj（bf16 GEMM 2560→16480，cube）→ S3 prolog（AIV）
// → 相位 A 的 q/k/v/g/β（`pfGdnQDev…`）。契约见 evidence/m151_prefill_prolog_wiring/CONTRACT.md。
// `mutant`：0=干净 / 1=S3 不交接 conv_state（noShift）/ 2=S3 不写 q/k pad 行（noPad）/ 3=S2 GEMM K−1。
// 两个段都是**独立 `__global__`**（逐参复用 m11/m9 donor 段体）；段间次序由同一条 stream 给，
// 段体内部已是 BufferID 同步 ⇒ 不引入 set_flag/wait_flag、不新增跨核 flagId。
static bool H_PfPrologDump(Ctx& C, uint32_t m, uint32_t mutant, const char* tag)
{
    if (C.pfDumpDir.empty()) {
        return true;
    }
    using namespace M15G;
    const PfGdnGeom g = H_PfGdnGeom(m);
    bool ok = true;
    char path[1400];
    auto W = [&](const char* dir, const char* nm, const void* p, size_t n) {
        snprintf(path, sizeof(path), "%s/%s/%s", C.pfDumpDir.c_str(), dir, nm);
        if (!H_WriteBin(path, p, n)) {
            printf("[m15][FAIL] prolog dump 写盘失败（%s）\n", path);
            C.fails++;
            ok = false;
        }
    };
    // ---- S2：m11 `check_ref.py` 的 a.bin/b.bin/c_device.bin 布局 ----
    char s2dir[128];
    snprintf(s2dir, sizeof(s2dir), "m151_s2_%s", tag);
    mkdir((C.pfDumpDir + "/" + s2dir).c_str(), 0755);
    {
        // m=1 quirk：m11 的 A 面须有 ≥2 行可读
        const uint32_t rows = (m < 2u) ? 2u : m;
        std::vector<uint8_t> a(static_cast<size_t>(rows) * HIDDEN * 2u, 0u);
        H_D2H(C, a.data(), C.pfHcBlk0Dev, a.size(), "m151_s2_a");
        const uint8_t* b = C.hostArena.data() +
                           static_cast<size_t>(M15Loop::LayerSlot(0u)) * M15Loop::W_STRIDE + M15Loop::W_IN_OFF;
        std::vector<uint8_t> c(static_cast<size_t>(m) * IN_N * 2u, 0u);
        H_D2H(C, c.data(), C.pfQkvzbaDev, c.size(), "m151_s2_c");
        W(s2dir, "a.bin", a.data(), a.size());
        W(s2dir, "b.bin", b, static_cast<size_t>(IN_N) * HIDDEN * 2u);
        W(s2dir, "c_device.bin", c.data(), c.size());
    }
    // ---- S3：m9 `check_ref.py` 的 m9mt_* 布局 ----
    char s3dir[128];
    snprintf(s3dir, sizeof(s3dir), "m151_s3_%s", tag);
    mkdir((C.pfDumpDir + "/" + s3dir).c_str(), 0755);
    char pfx[96];
    snprintf(pfx, sizeof(pfx), "m9mt_m%u_b%02u_mut%u_", m, C.numBlocks * 2u, mutant);
    {
        char nm[160];
        std::vector<uint8_t> x(static_cast<size_t>(m) * IN_N * 2u, 0u);
        H_D2H(C, x.data(), C.pfQkvzbaDev, x.size(), "m151_s3_x");
        auto W3 = [&](const char* suffix, const void* p, size_t n) {
            snprintf(nm, sizeof(nm), "%s%s", pfx, suffix);
            W(s3dir, nm, p, n);
        };
        W3("x.bin", x.data(), x.size());
        W3("conv_state_init.bin", C.pfConvStateInitH.data(), C.pfConvStateInitH.size());
        W3("conv_state_out.bin", C.pfConvStateOutH.data(), C.pfConvStateOutH.size());
        const uint8_t* wa = C.hostArena.data() +
                            static_cast<size_t>(M15Loop::LayerSlot(0u)) * M15Loop::W_STRIDE;
        W3("w.bin", wa + M15Loop::W_CONV_OFF, static_cast<size_t>(4u) * CH * 2u);
        W3("bias.bin", wa + M15Loop::W_CONVB_OFF, static_cast<size_t>(CH) * 2u);
        W3("a_log.bin", wa + M15Loop::W_ALOG_OFF, 64u * 4u);
        W3("dt_bias.bin", wa + M15Loop::W_DTB_OFF, 64u * 4u);
        W3("q.bin", C.pfGdnQHost.data(), static_cast<size_t>(g.nk) * g.Tp * 128u * 4u);
        W3("k.bin", C.pfGdnKHost.data(), static_cast<size_t>(g.nk) * g.Tp * 128u * 4u);
        W3("v.bin", C.pfGdnVHost.data(), static_cast<size_t>(g.h) * m * 128u * 4u);
        W3("g.bin", C.pfGdnGHost.data(), static_cast<size_t>(g.h) * g.tp * 4u);
        W3("beta.bin", C.pfGdnBetaHost.data(), static_cast<size_t>(g.h) * g.tp * 4u);
        snprintf(nm, sizeof(nm), "%smeta.txt", pfx);
        char mp[1400];
        snprintf(mp, sizeof(mp), "%s/%s/%s", C.pfDumpDir.c_str(), s3dir, nm);
        FILE* f = fopen(mp, "w");
        if (f == nullptr) {
            printf("[m15][FAIL] prolog meta 写盘失败（%s）\n", mp);
            C.fails++;
            ok = false;
        } else {
            fprintf(f, "m %u\ntp %u\nqkstride %u\nqscale %u\nmut %u\nblk %u\nsalt 0\n", m, g.tp, g.Tp,
                    C.O.pfPrologScale, mutant, C.numBlocks * 2u);
            fclose(f);
        }
    }
    return ok;
}

inline bool H_PfPrologRun(Ctx& C, uint32_t m, uint32_t mutant, const char* tag)
{
    using namespace M15G;
    if (C.pfQkvzbaDev == nullptr || C.pfConvStateDev == nullptr) {
        printf("[m15][FAIL] %s：prolog 平面未分配（M15_PREFILL_PROLOG=1 需 M15_PREFILL_WIRE=1）\n", tag);
        C.fails++;
        return false;
    }
    if (C.O.nLayers == 0u || M15Loop::KindOf(0u) != M15Loop::KIND_GDN) {
        printf("[m15][FAIL] %s：prolog 的权重按层 0 取（须为 GDN），实际 kind 非 GDN\n", tag);
        C.fails++;
        return false;
    }
    // conv_state 初值 = 该层 decode 路的 csInit（同源；host 干净副本落盘供参考）。
    C.pfConvStateInitH.assign(reinterpret_cast<const uint8_t*>(C.csInit.data()),
                              reinterpret_cast<const uint8_t*>(C.csInit.data()) + C.csInit.size() * 2u);
    H_H2D(C, C.pfConvStateDev, C.pfConvStateInitH.data(), C.pfConvStateInitH.size(), "pf_conv_state_init");

    // ---- S2：in_proj（cube；`m11 bf16_gemm_kernel<2560,16480>` 的 m15 lift）----
    const uint32_t gemmMode = (mutant == 3u) ? M15OP::GEMM_MODE_KMINUS1 : M15OP::GEMM_MODE_CONTRACT;
    printf("[m15]   %s：S2 in_proj 启动（A=H1.BLK [%u,2560] bf16 → C=[%u,16480] bf16，mode=%u）\n", tag, m, m,
           gemmMode);
    fflush(stdout);
    m15_pf_inproj_gemm_kernel<<<1, 0, C.stream>>>(reinterpret_cast<uint8_t*>(C.pfHcBlk0Dev),
                                                  H_W(C, 0u, M15Loop::W_IN_OFF),
                                                  reinterpret_cast<uint8_t*>(C.pfQkvzbaDev), m, gemmMode);
    if (!H_Sync(C, "pf_inproj")) {
        return false;
    }

    // ---- S3：prolog（AIV；`gdn_prolog_mt_kernel` 的 m>1 段体）----
    // 先毒化相位 A 的输入面：证 S3 真的写了它们（尤其 `noPad` 档 —— 不写 pad 行时毒值必须留下）。
    {
        const PfGdnGeom g = H_PfGdnGeom(m);
        aclrtMemset(C.pfGdnQDev, static_cast<size_t>(g.nk) * g.Tp * 128u * 4u, 0xCD,
                    static_cast<size_t>(g.nk) * g.Tp * 128u * 4u);
        aclrtMemset(C.pfGdnKDev, static_cast<size_t>(g.nk) * g.Tp * 128u * 4u, 0xCD,
                    static_cast<size_t>(g.nk) * g.Tp * 128u * 4u);
        aclrtMemset(C.pfGdnVDev, static_cast<size_t>(g.h) * m * 128u * 4u, 0xCD,
                    static_cast<size_t>(g.h) * m * 128u * 4u);
        aclrtMemset(C.pfGdnGDev, static_cast<size_t>(g.h) * g.tp * 4u, 0xCD,
                    static_cast<size_t>(g.h) * g.tp * 4u);
        aclrtMemset(C.pfGdnBetaDev, static_cast<size_t>(g.h) * g.tp * 4u, 0xCD,
                    static_cast<size_t>(g.h) * g.tp * 4u);
    }
    const uint32_t noShift = (mutant == 1u) ? 1u : 0u;
    const uint32_t noPad = (mutant == 2u) ? 1u : 0u;
    const uint32_t nAiv = C.numBlocks * 2u;
    printf("[m15]   %s：S3 prolog 启动（x=qkvzba → q/k/v/g/β；blk=%u，qScaleOn=%u，noShift=%u，noPad=%u）\n", tag,
           nAiv, C.O.pfPrologScale, noShift, noPad);
    fflush(stdout);
    m15_pf_gdn_prolog_kernel<<<nAiv, 0, C.stream>>>(
        reinterpret_cast<uint8_t*>(C.pfQkvzbaDev), reinterpret_cast<uint8_t*>(C.pfConvStateDev),
        H_W(C, 0u, M15Loop::W_CONV_OFF), H_W(C, 0u, M15Loop::W_CONVB_OFF), H_W(C, 0u, M15Loop::W_ALOG_OFF),
        H_W(C, 0u, M15Loop::W_DTB_OFF), reinterpret_cast<uint8_t*>(C.pfGdnQDev),
        reinterpret_cast<uint8_t*>(C.pfGdnKDev), reinterpret_cast<uint8_t*>(C.pfGdnVDev),
        reinterpret_cast<uint8_t*>(C.pfGdnGDev), reinterpret_cast<uint8_t*>(C.pfGdnBetaDev), m,
        C.O.pfPrologScale, noShift, noPad);
    if (!H_Sync(C, "pf_prolog")) {
        return false;
    }

    // ---- 回读相位 A 的输入（设备产出）+ conv_state 出口 ----
    const PfGdnGeom g = H_PfGdnGeom(m);
    const size_t qkB = static_cast<size_t>(g.nk) * g.Tp * 128u * 4u;
    const size_t vB = static_cast<size_t>(g.h) * m * 128u * 4u;
    const size_t gbB = static_cast<size_t>(g.h) * g.tp * 4u;
    C.pfGdnQHost.assign(qkB / 4u, 0.0f);
    C.pfGdnKHost.assign(qkB / 4u, 0.0f);
    C.pfGdnVHost.assign(vB / 4u, 0.0f);
    C.pfGdnGHost.assign(gbB / 4u, 0.0f);
    C.pfGdnBetaHost.assign(gbB / 4u, 0.0f);
    H_D2H(C, C.pfGdnQHost.data(), C.pfGdnQDev, qkB, "m151_q");
    H_D2H(C, C.pfGdnKHost.data(), C.pfGdnKDev, qkB, "m151_k");
    H_D2H(C, C.pfGdnVHost.data(), C.pfGdnVDev, vB, "m151_v");
    H_D2H(C, C.pfGdnGHost.data(), C.pfGdnGDev, gbB, "m151_g");
    H_D2H(C, C.pfGdnBetaHost.data(), C.pfGdnBetaDev, gbB, "m151_beta");
    C.pfConvStateOutH.assign(C.pfConvStateInitH.size(), 0u);
    H_D2H(C, C.pfConvStateOutH.data(), C.pfConvStateDev, C.pfConvStateOutH.size(), "m151_conv_state_out");

    // ---- 设备侧判据（有牙）：q/k 的 pad 行、g/β 的 pad 列；负向对照档必须真的动了它 ----
    bool padAllZero = true;
    for (uint32_t h = 0; h < g.nk && padAllZero; ++h) {
        for (uint32_t r = m; r < g.Tp && padAllZero; ++r) {
            for (uint32_t d = 0; d < 128u; ++d) {
                if (C.pfGdnQHost[(static_cast<size_t>(h) * g.Tp + r) * 128u + d] != 0.0f ||
                    C.pfGdnKHost[(static_cast<size_t>(h) * g.Tp + r) * 128u + d] != 0.0f) {
                    padAllZero = false;
                }
            }
        }
    }
    for (uint32_t h = 0; h < g.h && padAllZero; ++h) {
        for (uint32_t t = m; t < g.tp; ++t) {
            if (C.pfGdnGHost[static_cast<size_t>(h) * g.tp + t] != 0.0f ||
                C.pfGdnBetaHost[static_cast<size_t>(h) * g.tp + t] != 0.0f) {
                padAllZero = false;
            }
        }
    }
    bool finite = true;
    for (float x : C.pfGdnQHost) { finite = finite && std::isfinite(x); }
    for (float x : C.pfGdnVHost) { finite = finite && std::isfinite(x); }
    for (float x : C.pfGdnGHost) { finite = finite && std::isfinite(x); }

    // conv_state：干净档必须真的前进（noShift 档不要求）
    bool stateMoved = (C.pfConvStateOutH != C.pfConvStateInitH);

    printf("[m15]   %s：prolog 回读 ⇒ pad 全零=%d、全有限=%d、conv_state 前进=%d（q=%.4e max|v|=%.4e）\n", tag,
           padAllZero ? 1 : 0, finite ? 1 : 0, stateMoved ? 1 : 0, static_cast<double>(C.pfGdnQHost[0]),
           [&] {
               double mx = 0.0;
               for (float x : C.pfGdnVHost) { mx = std::max(mx, std::fabs(static_cast<double>(x))); }
               return mx;
           }());
    bool ok = true;
    ok &= H_CmpOk(C, finite);
    if (mutant == 2u) {
        ok &= H_CmpOk(C, !padAllZero);   // 负向对照（noPad）必须真的动了 pad —— 判据非空洞
    } else {
        ok &= H_CmpOk(C, padAllZero);
    }
    if (mutant == 0u) {
        ok &= H_CmpOk(C, stateMoved);
    }

    if (!H_PfPrologDump(C, m, mutant, tag)) {
        printf("[m15][FAIL] %s：prolog dump 失败\n", tag);
    } else if (!C.pfDumpDir.empty()) {
        printf("[m15]   %s：prolog dump → %s/m151_s2_%s/（m11 布局）、%s/m151_s3_%s/（m9 布局）\n", tag,
               C.pfDumpDir.c_str(), tag, C.pfDumpDir.c_str(), tag);
    }
    return ok;
}

// ============================================================
// M164：prefill epilog 链路（转位 → S5 RMSNormGated → S6 out_proj）
// ============================================================
// 数据流：相位 A 出口 `pfGdnODev`（wsO，head-major fp32 [48,m,128]）+ prolog S2 的 `pfQkvzbaDev`
// （z 段 [10240,16384)）→ ① 转位/落位（o fp32 [m,6144]、z bf16 [m,6144]）→ ② S5（y bf16 [m,6144]）
// → ③ S6（写 `pfHcAttnOutDev` = H2 的 bo；Fixpipe dstStride=N=2560 elems = 5120 B = ROW_HID）。
// `mutant`：0=干净 / 1=转位 headstride 错（只 m>1 暴露）/ 2=S5 gamma 未生效 / 3=S5 zhead0 / 4=S6 K−1。
// 三段都是**独立 `__global__`**（逐字复用 m28 donor 段体，见 m15_prefill_epilog.h）；段间次序由同一条
// stream 给，段体内部已是 BufferID 同步 ⇒ 不引入 set_flag/wait_flag、不新增跨核 flagId。
static bool H_PfEpilogDump(Ctx& C, uint32_t m, uint32_t mutant, const char* tag)
{
    if (C.pfDumpDir.empty()) {
        return true;
    }
    bool ok = true;
    char sub[160];
    snprintf(sub, sizeof(sub), "m164_%s", tag);
    mkdir((C.pfDumpDir + "/" + sub).c_str(), 0755);
    char path[1400];
    auto W = [&](const char* nm, const void* p, size_t n) {
        snprintf(path, sizeof(path), "%s/%s/%s", C.pfDumpDir.c_str(), sub, nm);
        if (!H_WriteBin(path, p, n)) {
            printf("[m15][FAIL] epilog dump 写盘失败（%s）\n", path);
            C.fails++;
            ok = false;
        }
    };
    const size_t hidElems = static_cast<size_t>(m) * M15PE::PF_EPI_HIDDEN;
    W("m164_wsO.bin", C.pfGdnOHost.data(), hidElems * 4u);
    W("m164_qkvzba.bin", C.pfQkvzbaH.data(), static_cast<size_t>(m) * M15G::IN_N * 2u);
    W("m164_o_device.bin", C.pfOTokH.data(), hidElems * 4u);
    W("m164_z_device.bin", C.pfZTokH.data(), hidElems * 2u);
    W("m164_y_device.bin", C.pfYTokH.data(), hidElems * 2u);
    W("m164_hcattnout_device.bin", C.pfEpiAttnOutH.data(), static_cast<size_t>(m) * M15H::HID * 2u);
    W("m164_hostsynth_bo.bin", C.pfHcAttnOutH.data(), static_cast<size_t>(m) * M15H::HID * 2u);
    {
        const uint8_t* wa = C.hostArena.data() + static_cast<size_t>(M15Loop::LayerSlot(0u)) * M15Loop::W_STRIDE;
        W("m164_gamma.bin", wa + M15Loop::W_GG_OFF, M15Loop::W_GG_BYTES);
        W("m164_wout.bin", wa + M15Loop::W_OUT_OFF, M15Loop::W_OUT_BYTES);
    }
    snprintf(path, sizeof(path), "%s/%s/m164_meta.txt", C.pfDumpDir.c_str(), sub);
    FILE* f = fopen(path, "w");
    if (f == nullptr) {
        printf("[m15][FAIL] epilog meta 写盘失败（%s）\n", path);
        C.fails++;
        ok = false;
    } else {
        fprintf(f, "m %u\nheads %u\nhead %u\nhidden %u\nin_n %u\nz_off %u\nz_dim %u\nout_n %u\nmut %u\nblk %u\n", m,
                M15PE::PF_EPI_HEADS, M15PE::PF_EPI_HEAD, M15PE::PF_EPI_HIDDEN, M15G::IN_N, 10240u, 6144u,
                M15PE::PF_EPI_OUT_N, mutant, C.numBlocks * 2u);
        fclose(f);
    }
    return ok;
}

inline bool H_PfEpilogRun(Ctx& C, uint32_t m, uint32_t mutant, const char* tag)
{
    using namespace M15G;
    if (C.pfGdnODev == nullptr || C.pfQkvzbaDev == nullptr || C.pfOTokDev == nullptr || C.pfZTokDev == nullptr ||
        C.pfYTokDev == nullptr || C.pfHcAttnOutDev == nullptr) {
        printf("[m15][FAIL] %s：epilog 平面未分配（M15_PREFILL_EPILOG=1 需 M15_PREFILL_PROLOG=1 + WIRE=1）\n", tag);
        C.fails++;
        return false;
    }
    const size_t hidElems = static_cast<size_t>(m) * M15PE::PF_EPI_HIDDEN;
    const size_t oB = hidElems * 4u;
    const size_t zB = hidElems * 2u;
    const size_t qkvB = static_cast<size_t>(m) * IN_N * 2u;
    const size_t attnB = static_cast<size_t>(m) * M15H::HID * 2u;
    const size_t attnPlaneB = static_cast<size_t>(M15Loop::M_PREFILL) * M15H::HID * 2u;
    const uint32_t transMut = (mutant == 1u) ? 1u : 0u;                    // MUT_HEADSTRIDE
    const uint32_t s5Mut = (mutant == 2u) ? 1u : ((mutant == 3u) ? 2u : 0u);
    const bool s6Mut = (mutant == 4u);
    const uint32_t nAiv = C.numBlocks * 2u;
    __gm__ uint8_t* const gamma = H_W(C, 0u, M15Loop::W_GG_OFF);
    __gm__ uint8_t* const wout = H_W(C, 0u, M15Loop::W_OUT_OFF);
    // 毒化 epilog 的产出面：证三段真的写了它们（[0,m) 之外的 [m,M_PREFILL) 行必须留毒）。
    aclrtMemset(C.pfOTokDev, oB, 0xCD, oB);
    aclrtMemset(C.pfZTokDev, zB, 0xCD, zB);
    aclrtMemset(C.pfYTokDev, zB, 0xCD, zB);
    aclrtMemset(C.pfHcAttnOutDev, attnPlaneB, 0xCD, attnPlaneB);
    printf("[m15]   %s：M164 epilog 启动（m=%u，mut=%u：① 转位 → ② S5 → ③ %s；blk=%u）\n", tag, m, mutant,
           s6Mut ? "S6(M15OP K−1)" : "S6(chain)", nAiv);
    fflush(stdout);
    m15_pf_epilog_transpose_kernel<<<nAiv, 0, C.stream>>>(
        reinterpret_cast<uint8_t*>(C.pfGdnODev), reinterpret_cast<uint8_t*>(C.pfQkvzbaDev),
        reinterpret_cast<uint8_t*>(C.pfOTokDev), reinterpret_cast<uint8_t*>(C.pfZTokDev), m, transMut);
    if (!H_Sync(C, "pf_epilog_transpose")) {
        return false;
    }
    m15_pf_epilog_s5_kernel<<<nAiv, 0, C.stream>>>(reinterpret_cast<uint8_t*>(C.pfOTokDev),
                                                   reinterpret_cast<uint8_t*>(C.pfZTokDev), gamma,
                                                   reinterpret_cast<uint8_t*>(C.pfYTokDev), m, s5Mut);
    if (!H_Sync(C, "pf_epilog_s5")) {
        return false;
    }
    if (s6Mut) {
        m15_pf_epilog_s6_mut_kernel<<<1, 0, C.stream>>>(reinterpret_cast<uint8_t*>(C.pfYTokDev), wout,
                                                        reinterpret_cast<uint8_t*>(C.pfHcAttnOutDev), m);
    } else {
        m15_pf_epilog_s6_kernel<<<1, 0, C.stream>>>(reinterpret_cast<uint8_t*>(C.pfYTokDev), wout,
                                                    reinterpret_cast<uint8_t*>(C.pfHcAttnOutDev), m);
    }
    if (!H_Sync(C, "pf_epilog_s6")) {
        return false;
    }

    // ---- 回读 device 产出（供判据 + dump）----
    C.pfGdnOHost.assign(hidElems, 0.0f);
    H_D2H(C, C.pfGdnOHost.data(), C.pfGdnODev, oB, "m164_wsO");
    C.pfQkvzbaH.assign(qkvB, 0u);
    H_D2H(C, C.pfQkvzbaH.data(), C.pfQkvzbaDev, qkvB, "m164_qkvzba");
    C.pfOTokH.assign(oB, 0u);
    H_D2H(C, C.pfOTokH.data(), C.pfOTokDev, oB, "m164_o");
    C.pfZTokH.assign(zB, 0u);
    H_D2H(C, C.pfZTokH.data(), C.pfZTokDev, zB, "m164_z");
    C.pfYTokH.assign(zB, 0u);
    H_D2H(C, C.pfYTokH.data(), C.pfYTokDev, zB, "m164_y");
    C.pfEpiAttnOutH.assign(attnB, 0u);
    H_D2H(C, C.pfEpiAttnOutH.data(), C.pfHcAttnOutDev, attnB, "m164_hcattnout");

    // [0,m) 行：无 0xCD16 残渣、非全零、无 inf/nan（bf16 指数 0xFF）；
    // 尾行 [m, M_PREFILL)：整片保毒 ⇒ "未写区不得看起来合法" 的反面证据。
    size_t pois = 0, nonzero = 0, nonfinite = 0;
    for (size_t i = 0; i + 1u < C.pfEpiAttnOutH.size(); i += 2u) {
        uint16_t b;
        __builtin_memcpy(&b, C.pfEpiAttnOutH.data() + i, 2u);
        if (b == 0xCDCDu) {
            ++pois;
        }
        if (b != 0u) {
            ++nonzero;
        }
        if (((b >> 7) & 0xFFu) == 0xFFu) {
            ++nonfinite;
        }
    }
    size_t tailPois = 0, tailWords = 0;
    if (attnPlaneB > attnB) {
        std::vector<uint8_t> tail(attnPlaneB - attnB, 0u);
        H_D2H(C, tail.data(), reinterpret_cast<uint8_t*>(C.pfHcAttnOutDev) + attnB, tail.size(), "m164_attnout_tail");
        for (size_t i = 0; i + 1u < tail.size(); i += 2u) {
            ++tailWords;
            uint16_t b;
            __builtin_memcpy(&b, tail.data() + i, 2u);
            if (b == 0xCDCDu) {
                ++tailPois;
            }
        }
    }
    const size_t words = attnB / 2u;
    // M151 §5（已登记）：m>1 的相位 A 出口 wsO 本身含 `exp(-Σg)` 级数溢出后的非有限（独立 m23
    // fp64 参考复现同一 pattern）⇒ epilog 出口的非有限是**继承自输入**，不是 epilog 引入的。
    // 因此"出口全有限"只在**输入全有限**（m=1 档）时作为判据；输入非有限时改为要求出口
    // **确实带非有限**（反面对照：不许被静默清成有限值）。
    size_t wsONonfinite = 0;
    for (float x : C.pfGdnOHost) {
        if (!std::isfinite(x)) {
            ++wsONonfinite;
        }
    }
    const bool inFinite = (wsONonfinite == 0u);
    printf("[m15]   %s：epilog 出口 hcAttnOut[0,%u) ⇒ 0xCD 残渣 %zu/%zu、非零 %zu、非有限 %zu"
           "（输入 wsO 非有限 %zu ⇒ %s）；尾行 [%u,%u) 0xCD %zu/%zu\n",
           tag, m, pois, words, nonzero, nonfinite, wsONonfinite, inFinite ? "全有限" : "预期非有限", m,
           static_cast<uint32_t>(M15Loop::M_PREFILL), tailPois, tailWords);
    bool ok = true;
    ok &= H_CmpOk(C, pois == 0u);
    ok &= H_CmpOk(C, nonzero > 0u);
    ok &= H_CmpOk(C, inFinite ? (nonfinite == 0u) : (nonfinite > 0u));
    ok &= H_CmpOk(C, tailWords == 0u || tailPois == tailWords);
    if (!H_PfEpilogDump(C, m, mutant, tag)) {
        printf("[m15][FAIL] %s：epilog dump 失败\n", tag);
    }
    // 让 H2 的 `h2_bo` dump（H_PfHcDump）反映 H2 **实际**读到的 bo（设备产出），而非宿主合成件。
    C.pfHcAttnOutH = C.pfEpiAttnOutH;
    return ok;
}

// M136（Wave D）：KIND_GDN 的**段体真产出**判据 —— 真指针起 GDN prefill 入口（相位 A），
// 回读 o（段出口）与 ht（状态），判「有限 / 非全零 / 非毒值」，并把 q/k/v/g/β/h0/o/ht 落盘成
// m23 的 dump 格式，供 `m23_gdn_prefill/check_ref.py`（numpy float64 逐句参考）离线对拍。
// mutant=1：**只**把送设备的 h0 翻倍（host 干净副本仍落盘）⇒ 参考吃干净、设备吃搅动 ⇒ 判据必须变红。
// M140：hc 四相位的产出 + 权重落盘（权重来自 host 镜像 `C.hcArena` 的 layer 0，设备读的是同一份）。
// 命名：`m140_h1_{hin,bo,ij,hcp,blk}` / `m140_h2_{bo,hcp,blk}` / `m140_w_{a1,a2}_{norm,down,inj,up}`。
static void H_PfHcDump(Ctx& C, const char* tag, uint32_t m);
static void H_PfMoeDump26(Ctx& C, uint32_t m, const char* tag);

inline bool H_PfGdnWired(Ctx& C, uint32_t m, uint32_t mutant, const char* tag)
{
    using namespace M15G;
    const bool prologOn = (C.O.pfProlog != 0u);
    // M151：prolog 需要 H1 产 BLK（`pfHcBlk0`）⇒ 强制 H1 进掩码（只在本档额外跑一次 H1 launch）。
    const uint32_t ph = C.O.pfPhases | (prologOn ? M15L::PF_STAGE_H1 : 0u);
    const bool phH1 = (ph & M15L::PF_STAGE_H1) != 0u;
    const bool phA = (ph & M15L::PF_STAGE_A) != 0u;
    const bool phH2 = (ph & M15L::PF_STAGE_H2) != 0u;
    const bool phB = (ph & M15L::PF_STAGE_B) != 0u;
    const bool hcAny = phH1 || phH2 || phB;
    C.pfMoeYH.clear();   // 每档起点清空：`moe_y` 只能来自**本档**（复审 r1 P2-3）
    printf("[m15]   %s：M140 相位掩码 = 0x%X（H1=%d A=%d H2=%d B=%d）；M151 prolog=%d/mut=%u\n", tag, ph,
           phH1 ? 1 : 0, phA ? 1 : 0, phH2 ? 1 : 0, phB ? 1 : 0, prologOn ? 1 : 0, C.O.pfPrologMut);

    // ---- 相位 A 的输入（M136 口径：q/k/v/g/β 由宿主合成；M151 prolog 档改由设备 S2+S3 产出）----
    H_PfGdnFillHost(C, m);
    const size_t qkB = C.pfGdnQHost.size() * 4u;
    const size_t vB = C.pfGdnVHost.size() * 4u;
    const size_t gbB = C.pfGdnGHost.size() * 4u;
    const size_t hB = C.pfGdnH0Host.size() * 4u;
    std::vector<float> h0Dev(C.pfGdnH0Host);
    if (mutant == 1u) {
        for (float& x : h0Dev) {
            x = 2.0f * x;
        }
    }
    if (!prologOn) {
        // 宿主合成路径（保留为可切换的对照/回归档）：prolog 档下这几个平面由 S3 写，勿覆盖。
        H_H2D(C, C.pfGdnQDev, C.pfGdnQHost.data(), qkB, "pfgdn_q");
        H_H2D(C, C.pfGdnKDev, C.pfGdnKHost.data(), qkB, "pfgdn_k");
        H_H2D(C, C.pfGdnVDev, C.pfGdnVHost.data(), vB, "pfgdn_v");
        H_H2D(C, C.pfGdnGDev, C.pfGdnGHost.data(), gbB, "pfgdn_g");
        H_H2D(C, C.pfGdnBetaDev, C.pfGdnBetaHost.data(), gbB, "pfgdn_beta");
    }
    H_H2D(C, C.pfGdnStateDev, h0Dev.data(), hB, "pfgdn_h0");
    C.pfPosHost.assign(M15Loop::M_PREFILL, 0);
    for (uint32_t r = 0; r < M15Loop::M_PREFILL; ++r) {
        C.pfPosHost[r] = static_cast<int32_t>(r);
    }
    H_H2D(C, C.pfPosDev, C.pfPosHost.data(), static_cast<size_t>(M15Loop::M_PREFILL) * 4u, "pfgdn_pos");
    const size_t scB = static_cast<size_t>(C.numBlocks) * M15G::GP_SLOT_BYTES;
    aclrtMemset(C.pfGdnODev, vB, 0, vB);
    aclrtMemset(C.pfGdnScratchDev, scB, 0, scB);

    // ---- M140：hc 四相位的输入（真权重 + 合成激活）----
    __gm__ uint8_t* hcH = nullptr;
    __gm__ uint8_t* hcBo = nullptr;
    __gm__ uint8_t* hcIj = nullptr;
    __gm__ uint8_t* hcAttnOut = nullptr;
    __gm__ uint8_t* hcAttnNorm = nullptr, *hcAttnDown = nullptr, *hcAttnInj = nullptr, *hcAttnUp = nullptr;
    __gm__ uint8_t* hcMlpNorm = nullptr, *hcMlpDown = nullptr, *hcMlpInj = nullptr, *hcMlpUp = nullptr;
    uint32_t hcIjStride = M15H::HC_IJ_STRIDE_PLANE;
    uint32_t hcAttnMode = M15H::MODE_COMBINE_MIX;
    uint32_t hcMlpMode = M15H::MODE_COMBINE_MIX;
    if (hcAny) {
        H_PfHcFillHost(C, m, mutant);
        H_PfHcH2D(C, m, (mutant == 2u) ? 1u : 0u);
        // 权重指针取**设备**槽（`C.hcWDev` 的 layer 0；与 decode 四相位路 `H_LaunchLayerHc` 同源）；
        // dump 时另取 host 镜像 `C.hcArena`（同一批字节，设备读的就是它 H2D 上去的）。
        const HcWPtrs hw = H_HcWPtrsOf(C.hcWDev, 0u);
        hcH = reinterpret_cast<uint8_t*>(C.pfHcHDev);
        hcBo = reinterpret_cast<uint8_t*>(C.pfHcBoDev);
        hcIj = reinterpret_cast<uint8_t*>(C.pfHcIjDev);
        hcAttnOut = reinterpret_cast<uint8_t*>(C.pfHcAttnOutDev);
        hcAttnNorm = hw.attnNorm; hcAttnDown = hw.attnDown; hcAttnInj = hw.attnInj; hcAttnUp = hw.attnUp;
        hcMlpNorm = hw.mlpNorm; hcMlpDown = hw.mlpDown; hcMlpInj = hw.mlpInj; hcMlpUp = hw.mlpUp;
        // 两个边界都取 MODE_COMBINE_MIX：这样 H1 **物化 H' 进 arena0**（MODE_MIX 不写 H'）⇒
        // 边界 #2 的 hIn（零拷贝取 arena0）才有真输入。层 0 的 attn 边界在真链上是 MODE_MIX
        // （没有 pending BO），本档给的是合成 hcBo ⇒ 取多数档的 MODE_COMBINE_MIX，见 evidence。
        hcAttnMode = M15H::MODE_COMBINE_MIX;
        hcMlpMode = M15H::MODE_COMBINE_MIX;
    }

    // ---- 相位 B 的 E=512（真 shape）MoE 权重 ----
    MoeWPtrs mp = H_MoeWPtrsOf(C.moeWDev, 0u);   // 相位 B 关时用作占位（段体不读这些指针）
    if (phB) {
        if (!C.pfMoe512Loaded) {
            if (C.pfMoe512Host.empty()) {
                C.pfMoe512Host.assign(static_cast<size_t>(C.O.nLayers) * M15L::MOE_W_PREFILL_STRIDE, 0u);
            }
            std::string err;
            const double t0 = H_NowMs();
            for (uint32_t L = 0; L < C.O.nLayers; ++L) {
                if (!H_LoadMoeSlot512(C.M, L, C.pfMoe512Host, C.pfMoeRouter512H, C.pfMoeSgate512H, err)) {
                    printf("[m15][FAIL] E=512 MoE 权重装载失败（layer %u）: %s\n", L, err.c_str());
                    return false;
                }
            }
            const size_t bytes = static_cast<size_t>(C.O.nLayers) * M15L::MOE_W_PREFILL_STRIDE;
            H_H2D(C, C.pfMoeWPrefillDev, C.pfMoe512Host.data(), bytes, "pf_moe_w512");
            C.pfMoe512Loaded = true;
            printf("[m15]   %s：E=512 MoE 权重装载（真 shape）：%u 层 × %.2f MB = %.2f GB，耗时 %.1f ms\n", tag,
                   C.O.nLayers, static_cast<double>(M15L::MOE_W_PREFILL_STRIDE) / 1e6,
                   static_cast<double>(bytes) / 1e9, H_NowMs() - t0);
        }
        const MoeWPrefillPtrs p5 = H_MoeWPrefillPtrsOf(C.pfMoeWPrefillDev, 0u);
        mp.router = p5.router; mp.sgate = p5.sgate; mp.wGu = p5.wGu; mp.sGu = p5.sGu;
        mp.wDn = p5.wDn; mp.sDn = p5.sDn; mp.wGuShd = p5.wGuShd; mp.sGuShd = p5.sGuShd;
        mp.wDnShd = p5.wDnShd; mp.sDnShd = p5.sDnShd; mp.g1 = p5.g1; mp.g2 = p5.g2;
        H_PfGdnBuildRouterWPad(C, C.pfMoeRouter512H.data(), C.pfMoeSgate512H.data());
    } else {
        // 相位 B 关：router pad 平面仍按 E=512 组板（保证"开了就真"的形态一致；段体不读它）
        if (!C.pfMoeRouter512H.empty()) {
            H_PfGdnBuildRouterWPad(C, C.pfMoeRouter512H.data(), C.pfMoeSgate512H.data());
        }
    }
    // 相位 B 的输入选择交给 kernel 内的相位判据（`M15L_PrefillPhaseB` 只在本相位被允许时才跑，
    // 且用 `pfStageMask` 判 H2 是否开）⇒ 这里始终传真指针（H2 的重定位目标就是它）。
    __gm__ uint8_t* const blk1 = reinterpret_cast<uint8_t*>(C.pfHcBlk1Dev);
    // 相位 B **实际**用的输入面（与 kernel 内 `M15L_PrefillPhaseB` 的同一判据）：H1/H2 都没开时
    // （例：只开相位 B 的隔离档 `M15_PREFILL_PHASES=8`）kernel 走 `A.xLayer` = `pfXDev` ⇒ 那一档
    // 必须先把 `pfXDev` 填成确定性平面（`H_PfFillMoeIn`），否则读到的是未初始化内容。
    const bool moeInFromH2 = hcAny && phH2 && (C.pfHcBlk1Dev != nullptr);
    C.pfMoeInDev = moeInFromH2 ? C.pfHcBlk1Dev : C.pfXDev;
    if (!moeInFromH2) {
        H_PfFillMoeIn(C, m);
    }

    // M140 复审 r1：MoE 的输入面按 `MT` 行分块读 ⇒ `pfHcBlk1` 的**尾块 pad 行**（`[m, tiles*MT)`）
    // 每次起 kernel 前置零（不是 `0xCD`）：链读到最后一块时会读到它们。**H2 关时不置零** ——
    // 那样整块面保持未写（`0xCD`），"未开相位不得看起来有产出"的反面判据才有证据。
    // M140 复审 r2：`M15_PREFILL_NO_PAD=1` 只关掉**这一步置零**（分配尺寸与其余代码逐字节不动）
    // ⇒ 这是"pad 置零"这个变量的**单变量 A/B** 控制侧（r1 的那次实验同时改了分配尺寸，不算）。
    if (phH2 && C.O.pfNoPad == 0u) {
        const size_t rowB = static_cast<size_t>(M15H::HID) * 2u;
        const size_t padRows = ((static_cast<size_t>(m) + M15PFR::MT - 1u) / M15PFR::MT) * M15PFR::MT - m;
        if (padRows > 0u) {
            aclrtMemset(reinterpret_cast<uint8_t*>(C.pfHcBlk1Dev) + static_cast<size_t>(m) * rowB,
                        padRows * rowB, static_cast<int32_t>(C.O.pfPadByte), padRows * rowB);
        }
    } else if (phH2) {
        printf("[m15]   %s：M15_PREFILL_NO_PAD=1 ⇒ **跳过**尾块 pad 置零（单变量 A/B 的控制侧）\n", tag);
    }
    if (phH2 && C.O.pfNoPad == 0u && C.O.pfPadByte != 0u) {
        printf("[m15]   %s：尾块 pad 行填充字节 = 0x%02X（内容控制侧；与 pad=0x00 的 memset 尺寸相同）\n",
               tag, C.O.pfPadByte);
    }

    auto PfLaunch = [&](uint32_t mask) {
        M15L::m15_layer_kernel_gdn_prefill<<<C.numBlocks, 0, C.stream>>>(
            reinterpret_cast<uint8_t*>(C.pfMoeWsDev), reinterpret_cast<uint8_t*>(C.pfXDev),
            reinterpret_cast<uint8_t*>(C.resZeroDev), reinterpret_cast<uint8_t*>(C.pfYDev),
            reinterpret_cast<uint8_t*>(C.resZeroDev), nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
            nullptr, nullptr, nullptr, reinterpret_cast<uint8_t*>(C.pfGdnStateDev), mp.router, mp.sgate, mp.wGu,
            mp.sGu, mp.wDn, mp.sDn, mp.wGuShd, mp.sGuShd, mp.wDnShd, mp.sDnShd, mp.g1, mp.g2, m,
            M15L::MOE_TOPK_PREFILL, nullptr, nullptr, nullptr, nullptr,
            reinterpret_cast<uint8_t*>(C.pfPosDev), nullptr, nullptr, nullptr,
            /*pfPosBase*/ 0u, M15L::PF_LAYER_K_NONE, /*pfStageMask*/ mask,
            /*pfWired*/ 1u, /*pfMutant*/ 0u,
            reinterpret_cast<uint8_t*>(C.pfGdnQDev), reinterpret_cast<uint8_t*>(C.pfGdnKDev),
            reinterpret_cast<uint8_t*>(C.pfGdnVDev), reinterpret_cast<uint8_t*>(C.pfGdnGDev),
            reinterpret_cast<uint8_t*>(C.pfGdnBetaDev), reinterpret_cast<uint8_t*>(C.pfGdnODev),
            reinterpret_cast<uint8_t*>(C.pfGdnScratchDev), reinterpret_cast<uint8_t*>(C.pfMoeRouterWPadDev),
            reinterpret_cast<uint8_t*>(C.pfHcArena0Dev), reinterpret_cast<uint8_t*>(C.pfHcArena1Dev),
            reinterpret_cast<uint8_t*>(C.pfHcBlk0Dev), blk1,
            reinterpret_cast<uint8_t*>(C.pfHcIj0Dev),
            /* ---- M140：hc 层界/权重（15 项）---- */
            hcH, hcBo, hcIj, hcAttnOut, hcAttnNorm, hcAttnDown, hcAttnInj, hcAttnUp, hcMlpNorm, hcMlpDown,
            hcMlpInj, hcMlpUp, hcIjStride, hcAttnMode, hcMlpMode,
            /* ---- M197：attention 前端 scratch + w/cs（本档 kind=gdn，不用）---- */
            nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr);
    };
    // M164：epilog 依赖 prolog（z 源 = S2 的 pfQkvzbaDev）；prolog 关时本档不挂 epilog（已在 H_PfSegAlloc 提示）。
    const bool epilogOn = (C.O.pfEpilog != 0u) && prologOn;
    // M175：`M15_PREFILL_EPILOG_MUT` 越界（只有 0..4 有定义）**不得静默当 clean 报 ALL PASS** —— 响亮失败，
    // 且计入 `C.fails` 让最终判定不再是 ALL PASS（解析时的 WARN 与 `pfEpilogMutOor` 见 H_ParseOpts）。
    if (epilogOn && C.O.pfEpilogMutOor != 0u) {
        printf("[m15][FAIL] %s：M15_PREFILL_EPILOG_MUT=%u 越界（只有 0..4 有定义）⇒ 本档按失败处理\n", tag,
               C.O.pfEpilogMutOor);
        C.fails++;
        return false;
    }
    if (prologOn) {
        // M151：prolog 档分三步 —— ① H1 单独起一次（产 BLK `pfHcBlk0`）；
        // ② S2 in_proj + S3 prolog（两段独立 `__global__`，写 q/k/v/g/β）；③ 其余相位读设备产出。
        // M164：挂 epilog 时第 ③ 步再拆成 A 与 H2|B 两次，中间插「转位 → S5 → S6 → hcAttnOut」——
        // H2 的 combine 读 bo=hcAttnOut，A 与 H2 同一次 launch 就插不进去。
        const uint32_t rest = ph & ~M15L::PF_STAGE_H1;
        const uint32_t aMask = rest & M15L::PF_STAGE_A;
        const uint32_t h2bMask = rest & (M15L::PF_STAGE_H2 | M15L::PF_STAGE_B);
        if (epilogOn && aMask == 0u) {
            printf("[m15][FAIL] %s：M15_PREFILL_EPILOG=1 但相位 A 不在掩码（rest=0x%X）⇒ wsO 无生产者，"
                   "epilog 无可挂（请给 H1|A|H2，M15_PREFILL_PHASES=7）\n", tag, rest);
            C.fails++;
            return false;
        }
        printf("[m15]   %s：M151 prolog 档 —— ① H1 起（产 BLK）→ ② S2+S3%s → ③ 相位掩码 0x%X\n", tag,
               epilogOn ? "（M164：A 单独起 → epilog → H2|B）" : "", rest);
        fflush(stdout);
        PfLaunch(M15L::PF_STAGE_H1);
        if (!H_Sync(C, "pfgdn_h1")) {
            return false;
        }
        if (!H_PfPrologRun(C, m, C.O.pfPrologMut, tag)) {
            return false;
        }
        if (epilogOn) {
            PfLaunch(aMask);
            if (!H_Sync(C, "pfgdn_a")) {
                return false;
            }
            if (!H_PfEpilogRun(C, m, C.O.pfEpilogMut, tag)) {
                return false;
            }
            if (h2bMask != 0u) {
                PfLaunch(h2bMask);
                if (!H_Sync(C, "pfgdn_h2b")) {
                    return false;
                }
            }
        } else if (rest == 0u) {
            printf("[m15][WARN] %s：prolog 档的其余相位掩码为 0（相位 A 未跑）—— 请给 H1|A（M15_PREFILL_PHASES=3）\n",
                   tag);
        } else {
            PfLaunch(rest);
            if (!H_Sync(C, "pfgdn_rest")) {
                return false;
            }
        }
    } else {
        if (C.O.pfEpilog != 0u) {
            printf("[m15][WARN] %s：M15_PREFILL_EPILOG=1 但 M15_PREFILL_PROLOG=0 ⇒ epilog 的 z 源无生产者，"
                   "本档不挂 epilog\n", tag);
        }
        printf("[m15]   %s：GDN 段入口启动（m=%u，相位掩码 0x%X，真指针 = q/k/v/g/β/o/state/scratch/"
               "routerWPad/hc*/moe*）…\n", tag, m, ph);
        fflush(stdout);
        PfLaunch(ph);
        if (!H_Sync(C, "pfgdn")) {
            return false;
        }
    }
    printf("[m15]   %s：GDN 段入口同步返回（D2H o/ht）\n", tag);
    fflush(stdout);
    C.pfGdnOHost.assign(vB / 4u, 0.0f);
    C.pfGdnHtHost.assign(hB / 4u, 0.0f);
    if (phA) {
        H_D2H(C, C.pfGdnOHost.data(), C.pfGdnODev, vB, "pfgdn_o");
    }
    H_D2H(C, C.pfGdnHtHost.data(), C.pfGdnStateDev, hB, "pfgdn_ht");

    double maxO = 0.0;
    double maxH = 0.0;
    size_t badO = 0, badH = 0, zeroO = 0;
    for (float x : C.pfGdnOHost) {
        if (!std::isfinite(x)) {
            ++badO;
            continue;
        }
        maxO = std::max(maxO, std::fabs(static_cast<double>(x)));
        if (x == 0.0f) {
            ++zeroO;
        }
    }
    for (float x : C.pfGdnHtHost) {
        if (!std::isfinite(x)) {
            ++badH;
            continue;
        }
        maxH = std::max(maxH, std::fabs(static_cast<double>(x)));
    }
    printf("[m15]   %s：m=%u mutant=%u ⇒ o 非有限 %zu、max|o|=%.4e、零元素 %zu/%zu；ht 非有限 %zu、max|ht|=%.4e\n",
           tag, m, mutant, badO, maxO, zeroO, C.pfGdnOHost.size(), badH, maxH);
    bool ok = true;
    if (phA) {
        if (prologOn) {
            // M151：真权重 +（bring-up 的宿主合成激活）下，m>1 的 GDN 递推含 `exp(-Σg)` 级数，
            // 会溢出 ⇒ o/ht 出现**非有限**（独立 m23 fp64 参考复现同一 pattern ⇒ PASS，
            // max|Δ|=1.9e-7；见 evidence/m151_prefill_prolog_wiring/README.md §5）。M136 的
            // "有限性"判据为**有界宿主合成输入**校准；prolog 档改判"**非全非有限**"（真产出过值），
            // 正确性权威交给离线 m23 的 T3 对拍。
            ok &= H_CmpOk(C, badO < C.pfGdnOHost.size());
            ok &= H_CmpOk(C, badH < C.pfGdnHtHost.size());
            C.phasePf += 2u;
        } else {
            ok &= H_CmpOk(C, badO == 0u && badH == 0u);
            ok &= H_CmpOk(C, maxO > 0.0);
            ok &= H_CmpOk(C, zeroO < C.pfGdnOHost.size());
            C.phasePf += 3u;
        }
    }
    ok &= H_CmpOk(C, maxH > 0.0);

    // ---- M140：四相位的产出回读 + 非毒值/非全零判据 + dump ----
    if (hcAny) {
        const size_t hpBm = static_cast<size_t>(m) * M15H::HYPER * 2u;
        const size_t hidBm = static_cast<size_t>(m) * M15H::HID * 2u;
        const size_t ijBm = (static_cast<size_t>(m) + M15H::M_MAX) * M15H::IJ_STRIDE * 2u;
        C.pfHcArena0H.assign(hpBm, 0u);
        C.pfHcArena1H.assign(hpBm, 0u);
        C.pfHcBlk0H.assign(hidBm, 0u);
        C.pfHcBlk1H.assign(hidBm, 0u);
        C.pfHcIj0H.assign(ijBm, 0u);
        // 回读**总是**做（不按相位开关跳过）：未开的相位必须能被"回读了才知道它没被写"，
        // 否则"未开相位保持毒值"这句话就没有证据（M140 复审 r1 P2-1 点名的正是这一处）。
        H_D2H(C, C.pfHcArena0H.data(), C.pfHcArena0Dev, hpBm, "pf_hc_arena0");
        H_D2H(C, C.pfHcBlk0H.data(), C.pfHcBlk0Dev, hidBm, "pf_hc_blk0");
        H_D2H(C, C.pfHcIj0H.data(), C.pfHcIj0Dev, ijBm, "pf_hc_ij0");
        H_D2H(C, C.pfHcArena1H.data(), C.pfHcArena1Dev, hpBm, "pf_hc_arena1");
        H_D2H(C, C.pfHcBlk1H.data(), C.pfHcBlk1Dev, hidBm, "pf_hc_blk1");
        size_t a0pois = 0, a0zero = 0, b0pois = 0, b0zero = 0, a1pois = 0, a1zero = 0,
               b1pois = 0, b1zero = 0;
        const auto plane = [](const std::vector<uint8_t>& v, size_t& pois, size_t& zr) {
            for (size_t i = 0; i + 1u < v.size(); i += 2u) {
                uint16_t b;
                __builtin_memcpy(&b, v.data() + i, 2u);
                if (b == 0xCDCDu) { ++pois; }
                if (b == 0u) { ++zr; }
            }
        };
        plane(C.pfHcArena0H, a0pois, a0zero);
        plane(C.pfHcBlk0H, b0pois, b0zero);
        plane(C.pfHcArena1H, a1pois, a1zero);
        plane(C.pfHcBlk1H, b1pois, b1zero);
        const size_t hpWords = hpBm / 2u, hidWords = hidBm / 2u;
        printf("[m15]   %s：hc H1 ⇒ H' 毒值 %zu/%zu、零 %zu；BLK 毒值 %zu/%zu、零 %zu；"
               "hc H2 ⇒ H' 毒值 %zu/%zu、零 %zu；BLK 毒值 %zu/%zu、零 %zu\n",
               tag, a0pois, hpWords, a0zero, b0pois, hidWords, b0zero, a1pois, hpWords, a1zero,
               b1pois, hidWords, b1zero);
        if (phH1) {
            ok &= H_CmpOk(C, a0pois * 100u < hpWords);       // H1 写了 arena0 的绝大多数行
            ok &= H_CmpOk(C, a0zero < hpWords);
            ok &= H_CmpOk(C, b0pois * 100u < hidWords);
            ok &= H_CmpOk(C, b0zero < hidWords);
            C.phasePf += 3u;
        }
        if (phH2) {
            ok &= H_CmpOk(C, a1pois * 100u < hpWords);
            ok &= H_CmpOk(C, a1zero < hpWords);
            ok &= H_CmpOk(C, b1pois * 100u < hidWords);
            ok &= H_CmpOk(C, b1zero < hidWords);
            C.phasePf += 3u;
        } else {
            // **H2 未开**（p1/p3 档）⇒ arena1/blk1 必须仍是**未写状态**（`0xCD` 毒值）：
            // 这是"未开的相位不得看起来有产出"这条反面判据的落点。回读已在上面无条件做过，
            // 所以这一条在 H2 关的档上**真会执行**（判据读的是设备回读值，不是 host 的零初始化缓冲）。
            ok &= H_CmpOk(C, a1pois + a1zero >= hpWords * 99u / 100u);
            ok &= H_CmpOk(C, b1pois + b1zero >= hidWords * 99u / 100u);
            C.phasePf += 2u;
        }
    }

    if (phB) {
        const size_t moeYB = static_cast<size_t>(m) * M15G::HIDDEN * 2u;
        C.pfMoeYH.assign(moeYB, 0u);
        H_D2H(C, C.pfMoeYH.data(), C.pfYDev, moeYB, "pf_moe_y");
        size_t pois = 0, zr = 0;
        for (size_t i = 0; i + 1u < C.pfMoeYH.size(); i += 2u) {
            uint16_t b;
            __builtin_memcpy(&b, C.pfMoeYH.data() + i, 2u);
            if (b == 0xCDCDu) { ++pois; }
            if (b == 0u) { ++zr; }
        }
        const size_t words = moeYB / 2u;
        printf("[m15]   %s：相位 B（MoE）⇒ y 毒值 %zu/%zu、零 %zu\n", tag, pois, words, zr);
        ok &= H_CmpOk(C, pois * 100u < words);
        ok &= H_CmpOk(C, zr < words);
        C.phasePf += 3u;
        if (!C.pfDumpDir.empty()) {
            H_PfMoeDump26(C, m, tag);
        }
    }

    // M140 复审 r1 P2-3：hc 的落盘**必须在** hcAny 与 phB 两块都跑完之后（原来放在 hcAny 块里，
    // 而 `C.pfMoeYH` 要到 `if (phB)` 才填 ⇒ 落盘的 `moe_y` 是**上一档**的产出）。
    if (!C.pfDumpDir.empty() && hcAny) {
        H_PfHcDump(C, tag, m);
    }

    if (!C.pfDumpDir.empty()) {
        if (!H_PfGdnDump(C, tag, m)) {
            printf("[m15][FAIL] pfgdn dump 写盘失败（%s）\n", tag);
            C.fails++;
        } else {
            printf("[m15]   %s：dump → %s/m23_%s_*.bin（对拍：python3 m23_gdn_prefill/check_ref.py --dir %s）\n",
                   tag, C.pfDumpDir.c_str(), tag, C.pfDumpDir.c_str());
        }
    }
    return ok;
}

// M140：hc 四相位的产出 + 权重落盘（权重来自 host 镜像 `C.hcArena` 的 layer 0，设备读的是同一份）。
// 命名：`m140_h1_{hin,bo,ij,hcp,blk}` / `m140_h2_{bo,hcp,blk}` / `m140_w_{a1,a2}_{norm,down,inj,up}`。
inline void H_PfHcDump(Ctx& C, const char* tag, uint32_t m)
{
    char nm[512];
    auto W = [&](const char* what, const void* p, size_t n) {
        snprintf(nm, sizeof(nm), "%s/m140_%s_%s.bin", C.pfDumpDir.c_str(), tag, what);
        if (!H_WriteBin(nm, p, n)) {
            printf("[m15][FAIL] m140 dump 写盘失败（%s）\n", nm);
            C.fails++;
        }
    };
    const size_t hpB = static_cast<size_t>(m) * M15H::HYPER * 2u;
    const size_t hidB = static_cast<size_t>(m) * M15H::HID * 2u;
    const size_t ijB = static_cast<size_t>(m) * M15H::IJ_STRIDE * 2u;
    W("h1_hin", C.pfHcHH.data(), hpB);
    W("h1_bo", C.pfHcBoH.data(), hidB);
    W("h1_ij", C.pfHcIjH.data(), ijB);
    W("h1_hcp", C.pfHcArena0H.data(), hpB);
    W("h1_blk", C.pfHcBlk0H.data(), hidB);
    W("h1_ij_handoff", C.pfHcIj0H.data(), (static_cast<size_t>(m) + M15H::M_MAX) * M15H::IJ_STRIDE * 2u);
    W("h2_bo", C.pfHcAttnOutH.data(), hidB);
    W("h2_hcp", C.pfHcArena1H.data(), hpB);
    W("h2_blk", C.pfHcBlk1H.data(), hidB);
    if (C.pfMoeYH.size() >= static_cast<size_t>(m) * M15G::HIDDEN * 2u) {
        W("moe_y", C.pfMoeYH.data(), static_cast<size_t>(m) * M15G::HIDDEN * 2u);
    }
    if (!C.pfMoeRouter512H.empty()) {
        W("moe_wpad", C.pfMoeRouter512H.data(), M15L::MWP_ROUTER_BYTES);
    }
    const size_t rowW = static_cast<size_t>(M15H::HYPER) * 2u;
    const HcWPtrs hw = H_HcWPtrsOf(reinterpret_cast<void*>(C.hcArena.data()), 0u);
    struct WSrc { const char* nm; const uint8_t* p; size_t b; };
    const WSrc ws[] = {
        {"w_a1_norm", hw.attnNorm, M15L::HW_NORM_BYTES},
        {"w_a1_down", hw.attnDown, M15L::HW_WDOWN_BYTES},
        {"w_a1_inj", hw.attnInj, M15L::HW_WINJ_BYTES},
        {"w_a1_up", hw.attnUp, M15L::HW_WUP_BYTES},
        {"w_a2_norm", hw.mlpNorm, M15L::HW_NORM_BYTES},
        {"w_a2_down", hw.mlpDown, M15L::HW_WDOWN_BYTES},
        {"w_a2_inj", hw.mlpInj, M15L::HW_WINJ_BYTES},
        {"w_a2_up", hw.mlpUp, M15L::HW_WUP_BYTES},
    };
    for (const WSrc& w : ws) {
        W(w.nm, w.p, w.b);
    }
    (void)rowW;
}

// M140：相位 B 的**数值对拍输入输出**落盘，摆成 `m26_moe_prefill/check_ref.py` 要的格式
// （`m26_{x,wpad,logits,ids,w,sgate}.bin` + `m26_meta.txt`）。口径：
//   · 只落**最后一块 tile**（`MoePrefillChain` 的 ws 在块间复用，跑完后 ws 里只剩最后一块的产物）；
//     meta 的 `m = MT` 都取这一块的行数 `rows` ⇒ 与 m26 的单块档同形。
//   · x = 该块的 `xLayer` 行（相位 B 的输入 = H2 的 BLK 平铺面，见 `M15L_PrefillPhaseB`）。
//   · **按 tag 落子目录** `<dumpdir>/m26_<tag>/`：同一个进程里 main / mut1 / mut2 三个 arm 都调它，
//     共用一个文件名会互相覆盖 ⇒ 子目录让三个 arm 的产物各自可判。
//   · 复用 m26 的判据：`python3 m26_moe_prefill/check_ref.py <dumpdir>/m26_<tag>`。
inline void H_PfMoeDump26(Ctx& C, uint32_t m, const char* tag)
{
    const uint32_t mt = M15PFR::MT;
    const uint32_t nTiles = (m + mt - 1u) / mt;
    const uint32_t row0 = (nTiles - 1u) * mt;
    const uint32_t rows = m - row0;
    char sub[700];
    snprintf(sub, sizeof(sub), "%s/m26_%s", C.pfDumpDir.c_str(), tag);
    if (mkdir(sub, 0755) != 0 && errno != EEXIST) {
        printf("[m15][FAIL] 建 m26 dump 子目录失败：%s\n", sub);
        C.fails++;
        return;
    }
    uint8_t* const ws = reinterpret_cast<uint8_t*>(C.pfMoeWsDev) + M15L::WS_MOE_OFF;
    auto W = [&](const char* nm, const void* p, size_t n) {
        char path[1400];
        snprintf(path, sizeof(path), "%s/%s", sub, nm);
        if (!H_WriteBin(path, p, n)) {
            printf("[m15][FAIL] m26 兼容 dump 写盘失败（%s）\n", path);
            C.fails++;
        }
    };
    auto D2H = [&](const char* nm, void* dev, size_t n) {
        std::vector<uint8_t> h(n, 0u);
        H_D2H(C, h.data(), dev, n, nm);
        W(nm, h.data(), n);
    };
    const size_t hidB = static_cast<size_t>(rows) * M15PFR::HIDDEN * 2u;
    // x = 相位 B **实际**用的输入面（H2 开 ⇒ H2 的 BLK 平铺面；否则 `A.xLayer`）
    std::vector<uint8_t> xh(hidB, 0u);
    __gm__ uint8_t* moeIn = reinterpret_cast<uint8_t*>(C.pfMoeInDev) +
                            static_cast<uint64_t>(row0) * M15PFR::HIDDEN * 2u;
    H_D2H(C, xh.data(), moeIn, hidB, "m26_x");
    W("m26_x.bin", xh.data(), hidB);
    D2H("m26_wpad.bin", C.pfMoeRouterWPadDev,
        static_cast<size_t>(M15PFR::E_PAD) * M15PFR::HIDDEN * 2u);
    D2H("m26_logits.bin", ws + M15PFR::PWS_LOGITS, static_cast<size_t>(rows) * M15PFR::E_PAD * 4u);
    D2H("m26_ids.bin", ws + M15PFR::PWS_IDS, static_cast<size_t>(rows) * M15PFR::TOPK * 4u);
    D2H("m26_w.bin", ws + M15PFR::PWS_W, static_cast<size_t>(rows) * M15PFR::TOPK * 4u);
    D2H("m26_sgate.bin", ws + M15PFR::PWS_SGATE, static_cast<size_t>(rows) * 4u);
    char path[1400];
    snprintf(path, sizeof(path), "%s/m26_meta.txt", sub);
    FILE* f = fopen(path, "w");
    if (f == nullptr) {
        printf("[m15][FAIL] m26_meta.txt 写盘失败\n");
        C.fails++;
        return;
    }
    fprintf(f, "m=%u\nstage=8\ntopk=%u\nE=%u\nE_PAD=%u\nMT=%u\nTP_MAX=%u\nhidden=%u\nnblk=%u\n", rows,
            static_cast<uint32_t>(M15PFR::TOPK), static_cast<uint32_t>(M15PFR::E),
            static_cast<uint32_t>(M15PFR::E_PAD), rows, static_cast<uint32_t>(M15PFR::TP_MAX),
            static_cast<uint32_t>(M15PFR::HIDDEN), C.numBlocks);
    fclose(f);
    printf("[m15]   %s：相位 B 的 m26 兼容 dump（最后一块 rows=%u, row0=%u → %s；对拍："
           "python3 m26_moe_prefill/check_ref.py %s）\n", tag, rows, row0, sub, sub);
}

// ============================================================
// M197：B2（attention 前端）挂进**真实层路径**的设备见证
// ============================================================
// 形态：真实 `__global__` 入口 `m15_layer_kernel_attn_prefill` + `pfWired=1` + `pfStageMask=PF_STAGE_A`
//   （只相位 A），五个 M197 scratch + 权重/cos-sin + `k=0` 的 cache 段全部给真指针。
//   `mUse = 64` = 一个整 m-tile（`AP_BASE_M`），**单 chunk**：行数契约判据因此是精确的
//   （B2 应只写 `[0,64)` 行，`[64,128)` 保持 0xCD 毒值）。
// 判据：
//   ①（正，wired=1）y0 / out / in / kv / ring / comp / pack 从毒值变"活"；且 y0/out 的行数契约成立。
//   ②（负，wired=0）同一输入、同一平面集：结构性占位**不碰**它们 ⇒ **仍是毒**（挂载关掉就不写）。
//   ③ 整条 attention 臂仍按 B3（稠密 core）缺席**响亮失败**（`H_RunPrefill` 的 wire+attn 硬失败），
//      所以本函数的返回值只覆盖 B2 的 wiring 判据，不代表整臂通过。
// ⚠ 本档**不判 B2 的数值**：fp64 判据在 M116 的独立验证路（`m24_attn_prefill`；4097 行 327 checks /
//   m=1 23 checks）。这里证的是「B2 在真实层路径里被调用、写对行、写对平面」这一层。
inline bool H_PfAttnWired(Ctx& C, uint32_t mutant, const char* tag)
{
    using namespace M15G;
    if (C.pfattnY0Dev == nullptr) {
        printf("[m15][FAIL] %s：M197 B2 平面未分配（需 M15_PREFILL_WIRE=1）\n", tag);
        return H_CmpOk(C, false);
    }
    const uint32_t mUse = 64u;   // 一个整 m-tile；见上
    const size_t y0B = static_cast<size_t>(M15PF::PF_ROWS) * M15PF::PF_Y0_STRIDE * 2u;
    const size_t outB = static_cast<size_t>(M15PF::PF_ROWS) * M15PF::PF_OUT_STRIDE * 2u;
    const size_t inB = static_cast<size_t>(M15AC::AC_IN_BYTES);
    const size_t poolB = static_cast<size_t>(M15AC::AC_POOLED_BYTES);
    const size_t flagB = static_cast<size_t>(M15AC::AC_FLAG_LANES) * 4u;
    const size_t kvSeg = static_cast<size_t>(M15Kv::KV_LAYER_STRIDE);
    const size_t compSeg = static_cast<size_t>(M15Kv::COMP_LAYER_STRIDE);
    const size_t ringSeg = static_cast<size_t>(M15Kv::RING_LAYER_BYTES);
    const size_t packSeg = static_cast<size_t>(M15AC::AC_PACK_SEED_BYTES);

    // 确定性非毒输入（w / cs / pack seed）；多档复用（一次生成）。
    if (C.pfattnWHost.empty()) {
        C.pfattnWHost.resize(M15AP::W_BYTES);
        for (size_t i = 0; i < C.pfattnWHost.size(); ++i) {
            C.pfattnWHost[i] = static_cast<uint8_t>((i * 131u + 7u) & 0xFFu);
        }
        C.pfattnCsHost.resize(M15AP::AP_CS_BYTES);
        for (size_t i = 0; i < C.pfattnCsHost.size(); ++i) {
            C.pfattnCsHost[i] = static_cast<uint8_t>((i * 29u + 3u) & 0xFFu);
        }
        C.pfattnPackHost.resize(packSeg);
        for (size_t i = 0; i < C.pfattnPackHost.size(); ++i) {
            C.pfattnPackHost[i] = static_cast<uint8_t>((i * 17u + 5u) & 0xFFu);
        }
    }
    C.pfattnY0H.assign(y0B, 0u);
    C.pfattnOutH.assign(outB, 0u);
    C.pfattnInH.assign(inB, 0u);
    std::vector<uint8_t> hkv(kvSeg, 0u), hcomp(compSeg, 0u), hring(ringSeg, 0u), hpack(packSeg, 0u),
        hpool(poolB, 0u), hflag(flagB, 0u);

    auto Live = [](const std::vector<uint8_t>& v, size_t off, size_t len) -> size_t {
        size_t n = 0;
        for (size_t i = off; i < off + len && i < v.size(); ++i) {
            if (v[i] != 0xCDu) { ++n; }
        }
        return n;
    };
    auto Run = [&](uint32_t wired) -> bool {
        // 每档先重毒（负档判「仍是毒」必须从干净毒值起算）。
        aclrtMemset(C.pfattnY0Dev, y0B, 0xCD, y0B);
        aclrtMemset(C.pfattnOutDev, outB, 0xCD, outB);
        aclrtMemset(C.pfattnInDev, inB, 0xCD, inB);
        aclrtMemset(C.pfattnPooledDev, poolB, 0xCD, poolB);
        aclrtMemset(C.pfattnFlagDev, flagB, 0xCD, flagB);
        aclrtMemset(C.attnKvDev, kvSeg, 0xCD, kvSeg);
        aclrtMemset(C.attnCompDev, compSeg, 0xCD, compSeg);
        aclrtMemset(C.attnRingDev, ringSeg, 0xCD, ringSeg);
        aclrtMemset(C.attnPackDev, packSeg, 0xCD, packSeg);

        H_PfFillX(C.pfXHost, mUse);
        C.pfPosHost.assign(mUse, 0);       // pos 表：行 r ⇒ r（单请求连续；rowStart=0）
        for (uint32_t r = 0; r < mUse; ++r) {
            C.pfPosHost[r] = static_cast<int32_t>(r);
        }
        H_H2D(C, C.pfXDev, C.pfXHost.data(), static_cast<size_t>(mUse) * M15L::PF::ROW_BYTES, "pf_attn_x");
        H_H2D(C, C.pfPosDev, C.pfPosHost.data(), static_cast<size_t>(mUse) * 4u, "pf_attn_pos");
        H_H2D(C, C.pfattnWDev, C.pfattnWHost.data(), M15AP::W_BYTES, "pf_attn_w");
        H_H2D(C, C.pfattnCsDev, C.pfattnCsHost.data(), M15AP::AP_CS_BYTES, "pf_attn_cs");
        H_H2D(C, C.attnPackDev, C.pfattnPackHost.data(), packSeg, "pf_attn_packseed");

        M15L::m15_layer_kernel_attn_prefill<<<C.numBlocks, 0, C.stream>>>(
            nullptr, reinterpret_cast<uint8_t*>(C.pfXDev), nullptr, reinterpret_cast<uint8_t*>(C.pfYDev),
            nullptr, nullptr, nullptr,
            nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
            nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
            mUse, M15L::MOE_TOPK_PREFILL,
            reinterpret_cast<uint8_t*>(C.attnKvDev), reinterpret_cast<uint8_t*>(C.attnCompDev),
            reinterpret_cast<uint8_t*>(C.attnRingDev), reinterpret_cast<uint8_t*>(C.attnPackDev),
            reinterpret_cast<uint8_t*>(C.pfPosDev), nullptr, nullptr, nullptr,
            /*pfPosBase*/ 0u, /*pfLayerK*/ 0u, /*pfStageMask*/ M15L::PF_STAGE_A, wired, mutant,
            nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
            nullptr, nullptr,
            nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr, nullptr,
            nullptr, M15H::HC_IJ_STRIDE_PLANE, M15H::MODE_COMBINE_MIX, M15H::MODE_COMBINE_MIX,
            reinterpret_cast<uint8_t*>(C.pfattnY0Dev), reinterpret_cast<uint8_t*>(C.pfattnOutDev),
            reinterpret_cast<uint8_t*>(C.pfattnInDev), reinterpret_cast<uint8_t*>(C.pfattnPooledDev),
            reinterpret_cast<uint8_t*>(C.pfattnFlagDev),
            reinterpret_cast<uint8_t*>(C.pfattnWDev), reinterpret_cast<uint8_t*>(C.pfattnCsDev));
        if (!H_Sync(C, "pf_attn_wired")) {
            return false;
        }
        H_D2H(C, C.pfattnY0H.data(), C.pfattnY0Dev, y0B, "pf_attn_y0");
        H_D2H(C, C.pfattnOutH.data(), C.pfattnOutDev, outB, "pf_attn_out");
        H_D2H(C, C.pfattnInH.data(), C.pfattnInDev, inB, "pf_attn_in");
        H_D2H(C, hkv.data(), C.attnKvDev, kvSeg, "pf_attn_kv");
        H_D2H(C, hcomp.data(), C.attnCompDev, compSeg, "pf_attn_comp");
        H_D2H(C, hring.data(), C.attnRingDev, ringSeg, "pf_attn_ring");
        H_D2H(C, hpack.data(), C.attnPackDev, packSeg, "pf_attn_pack");
        H_D2H(C, hpool.data(), C.pfattnPooledDev, poolB, "pf_attn_pooled");
        H_D2H(C, hflag.data(), C.pfattnFlagDev, flagB, "pf_attn_flag");
        return true;
    };

    bool ok = true;
    // ---- ① 正档：wired=1 ----
    if (!Run(1u)) {
        return false;
    }
    const size_t y0Row = static_cast<size_t>(M15PF::PF_Y0_STRIDE) * 2u;
    const size_t outRow = static_cast<size_t>(M15PF::PF_OUT_STRIDE) * 2u;
    uint32_t y0LiveRows = 0, y0PoisonAfter = 0, outLiveRows = 0, outPoisonAfter = 0;
    for (uint32_t r = 0; r < M15PF::PF_ROWS; ++r) {
        const bool y0Live = Live(C.pfattnY0H, static_cast<size_t>(r) * y0Row, y0Row) > 0u;
        const bool outLive = Live(C.pfattnOutH, static_cast<size_t>(r) * outRow, outRow) > 0u;
        if (r < mUse) { y0LiveRows += y0Live ? 1u : 0u; outLiveRows += outLive ? 1u : 0u; }
        else { y0PoisonAfter += y0Live ? 1u : 0u; outPoisonAfter += outLive ? 1u : 0u; }
    }
    const size_t inLive = Live(C.pfattnInH, 0u, inB);
    const size_t kvLive = Live(hkv, 0u, kvSeg);
    const size_t compLive = Live(hcomp, 0u, compSeg);
    const size_t ringLive = Live(hring, 0u, ringSeg);
    const size_t packLive = Live(hpack, 0u, packSeg);
    const size_t poolLive = Live(hpool, 0u, poolB);
    const size_t flagLive = Live(hflag, 0u, flagB);
    printf("[m15]   %s：M197 B2 层路径（wired=1, mUse=%u）⇒ y0 活行 %u/%u（[%u,128) 仍毒 %u）"
           "、out 活行 %u（尾毒 %u）、in 活字节 %zu、kv %zu、comp %zu、ring %zu、pack %zu、"
           "pooled %zu、flag %zu\n",
           tag, mUse, y0LiveRows, mUse, mUse, y0PoisonAfter, outLiveRows, outPoisonAfter, inLive, kvLive,
           compLive, ringLive, packLive, poolLive, flagLive);
    ok &= H_CmpOk(C, y0LiveRows == mUse);          // B2 在层路径里写了 chunks 覆盖的行（y0）
    ok &= H_CmpOk(C, y0PoisonAfter == 0u);         // 行数契约：chunk 外不得被写
    ok &= H_CmpOk(C, outLiveRows == mUse);
    ok &= H_CmpOk(C, outPoisonAfter == 0u);
    ok &= H_CmpOk(C, inLive > 0u);                 // cache 输入面被写
    ok &= H_CmpOk(C, kvLive > 0u);                 // 主 KV（k=0）被写
    ok &= H_CmpOk(C, ringLive > 0u);               // raw ring（k=0）被写
    ok &= H_CmpOk(C, packLive > 0u);               // packed seed 被抄写
    ok &= H_CmpOk(C, flagLive > 0u);               // 门控 lane 被写

    // ---- ② 负档：wired=0（结构性占位）⇒ 这些平面必须**仍是毒** ----
    // 只在 `mutant == 0` 的契约档做（负向对照档不复用本函数；见 H_RunPrefill）。
    if (mutant == 0u) {
        if (!Run(0u)) {
            return false;
        }
        const size_t y0Any = Live(C.pfattnY0H, 0u, y0B);
        const size_t outAny = Live(C.pfattnOutH, 0u, outB);
        const size_t inAny = Live(C.pfattnInH, 0u, inB);
        const size_t kvAny = Live(hkv, 0u, kvSeg);
        const size_t ringAny = Live(hring, 0u, ringSeg);
        // `pack` **不判**：它是 B2 的**输入** plane（packed seed，由本档 H2D 预置）⇒ 无论挂载开关
        // 都会"活"。判它恒真/恒假都没有咬合力，故从负控里排除（正档仍记它的活字节数）。
        printf("[m15]   %s：M197 B2 负控（wired=0）⇒ y0 活字节 %zu、out %zu、in %zu、kv %zu、ring %zu"
               "（应全 0 = 挂载关掉不写，仍是毒；pack 是输入 seed 面，不判）\n",
               tag, y0Any, outAny, inAny, kvAny, ringAny);
        ok &= H_CmpOk(C, y0Any == 0u && outAny == 0u && inAny == 0u && kvAny == 0u && ringAny == 0u);
    }
    // ③：整臂的响亮失败由 H_RunPrefill 的 wire+attn 硬失败负责，这里显式记一行（不吞掉那条判据）。
    printf("[m15]   %s：M197 注意 —— B2 已在层路径产出；**B3（稠密 causal core）未接** ⇒ 整条 attention "
           "臂仍按 H_RunPrefill 的 wire+attn 硬失败（响亮失败，rc≠0）\n", tag);
    return ok;
}

inline bool H_PfArm(Ctx& C, uint32_t m, uint32_t kind, uint32_t wired, uint32_t mutant, const char* tag)
{
    // M136（Wave D）：wired=1 走**真指针 + 段体真产出**判据（GDN = B1 段体；attn = M197 的 B2 挂载见证）。
    if (wired != 0u) {
        if (kind == M15Loop::KIND_GDN) {
            return H_PfGdnWired(C, m, mutant, tag);
        }
        // M197：attention 前端（B2）已挂进层路径 ⇒ 走 B2 的 wiring 见证。
        // `H_PfAttnWired` 内部固定 `mUse = 64`（单 chunk = 1 m-tile，行数判据精确）⇒ 两个 pfMs
        // 档（1 / 4097）只跑一次，避免重复。**注意整臂仍按 B3 缺席响亮失败**（见 H_RunPrefill）。
        if (m > 128u) {
            return true;
        }
        return H_PfAttnWired(C, mutant, tag);
    }
    using namespace M15G;
    const size_t rowBytes = M15L::PF::ROW_BYTES;
    const size_t planeBytes = static_cast<size_t>(m) * rowBytes;

    M15Pf::H_PfFillX(C.pfXHost, m);
    C.pfYHost.assign(planeBytes, 0xA5u);
    H_H2D(C, C.pfXDev, C.pfXHost.data(), planeBytes, "pf_x");
    H_H2D(C, C.pfYDev, C.pfYHost.data(), planeBytes, "pf_y_poison");
    // pos 表：单请求连续 ⇒ 第 r 行 = r（`pfPos` 与 `pfPosBase + r` 两条路给出同一个值）
    C.pfPosHost.assign(M15Loop::M_PREFILL, 0);
    for (uint32_t r = 0; r < M15Loop::M_PREFILL; ++r) {
        C.pfPosHost[r] = static_cast<int32_t>(r);
    }
    H_H2D(C, C.pfPosDev, C.pfPosHost.data(), static_cast<size_t>(M15Loop::M_PREFILL) * 4u, "pf_pos");

    __gm__ uint8_t* const nil = nullptr;
    if (kind == M15Loop::KIND_GDN) {
        M15L::m15_layer_kernel_gdn_prefill<<<C.numBlocks, 0, C.stream>>>(
            nil, reinterpret_cast<uint8_t*>(C.pfXDev), nil, reinterpret_cast<uint8_t*>(C.pfYDev), nil, nil, nil,
            nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil,
            m, M15L::MOE_TOPK_PREFILL,
            nil, nil, nil, nil, reinterpret_cast<uint8_t*>(C.pfPosDev), nil, nil, nil,
            /*pfPosBase*/ 0u, M15L::PF_LAYER_K_NONE, /*pfStageMask*/ 0u, wired, mutant,
            // M132：B1/B4/B5 段体实参（wsQ..wsGdnPrefillScratch / pfMoeRouterWPad / pfHcArena0/1+Blk0/1+Ij0）
            // —— 本档**全部 nil**：真指针的 host 组装归 Wave D；缺省 wired=0 ⇒ 段体不进这些字段。
            nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil,
            // M140：hc 层界/权重的 15 个实参（本档全 nil：wired=0 不触达；真指针见 H_PfGdnWired）
            nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, M15H::HC_IJ_STRIDE_PLANE,
            M15H::MODE_COMBINE_MIX, M15H::MODE_COMBINE_MIX,
            /* M197：attention 前端 scratch + w/cs（本档 wired=0/kind=gdn，不用）*/ nil, nil, nil, nil, nil, nil,
            nil);
    } else {
        M15L::m15_layer_kernel_attn_prefill<<<C.numBlocks, 0, C.stream>>>(
            nil, reinterpret_cast<uint8_t*>(C.pfXDev), nil, reinterpret_cast<uint8_t*>(C.pfYDev), nil, nil, nil,
            nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil,
            m, M15L::MOE_TOPK_PREFILL,
            nil, nil, nil, nil, reinterpret_cast<uint8_t*>(C.pfPosDev), nil, nil, nil,
            /*pfPosBase*/ 0u, /*pfLayerK*/ 0u, /*pfStageMask*/ 0u, wired, mutant,
            // M132：同 GDN 支——段体实参全 nil（真指针归 Wave D）。
            nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil,
            nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, nil, M15H::HC_IJ_STRIDE_PLANE,
            M15H::MODE_COMBINE_MIX, M15H::MODE_COMBINE_MIX,
            /* M197：attention 前端 scratch + w/cs（wired=0 不触达）*/ nil, nil, nil, nil, nil, nil, nil);
    }
    if (!H_Sync(C, "pf_arm")) {
        return false;
    }
    H_D2H(C, C.pfYHost.data(), C.pfYDev, planeBytes, "pf_y_out");

    const M15Pf::PfJudge J = M15Pf::H_PfJudge(C.pfXHost, C.pfYHost, m);
    printf("[m15]   %s：m=%u kind=%s wired=%u mutant=%u ⇒ 行标记命中 %u/%u、整面相等 %u/%u、毒值行 %u",
           tag, m, (kind == M15Loop::KIND_GDN) ? "gdn" : "attn", wired, mutant, m - J.tagMiss, m, J.fullEqual, m,
           J.poisonRows);
    if (!J.firstOffenders.empty()) {
        printf("（首个未命中行 %u/%u/%u）", J.firstOffenders[0],
               J.firstOffenders.size() > 1u ? J.firstOffenders[1] : J.firstOffenders[0],
               J.firstOffenders.size() > 2u ? J.firstOffenders[2] : J.firstOffenders[0]);
    }
    printf("\n");

    bool ok = true;
    if (wired == 0u && mutant == 0u) {
        // ---- 交付形态（段体未落地）：逐行标记全中 + 整面逐字节 + 无一行是毒值 ----
        ok &= H_CmpOk(C, J.tagMiss == 0u);
        ok &= H_CmpOk(C, J.poisonRows == 0u);
        ok &= H_CmpOk(C, J.fullEqual == m);
    } else if (mutant != 0u) {
        // ---- 负向对照：行循环被截到 M_MAX ⇒ 恰有 (m − M_MAX) 行从未被写（毒值 + 标记不命中）----
        const uint32_t expectMiss = (m > M15G::M_MAX) ? (m - M15G::M_MAX) : 0u;
        ok &= H_CmpOk(C, J.poisonRows == expectMiss);
        ok &= H_CmpOk(C, J.tagMiss == expectMiss);
        ok &= H_CmpOk(C, J.fullEqual == m - expectMiss);
    } else {
        // M136：wired != 0 在函数开头已转走（GDN → 段体真产出；attn → 响亮失败）⇒ 本支不可达。
        // 保留一条显式的"不应到达"：改接线的人若把转走逻辑删了，这里会立刻变红而不是静默通过。
        ok &= H_CmpOk(C, false);
    }
    C.phasePf += 3u;
    return ok;
}

inline bool H_RunPrefill(Ctx& C)
{
    using namespace M15G;
    bool ok = true;

    // ---- 契约常量（guard：恒真前置，不计入判定项）----
    ok &= H_Guard(C, M15L::PF_LAYER_K_NONE == M15Loop::NO_SLOT);
    ok &= H_Guard(C, M15L::PF::ROW_BYTES == static_cast<uint32_t>(HIDDEN) * 2u);
    // M136（Wave D）：旧的 `PREFILL_WIRED == pfWire` 守卫已过期 —— `PREFILL_WIRED`（编译期）仍是 0
    // （attention 的 3 个峰值槽未填，B3 未合入），而运行期 `M15_PREFILL_WIRE=1` 现在对 **KIND_GDN**
    // 已兑现（真指针 + 段体真产出）。两者不再要求相等；改为**显式打印 + attention 的响亮失败**。
    printf("[m15]   M136：编译期接线门 PREFILL_WIRED=%u（0 = attention 峰值槽未填）；运行期 "
           "M15_PREFILL_WIRE=%u（1 = GDN 走真段体）\n", M15L::PREFILL_WIRED, C.O.pfWire);
    if (C.O.pfWire != 0u && (C.O.pfKinds == 2u || C.O.pfKinds == 3u)) {
        // M197：B2（前端）**已挂载**（层路径会产出 y0/out/cache），但 **B3（稠密 causal core）未接**
        // ⇒ 整条 attention 臂仍不完整（核心输出 / subOut 无生产者）⇒ **响亮失败**，不给"开了却飘绿"。
        printf("[m15][FAIL] M15_PREFILL_WIRE=1 且 M15_PREFILL_KIND=%u 含 attention：B2 前端已挂载（部分产出），"
               "但 B3（稠密 causal core）未接 ⇒ 整条 attention 臂不完整（响亮失败，rc≠0）\n",
               C.O.pfKinds);
        ok &= H_CmpOk(C, false);
    }
    ok &= H_Guard(C, M15L::ENTRY_TABLE_N == 9u);
    ok &= H_Guard(C, M15L::MOE_TOPK_PREFILL == 10u && M15L::MOE_E_PREFILL == 512u);
    // M132（Wave C）：B1/B4/B5 的 5 个峰值槽已填实数 ⇒ 余数从 8 降到 3；余下的 3 个**全部且只是**
    // KIND_ATTN 的 UB/L1/L0C（B2+B3 本轮不接，见 §3c 的槽定义）。这也是 `PREFILL_WIRED` 必须保持
    // 0 的算术原因：attention 的槽未填 ⇒ 接线门（`m15_layer_resources.h:550`）会 FAIL。
    ok &= H_Guard(C, M15L::PfPeakUnfilled() == 3u);
    printf("[m15] M110 prefill 契约与挂载点档：入口 = %s / %s（ENTRY_TABLE 登记；wired 缺省 0），"
           "行宽 %u B，平面按 %u 行定尺 = %u B/面（decode 档 %u B/面的 %.2f 倍）\n",
           M15L::ENTRY_GDN_PREFILL, M15L::ENTRY_ATTN_PREFILL, M15L::PF::ROW_BYTES, M15Loop::M_PREFILL,
           M15Loop::H_ROWS_BYTES_PF, M15Loop::H_ROWS_BYTES,
           static_cast<double>(M15Loop::H_ROWS_BYTES_PF) / static_cast<double>(M15Loop::H_ROWS_BYTES));
    printf("[m15]   prefill 峰值断言位：未填 %u/%u 个（Wave C 填实数后才允许 PREFILL_WIRED=1）；"
           "MoE 权重槽 prefill 档 stride = %u B/层（decode 档 %u）\n",
           M15L::PfPeakUnfilled(), M15L::PF_PEAK_N, M15L::MOE_W_PREFILL_STRIDE, M15L::MOE_W_STRIDE);
    // ---- 「m=1 + ctx=4097」这一档的容量落点（人类原话：prefill 和 decode 都要照顾到）----
    // decode 侧的上下文上界不在本文件：容量权威是 `m15_attn_kv.h`（M82 已按 prefill 定尺）。
    // M184（2026-10-04）：`DECODE_CTX` 由 4096 改为 4097（旧值 `BlocksFor(4096) = 256` 页，而 token 4096
    // 落在第 257 页 ⇒ 少 1 页）。本行打印 decode 侧的 ctx/页数/compressed 行数，作为该常量的**设备侧
    // 见证**（`runs=prefill` 档：改前 ctx=4096 / 256 页，改后 ctx=4097 / 257 页）。
    printf("[m15]   decode 档的 ctx 容量（KV 权威 m15_attn_kv.h）：DECODE_CTX=%u ⇒ %u 页/层 × %u token/页 = %u token；"
           "PREFILL_M=%u、DECODE_COMP_ROWS=%u；本文件的 M_PREFILL=%u 与它的 PREFILL_M=%u 同一值\n",
           M15Kv::DECODE_CTX, M15Kv::DECODE_BLOCKS, M15Kv::KV_BLOCK_TOKENS,
           M15Kv::DECODE_BLOCKS * M15Kv::KV_BLOCK_TOKENS, M15Kv::PREFILL_M, M15Kv::DECODE_COMP_ROWS,
           M15Loop::M_PREFILL, M15Kv::PREFILL_M);
    ok &= H_Guard(C, M15Kv::PREFILL_BLOCKS * M15Kv::KV_BLOCK_TOKENS >= M15Kv::PREFILL_M);
    ok &= H_Guard(C, M15Loop::M_PREFILL == M15Kv::PREFILL_M);
    ok &= H_Guard(C, M15Kv::DECODE_CTX == M15Kv::PREFILL_M);   // M184：decode ctx 与 prefill 同一 4097 口径

    // ---- 入口登记表核对（host 侧用 strcmp 与将要启动的符号名对照）----
    bool gdnReg = false;
    bool attnReg = false;
    for (uint32_t i = 0; i < M15L::ENTRY_TABLE_N; ++i) {
        const char* s = M15L::ENTRY_TABLE[i].sym;
        if (strcmp(s, M15L::ENTRY_GDN_PREFILL) == 0) {
            gdnReg = (M15L::ENTRY_TABLE[i].kind[0] == 'g' && M15L::ENTRY_TABLE[i].prefill == 1u &&
                      M15L::ENTRY_TABLE[i].wired == 0u && M15L::ENTRY_TABLE[i].hc == 0u);
        }
        if (strcmp(s, M15L::ENTRY_ATTN_PREFILL) == 0) {
            attnReg = (M15L::ENTRY_TABLE[i].kind[0] == 'a' && M15L::ENTRY_TABLE[i].prefill == 1u &&
                       M15L::ENTRY_TABLE[i].wired == 0u && M15L::ENTRY_TABLE[i].hc == 0u);
        }
    }
    printf("[m15]   ENTRY_TABLE 里的两个 prefill 项：gdn=%s attn=%s（kind/prefill/wired/hc 四项逐项核）\n",
           gdnReg ? "登记正确" : "**不匹配**", attnReg ? "登记正确" : "**不匹配**");
    ok &= H_CmpOk(C, gdnReg);
    ok &= H_CmpOk(C, attnReg);
    C.phasePf += 2u;

    // ---- 主档：对 m 列表里每个 m、每个入口，跑**当前开关下的交付形态** ----
    // M136（Wave D）：`M15_PREFILL_WIRE=0`（缺省）走 M110 的结构性判据（逐行 x→y，一字未变）；
    // `=1` 走 **GDN 段体真产出**（真指针 + 相位 A + m23 参考对拍）。KIND_ATTN 在 wire=1 下判红。
    for (size_t mi = 0; mi < C.O.pfMs.size(); ++mi) {
        const uint32_t m = C.O.pfMs[mi];
        if (C.O.pfKinds == 3u || C.O.pfKinds == 1u) {
            ok &= M15Pf::H_PfArm(C, m, M15Loop::KIND_GDN, C.O.pfWire, 0u, "Pf.gdn");
        }
        if (C.O.pfKinds == 3u || C.O.pfKinds == 2u) {
            ok &= M15Pf::H_PfArm(C, m, M15Loop::KIND_ATTN, C.O.pfWire, 0u, "Pf.attn");
        }
    }

    // ---- 负向对照 + 段体真产出的"有牙"证据（只在最大的那个 m 上做，够用且省设备）----
    const uint32_t mBig = C.O.pfMs.empty() ? 1u : C.O.pfMs[C.O.pfMs.size() - 1u];
    if (C.O.pfWire != 0u) {
        // **收口 M132 登记的"默认不跑"的 `Pf.neg.wired`**：wire=1 现在是"段体真产出"（真指针 +
        // 相位 A），这条对照重新**有牙** —— 把送设备的 h0 翻倍（mutant=1）⇒ 设备出口变了，
        // 而 dump 的参考输入仍是干净副本 ⇒ 离线对拍 `check_ref.py --mutant 1 --dir <dir>` **必须变红**。
        // （M132 的 nil-指针响亮失败读数 `err 507015` 属历史；`M15_PREFILL_WIRE_NEG` 已退役。）
        // 标签以 `_mut1` 结尾 ⇒ `check_ref.py` 的干净档自动排除它、`--mutant 1` 自动选中它。
        printf("[m15]   Pf.gdn_mut1：段体真产出的负向对照（只搅动送设备的 h0；对拍命令由 dump 行给出）\n");
        ok &= M15Pf::H_PfArm(C, mBig, M15Loop::KIND_GDN, 1u, 1u, "Pf.gdn_mut1");
        // M140：hc 四相位（H1/H2/B）的负向对照 —— mutant=2 只把**送设备的** hcH 翻倍，
        // host 干净副本仍落盘 ⇒ H1/H2 的 numpy 参考吃干净、设备吃搅动 ⇒ 判据必须变红。
        if ((C.O.pfPhases & (M15L::PF_STAGE_H1 | M15L::PF_STAGE_H2 | M15L::PF_STAGE_B)) != 0u &&
            C.O.pfProlog == 0u) {
            // M151：prolog 档**跳过**这条 —— hcH 扰动会沿 BLK→S2→S3 渗进相位 A 的输入（实测把
            // gating 推成非有限），它不再是"只扰 hc 相位"的对照。prolog 档的负向对照改用下面
            // 的 `Pf.prolog_mut1/2/3`（conv_state 不交接 / 不写 pad 行 / GEMM K−1）。
            printf("[m15]   Pf.gdn_mut2：hc 四相位的负向对照（只搅动送设备的 hcH）\n");
            ok &= M15Pf::H_PfArm(C, mBig, M15Loop::KIND_GDN, 1u, 2u, "Pf.gdn_mut2");
        }
        // M151：prolog 链路的负向对照 —— 只在最大 m 上各跑一档；判红由离线 `check_prolog.py` 完成
        // （mut1 = S3 不交接 conv_state；mut2 = S3 不写 q/k pad 行；mut3 = S2 GEMM K−1）。
        if (C.O.pfProlog != 0u) {
            const uint32_t savedMut = C.O.pfPrologMut;
            const uint32_t savedPh = C.O.pfPhases;
            C.O.pfPhases = savedPh | M15L::PF_STAGE_H1;   // 负向档也要 BLK
            for (uint32_t mm = 1u; mm <= 3u; ++mm) {
                char lbl[32];
                snprintf(lbl, sizeof(lbl), "Pf.prolog_mut%u", mm);
                printf("[m15]   %s：M151 prolog 负向对照（mut=%u）\n", lbl, mm);
                C.O.pfPrologMut = mm;
                ok &= M15Pf::H_PfArm(C, mBig, M15Loop::KIND_GDN, 1u, 0u, lbl);
            }
            C.O.pfPrologMut = savedMut;
            C.O.pfPhases = savedPh;
        }
    } else {
        // 结构性负向对照（行循环截到 M_MAX）—— wire=0 的交付形态下仍然有效（一字未变）。
        ok &= M15Pf::H_PfArm(C, mBig, M15Loop::KIND_GDN, 0u, 1u, "Pf.neg.mutant");
    }
    return ok;
}

}  // namespace M15Pf

}  // namespace M15Run

int32_t main(int32_t argc, char* argv[])
{
    using namespace M15Run;
    using namespace M15G;

    Ctx C;
    H_ParseOpts(C.O);
    std::string manifestPath = (argc > 1) ? argv[1] : "m15_layer_loop/weights_manifest.txt";
    if (getenv("M15_MANIFEST") != nullptr) {
        manifestPath = getenv("M15_MANIFEST");
    }
    const std::string runs = (argc > 2) ? argv[2] : "all";

    printf("[m15] M25 48 层循环骨架：层类型 3:1（每 %u 层 1 个 full attention 占位直通）；"
           "本次跑前 %u 层，token %u，reps %u，权重=%s，dump=%s\n",
           M15Loop::ATTN_INTERVAL, C.O.nLayers, C.O.steps, C.O.reps, C.O.synth ? "合成" : "checkpoint",
           C.O.dump ? "开" : "关");
    printf("[m15] 层类型模式（config.json: full_attention_interval=%u, num_hidden_layers=%u）：", M15Loop::ATTN_INTERVAL,
           M15Loop::NL);

    C.real = !C.O.synth;
    C.manifestPath = manifestPath;
    // M136（Wave D）：GDN prefill 真产出的 m23 兼容 dump 目录（数值对拍用；不设则不落盘）。
    if (getenv("M15_PREFILL_DUMPDIR") != nullptr) {
        C.pfDumpDir = getenv("M15_PREFILL_DUMPDIR");
    }
    if (C.real) {
        if (!H_LoadManifest(manifestPath.c_str(), C.M)) {
            // review P2-5：验收路径**硬失败**，不再静默降级为合成权重。
            printf("\n[m15][FAIL] 读不到 weights manifest：%s\n", manifestPath.c_str());
            printf("[m15][FAIL] 验收档必须用真实 checkpoint 权重。确需合成权重请显式 M15_SYNTH=1（冒烟档）。\n");
            return 1;
        }
    }
    if (C.real) {
        // 用 manifest 里的 layer_kinds（直接来自 config.json）逐层核对本文件的模式推导
        if (C.M.numLayers != M15Loop::NL || C.M.kinds.size() != M15Loop::NL) {
            printf("\n[m15][FAIL] manifest 的 num_layers/layer_kinds 与预期（%u）不符\n", M15Loop::NL);
            return 1;
        }
        uint32_t mismatch = 0;
        for (uint32_t L = 0; L < M15Loop::NL; ++L) {
            const bool isAttn = (M15Loop::KindOf(L) == M15Loop::KIND_ATTN);
            const bool cfgAttn = (C.M.kinds[L] == "full_attention");
            if (isAttn != cfgAttn) {
                printf("\n[m15][FAIL] 层 %u 类型不符：本文件 %s，config %s\n", L, isAttn ? "full_attention" : "linear_attention",
                       C.M.kinds[L].c_str());
                ++mismatch;
            }
        }
        if (mismatch != 0) {
            return 1;
        }
        printf(" %u GDN + %u attention（与 config 逐层一致）\n", M15Loop::N_GDN, M15Loop::N_ATTN);
    } else {
        printf(" %u GDN + %u attention（未核对 config：合成权重模式）\n", M15Loop::N_GDN, M15Loop::N_ATTN);
    }

    // ---- acl ----
    aclInit(nullptr);
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        printf("[m15][FAIL] aclrtSetDevice(0) failed\n");
        return 1;
    }
    aclrtCreateStream(&C.stream);
    int64_t aicNum = 0;
    int64_t aivNum = 0;
    const aclError aicErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    const aclError aivErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum);
    if (aicErr != ACL_SUCCESS || aicNum <= 0) {
        printf("[m15][FAIL] aclrtGetDeviceInfo(AICORE_CORE_NUM) failed (err %d)\n", static_cast<int>(aicErr));
        return 1;
    }
    C.numBlocks = static_cast<uint32_t>(aicNum);
    if (aivErr != ACL_SUCCESS || aivNum != 2 * aicNum) {
        printf("[m15][WARN] VECTOR_CORE_NUM=%ld != 2*AICORE=%ld — mix(1,2) 配对假设存疑\n",
               static_cast<long>(aivNum), static_cast<long>(2 * aicNum));
    }
    printf("[m15] 核配置：%ld AIC + %ld AIV（blockDim=%u，__mix__(1,2)，核数由 API 获取）\n",
           static_cast<long>(aicNum), static_cast<long>(aivNum), C.numBlocks);

    // ---- 状态初值 / 每 token 输入（确定性公式生成，无 rand 状态）----
    C.csInit.resize(static_cast<size_t>(ST) * CH);
    H_GenBf16(C.csInit, 7001u, 1.0f);
    C.ssmInit.resize(static_cast<size_t>(HEADS) * HEAD_D * HEAD_D);
    H_GenF32(C.ssmInit, 7002u, 0.5f, 0.0f);
    for (uint32_t t = 0; t < 8; ++t) {
        C.h0[t].resize(static_cast<size_t>(M_MAX) * HIDDEN, 0);
        H_GenBf16(C.h0[t], 8000u + t, 2.0f);   // 行 0 = 本 token 的层输入（其余行不参与，H2D 只传行 0）
    }

    // ---- 分配 + 装载 ----
    C.W.resize(NL);
    C.R.resize(M15Loop::N_GDN);
    for (H_Ref& R : C.R) {
        H_RefAlloc(R);
    }
    if (!H_Alloc(C)) {
        return 1;
    }
    if (!H_LoadWeights(C)) {
        return 1;
    }
    H_DumpParams(C);

    // ---- 权重来源校验（先于任何层内计算；review P2-1 / M40 扩到 MoE 段）----
    bool ok = true;
    ok &= H_Sha256SelfTest(C);
    if (getenv("M15_SKIP_WCHECK") == nullptr) {
        ok &= H_WeightSourceCheck(C);
        ok &= H_MoeWeightSourceCheck(C);
        ok &= H_HcWeightSourceCheck(C);
    } else {
        C.phaseW = 0;
        C.phaseWh = 0;
    }

    // ---- M25 的三个验证（**独立启动形态**的回归：证明两个段各自、以及拼起来的行为没被
    //      本轮 M40 改动破坏；判据口径与 M25 完全一致，可逐条对照 evidence 归档）----
    if (runs == "all" || runs == "a") {
        ok &= H_RunA(C);
    }
    if (runs == "all" || runs == "b") {
        ok &= H_RunB(C);
    }
    if (runs == "all" || runs == "c") {
        ok &= H_RunC(C);
    }

    // ---- M40 的两个验证（**融合形态**；交付形态的正确性在这里）----
    if (runs == "all" || runs == "m") {
        // 注（M100）：这里**曾经**在 M1 之前把三块 ws 复位到同一个 0xCD 基线（当时为查 `M.moews`
        // 的 4 字节翻面）。**已撤掉**：那个复位改的是**共享的零回归路径**前置，且会把 `M.moews`
        // 的敏感性收窄（借 include 档实测 36 红 → 35 红）—— 判据宁严勿松。`M.moews` 的脆弱性
        // 作为独立 finding 报塔，不在这里动它。
        ok &= H_RunM1(C);
        ok &= H_RunM2(C);
    }
    // ---- M58 的四相位 hc 融合形态（hc(attn) → 子层段 → hc(mlp) → MoE 段）----
    if (runs == "all" || runs == "h") {
        ok &= H_RunH(C);
    }
    // ---- M65：48 层链（四相位入口）+ PLE 打断点 + 末层全局 mixer ----
    if (runs == "all" || runs == "chain" || runs == "x") {
        ok &= H_RunChain(C);
    }
    // ---- M82：attention 三套 cache + packed indices 的布局冻结（容量自检 + 逐字节判据 + 负向对照）----
    if (runs == "all" || runs == "kv") {
        ok &= H_RunKv(C);
    }
    // ---- M88：attention 前端 prolog（主干 q/k 的 GemmaRMSNorm+RoPE + indexer 路）----
    // ⚠ **故意不进 `runs=all`**：本档的 device 探针在 AIV 侧的 mode-2 `CrossCoreWaitFlag` 上**挂死**
    // （根因未隔离，见 evidence/attn_prolog_device_bisect.log），放进 `all` 会让 48 层验收退化成超时。
    // 修好之后应并回 `all`。
    if (runs == "prolog") {
        ok &= H_RunProlog(C);
    }
    // ---- M97：attention 相位 A 接进**融合 kernel** 的接线见证（真实路径；**故意不进 runs=all**）----
    // `runs=all` 的 2068/290/0 是零回归读数，本档会额外起融合 kernel 的 attention 臂（apW 由
    // host 提供）；层 4..11 的铺设不在本 mission，故不并回 `all`。
    if (runs == "attnwire" || runs == "aw") {
        ok &= H_RunAttnWire(C);
    }
    // ---- M100：PLE 段接进**融合 kernel 挂载点**的接线见证（新档 `runs=plewire`；**故意不进
    // `runs=all`**：本档会把层 1 的入口多流态 PLE 化，`runs=all` 的 Ch.ple.* 舍入点判据按设计
    // 假定 PLE 缺席）----
    if (runs == "plewire" || runs == "pw") {
        ok &= H_PleWireRun(C);
    }
    // ---- M110：prefill 的**契约与挂载点**档（新档 `runs=prefill`；**故意不进 `runs=all`**：
    //      它起的是两个 prefill 入口、写的是按 4097 行定尺的激活平面，与 `runs=all` 的 decode
    //      路径零交集；判据的读数与本 mission 的 delivery 一一对应）----
    if (runs == "prefill" || runs == "pf") {
        ok &= M15Pf::H_RunPrefill(C);
    }
    // ---- 计时/msprof（无判据；task4 的段级分解用）----
    if (runs == "p") {
        H_RunP(C);
    }

    // ---- dump manifest ----
    if (C.O.dump) {
        H_DumpMoeLayout("moe_layout.txt");
        printf("[m15] MoE 段布局表：moe_layout.txt（供 check_moe_ref.py 按同一套偏移切片）\n");
        H_DumpHcLayout("hc_layout.txt");
        printf("[m15] hc 段布局表：hc_layout.txt（供 check_hc_ref.py 按同一套偏移切片）\n");
        FILE* f = fopen("dump_manifest.txt", "wb");
        if (f != nullptr) {
            fprintf(f, "# m15 层循环 dump manifest（%s 权重；层数 %u，token %u）\n",
                    C.real ? "真实 checkpoint" : "合成", C.O.nLayers, C.O.steps);
            fprintf(f, "# 命名：L%02u_* = 验证 A（循环中的该层）单次运行的中间量；B_t%u_L%02u_* = 验证 B；"
                       "hc_L%02u_* = 验证 H（四相位 hc 形态）\n",
                    0u, 0u, 0u, 0u);
            for (const std::string& s : C.dumpLines) {
                fputs(s.c_str(), f);
            }
            fclose(f);
            printf("[m15] dump 清单：dump_manifest.txt（%zu 条），供 check_ref.py / check_moe_ref.py / "
                   "check_hc_ref.py\n",
                   C.dumpLines.size());
        }
    }

    printf("\n[m15] 判据分账：权重来源 %u（GDN+MoE）+ %u（hc）+ A %u + B %u + C %u + M1 %u + M2 %u + H %u"
           " + Ch %u + Pw %u + Kv %u + Prolog %u + AttnWire %u + Pf %u = %u 条判定项（聚合判据按 1 条计；"
           "口径见 README §3/§3.7）\n",
           C.phaseW, C.phaseWh, C.phaseA, C.phaseB, C.phaseC, C.phaseMm, C.phaseM2, C.phaseMh, C.phaseCh,
           C.phasePw,
           C.phaseKv, C.phaseProlog, C.phaseAttnWire, C.phasePf, C.checks);
    printf("[m15]   ④ 与 M39 官方单层参考对拍的判据**不在这个数里**：它在 `check_chain_ref.py`"
           "（torch，独立三态退出码与计数），由本程序的 dump 驱动；运行方式见 README。\n");
    // guard 的真实分解（review r1 的 P2-1b：旧版把**全部** guard 都写成「参考链锚点非空」，
    // 而其中 48 条其实是 M58 的 hc 注入行见证）。`其余` 显式打印 —— 新出现的 guard 不会被
    // 静默吸收进任何一类。
    printf("[m15] guard：%u 条（恒真前置断言，**不计入判定项**）：sha256 工具自检 %u + hc 注入行 "
           "[4,16) 全零 %u + 参考链锚点非空 %u + M65 链 %u + 其余 %u\n",
           C.guards, C.guardsSha, C.guardsHc, C.guardsRef, C.guardsCh,
           C.guards - C.guardsSha - C.guardsHc - C.guardsRef - C.guardsCh);
    printf("[m15] ===== %s（checks=%u, guards=%u, fails=%u）=====\n",
           (ok && C.fails == 0) ? "ALL PASS" : "FAILURES PRESENT", C.checks, C.guards, C.fails);

    H_Cleanup(C);
    aclrtDestroyStream(C.stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (ok && C.fails == 0) ? 0 : 1;
}
