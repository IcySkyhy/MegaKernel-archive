/**
 * m95_e512.asc —— M95 的**独立锤点**：把本仓的 S2 router（`m15_moe_layer.h` 的
 *   `M15M::RouterStage`，含 M95-#4 的 **16 块 Sort32 + 4 级二路 MrgSort 归并树**）在
 *   **真实规模档 E=512 / top-10** 上真机跑一遍，逐元素对拍独立银点。
 *
 * 为什么需要它：M95 改的是**实现**（单块 Sort32 → 归并树），"与改前逐字节相同"这条证据不再
 *   适用（改前在 E>32 下**算错**）。只有「在 E>32 的真规模档上、把设备输出钉在独立数值参考上」
 *   才能证明新实现对。M91 的 r1 复审实测过：把归并树末级换序的变异仍能过全部 2068 判定项 +
 *   291 guard + 三条静态判据 ⇒ **形态分析/判据通过不能替代数值对拍**。
 *
 * **溯源三分**（docs/17 §1.3）—— 按 §1.3 的 **①声明输入 / ②上游输出 / ③被判量自身的产物** 逐条列
 *   （工程口径的「被测代码 / 输入 / 参考」说明见上面的段落，两者不是同一种分法，以 §1.3 这张为准；
 *   逐条表见 `m95_README.md` §5）：
 *   · **① 声明输入** = `x.bin`（确定性 Hash3 生成，硬闸门 X1：必须与 `--x-seed` 重建的逐字节相同）
 *     与 `w.bin`（`--w <文件>` 的真实切片，X2：必须与源文件逐字节相同；或 `--w onehot` 的合成构造）。
 *     **J1（ids 逐元素相等）吃 ① ⇒ 它是独立性判据。**
 *   · **② 上游输出** = 银点自己算出的 `log_ref` / `ids_ref` / `w_ref`（`router_topk` 的输出，与设备
 *     无关）。J3 = 设备 logits vs `log_ref`。
 *   · **③ 被判量自身的产物** = **设备的 `router_logits.bin`** —— J2 用它按银点规则复算权重期望值
 *     ⇒ **J2 是「非独立性判据」**（它只在 J3 已把设备 logits 钉住之后，才能把 renorm 与 GEMV 链
 *     分开归因；单独看 J2 证明不了 logits 对）。
 *   ——（以下三条是**工程口径**的说明，与上面的 §1.3 分类并列，不要混用：）
 *   · 被测代码（device-under-test）= `m15_moe_layer.h`（M95 的生成物；`#include M95_HEADER`）
 *     + `m15_moe_resources.h` 的 **E=512/top-10 档**。档位不是手改副本：CMake 在**构建目录**里
 *     按字面替换生成一份资源表副本（只替换 `NUM_EXPERTS = 4` / `TOPK_MAX = 4` 两个字面值，
 *     其余逐字节相同，见 CMakeLists 的 `M95_E`/`M95_TOPK`），且它**排在 include 路径最前**
 *     以遮蔽仓库里那份 ⇒ 被编进去的就是仓库的 `m15_moe_layer.h` 本体。
 *   · 输入 = `--w <文件>`（默认 `m22_router512/data/router_weight.bin`：真实 checkpoint
 *     `layers.0.mlp.gate.weight` bf16[512,2560] 的切片，由 m22 的 `extract_router_weight.py`
 *     抽出并 sha256 入库）或 `--w onehot`（**合成/缩形权重** W[e][k] = (k == e)）；x 由本文件的
 *     `GenActivationsUniform`（与 m7/m22 同款 Hash3，确定性）生成，并**落盘 x.bin 供核对**。
 *   · 参考 = `tools/golden/moe_block_ref.py::router_topk`（M4/M26 独立编写、已建模设备 FTZ 的
 *     CPU 银点）+ 本目录 `check_ref.py` 里显式的容差推导（T3 界）。
 *
 * 为什么不直接跑 m17_moe_real 当锤点：m17 是 E=512 的**整层**参考，但它必须加载 1.24 GiB 的
 *   真实 checkpoint 才能跑（`m17_moe_real/README.md:766-784`），且它的 router 是**它自己那份**
 *   实现（与本段不同源，`m15_layer_loop/README.md:737`）—— 它验证不了**本仓 S2 的新实现**。
 *   本档只跑 router 段（合成/2.5MB 权重），正是人类原话「你测试的时候只测一层，不需要把所有权重
 *   都加载了」的形态。
 *
 * 用法（见同目录 README.md / run_commands.log；所有命令都是实跑过的）：
 *   source /usr/local/Ascend/ascend-toolkit/set_env.sh
 *   cmake -B m15_layer_loop/moe_relift/m95_e512/build -S m15_layer_loop/moe_relift/m95_e512 \
 *         -DCMAKE_BUILD_TYPE=Release
 *   cmake --build m15_layer_loop/moe_relift/m95_e512/build -j4
 *   M95_OUT=/tmp/m95_e512_real ./…/build/m95_e512 --m 33 --seed 5 \
 *       --w m22_router512/data/router_weight.bin
 *   python3.12 m15_layer_loop/moe_relift/m95_e512/check_ref.py /tmp/m95_e512_real \
 *       --w m22_router512/data/router_weight.bin --x-seed 5
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdint>
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <ctime>
#include <string>
#include <vector>
#include <sys/stat.h>

// 被测代码：本仓 S2 router 所在的生成物（档位资源表由 CMake 在构建目录生成并遮蔽）
#include M95_HEADER

// 运行期 topk 上界（= 资源表在 E=512 档的 TOPK_MAX；真规模配置 top-10）
constexpr uint32_t M95_TOPK_RUN = 10;

// ============================================================
// device：单 AIV 块，只跑 S2 router 段（subLimit = 3 = 全开）
// ============================================================
__vector__ __global__ void m95_router_kernel(__gm__ uint8_t* x, __gm__ uint8_t* rw,
                                             __gm__ uint8_t* sg, __gm__ uint8_t* logits,
                                             __gm__ uint8_t* ids, __gm__ uint8_t* weights,
                                             __gm__ uint8_t* sgate, uint32_t m, uint32_t topk)
{
    M15M::RouterStage op;
    op.Init(x, rw, sg, logits, ids, weights, sgate, m, topk);
    op.Run(3);
}

// ============================================================
// host：输入生成 / 运行 / 落盘（写法与 m22_router512.asc 的 host 段同款）
// ============================================================
static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t bias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + bias) >> 16);
}

static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// 确定性 bf16 激活（与 m7/m22 的 GenActivationsUniform 逐字节同款：指数窗 [122,132)）
static void GenActivationsUniform(uint16_t* x, uint32_t m, uint32_t seed)
{
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t j = 0; j < M15M::HIDDEN; ++j) {
            const uint32_t h = Hash3(i, j, seed);
            const uint32_t e = 122 + (h % 10);
            x[static_cast<size_t>(i) * M15M::HIDDEN + j] =
                static_cast<uint16_t>(((h >> 8) & 0x8000) | (e << 7) | ((h >> 9) & 0x7F));
        }
    }
}

// 合成/缩形权重：W[e][k] = 1 当 k == e（bf16 精确）—— 于是 logit[t][e] == x[t][e]
//（覆盖 e < HIDDEN=2560 的 512 个专家全在行内、且 top-k 命中点遍布 16 个 32 块）
static void GenOneHotWeight(uint16_t* w)
{
    std::memset(w, 0, static_cast<size_t>(M15M::NUM_EXPERTS) * M15M::HIDDEN * 2);
    const float one = 1.0f;
    const uint16_t bits = F32ToBf16(one);
    for (uint32_t e = 0; e < M15M::NUM_EXPERTS; ++e) {
        w[static_cast<size_t>(e) * M15M::HIDDEN + e] = bits;
    }
}

static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = std::fopen(path, "wb");
    if (f == nullptr) {
        return false;
    }
    const size_t wrote = std::fwrite(buf, 1, n, f);
    std::fclose(f);
    return wrote == n;
}

static bool MkdirP(const std::string& dir)
{
    std::string acc;
    for (size_t i = 0; i < dir.size(); ++i) {
        acc.push_back(dir[i]);
        if (dir[i] == '/' || i + 1 == dir.size()) {
            mkdir(acc.c_str(), 0755);
        }
    }
    return true;
}

static uint32_t ArgU32(int argc, char** argv, const char* key, uint32_t dflt)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], key) == 0) {
            return static_cast<uint32_t>(std::strtoul(argv[i + 1], nullptr, 10));
        }
    }
    return dflt;
}

static const char* ArgStr(int argc, char** argv, const char* key, const char* dflt)
{
    for (int i = 1; i + 1 < argc; ++i) {
        if (std::strcmp(argv[i], key) == 0) {
            return argv[i + 1];
        }
    }
    return dflt;
}

int32_t main(int32_t argc, char** argv)
{
    const uint32_t m = ArgU32(argc, argv, "--m", 33u);
    const uint32_t seed = ArgU32(argc, argv, "--seed", 5u);
    const char* wArg = ArgStr(argc, argv, "--w", "onehot");
    const char* outDir = ArgStr(argc, argv, "--out", nullptr);
    const char* envOut = std::getenv("M95_OUT");
    const std::string out = (outDir != nullptr) ? std::string(outDir)
                                                : (envOut != nullptr ? std::string(envOut) : std::string("m95_out"));
    if (m == 0 || m > M15M::M_MAX) {
        std::printf("[M95][FAIL] --m %u 超出 [1, %u]\n", m, M15M::M_MAX);
        return 1;
    }
    const uint32_t E = M15M::NUM_EXPERTS;
    const uint32_t HID = M15M::HIDDEN;
    const uint32_t TK = M95_TOPK_RUN;
    if (TK > M15M::TOPK_MAX) {
        std::printf("[M95][FAIL] 运行期 topk %u > 档位 TOPK_MAX %u\n", TK, M15M::TOPK_MAX);
        return 1;
    }

    // ---- host 输入 ----
    std::vector<uint16_t> xHost(static_cast<size_t>(M15M::M_MAX) * HID, 0);
    GenActivationsUniform(xHost.data(), m, seed);
    std::vector<uint16_t> wHost(static_cast<size_t>(E) * HID, 0);
    if (std::strcmp(wArg, "onehot") == 0) {
        GenOneHotWeight(wHost.data());
    } else {
        FILE* f = std::fopen(wArg, "rb");
        if (f == nullptr) {
            std::printf("[M95][FAIL] 打不开权重文件 %s\n", wArg);
            return 1;
        }
        const size_t want = static_cast<size_t>(E) * HID * 2;
        const size_t got = std::fread(wHost.data(), 1, want, f);
        std::fclose(f);
        if (got != want) {
            std::printf("[M95][FAIL] 权重文件 %s 只有 %zu B，需要 %zu B（%u×%u bf16）\n",
                        wArg, got, want, E, HID);
            return 1;
        }
    }
    std::vector<uint16_t> sgHost(HID, 0);   // 共享门权重：本档只跑 router，判据不覆盖 sgate

    // ---- device ----
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t xBytes = static_cast<size_t>(M15M::M_MAX) * HID * 2;
    const size_t wBytes = static_cast<size_t>(E) * HID * 2;
    const size_t logBytes = static_cast<size_t>(M15M::M_MAX) * E * 4;
    const size_t idsBytes = static_cast<size_t>(M15M::M_MAX) * M15M::TOPK_MAX * 4;
    const size_t wOutBytes = static_cast<size_t>(M15M::M_MAX) * M15M::TOPK_MAX * 4;
    uint8_t* xDev = nullptr;
    uint8_t* wDev = nullptr;
    uint8_t* sgDev = nullptr;
    uint8_t* logDev = nullptr;
    uint8_t* idsDev = nullptr;
    uint8_t* wOutDev = nullptr;
    uint8_t* sgOutDev = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&xDev), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&wDev), wBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&sgDev), HID * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&logDev), logBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&idsDev), idsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&wOutDev), wOutBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&sgOutDev), static_cast<size_t>(M15M::M_MAX) * 4,
                ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(xDev, xBytes, xHost.data(), xBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wDev, wBytes, wHost.data(), wBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(sgDev, HID * 2, sgHost.data(), HID * 2, ACL_MEMCPY_HOST_TO_DEVICE);

    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);
    m95_router_kernel<<<1, 0, stream>>>(xDev, wDev, sgDev, logDev, idsDev, wOutDev, sgOutDev, m, TK);
    const aclError err = aclrtSynchronizeStream(stream);
    clock_gettime(CLOCK_MONOTONIC, &t1);
    const double ms = (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6;
    if (err != ACL_SUCCESS) {
        std::printf("[M95][FAIL] kernel launch/sync error %d\n", static_cast<int>(err));
        return 1;
    }

    std::vector<float> logHost(static_cast<size_t>(m) * E, 0.0f);
    std::vector<int32_t> idsHost(static_cast<size_t>(m) * TK, 0);
    std::vector<float> wOutHost(static_cast<size_t>(m) * TK, 0.0f);
    aclrtMemcpy(logHost.data(), static_cast<size_t>(m) * E * 4, logDev,
                static_cast<size_t>(m) * E * 4, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(idsHost.data(), static_cast<size_t>(m) * TK * 4, idsDev,
                static_cast<size_t>(m) * TK * 4, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(wOutHost.data(), static_cast<size_t>(m) * TK * 4, wOutDev,
                static_cast<size_t>(m) * TK * 4, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    // ---- 落盘（供 check_ref.py）----
    MkdirP(out);
    const std::string p = out + "/";
    bool ok = true;
    ok = ok && WriteBin((p + "x.bin").c_str(), xHost.data(), static_cast<size_t>(m) * HID * 2);
    ok = ok && WriteBin((p + "w.bin").c_str(), wHost.data(), static_cast<size_t>(E) * HID * 2);
    ok = ok && WriteBin((p + "router_logits.bin").c_str(), logHost.data(), static_cast<size_t>(m) * E * 4);
    ok = ok && WriteBin((p + "topk_ids.bin").c_str(), idsHost.data(), static_cast<size_t>(m) * TK * 4);
    ok = ok && WriteBin((p + "topk_weights.bin").c_str(), wOutHost.data(), static_cast<size_t>(m) * TK * 4);
    if (!ok) {
        std::printf("[M95][FAIL] dump 写盘失败（%s）\n", out.c_str());
        return 1;
    }
    FILE* fm = std::fopen((p + "meta.txt").c_str(), "w");
    if (fm != nullptr) {
        std::fprintf(fm, "m=%u\nseed=%u\nE=%u\nHIDDEN=%u\ntopk=%u\nw_arg=%s\nkmain_ms=%.3f\n",
                     m, seed, E, HID, TK, wArg, ms);
        std::fclose(fm);
    }
    std::printf("[M95] ok m=%u seed=%u E=%u topk=%u w=%s kernel_ms=%.3f out=%s\n",
                m, seed, E, TK, wArg, ms, out.c_str());
    return 0;
}
