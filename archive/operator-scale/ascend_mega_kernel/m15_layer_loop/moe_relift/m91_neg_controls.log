== nc1：资源表把 SZ_GU 退回 padded 算式（NUM_EXPERTS * M_MAX * GU_N * 2）==
$ sed 's/AlignUp(TOTAL_MAX \* GU_N \* 2, WS_ALIGN)/AlignUp(NUM_EXPERTS * M_MAX * GU_N * 2, WS_ALIGN)/' m15_layer_loop/m15_moe_resources.h > /tmp/m91_nc/nc1_res.h
rc=0

$ grep -c 'NUM_EXPERTS \* M_MAX \* GU_N' /tmp/m91_nc/nc1_res.h
1
rc=0

$ LC_ALL=C python3 m15_layer_loop/moe_relift/check_rescale.py --res /tmp/m91_nc/nc1_res.h | grep -E 'FAIL'
