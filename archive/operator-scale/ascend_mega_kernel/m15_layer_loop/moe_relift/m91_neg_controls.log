$ sed 's|(ws + WS_Y + rowBase \* HIDDEN \* 2)|(ws + WS_Y + slot * M_MAX * HIDDEN * 2)|' m15_layer_loop/m15_moe_layer.h > /tmp/m91_nc/nc2_hdr.h
rc=0

$ grep -c 'WS_Y + rowBase' m15_layer_loop/m15_moe_layer.h
1
rc=0

$ grep -c 'WS_Y + rowBase' /tmp/m91_nc/nc2_hdr.h
0
rc=1

