## 变异定义（/tmp/m84_nc/mutate.py，未入库；逐字抄录以便复现）
import pathlib
# 只在 /tmp 副本上做变异；每条变异一个副本（base.h = 入库的 m15_moe_layer.h）
M = {
 "nc1_diag_slot": [("constexpr uint32_t IG_DIAG_GM_SLOT = AlignUp((NUM_EXPERTS + 1) * 4 + 4, WS_ALIGN) / 4;",
                    "constexpr uint32_t IG_DIAG_GM_SLOT = 8;   // 变异：退回 m13 的写死下标")],
 "nc2_stack_array": [("        uint32_t badIds = 0;   // 脏 ids 计数：诊断槽上报 + 落位循环的短路条件",
                      "        uint32_t badIds = 0;   // 脏 ids 计数：诊断槽上报 + 落位循环的短路条件\n        uint32_t cnt[NUM_EXPERTS];   // 变异：退回标量栈数组")],
 "nc3_switch_trunc": [("            case 9: unperm9.Run(bid, nAiv); break;\n", ""),
                      ("default: unperm10.Run", "default: unperm4.Run")],
 "nc4_yview_padded": [("        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ySorted), static_cast<uint64_t>(TOTAL_MAX) * HIDDEN);",
                       "        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ySorted), static_cast<uint64_t>(NUM_EXPERTS * M_MAX) * HIDDEN);   // 变异：照抄 m17 的 padded 上界")],
 "nc5_fma_trunc": [("                if constexpr (TK > 9) FmaChunk<9>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);\n", "")],
 # P2-1 的咬合正对照：使用点退回「NUM_EXPERTS + 8」（任务书警告的方向级错误）
 "nc6_diag_usage": [("            DataCopyPad(offsGm[IG_DIAG_GM_SLOT], bL[32], ExtBlock1(4));",
                     "            DataCopyPad(offsGm[NUM_EXPERTS + 8], bL[32], ExtBlock1(4));   // 变异：使用点退回字面 E+8")],
}
txt = pathlib.Path("base.h").read_text()
for name, subs in M.items():
    t = txt
    for old, new in subs:
        assert t.count(old) == 1, (name, old, t.count(old))
        t = t.replace(old, new)
    pathlib.Path(name + ".h").write_text(t)
    print("mutated:", name)
