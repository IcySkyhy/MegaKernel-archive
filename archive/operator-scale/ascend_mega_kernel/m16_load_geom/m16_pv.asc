/**
 * m16_pv.asc —— 用标定结果在**真实 BMM2 形状**上"先预测再实测"的验证工程
 *
 * BMM2 = P · V：A = P [M=16, K]，B = V [K, N]，C = P·V [16, N]。
 *
 * 标定结论（m16_geom，见 README §3）给出的配方：
 *   A（P）：GM [16, K] 行主序 → Nd2Nz(nValue=16, dValue=K, srcDValue=K, dstNzC0Stride=16) → L1
 *          → LoadData2DParamsV2{mStep=1, kStep=K/16, srcStride=1, dstStride=1, ifTranspose=false}
 *          （与 m11 LoadA / M24 BMM1 的 Q 侧同款：源 Nz 的行分形数 = 1）
 *   B（V）：GM [K, N] 行主序（k 为行）→ Nd2Nz(nValue=K, dValue=N, srcDValue=N, dstNzC0Stride=K) → L1
 *          → LoadData2DParamsV2{mStep=K/16, kStep=N/16, srcStride=K/16, dstStride=N/16, ifTranspose=true}
 *          （ifTranspose=true 是"B 不转置输入 [k,n]"形态；**必须** T1，T0 会拿到转置）
 *   循环结构：**A(P) 整块驻留 L0A，K 用一次 mmad（k=256）**；N 按 128 分块（N_TILE），
 *   每块 B 的 [K, nTile] 进 L0B（(K/16)×(nTile/16) = 16×8 = 128 行 × 512B = 64KB，正好占满 L0B），
 *   再一次 mmad + Fixpipe 写出该 N 块。**没有 k 分块累加**（早期版本的 kChunk 设计已废弃）。
 *
 *   配方里的 8 个数字都由下面的 A_xxx / B_xxx 常量同时喂给 kernel 与"预测配方"打印，
 *   避免打印与实际执行参数不一致（round-1 review P2-3）。
 *
 * 运行：
 *   ./m16_pv                      # 合成数据（小整数 ⇒ 精确整数域 ⇒ device 与 fp32 参考逐位一致）
 *   ./m16_pv dump                 # 合成数据 + dump p/v/c 到 .bin（供 check_ref.py 用 numpy 复核）
 *   ./m16_pv map                  # P=I ⇒ 直接读回 B_mmad[k][n] 的映射
 *   ./m16_pv baddst               # 反例：B 的 dstStride 照抄 BMM1 元组（=K/16）
 *   ./m16_pv kmap                 # K 轴探针：P 选中单个 k，看 mmad 实际取到 V 的哪一行
 *   ./m16_pv real <p.bin> <v.bin> # 用真实 dump（M24 的 P 中转 [unit][parity][16][256] 与 V [n2][seqPad][256]）
 */
#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <cmath>

namespace m16pv {
using namespace AscendC;

constexpr uint32_t M_DIM = 16;      // P 的行数（token）
constexpr uint32_t K_DIM = 256;     // 归约维（= S2）
constexpr uint32_t N_TILE = 128;    // L0B 一次容纳的 N（N=256 时做 N-split）

// 配方常量：kernel 与"预测配方"打印共用，保证两者不会分叉（round-1 review P2-3）
constexpr uint32_t A_MSTEP = M_DIM / 16;    // A(P) 源行方向分形数（M=16 ⇒ 1）
constexpr uint32_t A_KSTEP = K_DIM / 16;    // A(P) 源列方向分形数
constexpr uint32_t A_SRCSTR = M_DIM / 16;   // A(P) 源列方向分形间隔（Nd2Nz dstNzC0Stride=M ⇒ M/16）
constexpr uint32_t A_DSTSTR = M_DIM / 16;   // A(P) 目的 k 方向分形间隔（L0A 的 n 分形数 = M/16）
constexpr uint32_t B_MSTEP = K_DIM / 16;    // B(V) 源行方向分形数（k 方向）
constexpr uint32_t B_KSTEP = N_TILE / 16;   // B(V) 源列方向分形数（n 方向）
constexpr uint32_t B_SRCSTR = K_DIM / 16;   // B(V) 源列方向分形间隔（Nd2Nz dstNzC0Stride=K ⇒ K/16）
constexpr uint32_t B_DSTSTR = N_TILE / 16;  // B(V) 目的 k 方向分形间隔（L0B 的 n 分形数 = N_TILE/16）
// baddst 反例用的错元组（照抄 BMM1 的 dstStride）
constexpr uint32_t B_DSTSTR_BAD = K_DIM / 16;

constexpr uint32_t L1_P = 0;                       // P 的 L1（[16, K]，Nz）
constexpr uint32_t L1_V = 16384;                   // V 的 L1（[K, N]，Nz）
constexpr uint32_t L0_A = 0;
constexpr uint32_t L0_B = 0;
constexpr uint32_t L0C_BYTES = M_DIM * N_TILE * 4;

// wrongDst: 0 = 标定配方（dstStride = L0B 的 n 分形数）；1 = 照抄 BMM1 的元组（dstStride = K/16）
__global__ __cube__ void pv_kernel(__gm__ uint8_t* pGm, __gm__ uint8_t* vGm, __gm__ uint8_t* cGm, uint32_t nTotal,
                                   uint32_t wrongDst)
{
    AscendC::InitSocState();
    LocalTensor<uint8_t> l1P(TPosition::A1, L1_P, M_DIM * K_DIM * 2);
    LocalTensor<uint8_t> l1V(TPosition::B1, L1_V, K_DIM * N_TILE * 2);
    LocalTensor<uint8_t> l0A(TPosition::A2, L0_A, 64 * 1024);
    LocalTensor<uint8_t> l0B(TPosition::B2, L0_B, 64 * 1024);
    LocalTensor<uint8_t> l0C(TPosition::CO1, 0, L0C_BYTES);

    // ---- GM -> L1：P [16, K] ----
    {
        GlobalTensor<uint8_t> g;
        g.SetGlobalBuffer(pGm);
        Nd2NzParams par = {};
        par.ndNum = 1;
        par.nValue = M_DIM;
        par.dValue = K_DIM;
        par.srcNdMatrixStride = 0;
        par.srcDValue = K_DIM;
        par.dstNzC0Stride = M_DIM;   // 源 Nz 的 C0 块行距 = 16 行
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        DataCopy(l1P.ReinterpretCast<bfloat16_t>(), g.ReinterpretCast<bfloat16_t>(), par);
    }
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);

    // ---- L1 -> L0A：P（m11 LoadA / M24 Q 同款，已实证） ----
    {
        LoadData2DParamsV2 lp = {};
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = A_MSTEP;
        lp.kStep = A_KSTEP;
        lp.srcStride = A_SRCSTR;
        lp.dstStride = A_DSTSTR;
        lp.ifTranspose = false;
        lp.sid = 0;
        LoadData(l0A.ReinterpretCast<bfloat16_t>(), l1P.ReinterpretCast<bfloat16_t>(), lp);
    }
    SetFlag<HardEvent::MTE1_M>(EVENT_ID1);
    WaitFlag<HardEvent::MTE1_M>(EVENT_ID1);

    for (uint32_t nBase = 0; nBase < nTotal; nBase += N_TILE) {
        const uint32_t nTile = N_TILE;
        // ---- GM -> L1：V 的 [K, nTile] 子块（GM 行主序 [K, N]，行距 nTotal）----
        // Nd2Nz 的 nValue/dValue 按整块搬，这里每块搬 K 行 × nTile 列，srcDValue = nTotal
        {
            GlobalTensor<uint8_t> g;
            g.SetGlobalBuffer(vGm + (size_t)nBase * 2);
            Nd2NzParams par = {};
            par.ndNum = 1;
            par.nValue = K_DIM;
            par.dValue = nTile;
            par.srcNdMatrixStride = 0;
            par.srcDValue = nTotal;
            par.dstNzC0Stride = K_DIM;   // 行距 = K（分形 (r=k/16, c=n/16) 在 L1 单元 c*(K/16)+r）
            par.dstNzNStride = 1;
            par.dstNzMatrixStride = 0;
            DataCopy(l1V.ReinterpretCast<bfloat16_t>(), g.ReinterpretCast<bfloat16_t>(), par);
        }
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);

        // ---- L1 -> L0B：V 的 [K, nTile] 整块（T1 ⇒ B_mmad[k][n] = V[k][n]） ----
        {
            LoadData2DParamsV2 lp = {};
            lp.mStartPosition = 0;
            lp.kStartPosition = 0;
            lp.mStep = B_MSTEP;             // 源 row 方向（= k）分形数 = K/16
            lp.kStep = B_KSTEP;             // 源 col 方向（= n）分形数 = N_TILE/16
            lp.srcStride = B_SRCSTR;        // 源 col 方向分形间隔（Nd2Nz dstNzC0Stride=K ⇒ K/16）
            lp.dstStride = (wrongDst != 0) ? (uint16_t)B_DSTSTR_BAD : (uint16_t)B_DSTSTR;
            lp.ifTranspose = true;          // B 不转置输入 [k,n] ⇒ 必须 T1
            lp.sid = 0;
            LoadData(l0B.ReinterpretCast<bfloat16_t>(), l1V.ReinterpretCast<bfloat16_t>(), lp);
        }
        SetFlag<HardEvent::MTE1_M>(EVENT_ID1);
        WaitFlag<HardEvent::MTE1_M>(EVENT_ID1);

        MmadParams mp = {};
        mp.m = (uint16_t)M_DIM;
        mp.n = (uint16_t)nTile;
        mp.k = (uint16_t)K_DIM;             // 单次 mmad k=256（A 的 k 与 B 的 k 必须同段）
        mp.cmatrixInitVal = true;
        mp.cmatrixSource = false;
        Mmad(l0C.ReinterpretCast<float>(), l0A.ReinterpretCast<bfloat16_t>(), l0B.ReinterpretCast<bfloat16_t>(), mp);
        SetFlag<HardEvent::M_FIX>(EVENT_ID2);
        WaitFlag<HardEvent::M_FIX>(EVENT_ID2);
        // L0B 在下一块 LoadData 前释放（顺序执行，正确性优先）
        SetFlag<HardEvent::M_MTE1>(EVENT_ID4);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID4);
        {
            GlobalTensor<bfloat16_t> cg;
            // 目的基址偏移 = 列偏移 nBase（元素），行距由 dstStride=nTotal 表达；
            // 误写成 M_DIM*nBase 会让第二块覆盖第一块的第 0..127 列（本项目实测过一次）
            cg.SetGlobalBuffer((__gm__ bfloat16_t*)cGm + nBase);
            FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp = {};
            fp.nSize = (uint16_t)nTile;
            fp.mSize = (uint16_t)M_DIM;
            fp.srcStride = (uint16_t)M_DIM;
            fp.dstStride = nTotal;
            fp.quantPre = QuantMode_t::F322BF16;
            fp.reluScalar = 0;
            fp.vectorRelu = 0;
            fp.deqScalar = 0;
            Fixpipe(cg, l0C.ReinterpretCast<float>(), fp);
            SetFlag<HardEvent::FIX_S>(EVENT_ID3);
            WaitFlag<HardEvent::FIX_S>(EVENT_ID3);
        }
    }
    PipeBarrier<PIPE_ALL>();
}

// ---------------------------------------------------------------- host 工具
static uint16_t FloatToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return (uint16_t)((x + roundingBias) >> 16);
}
static float Bf16ToFloat(uint16_t h)
{
    uint32_t x = ((uint32_t)h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}
static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}
static bool ReadBin(const char* path, void* buf, size_t n)
{
    FILE* f = fopen(path, "rb");
    if (f == nullptr) return false;
    const size_t r = fread(buf, 1, n, f);
    fclose(f);
    return r == n;
}

}  // namespace m16pv

int32_t main(int32_t argc, char* argv[])
{
    using namespace m16pv;
    const bool doDump = (argc > 1 && strcmp(argv[1], "dump") == 0);
    const bool useReal = (argc > 1 && strcmp(argv[1], "real") == 0);
    const bool doMap = (argc > 1 && strcmp(argv[1], "map") == 0);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t pBytes = (size_t)M_DIM * K_DIM * 2;   // 8KB
    const size_t vBytes = (size_t)K_DIM * K_DIM * 2;   // 128KB（N 固定 256 输入，评测时 N-split）
    const size_t cBytes = (size_t)M_DIM * K_DIM * 2;   // 8KB（N=256）
    const uint32_t nTotal = 256;

    void* dP = nullptr;
    void* dV = nullptr;
    void* dC = nullptr;
    aclrtMalloc(&dP, pBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dV, vBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dC, cBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    uint16_t* hP = (uint16_t*)malloc(pBytes);
    uint16_t* hV = (uint16_t*)malloc(vBytes);
    uint16_t* hC = (uint16_t*)calloc(1, cBytes);
    uint16_t* hRef = (uint16_t*)malloc(cBytes);

    if (doMap) {
        // 直接标定 V(B) 装载：P = 16x256 单位阵（P[m][k]=1 iff m==k）⇒ C[m][n] = V[m][n]；
        // V[k][n] = bf16 位型 0x4000 + (k*256+n)（k<16，可逆解码）⇒ 解码即知 C[m][n] 拿到 V 的哪个 (k,n)。
        for (uint32_t m = 0; m < M_DIM; ++m) {
            for (uint32_t k = 0; k < K_DIM; ++k) {
                hP[m * K_DIM + k] = (m == k) ? (uint16_t)0x3F80u : (uint16_t)0x0000u;
            }
        }
        memset(hV, 0, vBytes);
        for (uint32_t k = 0; k < 16; ++k) {
            for (uint32_t n = 0; n < nTotal; ++n) {
                hV[k * nTotal + n] = (uint16_t)(0x4000u + k * 256u + n);
            }
        }
        printf("[PV][map] P=16x256 单位阵；V[k<16][n]=位型 0x4000+(k*256+n) ⇒ 期望 C[m][n] 解码 = m*256+n\n");
    } else if (useReal && argc >= 4) {
        // 真实 dump：P 取 gp[unit=0][parity=0] 的 [16][256]；V 取 v[n2=0] 的 [256][256]
        const size_t gpPer = (size_t)16 * 256 * 2;
        const size_t vPer = (size_t)256 * 256 * 2;
        if (!ReadBin(argv[2], hP, gpPer)) {
            printf("[PV][FAIL] 读 P 失败 %s（期望 %zu 字节 = [16][256] bf16）\n", argv[2], gpPer);
            return 1;
        }
        uint8_t* tmp = (uint8_t*)malloc(vPer);
        if (!ReadBin(argv[3], tmp, vPer)) {
            printf("[PV][FAIL] 读 V 失败 %s\n", argv[3]);
            return 1;
        }
        memcpy(hV, tmp, vPer);
        free(tmp);
        printf("[PV] 使用真实 dump：P=%s（前 8KB = gp[0][0][16][256]），V=%s（前 128KB = v[0][256][256]）\n",
               argv[2], argv[3]);
    } else {
        // 合成数据：[-8,8] 小整数 → 精确整数域（任意累加次序无舍入）⇒ 逐位可校验
        for (uint32_t i = 0; i < M_DIM; ++i) {
            for (uint32_t j = 0; j < K_DIM; ++j) {
                hP[i * K_DIM + j] = FloatToBf16((float)((int)(Hash3(i, j, 11) % 17u) - 8));
            }
        }
        for (uint32_t i = 0; i < K_DIM; ++i) {
            for (uint32_t j = 0; j < K_DIM; ++j) {
                hV[i * K_DIM + j] = FloatToBf16((float)((int)(Hash3(i, j, 23) % 17u) - 8));
            }
        }
        printf("[PV] 合成数据：P[%u,%u]、V[%u,%u]，[-8,8] 小整数（bf16 精确；K=%u 的累加和 < 2^24 无舍入）\n",
               M_DIM, K_DIM, K_DIM, K_DIM, K_DIM);
    }

    // fp32 参考（精确整数域下与任意累加次序同值），RNE 到 bf16
    {
        float* ref = (float*)malloc((size_t)M_DIM * K_DIM * 4);
        for (uint32_t m = 0; m < M_DIM; ++m) {
            for (uint32_t n = 0; n < nTotal; ++n) {
                float acc = 0.0f;
                for (uint32_t k = 0; k < K_DIM; ++k) {
                    acc += Bf16ToFloat(hP[m * K_DIM + k]) * Bf16ToFloat(hV[k * nTotal + n]);
                }
                ref[m * nTotal + n] = acc;
            }
        }
        for (uint32_t i = 0; i < M_DIM * nTotal; ++i) {
            hRef[i] = FloatToBf16(ref[i]);
        }
        free(ref);
    }

    aclrtMemcpy(dP, pBytes, hP, pBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dV, vBytes, hV, vBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dC, cBytes, 0, cBytes);

    // baddst：把 BMM1 的 dstStride 元组（= K/16）照搬到 BMM2 的 B 装载上，用于对照
    const uint32_t wrongDst = (argc > 1 && strcmp(argv[1], "baddst") == 0) ? 1u : 0u;
    const uint32_t bDstPrinted = (wrongDst != 0) ? B_DSTSTR_BAD : B_DSTSTR;
    printf("[PV] 预测配方（与 kernel 共用同一组常量）："
           "A(P) T0 {mStep=%u, kStep=%u, srcStride=%u, dstStride=%u}；"
           "B(V) T1 {mStep=%u, kStep=%u, srcStride=%u, dstStride=%u}\n",
           A_MSTEP, A_KSTEP, A_SRCSTR, A_DSTSTR, B_MSTEP, B_KSTEP, B_SRCSTR, bDstPrinted);
    printf("[PV]   Nd2Nz: A nValue=%u/dValue=%u/srcDValue=%u/dstNzC0Stride=%u；"
           "B nValue=%u/dValue=%u(N_TILE)/srcDValue=%u(nTotal)/dstNzC0Stride=%u；mmad m=%u n=%u k=%u\n",
           M_DIM, K_DIM, K_DIM, M_DIM, K_DIM, N_TILE, nTotal, K_DIM, M_DIM, N_TILE, K_DIM);
    if (wrongDst != 0) {
        printf("[PV][baddst] 对照（**故意错误**）：B 装载 dstStride 用 %u（BMM1 的元组 K/16）"
               "而非 L0B 的 n 分形数 %u\n",
               B_DSTSTR_BAD, B_DSTSTR);
    }
    pv_kernel<<<1, 0, stream>>>((uint8_t*)dP, (uint8_t*)dV, (uint8_t*)dC, nTotal, wrongDst);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("[PV][FAIL] sync err %d\n", (int)err);
        return 1;
    }
    aclrtMemcpy(hC, cBytes, dC, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    if (argc > 1 && strcmp(argv[1], "kmap") == 0) {
        // K 轴探针：P[m][k] = 1 iff k == kOff（对全部 m），V[k][n] = 1 + k（bf16 精确）
        // ⇒ C[m][n] 应等于 1 + kOff；实测值 - 1 即"mmad 实际拿到的 k"，可直接看出 k 轴映射。
        memset(hV, 0, vBytes);
        for (uint32_t k = 0; k < K_DIM; ++k) {
            for (uint32_t n = 0; n < nTotal; ++n) {
                hV[k * nTotal + n] = FloatToBf16((float)(1 + k));
            }
        }
        aclrtMemcpy(dV, vBytes, hV, vBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        const uint32_t kOffs[] = {0, 1, 7, 8, 15, 16, 17, 31, 32, 63, 64, 127, 128, 192, 255};
        for (uint32_t ki = 0; ki < sizeof(kOffs) / sizeof(kOffs[0]); ++ki) {
            const uint32_t kOff = kOffs[ki];
            memset(hP, 0, pBytes);
            for (uint32_t m = 0; m < M_DIM; ++m) {
                hP[m * K_DIM + kOff] = (uint16_t)0x3F80u;
            }
            aclrtMemcpy(dP, pBytes, hP, pBytes, ACL_MEMCPY_HOST_TO_DEVICE);
            aclrtMemset(dC, cBytes, 0, cBytes);
            pv_kernel<<<1, 0, stream>>>((uint8_t*)dP, (uint8_t*)dV, (uint8_t*)dC, nTotal, 0);
            if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
                printf("[PV][kmap] kOff=%u 挂死/出错\n", kOff);
                return 2;
            }
            aclrtMemcpy(hC, cBytes, dC, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);
            printf("[PV][kmap] kOff=%3u → C[0][0]=%.1f C[0][1]=%.1f C[0][64]=%.1f C[0][128]=%.1f（期望 %.1f）\n", kOff,
                   Bf16ToFloat(hC[0]), Bf16ToFloat(hC[1]), Bf16ToFloat(hC[64]), Bf16ToFloat(hC[128]),
                   (float)(1 + kOff));
        }
        free(hP); free(hV); free(hC); free(hRef);
        aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
        return 0;
    }
    if (doMap) {
        uint32_t hit = 0, miss = 0;
        for (uint32_t m = 0; m < M_DIM; ++m) {
            for (uint32_t n = 0; n < nTotal; ++n) {
                const uint32_t b = (uint32_t)hC[m * nTotal + n];
                if (hC[m * nTotal + n] == 0) { miss++; continue; }
                const uint32_t idx = b - 0x4000u;
                if (idx == m * 256u + n) hit++; else miss++;
                if (n < 4 && m < 4) {
                    printf("  C[%u][%u] 位型=0x%04x → V 的 (k=%u,n=%u)（期望 k=%u,n=%u）\n", m, n, b, idx / 256,
                           idx % 256, m, n);
                }
            }
        }
        printf("[PV][map] 解码命中 %u/%u（miss=%u）\n", hit, M_DIM * nTotal, miss);
        WriteBin("m16_pv_map_device.bin", hC, cBytes);
        free(hP); free(hV); free(hC); free(hRef);
        aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
        return hit == M_DIM * nTotal ? 0 : 1;
    }
    uint32_t nBad = 0, nZero = 0;
    double maxRel = 0.0;
    for (uint32_t i = 0; i < M_DIM * nTotal; ++i) {
        const float dv = Bf16ToFloat(hC[i]);
        const float rv = Bf16ToFloat(hRef[i]);
        if (hC[i] == 0) nZero++;
        if (hC[i] != hRef[i]) {
            nBad++;
            const float den = (fabsf(rv) > 1e-6f) ? fabsf(rv) : 1e-6f;
            const double rel = fabs((double)dv - (double)rv) / (double)den;
            if (rel > maxRel) maxRel = rel;
        }
    }
    printf("[PV] device C vs host fp32 参考（RNE→bf16）：%u/%u 逐位不等，maxRel=%.3e，device 零元素=%u\n", nBad,
           M_DIM * nTotal, maxRel, nZero);
    if (nBad == 0 && nZero == 0) {
        printf("[PV] PASS（逐位一致）\n");
    } else if (maxRel < 1e-2) {
        printf("[PV] PASS（bf16 网格容差 1e-2 内）\n");
    } else {
        printf("[PV] FAIL\n");
    }

    if (doDump || useReal) {
        WriteBin("m16_pv_p.bin", hP, pBytes);
        WriteBin("m16_pv_v.bin", hV, vBytes);
        WriteBin("m16_pv_c_device.bin", hC, cBytes);
        WriteBin("m16_pv_c_ref.bin", hRef, cBytes);
        printf("[PV] dumped m16_pv_{p,v,c_device,c_ref}.bin（check_ref.py 可独立 numpy 复核）\n");
    }

    free(hP);
    free(hV);
    free(hC);
    free(hRef);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
