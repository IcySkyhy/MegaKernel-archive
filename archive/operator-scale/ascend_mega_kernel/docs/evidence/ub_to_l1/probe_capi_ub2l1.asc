// M120 探针 1：C API 的 UB→L1 硬通道在本机工具链上能否编过（host 侧编译，零设备）。
// 只 include 目标 API 所在的头，不引官方样例的其它符号（样例源码另引 `AscendC::Std::ceil_div`，
// 该符号在本机 CANN 9.1.0 里不存在 —— 见 README §5「版本差」）。
#include "c_api/asc_simd.h"

constexpr uint32_t NBYTES = 512;

__global__ __mix__(1, 2) void probe_ub2l1(__gm__ uint8_t* out)
{
    if ASC_IS_AIV {
        __ubuf__ uint8_t* src = (__ubuf__ uint8_t*)asc_get_phy_buf_addr(0);
        __cbuf__ uint8_t* dst = (__cbuf__ uint8_t*)asc_get_phy_buf_addr(0);
        asc_copy_ub2l1(dst, src, NBYTES);
    }
    if ASC_IS_AIC {
        out[0] = 0;
    }
}
