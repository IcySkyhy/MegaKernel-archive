// M120 探针 2：基础 API 的连续 UB→L1（`DataCopy(L1_TSCM, UB_VECIN, count)`）在本机工具链上能否编过。
// 与探针 1 的区别：不写任何新 API，只用仓内既有的 `kernel_operator.h` 基础 API 形态。
#include "kernel_operator.h"

constexpr uint32_t NBYTES = 512;

__global__ __mix__(1, 2) void probe_basic_ub2l1(__gm__ uint8_t* out)
{
    if ASCEND_IS_AIV {
        AscendC::LocalTensor<uint8_t> src(AscendC::TPosition::VECIN, 0, NBYTES);
        AscendC::LocalTensor<uint8_t> dst(AscendC::TPosition::TSCM, 0, NBYTES);
        AscendC::DataCopy(dst, src, NBYTES);
    }
    if ASCEND_IS_AIC {
        out[0] = 0;
    }
}
