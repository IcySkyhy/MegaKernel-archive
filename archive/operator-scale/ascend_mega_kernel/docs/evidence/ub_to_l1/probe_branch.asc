// M120 探针 3：把 `DataCopyUB2L1Impl` 自身的预处理器条件
// （impl/basic_api/dav_3510/kernel_operator_data_copy_impl.h:582 逐字）抄成一条 #error，
// 用来判定本机工具链给 `__mix__(1,2)` kernel 编的是**硬件分支**还是 **GM/KFC 分支**。
// 预期输出：BRANCH_HARDWARE_CopyUbufToCbuf（见 README §5）。
#include "kernel_operator.h"

#if KFC_C310_SSBUF == 1 || __MIX_CORE_AIC_RATION__ != 1
#error BRANCH_HARDWARE_CopyUbufToCbuf
#else
#error BRANCH_GM_KFC_ScmDataCopyMsg
#endif

__global__ __mix__(1, 2) void k(__gm__ float* p) { p[0] = 1.0f; }
