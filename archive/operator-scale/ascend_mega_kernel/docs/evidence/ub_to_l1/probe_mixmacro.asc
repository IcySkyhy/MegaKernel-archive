// M120 探针 4：`__MIX_CORE_AIC_RATION__` 在本机这次编译里到底有没有被定义。
// 用途：探针 3d 的结论（「命中硬件分支」）依赖这个宏 —— 不能只靠反推，用 #error 直接打出来。
// 预期输出：MIX_RATIO_NOT_DEFINED（见 README §5）。
#include "kernel_operator.h"

#ifdef __MIX_CORE_AIC_RATION__
#error MIX_RATIO_DEFINED
#else
#error MIX_RATIO_NOT_DEFINED
#endif

__global__ __mix__(1, 2) void k(__gm__ float* p) { p[0] = 1.0f; }
