/**
 * probe_cube_fp32.asc —— M106：cube（AIC）吃 fp32 操作数的能力 / 精度形态 / 吞吐标定
 *
 * 背景（M104 的 out-of-scope finding #1）：仓内两处读数互相矛盾 ——
 *   cannbot-knowledge/knowledge/ops/ascendc/concepts/roofline_model.md:28
 *       "CUBE Peak (FP32) ~24 TFLOPS (Measured) — cube is fp16/bf16-optimized, fp32 not favored"
 *   m18_gdn_prefill/README.md §7
 *       "3510 的 cube 只能吃 bf16 操作数 + fp32 累加"
 * 这两句不可能同时为真。本探针用**最小 Mmad 实验**裁决「fp32 操作数能不能吃」，
 * 并标定其**精度形态**（全 fp32 乘累加？还是降到 hf32/tf32/bf16？）与**吞吐**（与 bf16 的比值）。
 *
 * 本文件只做一件事：把 fp32×fp32→fp32 的 `Mmad` 写在 AIC 上跑起来，逐元素对 host 侧
 * 独立参考（fp64 精确和 / 以及把操作数按 bf16、hf32(10-bit mantissa) 舍入后的参考）比。
 *
 * 口径纪律（人类反复强调过的三条）：
 *   ① 若编译不过：给逐字诊断 + rc + 代码上下文（本探针的代码就是那段上下文）；
 *   ② 精度结论分两层写：能否吃 fp32 操作数（二值）+ 若能则精度形态（给逐元素误差分布）；
 *   ③ 对硬件行为下结论必须带可复现最小用例（本文件即最小用例），不敢下结论就写"未确定"。
 *
 * 用法（每个 mode 一个独立进程）：
 *   ./probe_cube_fp32 prec        fp32×fp32→fp32，6 个分布，打误差表 + 落盘 prec_*.bin
 *   ./probe_cube_fp32 dump <dir>  同上但把 in/out 写到 <dir>/ 供 check_ref.py 独立复核
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"   // asc_enable_hf32()：fp32 操作数的“快路”配置（本探针用它标定 HF32 的精度形态）

#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <cmath>

namespace pcf {
using namespace AscendC;

// ---- 形状（全部取 BLOCK_CUBE 的整数倍，避开所有 ceil-align 歧义）----
constexpr uint32_t M_DIM = 16;
constexpr uint32_t N_DIM = 16;
constexpr uint32_t K_DIM = 256;
constexpr uint32_t NDIST = 7;
constexpr uint32_t C0_F = 32 / sizeof(float);   // fp32 的 C0_SIZE = 8

constexpr uint32_t L1_A_OFF = 0;
constexpr uint32_t L1_B_OFF = 32768;

// GM 布局：A[d][m][k]（行主序，dValue=K）；B[d][n][k]（行主序，dValue=K ⇒ 即 isBTranspose=true 的形态）
__global__ __cube__ void prec_kernel(__gm__ float* aGm, __gm__ float* bGm, __gm__ float* cGm, int32_t hf32En)
{
    AscendC::InitSocState();
    printf("[PCF] prec_kernel enter bid=%u M=%u N=%u K=%u NDIST=%u C0=%u hf32=%d\n",
           (uint32_t)GetBlockIdx(), M_DIM, N_DIM, K_DIM, NDIST, C0_F, hf32En);
    if (hf32En) {
        asc_enable_hf32();   // 开启 HF32：L0A/L0B 的 float 先按 RNE 舍到 HF32(1s+8e+10m) 再参与乘累加
    }

    LocalTensor<float> l1a(TPosition::A1, L1_A_OFF, M_DIM * K_DIM);
    LocalTensor<float> l1b(TPosition::B1, L1_B_OFF, N_DIM * K_DIM);
    LocalTensor<float> l0a(TPosition::A2, 0, M_DIM * K_DIM);
    LocalTensor<float> l0b(TPosition::B2, 0, N_DIM * K_DIM);
    LocalTensor<float> l0c(TPosition::CO1, 0, M_DIM * N_DIM);

    GlobalTensor<float> aG, bG;
    aG.SetGlobalBuffer(aGm);
    bG.SetGlobalBuffer(bGm);

    // 预置 3 个跨迭代交接的 flag（循环内各自 SetFlag/WaitFlag 一一配对）。
    // 只用 PipeBarrier 不足以建立 M→FIX 与 FIX→M 的跨 pipe 依赖（实测：整张表滞后一轮），
    // 故这里按 AscendC 官方 mmad 例的事件配对口径，逐管道显式交接。
    SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);   // L1 可被 MTE2 覆写
    SetFlag<HardEvent::M_MTE1>(EVENT_ID0);      // L0A/L0B 可被 MTE1 覆写
    SetFlag<HardEvent::FIX_M>(EVENT_ID0);       // L0C 可被 M 覆写

    for (uint32_t d = 0; d < NDIST; ++d) {
        WaitFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        {   // A[d] : ND [M,K] -> L1 Nz
            Nd2NzParams pa;
            pa.ndNum = 1;
            pa.nValue = M_DIM;
            pa.dValue = K_DIM;
            pa.srcNdMatrixStride = 0;
            pa.srcDValue = K_DIM;
            pa.dstNzC0Stride = M_DIM;        // 单位 C0_SIZE(32B)；= ceil(M/16)*16
            pa.dstNzNStride = 1;
            pa.dstNzMatrixStride = 0;
            DataCopy(l1a, aG[(uint64_t)d * M_DIM * K_DIM], pa);
        }
        {   // B[d] : ND [N,K] -> L1 Nz
            Nd2NzParams pb;
            pb.ndNum = 1;
            pb.nValue = N_DIM;
            pb.dValue = K_DIM;
            pb.srcNdMatrixStride = 0;
            pb.srcDValue = K_DIM;
            pb.dstNzC0Stride = N_DIM;
            pb.dstNzNStride = 1;
            pb.dstNzMatrixStride = 0;
            DataCopy(l1b, bG[(uint64_t)d * N_DIM * K_DIM], pb);
        }
        SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
        WaitFlag<HardEvent::M_MTE1>(EVENT_ID0);
        {   // A : L1 Nz -> L0A Nz （LoadData 2dv2；kStep 以 C0_SIZE 计）
            LoadData2DParamsV2 la;
            la.mStartPosition = 0;
            la.kStartPosition = 0;
            la.mStep = (uint16_t)(M_DIM / 16);
            la.kStep = (uint16_t)(K_DIM / C0_F);
            la.srcStride = (uint16_t)(M_DIM / 16);
            la.dstStride = (uint16_t)(M_DIM / 16);
            la.ifTranspose = false;
            la.sid = 0;
            LoadData(l0a, l1a, la);
        }
        {   // B : L1 Nz -> L0B Zn （LoadData 2dv1，与 asc-devkit 官方 mmad 例 isBTranspose 支同形态）
            LoadData2DParams lb;
            lb.startIndex = 0;
            lb.repeatTimes = (uint8_t)((N_DIM / 16) * (K_DIM / C0_F));
            lb.srcStride = 1;
            lb.dstGap = 0;
            lb.ifTranspose = false;
            LoadData(l0b, l1b, lb);
        }
        SetFlag<HardEvent::MTE1_MTE2>(EVENT_ID0);
        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);

        MmadParams mp;
        mp.m = M_DIM;
        mp.n = N_DIM;
        mp.k = K_DIM;
        mp.cmatrixInitVal = true;
        mp.cmatrixSource = false;
        WaitFlag<HardEvent::FIX_M>(EVENT_ID0);
        Mmad(l0c, l0a, l0b, mp);
        SetFlag<HardEvent::M_MTE1>(EVENT_ID0);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0);
        WaitFlag<HardEvent::M_FIX>(EVENT_ID0);

        GlobalTensor<float> dst;
        dst.SetGlobalBuffer(cGm + (uint64_t)d * M_DIM * N_DIM);
        FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
        fp.nSize = (uint16_t)N_DIM;
        fp.mSize = (uint16_t)M_DIM;
        fp.srcStride = (uint16_t)M_DIM;
        fp.dstStride = N_DIM;
        fp.reluScalar = 0;
        fp.vectorRelu = 0;
        fp.deqScalar = 0;
        static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
        Fixpipe<float, float, kFixGm>(dst, l0c, fp);
        SetFlag<HardEvent::FIX_M>(EVENT_ID0);
    }
    PipeBarrier<PIPE_ALL>();
}

// ==================== 吞吐标定：同 shape 下 fp32 vs bf16 的 Mmad 吞吐比 ====================
// 方法：操作数一次性装进 L0，然后连发 PERF_ITERS 次 Mmad，用 SYS_CNT 量这段的 cycle 数。
// 两侧（fp32 / bf16）走完全相同的代码路径与参数口径，只有 dtype（=> C0_SIZE）不同，
// 故 cycle 比值即硬件对这两种操作数精度的 Mmad 吞吐比。
constexpr uint32_t PM = 64;
constexpr uint32_t PN = 64;
constexpr uint32_t PK = 128;
constexpr uint32_t PERF_ITERS = 2000;

template <typename T, uint32_t C0V>
__aicore__ inline void perf_body(const GlobalTensor<T>& aG, const GlobalTensor<T>& bG,
                                 const GlobalTensor<float>& cG, GlobalTensor<int32_t>& cycG)
{
    LocalTensor<T> l1a(TPosition::A1, L1_A_OFF, PM * PK);
    LocalTensor<T> l1b(TPosition::B1, L1_B_OFF, PN * PK);
    LocalTensor<T> l0a(TPosition::A2, 0, PM * PK);
    LocalTensor<T> l0b(TPosition::B2, 0, PN * PK);
    LocalTensor<float> l0c(TPosition::CO1, 0, PM * PN);

    {   // A : ND [M,K] -> L1
        Nd2NzParams pa;
        pa.ndNum = 1;
        pa.nValue = PM;
        pa.dValue = PK;
        pa.srcNdMatrixStride = 0;
        pa.srcDValue = PK;
        pa.dstNzC0Stride = PM;
        pa.dstNzNStride = 1;
        pa.dstNzMatrixStride = 0;
        DataCopy(l1a, aG, pa);
    }
    {   // B : ND [N,K] -> L1
        Nd2NzParams pb;
        pb.ndNum = 1;
        pb.nValue = PN;
        pb.dValue = PK;
        pb.srcNdMatrixStride = 0;
        pb.srcDValue = PK;
        pb.dstNzC0Stride = PN;
        pb.dstNzNStride = 1;
        pb.dstNzMatrixStride = 0;
        DataCopy(l1b, bG, pb);
    }
    SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
    {
        LoadData2DParamsV2 la;
        la.mStartPosition = 0;
        la.kStartPosition = 0;
        la.mStep = (uint16_t)(PM / 16);
        la.kStep = (uint16_t)(PK / C0V);
        la.srcStride = (uint16_t)(PM / 16);
        la.dstStride = (uint16_t)(PM / 16);
        la.ifTranspose = false;
        la.sid = 0;
        LoadData(l0a, l1a, la);
    }
    {
        LoadData2DParams lb;
        lb.startIndex = 0;
        lb.repeatTimes = (uint8_t)((PN / 16) * (PK / C0V));
        lb.srcStride = 1;
        lb.dstGap = 0;
        lb.ifTranspose = false;
        LoadData(l0b, l1b, lb);
    }
    SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
    WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);

    MmadParams mp;
    mp.m = PM;
    mp.n = PN;
    mp.k = PK;
    mp.cmatrixInitVal = true;
    mp.cmatrixSource = false;

    const int64_t t0 = GetSystemCycle();
    for (uint32_t i = 0; i < PERF_ITERS; ++i) {
        Mmad(l0c, l0a, l0b, mp);
    }
    PipeBarrier<PIPE_ALL>();
    const int64_t t1 = GetSystemCycle();

    cycG.SetValue(0, (int32_t)((t1 - t0) & 0x7FFFFFFF));
    cycG.SetValue(1, (int32_t)C0V);
    cycG.SetValue(2, (int32_t)sizeof(T));

    SetFlag<HardEvent::M_FIX>(EVENT_ID0);
    WaitFlag<HardEvent::M_FIX>(EVENT_ID0);
    FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
    fp.nSize = (uint16_t)PN;
    fp.mSize = (uint16_t)PM;
    fp.srcStride = (uint16_t)PM;
    fp.dstStride = PN;
    fp.reluScalar = 0;
    fp.vectorRelu = 0;
    fp.deqScalar = 0;
    static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
    Fixpipe<float, float, kFixGm>(cG, l0c, fp);
    PipeBarrier<PIPE_ALL>();
}

__global__ __cube__ void perf_fp32_kernel(__gm__ float* aGm, __gm__ float* bGm, __gm__ float* cGm, __gm__ int32_t* cycGm, int32_t hf32En)
{
    AscendC::InitSocState();
    if (hf32En) asc_enable_hf32();
    GlobalTensor<float> aG, bG, cG;
    GlobalTensor<int32_t> cycG;
    aG.SetGlobalBuffer(aGm);
    bG.SetGlobalBuffer(bGm);
    cG.SetGlobalBuffer(cGm);
    cycG.SetGlobalBuffer(cycGm);
    perf_body<float, 8>(aG, bG, cG, cycG);
}

__global__ __cube__ void perf_bf16_kernel(__gm__ bfloat16_t* aGm, __gm__ bfloat16_t* bGm, __gm__ float* cGm, __gm__ int32_t* cycGm)
{
    AscendC::InitSocState();
    GlobalTensor<bfloat16_t> aG, bG;
    GlobalTensor<float> cG;
    GlobalTensor<int32_t> cycG;
    aG.SetGlobalBuffer(aGm);
    bG.SetGlobalBuffer(bGm);
    cG.SetGlobalBuffer(cGm);
    cycG.SetGlobalBuffer(cycGm);
    perf_body<bfloat16_t, 16>(aG, bG, cG, cycG);
}
}  // namespace pcf

// ============================ host 侧 ============================

static uint32_t Hash(uint32_t i, uint32_t salt)
{
    uint32_t h = i * 2654435761u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16; h *= 2246822519u; h ^= h >> 13;
    return h;
}

// 把 fp32 尾数按 RNE 舍到 mant 位（保留 sign+exp+mant 高位）
static float RoundMant(float x, int mant)
{
    uint32_t b; memcpy(&b, &x, 4);
    const int dropBits = 23 - mant;
    if (dropBits <= 0) return x;
    const uint32_t mask = (dropBits >= 32) ? 0xFFFFFFFFu : ((1u << dropBits) - 1u);
    const uint32_t half = 1u << (dropBits - 1);
    const uint32_t keep = b & ~mask;
    const uint32_t rem = b & mask;
    uint32_t out = keep;
    if (rem > half || (rem == half && ((keep >> dropBits) & 1u))) out = keep + (1u << dropBits);
    float r; memcpy(&r, &out, 4);
    return r;
}
static float ToBf16Rne(float x) { return RoundMant(x, 8); }
static float ToHf32Rne(float x) { return RoundMant(x, 10); }   // HF32: 1s+8e+10m

static const char* kDistName[pcf::NDIST] = {
    "d0 ones    ",   // A=1, B=1                     => C = K                （恒真自检）
    "d1 mant13  ",   // A=1+2^-12, B=1               => 13 位有效位能否保住
    "d2 mant10  ",   // A=1+2^-9,  B=1               => 10 位有效位能否保住
    "d3 absorb  ",   // A=1, B[0]=2^24, B[k>0]=1     => 暴露累加器位宽/分块
    "d4 rand    ",   // 23 位尾数伪随机              => 与 fp64 / 舍入参考逐元素比
    "d5 cancel  ",   // A=1, B=(-1)^k                => 完全相消 => 0
    "d6 mant23s ",   // 单项：A[.,0]=1+2^-23, 其余 0；B=1 => C = 1+2^-23（无累加噪声，直接读操作数位宽）
};

static void FillDist(uint32_t d, float* hA, float* hB)
{
    const uint32_t M = pcf::M_DIM, N = pcf::N_DIM, K = pcf::K_DIM;
    for (uint32_t m = 0; m < M; ++m) {
        for (uint32_t k = 0; k < K; ++k) {
            float a = 1.0f;
            if (d == 1) a = 1.0f + 0.000244140625f;          // 1 + 2^-12
            else if (d == 2) a = 1.0f + 0.001953125f;        // 1 + 2^-9
            else if (d == 4) {                               // 23 位尾数伪随机 ∈ [-1,1)
                const uint32_t raw = Hash(m * K + k, 11u);
                a = ((float)(raw >> 9) / 8388608.0f) - 1.0f; // 23-bit mantissa
            }
            else if (d == 6) a = (k == 0) ? (1.0f + 1.1920928955078125e-07f) : 0.0f;  // 1 + 2^-23 单项
            hA[m * K + k] = a;
        }
    }
    for (uint32_t n = 0; n < N; ++n) {
        for (uint32_t k = 0; k < K; ++k) {
            float b = 1.0f;
            if (d == 3) b = (k == 0) ? 16777216.0f : 1.0f;   // 2^24 吸收
            else if (d == 4) {
                const uint32_t raw = Hash(n * K + k + 777u, 29u);
                b = ((float)(raw >> 9) / 8388608.0f) - 1.0f;
            } else if (d == 5) b = (k & 1u) ? -1.0f : 1.0f;
            hB[n * K + k] = b;
        }
    }
}

int32_t main(int32_t argc, char** argv)
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // ------------------------- perf 模式 -------------------------
    if (argc > 1 && (strcmp(argv[1], "perf") == 0 || strcmp(argv[1], "perf_hf32") == 0)) {
        const int32_t hf32P = (strcmp(argv[1], "perf_hf32") == 0) ? 1 : 0;
        const size_t ab32 = (size_t)pcf::PM * pcf::PK * sizeof(float);
        const size_t bb32 = (size_t)pcf::PN * pcf::PK * sizeof(float);
        const size_t ab16 = (size_t)pcf::PM * pcf::PK * sizeof(uint16_t);
        const size_t bb16 = (size_t)pcf::PN * pcf::PK * sizeof(uint16_t);
        const size_t cb = (size_t)pcf::PM * pcf::PN * sizeof(float);
        void *dA32 = nullptr, *dB32 = nullptr, *dA16 = nullptr, *dB16 = nullptr, *dC = nullptr, *dCyc = nullptr;
        aclrtMalloc(&dA32, ab32, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&dB32, bb32, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&dA16, ab16, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&dB16, bb16, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&dC, cb, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&dCyc, 64, ACL_MEM_MALLOC_HUGE_FIRST);

        float* hA32 = (float*)malloc(ab32);
        float* hB32 = (float*)malloc(bb32);
        uint16_t* hA16 = (uint16_t*)malloc(ab16);
        uint16_t* hB16 = (uint16_t*)malloc(bb16);
        float* hC = (float*)malloc(cb);
        int32_t hCyc[16] = {0};
        // 全 1 操作数：C[0][0] 应恒等于 K（=128），用来确认那 2000 次 Mmad 真的执行了
        for (size_t i = 0; i < (size_t)pcf::PM * pcf::PK; ++i) { hA32[i] = 1.0f; hA16[i] = 0x3F80u; }
        for (size_t i = 0; i < (size_t)pcf::PN * pcf::PK; ++i) { hB32[i] = 1.0f; hB16[i] = 0x3F80u; }

        aclrtMemcpy(dA32, ab32, hA32, ab32, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dB32, bb32, hB32, bb32, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dA16, ab16, hA16, ab16, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dB16, bb16, hB16, bb16, ACL_MEMCPY_HOST_TO_DEVICE);

        const double macs = (double)pcf::PERF_ITERS * pcf::PM * pcf::PN * pcf::PK;

        printf("\n[PCF] Mmad 吞吐：同一 shape M=%u N=%u K=%u，连发 %u 次，SYS_CNT 计时\n",
               pcf::PM, pcf::PN, pcf::PK, pcf::PERF_ITERS);
        printf("%-8s %8s %14s %16s %14s %12s\n", "dtype", "C0", "cycles(all)", "cycles/Mmad", "MAC/cycle", "dev C[0][0]");
        double cycFp32 = 0, cycBf16 = 0;
        for (int variant = 0; variant < 2; ++variant) {
            aclrtMemset(dC, cb, 0, cb);
            aclrtMemset(dCyc, 64, 0, 64);
            if (variant == 0) {
                pcf::perf_fp32_kernel<<<1, 0, stream>>>((float*)dA32, (float*)dB32, (float*)dC, (int32_t*)dCyc, hf32P);
            } else {
                pcf::perf_bf16_kernel<<<1, 0, stream>>>((bfloat16_t*)dA16, (bfloat16_t*)dB16, (float*)dC, (int32_t*)dCyc);
            }
            const aclError err = aclrtSynchronizeStream(stream);
            if (err != ACL_SUCCESS) { printf("[PCF][FAIL] perf rc=%d\n", (int)err); return 1; }
            aclrtMemcpy(hC, cb, dC, cb, ACL_MEMCPY_DEVICE_TO_HOST);
            aclrtMemcpy(hCyc, 64, dCyc, 64, ACL_MEMCPY_DEVICE_TO_HOST);
            const double cyc = (double)hCyc[0];
            if (variant == 0) cycFp32 = cyc; else cycBf16 = cyc;
            printf("%-8s %8d %14.0f %16.2f %14.3f %12.4g\n",
                   (variant == 0 ? "fp32" : "bf16"), hCyc[1], cyc, cyc / pcf::PERF_ITERS,
                   macs / cyc, (double)hC[0]);
        }
        if (cycFp32 > 0 && cycBf16 > 0) {
            printf("[PCF] 同 shape 吞吐比 fp32 : bf16 的 cycle 比为 %.3f x（MAC/cycle 比 %.3f x）\n",
                   cycFp32 / cycBf16, cycBf16 / cycFp32);
        } else {
            printf("[PCF] 比值不可用（一侧 cycle 读数非正）\n");
        }
        free(hA32); free(hB32); free(hA16); free(hB16); free(hC);
        aclrtFree(dA32); aclrtFree(dB32); aclrtFree(dA16); aclrtFree(dB16); aclrtFree(dC); aclrtFree(dCyc);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return 0;
    }

    const size_t aBytes = (size_t)pcf::NDIST * pcf::M_DIM * pcf::K_DIM * sizeof(float);
    const size_t bBytes = (size_t)pcf::NDIST * pcf::N_DIM * pcf::K_DIM * sizeof(float);
    const size_t cBytes = (size_t)pcf::NDIST * pcf::M_DIM * pcf::N_DIM * sizeof(float);
    void *dA = nullptr, *dB = nullptr, *dC = nullptr;
    aclrtMalloc(&dA, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dB, bBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dC, cBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    float* hA = (float*)malloc(aBytes);
    float* hB = (float*)malloc(bBytes);
    float* hC = (float*)malloc(cBytes);
    memset(hC, 0, cBytes);
    for (uint32_t d = 0; d < pcf::NDIST; ++d)
        FillDist(d, hA + (uint64_t)d * pcf::M_DIM * pcf::K_DIM, hB + (uint64_t)d * pcf::N_DIM * pcf::K_DIM);

    aclrtMemcpy(dA, aBytes, hA, aBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dB, bBytes, hB, bBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dC, cBytes, 0, cBytes);

    const int32_t hf32En = (argc > 1 && strcmp(argv[1], "hf32") == 0) ? 1 : 0;
    pcf::prec_kernel<<<1, 0, stream>>>((float*)dA, (float*)dB, (float*)dC, hf32En);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) { printf("[PCF][FAIL] sync rc=%d\n", (int)err); return 1; }
    aclrtMemcpy(hC, cBytes, dC, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    const uint32_t M = pcf::M_DIM, N = pcf::N_DIM, K = pcf::K_DIM;
    printf("\n[PCF] fp32 x fp32 -> fp32 Mmad%s，设备 L0C vs host 参考（M=%u N=%u K=%u）\n",
           hf32En ? "（asc_enable_hf32 开启）" : "（默认：未开 HF32）", M, N, K);
    printf("%-11s %16s %16s %12s %12s %16s %16s\n",
           "dist", "dev C[0][0]", "ref_fp64 C[0][0]", "absErr", "relErr",
           "dev C[1][1]", "dev C[3][3]");
    for (uint32_t d = 0; d < pcf::NDIST; ++d) {
        const float* a = hA + (uint64_t)d * M * K;
        const float* b = hB + (uint64_t)d * N * K;
        const float* c = hC + (uint64_t)d * M * N;
        double ref = 0.0;
        for (uint32_t k = 0; k < K; ++k) ref += (double)a[k] * (double)b[k];
        const double dev = (double)c[0];
        const double ae = fabs(dev - ref);
        const double re = (ref != 0.0) ? ae / fabs(ref) : ae;
        printf("%-11s %16.9g %16.9g %12.3e %12.3e %16.9g %16.9g\n",
               kDistName[d], dev, ref, ae, re, (double)c[M * 1 + 1], (double)c[M * 3 + 3]);
    }

    // d4 rand：逐元素与三种参考比 —— 判别设备实际用的是哪一档操作数精度
    {
        const uint32_t d = 4;
        const float* a = hA + (uint64_t)d * M * K;
        const float* b = hB + (uint64_t)d * N * K;
        const float* c = hC + (uint64_t)d * M * N;
        double maxAbsFp64 = 0, maxAbsBf16 = 0, maxAbsHf32 = 0;
        uint32_t eqFp64 = 0, eqBf16 = 0;
        for (uint32_t m = 0; m < M; ++m) {
            for (uint32_t n = 0; n < N; ++n) {
                double rf = 0, rb = 0, rh = 0;
                for (uint32_t k = 0; k < K; ++k) {
                    const double av = (double)a[m * K + k], bv = (double)b[n * K + k];
                    rf += av * bv;
                    rb += (double)ToBf16Rne(a[m * K + k]) * (double)ToBf16Rne(b[n * K + k]);
                    // HF32 / tf32 / fp16 的尾数都是 10 位 ⇒ 这三档是同一个参考，只算一次
                    rh += (double)ToHf32Rne(a[m * K + k]) * (double)ToHf32Rne(b[n * K + k]);
                }
                const double dv = (double)c[m * N + n];
                maxAbsFp64 = fmax(maxAbsFp64, fabs(dv - rf));
                maxAbsBf16 = fmax(maxAbsBf16, fabs(dv - rb));
                maxAbsHf32 = fmax(maxAbsHf32, fabs(dv - rh));
                if (dv == (double)(float)rf) ++eqFp64;
                if (dv == (double)(float)rb) ++eqBf16;
            }
        }
        printf("\n[PCF] d4 rand 逐元素最大绝对误差（%u 个元素，每个是 K=%u 的内积）:\n", M * N, K);
        printf("   vs fp64 精确和        : %.6e\n", maxAbsFp64);
        printf("   vs bf16-操作数参考    : %.6e   (元素数与 dev 完全相等: %u/%u)\n", maxAbsBf16, eqBf16, M * N);
        printf("   vs hf32/tf32/fp16-操作数参考: %.6e   （三者尾数同为 10 位 ⇒ 是同一个参考，不是三个独立参考）\n", maxAbsHf32);
        printf("   dev 与 fp64 逐位相等元素数: %u/%u\n", eqFp64, M * N);
    }

    if (argc > 1 && strcmp(argv[1], "dump") == 0) {
        const char* dir = (argc > 2) ? argv[2] : ".";
        char path[512];
        snprintf(path, sizeof(path), "%s/prec_a.bin", dir);
        FILE* f = fopen(path, "wb");
        if (f) { fwrite(hA, 1, aBytes, f); fclose(f); }
        snprintf(path, sizeof(path), "%s/prec_b.bin", dir);
        f = fopen(path, "wb");
        if (f) { fwrite(hB, 1, bBytes, f); fclose(f); }
        snprintf(path, sizeof(path), "%s/prec_c.bin", dir);
        f = fopen(path, "wb");
        if (f) { fwrite(hC, 1, cBytes, f); fclose(f); }
        printf("[PCF] dumped prec_a/b/c.bin to %s\n", dir);
    }

    free(hA); free(hB); free(hC);
    aclrtFree(dA); aclrtFree(dB); aclrtFree(dC);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
