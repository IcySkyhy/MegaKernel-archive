/**
 * m4_gdn_recurrent.asc —— Mega kernel M4：GDN decode 递推核（纯 AIV，单 token）
 * （设计约束见 docs/05-megakernel-design.md §2/§6；分析见 docs/10-gdn-analysis.md；
 *  donor：/workspace/ops-transformer/attention/recurrent_gated_delta_rule arch35
 *  （vf_vec_mul_mat.h / vf_outer_add.h 寄存器 VF 写法）+ vllm-ascend
 *  csrc/attention/recurrent_gated_delta_rule ProcessKQ 融合结构）
 *
 * 递推公式（每 value head hv，key head hk = hv//3；全 fp32；docs/10 §1）：
 *   S ← e^g·S;  v ← β·(v − S·k);  S ← S + k⊗v;  o = S·q
 *   其中 S 为 (V=128, K=128) fp32 行主序（cache 布局 [block,NV,V,K] 的 per-head slab），
 *   k/q 为 key head 的 128 维向量（kernel 外已 l2norm；**1/√128 只乘 q**——模型语义，
 *   docs/10 §1「q,k=l2norm(eps 1e-6)，q×=1/√128」，vllm sigmoid_gating.py 仅 b_q*=scale；
 *   本核把 q/k 当不透明输入，见 README §递推公式），v/o 为 value head 的
 *   128 维向量，g（log-decay）/β 为 per-head 标量（kernel 外已算好 gating/sigmoid；
 *   output_gate_type=sigmoid 的 RMSNormGated 在递推核之外，不属于本任务）。
 *
 * 本核范围：只做递推。m=1（单 token）。MTP 多 token / prefill chunk 扫描不在本任务。
 *
 * 数据通路（全部基础 API / 寄存器 VF，无高阶 API / TPipe / TBuf / TQue）：
 *   GM --DataCopy(MTE2)--> UB head slab（128×128 fp32 = 64KB，ping-pong 双 slab）
 *   UB --Reg::LoadAlign/Mul/MulAddDst/ReduceSum/StoreAlign(VEC)--> 寄存器
 *   单遍融合 decay→delta→outer→matvec（每行状态只读一次、写一次，无 64KB 中间量）
 *   UB --DataCopy(MTE3)--> GM（state 原位写回 + o 写出）
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal = get_buf/rls_buf），
 *   不用 set_flag/wait_flag，不挂 PIPE_S。acquire 立即获取；release 用阻塞模式
 *   （mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射的访存落地，
 *   保证对跨 pipe 消费者可见。
 *   跨 head 软件流水：MTE2 预取 head h+nblk（parity 1-p）∥ VEC 计算 head h（parity p）
 *   ∥ MTE3 写回 head h−nblk（同 parity p）。
 *
 * 3510 quirk 规避（docs/05 §6）：
 *   - AIV-only 核以 __vector__ __global__ 声明（launch 才能推导核型）；
 *   - 所有 UB 偏移按 32B 对齐静态分配（UB→GM DataCopy 异常规避）；
 *   - 行数=1 的 Nd2Nz quirk 与本核无关（全部使用 1D 连续拷贝）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>

// ============================================================
// 编译期常量与静态资源表（UB 偏移 / BufferID 全部编译期静态分配）
// ============================================================

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t ROWS = 128;   // V 维（state 行数 / o、v 长度）
constexpr uint32_t COLS = 128;   // K 维（state 列数 / k、q 长度）
constexpr uint32_t VLEN = 64;    // 每个 256B 向量寄存器的 fp32 lane 数
constexpr uint32_t GROUP = 3;    // NV = 3×NK：value head hv 使用 key head hv/3（模型 48=3×16）
constexpr uint32_t MAX_HEADS = 64;  // g/beta UB 缓冲按 64 head 静态分配（host 保证 H ≤ 64）
constexpr uint32_t ST_ELEMS = ROWS * COLS;
constexpr uint32_t ST_BYTES = ST_ELEMS * sizeof(float);

// ---- UB 静态布局（字节偏移；全部 32B 对齐；VECCALC 空间 248KB 内）----
constexpr uint32_t UB_ST0 = 0;                       // state slab ping：128×128 fp32 = 64KB
constexpr uint32_t UB_ST1 = UB_ST0 + ST_BYTES;       // state slab pong                  64KB
constexpr uint32_t UB_Q0 = UB_ST1 + ST_BYTES;        // q [128] fp32 = 512B（本 parity 的 key head）
constexpr uint32_t UB_K0 = UB_Q0 + 512;              // k [128]
constexpr uint32_t UB_V0 = UB_K0 + 512;              // v [128]
constexpr uint32_t UB_O0 = UB_V0 + 512;              // o [128]
constexpr uint32_t UB_Q1 = UB_O0 + 512;
constexpr uint32_t UB_K1 = UB_Q1 + 512;
constexpr uint32_t UB_V1 = UB_K1 + 512;
constexpr uint32_t UB_O1 = UB_V1 + 512;
constexpr uint32_t UB_G = UB_O1 + 512;               // g  [64][8] fp32（stride-8 填充，仅 [h][0] 有效）2KB
constexpr uint32_t UB_EG = UB_G + MAX_HEADS * 32;    // e^g（VEC 内 Exp 一次成）                       2KB
constexpr uint32_t UB_BETA = UB_EG + MAX_HEADS * 32; // β  [64][8] fp32                               2KB
static_assert(UB_BETA + MAX_HEADS * 32 <= 248 * 1024, "UB footprint exceeds 248KB");
static_assert(UB_ST0 % 32 == 0 && UB_ST1 % 32 == 0 && UB_Q0 % 32 == 0 && UB_G % 32 == 0 &&
                  UB_EG % 32 == 0 && UB_BETA % 32 == 0,
              "UB offsets must be 32B aligned");

// ---- BufferID（每核用户可用 0-27，静态分配；单 AIV 核内同步）----
//   全局获取顺序一致（ST → IV → OV），无循环等待：
//     BUF_STx : MTE2 装载 slab → VEC 递推 → MTE3 原位写回（token 随 slab 全生命周期）
//     BUF_IVx : MTE2 装载 q/k/v → VEC 消费
//     BUF_OVx : VEC 写出 o → MTE3 写出 GM
//     BUF_GB  : MTE2 装载 g/β → VEC Exp 成 e^g（kernel 开头一次）
constexpr AscendC::MutexID BUF_ST0 = 0;
constexpr AscendC::MutexID BUF_ST1 = 1;
constexpr AscendC::MutexID BUF_IV0 = 2;
constexpr AscendC::MutexID BUF_IV1 = 3;
constexpr AscendC::MutexID BUF_OV0 = 4;
constexpr AscendC::MutexID BUF_OV1 = 5;
constexpr AscendC::MutexID BUF_GB = 6;

// BufferID 语义封装：acquire 立即获取；release 用阻塞模式（mode=false = CANN 默认
// ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射访存落地，对跨 pipe 消费者可见。
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// ============================================================
// 寄存器 VF 递推（照 donor arch35 融合写法的单遍版）
// ============================================================

// g -> e^g：[64][8] fp32（每 head 一个 32B 槽位，[h][0] 有效），512 float = 8 个 64-lane
// tile 各一次 Exp（超出 numHeads 的槽位为废值，不读）
__simd_vf__ inline void EgExpAll(__ubuf__ float* egUb, __ubuf__ float* gUb)
{
    AscendC::Reg::RegTensor<float> g;
    AscendC::Reg::MaskReg fullM = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();
    for (uint32_t t = 0; t < MAX_HEADS * 8 / VLEN; ++t) {
        AscendC::Reg::LoadAlign(g, gUb + t * VLEN);
        AscendC::Reg::Exp(g, g, fullM);
        AscendC::Reg::StoreAlign(egUb + t * VLEN, g, fullM);
    }
}

// 单 head 递推：st(UB 128×128 fp32) 原位读改写；o(UB 128) 写出。
// 每行 i 完全在寄存器内完成四步融合（状态行只 Load 一次、Store 一次）：
//   decay   : s = e^g * S[i,:]                     （Mul，egB 为 e^g 广播寄存器）
//   delta   : w = Σ_j s[j]·k[j]; d = β·(v[i] − w)  （Mul+Add+ReduceSum，DIST_BRC_B32 取 v[i]）
//   outer   : S[i,:] += k·d                        （MulAddDst，随即 StoreAlign 回 slab）
//   matvec  : o[i] = Σ_j S_new[i,j]·q[j]           （Mul+Add+ReduceSum，DIST_FIRST_ELEMENT_B32 存 lane0）
__simd_vf__ inline void GdnHeadRecurrence(__ubuf__ float* stUb, __ubuf__ float* qUb, __ubuf__ float* kUb,
                                          __ubuf__ float* vUb, __ubuf__ float* oUb, __ubuf__ float* egP,
                                          __ubuf__ float* betaP)
{
    AscendC::Reg::RegTensor<float> k0, k1, q0, q1, egB, betaB;
    AscendC::Reg::RegTensor<float> s0, s1, t, u, r, wB, vB, dB;
    AscendC::Reg::MaskReg fullM = AscendC::Reg::CreateMask<float, AscendC::Reg::MaskPattern::ALL>();

    AscendC::Reg::LoadAlign(k0, kUb);
    AscendC::Reg::LoadAlign(k1, kUb + VLEN);
    AscendC::Reg::LoadAlign(q0, qUb);
    AscendC::Reg::LoadAlign(q1, qUb + VLEN);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_BRC_B32>(egB, egP);
    AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_BRC_B32>(betaB, betaP);

    for (uint32_t i = 0; i < ROWS; ++i) {
        __ubuf__ float* row = stUb + i * COLS;
        AscendC::Reg::LoadAlign(s0, row);
        AscendC::Reg::LoadAlign(s1, row + VLEN);
        // decay: S ← e^g·S
        AscendC::Reg::Mul(s0, s0, egB, fullM);
        AscendC::Reg::Mul(s1, s1, egB, fullM);
        // delta: w = (e^g·S)·k；d = β·(v[i] − w)
        AscendC::Reg::Mul(t, s0, k0, fullM);
        AscendC::Reg::Mul(u, s1, k1, fullM);
        AscendC::Reg::Add(t, t, u, fullM);
        AscendC::Reg::ReduceSum(r, t, fullM);   // lane0 = w
        AscendC::Reg::Duplicate(wB, r, fullM);  // 广播 w 到全 lane
        AscendC::Reg::LoadAlign<float, AscendC::Reg::LoadDist::DIST_BRC_B32>(vB, vUb + i);
        AscendC::Reg::Sub(dB, vB, wB, fullM);
        AscendC::Reg::Mul(dB, dB, betaB, fullM);  // 全 lane = delta[i]
        // outer: S ← S + k⊗d（随即写回 slab）
        AscendC::Reg::MulAddDst(s0, k0, dB, fullM);
        AscendC::Reg::MulAddDst(s1, k1, dB, fullM);
        AscendC::Reg::StoreAlign(row, s0, fullM);
        AscendC::Reg::StoreAlign(row + VLEN, s1, fullM);
        // matvec: o[i] = S_new·q
        AscendC::Reg::Mul(t, s0, q0, fullM);
        AscendC::Reg::Mul(u, s1, q1, fullM);
        AscendC::Reg::Add(t, t, u, fullM);
        AscendC::Reg::ReduceSum(r, t, fullM);  // lane0 = o[i]
        AscendC::Reg::StoreAlign<float, AscendC::Reg::StoreDist::DIST_FIRST_ELEMENT_B32>(oUb + i, r, fullM);
    }
}

// ============================================================
// Kernel 实现
// ============================================================

class GdnDecodeRec {
public:
    __aicore__ inline GdnDecodeRec() {}

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR g, GM_ADDR beta, GM_ADDR state,
                                GM_ADDR out, uint32_t numHeads)
    {
        numHeads_ = numHeads;
        qGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(q));
        kGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(k));
        vGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(v));
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(g));
        betaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(beta));
        stateGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(state));
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out));
    }

    __aicore__ inline void Process()
    {
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t nblk = AscendC::GetBlockNum();

        // ---- (1) g/β 一次装载 + e^g 预算（布局 [H,8] fp32，每 head 占 32B，仅 [h][0] 有效）----
        LocalTensor<float> gL(TPosition::VECCALC, UB_G, MAX_HEADS * 8);
        LocalTensor<float> betaL(TPosition::VECCALC, UB_BETA, MAX_HEADS * 8);
        LocalTensor<float> egL(TPosition::VECCALC, UB_EG, MAX_HEADS * 8);
        __ubuf__ float* gUb = reinterpret_cast<__ubuf__ float*>(gL.GetPhyAddr());
        __ubuf__ float* egUb = reinterpret_cast<__ubuf__ float*>(egL.GetPhyAddr());
        __ubuf__ float* betaUb = reinterpret_cast<__ubuf__ float*>(betaL.GetPhyAddr());
        {
            const AscendC::DataCopyParams gp{static_cast<uint16_t>(numHeads_), 1, 0, 0};  // H 块 × 32B
            BufAcquire<PIPE_MTE2>(BUF_GB);
            DataCopy(gL, gGm_, gp);
            DataCopy(betaL, betaGm_, gp);
            BufRelease<PIPE_MTE2>(BUF_GB);
            BufAcquire<PIPE_V>(BUF_GB);
            EgExpAll(egUb, gUb);
            BufRelease<PIPE_V>(BUF_GB);
        }

        // ---- (2) head 软件流水：prefetch(h+nblk, parity 1-p) ∥ compute(h, p) ∥ writeback(h, p) ----
        if (bid < numHeads_) {
            CopyInHead(bid, 0);
        }
        uint32_t slot = 0;
        for (uint32_t h = bid; h < numHeads_; h += nblk, ++slot) {
            const uint32_t p = slot & 1;
            const uint32_t hn = h + nblk;
            if (hn < numHeads_) {
                CopyInHead(hn, p ^ 1);  // MTE2 预取下一 head（与下方 VEC/MTE3 重叠）
            }
            ComputeHead(h, p, egUb, betaUb);
            CopyOutHead(h, p);
        }
    }

private:
    // MTE2：state slab（128 行 × 512B 连续）+ q/k/v（key head hk = h/3 的 q/k）
    __aicore__ inline void CopyInHead(uint32_t h, uint32_t p)
    {
        const uint32_t hk = h / GROUP;
        LocalTensor<float> stL(TPosition::VECCALC, p ? UB_ST1 : UB_ST0, ST_ELEMS);
        LocalTensor<float> qL(TPosition::VECCALC, p ? UB_Q1 : UB_Q0, COLS);
        LocalTensor<float> kL(TPosition::VECCALC, p ? UB_K1 : UB_K0, COLS);
        LocalTensor<float> vL(TPosition::VECCALC, p ? UB_V1 : UB_V0, ROWS);

        const AscendC::MutexID bufSt = p ? BUF_ST1 : BUF_ST0;
        const AscendC::MutexID bufIv = p ? BUF_IV1 : BUF_IV0;
        BufAcquire<PIPE_MTE2>(bufSt);
        const AscendC::DataCopyParams sp{ROWS, (COLS * static_cast<uint32_t>(sizeof(float))) / 32, 0, 0};
        DataCopy(stL, stateGm_[static_cast<uint64_t>(h) * ST_ELEMS], sp);
        BufRelease<PIPE_MTE2>(bufSt);

        BufAcquire<PIPE_MTE2>(bufIv);
        DataCopy(qL, qGm_[static_cast<uint64_t>(hk) * COLS], COLS);
        DataCopy(kL, kGm_[static_cast<uint64_t>(hk) * COLS], COLS);
        DataCopy(vL, vGm_[static_cast<uint64_t>(h) * ROWS], ROWS);
        BufRelease<PIPE_MTE2>(bufIv);
    }

    // VEC：单遍融合递推（slab 原位读改写，o 写 UB）
    __aicore__ inline void ComputeHead(uint32_t h, uint32_t p, __ubuf__ float* egUb, __ubuf__ float* betaUb)
    {
        LocalTensor<float> stL(TPosition::VECCALC, p ? UB_ST1 : UB_ST0, ST_ELEMS);
        LocalTensor<float> qL(TPosition::VECCALC, p ? UB_Q1 : UB_Q0, COLS);
        LocalTensor<float> kL(TPosition::VECCALC, p ? UB_K1 : UB_K0, COLS);
        LocalTensor<float> vL(TPosition::VECCALC, p ? UB_V1 : UB_V0, ROWS);
        LocalTensor<float> oL(TPosition::VECCALC, p ? UB_O1 : UB_O0, ROWS);
        __ubuf__ float* stUb = reinterpret_cast<__ubuf__ float*>(stL.GetPhyAddr());
        __ubuf__ float* qUb = reinterpret_cast<__ubuf__ float*>(qL.GetPhyAddr());
        __ubuf__ float* kUb = reinterpret_cast<__ubuf__ float*>(kL.GetPhyAddr());
        __ubuf__ float* vUb = reinterpret_cast<__ubuf__ float*>(vL.GetPhyAddr());
        __ubuf__ float* oUb = reinterpret_cast<__ubuf__ float*>(oL.GetPhyAddr());

        const AscendC::MutexID bufSt = p ? BUF_ST1 : BUF_ST0;
        const AscendC::MutexID bufIv = p ? BUF_IV1 : BUF_IV0;
        const AscendC::MutexID bufOv = p ? BUF_OV1 : BUF_OV0;
        BufAcquire<PIPE_V>(bufSt);   // 等 MTE2 slab 就位
        BufAcquire<PIPE_V>(bufIv);   // 等 MTE2 q/k/v 就位
        BufAcquire<PIPE_V>(bufOv);   // 等上一轮回 MTE3 读走 o
        // eg/β 为 [H][8] fp32 槽位（32B/head，仅 [h][0] 有效），BRC 按槽位首元素广播
        GdnHeadRecurrence(stUb, qUb, kUb, vUb, oUb, egUb + h * 8, betaUb + h * 8);
        BufRelease<PIPE_V>(bufOv);   // o 写完且 drain，MTE3 可写 GM
        BufRelease<PIPE_V>(bufIv);   // q/k/v 已消费，MTE2 可复用
        BufRelease<PIPE_V>(bufSt);   // slab 递推完且 drain，MTE3 可原位写回
    }

    // MTE3：state 原位写回 + o 写出
    __aicore__ inline void CopyOutHead(uint32_t h, uint32_t p)
    {
        LocalTensor<float> stL(TPosition::VECCALC, p ? UB_ST1 : UB_ST0, ST_ELEMS);
        LocalTensor<float> oL(TPosition::VECCALC, p ? UB_O1 : UB_O0, ROWS);

        const AscendC::MutexID bufSt = p ? BUF_ST1 : BUF_ST0;
        const AscendC::MutexID bufOv = p ? BUF_OV1 : BUF_OV0;
        BufAcquire<PIPE_MTE3>(bufSt);
        const AscendC::DataCopyParams sp{ROWS, (COLS * static_cast<uint32_t>(sizeof(float))) / 32, 0, 0};
        DataCopy(stateGm_[static_cast<uint64_t>(h) * ST_ELEMS], stL, sp);
        BufRelease<PIPE_MTE3>(bufSt);

        BufAcquire<PIPE_MTE3>(bufOv);
        DataCopy(outGm_[static_cast<uint64_t>(h) * ROWS], oL, ROWS);
        BufRelease<PIPE_MTE3>(bufOv);
    }

private:
    uint32_t numHeads_;
    GlobalTensor<float> qGm_;
    GlobalTensor<float> kGm_;
    GlobalTensor<float> vGm_;
    GlobalTensor<float> gGm_;
    GlobalTensor<float> betaGm_;
    GlobalTensor<float> stateGm_;
    GlobalTensor<float> outGm_;
};

}  // namespace

__vector__ __global__ void gdn_decode_recurrence_kernel(GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR g, GM_ADDR beta,
                                                        GM_ADDR state, GM_ADDR out, uint32_t numHeads)
{
    GdnDecodeRec op;
    op.Init(q, k, v, g, beta, state, out, numHeads);
    op.Process();
}

// ============================================================
// Host 侧：确定性输入生成 + 运行读回 + dump（数值校验由 check_ref.py 完成）
// ============================================================

// ---- 确定性伪随机（与 m1/m2 同风格：纯公式，无 rand 状态）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

static float HashU11(uint32_t i, uint32_t j, uint32_t salt)  // [-1, 1)
{
    return static_cast<float>(Hash3(i, j, salt) % 1000000u) / 500000.0f - 1.0f;
}

// q/k：hash 向量 -> l2norm × 1/√128（模拟 kernel 外预计算的 l2norm(eps=1e-6)×scale；
// **注意**：模型真实语义是 1/√128 只乘 q（docs/10 §1），这里 host 测试数据对 q/k **都**
// 乘了 scale——本核把 q/k 当不透明输入，故对递推的正确性验证无影响（README 已注明）；
// host 无 libm，1/sqrt 用二分 [1e-4, 1] 46 轮，~1e-14 精度，确定性、无收敛域问题）
static void GenQk(float* dst, uint32_t row, uint32_t salt)
{
    float x[128];
    double sum = 0.0;
    for (uint32_t i = 0; i < 128; ++i) {
        x[i] = HashU11(i, row, salt);
        sum += static_cast<double>(x[i]) * x[i];
    }
    const double t = sum * 128.0;  // (sqrt(128)·|x|)^2 ∈ [~640, ~2e6]
    double lo = 1e-4, hi = 1.0;
    for (int it = 0; it < 46; ++it) {
        const double mid = 0.5 * (lo + hi);
        if (mid * mid * t < 1.0) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    const double y = 0.5 * (lo + hi);  // 1/sqrt(t)
    for (uint32_t i = 0; i < 128; ++i) {
        dst[i] = static_cast<float>(static_cast<double>(x[i]) * y);
    }
}

static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// 运行一个 (H, blockDim) 组合：生成 -> H2D -> launch -> D2H -> dump（供 check_ref.py 校验）
static bool RunCase(aclrtStream stream, uint32_t H, uint32_t blk, uint32_t salt)
{
    const uint32_t nK = (H + GROUP - 1) / GROUP;
    const size_t qkBytes = static_cast<size_t>(nK) * 128 * sizeof(float);
    const size_t vBytes = static_cast<size_t>(H) * 128 * sizeof(float);
    const size_t gbPadBytes = static_cast<size_t>(H) * 8 * sizeof(float);
    const size_t stBytes = static_cast<size_t>(H) * 128 * 128 * sizeof(float);

    float *qHost = nullptr, *kHost = nullptr, *vHost = nullptr, *gPadHost = nullptr, *bPadHost = nullptr;
    float *stHost = nullptr, *oHost = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&qHost), qkBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&kHost), qkBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&vHost), vBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&gPadHost), gbPadBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&bPadHost), gbPadBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&stHost), stBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&oHost), vBytes);
    float *qDev = nullptr, *kDev = nullptr, *vDev = nullptr, *gDev = nullptr, *bDev = nullptr;
    float *stDev = nullptr, *oDev = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&qDev), qkBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&kDev), qkBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&vDev), vBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&gDev), gbPadBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&bDev), gbPadBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&stDev), stBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&oDev), vBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    // ---- 确定性生成 ----
    for (uint32_t hk = 0; hk < nK; ++hk) {
        GenQk(qHost + static_cast<size_t>(hk) * 128, hk, salt + 0x51);
        GenQk(kHost + static_cast<size_t>(hk) * 128, hk, salt + 0x52);
    }
    for (uint32_t h = 0; h < H; ++h) {
        for (uint32_t i = 0; i < 128; ++i) {
            vHost[static_cast<size_t>(h) * 128 + i] = HashU11(i, h, salt + 0x53);
        }
        gPadHost[static_cast<size_t>(h) * 8] = -static_cast<float>(Hash3(h, 0, salt + 0x54) % 6001u) / 1000.0f;
        bPadHost[static_cast<size_t>(h) * 8] =
            0.1f + static_cast<float>(Hash3(h, 1, salt + 0x55) % 8000u) / 10000.0f;
        for (uint32_t i = 0; i < 128; ++i) {
            for (uint32_t j = 0; j < 128; ++j) {
                stHost[(static_cast<size_t>(h) * 128 + i) * 128 + j] = HashU11(i * 128 + j, h, salt + 0x56);
            }
        }
    }

    // ---- dump 输入侧（check_ref.py 读取；g/beta 导出紧凑 [H] 布局）----
    // 注意：state_init 必须在 launch 前落盘（D2H 会就地把 stHost 覆盖为结果）。
    char p[64], name[96];
    snprintf(p, sizeof(p), "m4_case_h%02ub%02u_", H, blk);
    bool ok = true;
    snprintf(name, sizeof(name), "%sq.bin", p); ok &= WriteBin(name, qHost, qkBytes);
    snprintf(name, sizeof(name), "%sk.bin", p); ok &= WriteBin(name, kHost, qkBytes);
    snprintf(name, sizeof(name), "%sv.bin", p); ok &= WriteBin(name, vHost, vBytes);
    {
        float* gc = new float[H];
        float* bc = new float[H];
        for (uint32_t h = 0; h < H; ++h) {
            gc[h] = gPadHost[static_cast<size_t>(h) * 8];
            bc[h] = bPadHost[static_cast<size_t>(h) * 8];
        }
        snprintf(name, sizeof(name), "%sg.bin", p); ok &= WriteBin(name, gc, H * sizeof(float));
        snprintf(name, sizeof(name), "%sbeta.bin", p); ok &= WriteBin(name, bc, H * sizeof(float));
        delete[] gc;
        delete[] bc;
    }
    snprintf(name, sizeof(name), "%sstate_init.bin", p); ok &= WriteBin(name, stHost, stBytes);

    aclrtMemcpy(qDev, qkBytes, qHost, qkBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(kDev, qkBytes, kHost, qkBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(vDev, vBytes, vHost, vBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(gDev, gbPadBytes, gPadHost, gbPadBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDev, gbPadBytes, bPadHost, gbPadBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(stDev, stBytes, stHost, stBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    gdn_decode_recurrence_kernel<<<blk, 0, stream>>>(reinterpret_cast<uint8_t*>(qDev), reinterpret_cast<uint8_t*>(kDev),
                                                     reinterpret_cast<uint8_t*>(vDev), reinterpret_cast<uint8_t*>(gDev),
                                                     reinterpret_cast<uint8_t*>(bDev), reinterpret_cast<uint8_t*>(stDev),
                                                     reinterpret_cast<uint8_t*>(oDev), H);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M4][FAIL] H=%u blk=%u kernel launch/sync error %d\n", H, blk, static_cast<int>(launchErr));
        return false;
    }
    aclrtMemcpy(oHost, vBytes, oDev, vBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(stHost, stBytes, stDev, stBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    snprintf(name, sizeof(name), "%sstate_out.bin", p); ok &= WriteBin(name, stHost, stBytes);
    snprintf(name, sizeof(name), "%sout.bin", p); ok &= WriteBin(name, oHost, vBytes);
    printf("[M4] H=%-2u blk=%-2u : launch/readback OK, dump %s\n", H, blk, ok ? "ok" : "WRITE FAILED");

    aclrtFree(qDev); aclrtFreeHost(qHost);
    aclrtFree(kDev); aclrtFreeHost(kHost);
    aclrtFree(vDev); aclrtFreeHost(vHost);
    aclrtFree(gDev); aclrtFreeHost(gPadHost);
    aclrtFree(bDev); aclrtFreeHost(bPadHost);
    aclrtFree(stDev); aclrtFreeHost(stHost);
    aclrtFree(oDev); aclrtFreeHost(oHost);
    return ok;
}

int32_t main()
{
    // 覆盖：小 head 子集（1 head/AIV）、8 head 满 AIV、8 head 折半 AIV（2 head/AIV 流水）、
    //       4 head 超配 AIV（空闲 AIV 早退路径）、48 head 整层子集（2 head/AIV，覆盖全部 16 个 key head 映射）
    const uint32_t cases[][2] = {{4, 4}, {8, 8}, {8, 4}, {4, 8}, {48, 24}};
    constexpr uint32_t nCases = sizeof(cases) / sizeof(cases[0]);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool allOk = true;
    for (uint32_t c = 0; c < nCases; ++c) {
        allOk &= RunCase(stream, cases[c][0], cases[c][1], 0x4D00 + c * 7);
    }
    printf("[M4] ===== %s（数值校验请运行 check_ref.py）=====\n", allOk ? "ALL RUNS OK" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
