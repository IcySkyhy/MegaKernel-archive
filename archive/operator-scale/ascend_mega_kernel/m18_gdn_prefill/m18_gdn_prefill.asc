/**
 * m18_gdn_prefill.asc —— Mega kernel M18：GDN 线性注意力 prefill chunk 扫描核
 *
 * 目标：把 decode 侧 m=1 的递推核（m4_gdn_recurrent）换成 **分块扫描（chunked scan）**，
 * 支持 m 到 4097（= 64×64 + 1，尾块 ragged）。设计约束（用户定）：mix(1,2) 全核启动、
 * 只用基础 API、禁 TPipe/TBuf/TQue/AllocTensor、buffer id / cross core id / 地址自己静态管理、
 * 尽量不挂 PIPE_S、功能优先从现有代码库抄改。
 *
 * 数学（逐句对照 /workspace/vllm-ascend/vllm_ascend/ops/triton/fla/ 与
 * /workspace/ops-transformer/attention/chunk_gated_delta_rule arch35，见 README §数学）：
 *
 *   每 (value head hv, key head hk = hv/3) 独立做一次 chunk 扫描。chunk 长 BT=64。
 *   chunk 内（局部，仅依赖本 chunk 输入）：
 *     ĝ      = inclusive cumsum_{j<=i} g_j           （**chunk 内**前缀和，每 chunk 从 0 起）
 *     eg     = exp(ĝ)，ig = exp(−ĝ)，egL = eg[cv−1]
 *     Γs[i,j]= eg_i·ig_j  (j<i，否则 0)              （严格下三角）
 *     A[i,j] = β_i·Γs[i,j]·(k_i·k_j)                 （KKT + 衰减 + β）
 *     u      = (I+A)^{-1}·(β⊙v)                      [BT,DV]
 *     w      = (I+A)^{-1}·(β⊙eg⊙k)                   [BT,DK]   （= T@…，T=(I+A)^{-1}）
 *   chunk 间（串行状态扫描，S = 状态 [DK,DV] fp32）：
 *     d      = u − w·S_0                             （raw delta，= fla 的 v_new）
 *     o_part = ((q·scale)·S_0) ⊙_row eg
 *     AB[i,j]= Γi[i,j]·(q_i·k_j)  (j<=i，含对角)
 *     o      = o_part + AB·d
 *     d'     = d ⊙ ig
 *     S_1    = egL·(S_0 + kᵀ·d')
 *   （vllm-ascend chunk_delta_h.py:121-149 的 fwd_h 正是「先用未衰减 S 减 w@S、再按
 *     e^{ĝ_C−ĝ_j} 缩放 d、S 乘 e^{ĝ_C} 后累加」，与本式逐句一致；fla 原版把衰减提到
 *     w@h 之前且 w 里不带 e^ĝ，两者等价，见 README §数学。）
 *
 * 关键实现选择（与 donor 的差异，见 README §与 donor 的差异 / §AIC 升级路径）：
 *   * donor 显式算出 T = (I+A)^{-1}（AIV 32×32 前代 + AIC 2×2 块合并），再用 cube GEMM
 *     求 T@RHS。本核 **不物化 T**，直接对两个右端做行前代求解（(I+A)X = RHS，行串行
 *     BT 步）——同一公式、flop 更少、条件数更好，且不需要单位阵与块合并。arch35 的
 *     InverseAIVVF<32> 正是本实现 TrilSolveVF 取 RHS=I 的特例。
 *   * 全程 fp32（算子面 / UB 面 / 寄存器面），不引入 bf16 —— 以对齐 fp64 参考的紧容差判据。
 *     donor 走 bf16 操作数 + fp32 累加（生产精度目标），见 README §已知限制。
 *   * AIC 在本切分为空转（不发起任何访存）：本 chunk 的工作全是 fp32 向量域，48 个 value
 *     head 用 48 个 AIV（1 head/AIV）；mix(1,2) 的 56 个 AIV 线程里 8 个空闲早退（占用 48/56，
 *     不是"铺满"）。AIC 参与需走 arch35 三段式 + bf16 操作数。
 *
 * 数据通路（全部基础 API / 寄存器 VF，无高阶 API / TPipe / TBuf / TQue / AllocTensor）：
 *   GM --DataCopy(MTE2)--> UB（k/q/v/g/β 与状态 S）
 *   UB --Reg::LoadAlign/Mul/MulAddDst/StoreAlign(VEC)--> 寄存器
 *   UB --DataCopy(MTE3)--> GM（o 逐 chunk 写出、S 收尾写出、probe 抽点）
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal = get_buf/rls_buf；m4 同款封装），
 *   不用 set_flag/wait_flag，不挂 PIPE_S。acquire 立即获取；release 用阻塞模式
 *   （mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射的访存落地，
 *   保证对跨 pipe 消费者可见。
 *   BUF_BLK 是「一个 chunk 的 UB 工作集」令牌，按 MTE2 → V → MTE3 → MTE2 三方轮转
 *   （UB_V 每个 chunk 先装 v、后被 o 覆盖，必须让 MTE3 读完 o 才能给下一 chunk 的 MTE2）。
 *   同 pipe 背靠背同类拷贝不保序（M1 实测裁决），本核每次 DataCopy 换 buffer/地址，
 *   靠 BufferID 交接，无「同 buffer 背靠背复用」写法。
 *
 * 3510 quirk 规避（docs/05 §6）：
 *   - mix(1,2) 核用 __global__ __mix__(1,2) 声明；AIV 视角 GetBlockIdx()∈[0,2N)，
 *     GetBlockNum()=AIC 数（m14 已确认）；
 *   - 所有 UB 偏移按 32B 对齐静态分配（UB→GM DataCopy 异常规避）；
 *   - 所有 GM→UB DataCopy 的字节数按 32B 取整（ragged 尾块 g/β 按 8 元素上取整，
 *     多读 lane 随后用 mask 置零覆盖；GM 侧预留尾部 padding 防越界读）；
 *   - VF 内 UB store→load 依赖用 LocalMemBar<VEC_STORE,VEC_LOAD>（arch35 同款）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <ctime>
#include <vector>

namespace {

using namespace AscendC;
using namespace AscendC::Reg;

// ============================================================
// 编译期常量（chunk 尺寸 BT 是唯一的调优旋钮）
// ============================================================
constexpr uint32_t BT = 64;    // chunk 长度（编译期常量；本项目 donor 亦为 64，见 README §chunk 取值依据）
constexpr uint32_t DK = 128;   // key/q head dim
constexpr uint32_t DV = 128;   // value head dim
constexpr uint32_t VL = 64;    // 单个 fp32 向量寄存器 lane 数（256B / 4B）
constexpr uint32_t GROUP = 3;  // NV = 3×NK：value head hv 使用 key head hv/3（模型 48=3×16）
constexpr uint32_t RBLK = 4;   // 小 GEMM 行块（4 累加 + 4 BRC + 1 B 向量寄存器）
constexpr uint32_t MAX_CHUNKS = 128;  // probe 区静态预留 chunk 数（T ≤ 8192）

constexpr uint32_t KE = BT * DK;  // 8192
constexpr uint32_t VE = BT * DV;  // 8192
constexpr uint32_t AE = BT * BT;  // 4096
constexpr uint32_t HE = DK * DV;  // 16384

// ---- UB 静态布局（字节偏移；全部 32B 对齐）----
constexpr uint32_t UB_K = 0;                 // k  [BT,DK] fp32 32KB（整 chunk 只读）
constexpr uint32_t UB_Q = UB_K + KE * 4;     // q  [BT,DK] 32KB → q·scale
constexpr uint32_t UB_V = UB_Q + KE * 4;     // v→RHS_k→w→o_part→o  [BT,DV] 32KB
constexpr uint32_t UB_U = UB_V + VE * 4;     // u→d  [BT,DV] 32KB
constexpr uint32_t UB_A = UB_U + VE * 4;     // KKT→A→AB  [BT,BT] 16KB
constexpr uint32_t UB_G = UB_A + AE * 4;     // Γs / Γi  [BT,BT] 16KB
constexpr uint32_t UB_H = UB_G + AE * 4;     // 状态 S [DK,DV] fp32 64KB（跨 chunk 常驻）
constexpr uint32_t UB_SC = UB_H + HE * 4;    // 标量区 6×[BT] fp32 = 1536B
constexpr uint32_t SC_E = BT * 4;
constexpr uint32_t UB_SC_G = UB_SC + 0 * SC_E;   // g
constexpr uint32_t UB_SC_B = UB_SC + 1 * SC_E;   // β
constexpr uint32_t UB_SC_GC = UB_SC + 2 * SC_E;  // ĝ
constexpr uint32_t UB_SC_EG = UB_SC + 3 * SC_E;  // e^ĝ
constexpr uint32_t UB_SC_IG = UB_SC + 4 * SC_E;  // e^{−ĝ}
constexpr uint32_t UB_SC_SG = UB_SC + 5 * SC_E;  // β⊙e^ĝ
constexpr uint32_t UB_TOTAL = UB_SC + 6 * SC_E;

static_assert(UB_TOTAL <= 248 * 1024, "UB footprint exceeds 248KB");
static_assert(UB_K % 32 == 0 && UB_Q % 32 == 0 && UB_V % 32 == 0 && UB_U % 32 == 0 && UB_A % 32 == 0 &&
                  UB_G % 32 == 0 && UB_H % 32 == 0 && UB_SC % 32 == 0,
              "UB offsets must be 32B aligned");

// ---- BufferID（每核用户可用 0-27，静态分配）----
constexpr AscendC::MutexID BUF_BLK = 0;  // 「一个 chunk 的 UB 工作集」令牌：MTE2→V→MTE3→MTE2
constexpr AscendC::MutexID BUF_ST = 1;   // MTE2 装载状态 S → V
constexpr AscendC::MutexID BUF_SO = 2;   // V 收尾写 S → MTE3 写 GM
constexpr AscendC::MutexID BUF_PR = 3;   // V probe 抽点 → MTE3 写 GM（串行握手，保证读完成）

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);  // mode=false：阻塞释放，等本 pipe 已发射指令落地（CANN ASC_LOCK_BLOCK 默认）
}

// ============================================================
// VF 原语
// ============================================================

__simd_vf__ inline void MemBarVL()
{
    LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
}

// ptr 起 count 个 fp32 置 0（count 必须是 64 的倍数）
__simd_vf__ inline void ZeroVF(__ubuf__ float* ptr, uint32_t count)
{
    RegTensor<float> z;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    Duplicate(z, 0.0f);
    for (uint16_t t = 0; t < static_cast<uint16_t>(count / VL); ++t) {
        StoreAlign(ptr + static_cast<uint32_t>(t) * VL, z, allF);
    }
}

// [from, BT) lane 置 0（一个 [BT] 向量，用于尾块 padding）
__simd_vf__ inline void ZeroTailVF(__ubuf__ float* ptr, uint32_t from)
{
    RegTensor<float> z;
    RegTensor<int32_t> laneIdx;
    MaskReg allI = CreateMask<int32_t, MaskPattern::ALL>();
    MaskReg m;
    Arange(laneIdx, static_cast<int32_t>(0));
    Compares<int32_t, CMPMODE::GE>(m, laneIdx, static_cast<int32_t>(from), allI);
    Duplicate(z, 0.0f);
    StoreAlign(ptr, z, m);
}

/**
 * ĝ = inclusive cumsum(g)（Hillis–Steele，log2(BT) 轮，照 arch35 CumSumExpVF）；
 * eg = exp(ĝ)；ig = exp(−ĝ)。
 * 尾块 padding lane 的 g 已置 0，故其 ĝ = ĝ[cv−1]（常数），不会溢出。
 */
__simd_vf__ inline void CumSumExpVF(__ubuf__ float* gUb, __ubuf__ float* gcUb, __ubuf__ float* egUb,
                                    __ubuf__ float* igUb)
{
    RegTensor<float> gc, shifted, tmp;
    RegTensor<int32_t> laneIdx, gidx;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    MaskReg allI = CreateMask<int32_t, MaskPattern::ALL>();
    MaskReg addMask;

    LoadAlign(gc, gUb);
    Arange(laneIdx, static_cast<int32_t>(0));
    for (int32_t stride = 1; stride < static_cast<int32_t>(BT); stride <<= 1) {
        Adds<int32_t>(gidx, laneIdx, -stride, allI);
        Maxs<int32_t>(gidx, gidx, static_cast<int32_t>(0), allI);
        Gather<float, uint32_t>(shifted, gc, reinterpret_cast<RegTensor<uint32_t>&>(gidx));
        Compares<int32_t, CMPMODE::GE>(addMask, laneIdx, stride, allI);
        Add<float, MaskMergeMode::MERGING>(gc, gc, shifted, addMask);
    }
    StoreAlign<float, StoreDist::DIST_NORM>(gcUb, gc, allF);
    Exp<float, MaskMergeMode::ZEROING>(tmp, gc, allF);
    StoreAlign<float, StoreDist::DIST_NORM>(egUb, tmp, allF);
    Muls<float>(tmp, gc, -1.0f, allF);
    Exp<float, MaskMergeMode::ZEROING>(tmp, tmp, allF);
    StoreAlign<float, StoreDist::DIST_NORM>(igUb, tmp, allF);
}

// Γ 行：row r 的 lane j<r（严格下三角）→ Γ[i,j] = exp(ĝ_i−ĝ_j) = eg_i·ig_j
__simd_vf__ inline void GammaStrictVF(__ubuf__ float* egUb, __ubuf__ float* igUb, __ubuf__ float* gamUb)
{
    RegTensor<float> ig, egB, out;
    RegTensor<int32_t> laneIdx;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    MaskReg allI = CreateMask<int32_t, MaskPattern::ALL>();
    LoadAlign(ig, igUb);
    Arange(laneIdx, static_cast<int32_t>(0));
    for (uint16_t r = 0; r < BT; ++r) {
        MaskReg m;
        Compares<int32_t, CMPMODE::LT>(m, laneIdx, static_cast<int32_t>(r), allI);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(egB, egUb + r);
        Mul<float, MaskMergeMode::ZEROING>(out, egB, ig, m);
        StoreAlign<float, StoreDist::DIST_NORM_B32>(gamUb + static_cast<uint32_t>(r) * BT, out, allF);
    }
}

// Γ 行（含对角，j<=r）——chunk 内输出项用
__simd_vf__ inline void GammaInclVF(__ubuf__ float* egUb, __ubuf__ float* igUb, __ubuf__ float* gamUb)
{
    RegTensor<float> ig, egB, out;
    RegTensor<int32_t> laneIdx;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    MaskReg allI = CreateMask<int32_t, MaskPattern::ALL>();
    LoadAlign(ig, igUb);
    Arange(laneIdx, static_cast<int32_t>(0));
    for (uint16_t r = 0; r < BT; ++r) {
        MaskReg m;
        Compares<int32_t, CMPMODE::LE>(m, laneIdx, static_cast<int32_t>(r), allI);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(egB, egUb + r);
        Mul<float, MaskMergeMode::ZEROING>(out, egB, ig, m);
        StoreAlign<float, StoreDist::DIST_NORM_B32>(gamUb + static_cast<uint32_t>(r) * BT, out, allF);
    }
}

/**
 * 小 GEMM 三种访问形态（lane 维恒为 64 = 一个 fp32 寄存器；cols > 64 由调用方拆两次）：
 *   GemmAA: C[i,l] += Σ_t A[i,t]·B[t,l]     （A/B 行主序）
 *   GemmBT: C[i,l] += Σ_t A[i,t]·B[l,t]     （B 转置读：B 的「行」是输入向量的列，用 UB Gather 取列）
 *   GemmTA: C[k,l] += Σ_t A[t,k]·B[t,l]     （A 转置读：B 的行索引 t 作累加轴，A 的列索引作输出行）
 * 每 (row,t) 一次 BRC + 一次 FMA；B 向量装载按 RBLK 行摊薄。
 */
__simd_vf__ inline void GemmAA(__ubuf__ float* cUb, uint32_t cS, __ubuf__ float* aUb, uint32_t aS,
                               __ubuf__ float* bUb, uint32_t bS, uint16_t rows, uint16_t inner)
{
    RegTensor<float> c0, c1, c2, c3, bv, v0, v1, v2, v3;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t i0 = 0; i0 < rows; i0 += RBLK) {
        const uint32_t b0 = static_cast<uint32_t>(i0) * cS;
        const uint32_t a0 = static_cast<uint32_t>(i0) * aS;  // A 的行偏移（≠ 输出行偏移，cS/aS 可不同）
        LoadAlign(c0, cUb + b0);
        LoadAlign(c1, cUb + b0 + cS);
        LoadAlign(c2, cUb + b0 + 2 * cS);
        LoadAlign(c3, cUb + b0 + 3 * cS);
        for (uint16_t t = 0; t < inner; ++t) {
            LoadAlign(bv, bUb + static_cast<uint32_t>(t) * bS);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v0, aUb + a0 + t);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v1, aUb + a0 + aS + t);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v2, aUb + a0 + 2 * aS + t);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v3, aUb + a0 + 3 * aS + t);
            MulAddDst(c0, v0, bv, allF);
            MulAddDst(c1, v1, bv, allF);
            MulAddDst(c2, v2, bv, allF);
            MulAddDst(c3, v3, bv, allF);
        }
        StoreAlign(cUb + b0, c0, allF);
        StoreAlign(cUb + b0 + cS, c1, allF);
        StoreAlign(cUb + b0 + 2 * cS, c2, allF);
        StoreAlign(cUb + b0 + 3 * cS, c3, allF);
    }
}

__simd_vf__ inline void GemmBT(__ubuf__ float* cUb, uint32_t cS, __ubuf__ float* aUb, uint32_t aS,
                               __ubuf__ float* bUb, uint32_t bRows, uint16_t rows, uint16_t inner)
{
    RegTensor<float> c0, c1, c2, c3, bv, v0, v1, v2, v3;
    RegTensor<int32_t> laneI, gidx;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    MaskReg allI = CreateMask<int32_t, MaskPattern::ALL>();
    Arange(laneI, static_cast<int32_t>(0));
    for (uint16_t i0 = 0; i0 < rows; i0 += RBLK) {
        const uint32_t b0 = static_cast<uint32_t>(i0) * cS;
        const uint32_t a0 = static_cast<uint32_t>(i0) * aS;  // A 的行偏移（cS/aS 可不同）
        Muls<int32_t>(gidx, laneI, static_cast<int32_t>(bRows), allI);  // gidx[l] = l·bRows
        LoadAlign(c0, cUb + b0);
        LoadAlign(c1, cUb + b0 + cS);
        LoadAlign(c2, cUb + b0 + 2 * cS);
        LoadAlign(c3, cUb + b0 + 3 * cS);
        for (uint16_t t = 0; t < inner; ++t) {
            Gather<float>(bv, bUb, reinterpret_cast<RegTensor<uint32_t>&>(gidx), allF);  // bv[l] = bUb[l·bRows+t]
            Adds<int32_t>(gidx, gidx, static_cast<int32_t>(1), allI);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v0, aUb + a0 + t);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v1, aUb + a0 + aS + t);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v2, aUb + a0 + 2 * aS + t);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v3, aUb + a0 + 3 * aS + t);
            MulAddDst(c0, v0, bv, allF);
            MulAddDst(c1, v1, bv, allF);
            MulAddDst(c2, v2, bv, allF);
            MulAddDst(c3, v3, bv, allF);
        }
        StoreAlign(cUb + b0, c0, allF);
        StoreAlign(cUb + b0 + cS, c1, allF);
        StoreAlign(cUb + b0 + 2 * cS, c2, allF);
        StoreAlign(cUb + b0 + 3 * cS, c3, allF);
    }
}

__simd_vf__ inline void GemmTA(__ubuf__ float* cUb, uint32_t cS, __ubuf__ float* aUb, uint32_t aRows,
                               __ubuf__ float* bUb, uint32_t bS, uint16_t rows, uint16_t inner)
{
    RegTensor<float> c0, c1, c2, c3, bv, v0, v1, v2, v3;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t i0 = 0; i0 < rows; i0 += RBLK) {
        const uint32_t b0 = static_cast<uint32_t>(i0) * cS;
        LoadAlign(c0, cUb + b0);
        LoadAlign(c1, cUb + b0 + cS);
        LoadAlign(c2, cUb + b0 + 2 * cS);
        LoadAlign(c3, cUb + b0 + 3 * cS);
        for (uint16_t t = 0; t < inner; ++t) {
            LoadAlign(bv, bUb + static_cast<uint32_t>(t) * bS);
            const uint32_t at = static_cast<uint32_t>(t) * aRows + static_cast<uint32_t>(i0);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v0, aUb + at);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v1, aUb + at + 1);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v2, aUb + at + 2);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(v3, aUb + at + 3);
            MulAddDst(c0, v0, bv, allF);
            MulAddDst(c1, v1, bv, allF);
            MulAddDst(c2, v2, bv, allF);
            MulAddDst(c3, v3, bv, allF);
        }
        StoreAlign(cUb + b0, c0, allF);
        StoreAlign(cUb + b0 + cS, c1, allF);
        StoreAlign(cUb + b0 + 2 * cS, c2, allF);
        StoreAlign(cUb + b0 + 3 * cS, c3, allF);
    }
}

/**
 * 下三角前代求解（WY：(I+A)X = RHS，A 严格下三角，行主序 [BT,BT]）：
 *   X[i,:] -= Σ_{j<i} A[i,j]·X[j,:]      i 升序（行串行 BT 步）
 * X 行宽 128（两个寄存器）。arch35 InverseAIVVF<32> 是本式取 RHS=I 的特例。
 */
__simd_vf__ inline void TrilSolveVF(__ubuf__ float* xUb, uint32_t xS, __ubuf__ float* aUb, uint32_t aS,
                                    uint16_t rows)
{
    RegTensor<float> acc0, acc1, xj0, xj1, av, xi0, xi1;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t i = 0; i < rows; ++i) {
        Duplicate(acc0, 0.0f);
        Duplicate(acc1, 0.0f);
        // 内层用**编译期常量**上界（A 的上三角恒为 0，多算的项贡献为 0）。
        // 3510 实测 quirk：内层上界取外层归纳变量（j < i）时，硬件循环少执行一次
        // （即丢掉 j=i−1 这一项，误差 ~1%），故此处不做三角裁剪。见 README §已知限制。
        for (uint16_t j = 0; j < BT; ++j) {
            LoadAlign<float, LoadDist::DIST_BRC_B32>(av, aUb + static_cast<uint32_t>(i) * aS + j);
            LoadAlign(xj0, xUb + static_cast<uint32_t>(j) * xS);
            LoadAlign(xj1, xUb + static_cast<uint32_t>(j) * xS + VL);
            MulAddDst(acc0, av, xj0, allF);
            MulAddDst(acc1, av, xj1, allF);
        }
        LoadAlign(xi0, xUb + static_cast<uint32_t>(i) * xS);
        LoadAlign(xi1, xUb + static_cast<uint32_t>(i) * xS + VL);
        Sub(xi0, xi0, acc0, allF);
        Sub(xi1, xi1, acc1, allF);
        StoreAlign(xUb + static_cast<uint32_t>(i) * xS, xi0, allF);
        StoreAlign(xUb + static_cast<uint32_t>(i) * xS + VL, xi1, allF);
        LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();  // 本行写入对后续行的 load 可见
    }
}

// dst[r,:] = src[r,:]·s[r]，行宽 128（两寄存器），s 为 [BT]
__simd_vf__ inline void CopyScale2VF(__ubuf__ float* dUb, uint32_t dS, __ubuf__ float* sUb, __ubuf__ float* srcUb,
                                     uint32_t sS)
{
    RegTensor<float> sr, a0, a1;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t r = 0; r < BT; ++r) {
        LoadAlign<float, LoadDist::DIST_BRC_B32>(sr, sUb + r);
        LoadAlign(a0, srcUb + static_cast<uint32_t>(r) * sS);
        LoadAlign(a1, srcUb + static_cast<uint32_t>(r) * sS + VL);
        Mul(a0, a0, sr, allF);
        Mul(a1, a1, sr, allF);
        StoreAlign(dUb + static_cast<uint32_t>(r) * dS, a0, allF);
        StoreAlign(dUb + static_cast<uint32_t>(r) * dS + VL, a1, allF);
    }
}

// x[r,:] *= s[r]，行宽 64（一寄存器）
__simd_vf__ inline void RowScale1VF(__ubuf__ float* xUb, uint32_t xS, __ubuf__ float* sUb)
{
    RegTensor<float> sr, a0;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t r = 0; r < BT; ++r) {
        LoadAlign<float, LoadDist::DIST_BRC_B32>(sr, sUb + r);
        LoadAlign(a0, xUb + static_cast<uint32_t>(r) * xS);
        Mul(a0, a0, sr, allF);
        StoreAlign(xUb + static_cast<uint32_t>(r) * xS, a0, allF);
    }
}

// x[r,:] *= s[r]，行宽 128（两寄存器）
__simd_vf__ inline void RowScale2VF(__ubuf__ float* xUb, uint32_t xS, __ubuf__ float* sUb)
{
    RegTensor<float> sr, a0, a1;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t r = 0; r < BT; ++r) {
        LoadAlign<float, LoadDist::DIST_BRC_B32>(sr, sUb + r);
        LoadAlign(a0, xUb + static_cast<uint32_t>(r) * xS);
        LoadAlign(a1, xUb + static_cast<uint32_t>(r) * xS + VL);
        Mul(a0, a0, sr, allF);
        Mul(a1, a1, sr, allF);
        StoreAlign(xUb + static_cast<uint32_t>(r) * xS, a0, allF);
        StoreAlign(xUb + static_cast<uint32_t>(r) * xS + VL, a1, allF);
    }
}

// dUb = aUb ⊙ bUb（两个 [BT] 向量逐 lane 乘）
__simd_vf__ inline void MulVecVF(__ubuf__ float* dUb, __ubuf__ float* aUb, __ubuf__ float* bUb)
{
    RegTensor<float> a, b;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    LoadAlign(a, aUb);
    LoadAlign(b, bUb);
    Mul(a, a, b, allF);
    StoreAlign(dUb, a, allF);
}

// [BT,BT] 元素乘（a ⊙= b）
__simd_vf__ inline void Mul2DVF(__ubuf__ float* aUb, __ubuf__ float* bUb, uint32_t stride)
{
    RegTensor<float> x, y;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t r = 0; r < BT; ++r) {
        const uint32_t o = static_cast<uint32_t>(r) * stride;
        LoadAlign(x, aUb + o);
        LoadAlign(y, bUb + o);
        Mul(x, x, y, allF);
        StoreAlign(aUb + o, x, allF);
    }
}

// S[r,:] *= c（c 从 UB 取一个标量做 BRC，避免标量回读），行宽 128，DK 行
__simd_vf__ inline void StateScaleVF(__ubuf__ float* hUb, uint32_t hS, __ubuf__ float* cUb)
{
    RegTensor<float> cr, a0, a1;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    LoadAlign<float, LoadDist::DIST_BRC_B32>(cr, cUb);
    for (uint16_t r = 0; r < DK; ++r) {
        LoadAlign(a0, hUb + static_cast<uint32_t>(r) * hS);
        LoadAlign(a1, hUb + static_cast<uint32_t>(r) * hS + VL);
        Mul(a0, a0, cr, allF);
        Mul(a1, a1, cr, allF);
        StoreAlign(hUb + static_cast<uint32_t>(r) * hS, a0, allF);
        StoreAlign(hUb + static_cast<uint32_t>(r) * hS + VL, a1, allF);
    }
}

// x[r,:] *= c（编译期立即数），行宽 128，rows 行
__simd_vf__ inline void ConstScale2VF(__ubuf__ float* xUb, uint32_t xS, float c, uint16_t rows)
{
    RegTensor<float> a0, a1;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    for (uint16_t r = 0; r < rows; ++r) {
        LoadAlign(a0, xUb + static_cast<uint32_t>(r) * xS);
        LoadAlign(a1, xUb + static_cast<uint32_t>(r) * xS + VL);
        Muls<float>(a0, a0, c, allF);
        Muls<float>(a1, a1, c, allF);
        StoreAlign(xUb + static_cast<uint32_t>(r) * xS, a0, allF);
        StoreAlign(xUb + static_cast<uint32_t>(r) * xS + VL, a1, allF);
    }
}

// ============================================================
// Kernel 主体
// ============================================================
class GdnPrefillChunkScan {
public:
    __aicore__ inline GdnPrefillChunkScan() {}

    __aicore__ inline void Init(GM_ADDR q, GM_ADDR k, GM_ADDR v, GM_ADDR g, GM_ADDR beta, GM_ADDR h0,
                                GM_ADDR out, GM_ADDR ht, GM_ADDR probe, uint32_t numHeads, uint32_t seqLen,
                                float scale, uint32_t probeHeads)
    {
        qGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(q));
        kGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(k));
        vGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(v));
        gGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(g));
        bGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(beta));
        h0Gm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(h0));
        oGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out));
        htGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ht));
        prGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(probe));
        numHeads_ = numHeads;
        seqLen_ = seqLen;
        scale_ = scale;
        probeHeads_ = probeHeads;
    }

    __aicore__ inline void Process()
    {
        const uint32_t bid = AscendC::GetBlockIdx();       // 0 .. 2*nblk-1（mix(1,2) AIV 视角）
        const uint32_t nAiv = AscendC::GetBlockNum() * 2;  // AIV 线程数 = 2×AIC 数

        LocalTensor<float> ubAll(TPosition::VECCALC, 0, UB_TOTAL / 4);
        ub_ = reinterpret_cast<__ubuf__ float*>(ubAll.GetPhyAddr());

        for (uint32_t hv = bid; hv < numHeads_; hv += nAiv) {
            ProcessHead(hv);
        }
    }

private:
    __aicore__ inline LocalTensor<float> Lt(uint32_t byteOff, uint32_t elems)
    {
        LocalTensor<float> t(TPosition::VECCALC, byteOff, elems);
        return t;
    }
    __aicore__ inline __ubuf__ float* P(uint32_t byteOff) { return ub_ + byteOff / 4; }

    // ---------------- 单 head 的整段 chunk 扫描 ----------------
    __aicore__ inline void ProcessHead(uint32_t hv)
    {
        const uint32_t nChunk = (seqLen_ + BT - 1) / BT;
        const uint32_t hk = hv / GROUP;
        const bool isProbe = (probeHeads_ > 0 && hv < probeHeads_);

        // (0) 装载状态 S（[DK,DV] fp32 行主序，128 行 × 512B）
        const AscendC::DataCopyParams hp{DK, (DV * static_cast<uint32_t>(sizeof(float))) / 32, 0, 0};
        BufAcquire<PIPE_MTE2>(BUF_ST);
        DataCopy(Lt(UB_H, HE), h0Gm_[static_cast<uint64_t>(hv) * HE], hp);
        BufRelease<PIPE_MTE2>(BUF_ST);
        // V 侧等它就位（并立刻放行，语义等价于一次 V 域屏障）
        BufAcquire<PIPE_V>(BUF_ST);
        BufRelease<PIPE_V>(BUF_ST);
        MemBarVL();

        for (uint32_t c = 0; c < nChunk; ++c) {
            const uint32_t t0 = c * BT;
            const uint32_t cv = (seqLen_ - t0 < BT) ? (seqLen_ - t0) : BT;
            RunChunk(hv, hk, c, cv, isProbe, nChunk);
        }

        // (N) 状态写回
        BufAcquire<PIPE_V>(BUF_SO);
        BufRelease<PIPE_V>(BUF_SO);  // 阻塞释放：此后 UB_H 终值对 MTE3 可见
        BufAcquire<PIPE_MTE3>(BUF_SO);
        DataCopy(htGm_[static_cast<uint64_t>(hv) * HE], Lt(UB_H, HE), hp);
        BufRelease<PIPE_MTE3>(BUF_SO);
    }

    // ---------------- 单 chunk ----------------
    __aicore__ inline void RunChunk(uint32_t hv, uint32_t hk, uint32_t c, uint32_t cv, bool isProbe,
                                    uint32_t nChunk)
    {
        const uint32_t t0 = c * BT;
        __ubuf__ float* kUb = P(UB_K);
        __ubuf__ float* qUb = P(UB_Q);
        __ubuf__ float* vUb = P(UB_V);
        __ubuf__ float* uUb = P(UB_U);
        __ubuf__ float* aUb = P(UB_A);
        __ubuf__ float* gUb = P(UB_G);
        __ubuf__ float* hUb = P(UB_H);
        __ubuf__ float* scG = P(UB_SC_G);
        __ubuf__ float* scB = P(UB_SC_B);
        __ubuf__ float* scGC = P(UB_SC_GC);
        __ubuf__ float* scEG = P(UB_SC_EG);
        __ubuf__ float* scIG = P(UB_SC_IG);
        __ubuf__ float* scSG = P(UB_SC_SG);

        // ---------- (1) MTE2：装载 k/q（[cv,DK]）、v（[cv,DV]）、g/β（[cv]）----------
        // 所有 GM 起始地址均 32B 对齐：k/q/v/o 的行长 128 fp32 = 512B；g/β 按 [H,Tp] 填充
        // （Tp = ceil(T/8)·8，故 hv·Tp+t0 是 8 的倍数）。
        BufAcquire<PIPE_MTE2>(BUF_BLK);
        {
            const AscendC::DataCopyParams kp{static_cast<uint16_t>(cv), (DK * static_cast<uint32_t>(sizeof(float))) / 32,
                                             0, 0};
            const AscendC::DataCopyParams vp{static_cast<uint16_t>(cv), (DV * static_cast<uint32_t>(sizeof(float))) / 32,
                                             0, 0};
            const uint32_t kOff = static_cast<uint32_t>(static_cast<uint64_t>(hk) * seqLen_ * DK + static_cast<uint64_t>(t0) * DK);
            const uint32_t vOff = static_cast<uint32_t>(static_cast<uint64_t>(hv) * seqLen_ * DV + static_cast<uint64_t>(t0) * DV);
            DataCopy(Lt(UB_K, KE), kGm_[kOff], kp);
            DataCopy(Lt(UB_Q, KE), qGm_[kOff], kp);
            DataCopy(Lt(UB_V, VE), vGm_[vOff], vp);
            // g/β：[H,Tp] 行主序；长度按 8 元素（32B）上取整，GM 侧尾部 padding + 尾块 ZeroTailVF 覆盖
            const uint32_t gLen = ((cv + 7) / 8) * 8;
            const AscendC::DataCopyParams gp{1, static_cast<uint16_t>(gLen / 8), 0, 0};
            const uint32_t tp = ((seqLen_ + 7) / 8) * 8;
            DataCopy(Lt(UB_SC_G, BT), gGm_[static_cast<uint64_t>(hv) * tp + t0], gp);
            DataCopy(Lt(UB_SC_B, BT), bGm_[static_cast<uint64_t>(hv) * tp + t0], gp);
        }
        BufRelease<PIPE_MTE2>(BUF_BLK);

        BufAcquire<PIPE_V>(BUF_BLK);

        // 尾块：padding 位/行清零（g/β 补 0 使 ĝ 常数、β=0 使该行不参与；k/q/v 补 0）
        if (cv < BT) {
            ZeroTailVF(scG, cv);
            ZeroTailVF(scB, cv);
            ZeroVF(kUb + cv * DK, (BT - cv) * DK);
            ZeroVF(qUb + cv * DK, (BT - cv) * DK);
            ZeroVF(vUb + cv * DV, (BT - cv) * DV);
            MemBarVL();
        }

        // ---------- (2) chunk 内：ĝ / eg / ig / Γ / A / u / w ----------
        CumSumExpVF(scG, scGC, scEG, scIG);
        MemBarVL();
        GammaStrictVF(scEG, scIG, gUb);
        MemBarVL();
        ZeroVF(aUb, AE);
        MemBarVL();
        GemmBT(aUb, BT, kUb, DK, kUb, DK, BT, DK);  // A = k·kᵀ
        MemBarVL();
        RowScale1VF(gUb, BT, scB);  // Γs 行乘 β
        MemBarVL();
        Mul2DVF(aUb, gUb, BT);      // A ⊙= β⊙Γs
        MemBarVL();

        if (isProbe && (c < 2 || c + 1 == nChunk)) {
            ProbeDump(hv, c, nChunk, 0, UB_SC_GC, BT);
            ProbeDump(hv, c, nChunk, 1, UB_SC_EG, BT);
            ProbeDump(hv, c, nChunk, 2, UB_A, AE);
        }

        // u = (I+A)^{-1}(β⊙v)：先把 β⊙v 写进 UB_U，再原地前代
        CopyScale2VF(uUb, DV, scB, vUb, DV);
        MemBarVL();
        TrilSolveVF(uUb, DV, aUb, BT, BT);
        MemBarVL();
        // w = (I+A)^{-1}(β⊙eg⊙k)：sg = β⊙eg，写进 UB_V（v 已消费），再原地前代
        MulVecVF(scSG, scB, scEG);
        MemBarVL();
        CopyScale2VF(vUb, DK, scSG, kUb, DK);
        MemBarVL();
        TrilSolveVF(vUb, DK, aUb, BT, BT);
        MemBarVL();

        if (isProbe && (c < 2 || c + 1 == nChunk)) {
            ProbeDump(hv, c, nChunk, 3, UB_U, VE);
            ProbeDump(hv, c, nChunk, 4, UB_V, VE);
        }

        // ---------- (3) chunk 间：状态扫描 ----------
        // w ← −w：GemmAA 是 **累加**（C += A·B），而公式是 d = u − w·S，
        // 故把 w 取负后直接累加进 u（省一个减法 pass）。slot 4 抽点在取负之前，仍是真 w。
        ConstScale2VF(vUb, DK, -1.0f, BT);
        MemBarVL();
        ConstScale2VF(qUb, DK, scale_, BT);  // q' = q·scale
        MemBarVL();
        // d = u + (−w)·S = u − w·S（UB_U 原地累加）
        GemmAA(uUb, DV, vUb, DK, hUb, DV, BT, DK);
        GemmAA(uUb + VL, DV, vUb, DK, hUb + VL, DV, BT, DK);
        MemBarVL();
        // o_part = (q·scale)·S ⊙_row eg（写 UB_V，w 已消费）
        ZeroVF(vUb, VE);
        MemBarVL();
        GemmAA(vUb, DV, qUb, DK, hUb, DV, BT, DK);
        GemmAA(vUb + VL, DV, qUb, DK, hUb + VL, DV, BT, DK);
        MemBarVL();
        RowScale2VF(vUb, DV, scEG);
        MemBarVL();
        // AB = (q·scale)·kᵀ ⊙ Γi
        GammaInclVF(scEG, scIG, gUb);
        MemBarVL();
        ZeroVF(aUb, AE);
        MemBarVL();
        GemmBT(aUb, BT, qUb, DK, kUb, DK, BT, DK);
        MemBarVL();
        Mul2DVF(aUb, gUb, BT);
        MemBarVL();
        // o = o_part + AB·d
        GemmAA(vUb, DV, aUb, BT, uUb, DV, BT, BT);
        GemmAA(vUb + VL, DV, aUb, BT, uUb + VL, DV, BT, BT);
        MemBarVL();

        if (isProbe && (c < 2 || c + 1 == nChunk)) {
            ProbeDump(hv, c, nChunk, 5, UB_U, VE);
            ProbeDump(hv, c, nChunk, 6, UB_A, AE);
            ProbeDump(hv, c, nChunk, 7, UB_V, VE);
        }

        // ---------- (4) 状态更新：d' = d⊙ig；S = egL·(S + kᵀ·d') ----------
        RowScale2VF(uUb, DV, scIG);
        MemBarVL();
        // S ← egL·(S + kᵀ·d')：**先累加再整体缩放**（两个 pass 的顺序必须如此——
        // egL 要乘到整个括号上；先缩放 S 再加就会漏掉 egL·kᵀd'）。数值上也更好。
        GemmTA(hUb, DV, kUb, DK, uUb, DV, DK, BT);
        GemmTA(hUb + VL, DV, kUb, DK, uUb + VL, DV, DK, BT);
        MemBarVL();
        StateScaleVF(hUb, DV, scEG + (BT - 1));  // egL = eg[cv−1]；padding 行 g=0 ⇒ eg[BT−1]=eg[cv−1]
        MemBarVL();

        if (isProbe) {
            ProbeDump(hv, c, nChunk, 8, UB_H, HE);  // 逐 chunk 状态（chunk 间串行链证据）
        }

        BufRelease<PIPE_V>(BUF_BLK);  // chunk 的 UB 工作集交回（V 域已 drain）

        // ---------- (5) MTE3：逐 chunk 写出 o（UB_V 仍被本 chunk 的 o 占用）----------
        BufAcquire<PIPE_MTE3>(BUF_BLK);
        {
            const AscendC::DataCopyParams op{static_cast<uint16_t>(cv),
                                             (DV * static_cast<uint32_t>(sizeof(float))) / 32, 0, 0};
            const uint32_t oOff =
                static_cast<uint32_t>(static_cast<uint64_t>(hv) * seqLen_ * DV + static_cast<uint64_t>(t0) * DV);
            DataCopy(oGm_[oOff], Lt(UB_V, VE), op);
        }
        BufRelease<PIPE_MTE3>(BUF_BLK);
    }

    /**
     * probe 抽点：UB 区 → GM。probe GM 布局（float 下标）：
     *   [0, PH*MAX_CHUNKS*HE)                       逐 chunk 状态（slot 8，probe head 0/1）
     *   [PH*MAX_CHUNKS*HE, ...)                     分段抽点（仅 probe head 0）
     *      每 chunk 占 9*HE，slot 0..8：
     *        0=ĝ 1=eg 2=A(缩放后/求解前) 3=u 4=w 5=d 6=AB 7=o 8=S
     *      chunkIdx 0/1/2 对应第 0 / 第 1 / 最后一个 chunk
     * 用 BUF_PR 串行握手：V 发起 → MTE3 读完 → V 才继续（probe 跑法可以慢）。
     */
    __aicore__ inline void ProbeDump(uint32_t hv, uint32_t c, uint32_t nChunk, uint32_t slot, uint32_t ubByteOff,
                                     uint32_t elems)
    {
        constexpr uint32_t PH = 2;
        const AscendC::DataCopyParams pp{1, static_cast<uint16_t>(elems / 8), 0, 0};  // elems 为 8 的倍数
        BufAcquire<PIPE_V>(BUF_PR);
        BufRelease<PIPE_V>(BUF_PR);
        BufAcquire<PIPE_MTE3>(BUF_PR);
        if (slot == 8) {
            DataCopy(prGm_[static_cast<uint64_t>(hv) * MAX_CHUNKS * HE + static_cast<uint64_t>(c) * HE],
                     Lt(ubByteOff, elems), pp);
        } else if (hv == 0) {
            const uint32_t chunkIdx = (c < 2) ? c : 2u;
            const uint32_t off = PH * MAX_CHUNKS * HE + (chunkIdx * 9u + slot) * HE;
            DataCopy(prGm_[off], Lt(ubByteOff, elems), pp);
        }
        BufRelease<PIPE_MTE3>(BUF_PR);
        BufAcquire<PIPE_V>(BUF_PR);  // 等 MTE3 读完，后续 V 写不会覆盖被读的区
        BufRelease<PIPE_V>(BUF_PR);
    }

private:
    __ubuf__ float* ub_ = nullptr;
    uint32_t numHeads_ = 0;
    uint32_t seqLen_ = 0;
    float scale_ = 1.0f;
    uint32_t probeHeads_ = 0;
    GlobalTensor<float> qGm_, kGm_, vGm_, gGm_, bGm_, h0Gm_, oGm_, htGm_, prGm_;
};

}  // namespace

__global__ __mix__(1, 2) void m18_gdn_prefill_kernel(__gm__ uint8_t* q, __gm__ uint8_t* k, __gm__ uint8_t* v,
                                                     __gm__ uint8_t* g, __gm__ uint8_t* beta, __gm__ uint8_t* h0,
                                                     __gm__ uint8_t* out, __gm__ uint8_t* ht, __gm__ uint8_t* probe,
                                                     uint32_t numHeads, uint32_t seqLen, float scale,
                                                     uint32_t probeHeads)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIV {
        GdnPrefillChunkScan op;
        op.Init(q, k, v, g, beta, h0, out, ht, probe, numHeads, seqLen, scale, probeHeads);
        op.Process();
    }
    // AIC：本切分不参与（chunk 工作全在 fp32 向量域；见文件头与 README §AIC 升级路径）
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧：确定性输入生成 + 运行读回 + dump + 计时
// 数值校验由 check_ref.py（numpy float64 逐句参考）完成。
// ============================================================

// ---- 确定性伪随机（与 m1/m2/m4 同风格：纯公式，无 rand 状态）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

static float HashU11(uint32_t i, uint32_t j, uint32_t salt)  // [-1, 1)
{
    return static_cast<float>(Hash3(i, j, salt) % 1000000u) / 500000.0f - 1.0f;
}

// q/k 行：hash 向量 -> l2norm（**纯单位化**；1/√DK 的 scale 由 kernel 内部的 scale 参数施加，
// 与 donor 语义一致：算子的 q/k 输入是 l2norm 后的向量，scale 在 chunk 输出项里乘）
// host 无 libm，1/sqrt 用二分 [1e-4,1] 46 轮（~1e-14），确定性、无收敛域问题。
static void GenQk(float* dst, uint32_t dim, uint32_t row, uint32_t salt)
{
    static float x[256];
    double sum = 0.0;
    for (uint32_t i = 0; i < dim; ++i) {
        x[i] = HashU11(i, row, salt);
        sum += static_cast<double>(x[i]) * static_cast<double>(x[i]);
    }
    const double t = sum;  // 1/sqrt(Σx²) = 1/|x|（纯 l2norm）
    double lo = 1e-4, hi = 1.0;
    for (int it = 0; it < 46; ++it) {
        const double mid = 0.5 * (lo + hi);
        if (mid * mid * t < 1.0) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    const double y = 0.5 * (lo + hi);
    for (uint32_t i = 0; i < dim; ++i) {
        dst[i] = static_cast<float>(static_cast<double>(x[i]) * y);
    }
}

static bool WriteBin(const char* path, const void* buf, size_t bytes)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) {
        printf("[M18][FAIL] cannot open %s\n", path);
        return false;
    }
    const size_t w = fwrite(buf, 1, bytes, f);
    fclose(f);
    return w == bytes;
}

struct Case {
    const char* tag;
    uint32_t H;
    uint32_t T;
    uint32_t salt;
};

// probe GM 区大小（float 数）：2*MAX_CHUNKS*HE + 3*9*HE
static size_t ProbeFloats()
{
    const size_t ph = 2;
    const size_t maxChunks = 128;
    const size_t he = 128u * 128u;
    return ph * maxChunks * he + 3u * 9u * he;
}

static bool RunCase(aclrtStream stream, const Case& cs, uint32_t nblk, bool quiet, uint32_t probeOverride = 0xFFFFFFFFu,
                    bool noDump = false)
{
    const uint32_t H = cs.H;
    const uint32_t T = cs.T;
    const uint32_t nk = (H + 2) / 3;
    const float scale = 1.0f / 11.313708f;  // ≈ 1/sqrt(128)
    const uint32_t probeHeads = (probeOverride != 0xFFFFFFFFu) ? probeOverride : ((H >= 2) ? 2u : H);

    const size_t qkF = static_cast<size_t>(nk) * T * 128;
    const size_t vF = static_cast<size_t>(H) * T * 128;
    const size_t tp = ((static_cast<size_t>(T) + 7) / 8) * 8;  // g/β 行 stride（32B 对齐）
    const size_t gbF = static_cast<size_t>(H) * tp;
    const size_t hF = static_cast<size_t>(H) * 128 * 128;
    const size_t prF = ProbeFloats();

    // ---- host 侧生成 ----
    std::vector<float> q(qkF), k(qkF), v(vF), g(gbF, 0.0f), beta(gbF, 0.0f), h0(hF);
    for (uint32_t kk = 0; kk < nk; ++kk) {
        for (uint32_t t = 0; t < T; ++t) {
            GenQk(&q[static_cast<size_t>(kk) * T * 128 + static_cast<size_t>(t) * 128], 128, t * 7 + kk, cs.salt + 0x51);
            GenQk(&k[static_cast<size_t>(kk) * T * 128 + static_cast<size_t>(t) * 128], 128, t * 7 + kk, cs.salt + 0x52);
        }
    }
    for (uint32_t h = 0; h < H; ++h) {
        for (uint32_t t = 0; t < T; ++t) {
            for (uint32_t i = 0; i < 128; ++i) {
                v[(static_cast<size_t>(h) * T + t) * 128 + i] = HashU11(i, t * 31 + h, cs.salt + 0x53);
            }
            // g ∈ [−0.05, −0.001)（log 衰减，per (head, token)）；β ∈ (0.05, 0.95]
            g[static_cast<size_t>(h) * tp + t] =
                -0.001f - static_cast<float>(Hash3(t, h, cs.salt + 0x54) % 50000u) / 1000000.0f;
            beta[static_cast<size_t>(h) * tp + t] =
                0.05f + static_cast<float>(Hash3(t, h, cs.salt + 0x55) % 900000u) / 1000000.0f;
        }
    }
    for (uint32_t h = 0; h < H; ++h) {
        for (uint32_t i = 0; i < 128; ++i) {
            for (uint32_t j = 0; j < 128; ++j) {
                h0[(static_cast<size_t>(h) * 128 + i) * 128 + j] =
                    0.1f * HashU11(i * 128 + j, h, cs.salt + 0x56);
            }
        }
    }

    // ---- device 缓冲 ----
    std::vector<void*> dv(9, nullptr);
    std::vector<size_t> bytes = {
        qkF * 4, qkF * 4, vF * 4, gbF * 4, gbF * 4, hF * 4, vF * 4, hF * 4, prF * 4,
    };
    for (size_t i = 0; i < dv.size(); ++i) {
        if (aclrtMalloc(&dv[i], bytes[i], ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
            printf("[M18][FAIL] aclrtMalloc(%zu) failed\n", bytes[i]);
            return false;
        }
    }
    auto h2d = [&](size_t i, const void* p) {
        return aclrtMemcpy(dv[i], bytes[i], p, bytes[i], ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    };
    bool ok = true;
    ok &= h2d(0, q.data());
    ok &= h2d(1, k.data());
    ok &= h2d(2, v.data());
    ok &= h2d(3, g.data());
    ok &= h2d(4, beta.data());
    ok &= h2d(5, h0.data());
    if (!ok) {
        printf("[M18][FAIL] H2D failed\n");
        return false;
    }
    aclrtMemset(dv[6], bytes[6], 0, bytes[6]);
    aclrtMemset(dv[7], bytes[7], 0, bytes[7]);
    aclrtMemset(dv[8], bytes[8], 0, bytes[8]);

    // ---- launch（mix(1,2)：blockDim = AIC 数）----
    m18_gdn_prefill_kernel<<<nblk, 0, stream>>>(reinterpret_cast<uint8_t*>(dv[0]), reinterpret_cast<uint8_t*>(dv[1]),
                                                reinterpret_cast<uint8_t*>(dv[2]), reinterpret_cast<uint8_t*>(dv[3]),
                                                reinterpret_cast<uint8_t*>(dv[4]), reinterpret_cast<uint8_t*>(dv[5]),
                                                reinterpret_cast<uint8_t*>(dv[6]), reinterpret_cast<uint8_t*>(dv[7]),
                                                reinterpret_cast<uint8_t*>(dv[8]), H, T, scale, probeHeads);
    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);
    const aclError err = aclrtSynchronizeStream(stream);
    clock_gettime(CLOCK_MONOTONIC, &t1);
    const double ms = (static_cast<double>(t1.tv_sec - t0.tv_sec) * 1e3) +
                      static_cast<double>(t1.tv_nsec - t0.tv_nsec) * 1e-6;
    if (err != ACL_SUCCESS) {
        printf("[M18][FAIL] H=%u T=%u launch/sync error %d : %s\n", H, T, static_cast<int>(err), aclGetRecentErrMsg());
        return false;
    }

    if (noDump) {
        printf("[M18] H=%-2u T=%-4u blk=%-2u : %.3f ms  (probeHeads=%u, 不落盘，纯计时)\n", H, T, nblk, ms,
               probeHeads);
        for (size_t i = 0; i < dv.size(); ++i) {
            aclrtFree(dv[i]);
        }
        return true;
    }

    // ---- D2H + dump ----
    std::vector<float> o(vF), ht(hF), pr(prF);
    ok &= aclrtMemcpy(o.data(), vF * 4, dv[6], vF * 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    ok &= aclrtMemcpy(ht.data(), hF * 4, dv[7], hF * 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    ok &= aclrtMemcpy(pr.data(), prF * 4, dv[8], prF * 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    if (!ok) {
        printf("[M18][FAIL] D2H failed\n");
        return false;
    }

    char nm[160];
    auto dump = [&](const char* what, const void* p, size_t n) {
        snprintf(nm, sizeof(nm), "m18_h%02u_t%05u_%s.bin", H, T, what);
        return WriteBin(nm, p, n);
    };
    // g/β 落盘用紧凑 [H,T] 布局（去掉 32B 行填充），供 Python 直接按 [H,T] 读
    std::vector<float> gPack(static_cast<size_t>(H) * T), bPack(static_cast<size_t>(H) * T);
    for (uint32_t h = 0; h < H; ++h) {
        for (uint32_t t = 0; t < T; ++t) {
            gPack[static_cast<size_t>(h) * T + t] = g[static_cast<size_t>(h) * tp + t];
            bPack[static_cast<size_t>(h) * T + t] = beta[static_cast<size_t>(h) * tp + t];
        }
    }
    ok &= dump("q", q.data(), qkF * 4);
    ok &= dump("k", k.data(), qkF * 4);
    ok &= dump("v", v.data(), vF * 4);
    ok &= dump("g", gPack.data(), static_cast<size_t>(H) * T * 4);
    ok &= dump("beta", bPack.data(), static_cast<size_t>(H) * T * 4);
    ok &= dump("h0", h0.data(), hF * 4);
    const size_t oF = vF;
    const size_t htF = hF;
    ok &= dump("o", o.data(), oF * 4);
    ok &= dump("ht", ht.data(), htF * 4);
    ok &= dump("probe", pr.data(), prF * 4);
    snprintf(nm, sizeof(nm), "m18_h%02u_t%05u_meta.txt", H, T);
    {
        FILE* f = fopen(nm, "w");
        if (f != nullptr) {
            fprintf(f, "H %u\nT %u\nNK %u\nDK 128\nDV 128\nBT 64\nscale %.9g\nprobeHeads %u\nnc %u\n",
                    H, T, nk, static_cast<double>(scale), probeHeads, (T + 63) / 64);
            fclose(f);
        }
    }

    if (!quiet) {
        printf("[M18] H=%-2u T=%-4u blk=%-2u : %.3f ms  (%.1f heads/ms, %s)\n", H, T, nblk, ms,
               static_cast<double>(H) / (ms * 1e-3) / 1000.0, ok ? "dump ok" : "DUMP FAILED");
        printf("[M18]   o[0..5] = %.6f %.6f %.6f %.6f %.6f %.6f\n", static_cast<double>(o[0]),
               static_cast<double>(o[1]), static_cast<double>(o[2]), static_cast<double>(o[3]),
               static_cast<double>(o[4]), static_cast<double>(o[5]));
    }
    for (size_t i = 0; i < dv.size(); ++i) {
        aclrtFree(dv[i]);
    }
    return ok;
}

int32_t main()
{
    // 覆盖：单 key head + 多 chunk + ragged（3,257=4×64+1）、单 chunk（8,64）、
    //       全 48 head + ragged（48,129=2×64+1）、目标档（48,4097=64×64+1）
    const Case cases[] = {
        {"gqa3", 3, 257, 0x1101u},
        {"one", 8, 64, 0x1102u},
        {"all48", 48, 129, 0x1103u},
        {"target", 48, 4097, 0x1104u},
    };
    constexpr uint32_t nCases = sizeof(cases) / sizeof(cases[0]);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    int64_t aicNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("[M18][FAIL] query AICORE_CORE_NUM failed\n");
        return 1;
    }
    const uint32_t nblk = static_cast<uint32_t>(aicNum);
    printf("[M18] mix(1,2) launch: nblk(AIC)=%u → AIV 线程数=%u\n", nblk, nblk * 2);

    bool allOk = true;
    for (uint32_t c = 0; c < nCases; ++c) {
        const bool quiet = false;  // 计时与摘要全部打印（含目标档 m=4097）
        allOk &= RunCase(stream, cases[c], nblk, quiet);
    }
    // 纯计时对照：目标档关掉 probe 逐 chunk 抽点（probeHeads=0），只测 kernel 本体
    printf("[M18] ---- probe 关闭对照（目标档）----\n");
    allOk &= RunCase(stream, cases[nCases - 1], nblk, false, 0u, true);
    printf("[M18] ===== %s（数值校验请运行 check_ref.py）=====\n", allOk ? "ALL RUNS OK" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
