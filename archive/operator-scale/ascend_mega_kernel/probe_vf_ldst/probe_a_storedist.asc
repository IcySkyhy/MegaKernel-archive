/**
 * probe_a_storedist.asc —— 探针 A：`StoreDist::DIST_FIRST_ELEMENT_B32` 到底吃不吃 mask？
 *
 * 触发点（M36，2026-09-26）：M36 用 `StoreAlign<float, DIST_FIRST_ELEMENT_B32>` 想把 4 条流的
 * 注入权重按 lane 分别落到 4 个 32B 槽首，实测「4 个槽全写成同一个流的值」，因而报「恒写 lane 0、
 * 与掩码无关」并建议固化进 docs/05。tower 的判读是**先取证官方定义**：
 *
 *   官方《连续对齐搬出（StoreAlign）》表3 StoreDist参数说明（单搬出模式）原文：
 *     DIST_FIRST_ELEMENT_B32 | 忽略mask，向dst中搬运src第一个元素，数据类型为b32。 | 对齐约束 4B
 *   本地归档副本（**按表号定位，不按行号**）：/workspace/cannbot-knowledge/knowledge/ops/ascendc/
 *     apis/simd_api/basic_api/reg_vector_compute/reg_data_store/store_align_continuous.md
 *     （该文件的 sha256 固定在 evidence/doc_refs.txt，原文摘录也在那里）
 *
 * ⇒ 文档直接写着「**忽略mask**」「搬运 src **第一个**元素」⇒ lane 0 之外从来不写、mask 从来不参与。
 *   本探针就是把「文档说 X」与「实测 Y」并列归档的**最小实证**，并给出能把
 *   「按定义如此」与「掩码被静默忽略（=quirk）」区分开的对照：同一掩码换成 `DIST_NORM_B32`
 *   必须让掩码生效。
 *
 * 实验（单 launch，无循环）：
 *   1. MTE2 把 UB_SRC ← gmVal（lane i = 100+i）、UB_DST ← gmPoison（全 -999.0f，32B 对齐槽）
 *   2. V 侧：LoadAlign 全宽读 UB_SRC → v（lanes=100..163）
 *   3. V 侧：StoreAlign<T=float, PROBE_A_DIST>(UB_DST, v, mask(maskMode))
 *   4. MTE3 把 UB_DST 的 256B 原样搬回 GM ⇒ 逐字节 dump
 *
 * 判据（T1 位域/逐字节，docs/17 §1.1）：
 *   * DIST = FIRST_ELEMENT_B32：**与 maskMode 无关**，恒为
 *       dst[0] == v[0] == 100.0f，dst[1..63] == -999.0f（未被触碰）
 *   * DIST = NORM_B32（对照，mask 应当生效）：
 *       dst[i] == (mask 有效 ? v[i] : -999.0f)
 *     掩码生效 ⇒ 说明「mask 机制本身在该点位是可用的，FIRST_ELEMENT 不吃掩码是它的定义」。
 *
 * 掩码是**运行时实参**（host 每次 launch 传一个值，一次 launch 只跑一个 mode —— M24 reviewer 的
 * 「一次 launch 只跑一个 mode」纪律），两类（宏 PROBE_A_ALT 选）：
 *
 *   PROBE_A_ALT=0（默认）**连续掩码族**：`UpdateMask<T>(count)` ⇒ count ∈ {0,1,8,64}
 *      = 全 0 / 单 lane / 低 8 lane / 全 1。
 *      ⚠ `UpdateMask<T>(count)` 只能生成「最低 count 个 lane 有效」这一族，**表达不出非连续掩码**；
 *      非连续（交替 / 周期性）掩码由另一组 target（下）承担。
 *
 *   PROBE_A_ALT=1 **非连续掩码族**（补 mission 明列的「交替」）：selector ∈ {0,1,2,3}
 *      0 ⇒ `CreateMask<float, MaskPattern::M4>`（文档：4 的倍数设为有效 ⇒ 周期 4 = 非连续）
 *      1 ⇒ `CreateMask<float, MaskPattern::M3>`（周期 3 = 非连续）
 *      2/3 ⇒ `MaskGenWithRegTensor<uint32_t, 0>` 从 host 给的 64bit 码型造**真交替**掩码
 *             （0x5555… / 0xAAAA… 两个反相），码型由 MTE2 搬进 UB 的 32B 对齐槽
 *  ⇒ 这一组回答「掩码是**按位**参与还是**按数量**参与」：若 DIST_NORM_B32 写出的 lane 集合是
 *     周期性/交替而非前缀，则掩码确按位参与；此时 DIST_FIRST_ELEMENT_B32 仍应只写 lane 0。
 *
 * 编译（本目录）：见 CMakeLists.txt / run_probes.sh；
 *   变体 = 宏 PROBE_A_DIST（0=FIRST_ELEMENT_B32，1=NORM_B32），每个变体 ≥5 次独立进程运行。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>

#ifndef PROBE_A_DIST
#define PROBE_A_DIST 0
#endif
#ifndef PROBE_A_ALT
#define PROBE_A_ALT 0
#endif
#ifndef PROBE_A_TAG
#define PROBE_A_TAG probe_a_custom
#endif

#define PROBE_A_STR_(x) #x
#define PROBE_A_STR(x) PROBE_A_STR_(x)

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t VL = 64;                 // 3510 向量寄存器 fp32 lane 数（256B / 4B）
constexpr uint32_t UB_SRC = 0;              // fp32[64] = 256B（源寄存器数据）
constexpr uint32_t UB_DST = 256;            // fp32[64] = 256B（落盘目标，32B 对齐）
constexpr uint32_t UB_PAT = 512;            // uint32_t[8] = 32B（MaskGenWithRegTensor 的码型槽）
constexpr uint32_t UB_END = 544;
static_assert(UB_END <= 190 * 1024, "UB footprint too large");

constexpr float POISON = -999.0f;           // dst 预置值：不在 src 值域 [100,164) 内

constexpr AscendC::MutexID BUF_X = 0;

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe, bool RLS_NONBLOCK>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, RLS_NONBLOCK>(id);
}
template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

class StoreDistProbe {
public:
    __aicore__ inline void Init(GM_ADDR val, GM_ADDR poison, GM_ADDR out, uint32_t maskCount,
                                GM_ADDR pat)
    {
        maskCount_ = maskCount;
        patRaw_ = reinterpret_cast<__gm__ uint32_t*>(pat);
        valGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(val), VL);
        poisonGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(poison), VL);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out), VL);
        patGm_.SetGlobalBuffer(patRaw_, 8);
    }

    __aicore__ inline void Process()
    {
        BufAcquire<PIPE_MTE2>(BUF_X);
        DataCopy(MkT<float>(UB_SRC, VL), valGm_[0], VL);
        AscendC::PipeBarrier<PIPE_MTE2>();     // 不同缓冲，但排空以固定 dump 的确定性
        DataCopy(MkT<float>(UB_DST, VL), poisonGm_[0], VL);
#if PROBE_A_ALT == 1
        AscendC::PipeBarrier<PIPE_MTE2>();
        DataCopy(MkT<uint32_t>(UB_PAT, 8), patGm_[0], 8);   // 32B 码型槽（MaskGenWithRegTensor 用）
#endif
        BufRelease<PIPE_MTE2, false>(BUF_X);

        BufAcquire<PIPE_V>(BUF_X);
        Run();
        BufRelease<PIPE_V, false>(BUF_X);

        BufAcquire<PIPE_MTE3>(BUF_X);
        DataCopy(outGm_[0], MkT<float>(UB_DST, VL), VL);
        BufRelease<PIPE_MTE3, false>(BUF_X);
    }

private:
    __aicore__ inline void Run()
    {
        __ubuf__ float* srcP = reinterpret_cast<__ubuf__ float*>(UB_SRC);
        __ubuf__ float* dstP = reinterpret_cast<__ubuf__ float*>(UB_DST);
        __ubuf__ uint32_t* patP = reinterpret_cast<__ubuf__ uint32_t*>(UB_PAT);
        uint32_t cnt = maskCount_;
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            RegTensor<uint32_t> pat;
            MaskReg m;
#if PROBE_A_ALT == 0
            m = UpdateMask<float>(cnt);                // 连续族：cnt 个最低 lane 有效
#else
            // 非连续族：selector 0=M4、1=M3、2/3=MaskGenWithRegTensor 真交替
            if (maskCount_ == 0) {
                m = CreateMask<float, MaskPattern::M4>();
            } else if (maskCount_ == 1) {
                m = CreateMask<float, MaskPattern::M3>();
            } else {
                LoadAlign(pat, patP);                  // 32B 对齐码型槽（前 8B 即 64 个有效位）
                MaskGenWithRegTensor<uint32_t, 0>(m, pat);
            }
#endif
            LoadAlign(v, srcP);                        // 全宽读，DIST_NORM
#if PROBE_A_DIST == 0
            StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstP, v, m);
#else
            StoreAlign<float, StoreDist::DIST_NORM_B32>(dstP, v, m);
#endif
        }
    }

    uint32_t maskCount_ = VL;
    __gm__ uint32_t* patRaw_ = nullptr;
    GlobalTensor<float> valGm_;
    GlobalTensor<float> poisonGm_;
    GlobalTensor<float> outGm_;
    GlobalTensor<uint32_t> patGm_;
};

}   // namespace

__vector__ __global__ void probe_a_storedist_kernel(GM_ADDR val, GM_ADDR poison, GM_ADDR out,
                                                    uint32_t maskCount, GM_ADDR pat)
{
    StoreDistProbe op;
    op.Init(val, poison, out, maskCount, pat);
    op.Process();
}

int main(int argc, char** argv)
{
    const char* dumpDir = (argc >= 2) ? argv[1] : nullptr;
    const uint32_t procIdx = (argc >= 3) ? static_cast<uint32_t>(std::atoi(argv[2])) : 0;
    const uint32_t maskCount = (argc >= 4) ? static_cast<uint32_t>(std::atoi(argv[3])) : VL;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t bytes = VL * sizeof(float);
    float* valHost = new float[VL];
    float* poisonHost = new float[VL];
    float* outHost = new float[VL];
    for (uint32_t i = 0; i < VL; ++i) {
        valHost[i] = 100.0f + static_cast<float>(i);
        poisonHost[i] = POISON;
        outHost[i] = 0.0f;
    }
    void* valDev = nullptr;
    void* poisonDev = nullptr;
    void* outDev = nullptr;
    aclrtMalloc(&valDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&poisonDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&outDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(valDev, bytes, valHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(poisonDev, bytes, poisonHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    // 码型槽：MaskGenWithRegTensor 的 64 个有效位（前 8B = 64 bit，1 bit ↔ 1 个 fp32 lane）
    const size_t patBytes = 8 * sizeof(uint32_t);
    uint32_t patHost[8] = {0, 0, 0, 0, 0, 0, 0, 0};
    patHost[0] = (maskCount == 3) ? 0xAAAAAAAAu : 0x55555555u;   // 交替的两个反相
    patHost[1] = patHost[0];
    void* patDev = nullptr;
    aclrtMalloc(&patDev, patBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(patDev, patBytes, patHost, patBytes, ACL_MEMCPY_HOST_TO_DEVICE);

#if PROBE_A_DIST == 0
    const char* distName = "DIST_FIRST_ELEMENT_B32";
#else
    const char* distName = "DIST_NORM_B32";
#endif
    std::printf("[probe A] %s  dist=%s maskSel=%u altFamily=%d proc=%u\n", PROBE_A_STR(PROBE_A_TAG),
                distName, maskCount, PROBE_A_ALT, procIdx);

    aclrtMemset(outDev, bytes, 0, bytes);
    probe_a_storedist_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(valDev),
                                              reinterpret_cast<uint8_t*>(poisonDev),
                                              reinterpret_cast<uint8_t*>(outDev), maskCount,
                                              reinterpret_cast<uint8_t*>(patDev));
    aclError e = aclrtSynchronizeStream(stream);
    if (e != ACL_SUCCESS) {
        std::printf("[probe A] 运行失败 aclError=%d\n", static_cast<int>(e));
        return 2;
    }
    aclrtMemcpy(outHost, bytes, outDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    // ---- 判读 ----
    // 期望的"被写 lane 集合"：
    //   FIRST_ELEMENT_B32（文档：忽略 mask，只搬 src 第一个元素）⇒ 恒 {0}
    //   NORM_B32（对照）⇒ 由掩码决定：
    //     连续族 UpdateMask(count)          ⇒ {0..count-1}
    //     非连续族 sel=0 (M4，周期 4)        ⇒ {i : i%4==0}
    //              sel=1 (M3，周期 3)        ⇒ {i : i%3==0}
    //              sel=2/3 (MaskGenWithRegTensor 交替) ⇒ 结构判据：恰好 32 个 lane、
    //                       且全部同奇偶（真交替）+ 每个被写 lane 的值都逐位等于 src
    uint32_t written = 0, untouched = 0, other = 0, firstMismatch = VL;
    uint32_t writtenEven = 0, writtenOdd = 0;
    float firstGot = 0.0f;
    char lanes[256];
    uint32_t lp = 0;
    lanes[0] = '\0';
    uint32_t expectCount = 0;
    for (uint32_t i = 0; i < VL; ++i) {
        const bool isPoison = (outHost[i] == POISON);
        bool expectWritten;
#if PROBE_A_DIST == 0
        expectWritten = (i == 0);                     // 文档：忽略 mask，只写 src 第一个元素
#else
  #if PROBE_A_ALT == 0
        expectWritten = (i < maskCount);              // 连续族：掩码应生效
  #else
        if (maskCount == 0)      expectWritten = (i % 4 == 0);   // M4
        else if (maskCount == 1) expectWritten = (i % 3 == 0);   // M3
        else                     expectWritten = !isPoison;      // 交替：集合由实测位图定，只做结构判据
  #endif
#endif
        if (expectWritten) ++expectCount;
        const float want = expectWritten ? valHost[i] : POISON;
        if (outHost[i] == want) {
            if (expectWritten) {
                ++written;
                if (i % 2 == 0) ++writtenEven; else ++writtenOdd;
            } else {
                ++untouched;
            }
        } else {
            ++other;
            if (firstMismatch == VL) {
                firstMismatch = i;
                firstGot = outHost[i];
            }
        }
        if (isPoison) { lanes[lp++] = '.'; } else { lanes[lp++] = '#'; }
        if (lp >= sizeof(lanes) - 1) break;
    }
    lanes[lp] = '\0';

    std::printf("[probe A] 实测: dst[0..7]=%g %g %g %g %g %g %g %g\n",
                static_cast<double>(outHost[0]), static_cast<double>(outHost[1]),
                static_cast<double>(outHost[2]), static_cast<double>(outHost[3]),
                static_cast<double>(outHost[4]), static_cast<double>(outHost[5]),
                static_cast<double>(outHost[6]), static_cast<double>(outHost[7]));
    std::printf("[probe A] 落盘位图(.=未触碰 #=被写): %s\n", lanes);
    std::printf("[probe A] 写出 lane 数=%u（偶 %u / 奇 %u）\n", written, writtenEven, writtenOdd);

    bool pass = (other == 0);
    bool alternateCase = false;
#if PROBE_A_DIST == 1 && PROBE_A_ALT == 1
    if (maskCount >= 2) {
        // 交替掩码的结构判据（不预设奇偶相位）：恰好 32 个 lane 被写、且全部同奇偶（=真交替，非前缀）
        alternateCase = true;
        pass = (other == 0 && written == 32 && (writtenEven == 32 || writtenOdd == 32));
    }
#endif

    if (pass) {
        if (alternateCase) {
            std::printf("[probe A] %s maskSel=%u RUN PASS：交替掩码被严格遵守"
                        "（%u 个 lane、全%s；其余全为 POISON）\n",
                        PROBE_A_STR(PROBE_A_TAG), maskCount, written,
                        (writtenEven == 32) ? "偶" : "奇");
        } else {
            std::printf("[probe A] %s maskSel=%u RUN PASS：写出 %u lane（期望 %u）、未触碰 %u lane\n",
                        PROBE_A_STR(PROBE_A_TAG), maskCount, written, expectCount, untouched);
        }
    } else if (alternateCase) {
        std::printf("[probe A] %s maskSel=%u RUN FAIL：交替掩码结构判据不成立"
                    "（写出 %u lane、偶 %u / 奇 %u、不符 %u）\n",
                    PROBE_A_STR(PROBE_A_TAG), maskCount, written, writtenEven, writtenOdd, other);
    } else {
        std::printf("[probe A] %s maskSel=%u RUN FAIL：%u lane 不符；首个不符 lane=%u 得到 %g\n",
                    PROBE_A_STR(PROBE_A_TAG), maskCount, other, firstMismatch,
                    static_cast<double>(firstGot));
    }

    if (dumpDir != nullptr) {
        char path[512];
        std::snprintf(path, sizeof(path), "%s/a_%s_mask%u_p%u.bin", dumpDir, PROBE_A_STR(PROBE_A_TAG),
                      maskCount, procIdx);
        FILE* f = std::fopen(path, "wb");
        if (f != nullptr) {
            std::fwrite(outHost, 1, bytes, f);
            std::fclose(f);
        }
    }

    aclrtFree(valDev);
    aclrtFree(poisonDev);
    aclrtFree(outDev);
    aclrtFree(patDev);
    delete[] valHost;
    delete[] poisonHost;
    delete[] outHost;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return pass ? 0 : 1;
}
