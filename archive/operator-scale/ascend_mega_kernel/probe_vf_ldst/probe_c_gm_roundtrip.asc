/**
 * probe_c_gm_roundtrip.asc —— 探针 C：**GM 回环**（同核 `MTE3: UB→GM` 紧接 `MTE2: GM→UB`）的可见性。
 *
 * 为什么单独立这个探针（探针 B 的结论 + M36 源码阅读）：
 *   探针 B 的 23 个变体把 mission 列出的全部变量矩阵都扫过（读法 / 释放模式 / 搬运粒度 /
 *   槽复用 / 中间 V 操作 / 消费者释放 / MTE2 在飞 backlog），**一个都没有复现 M36 的
 *   "BRC 读 MTE2 刚搬进的 UB 槽非确定性读到旧值"**。于是我去读 M36 的现役源码
 *   （`../wt-36/m20_hyperconn/m20_hyperconn.asc`；引用只给**符号**、不给裸行号，行号会随其分支漂移），
 *   看到三处关键事实：
 *     * `InjwStage`（W0）：V 算出 injW 全表后 `DataCopy(injwGm[0], tabL, ...)` —— **MTE3 把表整块落 GM**；
 *     * `CombineStage`（S1）读的是 **UB 里的同表**（`iwTabUb`，`DIST_BRC_B32`）；
 *     * `ProcessAiv` 里 **W0 与 S1 之间没有任何 barrier**，S1 之后才有 `BarrierAiv`。
 *   ⇒ 最可能的原设计是「S1 用 MTE2 从 GM 把 injW 取回 UB 槽再 BRC」——即 **MTE3(UB→GM) 与
 *     MTE2(GM→UB) 之间的同核可见性**，而不是"BRC 这条指令有什么问题"。这与 M36 自述的四个
 *     现象全都吻合（粒度无关 / 位置每次不同 / V 自己写的槽正确 / 普通全宽读不受影响）。
 *
 *   **agent-hcmix（M36）随后回信确认了这个假说**，并自查出第二个因子：
 *     (i) injW 表当初确实先在 GM 里（W0 `DataCopyPad(..., ExtBlock1(16))` MTE3 写 GM，
 *         S1 `DataCopyPad(..., ExtBlock1(4))` MTE2 取回同一地址，再 BRC）；
 *     (ii) **两侧用的是两个不同的 BufferID**（`BUF_AIV_SG=5` 阻塞释放（false=BLOCK）/ `BUF_AIV_IW=3` 取）
 *          ⇒ 那次阻塞释放**没有任何消费者 acquire**，对「GM 写 → GM 读」不构成任何排序。
 *     本探针的 ORDER=3（两个不同 token）与 SHAPE=1（逐 chunk 16B 小回写）就是照这两条事实加的。
 *
 * 本探针就是把这条回环单独隔离出来：
 *   W0 等价：V 写出 ITERS×256B 的表 → MTE3 整块落 GM（gmMid）
 *   S1 等价：MTE2 逐 chunk 从 gmMid 取回 256B 到 UB 槽 → V `DIST_BRC_B32` 读槽 → 落盘
 *   gmMid 由 **host 预置成 POISON(-999.0f)** ⇒ 「读到 poison」= 读到了 MTE3 还没写回的内容
 *
 * 变体（宏 PROBE_C_ORDER）：
 *   0 = **不插任何排序**（只有标量程序序：MTE3 的 DataCopy 先于 MTE2 的 DataCopy 被发射）
 *   1 = `SetFlag/WaitFlag<HardEvent::MTE3_MTE2>`（跨 pipe 硬件事件，官方 donor 同款）
 *   2 = BufferID 跨 pipe 交接：MTE3 阻塞释放（false=BLOCK）→ **对侧取同一个 token**（文档 §2 认可的可见性载体）
 *   3 = **两个不同 BufferID**（复刻 M36 的事实形态，见下）：MTE3 在 token A 上阻塞释放（false=BLOCK）、
 *       MTE2 在 token B 上取 —— **A 的阻塞释放没有任何消费者去 acquire**，
 *       所以它对「GM 写 → GM 读」不构成任何排序（M36 自述：`BUF_AIV_SG=5` 释放、`BUF_AIV_IW=3` 取）
 *
 * 变体（宏 PROBE_C_SHAPE）——回写的**形态**：
 *   0 = 一次性 16KB 整块 MTE3（本探针初版）
 *   1 = **逐 chunk 一条小 MTE3**（16B），64 条背靠背 —— 复刻 M36 的 W0 形态
 *       （其自述：W0 每 token 一条 `DataCopyPad(injwGm[…], sigL, ExtBlock1(16))`，共 m 条；
 *        S1 每 item 一条 `DataCopyPad(iwL, injwGm[…], ExtBlock1(4))`）
 *       ⇒ 在飞写流更长，可检验"137/160 的失败率"是否来自这条写流与读流的交叠
 *
 * 判据（T1 逐字节）：每个 chunk 的 lane0 必须 == 1000.0f + k；分类 ok / stale_prev / ahead /
 *   poison / zero / other，与探针 B 同一套判读器。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>

#ifndef PROBE_C_ORDER
#define PROBE_C_ORDER 0
#endif
#ifndef PROBE_C_SHAPE
#define PROBE_C_SHAPE 0
#endif
#ifndef PROBE_C_TAG
#define PROBE_C_TAG probe_c_custom
#endif

#define PROBE_C_STR_(x) #x
#define PROBE_C_STR(x) PROBE_C_STR_(x)

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t VL = 64;
constexpr uint32_t ITERS = 64;
constexpr float POISON = -999.0f;
constexpr float V_BASE = 1000.0f;

constexpr uint32_t UB_TAB = 0;                                  // fp32[ITERS*VL] 表（W0 产出）
constexpr uint32_t UB_SLOT = UB_TAB + ITERS * VL * 4;           // 256B 消费者槽
constexpr uint32_t UB_OUT = UB_SLOT + 256;                      // fp32[ITERS*VL] 输出
constexpr uint32_t UB_END = UB_OUT + ITERS * VL * 4;
static_assert(UB_END <= 190 * 1024, "UB footprint too large");

constexpr AscendC::MutexID BUF_TAB = 0;    // 表：V → MTE3（ORDER=2 时也是回环的交接 token）
constexpr AscendC::MutexID BUF_RT = 1;     // ORDER=3 消费者侧的另一个 token（复刻 M36 的两个不同 id）
constexpr AscendC::MutexID BUF_SLOT = 2;   // 槽：MTE2 → V
constexpr AscendC::MutexID BUF_OUT = 3;    // 输出：V → MTE3

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe, bool RLS_NONBLOCK>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, RLS_NONBLOCK>(id);
}
template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

class GmRoundTripProbe {
public:
    __aicore__ inline void Init(GM_ADDR mid, GM_ADDR out, GM_ADDR outDump)
    {
        midGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(mid), static_cast<uint64_t>(ITERS) * VL);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out), static_cast<uint64_t>(ITERS) * VL);
        dumpGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outDump), static_cast<uint64_t>(UB_END / 4));
    }

    __aicore__ inline void Process()
    {
        WriteTable();      // W0 等价：V 写 UB 表 → MTE3 整块落 GM
        ReadBackLoop();    // S1 等价：MTE2 从 GM 逐 chunk 取回 UB 槽 → V BRC 读
        DumpBack();
    }

private:
    __aicore__ inline void WriteTable()
    {
        BufAcquire<PIPE_V>(BUF_TAB);
        __ubuf__ float* tabP = reinterpret_cast<__ubuf__ float*>(UB_TAB);
        for (uint16_t k = 0; k < static_cast<uint16_t>(ITERS); ++k) {
            // VF 内的动态标量（V_BASE + k）会触发 "Unsupported scalar instruction in AIV loop"。
            // M36 的 `InjwStage` 里有同款约束，其注释**原文**（截至 M36 的 commit 4fe9ac8；
            // 按**符号 + commit** 定位，不给行号）：
            //   「另外 s 必须编译期常量展开（VF 内动态标量会触发
            //     「Unsupported scalar instruction in AIV loop」，docs/05 §6.3 #23 同类）。」
            // 故这里按 chunk 单独进/出 VF。
            const float kv = V_BASE + static_cast<float>(k);
            __VEC_SCOPE__
            {
                RegTensor<float> p;
                MaskReg full = CreateMask<float, MaskPattern::ALL>();
                Duplicate(p, kv);
                StoreAlign(tabP + static_cast<uint32_t>(k) * VL, p, full);
                LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            }
        }
        BufRelease<PIPE_V, false>(BUF_TAB);

        BufAcquire<PIPE_MTE3>(BUF_TAB);
#if PROBE_C_SHAPE == 0
        DataCopy(midGm_[0], MkT<float>(UB_TAB, ITERS * VL), ITERS * VL);        // 一次性 16KB
#else
        // 逐 chunk 一条 16B 小 MTE3（复刻 M36 的 W0：每 token 一条 ExtBlock1(16)），64 条背靠背
        for (uint16_t k = 0; k < static_cast<uint16_t>(ITERS); ++k) {
            DataCopyPad(midGm_[static_cast<uint64_t>(k) * VL], MkT<float>(UB_TAB + k * VL * 4, 4),
                        DataCopyExtParams{1, 4 * sizeof(float), 0, 0, 0});
        }
#endif
#if PROBE_C_ORDER == 1
        BufRelease<PIPE_MTE3, false>(BUF_TAB);
        SetFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_MTE2>(EVENT_ID0);
#elif PROBE_C_ORDER == 2
        BufRelease<PIPE_MTE3, false>(BUF_TAB);   // 阻塞释放（false=BLOCK）= 同步点
        BufAcquire<PIPE_MTE2>(BUF_TAB);         // **对侧取同一个 token**：文档 §2 认可的可见性载体
        BufRelease<PIPE_MTE2, false>(BUF_TAB);
#elif PROBE_C_ORDER == 3
        BufRelease<PIPE_MTE3, false>(BUF_TAB);   // token A：阻塞释放（false=BLOCK），但**没有任何消费者去 acquire**
        BufAcquire<PIPE_MTE2>(BUF_RT);          // token B：另一个 id 上取 ⇒ 对 GM 写读不构成排序
        BufRelease<PIPE_MTE2, false>(BUF_RT);
#else
        BufRelease<PIPE_MTE3, false>(BUF_TAB);
        // **不插任何排序**：紧接着（标量程序序）就发 MTE2 取回
#endif
    }

    __aicore__ inline void ReadBackLoop()
    {
        __ubuf__ float* outP = reinterpret_cast<__ubuf__ float*>(UB_OUT);
        BufAcquire<PIPE_V>(BUF_OUT);
        for (uint16_t k = 0; k < static_cast<uint16_t>(ITERS); ++k) {
            BufAcquire<PIPE_MTE2>(BUF_SLOT);
            DataCopy(MkT<float>(UB_SLOT, VL), midGm_[static_cast<uint64_t>(k) * VL], VL);
            BufRelease<PIPE_MTE2, false>(BUF_SLOT);

            BufAcquire<PIPE_V>(BUF_SLOT);
            __VEC_SCOPE__
            {
                RegTensor<float> v;
                MaskReg full = CreateMask<float, MaskPattern::ALL>();
                LoadAlign<float, LoadDist::DIST_BRC_B32>(v, reinterpret_cast<__ubuf__ float*>(UB_SLOT));
                StoreAlign(outP + static_cast<uint32_t>(k) * VL, v, full);
            }
            BufRelease<PIPE_V, false>(BUF_SLOT);
        }
        BufRelease<PIPE_V, false>(BUF_OUT);
    }

    __aicore__ inline void DumpBack()
    {
        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(outGm_[0], MkT<float>(UB_OUT, ITERS * VL), ITERS * VL);
        BufRelease<PIPE_MTE3, false>(BUF_OUT);

        BufAcquire<PIPE_MTE3>(BUF_SLOT);
        DataCopy(dumpGm_[0], MkT<float>(UB_TAB, UB_END / 4), UB_END / 4);
        BufRelease<PIPE_MTE3, false>(BUF_SLOT);
    }

    GlobalTensor<float> midGm_;
    GlobalTensor<float> outGm_;
    GlobalTensor<float> dumpGm_;
};

}   // namespace

__vector__ __global__ void probe_c_roundtrip_kernel(GM_ADDR mid, GM_ADDR out, GM_ADDR outDump)
{
    GmRoundTripProbe op;
    op.Init(mid, out, outDump);
    op.Process();
}

namespace {
#if PROBE_C_ORDER == 0
const char* OrderName() { return "无排序（仅标量程序序）"; }
#elif PROBE_C_ORDER == 1
const char* OrderName() { return "SetFlag/WaitFlag<MTE3_MTE2>"; }
#elif PROBE_C_ORDER == 2
const char* OrderName() { return "BufferID 同一 token: MTE3 阻塞释放(false) → MTE2 取"; }
#else
const char* OrderName() { return "两个不同 BufferID（A 阻塞释放(false) 无人取 / B 取另一 token）——复刻 M36 事实"; }
#endif
}   // namespace

int main(int argc, char** argv)
{
    const char* dumpDir = (argc >= 2) ? argv[1] : nullptr;
    const uint32_t procIdx = (argc >= 3) ? static_cast<uint32_t>(std::atoi(argv[2])) : 0;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t n = static_cast<size_t>(ITERS) * VL;
    const size_t bytes = n * sizeof(float);
    const size_t dumpBytes = static_cast<size_t>(UB_END);

    float* midHost = new float[n];
    float* outHost = new float[n];
    float* dumpHost = new float[UB_END / 4];
    for (size_t i = 0; i < n; ++i) {
        midHost[i] = POISON;      // gmMid 预置 POISON：读到它 = MTE3 的写回还没到
    }
    void* midDev = nullptr;
    void* outDev = nullptr;
    void* dumpDev = nullptr;
    aclrtMalloc(&midDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&outDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dumpDev, dumpBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(midDev, bytes, midHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    std::printf("[probe C] %s  order=%d (%s)  shape=%d (%s)  iters=%u  proc=%u\n",
                PROBE_C_STR(PROBE_C_TAG), PROBE_C_ORDER, OrderName(), PROBE_C_SHAPE,
                (PROBE_C_SHAPE == 0) ? "一次性 16KB 整块 MTE3" : "逐 chunk 16B 小 MTE3 ×64",
                ITERS, procIdx);

    aclrtMemset(outDev, bytes, 0, bytes);
    aclrtMemset(dumpDev, dumpBytes, 0, dumpBytes);
    probe_c_roundtrip_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(midDev),
                                               reinterpret_cast<uint8_t*>(outDev),
                                               reinterpret_cast<uint8_t*>(dumpDev));
    const aclError e = aclrtSynchronizeStream(stream);
    if (e != ACL_SUCCESS) {
        std::printf("[probe C] 运行失败 aclError=%d\n", static_cast<int>(e));
        return 2;
    }
    aclrtMemcpy(outHost, bytes, outDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dumpHost, dumpBytes, dumpDev, dumpBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t ok = 0, stalePrev = 0, ahead = 0, poison = 0, zero = 0, other = 0;
    uint32_t firstBadK = ITERS, laneBad = 0;
    float firstBadGot = 0.0f;
    char classify[ITERS + 1];
    for (uint32_t k = 0; k < ITERS; ++k) {
        const float want = V_BASE + static_cast<float>(k);
        const float got = outHost[k * VL];
        if (got == want) { ++ok; classify[k] = '.'; }
        else if (got == want - 1.0f) { ++stalePrev; classify[k] = 'p'; }
        else if (got == want + 1.0f) { ++ahead; classify[k] = 'n'; }
        else if (got == POISON) { ++poison; classify[k] = 'X'; }
        else if (got == 0.0f) { ++zero; classify[k] = 'z'; }
        else { ++other; classify[k] = '?'; }
        if (got != want && firstBadK == ITERS) { firstBadK = k; firstBadGot = got; }
        for (uint32_t i = 0; i < VL; ++i) {
            if (outHost[k * VL + i] != want) ++laneBad;
        }
    }
    classify[ITERS] = '\0';
    std::printf("[probe C] chunk 判读(.=ok p=上一chunk n=下一chunk X=poison z=0 ?=其它): %s\n", classify);
    std::printf("[probe C] chunk: ok=%u stale_prev=%u ahead=%u poison=%u zero=%u other=%u / %u\n", ok,
                stalePrev, ahead, poison, zero, other, ITERS);
    std::printf("[probe C] lane0 不符=%u  全 lane 不符=%u/%u\n", ITERS - ok, laneBad, ITERS * VL);
    if (firstBadK != ITERS) {
        std::printf("[probe C] 首个不符 chunk=%u 得到 %g 期望 %g\n", firstBadK,
                    static_cast<double>(firstBadGot), static_cast<double>(V_BASE + firstBadK));
    }
    const bool pass = (ok == ITERS);
    std::printf("[probe C] %s %s\n", PROBE_C_STR(PROBE_C_TAG), pass ? "RUN PASS" : "RUN FAIL");

    // GM 里最终的内容（校验 MTE3 的写回是否到位）
    aclrtMemcpy(midHost, bytes, midDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    uint32_t midOk = 0;
    for (uint32_t k = 0; k < ITERS; ++k) {
        if (midHost[k * VL] == V_BASE + static_cast<float>(k)) ++midOk;
    }
    std::printf("[probe C] GM(gmMid) 最终内容逐 chunk 正确数: %u/%u\n", midOk, ITERS);

    if (dumpDir != nullptr) {
        char path[512];
        std::snprintf(path, sizeof(path), "%s/c_%s_p%u_out.bin", dumpDir, PROBE_C_STR(PROBE_C_TAG),
                      procIdx);
        FILE* f = std::fopen(path, "wb");
        if (f != nullptr) { std::fwrite(outHost, 1, bytes, f); std::fclose(f); }
        std::snprintf(path, sizeof(path), "%s/c_%s_p%u_mid.bin", dumpDir, PROBE_C_STR(PROBE_C_TAG),
                      procIdx);
        f = std::fopen(path, "wb");
        if (f != nullptr) { std::fwrite(midHost, 1, bytes, f); std::fclose(f); }
        std::snprintf(path, sizeof(path), "%s/c_%s_p%u_ub.bin", dumpDir, PROBE_C_STR(PROBE_C_TAG),
                      procIdx);
        f = std::fopen(path, "wb");
        if (f != nullptr) { std::fwrite(dumpHost, 1, dumpBytes, f); std::fclose(f); }
    }

    aclrtFree(midDev);
    aclrtFree(outDev);
    aclrtFree(dumpDev);
    delete[] midHost;
    delete[] outHost;
    delete[] dumpHost;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return pass ? 0 : 1;
}
