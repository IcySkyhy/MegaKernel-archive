/**
 * probe_b_ldst_handover.asc —— 探针 B（本 mission 的核心）：
 *   「MTE2 写 UB 槽 → BufferID 交接 → V 侧读」的**可见性**，按读法/释放模式/粒度/中间 V 操作隔离。
 *
 * 触发点（M36，2026-09-26，见 m20_hyperconn/README.md §4.1 第 2 条）：M36 的 S1 段按 item 从 GM 取
 * `injW[s]` 再 `LoadDist::DIST_BRC_B32` 广播，160 个 chunk 里 137 个退化为 `out = h`（读到旧值），
 * **且每次跑错的位置不同**；而 `Duplicate(1.0f)` 硬编码 160/160 对、`LoadAlign<bfloat16_t,
 * DIST_UNPACK_B16>`（普通全宽读）一直对、BRC 读 **V 自己写出**的槽也对（S2 的 rstd 逐位一致）。
 * M36 的规避：需要广播的标量先进 V（V 写 UB 槽），再从该槽 BRC。
 *
 * 本探针要回答两个问题（mission 原文）：
 *   Q1 是「**BRC 特有**」还是「**整类装载读都被影响**」？
 *   Q2 是「**我们少了一步 drain/acquire**」还是「**跨 pipe 可见性对装载指令类型敏感**」？
 * 若无法对齐，如实写「未对齐、但观测到 X」，不硬给归因。
 *
 * ---- 场景（忠实于 M36 的形态：per-item 取标量 → 广播 → 用）----
 *   gmVal: ITERS 个 chunk，chunk k 的 64 个 f32 全部 = 1000.0f + k（**每 chunk 值互不相同**，
 *          "读到旧值"就能被分类到具体来源）
 *   启动时用 V 把整段槽区写成 POISON = -999.0f（V→V + LocalMemBar，确定性初值）
 *   主循环 k=0..ITERS-1：
 *     生产者（MTE2 或 V）写 chunk k 的值进槽 → 释放 BufferID（REL 决定 mode）
 *     消费者 V get → 用 READ 指定的读法把槽读进寄存器 → 全 VL 落盘 UB_OUT + k*VL
 *   循环后整段 UB（槽区 + 输出区）原样 dump 回 GM
 *
 * ---- 判据（T1 逐字节，docs/17 §1.1）----
 *   每个 chunk 取 lane 0：want = 1000.0f + k。分类：
 *     ok          got == want                        （正确）
 *     stale_prev  got == want - 1                    （读到**上一个 chunk**的值 = 同槽复用下最自然的"旧值"）
 *     poison      got == -999.0f                     （从未被写过 ⇒ 生产者的写完全没到）
 *     other       got 为其它值                        （残留/第三来源）
 *   另报"全 VL lane 不符点数"（报告项，用于说明 GRAN<256 时槽尾的旧数据）。
 *
 * ---- 变体宏 ----
 *   PROBE_B_REL     历史档位键；全项目裁定「release 侧所有场景一律 false」⇒ 本轴作废，恒 false。
 *                   0=false（CANN ASC_LOCK_BLOCK 默认、阻塞）；1/2 原 NON_BLOCK 档，现亦 false
 *                   （2 保留释放前 PipeBarrier<PIPE_MTE2>）
 *   PROBE_B_READ    0=LoadAlign<float, DIST_BRC_B32>   1=LoadAlign 全宽（DIST_NORM）
 *                   2=LocalTensor::GetValue            3=BRC + 前置 LocalMemBar<VEC_STORE,VEC_LOAD>
 *   PROBE_B_GRAN    0=整块 256B（64 f32） 1=32B（8 f32） 2=4B（DataCopyPad 1 f32）
 *   PROBE_B_MID     0=无  1=V 侧先对无关 32B scratch 做一次 store→load
 *   PROBE_B_LAYOUT  0=所有 chunk 复用同一个 256B 槽  1=每 chunk 自己的 256B 槽
 *   PROBE_B_PROD    0=生产者 = MTE2 DataCopy   1=生产者 = V（Duplicate+StoreAlign，M36 的规避形式）
 *                   2=**生产者关闭**（不写槽，只做握手）⇒ 非空洞性对照：读到的必须是 POISON，
 *                     否则说明"读的不是这个槽"，本探针全部 PASS 都不可信
 *   PROBE_B_OFF     读地址相对槽首的元素偏移（0=+0B，1=+4B）
 *   PROBE_B_VREL    **消费者释放模式**：历史档位键；全项目裁定「一律 false」⇒ 本轴作废，恒 false。
 *                   0/1 原 NON_BLOCK/BLOCK 双档，现均落 false（= CANN ASC_LOCK_BLOCK 默认、阻塞）
 *   PROBE_B_BACKLOG 0=MTE2 每 chunk 只发一条槽写（无在飞队列）
 *                   1=槽写**之前**先发一条 16KB 的大 DataCopy（到无关 scratch）⇒ MTE2 队列里有在飞工作量。
 *                     （REL 轴已按全项目 all-false 政策作废：0/1/2 现均落 false，不再区分 mode）
 *                     这是 M36 场景（S1 每 chunk 还要搬 H/BO）的形态最近似逼近。
 *
 * 每个变体一个可执行文件，参数：<dumpdir> <procIdx>；一次 launch 只跑一种配置（M24 reviewer 纪律），
 * run_probes.sh 对每个变体起 ≥5 个**独立进程**、逐次 dump + sha256。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>

#ifndef PROBE_B_REL
#define PROBE_B_REL 1
#endif
#ifndef PROBE_B_READ
#define PROBE_B_READ 0
#endif
#ifndef PROBE_B_GRAN
#define PROBE_B_GRAN 0
#endif
#ifndef PROBE_B_MID
#define PROBE_B_MID 0
#endif
#ifndef PROBE_B_LAYOUT
#define PROBE_B_LAYOUT 0
#endif
#ifndef PROBE_B_PROD
#define PROBE_B_PROD 0
#endif
#ifndef PROBE_B_OFF
#define PROBE_B_OFF 0
#endif
#ifndef PROBE_B_VREL
#define PROBE_B_VREL 0
#endif
#ifndef PROBE_B_BACKLOG
#define PROBE_B_BACKLOG 0
#endif
#ifndef PROBE_B_TAG
#define PROBE_B_TAG probe_b_custom
#endif

#define PROBE_B_STR_(x) #x
#define PROBE_B_STR(x) PROBE_B_STR_(x)

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t VL = 64;                 // 3510 向量寄存器 fp32 lane 数（256B / 4B）
constexpr uint32_t ITERS = 64;              // 每次 launch 的 chunk 数
constexpr uint32_t SLOT_B = VL * 4;         // 每 chunk 槽 = 256B
constexpr uint32_t SLOT_REGS = ITERS;       // 槽区 = ITERS 个 VL
constexpr float POISON = -999.0f;
constexpr float V_BASE = 1000.0f;

constexpr uint32_t UB_SLOT = 0;                                  // 槽区：ITERS × 256B = 16KB
constexpr uint32_t UB_OUT = UB_SLOT + SLOT_REGS * SLOT_B;        // 输出区：ITERS × 256B = 16KB
constexpr uint32_t UB_MID = UB_OUT + SLOT_REGS * SLOT_B;         // MID 变体的无关 scratch 256B
constexpr uint32_t UB_BACKLOG = UB_MID + SLOT_B;                 // BACKLOG 变体的大块 scratch
constexpr uint32_t BACKLOG_B = 16 * 1024;                        // 每条 backlog DMA 16KB
constexpr uint32_t UB_END = UB_BACKLOG + BACKLOG_B;
static_assert(UB_END <= 190 * 1024, "UB footprint too large");

constexpr AscendC::MutexID BUF_SLOT = 0;    // 槽：生产者 → V
constexpr AscendC::MutexID BUF_OUT = 1;     // 输出：V → MTE3

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
// RLS_NONBLOCK(bool) 即 rls_buf 的 mode 位：false=BLOCK 阻塞释放（CANN ASC_LOCK_BLOCK 默认，本仓现用）；
// true=ASC_LOCK_NON_BLOCK（本仓不使用）。两种模式都等本 pipe 已发射指令落地，true 额外等同 id 释放。
template <pipe_t pipe, bool RLS_NONBLOCK>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, RLS_NONBLOCK>(id);
}
template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

class LdStHandoverProbe {
public:
    __aicore__ inline void Init(GM_ADDR val, GM_ADDR out, GM_ADDR outDump, GM_ADDR big)
    {
        valGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(val),
                               static_cast<uint64_t>(ITERS) * VL);
        bigGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(big), BACKLOG_B / 4);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out),
                               static_cast<uint64_t>(ITERS) * VL);
        dumpGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outDump),
                                static_cast<uint64_t>(UB_END / 4));
    }

    __aicore__ inline void Process()
    {
        PlantPoison();
        SlotLoop();
        DumpBack();
    }

private:
    // ---- 0. 用 V 把整段槽区写成 POISON（确定性初值；V→V 靠 LocalMemBar 保证可见）----
    __aicore__ inline void PlantPoison()
    {
        BufAcquire<PIPE_V>(BUF_SLOT);
        __ubuf__ float* slotP = reinterpret_cast<__ubuf__ float*>(UB_SLOT);
        __VEC_SCOPE__
        {
            RegTensor<float> p;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(p, POISON);
            for (uint16_t i = 0; i < static_cast<uint16_t>(SLOT_REGS); ++i) {
                StoreAlign(slotP + i * VL, p, full);
            }
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRelease<PIPE_V, false>(BUF_SLOT);
    }

    __aicore__ inline uint32_t SlotOff(uint16_t k) const
    {
#if PROBE_B_LAYOUT == 1
        return UB_SLOT + static_cast<uint32_t>(k) * SLOT_B;   // 每 chunk 独立槽
#else
        (void)k;
        return UB_SLOT;                                       // 所有 chunk 复用一槽
#endif
    }

    __aicore__ inline void SlotLoop()
    {
        __ubuf__ float* outP = reinterpret_cast<__ubuf__ float*>(UB_OUT);
        __ubuf__ float* midP = reinterpret_cast<__ubuf__ float*>(UB_MID);

        BufAcquire<PIPE_V>(BUF_OUT);   // 输出缓冲在整个循环里由 V 持有
        for (uint16_t k = 0; k < static_cast<uint16_t>(ITERS); ++k) {
            const uint32_t off = SlotOff(k);

#if PROBE_B_PROD != 1
            // ---- 生产者 = MTE2（PROD=2 时只握手、不写）----
            BufAcquire<PIPE_MTE2>(BUF_SLOT);
#if PROBE_B_BACKLOG == 1
            // 在槽写之前塞一条 16KB 大 DMA 到无关 scratch：MTE2 队列里有真实在飞工作
            DataCopy(MkT<float>(UB_BACKLOG, BACKLOG_B / 4), bigGm_[0], BACKLOG_B / 4);
#endif
  #if PROBE_B_PROD == 0
    #if PROBE_B_GRAN == 0
            DataCopy(MkT<float>(off, VL), valGm_[static_cast<uint64_t>(k) * VL], VL);        // 256B
    #elif PROBE_B_GRAN == 1
            DataCopy(MkT<float>(off, 8), valGm_[static_cast<uint64_t>(k) * VL], 8);          // 32B
    #else
            DataCopyPad(MkT<float>(off, 1), valGm_[static_cast<uint64_t>(k) * VL],
                        DataCopyExtParams{1, sizeof(float), 0, 0, 0},
                        DataCopyPadExtParams<float>{false, 0, 0, 0});                        // 4B
    #endif
  #endif
#if PROBE_B_PROD == 3
            // 判读器自检：生产者故意写**上一个 chunk** 的值 ⇒ 分类器必须报 63 个 stale_prev
            DataCopy(MkT<float>(off, VL),
                     valGm_[static_cast<uint64_t>(k == 0 ? 0 : k - 1) * VL], VL);
#endif
  #if PROBE_B_REL == 2
            AscendC::PipeBarrier<PIPE_MTE2>();
  #endif
            // 全项目裁定：release 侧一律 false = CANN ASC_LOCK_BLOCK（默认，阻塞）。
            // 曾经的 PROBE_B_REL 双档已按全项目 all-false 政策移除（本臂恒 false）。
            BufRelease<PIPE_MTE2, false>(BUF_SLOT);
#endif

            // ---- 消费者 = V ----
            BufAcquire<PIPE_V>(BUF_SLOT);
            __ubuf__ float* slotP = reinterpret_cast<__ubuf__ float*>(off) + PROBE_B_OFF;
#if PROBE_B_PROD == 1
            const float chunkVal = V_BASE + static_cast<float>(k);
            __VEC_SCOPE__
            {
                RegTensor<float> p;
                MaskReg full = CreateMask<float, MaskPattern::ALL>();
                Duplicate(p, chunkVal);
                StoreAlign(slotP - PROBE_B_OFF, p, full);
                LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            }
#endif
            __VEC_SCOPE__
            {
                RegTensor<float> v;
                MaskReg full = CreateMask<float, MaskPattern::ALL>();
#if PROBE_B_MID == 1
                // 中间 V 操作：对无关 32B scratch 做一次真实的 store→load（改变 V 侧时序）
                RegTensor<float> t;
                Duplicate(t, 1.0f);
                StoreAlign(midP, t, full);
                LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
                LoadAlign(t, midP);
#endif
#if PROBE_B_READ == 3
                LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
#endif
#if PROBE_B_READ == 0 || PROBE_B_READ == 3
                LoadAlign<float, LoadDist::DIST_BRC_B32>(v, slotP);
#elif PROBE_B_READ == 1
                LoadAlign(v, slotP);                       // 全宽 DIST_NORM（32B 对齐）
#else
                float s = MkT<float>(off, VL).GetValue(0);  // 标量读 UB
                Duplicate(v, s);
#endif
                StoreAlign(outP + static_cast<uint32_t>(k) * VL, v, full);
            }
            // 全项目裁定：release 侧一律 false；曾经的 PROBE_B_VREL 双档已按 all-false 政策移除。
            BufRelease<PIPE_V, false>(BUF_SLOT);
        }
        BufRelease<PIPE_V, false>(BUF_OUT);
    }

    // ---- 2. 输出区搬回 GM（判读用）+ 整段 UB（槽区 + 输出区 + MID scratch）原样 dump ----
    __aicore__ inline void DumpBack()
    {
        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(outGm_[0], MkT<float>(UB_OUT, ITERS * VL), ITERS * VL);
        BufRelease<PIPE_MTE3, false>(BUF_OUT);

        BufAcquire<PIPE_MTE3>(BUF_SLOT);
        DataCopy(dumpGm_[0], MkT<float>(UB_SLOT, UB_END / 4), UB_END / 4);
        BufRelease<PIPE_MTE3, false>(BUF_SLOT);
    }

    GlobalTensor<float> valGm_;
    GlobalTensor<float> outGm_;
    GlobalTensor<float> dumpGm_;
    GlobalTensor<float> bigGm_;
};

}   // namespace

__vector__ __global__ void probe_b_ldst_kernel(GM_ADDR val, GM_ADDR out, GM_ADDR outDump,
                                              GM_ADDR big)
{
    LdStHandoverProbe op;
    op.Init(val, out, outDump, big);
    op.Process();
}

namespace {
const char* RelName()
{
    // 全项目裁定：release 侧一律 false（= CANN ASC_LOCK_BLOCK 默认、阻塞）。历史档位键仅作标签。
#if PROBE_B_REL == 0
    return "BLOCK(mode=false)";
#elif PROBE_B_REL == 1
    return "BLOCK(mode=false; 原 NON_BLOCK 档已按 all-false 政策统一)";
#else
    return "BLOCK(mode=false)+PipeBarrier<MTE2>";
#endif
}
const char* ReadName()
{
#if PROBE_B_READ == 0
    return "LoadAlign<DIST_BRC_B32>";
#elif PROBE_B_READ == 1
    return "LoadAlign<DIST_NORM>(full)";
#elif PROBE_B_READ == 2
    return "LocalTensor::GetValue";
#else
    return "LocalMemBar + DIST_BRC_B32";
#endif
}
}   // namespace

int main(int argc, char** argv)
{
    const char* dumpDir = (argc >= 2) ? argv[1] : nullptr;
    const uint32_t procIdx = (argc >= 3) ? static_cast<uint32_t>(std::atoi(argv[2])) : 0;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t n = static_cast<size_t>(ITERS) * VL;
    const size_t bytes = n * sizeof(float);
    const size_t dumpBytes = static_cast<size_t>(UB_END);

    const size_t bigBytes = static_cast<size_t>(BACKLOG_B);
    float* valHost = new float[n];
    float* outHost = new float[n];
    float* dumpHost = new float[UB_END / 4];
    float* bigHost = new float[BACKLOG_B / 4];
    for (uint32_t k = 0; k < ITERS; ++k) {
        for (uint32_t i = 0; i < VL; ++i) {
            valHost[k * VL + i] = V_BASE + static_cast<float>(k);
        }
    }
    for (uint32_t i = 0; i < BACKLOG_B / 4; ++i) {
        bigHost[i] = 7.0f;
    }
    void* valDev = nullptr;
    void* outDev = nullptr;
    void* dumpDev = nullptr;
    void* bigDev = nullptr;
    aclrtMalloc(&valDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&outDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dumpDev, dumpBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&bigDev, bigBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(valDev, bytes, valHost, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bigDev, bigBytes, bigHost, bigBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    std::printf("[probe B] %s\n", PROBE_B_STR(PROBE_B_TAG));
    std::printf("[probe B]   rel=%s  read=%s  gran=%d  mid=%d  layout=%d  prod=%d  off=%d  vrel=%d  backlog=%d\n",
                RelName(), ReadName(), PROBE_B_GRAN, PROBE_B_MID, PROBE_B_LAYOUT, PROBE_B_PROD,
                PROBE_B_OFF, PROBE_B_VREL, PROBE_B_BACKLOG);
    std::printf("[probe B]   iters=%u VL=%u  一次 launch 只跑一种配置  proc=%u\n", ITERS, VL, procIdx);

    aclrtMemset(outDev, bytes, 0, bytes);
    aclrtMemset(dumpDev, dumpBytes, 0, dumpBytes);
    probe_b_ldst_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(valDev),
                                          reinterpret_cast<uint8_t*>(outDev),
                                          reinterpret_cast<uint8_t*>(dumpDev),
                                          reinterpret_cast<uint8_t*>(bigDev));
    const aclError e = aclrtSynchronizeStream(stream);
    if (e != ACL_SUCCESS) {
        std::printf("[probe B] 运行失败 aclError=%d\n", static_cast<int>(e));
        return 2;
    }
    aclrtMemcpy(outHost, bytes, outDev, bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(dumpHost, dumpBytes, dumpDev, dumpBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    // ---- 判读（T1：逐字节）----
    uint32_t ok = 0, stalePrev = 0, poison = 0, other = 0, zero = 0, ahead = 0;
    uint32_t firstBadK = ITERS, laneBad = 0, laneTotal = 0;
    float firstBadGot = 0.0f;
    char classify[ITERS + 1];
    for (uint32_t k = 0; k < ITERS; ++k) {
        const float want = V_BASE + static_cast<float>(k);
        const float got = outHost[k * VL];
        if (got == want) {
            ++ok;
            classify[k] = '.';
        } else if (got == want - 1.0f) {
            ++stalePrev;                    // 读到上一个 chunk 的值 = 最典型的"旧值"
            classify[k] = 'p';
        } else if (got == want + 1.0f) {
            ++ahead;                        // 读到下一个 chunk 的值 = 生产者抢跑覆盖
            classify[k] = 'n';
        } else if (got == POISON) {
            ++poison;                       // 从未被写过
            classify[k] = 'X';
        } else if (got == 0.0f) {
            ++zero;                         // M36 的症状：广播读到 0（out=h）
            classify[k] = 'z';
        } else {
            ++other;
            classify[k] = '?';
        }
        if (got != want && firstBadK == ITERS) {
            firstBadK = k;
            firstBadGot = got;
        }
        for (uint32_t i = 0; i < VL; ++i) {
            const bool wantLane = (outHost[k * VL + i] == want);
#if PROBE_B_READ == 1
            // 全宽读：整个 VL 都应当来自槽；GRAN<256 时槽尾是上一 chunk 的旧数据，判据仍是 want
            if (!wantLane) ++laneBad;
#else
            if (!wantLane) ++laneBad;
#endif
            ++laneTotal;
        }
    }
    classify[ITERS] = '\0';

    std::printf("[probe B] chunk 判读(.=ok p=读到上一chunk n=读到下一chunk X=poison z=读到0 ?=其它): %s\n",
                classify);
    std::printf("[probe B] chunk: ok=%u stale_prev=%u ahead=%u poison=%u zero=%u other=%u / %u\n", ok,
                stalePrev, ahead, poison, zero, other, ITERS);
    std::printf("[probe B] lane0 不符点数=%u  全 lane 不符=%u/%u\n", ITERS - ok, laneBad, laneTotal);
    if (firstBadK != ITERS) {
        std::printf("[probe B] 首个不符 chunk=%u 得到 %g 期望 %g\n", firstBadK,
                    static_cast<double>(firstBadGot), static_cast<double>(V_BASE + firstBadK));
    }
#if PROBE_B_PROD == 2
    // 非空洞性对照：生产者关闭 ⇒ 槽里应恒为 POISON；读到别的值反而说明判读/寻址有问题
    const bool pass = (poison == ITERS);
    std::printf("[probe B] %s %s（非空洞性对照：期望 %u/%u 全为 POISON）\n",
                PROBE_B_STR(PROBE_B_TAG), pass ? "RUN PASS" : "RUN FAIL", ITERS, ITERS);
#else
    const bool pass = (ok == ITERS);
    std::printf("[probe B] %s %s\n", PROBE_B_STR(PROBE_B_TAG), pass ? "RUN PASS" : "RUN FAIL");
#endif

    if (dumpDir != nullptr) {
        char path[512];
        std::snprintf(path, sizeof(path), "%s/b_%s_p%u_out.bin", dumpDir, PROBE_B_STR(PROBE_B_TAG),
                      procIdx);
        FILE* f = std::fopen(path, "wb");
        if (f != nullptr) {
            std::fwrite(outHost, 1, bytes, f);
            std::fclose(f);
        }
        std::snprintf(path, sizeof(path), "%s/b_%s_p%u_ub.bin", dumpDir, PROBE_B_STR(PROBE_B_TAG),
                      procIdx);
        f = std::fopen(path, "wb");
        if (f != nullptr) {
            std::fwrite(dumpHost, 1, dumpBytes, f);
            std::fclose(f);
        }
    }

    aclrtFree(valDev);
    aclrtFree(outDev);
    aclrtFree(dumpDev);
    aclrtFree(bigDev);
    delete[] valHost;
    delete[] outHost;
    delete[] dumpHost;
    delete[] bigHost;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return pass ? 0 : 1;
}
