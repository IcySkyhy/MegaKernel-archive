/**
 * m13_moe_layer.asc —— Mega kernel M21：MoE block layer kernel 骨架
 * （设计：docs/12-layer-integration.md + docs/05-megakernel-design.md §2/§5/§6）
 *
 * 单一 __mix__(1,2) 启动内跑完整 MoE block 段序 S1-S10：
 *
 *   S1  m6#1   Add+RMSNorm（x_res + res → x_norm bf16, resOut fp32）      [AIV, 行切分]
 *   S2  m7     router：GEMV logits → softmax(max-shift) → top-k 降序 → renorm
 *              （同一 AIV0 段内顺带算共享专家 sigmoid 门 sgate[m]）        [AIV0]
 *   S3  new    routing 索引生成：计数排序 → perm_src/perm_expert/counts/
 *              offsets/inv_slot/w_tk_packed（m7↔m8 之间的缺口 glue）       [AIV0]
 *   S4  m8#1   permute：x_sorted[i] = x[perm_src[i]]（四级流水 gather）    [AIV, 行切分]
 *   S5  m2/m5  A 侧 MXFP4 全 VEC 量化：x_sorted → A_qx + A_scale，
 *              共享专家激活 x → A_qx_shd + A_scale_shd                   [AIV, 行切分]
 *   S6  m3     grouped gate_up GEMM（5 槽位 = 4 routed + 1 shared，K=2560 N=1280）[AIC]
 *   S7  m5     SwiGLU + MXFP4 全 VEC 量化：GU → H_qx + H_scale（共享同款） [AIV, 行切分]
 *   S8  m3     grouped down GEMM（5 槽位，K=640 N=2560）→ Y / Y_shd       [AIC]
 *   S9  m8#2   unpermute 加权折叠 → routed_out；shared*sgate → shared_out；
 *              moe_out = routed + shared                                  [AIV, 行切分]
 *   S10 m6#2   Add+RMSNorm（moe_out + res1(fp32) → y, resOut2 fp32）       [AIV, 行切分]
 *
 * 段边界跨核同步（docs/12 §5 标准 mix 序列）：
 *   AIV→AIC：AIV set mode2(PIPE_MTE3 drain) → AIC wait mode2(PIPE_S) →
 *            AIC set mode0(PIPE_MTE2) + wait mode0(PIPE_S)（全体 AIC 对齐）
 *   AIC→AIV：AIC set mode0(PIPE_FIX drain) + wait mode0(PIPE_S) →
 *            AIC set mode2(PIPE_MTE2) → AIV wait mode2(narrow pipe，需标量值
 *            依赖的段用 PIPE_S)
 *   段内 AIV↔AIV 交接：全体 AIV mode0 barrier（m0 实证 56 AIV 可用）
 *   set 一律挂生产 pipe（FIX/MTE3），wait 窄 pipe；相邻同步点 flagId 走旋转槽。
 *
 * 算件代码来源（均为「复制改造」，不改动原目录）：
 *   S1/S10  m6_rmsnorm（含 NormDonor 二分 fold reduce + NR rsqrt 逐字 lift）
 *   S2      m7_router_topk（GEMV 向量 MAC + Sort32 排序 + top-k 拆分/renorm 位打包；
 *           `Extract` 已按厂商 VF 形态内联，`Sort32` 属 docs/05 §6.1 ⓒ 裁定例外）
 *   S4/S9   m8_permute（permute 四级流水 / unpermute 寄存器加权折叠）
 *   S5/S7   m5_swiglu_quant（SwiGLU 五元组 + MxQuant 三段式，全 VEC、无 PIPE_S）
 *   S6/S8   m3_grouped_gemm（MXFP4GemmItem：Nd2Nz/Dn2Nz → LoadData2D(Mx) →
 *           MmadMx → Fixpipe F322BF16），量化器换成 m5 全 VEC 路径（小改 C）
 *
 * 小改清单（docs/12 §6）落实：
 *   A. 元素计数 DataCopy 重载 → 一律显式 DataCopyParams/DataCopyExtParams{1,len,0,0}
 *   B. 行循环 MTE2 背靠背复用同一 UB buffer → 补 PipeBarrier<PIPE_MTE2>
 *   C. m3-AIV 标量量化器（PIPE_S）→ m5 全 VEC 量化路径（S5/S7 无 PIPE_S 挂载）
 *   D. m6 残差输入支持 fp32（S10 消费 S1 的 fp32 resOut）
 *   E. 索引读改 MTE2/标量 UB 批量（本骨架：索引数组仍按 m8 协议的标量 GM 读，
 *      w_tk_packed 协议保留；见 README「已知限制」）
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstring>
#include <cstdlib>
#include <cmath>

#include "m13_resources.h"

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M13;

// ============================================================
// 通用：pipe_t 常量（BufferID 同步封装）
// ============================================================

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);   // acquire 立即获取
}

template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);    // 阻塞释放（mode=false = CANN ASC_LOCK_BLOCK 默认）
}

template <pipe_t pipe>
__aicore__ inline void MutexLock(AscendC::MutexID id)
{
    AscendC::Mutex::Lock<pipe>(id);
}

template <pipe_t pipe>
__aicore__ inline void MutexUnlock(AscendC::MutexID id)
{
    AscendC::Mutex::Unlock<pipe>(id);
}

// 显式块拷贝参数（小改 A：杜绝元素计数重载）
//   注意 DataCopyParams.blockLen 单位是 **32B 块**（CANN: blockLen = count / GetC0Count(sizeof(T))），
//   故入参统一为**字节数**，内部 /32 换算：bf16 行 HIDDEN → Block1(HIDDEN*2) = {1,160,0,0}；
//   fp32 resOut 行 → Block1(HIDDEN*4) = {1,320,0,0}；WROW_I32 → Block1(WROW_I32*4) = {1,2,0,0}。
__aicore__ inline AscendC::DataCopyParams Block1(uint32_t bytes)
{
    // 前置条件：bytes 必须是 32B 整数倍（当前 22 个点位全部整除）。非整数倍会静默少搬，
    // 必须改走 DataCopyPad —— 这里留防呆：违反时 Trap（device 报 aicore exception，便于定位）。
    if ((bytes & 31u) != 0u) {
        AscendC::Trap();
    }
    return AscendC::DataCopyParams{1, static_cast<uint16_t>(bytes / 32), 0, 0};
}

__aicore__ inline AscendC::DataCopyExtParams ExtBlock1(uint32_t bytes)
{
    return AscendC::DataCopyExtParams{1, bytes, 0, 0, 0};
}

// ============================================================
// 通用：bf16 / fp32 位运算与 cast trait
// ============================================================

__aicore__ inline float Bf16ToF32Bits(uint32_t bitsLow16)
{
    uint32_t x = bitsLow16 << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

constexpr Reg::CastTrait castTraitB162B32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                            RoundMode::UNKNOWN};
constexpr Reg::CastTrait castTraitB322B16 = {RegLayout::ZERO, SatMode::NO_SAT, MaskMergeMode::ZEROING,
                                            RoundMode::CAST_RINT};
constexpr Reg::CastTrait castTraitRM_Round = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                             RoundMode::CAST_ROUND};


// ============================================================
// AIC：grouped MXFP4 GEMM 单 work item（m3_grouped_gemm 的 MXFP4GemmItem 逐行 lift）
//   K/N 编译期常量；A_SCAL_STRIDE = A 侧 scale 行距（字节）
// ============================================================

template <uint32_t K, uint32_t N, uint32_t A_SCAL_STRIDE>
class MXFP4GemmItem {
    static constexpr uint32_t PACKED_K = K / 2;
    static constexpr uint32_t SCALE_K = K / GROUP;
    static_assert(K % BASE_K == 0, "K must be divisible by BASE_K");
    static_assert(N % BASE_N == 0, "N must be divisible by BASE_N");

public:
    __aicore__ inline MXFP4GemmItem() {}

    // 每个 work item 调用：设置该槽位的 GM 基址（每对象只 Set 一次：本 item 是常驻成员）
    __aicore__ inline void SetItem(__gm__ uint8_t* a, __gm__ uint8_t* as, __gm__ uint8_t* b, __gm__ uint8_t* bs,
                                   __gm__ uint8_t* c)
    {
        aGM.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)a);
        asGM.SetGlobalBuffer((__gm__ fp8_e8m0_t*)as);
        bGM.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)b);
        bsGM.SetGlobalBuffer((__gm__ fp8_e8m0_t*)bs);
        cGM.SetGlobalBuffer((__gm__ bfloat16_t*)c);
    }

    // 计算一个 (nBlock, curM) tile：k 循环累加 L0C → Fixpipe 写 GM
    __aicore__ inline void Run(uint32_t nBlock, uint32_t curM)
    {
        const uint32_t curMAlign = ((curM + CUBE_BLOCK - 1) / CUBE_BLOCK) * CUBE_BLOCK;
        // 3510 quirk（同 m1）：Nd2Nz/Dn2Nz 行数=1 退化，计算侧提升为 >=2 行，仅 Fixpipe 按 curM 写出
        const uint32_t calcM = curM < 2 ? 2 : curM;
        const uint32_t kLoop = K / BASE_K;

        AscendC::LocalTensor<fp4x2_e2m1_t> a1Ping(AscendC::TPosition::A1, L1_OFF_A0, L1_A_DATA);
        AscendC::LocalTensor<fp4x2_e2m1_t> a1Pong(AscendC::TPosition::A1, L1_OFF_A1, L1_A_DATA);
        AscendC::LocalTensor<fp8_e8m0_t> as1Ping(AscendC::TPosition::A1, L1_OFF_AS0, L1_A_SCAL);
        AscendC::LocalTensor<fp8_e8m0_t> as1Pong(AscendC::TPosition::A1, L1_OFF_AS1, L1_A_SCAL);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Ping(AscendC::TPosition::B1, L1_OFF_B0, L1_B_DATA);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Pong(AscendC::TPosition::B1, L1_OFF_B1, L1_B_DATA);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Ping(AscendC::TPosition::B1, L1_OFF_BS0, L1_B_SCAL);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Pong(AscendC::TPosition::B1, L1_OFF_BS1, L1_B_SCAL);
        AscendC::LocalTensor<fp4x2_e2m1_t> a2Ping(AscendC::TPosition::A2, L0_OFF_0, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> a2Pong(AscendC::TPosition::A2, L0_OFF_1, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Ping(AscendC::TPosition::B2, L0_OFF_0, BASE_K * BASE_N / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Pong(AscendC::TPosition::B2, L0_OFF_1, BASE_K * BASE_N / 2);
        AscendC::LocalTensor<float> cL0C(AscendC::TPosition::CO1, 0, BASE_M * BASE_N);

        MutexLock<PIPE_M>(BUF_AIC_L0C);   // 挡住上一 item 的 Fixpipe 读，允许本 tile 累加
        for (uint32_t kBlock = 0; kBlock < kLoop; ++kBlock) {
            const uint32_t p = kBlock & 1;
            const AscendC::MutexID bufA = p ? BUF_AIC_A1 : BUF_AIC_A0;
            const AscendC::MutexID bufB = p ? BUF_AIC_B1 : BUF_AIC_B0;
            const AscendC::MutexID bufL0 = p ? BUF_AIC_L01 : BUF_AIC_L00;
            AscendC::LocalTensor<fp4x2_e2m1_t> a1 = p ? a1Pong : a1Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> b1 = p ? b1Pong : b1Ping;
            AscendC::LocalTensor<fp8_e8m0_t> as1 = p ? as1Pong : as1Ping;
            AscendC::LocalTensor<fp8_e8m0_t> bs1 = p ? bs1Pong : bs1Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> a2 = p ? a2Pong : a2Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> b2 = p ? b2Pong : b2Ping;

            MutexLock<PIPE_MTE2>(bufA);
            CopyInA(a1, as1, kBlock, calcM);
            MutexUnlock<PIPE_MTE2>(bufA);
            MutexLock<PIPE_MTE2>(bufB);
            CopyInB(b1, bs1, kBlock, nBlock);
            MutexUnlock<PIPE_MTE2>(bufB);

            MutexLock<PIPE_MTE1>(bufL0);
            MutexLock<PIPE_MTE1>(bufA);
            MutexLock<PIPE_MTE1>(bufB);
            LoadA(a1, as1, a2, curMAlign);
            LoadB(b1, bs1, b2);
            MutexUnlock<PIPE_MTE1>(bufA);
            MutexUnlock<PIPE_MTE1>(bufB);
            MutexUnlock<PIPE_MTE1>(bufL0);

            MutexLock<PIPE_M>(bufL0);
            AscendC::MmadParams mmadParams;
            mmadParams.m = calcM;
            mmadParams.n = BASE_N;
            mmadParams.k = BASE_K;
            mmadParams.cmatrixInitVal = (kBlock == 0);
            AscendC::MmadMx(cL0C, a2, b2, mmadParams);
            MutexUnlock<PIPE_M>(bufL0);
        }
        MutexUnlock<PIPE_M>(BUF_AIC_L0C);   // L0C 累加结果就绪
        MutexLock<PIPE_FIX>(BUF_AIC_L0C);
        CopyOut(cL0C, nBlock, curM, curMAlign);
        MutexUnlock<PIPE_FIX>(BUF_AIC_L0C);
    }

private:
    // GM → L1：A 的一个 baseK 大包（calcM 行 × BASE_K fp4）+ scale（Dn2Nz，b16 视图）
    __aicore__ inline void CopyInA(AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
                                  uint32_t kBlock, uint32_t curM)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = curM;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_M;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, aGM[kBlock * BASE_K], par);   // 偏移按 fp4 元素（4bit）计

        constexpr uint32_t stepScaleK = BASE_K / GROUP;
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = curM;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = A_SCAL_STRIDE / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> asGMB16;
        asGMB16.SetGlobalBuffer(((__gm__ half*)asGM.GetPhyAddr()) + scaleOffHalf, curM * (A_SCAL_STRIDE / 2));
        AscendC::DataCopy(as1.ReinterpretCast<half>(), asGMB16, sp);
    }

    // GM → L1：B 按 [N, K] 原始 layout 搬 baseN 行 × BASE_K fp4 + scale
    __aicore__ inline void CopyInB(AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
                                  uint32_t kBlock, uint32_t nBlock)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = BASE_N;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_N;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, bGM[kBlock * BASE_K + nBlock * BASE_N * K], par);

        constexpr uint32_t stepScaleK = BASE_K / GROUP;
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = BASE_N;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = SCALE_K / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (nBlock * BASE_N * SCALE_K + kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> bsGMB16;
        bsGMB16.SetGlobalBuffer(((__gm__ half*)bsGM.GetPhyAddr()) + scaleOffHalf, BASE_N * (SCALE_K / 2));
        AscendC::DataCopy(bs1.ReinterpretCast<half>(), bsGMB16, sp);
    }

    __aicore__ inline void LoadA(AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
                                AscendC::LocalTensor<fp4x2_e2m1_t>& a2, uint32_t curMAlign)
    {
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = curMAlign / CUBE_BLOCK;
        lp.kStep = BASE_K / 64;
        lp.srcStride = BASE_M / CUBE_BLOCK;
        lp.dstStride = curMAlign / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = curMAlign / CUBE_BLOCK;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(a2, a1[0], as1[0], lp, mx);
    }

    __aicore__ inline void LoadB(AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
                                AscendC::LocalTensor<fp4x2_e2m1_t>& b2)
    {
        constexpr uint32_t nFracs = BASE_N / CUBE_BLOCK;
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = nFracs;
        lp.kStep = BASE_K / 64;
        lp.srcStride = BASE_N / CUBE_BLOCK;
        lp.dstStride = nFracs;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = nFracs;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(b2, b1[0], bs1[0], lp, mx);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<float>& cL0C, uint32_t nBlock, uint32_t curM,
                                  uint32_t curMAlign)
    {
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp;
        fp.nSize = BASE_N;
        fp.mSize = curM;
        fp.srcStride = curMAlign;
        fp.dstStride = N;
        fp.quantPre = QuantMode_t::F322BF16;
        AscendC::Fixpipe(cGM[nBlock * BASE_N], cL0C, fp);
    }

private:
    AscendC::GlobalTensor<fp4x2_e2m1_t> aGM;
    AscendC::GlobalTensor<fp8_e8m0_t> asGM;
    AscendC::GlobalTensor<fp4x2_e2m1_t> bGM;
    AscendC::GlobalTensor<fp8_e8m0_t> bsGM;
    AscendC::GlobalTensor<bfloat16_t> cGM;
};

}  // namespace
// ============================================================
// S1/S10：Add + RMSNorm 段（m6_rmsnorm 移植；小改 D：残差输入支持 fp32）
//   ① xAdd = f32(x) + [f32(res) | res fp32] → xFp32
//   ② resOut(fp32) = xAdd      ③ rstd = 1/sqrt(mean+eps)   ④ y = bf16(xAdd·rstd·gamma)
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M13;

constexpr uint32_t VL_F32 = 64;                 // 256B 向量寄存器 fp32 lane 数
constexpr uint16_t CHUNKS_H = HIDDEN / VL_F32;  // 每行 64-lane chunk 数 = 40
constexpr float RMS_EPS = 1e-6f;
constexpr float RMS_AVG_FACTOR = 1.0f / static_cast<float>(HIDDEN);
constexpr uint32_t FOLD_POINT = 1280;           // 二分 fold 点（m6 donor tiling binAddQuotient）
constexpr uint32_t REDUCE_TMP_STRIDE = 24;      // ceil(foldLoops(20)/BLK_B32(8))*8

// ---- donorn（ops-nn norm/norm_common/op_kernel/reduce_common_regbase*.h，m6 逐字 lift）----
namespace NormDonor {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t V_LENGTH = VL_F32;
constexpr uint16_t DICHOTOMY_ADD_COEFF = 2;

constexpr AscendC::Reg::CastTrait castTraitB162B32 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::UNKNOWN,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::UNKNOWN};
constexpr AscendC::Reg::CastTrait castTraitB322B16 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::NO_SAT,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::CAST_RINT};

template <typename T, LoadDist FLOAT_LOAD_DIST = LoadDist::DIST_NORM,
          LoadDist NON_FLOAT_LOAD_DIST = LoadDist::DIST_UNPACK_B16>
__aicore__ inline void LoadRegForDtype(__ubuf__ T* src, RegTensor<float>& dst, MaskReg& preg, uint32_t offset)
{
    if constexpr (IsSameType<T, float>::value) {
        LoadAlign<T, FLOAT_LOAD_DIST>(dst, src + offset);
    } else {
        RegTensor<T> srcReg;
        LoadAlign<T, NON_FLOAT_LOAD_DIST>(srcReg, src + offset);
        Cast<float, T, castTraitB162B32>(dst, srcReg, preg);
    }
}

template <typename T, int32_t LAST_LOOP_NUMS>
__aicore__ inline void CalculateSquareReduceSumCommon(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                      __ubuf__ float* tmpPtr, uint16_t rows, uint32_t rowStride,
                                                      uint32_t reduceNum, uint32_t foldPoint, uint32_t tmpStride)
{
    uint16_t foldLoops = static_cast<uint16_t>((foldPoint + V_LENGTH - 1) / V_LENGTH);
    uint32_t lastNum = foldPoint / V_LENGTH;
    uint32_t tail = (reduceNum > foldPoint) ? reduceNum - foldPoint : 0;
    uint16_t tailCeilLoops = static_cast<uint16_t>((tail + V_LENGTH - 1) / V_LENGTH);
    uint16_t firstFlodWithOutAddLoops = static_cast<uint16_t>(foldLoops - tailCeilLoops);
    (void)firstFlodWithOutAddLoops;

    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> xFoldReg;
        RegTensor<float> sumReg;
        RegTensor<float> reduceReg;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        MaskReg pregLoop;

        for (uint16_t i = 0; i < rows; ++i) {
            uint32_t baseOffset = static_cast<uint32_t>(i) * rowStride;
            uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
            uint32_t sregTail = tail;
            for (uint16_t j = 0; j < tailCeilLoops; ++j) {
                pregLoop = UpdateMask<float>(sregTail);
                uint32_t offset = static_cast<uint32_t>(j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                LoadRegForDtype<T>(xPtr + foldPoint, xFoldReg, pregFull, offset);
                Mul(xFoldReg, xFoldReg, xFoldReg, pregLoop);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + j, reduceReg, pregOne);
            }
            for (uint16_t j = 0; j < firstFlodWithOutAddLoops; ++j) {
                uint32_t offset = static_cast<uint32_t>(tailCeilLoops + j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + tailCeilLoops + j,
                                                                     reduceReg, pregOne);
            }
        }
        LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        if constexpr (LAST_LOOP_NUMS == 1) {
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                LoadAlign<float>(xReg, tmpPtr + static_cast<uint32_t>(i) * tmpStride);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregLast);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        } else if constexpr (LAST_LOOP_NUMS == DICHOTOMY_ADD_COEFF) {
            lastNum -= V_LENGTH;
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
                LoadAlign<float>(xReg, tmpPtr + tmpOffset);
                LoadAlign<float>(xFoldReg, tmpPtr + tmpOffset + V_LENGTH);
                ShiftLefts((RegTensor<uint32_t>&)xFoldReg, (RegTensor<uint32_t>&)xFoldReg, static_cast<int16_t>(0),
                           pregLast);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        }
    }
}

template <typename T>
__aicore__ inline void CalculateSquareReduceSum(__ubuf__ T* xPtr, __ubuf__ float* dstPtr, __ubuf__ float* tmpPtr,
                                                uint16_t rows, uint32_t rowStride, uint32_t reduceNum,
                                                uint32_t foldPoint, uint32_t tmpStride)
{
    // 2560 = 2×1280 → 走 Common<1> 分支（与 m6 donor 调用一致）
    CalculateSquareReduceSumCommon<T, 1>(xPtr, dstPtr, tmpPtr, rows, rowStride, reduceNum, foldPoint, tmpStride);
}

template <bool NEED_MAX = true>
__aicore__ inline void ComputeRstdNewtonRaphsonReg(RegTensor<float>& var, RegTensor<float>& rstd, MaskReg& preg,
                                                   float epsilon)
{
    static constexpr float POS_INF = 3.40282366920938E+38;
    static constexpr float SCALAR1 = -0.5;
    static constexpr float SCALAR2 = 1.5;
    static constexpr float SCALAR3 = 0.5;
    static constexpr float SCALAR0 = -99.99;

    RegTensor<float> r;
    RegTensor<float> y;
    RegTensor<float> s;
    RegTensor<float> t;
    RegTensor<float> one;
    RegTensor<float> scalar1;
    RegTensor<float> t1;
    RegTensor<float> t3;
    RegTensor<float> t4;
    RegTensor<float> scalarInf;
    RegTensor<float> scalarZero;
    RegTensor<float> tmp;
    MaskReg cmpRegZero;
    MaskReg cmpRegInf;

    Duplicate(scalarInf, POS_INF, preg);
    Duplicate(scalarZero, float(0.0), preg);
    Duplicate(one, float(1.0), preg);
    Duplicate(scalar1, SCALAR3, preg);
    Duplicate(t1, SCALAR2, preg);
    Duplicate(s, float(1.0), preg);

    Adds(var, var, epsilon, preg);
    if constexpr (NEED_MAX) {
        Maxs(var, var, SCALAR0, preg);
    }
    Div(r, one, var, preg);
    Sqrt(y, r, preg);
    Muls(t, var, SCALAR1, preg);
    Mul(t, t, y, preg);
    Mul(tmp, t, y, preg);
    Add(t1, t1, tmp, preg);   // donor Mula
    Mul(rstd, y, t1, preg);
    Muls(t3, var, float(-1.0), preg);
    Mul(tmp, t3, r, preg);
    Add(s, s, tmp, preg);     // donor Mula
    Muls(t4, rstd, float(-1.0), preg);
    Mul(tmp, t4, rstd, preg);
    Add(r, r, tmp, preg);     // donor Mula
    Mul(tmp, var, r, preg);
    Add(s, s, tmp, preg);     // donor Mula
    Mul(s, s, rstd, preg);
    Mul(tmp, s, scalar1, preg);
    Add(rstd, rstd, tmp, preg);  // donor Mula
    Compares(cmpRegZero, var, POS_INF, preg);
    Select(rstd, scalarZero, rstd, cmpRegZero);
    Compares(cmpRegInf, var, float(0.0), preg);
    Select(rstd, scalarInf, rstd, cmpRegInf);
}

template <bool NEED_MAX = true, bool NEED_AVG_FACTOR = false>
__aicore__ inline void ComputeRstdNewtonRaphson(__ubuf__ float* src, __ubuf__ float* dst, uint32_t rowCount,
                                                float epsilon, float avgFactor, uint32_t vectorLen)
{
    uint16_t loopRows = static_cast<uint16_t>((rowCount + vectorLen - 1) / vectorLen);
    __VEC_SCOPE__
    {
        RegTensor<float> var;
        RegTensor<float> rstd;
        MaskReg pregLoop;

        uint32_t sreg = rowCount;
        for (uint16_t i = 0; i < loopRows; ++i) {
            pregLoop = UpdateMask<float>(sreg);
            LoadAlign<float>(var, src + i * vectorLen);
            if constexpr (NEED_AVG_FACTOR) {
                Muls(var, var, avgFactor, pregLoop);
            }
            ComputeRstdNewtonRaphsonReg<NEED_MAX>(var, rstd, pregLoop, epsilon);
            StoreAlign<float>(dst + i * vectorLen, rstd, pregLoop);
        }
    }
}

}  // namespace NormDonor

// ---- gamma bf16 → fp32 预转（每个 AIV 核一次；落在 UB_GAMMA1_F32 / UB_GAMMA2_F32）----
// m6 的 PrecomputeGammaF32 同款：整核只做一次，之后 S1/S10 每行少 40 次 Cast，
// 同时让 y 循环里每 chunk 只剩一次 fp32→bf16 Cast（规避 3510 连续 Cast quirk）。
__aicore__ inline void PrecastGammaF32(__gm__ uint8_t* gamma, uint32_t dstUbOff)
{
    AscendC::GlobalTensor<bfloat16_t> gGm;
    gGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(gamma), HIDDEN);
    LocalTensor<bfloat16_t> gbL(TPosition::VECCALC, UB_PERSIST, HIDDEN);

    BufAcquire<PIPE_MTE2>(BUF_AIV_GAMMA);
    PipeBarrier<PIPE_MTE2>();
    DataCopy(gbL, gGm, Block1(HIDDEN * 2));
    BufRelease<PIPE_MTE2>(BUF_AIV_GAMMA);

    __ubuf__ bfloat16_t* gbUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_PERSIST);
    __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(dstUbOff);
    BufAcquire<PIPE_V>(BUF_AIV_GAMMA);
    __VEC_SCOPE__
    {
        RegTensor<bfloat16_t> gB16;
        RegTensor<float> gF;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        for (uint16_t i = 0; i < CHUNKS_H; ++i) {
            uint32_t offset = static_cast<uint32_t>(i) * VL_F32;
            LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(gB16, gbUb + offset);
            Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(gF, gB16, maskAll);
            StoreAlign<float, StoreDist::DIST_NORM_B32>(gfUb + offset, gF, maskAll);
        }
    }
    BufRelease<PIPE_V>(BUF_AIV_GAMMA);
}

// ============================================================
// S1/S10：NormStage（行切分；RES_F32 = 残差输入 fp32）
// ============================================================

template <bool RES_F32>
class NormStage {
public:
    __aicore__ inline NormStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* res, __gm__ uint8_t* y, __gm__ uint8_t* resOut,
                                uint32_t gammaF32UbOff, uint32_t m)
    {
        M = m;
        gammaOff = gammaF32UbOff;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M_MAX) * HIDDEN);
        if constexpr (RES_F32) {
            resGmF.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(res), static_cast<uint64_t>(M_MAX) * HIDDEN);
        } else {
            resGmB.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(res), static_cast<uint64_t>(M_MAX) * HIDDEN);
        }
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(y), static_cast<uint64_t>(M_MAX) * HIDDEN);
        resOutGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(resOut), static_cast<uint64_t>(M_MAX) * HIDDEN);
    }

    // 行 r = bid + i*nAiv（行间无依赖）
    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        for (uint32_t row = bid; row < M; row += nAiv) {
            CopyInRow(row);
            ComputeRow();
            CopyOutRow(row);
        }
    }

private:
    __aicore__ inline void CopyInRow(uint32_t row)
    {
        LocalTensor<bfloat16_t> x1L(TPosition::VECCALC, UB_M6_X1, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0);   // 挡上一行的 V 消费
        PipeBarrier<PIPE_MTE2>();              // 小改 B：行循环同 pipe 复用同一 UB 行缓冲
        DataCopy(x1L, xGm[off], Block1(HIDDEN * 2));
        if constexpr (RES_F32) {
            LocalTensor<float> resL(TPosition::VECCALC, UB_M6_RES, HIDDEN);
            DataCopy(resL, resGmF[off], Block1(HIDDEN * 4));   // fp32 残差（小改 D）
        } else {
            LocalTensor<bfloat16_t> resL(TPosition::VECCALC, UB_M6_RES, HIDDEN);
            DataCopy(resL, resGmB[off], Block1(HIDDEN * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0);
    }

    // donor ①：残差加（fp32 寄存器）→ UB 留 xFp32（resOut fp32 直接由它 MTE3 写出）
    __aicore__ inline void CalculateXAdd(__ubuf__ bfloat16_t* x1Ub, __ubuf__ float* xfUb)
    {
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> x1B16;
            RegTensor<float> x1;
            RegTensor<float> x2;
            RegTensor<float> xSum;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < CHUNKS_H; ++i) {
                uint32_t offset = static_cast<uint32_t>(i) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(x1B16, x1Ub + offset);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(x1, x1B16, maskAll);
                if constexpr (RES_F32) {
                    LoadAlign<float>(x2, reinterpret_cast<__ubuf__ float*>(UB_M6_RES) + offset);
                } else {
                    RegTensor<bfloat16_t> x2B16;
                    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(
                        x2B16, reinterpret_cast<__ubuf__ bfloat16_t*>(UB_M6_RES) + offset);
                    Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(x2, x2B16, maskAll);
                }
                Add(xSum, x1, x2, maskAll);
                StoreAlign<float, StoreDist::DIST_NORM_B32>(xfUb + offset, xSum, maskAll);
            }
        }
    }

    // donor ④：y = (x·rstd)·gamma → bf16（gamma 已预转 fp32，每 chunk 仅一次 fp32→bf16 Cast）
    __aicore__ inline void CalculateY(__ubuf__ float* xfUb, __ubuf__ bfloat16_t* yUb, __ubuf__ float* rstdUb)
    {
        __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(gammaOff);
        __VEC_SCOPE__
        {
            RegTensor<float> xReg;
            RegTensor<float> gReg;
            RegTensor<float> rstdReg;
            RegTensor<float> tReg;
            RegTensor<float> yReg;
            RegTensor<bfloat16_t> yB16;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            LoadAlign<float, LoadDist::DIST_BRC_B32>(rstdReg, rstdUb);
            for (uint16_t i = 0; i < CHUNKS_H; ++i) {
                uint32_t offset = static_cast<uint32_t>(i) * VL_F32;
                LoadAlign<float>(xReg, xfUb + offset);
                LoadAlign<float>(gReg, gfUb + offset);
                Mul(tReg, xReg, rstdReg, maskAll);
                Mul(yReg, tReg, gReg, maskAll);
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yB16, yReg, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(yUb + offset, yB16, maskAll);
            }
        }
    }

    __aicore__ inline void ComputeRow()
    {
        LocalTensor<float> xfL(TPosition::VECCALC, UB_M6_XF, HIDDEN);
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_M6_Y, HIDDEN);
        LocalTensor<float> tmpL(TPosition::VECCALC, UB_M6_TMP, 64);
        LocalTensor<float> redL(TPosition::VECCALC, UB_M6_RED, 64);
        LocalTensor<float> rstdL(TPosition::VECCALC, UB_M6_RSTD, 64);
        __ubuf__ bfloat16_t* x1Ub = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_M6_X1);
        __ubuf__ float* xfUb = reinterpret_cast<__ubuf__ float*>(xfL.GetPhyAddr());
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(yL.GetPhyAddr());
        __ubuf__ float* tmpUb = reinterpret_cast<__ubuf__ float*>(tmpL.GetPhyAddr());
        __ubuf__ float* redUb = reinterpret_cast<__ubuf__ float*>(redL.GetPhyAddr());
        __ubuf__ float* rstdUb = reinterpret_cast<__ubuf__ float*>(rstdL.GetPhyAddr());

        BufAcquire<PIPE_V>(BUF_AIV_ROW0);    // 等 x/res 行就位
        BufAcquire<PIPE_V>(BUF_AIV_OUT);     // 等上一行 MTE3 读完 xFp32/y 缓冲
        CalculateXAdd(x1Ub, xfUb);
        NormDonor::CalculateSquareReduceSum<float>(xfUb, redUb, tmpUb, 1, HIDDEN, HIDDEN, FOLD_POINT,
                                                   REDUCE_TMP_STRIDE);
        NormDonor::ComputeRstdNewtonRaphson<true, true>(redUb, rstdUb, 1, RMS_EPS, RMS_AVG_FACTOR, VL_F32);
        CalculateY(xfUb, yUb, rstdUb);
        BufRelease<PIPE_V>(BUF_AIV_ROW0);    // x/res 消费完，MTE2 可复用
        BufRelease<PIPE_V>(BUF_AIV_OUT);     // xFp32/y 写完（mode=false），MTE3 可读
    }

    __aicore__ inline void CopyOutRow(uint32_t row)
    {
        LocalTensor<float> xfL(TPosition::VECCALC, UB_M6_XF, HIDDEN);
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_M6_Y, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        BufAcquire<PIPE_MTE3>(BUF_AIV_OUT);
        DataCopy(resOutGm[off], xfL, Block1(HIDDEN * 4));   // 残差出口 fp32
        DataCopy(yGm[off], yL, Block1(HIDDEN * 2));        // y bf16
        BufRelease<PIPE_MTE3>(BUF_AIV_OUT);
    }

private:
    uint32_t M = 0;
    uint32_t gammaOff = 0;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<bfloat16_t> resGmB;
    AscendC::GlobalTensor<float> resGmF;
    AscendC::GlobalTensor<bfloat16_t> yGm;
    AscendC::GlobalTensor<float> resOutGm;
};

}  // namespace
// ============================================================
// S2：Router 段（m7_router_topk 移植：GEMV 向量 MAC → max-shift softmax →
//     Sort32 排序 + top-k 拆分（Extract 的 VF 内联）→ renorm），AIV0 单核
//     同一段内顺带算共享专家门裸点积 sgate[r]（sigmoid 在 S10 用向量做）
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M13;

constexpr uint32_t RT_LANES = 32;                 // Sort32 输入 lane 数（索引模板宽度）
constexpr uint32_t RT_NROWS = NUM_EXPERTS + 1;    // 路由专家 + 共享门
constexpr float RT_NEG_BIG = -3.0e38f;

class RouterStage {
public:
    static constexpr uint32_t RT_RB = 16;   // row-block（m ≤ 64 → 最多 4 块；m7 同款结构）

    __aicore__ inline RouterStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* xIn, __gm__ uint8_t* routerW, __gm__ uint8_t* sgateW,
                                __gm__ uint8_t* logits, __gm__ uint8_t* ids, __gm__ uint8_t* weights,
                                __gm__ uint8_t* sgate, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(xIn), static_cast<uint64_t>(M_MAX) * HIDDEN);
        rwGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(routerW), static_cast<uint64_t>(NUM_EXPERTS) * HIDDEN);
        sgGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(sgateW), HIDDEN);
        logitsGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(logits), static_cast<uint64_t>(M_MAX) * NUM_EXPERTS);
        idsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ids), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(weights), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        sgateGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(sgate), M_MAX);
    }

    // m7 同款块结构：整块 x 行一次 MTE2 载入 → 逐行 V 计算写 UB staging → 整块一次 MTE3 出。
    // 块级粒度让 x 行缓冲的 MTE2→V 交接足以被 BufferID 阻塞释放（mode=false）覆盖（逐行粒度实测会被
    // MTE2 抢跑覆盖，导致所有行读到最后一行的 x）。
    __aicore__ inline void Run(uint32_t subLimit)
    {
        if (subLimit >= 1) {
            PrecastWeights();
        }
        if (subLimit >= 2) {
            BuildIndexTemplate();
        }
        if (subLimit >= 3) {
            const uint32_t nblk = (M + RT_RB - 1) / RT_RB;
            for (uint32_t b = 0; b < nblk; ++b) {
                const uint32_t b0 = b * RT_RB;
                const uint32_t rows = (M - b0 < RT_RB) ? (M - b0) : RT_RB;
                CopyInXBlock(b0, rows);
                ComputeBlock(b0, rows);
                CopyOutBlock(b0, rows);
            }
        }
    }

private:
    // 权重行 bf16 → fp32 预转（RT_NROWS 行；ping-pong UB）
    __aicore__ inline void PrecastWeights()
    {
        for (uint32_t i = 0; i < RT_NROWS; ++i) {
            const uint32_t sel = i & 1;
            const uint32_t wbOff = sel ? UB_RT_WB1 : UB_RT_WB0;
            LocalTensor<bfloat16_t> wbL(TPosition::VECCALC, wbOff, HIDDEN);
            BufAcquire<PIPE_MTE2>(BUF_AIV_STG);
            PipeBarrier<PIPE_MTE2>();
            if (i < NUM_EXPERTS) {
                DataCopy(wbL, rwGm[static_cast<uint64_t>(i) * HIDDEN], Block1(HIDDEN * 2));
            } else {
                DataCopy(wbL, sgGm, Block1(HIDDEN * 2));
            }
            BufRelease<PIPE_MTE2>(BUF_AIV_STG);

            __ubuf__ bfloat16_t* wSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(wbOff);
            __ubuf__ float* wDst = reinterpret_cast<__ubuf__ float*>(UB_RT_WF + i * HIDDEN * 4);
            BufAcquire<PIPE_V>(BUF_AIV_STG);
            __VEC_SCOPE__
            {
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                for (uint16_t c = 0; c < CHUNKS_H; ++c) {
                    RegTensor<bfloat16_t> b0;
                    RegTensor<float> f0;
                    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(b0, wSrc + c * VL_F32);
                    Cast<float, bfloat16_t, castTraitB162B32>(f0, b0, maskAll);
                    StoreAlign<float, StoreDist::DIST_NORM_B32>(wDst + c * VL_F32, f0, maskAll);
                }
            }
            BufRelease<PIPE_V>(BUF_AIV_STG);
        }
    }

    // 索引模板 0..31（Arange 只填 64 lane → 取低 32 lane）
    __aicore__ inline void BuildIndexTemplate()
    {
        __ubuf__ int32_t* idxUb = reinterpret_cast<__ubuf__ int32_t*>(UB_RT_IDX);
        __VEC_SCOPE__
        {
            RegTensor<int32_t> rg;
            uint32_t n32 = RT_LANES;
            MaskReg m32 = UpdateMask<int32_t>(n32);
            Arange(rg, static_cast<int32_t>(0));
            StoreAlign(idxUb, rg, m32);
        }
    }

    __aicore__ inline void CopyInXBlock(uint32_t b0, uint32_t rows)
    {
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0);   // 挡上一块的 V 消费
        PipeBarrier<PIPE_MTE2>();              // 小改 B
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> xL(TPosition::VECCALC, UB_RT_XB + r * HIDDEN * 2, HIDDEN);
            DataCopy(xL, xGm[static_cast<uint64_t>(b0 + r) * HIDDEN], Block1(HIDDEN * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0);
    }

    // 整块 V 段：x 行全读 + staging 全写 都在同一 span 内，块尾一次性 drain 释放
    __aicore__ inline void ComputeBlock(uint32_t b0, uint32_t rows)
    {
        BufAcquire<PIPE_V>(BUF_AIV_ROW0);   // 等整块 x 行就位
        BufAcquire<PIPE_V>(BUF_AIV_ROW1);   // staging（等上一块的 MTE3 拷走）
        for (uint32_t r = 0; r < rows; ++r) {
            GemvRow(r, b0 + r);
            SoftmaxTopkRow(r, b0 + r);
        }
        BufRelease<PIPE_V>(BUF_AIV_ROW0);   // x 块全部消费完 → MTE2 可复用
        BufRelease<PIPE_V>(BUF_AIV_ROW1);   // staging 写完 → MTE3 可读
    }

    // 行内 GEMV（读 UB_RT_XB 的第 r 行）→ logits 行写入 staging
    __aicore__ inline void GemvRow(uint32_t r, uint32_t grow)
    {
        __ubuf__ bfloat16_t* xRowUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_RT_XB + r * HIDDEN * 2);
        __ubuf__ float* rowUb = reinterpret_cast<__ubuf__ float*>(UB_RT_LOG + r * 64 * 4);
        __ubuf__ float* sgUb = reinterpret_cast<__ubuf__ float*>(UB_RT_SG);
        __VEC_SCOPE__
        {
            RegTensor<float> a0, a1, a2, a3, a4;
            RegTensor<float> xf;
            RegTensor<float> w;
            RegTensor<bfloat16_t> xb;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            Duplicate(a0, 0.0f);
            Duplicate(a1, 0.0f);
            Duplicate(a2, 0.0f);
            Duplicate(a3, 0.0f);
            Duplicate(a4, 0.0f);
            for (uint16_t c = 0; c < CHUNKS_H; ++c) {
                const uint32_t off = static_cast<uint32_t>(c) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(xb, xRowUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(xf, xb, maskAll);
                LoadAlign(w, reinterpret_cast<__ubuf__ float*>(UB_RT_WF + 0 * HIDDEN * 4) + off);
                MulAddDst(a0, xf, w, maskAll);
                LoadAlign(w, reinterpret_cast<__ubuf__ float*>(UB_RT_WF + 1 * HIDDEN * 4) + off);
                MulAddDst(a1, xf, w, maskAll);
                LoadAlign(w, reinterpret_cast<__ubuf__ float*>(UB_RT_WF + 2 * HIDDEN * 4) + off);
                MulAddDst(a2, xf, w, maskAll);
                LoadAlign(w, reinterpret_cast<__ubuf__ float*>(UB_RT_WF + 3 * HIDDEN * 4) + off);
                MulAddDst(a3, xf, w, maskAll);
                LoadAlign(w, reinterpret_cast<__ubuf__ float*>(UB_RT_WF + 4 * HIDDEN * 4) + off);
                MulAddDst(a4, xf, w, maskAll);
            }
            Reduce<ReduceType::SUM, float>(a0, a0, maskAll);
            Reduce<ReduceType::SUM, float>(a1, a1, maskAll);
            Reduce<ReduceType::SUM, float>(a2, a2, maskAll);
            Reduce<ReduceType::SUM, float>(a3, a3, maskAll);
            Reduce<ReduceType::SUM, float>(a4, a4, maskAll);
            RegTensor<float> p02, p13, v4, tmp;
            Interleave(p02, tmp, a0, a2);
            Interleave(p13, tmp, a1, a3);
            Interleave(v4, tmp, p02, p13);      // [l0,l1,l2,l3]
            RegTensor<float> negInf, rowReg;
            Duplicate(negInf, RT_NEG_BIG, maskAll);
            uint32_t nE = NUM_EXPERTS;
            MaskReg mE = UpdateMask<float>(nE);
            Select(rowReg, v4, negInf, mE);
            StoreAlign(rowUb, rowReg, maskAll);          // logits 行（未 shift）写 staging
            uint32_t n1 = 1;
            MaskReg m1 = UpdateMask<float>(n1);
            StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(sgUb + r, a4, m1);   // 共享门裸点积
        }
    }

    // 行内 softmax(max-shift) + Sort32 + 前 32 对拆分（Extract 的 VF 内联）+ renorm → staging
    __aicore__ inline void SoftmaxTopkRow(uint32_t r, uint32_t grow)
    {
        __ubuf__ float* rowUb = reinterpret_cast<__ubuf__ float*>(UB_RT_LOG + r * 64 * 4);
        __ubuf__ float* valUb = reinterpret_cast<__ubuf__ float*>(UB_RT_VAL);
        __ubuf__ float* ovUb = reinterpret_cast<__ubuf__ float*>(UB_RT_OV);
        __ubuf__ int32_t* oiUb = reinterpret_cast<__ubuf__ int32_t*>(UB_RT_OI);
        __ubuf__ float* pairUb = reinterpret_cast<__ubuf__ float*>(UB_RT_PAIR);
        __ubuf__ float* wsUb = reinterpret_cast<__ubuf__ float*>(UB_RT_WS + r * 64 * 4);
        __ubuf__ int32_t* idsUb = reinterpret_cast<__ubuf__ int32_t*>(UB_RT_IDS + r * 64 * 4);

        __VEC_SCOPE__
        {
            RegTensor<float> rowReg, mx, dm;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            LoadAlign(rowReg, rowUb);
            uint32_t n32 = RT_LANES;
            MaskReg m32 = UpdateMask<float>(n32);
            Reduce<ReduceType::MAX, float>(mx, rowReg, m32);
            Duplicate(dm, mx, maskAll);
            Sub(rowReg, rowReg, dm, maskAll);
            StoreAlign(rowUb, rowReg, maskAll);   // logits -= rowmax（对齐 golden 返回形式）
            Exp(rowReg, rowReg, maskAll);         // padding lane = exp(-3e38-max) = 0
            StoreAlign(valUb, rowReg, m32);
        }
        {
            // Sort32 属**裁定例外**（docs/05 §6.1 计算路径规则 ⓒ + §2 指令级原语白名单）：
            //   ① Reg 侧**无**等价物（CANN 9.1.0 `reg_compute/**` 穷举无 Sort32/MrgSort）；
            //   ② 官方 donor 同为 memory-based：ops-transformer/moe/moe_gating_top_k_softmax_v2/
            //      op_kernel/arch35/moe_gating_top_k_softmax_v2_perf_arch35.h:187（Sort32）、
            //      :225/:243（MrgSort）。仅限本 topk 排序段，不得扩散。
            //   `MrgSort4` 是 dav-3510 上的 deprecated 空函数体（静默 no-op），本文件 0 处使用。
            LocalTensor<float> pairT(TPosition::VECCALC, UB_RT_PAIR, 2 * RT_LANES);
            LocalTensor<float> valT(TPosition::VECCALC, UB_RT_VAL, RT_LANES);
            LocalTensor<uint32_t> idxT(TPosition::VECCALC, UB_RT_IDX, RT_LANES);
            Sort32(pairT, valT, idxT, 1);
        }
        // 前 32 对 (value, idx) 拆分 = 经典 `Extract(..., 1)` 的 VF 内联。抄厂商 dav_3510
        //   ExtractVf（asc/impl/basic_api/dav_3510/kernel_operator_vec_gather_mask_impl.h:426-481）
        //   的 float 分支：repeatTime=1 ⇒ loopTimes=0/tail=1 的「单寄存器载入 + DeInterleave +
        //   半寄存器存储」路径；与官方 topk donor 落盘同形（…perf_arch35.h:309-343：
        //   LoadAlign<DIST_DINTLV_B32> 载入 (value, idx) 交错对 + 两条掩码 StoreAlign）。
        //   纯 pair 拆分、无算术 ⇒ 与经典 Extract 逐位等价（判据 T1：topk_ids/weights 逐位）。
        __VEC_SCOPE__
        {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            RegTensor<float> vr, vi;
            uint32_t n32 = RT_LANES;
            MaskReg m32 = UpdateMask<float>(n32);
            LoadAlign<float, LoadDist::DIST_DINTLV_B32>(vr, vi, pairUb);
            StoreAlign(ovUb, vr, m32);
            StoreAlign(reinterpret_cast<__ubuf__ uint32_t*>(UB_RT_OI),
                       reinterpret_cast<RegTensor<uint32_t>&>(vi), m32);
        }
        __VEC_SCOPE__
        {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            RegTensor<float> vals;
            RegTensor<int32_t> idxs;
            RegTensor<float> s, ds;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            MaskReg maskAllI = CreateMask<int32_t, MaskPattern::ALL>();
            LoadAlign(vals, ovUb);
            LoadAlign(idxs, oiUb);
            uint32_t nk = TOPK;
            MaskReg mk = UpdateMask<float>(nk);
            Reduce<ReduceType::SUM, float>(s, vals, mk);
            Duplicate(ds, s, maskAll);
            Div(vals, vals, ds, mk);
            StoreAlign(wsUb, vals, maskAll);
            StoreAlign(idsUb, idxs, maskAllI);
        }
    }

    __aicore__ inline void CopyOutBlock(uint32_t b0, uint32_t rows)
    {
        LocalTensor<float> sgAll(TPosition::VECCALC, UB_RT_SG, RT_RB);
        BufAcquire<PIPE_MTE3>(BUF_AIV_ROW1);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<float> logitsL(TPosition::VECCALC, UB_RT_LOG + r * 64 * 4, 64);
            LocalTensor<int32_t> idsL(TPosition::VECCALC, UB_RT_IDS + r * 64 * 4, 64);
            LocalTensor<float> wsL(TPosition::VECCALC, UB_RT_WS + r * 64 * 4, 64);
            DataCopyPad(logitsGm[static_cast<uint64_t>(b0 + r) * NUM_EXPERTS], logitsL,
                        ExtBlock1(NUM_EXPERTS * 4));
            DataCopyPad(idsGm[static_cast<uint64_t>(b0 + r) * TOPK], idsL, ExtBlock1(TOPK * 4));
            DataCopyPad(wGm[static_cast<uint64_t>(b0 + r) * TOPK], wsL, ExtBlock1(TOPK * 4));
        }
        // 共享门裸点积（值在 lane0，整块一次紧凑拷出；sigmoid 由 S10 向量路径完成）
        DataCopyPad(sgateGm[b0], sgAll, ExtBlock1(rows * 4));
        BufRelease<PIPE_MTE3>(BUF_AIV_ROW1);
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<bfloat16_t> rwGm;
    AscendC::GlobalTensor<bfloat16_t> sgGm;
    AscendC::GlobalTensor<float> logitsGm;
    AscendC::GlobalTensor<int32_t> idsGm;
    AscendC::GlobalTensor<float> wGm;
    AscendC::GlobalTensor<float> sgateGm;
};

// ============================================================
// S3：routing 索引生成（m7 ↔ m8 之间的缺口 glue；m8#1 只消费 perm_src/counts，
//     m8#2 消费 inv_slot/w_tk_packed，没有任何算件产生它们 → 本段补齐）
//     计数排序（stable，按 expert id 分组）与 moe_block_ref.py::moe_permute 同语义；
//     标量实现（m*TOPK ≤ 256），UB 写 → MTE3 出（m3-AIV 同款 PIPE_S→MTE3 握手）
// ============================================================

class IndexGenStage {
public:
    __aicore__ inline IndexGenStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* ids, __gm__ uint8_t* weights, __gm__ uint8_t* counts,
                                __gm__ uint8_t* offsets, __gm__ uint8_t* permSrc, __gm__ uint8_t* permExp,
                                __gm__ uint8_t* inv, __gm__ uint8_t* wtk, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        idsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ids), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(weights), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), NUM_EXPERTS);
        offsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets), NUM_EXPERTS + 1);
        permSrcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permSrc), TOTAL_MAX);
        permExpGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permExp), TOTAL_MAX);
        invGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(inv), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wtkGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(wtk), static_cast<uint64_t>(M_MAX) * 16);
    }

    __aicore__ inline uint32_t OobCount() const { return oobCountUb; }

    // subLimit：与 RouterStage 同一 bring-up 旋钮（运行时值；7/8/9 分别为索引数组/counts/诊断槽门控）
    __aicore__ inline void Run(uint32_t subLimit)
    {
        // router 的 MTE3 GM 写排空后再做标量 GM 读（同核次序）
        SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);

        const uint32_t S = M * TOPK;
        uint32_t badIds = 0;   // 脏 ids 计数：诊断槽上报 + 落位循环的短路条件
        uint32_t cnt[NUM_EXPERTS];
        for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
            cnt[e] = 0;
        }
        for (uint32_t s = 0; s < S; ++s) {
            const int32_t e = idsGm.GetValue(s);
            if (e < 0 || e >= static_cast<int32_t>(NUM_EXPERTS)) {
                ++badIds;   // 防御：脏 ids 时不做越界写（会踩栈/UB）
                continue;
            }
            cnt[e] += 1;
        }
        oobCountUb = badIds;   // 诊断槽（badIds != 0 时下面的落位循环整体短路）
        uint32_t off[NUM_EXPERTS + 1];
        off[0] = 0;
        for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
            off[e + 1] = off[e] + cnt[e];
        }

        __ubuf__ int32_t* srcUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_SRC);
        __ubuf__ int32_t* expUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_EXP);
        __ubuf__ int32_t* invUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_INV);
        __ubuf__ int32_t* wtkUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_WTK);
        __ubuf__ int32_t* cntUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_CNT);

        MutexLock<PIPE_S>(BUF_AIV_IDX);
        for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
            cntUb[e] = static_cast<int32_t>(cnt[e]);
        }
        for (uint32_t e = 0; e <= NUM_EXPERTS; ++e) {
            cntUb[8 + e] = static_cast<int32_t>(off[e]);   // +32B 对齐槽（DataCopyPad 源需 32B 对齐）
        }
        uint32_t cursor[NUM_EXPERTS];
        for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
            cursor[e] = off[e];
        }
        for (uint32_t t = 0; t < M; ++t) {
            for (uint32_t k = 0; k < TOPK; ++k) {
                const uint32_t s = t * TOPK + k;
                const int32_t e = idsGm.GetValue(s);
                if (e < 0 || e >= static_cast<int32_t>(NUM_EXPERTS) || badIds != 0) {
                    // 与计数循环对称的防御：脏 ids 时 cursor[e]/off[e]/invUb[s] 一律不越界
                    ++badIds;
                    continue;
                }
                const uint32_t pos = cursor[e];
                cursor[e] = pos + 1;
                srcUb[pos] = static_cast<int32_t>(t);
                expUb[pos] = e;
                // Y 布局是 [slot][M_MAX][HIDDEN]（槽位 padding）→ inv 存 padding 行号
                invUb[s] = static_cast<int32_t>(e * M_MAX + (pos - off[e]));
                // bf16(RNE) 权重位打包进 int32 低 16 位（m8 w_tk_packed 协议）
                const float f = wGm.GetValue(s);
                uint32_t bits;
                __builtin_memcpy(&bits, &f, 4);
                const uint32_t rounded = (bits + 0x7FFFu + ((bits >> 16) & 1u)) >> 16;
                wtkUb[t * 16 + k] = static_cast<int32_t>(rounded & 0xFFFFu);
            }
        }
        MutexUnlock<PIPE_S>(BUF_AIV_IDX);
        if (subLimit < 7) {
            return;
        }

        // UB → GM（PIPE_S 写 → MTE3 读的 BufferID 握手，m3-AIV 同款）
        LocalTensor<int32_t> srcL(TPosition::VECCALC, UB_IG_SRC, S);
        LocalTensor<int32_t> expL(TPosition::VECCALC, UB_IG_EXP, S);
        LocalTensor<int32_t> invL(TPosition::VECCALC, UB_IG_INV, S);
        LocalTensor<int32_t> wtkL(TPosition::VECCALC, UB_IG_WTK, M * 16);
        LocalTensor<int32_t> cntL(TPosition::VECCALC, UB_IG_CNT, NUM_EXPERTS + 1);
        BufAcquire<PIPE_MTE3>(BUF_AIV_IDX);
        DataCopyPad(permSrcGm[0], srcL, ExtBlock1(S * 4));
        DataCopyPad(permExpGm[0], expL, ExtBlock1(S * 4));
        DataCopyPad(invGm[0], invL, ExtBlock1(S * 4));
        DataCopyPad(wtkGm[0], wtkL, ExtBlock1(M * 16 * 4));
        if (subLimit < 8) {
            BufRelease<PIPE_MTE3>(BUF_AIV_IDX);
            return;
        }
        DataCopyPad(countsGm[0], cntL, ExtBlock1(NUM_EXPERTS * 4));
        DataCopyPad(offsGm[0], cntL[8], ExtBlock1((NUM_EXPERTS + 1) * 4));
        if (subLimit >= 9) {
            // 诊断槽：UB 源必须 32B 对齐（+128B），GM 目的也用 32B 对齐槽（offs[8]）
            __ubuf__ int32_t* bUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_CNT);
            bUb[32] = static_cast<int32_t>(oobCountUb);
            LocalTensor<int32_t> bL(TPosition::VECCALC, UB_IG_CNT, 64);
            DataCopyPad(offsGm[8], bL[32], ExtBlock1(4));
        }
        BufRelease<PIPE_MTE3>(BUF_AIV_IDX);
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    uint32_t oobCountUb = 0;
    AscendC::GlobalTensor<int32_t> idsGm;
    AscendC::GlobalTensor<float> wGm;
    AscendC::GlobalTensor<int32_t> countsGm;
    AscendC::GlobalTensor<int32_t> offsGm;
    AscendC::GlobalTensor<int32_t> permSrcGm;
    AscendC::GlobalTensor<int32_t> permExpGm;
    AscendC::GlobalTensor<int32_t> invGm;
    AscendC::GlobalTensor<int32_t> wtkGm;
};

}  // namespace
// ============================================================
// S4：permute（m8_permute kernel #1 移植：x_sorted[i] = x[perm_src_token[i]]，
//     纯带宽逐行 gather，四级流水 + 小改 B 的 MTE2 排空）
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M13;

constexpr uint32_t PERM_STAGES = 4;

class PermuteStage {
public:
    __aicore__ inline PermuteStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* permSrc, __gm__ uint8_t* counts,
                                __gm__ uint8_t* xSorted, uint32_t numExperts, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        E = numExperts;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M_MAX) * HIDDEN);
        srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permSrc), TOTAL_MAX);
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), numExperts);
        xSortedGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(xSorted), static_cast<uint64_t>(TOTAL_MAX) * HIDDEN);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        uint32_t total = 0;
        for (uint32_t e = 0; e < E; ++e) {
            total += static_cast<uint32_t>(countsGm.GetValue(e));
        }
        TOTAL = total;
        const uint32_t myRows = (total > bid) ? (total - bid - 1) / nAiv + 1 : 0;
        for (uint32_t s = 0; s < PERM_STAGES && s < myRows; ++s) {
            CopyIn(bid + s * nAiv, s);
        }
        for (uint32_t r = 0; r < myRows; ++r) {
            const uint32_t stage = r % PERM_STAGES;
            CopyOut(bid + r * nAiv, stage);
            if (r + PERM_STAGES < myRows) {
                CopyIn(bid + (r + PERM_STAGES) * nAiv, stage);
            }
        }
    }

    __aicore__ inline uint32_t Total() const { return TOTAL; }

private:
    __aicore__ inline void CopyIn(uint32_t row, uint32_t stage)
    {
        LocalTensor<bfloat16_t> bufL(TPosition::VECCALC, UB_PM_ROW + stage * HIDDEN * 2, HIDDEN);
        const int32_t src = srcGm.GetValue(row);   // 标量 GM 读（地址计算，值依赖合法）
        BufAcquire<PIPE_MTE2>(BUF_AIV_PERM0 + stage);
        PipeBarrier<PIPE_MTE2>();                  // 小改 B
        DataCopy(bufL, xGm[static_cast<uint64_t>(src) * HIDDEN], Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE2>(BUF_AIV_PERM0 + stage);
    }

    __aicore__ inline void CopyOut(uint32_t row, uint32_t stage)
    {
        LocalTensor<bfloat16_t> bufL(TPosition::VECCALC, UB_PM_ROW + stage * HIDDEN * 2, HIDDEN);
        BufAcquire<PIPE_MTE3>(BUF_AIV_PERM0 + stage);
        DataCopy(xSortedGm[static_cast<uint64_t>(row) * HIDDEN], bufL, Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE3>(BUF_AIV_PERM0 + stage);
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    uint32_t E = 1;
    uint32_t TOTAL = 0;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<int32_t> srcGm;
    AscendC::GlobalTensor<int32_t> countsGm;
    AscendC::GlobalTensor<bfloat16_t> xSortedGm;
};

// ============================================================
// S5/S7：行级 MXFP4 量化（m5_swiglu_quant 的 SwiGLU 五元组 + MxQuant 三段式）
//   小改 C：全 VEC 路径，**无 PIPE_S 挂载**（m3-AIV 的标量量化器被替换）
//   SWIGLU=true 时先做 SwiGLU（源为 gate|up 拼接行）+ 写 swiglu 输出（H 抽点用）
//   PAD_SRC/PAD_DST：源/目标是「按槽位 MAXM 行 padding」的布局（routed 路径），
//   否则是紧凑 m 行布局（shared 专家路径）
// ============================================================

template <uint32_t K, uint32_t SCAL_STRIDE, bool SWIGLU, bool PAD_SRC, bool PAD_DST>
class VecQuantStage {
public:
    static constexpr uint32_t TILE = 256;
    static constexpr uint32_t FULL_TILES = K / TILE;
    static constexpr uint32_t NTILES = (K % TILE == 0) ? FULL_TILES : FULL_TILES + 1;
    static constexpr uint32_t PACKED_K = K / 2;
    static constexpr uint32_t SRC_ROW = SWIGLU ? (2 * K) : K;   // gate|up vs 单段
    static constexpr uint32_t GP = K / GROUP;                   // 每行 scale 有效字节数

    __aicore__ inline VecQuantStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* src, __gm__ uint8_t* swigluOut, __gm__ uint8_t* qx,
                                __gm__ uint8_t* scale, __gm__ uint8_t* counts, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(src),
                              static_cast<uint64_t>(TOTAL_MAX) * SRC_ROW);
        swigluGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(swigluOut),
                                 static_cast<uint64_t>(TOTAL_MAX) * K);
        qxGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(qx), static_cast<uint64_t>(TOTAL_MAX) * PACKED_K);
        scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(scale),
                               static_cast<uint64_t>(TOTAL_MAX) * (SCAL_STRIDE / 2));
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), NUM_EXPERTS);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        uint32_t startOff[NUM_EXPERTS + 1];
        startOff[0] = 0;
        uint32_t rows = M;
        if constexpr (PAD_DST) {
            for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
                startOff[e + 1] = startOff[e] + static_cast<uint32_t>(countsGm.GetValue(e));
            }
            rows = startOff[NUM_EXPERTS];
        }
        for (uint32_t r = bid; r < rows; r += nAiv) {
            uint32_t slot = 0;
            uint32_t lr = r;
            if constexpr (PAD_DST) {
                while (slot < NUM_EXPERTS - 1 && r >= startOff[slot + 1]) {
                    ++slot;
                }
                lr = r - startOff[slot];
            }
            const uint32_t srcRow = PAD_SRC ? (slot * M_MAX + lr) : r;
            const uint32_t dstRow = PAD_DST ? (slot * M_MAX + lr) : r;
            for (uint32_t t = 0; t < NTILES; ++t) {
                // 尾 tile 回退窗口（K % TILE != 0 时），group 对齐 → 重叠区结果逐位一致
                const uint32_t t0 = (t < FULL_TILES) ? t * TILE : (K - TILE);
                ProcessTile(r, srcRow, dstRow, t0);
            }
        }
    }

private:
    __aicore__ inline void ProcessTile(uint32_t packedRow, uint32_t srcRow, uint32_t dstRow, uint32_t t0)
    {
        const uint64_t xOff = static_cast<uint64_t>(srcRow) * SRC_ROW + t0;
        const uint64_t hOff = static_cast<uint64_t>(packedRow) * K + t0;
        const uint64_t qxOff = static_cast<uint64_t>(dstRow) * PACKED_K + t0 / 2;
        const uint64_t sOff = static_cast<uint64_t>(dstRow) * (SCAL_STRIDE / 2) + t0 / GROUP / 2;

        LocalTensor<bfloat16_t> gateL(TPosition::VECCALC, UB_QT_GATE, TILE);
        LocalTensor<bfloat16_t> upL(TPosition::VECCALC, UB_QT_GATE + TILE * 2, TILE);
        LocalTensor<bfloat16_t> swigluL(TPosition::VECCALC, UB_QT_SWIGLU, TILE);
        LocalTensor<int8_t> qxL(TPosition::VECCALC, UB_QT_QX, TILE / 2);
        LocalTensor<uint16_t> scaleL(TPosition::VECCALC, UB_QT_SCALE, TILE / GROUP / 2);
        LocalTensor<uint16_t> halfL(TPosition::VECCALC, UB_QT_HALF, TILE / GROUP);

        __ubuf__ bfloat16_t* gateUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_QT_GATE);
        __ubuf__ bfloat16_t* upUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_QT_GATE + TILE * 2);
        __ubuf__ bfloat16_t* swigluUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_QT_SWIGLU);
        __ubuf__ int8_t* qxUb = reinterpret_cast<__ubuf__ int8_t*>(UB_QT_QX);
        __ubuf__ uint16_t* scaleUb = reinterpret_cast<__ubuf__ uint16_t*>(UB_QT_SCALE);
        __ubuf__ uint16_t* halfUb = reinterpret_cast<__ubuf__ uint16_t*>(UB_QT_HALF);

        // ---- MTE2：GM → UB ----
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0);
        PipeBarrier<PIPE_MTE2>();   // 小改 B：tile 循环同 pipe 复用同一 UB tile
        DataCopy(gateL, srcGm[xOff], Block1(TILE * 2));
        if constexpr (SWIGLU) {
            DataCopy(upL, srcGm[xOff + K], Block1(TILE * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0);

        // ---- V：SwiGLU（可选）→ MxQuant scale → MxQuant data（原地接力）----
        BufAcquire<PIPE_V>(BUF_AIV_ROW0);
        BufAcquire<PIPE_V>(BUF_AIV_OUT);
        if constexpr (SWIGLU) {
            SwigluComputeTile(gateUb, upUb, swigluUb);
            MxQuantComputeScale(swigluUb, scaleUb, halfUb);
            MxQuantComputeDataFP4(swigluUb, halfUb, qxUb);
        } else {
            MxQuantComputeScale(gateUb, scaleUb, halfUb);
            MxQuantComputeDataFP4(gateUb, halfUb, qxUb);
        }
        BufRelease<PIPE_V>(BUF_AIV_ROW0);
        BufRelease<PIPE_V>(BUF_AIV_OUT);

        // ---- MTE3：UB → GM ----
        BufAcquire<PIPE_MTE3>(BUF_AIV_OUT);
        if constexpr (SWIGLU) {
            DataCopy(swigluGm[hOff], swigluL, Block1(TILE * 2));
        }
        DataCopy(qxGm[qxOff], qxL, Block1(TILE / 2));   // int8：TILE/2 字节 = 4 个 32B 块
        DataCopyPad<uint16_t, PaddingMode::Compact>(scaleGm[sOff], scaleL, ExtBlock1(TILE / GROUP));
        BufRelease<PIPE_MTE3>(BUF_AIV_OUT);
    }

    // SwiGLU 五元组（donor VFSwiGlu；m5 逐字 lift）：silu(g) = g/(1+exp(-g))，y = silu(gate)*up
    __aicore__ inline void SwigluComputeTile(__ubuf__ bfloat16_t* gateUb, __ubuf__ bfloat16_t* upUb,
                                             __ubuf__ bfloat16_t* swigluUb)
    {
        constexpr uint32_t VL = 64;
        constexpr uint16_t LOOP = TILE / VL;
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> tg;
            RegTensor<bfloat16_t> tu;
            RegTensor<bfloat16_t> ty;
            RegTensor<float> g;
            RegTensor<float> u;
            RegTensor<float> y;
            RegTensor<float> v;
            uint32_t vl = VL;
            MaskReg dataMask = UpdateMask<float>(vl);
            for (uint16_t j = 0; j < LOOP; ++j) {
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tg, gateUb + j * VL);
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tu, upUb + j * VL);
                Cast<float, bfloat16_t, castTraitB162B32>(g, tg, dataMask);
                Cast<float, bfloat16_t, castTraitB162B32>(u, tu, dataMask);
                Muls(v, g, -1.0f, dataMask);
                Exp(v, v, dataMask);
                Adds(v, v, 1.0f, dataMask);
                Div(v, g, v, dataMask);
                Mul(y, v, u, dataMask);
                Cast<bfloat16_t, float, castTraitB322B16>(ty, y, dataMask);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(swigluUb + j * VL, ty, dataMask);
            }
        }
    }

    // 以下两段为 m2_mxfp4_quant → m5 的 MxQuantComputeScale / MxQuantComputeDataFP4 逐字移植
    __aicore__ inline void MxQuantComputeScale(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* mxScaleLocalAddr,
                                               __ubuf__ uint16_t* halfScaleLocalAddr)
    {
        constexpr uint32_t groups = TILE / GROUP;
        constexpr uint16_t MAX_EXP_FOR_BF16 = 0x7f80;
        constexpr uint16_t MAX_EXP_FOR_FP8 = 0x00ff;
        constexpr uint16_t NAN_CUSTOMIZATION = 0x7f81;
        constexpr int16_t SHR_NUM_FOR_BF16 = 7;
        constexpr uint16_t BF16_EXP_BIAS = 0x7f00;
        constexpr uint16_t FP4_E2M1_BF16_MAX_EXP = 0x0100;
        constexpr uint32_t VL_B16 = 128;
        constexpr int64_t DIGIT_TWO = 2;
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<uint16_t> vdExpExtract0;
            RegTensor<uint16_t> vdExpExtract1;
            RegTensor<uint16_t> expMaskBF16;
            Duplicate(expMaskBF16, MAX_EXP_FOR_BF16);
            RegTensor<uint16_t> vdMaxExp;
            MaskReg Mask = CreateMask<uint16_t, MaskPattern::ALL>();
            MaskReg cmpResult;
            MaskReg zeroMask;
            MaskReg preMaskScale;
            RegTensor<uint16_t> maxExpValue;
            Duplicate(maxExpValue, FP4_E2M1_BF16_MAX_EXP);
            RegTensor<uint16_t> sharedExp;
            RegTensor<uint16_t> scaleValue;
            RegTensor<uint16_t> scaleBias;
            Duplicate(scaleBias, BF16_EXP_BIAS);
            RegTensor<uint16_t> halfScale;
            RegTensor<uint16_t> fp8NanRegTensor;
            Duplicate(fp8NanRegTensor, MAX_EXP_FOR_FP8);
            RegTensor<uint16_t> nanRegTensor;
            Duplicate(nanRegTensor, NAN_CUSTOMIZATION);
            RegTensor<uint16_t> zeroRegTensor;
            Duplicate(zeroRegTensor, 0);

            uint32_t nGroups = groups;
            preMaskScale = UpdateMask<uint16_t>(nGroups);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            And(vdExpExtract0, (RegTensor<uint16_t>&)vdExp0, expMaskBF16, Mask);
            And(vdExpExtract1, (RegTensor<uint16_t>&)vdExp1, expMaskBF16, Mask);
            Max(vdMaxExp, vdExpExtract0, vdExpExtract1, Mask);
            ReduceDataBlock<AscendC::Reg::ReduceType::MAX>(vdMaxExp, vdMaxExp, Mask);

            Compare<uint16_t, CMPMODE::NE>(cmpResult, vdMaxExp, expMaskBF16, preMaskScale);
            Compare<uint16_t, CMPMODE::LE>(zeroMask, vdMaxExp, maxExpValue, preMaskScale);
            Select<uint16_t>(vdMaxExp, maxExpValue, vdMaxExp, zeroMask);
            Sub(sharedExp, vdMaxExp, maxExpValue, preMaskScale);
            ShiftRights(scaleValue, sharedExp, SHR_NUM_FOR_BF16, preMaskScale);
            Select<uint16_t>(scaleValue, scaleValue, fp8NanRegTensor, cmpResult);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK_B16>(
                mxScaleLocalAddr, scaleValue, nGroups / 2, preMaskScale);
            Compare<uint16_t, CMPMODE::NE>(zeroMask, sharedExp, zeroRegTensor, preMaskScale);
            Sub(halfScale, scaleBias, sharedExp, preMaskScale);
            // 官方 add_rms_norm_dynamic_mx_quant_common.h:412-413 同源：组内非有限（±Inf/NaN）
            // 时把 halfScale 覆盖成 NAN_CUSTOMIZATION=0x7F81（bf16 NaN），使后续 Mul(±Inf, NaN)=NaN
            // -> Cast<fp4> = 0.0；否则 Mul(±Inf, 2^-126)=±Inf -> Cast 饱和成 ±6。
            // 官方 :401 Compare<uint16_t, CMPMODE::NE>(cmpResult, vdMaxExp, expMask=0x7F80) 得到的
            // mask 在此复用（置位取 src0=halfScale，清位取 src1=nanRegTensor）。
            Select<uint16_t>(halfScale, halfScale, nanRegTensor, cmpResult);
            Select<uint16_t>(halfScale, halfScale, zeroRegTensor, zeroMask);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE>(halfScaleLocalAddr, halfScale, nGroups, preMaskScale);
        }
    }

    __aicore__ inline void MxQuantComputeDataFP4(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* halfScaleLocalAddr,
                                                 __ubuf__ int8_t* outLocalAddr)
    {
        constexpr uint32_t VL_B16 = 128;
        constexpr int64_t DIGIT_TWO = 2;
        __VEC_SCOPE__
        {
            MaskReg dataMask1;
            RegTensor<uint16_t> halfScaleForMul;
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<fp4x2_e2m1_t> vdExp0FP4;
            RegTensor<fp4x2_e2m1_t> vdExp1FP4;
            uint32_t totalCount = TILE;
            dataMask1 = UpdateMask<bfloat16_t>(totalCount);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            LoadAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_E2B_B16>(
                halfScaleForMul, halfScaleLocalAddr, TILE / GROUP);
            Mul(vdExp0, vdExp0, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Mul(vdExp1, vdExp1, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Interleave(vdExp0, vdExp1, vdExp0, vdExp1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp0FP4, vdExp0, dataMask1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp1FP4, vdExp1, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp0FP4, 64, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp1FP4, 64, dataMask1);
        }
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    AscendC::GlobalTensor<bfloat16_t> srcGm;
    AscendC::GlobalTensor<bfloat16_t> swigluGm;
    AscendC::GlobalTensor<int8_t> qxGm;
    AscendC::GlobalTensor<uint16_t> scaleGm;
    AscendC::GlobalTensor<int32_t> countsGm;
};

}  // namespace
// ============================================================
// S9a：unpermute 加权折叠（m8_permute kernel #2 移植；topK 模板实例化 1..TOPK_MAX）
//   routed_out[t] = bf16( Σ_k fp32(bf16 w[t,k]) * fp32(y_sorted[inv[t,k]]) )
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M13;

constexpr uint32_t U_STAGES = 2;
constexpr uint32_t WROW_I32 = 16;     // 权重行 int32 槽位数（64B，DataCopy 32B 对齐）
constexpr uint32_t UB_U_OUT = TOPK_MAX * HIDDEN * 2;
constexpr uint32_t UB_U_WROW = UB_U_OUT + HIDDEN * 2;

template <uint32_t TK>
__aicore__ inline void FmaChunk(RegTensor<float>& acc, RegTensor<float>& yF, RegTensor<bfloat16_t>& yB16,
                                RegTensor<int32_t>& wRaw, RegTensor<float>& wF, __ubuf__ bfloat16_t* yUb,
                                __ubuf__ int32_t* wRowUb, MaskReg& maskAll, uint32_t off)
{
    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(yB16, yUb + TK * HIDDEN + off);
    Cast<float, bfloat16_t, castTraitB162B32>(yF, yB16, maskAll);
    LoadAlign<int32_t, LoadDist::DIST_BRC_B32>(wRaw, wRowUb + TK);
    ShiftLefts((RegTensor<uint32_t>&)wF, (RegTensor<uint32_t>&)wRaw, static_cast<int16_t>(16), maskAll);
    Mul(yF, yF, wF, maskAll);
    Add(acc, acc, yF, maskAll);
}

template <uint32_t TK>
class UnpermuteStage {
public:
    __aicore__ inline UnpermuteStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* ySorted, __gm__ uint8_t* invSlot, __gm__ uint8_t* wtk,
                                __gm__ uint8_t* out, uint32_t m)
    {
        M = m;
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ySorted), static_cast<uint64_t>(M_MAX * TOPK_MAX) * HIDDEN);
        slotGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(invSlot), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(wtk), static_cast<uint64_t>(M_MAX) * WROW_I32);
        outGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(out), static_cast<uint64_t>(M_MAX) * HIDDEN);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        const uint32_t myRows = (M > bid) ? (M - bid - 1) / nAiv + 1 : 0;
        for (uint32_t r = 0; r < myRows; ++r) {
            const uint32_t t = bid + r * nAiv;
            const uint32_t stage = r % U_STAGES;
            CopyIn(t, stage);
            ComputeRow(stage);
            CopyOut(t, stage);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t t, uint32_t stage)
    {
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_UP_STAGE0 + stage * U_STAGE_B, TOPK_MAX * HIDDEN);
        LocalTensor<int32_t> wL(TPosition::VECCALC, UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_WROW, WROW_I32);
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0 + stage);
        PipeBarrier<PIPE_MTE2>();   // 小改 B
        DataCopy(wL, wGm[static_cast<uint64_t>(t) * WROW_I32], Block1(WROW_I32 * 4));
        for (uint32_t k = 0; k < TK; ++k) {
            const int32_t slot = slotGm.GetValue(static_cast<uint64_t>(t) * TK + k);   // 标量 GM 读→地址
            DataCopy(yL[k * HIDDEN], yGm[static_cast<uint64_t>(slot) * HIDDEN], Block1(HIDDEN * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0 + stage);
    }

    __aicore__ inline void ComputeRow(uint32_t stage)
    {
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_UP_STAGE0 + stage * U_STAGE_B);
        __ubuf__ bfloat16_t* outUb =
            reinterpret_cast<__ubuf__ bfloat16_t*>(UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_OUT);
        __ubuf__ int32_t* wRowUb =
            reinterpret_cast<__ubuf__ int32_t*>(UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_WROW);

        BufAcquire<PIPE_V>(BUF_AIV_ROW0 + stage);
        __VEC_SCOPE__
        {
            RegTensor<float> acc;
            RegTensor<float> yF;
            RegTensor<float> wF;
            RegTensor<int32_t> wRaw;
            RegTensor<bfloat16_t> yB16;
            RegTensor<bfloat16_t> outB16;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t c = 0; c < CHUNKS_H; ++c) {
                const uint32_t off = static_cast<uint32_t>(c) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(yB16, yUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(yF, yB16, maskAll);
                LoadAlign<int32_t, LoadDist::DIST_BRC_B32>(wRaw, wRowUb);
                ShiftLefts((RegTensor<uint32_t>&)wF, (RegTensor<uint32_t>&)wRaw, static_cast<int16_t>(16), maskAll);
                Mul(acc, yF, wF, maskAll);   // k = 0 直写 acc
                if constexpr (TK > 1) FmaChunk<1>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 2) FmaChunk<2>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 3) FmaChunk<3>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                Cast<bfloat16_t, float, castTraitB322B16>(outB16, acc, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(outUb + off, outB16, maskAll);
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_ROW0 + stage);
    }

    __aicore__ inline void CopyOut(uint32_t t, uint32_t stage)
    {
        LocalTensor<bfloat16_t> outL(TPosition::VECCALC, UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_OUT, HIDDEN);
        BufAcquire<PIPE_MTE3>(BUF_AIV_ROW0 + stage);
        DataCopy(outGm[static_cast<uint64_t>(t) * HIDDEN], outL, Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE3>(BUF_AIV_ROW0 + stage);
    }

private:
    uint32_t M = 0;
    AscendC::GlobalTensor<bfloat16_t> yGm;
    AscendC::GlobalTensor<int32_t> slotGm;
    AscendC::GlobalTensor<int32_t> wGm;
    AscendC::GlobalTensor<bfloat16_t> outGm;
};

// ============================================================
// S9b：combine（shared_out = sigmoid(sgate)·shared_mlp；moe_out = routed + shared_out）
//   sgate 的 sigmoid 在这里用向量做（S2 只出裸点积，避免 AIV 内标量浮点）
// ============================================================

class CombineStage {
public:
    __aicore__ inline CombineStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* routed, __gm__ uint8_t* shdMlp, __gm__ uint8_t* sgate,
                                __gm__ uint8_t* sharedOut, __gm__ uint8_t* moeOut, uint32_t m)
    {
        M = m;
        routedGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(routed), static_cast<uint64_t>(M_MAX) * HIDDEN);
        shdGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(shdMlp), static_cast<uint64_t>(M_MAX) * HIDDEN);
        sgateGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(sgate), M_MAX);
        sharedGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(sharedOut), static_cast<uint64_t>(M_MAX) * HIDDEN);
        moeGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(moeOut), static_cast<uint64_t>(M_MAX) * HIDDEN);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        for (uint32_t t = bid; t < M; t += nAiv) {
            CopyInRow(t);
            ComputeRow();
            CopyOutRow(t);
        }
    }

private:
    __aicore__ inline void CopyInRow(uint32_t t)
    {
        LocalTensor<bfloat16_t> rtL(TPosition::VECCALC, UB_CB_ROUTED, HIDDEN);
        LocalTensor<bfloat16_t> shL(TPosition::VECCALC, UB_CB_SHARED, HIDDEN);
        LocalTensor<float> sgL(TPosition::VECCALC, UB_CB_G, 64);
        const uint64_t off = static_cast<uint64_t>(t) * HIDDEN;
        // 整行（MTE2 写 → V 就地改 → MTE3 读）必须共用一个 BufferID：
        // 否则下一行的 MTE2 会抢在 MTE3 读之前覆盖 UB_CB_ROUTED/SHARED
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0);
        PipeBarrier<PIPE_MTE2>();   // 小改 B
        DataCopy(rtL, routedGm[off], Block1(HIDDEN * 2));
        DataCopy(shL, shdGm[off], Block1(HIDDEN * 2));
        // 单值 4B / 非 32B 对齐地址：必须走 DataCopyPad（非原子 DataCopy 会报地址未对齐）
        DataCopyPad(sgL, sgateGm[t], ExtBlock1(4), DataCopyPadExtParams<float>{false, 0, 0, 0});
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0);
    }

    __aicore__ inline void ComputeRow()
    {
        __ubuf__ bfloat16_t* rtUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_CB_ROUTED);
        __ubuf__ bfloat16_t* shUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_CB_SHARED);
        __ubuf__ float* sgUb = reinterpret_cast<__ubuf__ float*>(UB_CB_G);

        BufAcquire<PIPE_V>(BUF_AIV_ROW0);   // 与 MTE2 写、MTE3 读共用同一 token
        __VEC_SCOPE__
        {
            RegTensor<float> g;
            RegTensor<float> one;
            RegTensor<float> shF;
            RegTensor<float> rtF;
            RegTensor<bfloat16_t> shB;
            RegTensor<bfloat16_t> rtB;
            RegTensor<bfloat16_t> outB;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            Duplicate(one, 1.0f);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(g, sgUb);   // 门裸点积广播
            Muls(g, g, -1.0f, maskAll);
            Exp(g, g, maskAll);
            Adds(g, g, 1.0f, maskAll);
            Div(g, one, g, maskAll);                             // sigmoid = 1/(1+exp(-x))
            for (uint16_t c = 0; c < CHUNKS_H; ++c) {
                const uint32_t off = static_cast<uint32_t>(c) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(shB, shUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(shF, shB, maskAll);
                Mul(shF, shF, g, maskAll);
                Cast<bfloat16_t, float, castTraitB322B16>(outB, shF, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(shUb + off, outB, maskAll);  // 原地写回
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(rtB, rtUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(rtF, rtB, maskAll);
                Add(shF, shF, rtF, maskAll);
                Cast<bfloat16_t, float, castTraitB322B16>(outB, shF, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(rtUb + off, outB, maskAll);  // 复用 routed 缓冲
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_ROW0);
    }

    __aicore__ inline void CopyOutRow(uint32_t t)
    {
        // shared 结果原地写在 UB_CB_SHARED，moe 结果写在 UB_CB_ROUTED
        LocalTensor<bfloat16_t> shL(TPosition::VECCALC, UB_CB_SHARED, HIDDEN);
        LocalTensor<bfloat16_t> moeL(TPosition::VECCALC, UB_CB_ROUTED, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(t) * HIDDEN;
        BufAcquire<PIPE_MTE3>(BUF_AIV_ROW0);
        DataCopy(sharedGm[off], shL, Block1(HIDDEN * 2));
        DataCopy(moeGm[off], moeL, Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE3>(BUF_AIV_ROW0);
    }

private:
    uint32_t M = 0;
    AscendC::GlobalTensor<bfloat16_t> routedGm;
    AscendC::GlobalTensor<bfloat16_t> shdGm;
    AscendC::GlobalTensor<float> sgateGm;
    AscendC::GlobalTensor<bfloat16_t> sharedGm;
    AscendC::GlobalTensor<bfloat16_t> moeGm;
};

}  // namespace
// ============================================================
// MoE layer kernel：段序编排 + 跨核同步（单一 __mix__(1,2) 启动）
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M13;

// 段形状的编译期常量（gate_up: K=2560 N=1280；down: K=640 N=2560）
constexpr uint32_t GU_NBLK = GU_N / BASE_N;       // 5
constexpr uint32_t DN_NBLK = HIDDEN / BASE_N;     // 10
constexpr uint32_t NUM_SLOTS = NUM_EXPERTS + 1;   // routed 专家 + shared 专家
constexpr uint32_t GU_ITEMS = NUM_SLOTS * GU_NBLK;
constexpr uint32_t DN_ITEMS = NUM_SLOTS * DN_NBLK;

struct MoeLayerPtrs {
    __gm__ uint8_t* ws;
    __gm__ uint8_t* xLayer;     // 层输入激活 [M_MAX, HIDDEN] bf16
    __gm__ uint8_t* resZero;    // 全 0 残差（S1 的残差入口）
    __gm__ uint8_t* gamma1;
    __gm__ uint8_t* gamma2;
    __gm__ uint8_t* routerW;
    __gm__ uint8_t* sgateW;
    __gm__ uint8_t* wGu;
    __gm__ uint8_t* sGu;
    __gm__ uint8_t* wDn;
    __gm__ uint8_t* sDn;
    __gm__ uint8_t* wGuShd;
    __gm__ uint8_t* sGuShd;
    __gm__ uint8_t* wDnShd;
    __gm__ uint8_t* sDnShd;
    uint32_t m;
    uint32_t topk;
    uint32_t sliceMode;   // 0 = MoE slice 直接消费 golden x（逐 op 对齐 golden）
                          // 1 = 全层链（router 消费 S1 的 x_norm）
    uint32_t stageLimit;  // 段序截断（bring-up 定位用；8 = 全链）
    uint32_t subLimit;    // S2/S3 段内截断（bring-up 定位用；9 = 全开）
};

class MoeLayerChain {
public:
    __aicore__ inline MoeLayerChain() {}

    __aicore__ inline void Init(const MoeLayerPtrs& args)
    {
        p = args;
        ws = args.ws;

        // S1 m6#1：x = 层输入，res = 0，gamma1
        norm1.Init(args.xLayer, args.resZero, ws + WS_XNORM, ws + WS_RES1, UB_GAMMA1_F32, args.m);
        // S10 m6#2：x = moe_out，res = S1 的 fp32 resOut（小改 D），gamma2
        norm2.Init(ws + WS_MOE, ws + WS_RES1, ws + WS_YFINAL, ws + WS_RES2, UB_GAMMA2_F32, args.m);

        __gm__ uint8_t* sliceSrc = args.sliceMode ? (ws + WS_XNORM) : args.xLayer;

        // S2/S3（AIV0）
        router.Init(sliceSrc, args.routerW, args.sgateW, ws + WS_LOGITS, ws + WS_IDS, ws + WS_W, ws + WS_SGATE,
                    args.m, args.topk);
        idxGen.Init(ws + WS_IDS, ws + WS_W, ws + WS_COUNTS, ws + WS_OFFSETS, ws + WS_PERM_SRC, ws + WS_PERM_EXP,
                    ws + WS_INV, ws + WS_WTK, args.m, args.topk);
        // S4 permute
        perm.Init(sliceSrc, ws + WS_PERM_SRC, ws + WS_COUNTS, ws + WS_XSORT, NUM_EXPERTS, args.m, args.topk);
        // S5 A 侧量化（routed + shared）
        quantA.Init(ws + WS_XSORT, nullptr, ws + WS_AQ, ws + WS_AS, ws + WS_COUNTS, args.m, args.topk);
        quantAShd.Init(sliceSrc, nullptr, ws + WS_AQ_SHD, ws + WS_AS_SHD, ws + WS_COUNTS, args.m, args.topk);
        // S7 SwiGLU + 量化（routed + shared）
        quantH.Init(ws + WS_GU, ws + WS_H, ws + WS_HQ, ws + WS_HS, ws + WS_COUNTS, args.m, args.topk);
        quantHShd.Init(ws + WS_GU_SHD, ws + WS_H_SHD, ws + WS_HQ_SHD, ws + WS_HS_SHD, ws + WS_COUNTS, args.m,
                       args.topk);
        // S8/S9
        PrepareUnpermute(args);
    }

    // ---- AIV 侧 ----
    __aicore__ inline void ProcessAiv()
    {
        const uint32_t bid = AscendC::GetBlockIdx();          // 0 .. 2*numBlocks-1
        const uint32_t nAiv = AscendC::GetBlockNum() * 2;
        const bool isPrimary = (bid == 0);

        // gamma bf16 → fp32 预转（每核一次）
        PrecastGammaF32(p.gamma1, UB_GAMMA1_F32);
        PrecastGammaF32(p.gamma2, UB_GAMMA2_F32);

        // ---------- S1：m6#1 ----------
        if (p.stageLimit >= 1) {
            norm1.Run(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(0);   // 等 x_norm/res1 全体就位
        }

        // ---------- S2/S3：router + 索引生成（AIV0）----------
        if (p.stageLimit >= 2) {
            if (isPrimary) {
                router.Run(p.subLimit);
                if (p.subLimit >= 6) {
                    idxGen.Run(p.subLimit);
                }
            }
            BarrierAiv<PIPE_S>(1);      // perm_src/counts 的标量 GM 读需要 PIPE_S 值依赖
        }

        // ---------- S4：permute ----------
        if (p.stageLimit >= 3) {
            perm.Run(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(2);
        }

        // ---------- S5：A 侧 MXFP4 全 VEC 量化 ----------
        if (p.stageLimit >= 4) {
            quantA.Run(bid, nAiv);
            quantAShd.Run(bid, nAiv);
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE3>(FLAG_M2_RING[0]);   // A 就绪 → 配对 AIC
        }

        // ---------- S7：SwiGLU + MXFP4 量化（等 GU）----------
        if (p.stageLimit >= 5) {
            CrossCoreWaitFlag<CC_MODE2, PIPE_MTE2>(FLAG_M2_RING[1]);
            quantH.Run(bid, nAiv);
            quantHShd.Run(bid, nAiv);
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE3>(FLAG_M2_RING[2]);   // H 就绪 → 配对 AIC
        }

        // ---------- S9a：unpermute 加权折叠（等 Y）----------
        if (p.stageLimit >= 6) {
            CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_M2_RING[3]);     // inv_slot/w_tk 标量读
            RunUnpermute(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(3);
        }

        // ---------- S9b：combine ----------
        if (p.stageLimit >= 7) {
            combine.Run(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(0);
        }

        // ---------- S10：m6#2 ----------
        if (p.stageLimit >= 8) {
            norm2.Run(bid, nAiv);
        }
    }

    // ---- AIC 侧 ----
    __aicore__ inline void ProcessAic()
    {
        const uint32_t bid = AscendC::GetBlockIdx();          // 0 .. numBlocks-1
        const uint32_t numBlocks = AscendC::GetBlockNum();
        AscendC::GlobalTensor<uint32_t> countsGm;
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(ws + WS_COUNTS), NUM_EXPERTS);

        if (p.stageLimit < 5) {
            return;
        }
        // ---------- 等 S5 的 A 就绪 ----------
        CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_M2_RING[0]);
        CrossCoreSetFlag<CC_MODE0, PIPE_MTE2>(FLAG_AIC_SEG_RING[0]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[0]);

        // ---------- S6：grouped gate_up GEMM（槽位 = 4 routed + 1 shared）----------
        for (uint32_t item = bid; item < GU_ITEMS; item += numBlocks) {
            const uint32_t slot = item / GU_NBLK;
            const uint32_t nb = item % GU_NBLK;
            const bool shd = (slot == NUM_EXPERTS);
            const uint32_t t = shd ? p.m : countsGm.GetValue(slot);
            if (t == 0) {
                continue;   // 空槽位：A 区未被量化器写、curM=0 无需计算
            }
            gemmGu.SetItem(shd ? (ws + WS_AQ_SHD) : (ws + WS_AQ + slot * M_MAX * (HIDDEN / 2)),
                           shd ? (ws + WS_AS_SHD) : (ws + WS_AS + slot * M_MAX * GU_SCALE_STRIDE),
                           shd ? p.wGuShd : (p.wGu + slot * GU_N * (HIDDEN / 2)),
                           shd ? p.sGuShd : (p.sGu + slot * GU_N * GU_SCALE_STRIDE),
                           shd ? (ws + WS_GU_SHD) : (ws + WS_GU + slot * M_MAX * GU_N * 2));
            gemmGu.Run(nb, t);
        }
        CrossCoreSetFlag<CC_MODE0, PIPE_FIX>(FLAG_AIC_SEG_RING[1]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[1]);
        CrossCoreSetFlag<CC_MODE2, PIPE_MTE2>(FLAG_M2_RING[1]);   // GU 就绪 → 配对 AIV

        if (p.stageLimit < 6) {
            return;
        }
        // ---------- 等 S7 的 H 就绪 ----------
        CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_M2_RING[2]);
        CrossCoreSetFlag<CC_MODE0, PIPE_MTE2>(FLAG_AIC_SEG_RING[2]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[2]);

        // ---------- S8：grouped down GEMM ----------
        for (uint32_t item = bid; item < DN_ITEMS; item += numBlocks) {
            const uint32_t slot = item / DN_NBLK;
            const uint32_t nb = item % DN_NBLK;
            const bool shd = (slot == NUM_EXPERTS);
            const uint32_t t = shd ? p.m : countsGm.GetValue(slot);
            if (t == 0) {
                continue;
            }
            gemmDn.SetItem(shd ? (ws + WS_HQ_SHD) : (ws + WS_HQ + slot * M_MAX * (INTER / 2)),
                           shd ? (ws + WS_HS_SHD) : (ws + WS_HS + slot * M_MAX * DN_SCALE_STRIDE),
                           shd ? p.wDnShd : (p.wDn + slot * HIDDEN * (INTER / 2)),
                           shd ? p.sDnShd : (p.sDn + slot * HIDDEN * (INTER / GROUP)),
                           shd ? (ws + WS_Y_SHD) : (ws + WS_Y + slot * M_MAX * HIDDEN * 2));
            gemmDn.Run(nb, t);
        }
        CrossCoreSetFlag<CC_MODE0, PIPE_FIX>(FLAG_AIC_SEG_RING[3]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[3]);
        CrossCoreSetFlag<CC_MODE2, PIPE_MTE2>(FLAG_M2_RING[3]);   // Y 就绪 → 配对 AIV
    }

private:
    // 全体 AIV mode 0 barrier（wait 挂窄 pipe；需标量值依赖的段用 PIPE_S）
    template <pipe_t WAIT_PIPE>
    __aicore__ inline void BarrierAiv(uint32_t slot)
    {
        CrossCoreSetFlag<CC_MODE0, PIPE_MTE3>(FLAG_AIV_SEG_RING[slot]);
        CrossCoreWaitFlag<CC_MODE0, WAIT_PIPE>(FLAG_AIV_SEG_RING[slot]);
    }

    // topK 运行时 → 模板分发（m8#2 同款：k 链全展开，下标皆编译期）
    __aicore__ inline void RunUnpermute(uint32_t bid, uint32_t nAiv)
    {
        switch (p.topk) {
            case 1: unperm1.Run(bid, nAiv); break;
            case 2: unperm2.Run(bid, nAiv); break;
            case 3: unperm3.Run(bid, nAiv); break;
            default: unperm4.Run(bid, nAiv); break;
        }
    }

public:
    // Init 中把 topK 分发到模板实例（避免 Init 里做 switch）
    __aicore__ inline void PrepareUnpermute(const MoeLayerPtrs& args)
    {
        unperm1.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm2.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm3.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm4.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        combine.Init(ws + WS_ROUTED, ws + WS_Y_SHD, ws + WS_SGATE, ws + WS_SHARED, ws + WS_MOE, args.m);
    }

private:
    MoeLayerPtrs p;
    __gm__ uint8_t* ws = nullptr;

    NormStage<false> norm1;      // 残差 bf16（全 0）
    NormStage<true> norm2;       // 残差 fp32（小改 D）
    RouterStage router;
    IndexGenStage idxGen;
    PermuteStage perm;
    VecQuantStage<HIDDEN, GU_SCALE_STRIDE, false, false, true> quantA;
    VecQuantStage<HIDDEN, GU_SCALE_STRIDE, false, false, false> quantAShd;
    VecQuantStage<INTER, DN_SCALE_STRIDE, true, true, true> quantH;
    VecQuantStage<INTER, DN_SCALE_STRIDE, true, false, false> quantHShd;
    UnpermuteStage<1> unperm1;
    UnpermuteStage<2> unperm2;
    UnpermuteStage<3> unperm3;
    UnpermuteStage<4> unperm4;
    CombineStage combine;
    MXFP4GemmItem<HIDDEN, GU_N, GU_SCALE_STRIDE> gemmGu;
    MXFP4GemmItem<INTER, HIDDEN, DN_SCALE_STRIDE> gemmDn;
};

}  // namespace

__global__ __mix__(1, 2) void m13_moe_layer_kernel(
    __gm__ uint8_t* ws, __gm__ uint8_t* xLayer, __gm__ uint8_t* resZero, __gm__ uint8_t* gamma1,
    __gm__ uint8_t* gamma2, __gm__ uint8_t* routerW, __gm__ uint8_t* sgateW, __gm__ uint8_t* wGu, __gm__ uint8_t* sGu,
    __gm__ uint8_t* wDn, __gm__ uint8_t* sDn, __gm__ uint8_t* wGuShd, __gm__ uint8_t* sGuShd, __gm__ uint8_t* wDnShd,
    __gm__ uint8_t* sDnShd, uint32_t m, uint32_t topk, uint32_t sliceMode, uint32_t stageLimit, uint32_t subLimit)
{
    AscendC::InitSocState();
    MoeLayerPtrs args;
    args.ws = ws;
    args.xLayer = xLayer;
    args.resZero = resZero;
    args.gamma1 = gamma1;
    args.gamma2 = gamma2;
    args.routerW = routerW;
    args.sgateW = sgateW;
    args.wGu = wGu;
    args.sGu = sGu;
    args.wDn = wDn;
    args.sDn = sDn;
    args.wGuShd = wGuShd;
    args.sGuShd = sGuShd;
    args.wDnShd = wDnShd;
    args.sDnShd = sDnShd;
    args.m = m;
    args.topk = topk;
    args.sliceMode = sliceMode;
    args.stageLimit = stageLimit;
    args.subLimit = subLimit;

    MoeLayerChain op;
    op.Init(args);
    op.PrepareUnpermute(args);
    if ASCEND_IS_AIV {
        op.ProcessAiv();
    }
    if ASCEND_IS_AIC {
        op.ProcessAic();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// 量化段自检 kernel（任务 M32）：复用 S5/S7 **同一份** VecQuantStage 设备代码
//   （MxQuantComputeScale / MxQuantComputeDataFP4），只是把源/目标换成 host 直给的紧凑
//   布局（PAD_SRC=PAD_DST=false，行索引 = 行号），用于跑含 ±Inf/NaN 的激活并做逐字节比对。
//   src  : bf16 [rows][SRC_ROW]（SWIGLU=true 时 SRC_ROW=2K 即 gate|up 拼接）
//   qx   : int8 [rows][K/2]；scale: uint8 [rows][SCAL_STRIDE]（每行前 K/GROUP 字节有效）
//   与正式链路同 K/SCAL_STRIDE/SWIGLU 三个模板参数（故覆盖 quantA 与 quantH 两种实例化）
// ============================================================
template <uint32_t K, uint32_t SCAL_STRIDE, bool SWIGLU>
__vector__ __global__ void m13_quant_selftest_kernel(__gm__ uint8_t* src, __gm__ uint8_t* swigluOut,
                                                     __gm__ uint8_t* qx, __gm__ uint8_t* scale, uint32_t rows)
{
    AscendC::InitSocState();
    __gm__ uint8_t* counts = nullptr;   // PAD_DST=false -> counts 不参与行索引
    VecQuantStage<K, SCAL_STRIDE, SWIGLU, false, false> q;
    q.Init(src, swigluOut, qx, scale, counts, rows, 1);
    q.Run(0, 1);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧：消费 tools/golden/data/{m1,m33} + 读回比对 + dump（供 check_ref.py）
// ============================================================

#include <string>
#include <vector>

static float H_Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t H_F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t bias = ((x >> 16) & 1u) + 0x7FFFu;
    return static_cast<uint16_t>((x + bias) >> 16);
}

static uint32_t H_Hash(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

static bool H_ReadBin(const std::string& path, void* buf, size_t bytes)
{
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) {
        return false;
    }
    const size_t r = fread(buf, 1, bytes, f);
    fclose(f);
    return r == bytes;
}

static bool H_ReadAll(const std::string& path, std::vector<uint8_t>& out)
{
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) {
        return false;
    }
    fseek(f, 0, SEEK_END);
    const long sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (sz < 0) {
        fclose(f);
        return false;
    }
    out.resize(static_cast<size_t>(sz));
    const size_t r = out.empty() ? 0 : fread(out.data(), 1, out.size(), f);
    fclose(f);
    return r == out.size();
}

// manifest.json 极简抽取（只取本工程需要的三个标量）
static bool H_ScrapeU32(const std::string& text, const std::string& key, uint32_t& out)
{
    const size_t k = text.find("\"" + key + "\"");
    if (k == std::string::npos) {
        return false;
    }
    size_t i = text.find(':', k);
    if (i == std::string::npos) {
        return false;
    }
    ++i;
    while (i < text.size() && (text[i] == ' ' || text[i] == '\t')) {
        ++i;
    }
    if (i >= text.size() || text[i] < '0' || text[i] > '9') {
        return false;
    }
    uint32_t v = 0;
    while (i < text.size() && text[i] >= '0' && text[i] <= '9') {
        v = v * 10u + static_cast<uint32_t>(text[i] - '0');
        ++i;
    }
    out = v;
    return true;
}

// ---- 数据集（输入 + golden 输出）----
struct CaseData {
    uint32_t m = 0;
    uint32_t E = 0;
    uint32_t topk = 0;
    uint32_t total = 0;   // Σt_e = m*top_k（golden 约定）
    std::vector<uint16_t> x;         // [m, HIDDEN]
    std::vector<uint16_t> routerW;   // [E, HIDDEN]
    std::vector<uint16_t> sgateW;    // [HIDDEN]
    std::vector<uint8_t> wGu;        // [E, GU_N, HIDDEN/2]
    std::vector<uint8_t> sGu;        // [E, GU_N, 80]
    std::vector<uint8_t> wDn;        // [E, HIDDEN, INTER/2]
    std::vector<uint8_t> sDn;        // [E, HIDDEN, 20]
    std::vector<uint8_t> wGuShd;     // [GU_N, HIDDEN/2]（gate|up 行拼接，host 侧组板）
    std::vector<uint8_t> sGuShd;     // [GU_N, 80]
    std::vector<uint8_t> wDnShd;     // [HIDDEN, INTER/2]
    std::vector<uint8_t> sDnShd;     // [HIDDEN, 20]
    // golden
    std::vector<float> gLogits;      // [m, E] max-shifted
    std::vector<int32_t> gIds;       // [m, topk]
    std::vector<float> gWeights;     // [m, topk]
    std::vector<int32_t> gPermSrc;   // [total]
    std::vector<int32_t> gPermExp;   // [total]
    std::vector<int32_t> gCounts;    // [E]
    std::vector<uint16_t> gXSorted;  // [total, HIDDEN]
    std::vector<uint16_t> gRouted;   // [m, HIDDEN]
    std::vector<uint16_t> gShared;   // [m, HIDDEN]
    std::vector<uint16_t> gMoe;      // [m, HIDDEN]
};

static bool H_LoadDataset(const std::string& dir, CaseData& d)
{
    std::vector<uint8_t> manifest;
    if (!H_ReadAll(dir + "/manifest.json", manifest)) {
        printf("[M13][FAIL] cannot read %s/manifest.json\n", dir.c_str());
        return false;
    }
    const std::string text(manifest.begin(), manifest.end());
    if (!H_ScrapeU32(text, "m", d.m) || !H_ScrapeU32(text, "num_experts", d.E) ||
        !H_ScrapeU32(text, "top_k", d.topk)) {
        printf("[M13][FAIL] manifest.json missing m/num_experts/top_k\n");
        return false;
    }
    if (d.m == 0 || d.m > M13::M_MAX || d.E != M13::NUM_EXPERTS || d.topk == 0 || d.topk > M13::TOPK_MAX) {
        printf("[M13][FAIL] dataset envelope violated: m=%u E=%u topk=%u (m<=%u, E=%u, topk<=%u)\n", d.m, d.E, d.topk,
               M13::M_MAX, M13::NUM_EXPERTS, M13::TOPK_MAX);
        return false;
    }
    d.total = d.m * d.topk;

    const size_t H = M13::HIDDEN;
    const size_t N = M13::GU_N;
    const size_t I = M13::INTER;
    d.x.resize(H * M13::M_MAX, 0);         // 按 M_MAX 行分配（host 端 0 padding）
    d.routerW.resize(H * d.E);
    d.sgateW.resize(H);
    d.wGu.resize(d.E * N * (H / 2));
    d.sGu.resize(d.E * N * M13::GU_SCALE_STRIDE);
    d.wDn.resize(d.E * H * (I / 2));
    d.sDn.resize(d.E * H * (I / M13::GROUP));
    d.wGuShd.resize(2 * N * (H / 2));            // gate 行 [0,N) + up 行 [N,2N)
    d.sGuShd.resize(2 * N * M13::GU_SCALE_STRIDE);
    d.wDnShd.resize(H * (I / 2));
    d.sDnShd.resize(H * (I / M13::GROUP));
    d.gLogits.resize(static_cast<size_t>(d.m) * d.E);
    d.gIds.resize(static_cast<size_t>(d.m) * d.topk);
    d.gWeights.resize(static_cast<size_t>(d.m) * d.topk);
    d.gPermSrc.resize(d.total);
    d.gPermExp.resize(d.total);
    d.gCounts.resize(d.E);
    d.gXSorted.resize(d.total * H);
    d.gRouted.resize(d.m * H);
    d.gShared.resize(d.m * H);
    d.gMoe.resize(d.m * H);

    if (!H_ReadBin(dir + "/x.bin", d.x.data(), d.m * H * 2) ||
        !H_ReadBin(dir + "/router_weight.bin", d.routerW.data(), d.routerW.size() * 2) ||
        !H_ReadBin(dir + "/shared_expert_gate_weight.bin", d.sgateW.data(), H * 2)) {
        printf("[M13][FAIL] missing activation/router-weight bins in %s\n", dir.c_str());
        return false;
    }
    if (!H_ReadBin(dir + "/experts.gate_up_proj.bin", d.wGu.data(), d.wGu.size()) ||
        !H_ReadBin(dir + "/experts.gate_up_proj.weight_scale.bin", d.sGu.data(), d.sGu.size()) ||
        !H_ReadBin(dir + "/experts.down_proj.bin", d.wDn.data(), d.wDn.size()) ||
        !H_ReadBin(dir + "/experts.down_proj.weight_scale.bin", d.sDn.data(), d.sDn.size())) {
        printf("[M13][FAIL] missing routed-expert weight bins in %s\n", dir.c_str());
        return false;
    }
    // 共享专家：checkpoint 是独立 gate/up；kernel 侧要 gate|up 行拼接（与 routed 的
    // merged gate_up_proj 形态一致）→ host 组板（纯行拼接，权重字节不变）
    {
        const size_t rowB = H / 2;
        const size_t sRow = M13::GU_SCALE_STRIDE;
        // checkpoint 布局：[INTER, HIDDEN/2]（N = moe_intermediate_size = 640）
        std::vector<uint8_t> g(I * rowB);
        std::vector<uint8_t> u(I * rowB);
        std::vector<uint8_t> gs(I * sRow);
        std::vector<uint8_t> us(I * sRow);
        if (!H_ReadBin(dir + "/shared_expert.gate_proj.bin", g.data(), g.size()) ||
            !H_ReadBin(dir + "/shared_expert.up_proj.bin", u.data(), u.size()) ||
            !H_ReadBin(dir + "/shared_expert.gate_proj.weight_scale.bin", gs.data(), gs.size()) ||
            !H_ReadBin(dir + "/shared_expert.up_proj.weight_scale.bin", us.data(), us.size()) ||
            !H_ReadBin(dir + "/shared_expert.down_proj.bin", d.wDnShd.data(), d.wDnShd.size()) ||
            !H_ReadBin(dir + "/shared_expert.down_proj.weight_scale.bin", d.sDnShd.data(), d.sDnShd.size())) {
            printf("[M13][FAIL] missing shared-expert weight bins in %s\n", dir.c_str());
            return false;
        }
        // 行 [0, I) = gate_proj；行 [I, 2I) = up_proj（I = INTER = 640，总行数 = GU_N）
        for (size_t r = 0; r < I; ++r) {
            __builtin_memcpy(d.wGuShd.data() + r * rowB, g.data() + r * rowB, rowB);
            __builtin_memcpy(d.wGuShd.data() + (I + r) * rowB, u.data() + r * rowB, rowB);
            __builtin_memcpy(d.sGuShd.data() + r * sRow, gs.data() + r * sRow, sRow);
            __builtin_memcpy(d.sGuShd.data() + (I + r) * sRow, us.data() + r * sRow, sRow);
        }
    }

    if (!H_ReadBin(dir + "/router_logits.bin", d.gLogits.data(), d.gLogits.size() * 4) ||
        !H_ReadBin(dir + "/topk_ids.bin", d.gIds.data(), d.gIds.size() * 4) ||
        !H_ReadBin(dir + "/topk_weights.bin", d.gWeights.data(), d.gWeights.size() * 4) ||
        !H_ReadBin(dir + "/perm_src_token.bin", d.gPermSrc.data(), d.gPermSrc.size() * 4) ||
        !H_ReadBin(dir + "/perm_expert.bin", d.gPermExp.data(), d.gPermExp.size() * 4) ||
        !H_ReadBin(dir + "/expert_token_counts.bin", d.gCounts.data(), d.gCounts.size() * 4) ||
        !H_ReadBin(dir + "/x_sorted.bin", d.gXSorted.data(), d.gXSorted.size() * 2) ||
        !H_ReadBin(dir + "/routed_output.bin", d.gRouted.data(), d.gRouted.size() * 2) ||
        !H_ReadBin(dir + "/shared_output.bin", d.gShared.data(), d.gShared.size() * 2) ||
        !H_ReadBin(dir + "/moe_output.bin", d.gMoe.data(), d.gMoe.size() * 2)) {
        printf("[M13][FAIL] missing golden bins in %s\n", dir.c_str());
        return false;
    }
    return true;
}

// ============================================================
// 比对工具（返回是否通过；同时打印最差指标）
// ============================================================

static bool H_CmpI32Exact(const char* tag, const int32_t* got, const int32_t* exp, size_t n)
{
    size_t bad = 0;
    size_t first = 0;
    for (size_t i = 0; i < n; ++i) {
        if (got[i] != exp[i]) {
            if (bad == 0) {
                first = i;
            }
            ++bad;
        }
    }
    if (bad == 0) {
        printf("[M13]   %-28s PASS (exact, n=%zu)\n", tag, n);
        return true;
    }
    printf("[M13]   %-28s FAIL (%zu/%zu mismatch, first idx %zu: got %d exp %d)\n", tag, bad, n, first, got[first],
           exp[first]);
    return false;
}

static bool H_CmpBf16Exact(const char* tag, const uint16_t* got, const uint16_t* exp, size_t n)
{
    size_t bad = 0;
    size_t first = 0;
    for (size_t i = 0; i < n; ++i) {
        if (got[i] != exp[i]) {
            if (bad == 0) {
                first = i;
            }
            ++bad;
        }
    }
    if (bad == 0) {
        printf("[M13]   %-28s PASS (bit-exact bf16, n=%zu)\n", tag, n);
        return true;
    }
    printf("[M13]   %-28s FAIL (%zu/%zu mismatch, first idx %zu: got %04x exp %04x)\n", tag, bad, n, first,
           static_cast<unsigned>(got[first]), static_cast<unsigned>(exp[first]));
    return false;
}

static bool H_CmpF32Bf16Ulp(const char* tag, const uint16_t* gotBits, const float* expF32, size_t n, int maxUlp)
{
    int worst = 0;
    size_t first = 0;
    size_t bad = 0;
    for (size_t i = 0; i < n; ++i) {
        const uint16_t eb = H_F32ToBf16(expF32[i]);
        const int ulp = std::abs(static_cast<int>(gotBits[i]) - static_cast<int>(eb));
        if (ulp > worst) {
            worst = ulp;
        }
        if (ulp > maxUlp) {
            if (bad == 0) {
                first = i;
            }
            ++bad;
        }
    }
    const bool ok = (bad == 0);
    printf("[M13]   %-28s %s (bf16 grid max ulp %d, %zu/%zu over %d ulp%s)\n", tag, ok ? "PASS" : "FAIL", worst, bad, n,
           maxUlp, ok ? "" : " → first idx printed below");
    if (!ok) {
        printf("[M13]     first over-tolerance idx %zu: got %04x exp(bf16) %04x\n", first,
               static_cast<unsigned>(gotBits[first]), static_cast<unsigned>(H_F32ToBf16(expF32[first])));
    }
    return ok;
}

static bool H_CmpBf16Rel(const char* tag, const uint16_t* got, const uint16_t* exp, size_t n, double relTol)
{
    double worst = 0.0;
    size_t worstIdx = 0;
    size_t bad = 0;
    size_t firstBad = 0;
    for (size_t i = 0; i < n; ++i) {
        const double g = H_Bf16ToF32(got[i]);
        const double e = H_Bf16ToF32(exp[i]);
        double rel;
        if (e == 0.0) {
            rel = (g == 0.0) ? 0.0 : 1.0;
        } else {
            rel = std::fabs(g - e) / std::fabs(e);
        }
        if (rel > worst) {
            worst = rel;
            worstIdx = i;
        }
        if (rel > relTol) {
            if (bad == 0) {
                firstBad = i;
            }
            ++bad;
        }
    }
    const bool ok = (bad == 0);
    printf("[M13]   %-28s %s (bf16 网格 max rel %.3g, 容差 %.0e, %zu/%zu 超差)\n", tag, ok ? "PASS" : "FAIL", worst,
           relTol, bad, n);
    if (!ok) {
        printf("[M13]     worst idx %zu: got %.6g exp %.6g\n", firstBad, H_Bf16ToF32(got[firstBad]),
               H_Bf16ToF32(exp[firstBad]));
    }
    return ok;
}

// bf16 半 ulp（按 |v| 的指数），用于「加数各自的网格」容差
static double H_HalfUlpBf16(double v)
{
    const double a = fabs(v);
    if (a <= 0.0) {
        return 0.0;
    }
    return exp2(floor(log2(a)) - 9.0);
}

// bf16 → bf16 的 ulp 级比较（用于「同一运算式但 fp32 计算次序不同」的段：允许 ≤2.5 半 ulp）
static bool H_CmpBf16UlpTol(const char* tag, const uint16_t* got, const uint16_t* exp, size_t n)
{
    size_t viol = 0;
    int worst = 0;
    const int maxUlp = 2;
    for (size_t i = 0; i < n; ++i) {
        // bf16 位距（同号时 = ulp 距离；异号时差值极大 → 必然越界）
        int d = static_cast<int>(got[i]) - static_cast<int>(exp[i]);
        if (d < 0) {
            d = -d;
        }
        if (d > worst) {
            worst = d;
        }
        if (d > maxUlp) {
            ++viol;
        }
    }
    const bool ok = (viol == 0);
    printf("[M13]   %-28s %s (bf16 位距 ≤%d ulp: 越界 %zu/%zu, 最大 %d ulp)\n", tag, ok ? "PASS" : "FAIL", maxUlp,
           viol, n, worst);
    return ok;
}

// 报告项（不判定）：与 float golden 的偏差统计
static bool H_ReportBf16Dev(const char* tag, const uint16_t* got, const uint16_t* exp, size_t n)
{
    double worstAbs = 0.0;
    double worstRel = 0.0;
    double rmsG = 0.0, rmsE = 0.0;
    for (size_t i = 0; i < n; ++i) {
        const double g = H_Bf16ToF32(got[i]);
        const double e = H_Bf16ToF32(exp[i]);
        const double ad = fabs(g - e);
        worstAbs = fmax(worstAbs, ad);
        if (fabs(e) > 1e-3) {
            worstRel = fmax(worstRel, ad / fabs(e));
        }
        rmsG += g * g;
        rmsE += e * e;
    }
    printf("[M13]   %-28s [报告] maxAbs %.4f, maxRel %.3f, rms dev %.4f vs golden %.4f\n", tag, worstAbs, worstRel,
           sqrt(rmsG / static_cast<double>(n)), sqrt(rmsE / static_cast<double>(n)));
    return true;
}

static bool H_CmpF32Abs(const char* tag, const float* got, const float* exp, size_t n, double tol)
{
    double worst = 0.0;
    size_t worstIdx = 0;
    for (size_t i = 0; i < n; ++i) {
        const double dd = std::fabs(static_cast<double>(got[i]) - static_cast<double>(exp[i]));
        if (dd > worst) {
            worst = dd;
            worstIdx = i;
        }
    }
    const bool ok = (worst <= tol);
    printf("[M13]   %-28s %s (max abs diff %.3g, 容差 %.0e, worst idx %zu)\n", tag, ok ? "PASS" : "FAIL", worst, tol,
           worstIdx);
    return ok;
}

static bool H_CmpF32BitExact(const char* tag, const float* got, const float* exp, size_t n)
{
    size_t bad = 0;
    size_t first = 0;
    for (size_t i = 0; i < n; ++i) {
        uint32_t a, b;
        __builtin_memcpy(&a, &got[i], 4);
        __builtin_memcpy(&b, &exp[i], 4);
        if (a != b) {
            if (bad == 0) {
                first = i;
            }
            ++bad;
        }
    }
    const bool ok = (bad == 0);
    printf("[M13]   %-28s %s (fp32 bit-exact, %zu/%zu mismatch)\n", tag, ok ? "PASS" : "FAIL", bad, n);
    if (!ok) {
        printf("[M13]     first idx %zu: got %.9g exp %.9g\n", first, got[first], exp[first]);
    }
    return ok;
}

// ============================================================
// w4a4 参考链（m3 方法论推广）：反量化「device 自己产出的」MXFP4 激活
//   （A_qx/A_scale、H_qx/H_scale）→ double GEMM → silu/gate → 逐段比对。
//   —— 这是量化段（GEMM/SwiGLU/combine）的严格 oracle：它验证 kernel 的 GEMM
//   数学、layout、permute/unpermute/combine/gating 与自己的量化输入一致。
//   与 float golden 的偏差单独作为「量化噪声预算」报告（w4a4 设计决定了
//   4bit 激活量化噪声无法被 float golden 的 bf16 网格容差包住，详见 README）。
// ============================================================

static double H_E2M1(uint8_t code)
{
    static const double kTab[8] = {0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0};
    return (code & 0x8) ? -kTab[code & 0x7] : kTab[code & 0x7];
}

static double H_E8M0(uint8_t b)
{
    return exp2(static_cast<double>(static_cast<int>(b)) - 127.0);
}

// 反量化 packed fp4 块：rows 行 × k 列（packedK = k/2），行 stride 可控
static void H_DequantFp4(const uint8_t* packed, const uint8_t* scale, size_t rows, size_t packedRowStride,
                         size_t scaleRowStride, size_t k, double* out)
{
    const size_t groups = k / M13::GROUP;
    for (size_t r = 0; r < rows; ++r) {
        const uint8_t* p = packed + r * packedRowStride;
        const uint8_t* sc = scale + r * scaleRowStride;
        double* o = out + r * k;
        for (size_t g = 0; g < groups; ++g) {
            const double s = H_E8M0(sc[g]);
            for (size_t j = 0; j < M13::GROUP / 2; ++j) {
                const uint8_t byte = p[g * (M13::GROUP / 2) + j];
                o[g * M13::GROUP + 2 * j] = H_E2M1(byte & 0x0F) * s;
                o[g * M13::GROUP + 2 * j + 1] = H_E2M1(byte >> 4) * s;
            }
        }
    }
}

// C[rows][n] = A[rows][k] @ W[n][k]^T（double）
static void H_DgemmNT(const double* a, const double* w, size_t rows, size_t n, size_t k, double* c)
{
    for (size_t i = 0; i < rows; ++i) {
        const double* ai = a + i * k;
        double* ci = c + i * n;
        for (size_t j = 0; j < n; ++j) {
            const double* wj = w + j * k;
            double acc = 0.0;
            for (size_t t = 0; t < k; ++t) {
                acc += ai[t] * wj[t];
            }
            ci[j] = acc;
        }
    }
}

// bf16 网格容差比较：device 输出是 bf16，参考是 double。
//   判据 |got - exp| <= relTol*|exp| + |bf16(exp) - exp| + 1e-9
//   —— 第二项正是「bf16 网格」允许量（参考值自身的 bf16 舍入），第一项给 fp32 累加次序差。
static bool H_CmpF64Bf16Rel(const char* tag, const uint16_t* gotBits, const double* expF64, size_t n, double relTol,
                            double absFloorUnused = 0.0)
{
    (void)absFloorUnused;
    double worstRatio = 0.0;
    double worstAbs = 0.0;
    size_t worstIdx = 0;
    size_t viol = 0;
    for (size_t i = 0; i < n; ++i) {
        const double g = H_Bf16ToF32(gotBits[i]);
        const double e = expF64[i];
        const double ad = fabs(g - e);
        const double grid = fabs(H_Bf16ToF32(H_F32ToBf16(static_cast<float>(e))) - e);
        const double tol = relTol * fabs(e) + grid + 1e-9;
        const double ratio = ad / tol;
        if (ratio > worstRatio) {
            worstRatio = ratio;
            worstIdx = i;
        }
        if (ad > worstAbs) {
            worstAbs = ad;
        }
        if (ad > tol) {
            ++viol;
        }
    }
    const bool ok = (viol == 0);
    printf("[M13]   %-28s %s (w4a4-ref: 越界 %zu/%zu, maxAbs %.3e, 最差占容差 %.2f, idx %zu)\n", tag,
           ok ? "PASS" : "FAIL", viol, n, worstAbs, worstRatio, worstIdx);
    return ok;
}

// 反量化 golden 权重（[N, K] → double），供参考链使用
static void H_DequantWeight(const uint8_t* packed, const uint8_t* scale, size_t n, size_t k, double* out)
{
    H_DequantFp4(packed, scale, n, k / 2, k / M13::GROUP, k, out);
}

// ============================================================
// Host：确定性 gamma + norm C 参考 + 单 case 运行/比对/dump
// ============================================================

// 数据集不含 norm 权重（golden 只覆盖 MoE slice）→ host 合成确定性 gamma ∈ [0.5, 1.5]
static void H_GenGamma(std::vector<uint16_t>& g, uint32_t seed)
{
    g.resize(M13::HIDDEN);
    for (uint32_t j = 0; j < M13::HIDDEN; ++j) {
        const uint32_t h = H_Hash(0, j, seed);
        const float v = 0.5f + 1.0f * (static_cast<float>((h >> 8) & 0xFFu) / 255.0f);
        g[j] = H_F32ToBf16(v);
    }
}

// m6 语义的 C 参考：xAdd = f32(x) + f32(res)；resOut = xAdd；y = bf16(xAdd·rstd·gamma)
template <typename RES_T>
static void H_RefNorm(const uint16_t* x, const RES_T* res, const uint16_t* gamma, float* resOut, uint16_t* y,
                      uint32_t rows)
{
    for (uint32_t i = 0; i < rows; ++i) {
        float sq = 0.0f;
        for (uint32_t j = 0; j < M13::HIDDEN; ++j) {
            float rv;
            if (sizeof(RES_T) == 2) {
                rv = H_Bf16ToF32(res[i * M13::HIDDEN + j]);
            } else {
                rv = static_cast<float>(res[i * M13::HIDDEN + j]);
            }
            const float a = H_Bf16ToF32(x[i * M13::HIDDEN + j]) + rv;
            resOut[i * M13::HIDDEN + j] = a;
            sq += a * a;
        }
        const float mean = sq / static_cast<float>(M13::HIDDEN);
        const float rstd = 1.0f / sqrtf(mean + 1e-6f);
        for (uint32_t j = 0; j < M13::HIDDEN; ++j) {
            const float t = resOut[i * M13::HIDDEN + j] * rstd * H_Bf16ToF32(gamma[j]);
            y[i * M13::HIDDEN + j] = H_F32ToBf16(t);
        }
    }
}

template <typename T>
static const T* WsPtr(const std::vector<uint8_t>& ws, size_t off)
{
    return reinterpret_cast<const T*>(ws.data() + off);
}

struct DumpItem {
    const char* name;
    size_t off;
    size_t bytes;
};

static void H_DumpWorkspace(const std::string& tag, const std::vector<uint8_t>& ws)
{
    const size_t H = M13::HIDDEN;
    const size_t E = M13::NUM_EXPERTS;
    const size_t N = M13::GU_N;
    const size_t I = M13::INTER;
    const DumpItem items[] = {
        {"xnorm", M13::WS_XNORM, M13::SZ_XNORM},
        {"res1", M13::WS_RES1, M13::SZ_RES1},
        {"logits", M13::WS_LOGITS, M13::SZ_LOGITS},
        {"ids", M13::WS_IDS, M13::SZ_IDS},
        {"topk_weights", M13::WS_W, M13::SZ_W},
        {"perm_src_token", M13::WS_PERM_SRC, M13::SZ_PERM},
        {"perm_expert", M13::WS_PERM_EXP, M13::SZ_PERM},
        {"expert_token_counts", M13::WS_COUNTS, M13::SZ_COUNTS},
        {"expert_offsets", M13::WS_OFFSETS, M13::SZ_OFFSETS},
        {"inv_slot", M13::WS_INV, M13::SZ_INV},
        {"w_tk_packed", M13::WS_WTK, M13::SZ_WTK},
        {"sgate", M13::WS_SGATE, M13::SZ_SGATE},
        {"x_sorted", M13::WS_XSORT, M13::SZ_XSORT},
        {"a_qx", M13::WS_AQ, M13::SZ_AQ},
        {"a_scale", M13::WS_AS, M13::SZ_AS},
        {"a_qx_shd", M13::WS_AQ_SHD, M13::SZ_AQ_SHD},
        {"a_scale_shd", M13::WS_AS_SHD, M13::SZ_AS_SHD},
        {"gu", M13::WS_GU, M13::SZ_GU},
        {"gu_shd", M13::WS_GU_SHD, M13::SZ_GU_SHD},
        {"h_swiglu", M13::WS_H, M13::SZ_H},
        {"h_swiglu_shd", M13::WS_H_SHD, M13::SZ_H_SHD},
        {"h_qx", M13::WS_HQ, M13::SZ_HQ},
        {"h_scale", M13::WS_HS, M13::SZ_HS},
        {"h_qx_shd", M13::WS_HQ_SHD, M13::SZ_HQ_SHD},
        {"h_scale_shd", M13::WS_HS_SHD, M13::SZ_HS_SHD},
        {"y_sorted", M13::WS_Y, M13::SZ_Y},
        {"y_shd", M13::WS_Y_SHD, M13::SZ_Y_SHD},
        {"routed_output", M13::WS_ROUTED, M13::SZ_ROUTED},
        {"shared_output", M13::WS_SHARED, M13::SZ_SHARED},
        {"moe_output", M13::WS_MOE, M13::SZ_MOE},
        {"y_final", M13::WS_YFINAL, M13::SZ_YFINAL},
        {"res2", M13::WS_RES2, M13::SZ_RES2},
    };
    for (const DumpItem& it : items) {
        char path[256];
        snprintf(path, sizeof(path), "%s_%s_device.bin", tag.c_str(), it.name);
        FILE* f = fopen(path, "wb");
        if (f == nullptr) {
            printf("[M13][dump] cannot write %s\n", path);
            continue;
        }
        fwrite(ws.data() + it.off, 1, it.bytes, f);
        fclose(f);
    }
    printf("[M13][dump] workspace (%u bytes) → *_device.bin; rows=%u hidden=%u gu_n=%u inter=%u\n",
           static_cast<unsigned>(M13::WS_BYTES), static_cast<unsigned>(M13::M_MAX), static_cast<unsigned>(H),
           static_cast<unsigned>(N), static_cast<unsigned>(I));
}

static bool H_RunCase(aclrtStream stream, const std::string& name, const CaseData& d, uint32_t sliceMode)
{
    const bool dump = (getenv("M13_DUMP") != nullptr);
    // 世界尺寸（核数一律 API 获取；查询失败即报错回退，不硬编码、不发起 0-block 启动）
    int64_t aicNum = 0;
    int64_t aivNum = 0;
    const aclError aicErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    const aclError aivErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum);
    if (aicErr != ACL_SUCCESS || aicNum <= 0) {
        printf("[M13][FAIL] aclrtGetDeviceInfo(AICORE_CORE_NUM) failed (err %d, aicNum %ld) — 不发起启动\n",
               static_cast<int>(aicErr), static_cast<long>(aicNum));
        return false;
    }
    if (aivErr != ACL_SUCCESS || aivNum != 2 * aicNum) {
        printf("[M13][WARN] VECTOR_CORE_NUM=%ld (err %d) != 2*AICORE=%ld — mix(1,2) 配对假设存疑\n",
               static_cast<long>(aivNum), static_cast<int>(aivErr), static_cast<long>(2 * aicNum));
    }
    const uint32_t numBlocks = static_cast<uint32_t>(aicNum);
    const size_t H = M13::HIDDEN;

    std::vector<uint16_t> gamma1;
    std::vector<uint16_t> gamma2;
    H_GenGamma(gamma1, 20260926u + 11u);
    H_GenGamma(gamma2, 20260926u + 22u);
    std::vector<uint16_t> resZero(static_cast<size_t>(M13::M_MAX) * H, 0);

    // ---- device 缓冲 ----
    void* wsDev = nullptr;
    aclrtMalloc(&wsDev, M13::WS_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(wsDev, M13::WS_BYTES, 0xCD, M13::WS_BYTES);   // 污染，防假 PASS
    uint32_t stageLimit = 8;
    uint32_t subLimit = 9;
    if (getenv("M13_STAGE_LIMIT") != nullptr) {
        stageLimit = static_cast<uint32_t>(atoi(getenv("M13_STAGE_LIMIT")));
    }
    if (getenv("M13_SUB_LIMIT") != nullptr) {
        subLimit = static_cast<uint32_t>(atoi(getenv("M13_SUB_LIMIT")));
    }
    void* xDev = nullptr; aclrtMalloc(&xDev, static_cast<size_t>(M13::M_MAX) * H * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    void* zeroDev = nullptr; aclrtMalloc(&zeroDev, resZero.size() * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    void* g1Dev = nullptr; aclrtMalloc(&g1Dev, H * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    void* g2Dev = nullptr; aclrtMalloc(&g2Dev, H * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    void* rwDev = nullptr; aclrtMalloc(&rwDev, d.routerW.size() * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    void* sgDev = nullptr; aclrtMalloc(&sgDev, d.sgateW.size() * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    void* wguDev = nullptr; aclrtMalloc(&wguDev, d.wGu.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* sguDev = nullptr; aclrtMalloc(&sguDev, d.sGu.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* wdnDev = nullptr; aclrtMalloc(&wdnDev, d.wDn.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* sdnDev = nullptr; aclrtMalloc(&sdnDev, d.sDn.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* wgushdDev = nullptr; aclrtMalloc(&wgushdDev, d.wGuShd.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* sgushdDev = nullptr; aclrtMalloc(&sgushdDev, d.sGuShd.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* wdnshdDev = nullptr; aclrtMalloc(&wdnshdDev, d.wDnShd.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* sdnshdDev = nullptr; aclrtMalloc(&sdnshdDev, d.sDnShd.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    if (wsDev == nullptr || xDev == nullptr || zeroDev == nullptr || g1Dev == nullptr || g2Dev == nullptr ||
        rwDev == nullptr || sgDev == nullptr || wguDev == nullptr || sguDev == nullptr || wdnDev == nullptr ||
        sdnDev == nullptr || wgushdDev == nullptr || sgushdDev == nullptr || wdnshdDev == nullptr ||
        sdnshdDev == nullptr) {
        printf("[M13][FAIL] aclrtMalloc failed (workspace %u bytes)\n", static_cast<unsigned>(M13::WS_BYTES));
        return false;
    }

    // H2D 拷贝（逐条检查返回值：拷贝失败时后续判据必然是误导性 FAIL）
    bool copyOk = true;
    auto h2d = [&copyOk](void* dev, const void* host, size_t bytes, const char* tag) {
        const aclError e = aclrtMemcpy(dev, bytes, host, bytes, ACL_MEMCPY_HOST_TO_DEVICE);
        if (e != ACL_SUCCESS) {
            printf("[M13][FAIL] aclrtMemcpy H2D failed for %s (err %d, %zu bytes)\n", tag, static_cast<int>(e),
                   bytes);
            copyOk = false;
        }
    };
    h2d(xDev, d.x.data(), d.x.size() * 2, "x");
    h2d(zeroDev, resZero.data(), resZero.size() * 2, "resZero");
    h2d(g1Dev, gamma1.data(), H * 2, "gamma1");
    h2d(g2Dev, gamma2.data(), H * 2, "gamma2");
    h2d(rwDev, d.routerW.data(), d.routerW.size() * 2, "router_weight");
    h2d(sgDev, d.sgateW.data(), d.sgateW.size() * 2, "shared_expert_gate_weight");
    h2d(wguDev, d.wGu.data(), d.wGu.size(), "experts.gate_up_proj");
    h2d(sguDev, d.sGu.data(), d.sGu.size(), "experts.gate_up_proj.scale");
    h2d(wdnDev, d.wDn.data(), d.wDn.size(), "experts.down_proj");
    h2d(sdnDev, d.sDn.data(), d.sDn.size(), "experts.down_proj.scale");
    h2d(wgushdDev, d.wGuShd.data(), d.wGuShd.size(), "shared_expert.gate_up");
    h2d(sgushdDev, d.sGuShd.data(), d.sGuShd.size(), "shared_expert.gate_up.scale");
    h2d(wdnshdDev, d.wDnShd.data(), d.wDnShd.size(), "shared_expert.down_proj");
    h2d(sdnshdDev, d.sDnShd.data(), d.sDnShd.size(), "shared_expert.down_proj.scale");
    if (!copyOk) {
        return false;
    }

    m13_moe_layer_kernel<<<numBlocks, 0, stream>>>(
        reinterpret_cast<uint8_t*>(wsDev), reinterpret_cast<uint8_t*>(xDev), reinterpret_cast<uint8_t*>(zeroDev),
        reinterpret_cast<uint8_t*>(g1Dev), reinterpret_cast<uint8_t*>(g2Dev), reinterpret_cast<uint8_t*>(rwDev),
        reinterpret_cast<uint8_t*>(sgDev), reinterpret_cast<uint8_t*>(wguDev), reinterpret_cast<uint8_t*>(sguDev),
        reinterpret_cast<uint8_t*>(wdnDev), reinterpret_cast<uint8_t*>(sdnDev), reinterpret_cast<uint8_t*>(wgushdDev),
        reinterpret_cast<uint8_t*>(sgushdDev), reinterpret_cast<uint8_t*>(wdnshdDev),
        reinterpret_cast<uint8_t*>(sdnshdDev), d.m, d.topk, sliceMode, stageLimit, subLimit);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("[M13][FAIL] %s mode=%u stageLimit=%u kernel launch/sync error %d\n", name.c_str(), sliceMode,
               stageLimit, static_cast<int>(err));
        printf("[M13] recent err msg: %s\n", aclGetRecentErrMsg());
        return false;
    }

    std::vector<uint8_t> ws(M13::WS_BYTES);
    if (aclrtMemcpy(ws.data(), M13::WS_BYTES, wsDev, M13::WS_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        printf("[M13][FAIL] aclrtMemcpy D2H of workspace (%u bytes) failed\n", M13::WS_BYTES);
        return false;
    }

    printf("[M13] case %s mode=%u (%s): m=%u E=%u topk=%u total=%u numBlocks=%u\n", name.c_str(), sliceMode,
           sliceMode ? "layer chain (router 消费 x_norm)" : "MoE slice (router 消费 golden x)", d.m, d.E, d.topk,
           d.total, numBlocks);

    if (dump) {
        char tag[128];
        snprintf(tag, sizeof(tag), "%s_mode%u", name.c_str(), sliceMode);
        printf("[M13][dump] tag %s\n", tag);
        H_DumpWorkspace(tag, ws);
        // 输入侧也落盘（check_ref.py 需要 x / gamma1 / gamma2 重算参考）
        {
            char pbuf[256];
            snprintf(pbuf, sizeof(pbuf), "%s_x_input_device.bin", tag);
            FILE* f = fopen(pbuf, "wb");
            if (f != nullptr) {
                fwrite(d.x.data(), 1, d.x.size() * 2, f);
                fclose(f);
            }
            snprintf(pbuf, sizeof(pbuf), "%s_gamma1_input_device.bin", tag);
            f = fopen(pbuf, "wb");
            if (f != nullptr) {
                fwrite(gamma1.data(), 1, gamma1.size() * 2, f);
                fclose(f);
            }
            snprintf(pbuf, sizeof(pbuf), "%s_gamma2_input_device.bin", tag);
            f = fopen(pbuf, "wb");
            if (f != nullptr) {
                fwrite(gamma2.data(), 1, gamma2.size() * 2, f);
                fclose(f);
            }
        }
        char meta[256];
        snprintf(meta, sizeof(meta), "%s_meta.txt", tag);
        FILE* f = fopen(meta, "w");
        if (f != nullptr) {
            fprintf(f, "case=%s\nm=%u\nslice_mode=%u\nE=%u\ntopk=%u\ntotal=%u\nhidden=%u\ngu_n=%u\ninter=%u\n",
                    name.c_str(), d.m, sliceMode, d.E, d.topk, d.total, M13::HIDDEN, M13::GU_N, M13::INTER);
            fclose(f);
        }
    }


    bool ok = true;
    // ---- 1. S1 m6#1：res1 bit-exact + x_norm bf16 网格 ----
    {
        std::vector<float> refRes(static_cast<size_t>(d.m) * H);
        std::vector<uint16_t> refY(static_cast<size_t>(d.m) * H);
        H_RefNorm<uint16_t>(d.x.data(), resZero.data(), gamma1.data(), refRes.data(), refY.data(), d.m);
        ok &= H_CmpF32BitExact("res1 (m6#1 fp32)", WsPtr<float>(ws, M13::WS_RES1), refRes.data(),
                               static_cast<size_t>(d.m) * H);
        ok &= H_CmpBf16Rel("x_norm (m6#1 y)", WsPtr<uint16_t>(ws, M13::WS_XNORM), refY.data(),
                           static_cast<size_t>(d.m) * H, 1e-2);
    }

    // ---- 2. slice 模式：逐 op 对齐 golden ----
    if (sliceMode == 0) {
        ok &= H_CmpF32Abs("router_logits", WsPtr<float>(ws, M13::WS_LOGITS), d.gLogits.data(), d.gLogits.size(),
                          2e-2);
        ok &= H_CmpI32Exact("topk_ids", WsPtr<int32_t>(ws, M13::WS_IDS), d.gIds.data(), d.gIds.size());
        {
            // device 的 topk_weights 是 fp32 存储 → 先 RNE 到 bf16 再与 golden 的 bf16 网格比 ulp
            const float* wdev = WsPtr<float>(ws, M13::WS_W);
            std::vector<uint16_t> wdevB16(d.gWeights.size());
            for (size_t i = 0; i < wdevB16.size(); ++i) {
                wdevB16[i] = H_F32ToBf16(wdev[i]);
            }
            ok &= H_CmpF32Bf16Ulp("topk_weights", wdevB16.data(), d.gWeights.data(), d.gWeights.size(), 1);
        }
        ok &= H_CmpI32Exact("perm_src_token", WsPtr<int32_t>(ws, M13::WS_PERM_SRC), d.gPermSrc.data(), d.total);
        ok &= H_CmpI32Exact("perm_expert", WsPtr<int32_t>(ws, M13::WS_PERM_EXP), d.gPermExp.data(), d.total);
        ok &= H_CmpI32Exact("expert_token_counts", WsPtr<int32_t>(ws, M13::WS_COUNTS), d.gCounts.data(), d.E);
        ok &= H_CmpBf16Exact("x_sorted", WsPtr<uint16_t>(ws, M13::WS_XSORT), d.gXSorted.data(),
                             d.gXSorted.size());
        // 报告项（不参与判定）：w4a4 kernel 与 float golden 的逐元素偏差 —— 4bit 激活量化
        // 噪声决定了它无法落在 bf16 网格容差内；真正的判据是下面的「golden 预算」检查
        // （|dev-gold| 必须被 |w4a4ref-gold| 解释）
        (void)H_ReportBf16Dev("routed_output vs float golden", WsPtr<uint16_t>(ws, M13::WS_ROUTED),
                              d.gRouted.data(), d.gRouted.size());
        (void)H_ReportBf16Dev("shared_output vs float golden", WsPtr<uint16_t>(ws, M13::WS_SHARED),
                              d.gShared.data(), d.gShared.size());
        (void)H_ReportBf16Dev("moe_output vs float golden", WsPtr<uint16_t>(ws, M13::WS_MOE), d.gMoe.data(),
                              d.gMoe.size());
    } else {
        printf("[M13]   %-28s (chain 模式：MoE 段输入为 x_norm，golden 不适用 → 由 check_ref.py 比对)\n",
               "golden comparison");
    }

    // ---- 3. 路由/重排内部一致性（两种模式都成立）----
    {
        const int32_t* ids = WsPtr<int32_t>(ws, M13::WS_IDS);
        const int32_t* w = reinterpret_cast<const int32_t*>(WsPtr<uint16_t>(ws, M13::WS_W));
        const int32_t* psrc = WsPtr<int32_t>(ws, M13::WS_PERM_SRC);
        const int32_t* pexp = WsPtr<int32_t>(ws, M13::WS_PERM_EXP);
        const int32_t* cnt = WsPtr<int32_t>(ws, M13::WS_COUNTS);
        const int32_t* inv = WsPtr<int32_t>(ws, M13::WS_INV);
        const int32_t* wtk = WsPtr<int32_t>(ws, M13::WS_WTK);
        bool cons = true;
        uint32_t cntChk[M13::NUM_EXPERTS] = {0, 0, 0, 0};
        for (uint32_t i = 0; i < d.total; ++i) {
            if (pexp[i] < 0 || pexp[i] >= static_cast<int32_t>(d.E) || psrc[i] < 0 ||
                psrc[i] >= static_cast<int32_t>(d.m)) {
                printf("[M13]   routing consistency FAIL: slot %u out of range (e=%d t=%d)\n", i, pexp[i], psrc[i]);
                cons = false;
                break;
            }
            cntChk[pexp[i]] += 1;
            if (i > 0 && (pexp[i] < pexp[i - 1] || (pexp[i] == pexp[i - 1] && psrc[i] <= psrc[i - 1]))) {
                printf("[M13]   routing consistency FAIL: slot %u not in (expert, token) grouped order\n", i);
                cons = false;
                break;
            }
        }
        for (uint32_t e = 0; e < d.E && cons; ++e) {
            if (static_cast<uint32_t>(cnt[e]) != cntChk[e]) {
                printf("[M13]   routing consistency FAIL: counts[%u]=%d but perm_expert has %u\n", e, cnt[e],
                       cntChk[e]);
                cons = false;
            }
        }
        for (uint32_t i = 0; i < d.total && cons; ++i) {
            const int32_t t = psrc[i];
            const int32_t e = pexp[i];
            int32_t k = -1;
            for (uint32_t kk = 0; kk < d.topk; ++kk) {
                if (ids[t * d.topk + kk] == e) {
                    k = static_cast<int32_t>(kk);
                    break;
                }
            }
            if (k < 0) {
                printf("[M13]   routing consistency FAIL: slot %u (t=%d e=%d) not in topk_ids\n", i, t, e);
                cons = false;
                break;
            }
            // inv_slot 约定：Y 的 padded 行号 = expert * M_MAX + 该专家内局部行号
            uint32_t offE = 0;
            for (int32_t ee = 0; ee < e; ++ee) {
                offE += static_cast<uint32_t>(cnt[ee]);
            }
            const int32_t expectInv = static_cast<int32_t>(e) * static_cast<int32_t>(M13::M_MAX) +
                                      static_cast<int32_t>(i - offE);
            if (inv[t * d.topk + k] != expectInv) {
                printf("[M13]   routing consistency FAIL: inv_slot[%d,%d]=%d expect %d\n", t, k, inv[t * d.topk + k],
                       expectInv);
                cons = false;
                break;
            }
            if (static_cast<uint16_t>(wtk[t * 16 + k] & 0xFFFF) !=
                H_F32ToBf16(reinterpret_cast<const float*>(w)[t * d.topk + k])) {
                printf("[M13]   routing consistency FAIL: w_tk_packed[%d,%d] != bf16(topk_weights)\n", t, k);
                cons = false;
                break;
            }
        }
        printf("[M13]   %-28s %s\n", "routing 内部一致性", cons ? "PASS" : "FAIL");
        ok &= cons;
    }

    // ---- 4. permute gather 逐位一致（源 = golden x | device x_norm）----
    {
        const uint16_t* src = (sliceMode == 0) ? d.x.data() : WsPtr<uint16_t>(ws, M13::WS_XNORM);
        const int32_t* psrc = WsPtr<int32_t>(ws, M13::WS_PERM_SRC);
        const uint16_t* xs = WsPtr<uint16_t>(ws, M13::WS_XSORT);
        size_t bad = 0;
        size_t first = 0;
        for (uint32_t i = 0; i < d.total; ++i) {
            if (psrc[i] < 0 || psrc[i] >= static_cast<int32_t>(d.m)) {
                if (bad == 0) {
                    first = i;
                }
                ++bad;
                continue;
            }
            for (uint32_t j = 0; j < H; ++j) {
                if (xs[i * H + j] != src[static_cast<size_t>(psrc[i]) * H + j]) {
                    if (bad == 0) {
                        first = i;
                    }
                    ++bad;
                    j = static_cast<uint32_t>(H);
                }
            }
        }
        printf("[M13]   %-28s %s (%zu/%u 行不一致)\n", "x_sorted gather exactness", bad == 0 ? "PASS" : "FAIL", bad,
               d.total);
        if (bad != 0) {
            printf("[M13]     first bad slot %zu (src token %d)\n", first, psrc[first]);
        }
        ok &= (bad == 0);
    }

    // ---- 5. S10 m6#2（残差 fp32 路径，小改 D）：从 device moe_out/res1 重算 ----
    {
        std::vector<float> refRes(static_cast<size_t>(d.m) * H);
        std::vector<uint16_t> refY(static_cast<size_t>(d.m) * H);
        const uint16_t* moe = WsPtr<uint16_t>(ws, M13::WS_MOE);
        const float* res1 = WsPtr<float>(ws, M13::WS_RES1);
        H_RefNorm<float>(moe, res1, gamma2.data(), refRes.data(), refY.data(), d.m);
        ok &= H_CmpF32BitExact("res2 (m6#2 fp32)", WsPtr<float>(ws, M13::WS_RES2), refRes.data(),
                               static_cast<size_t>(d.m) * H);
        ok &= H_CmpBf16Rel("y_final (m6#2 y)", WsPtr<uint16_t>(ws, M13::WS_YFINAL), refY.data(),
                           static_cast<size_t>(d.m) * H, 1e-2);
    }


    // ---- 6. w4a4 参考链（严格 oracle）：反量化 device 自己的 MXFP4 激活做 double GEMM，
    //         逐段（GU/H/Y/routed/shared/moe）比对；再按「量化噪声预算」检查与 float golden
    //         的偏差 —— |dev-gold| 必须被 |w4a4ref-gold| 解释（w4a4 设计下 float golden 的
    //         bf16 网格容差包不住 4bit 激活量化噪声，README「校验方法」一节有完整说明）----
    {
        const size_t H2 = H / 2;
        const uint8_t* aqx = WsPtr<uint8_t>(ws, M13::WS_AQ);
        const uint8_t* asc = WsPtr<uint8_t>(ws, M13::WS_AS);
        const uint8_t* aqxS = WsPtr<uint8_t>(ws, M13::WS_AQ_SHD);
        const uint8_t* ascS = WsPtr<uint8_t>(ws, M13::WS_AS_SHD);
        const uint8_t* hqx = WsPtr<uint8_t>(ws, M13::WS_HQ);
        const uint8_t* hs = WsPtr<uint8_t>(ws, M13::WS_HS);
        const uint8_t* hqxS = WsPtr<uint8_t>(ws, M13::WS_HQ_SHD);
        const uint8_t* hsS = WsPtr<uint8_t>(ws, M13::WS_HS_SHD);
        const uint16_t* guDev = WsPtr<uint16_t>(ws, M13::WS_GU);
        const uint16_t* guShdDev = WsPtr<uint16_t>(ws, M13::WS_GU_SHD);
        const uint16_t* hSwDev = WsPtr<uint16_t>(ws, M13::WS_H);
        const uint16_t* hSwShdDev = WsPtr<uint16_t>(ws, M13::WS_H_SHD);
        const uint16_t* yDev = WsPtr<uint16_t>(ws, M13::WS_Y);
        const uint16_t* yShdDev = WsPtr<uint16_t>(ws, M13::WS_Y_SHD);
        const uint16_t* routedDev = WsPtr<uint16_t>(ws, M13::WS_ROUTED);
        const uint16_t* sharedDev = WsPtr<uint16_t>(ws, M13::WS_SHARED);
        const uint16_t* moeDev = WsPtr<uint16_t>(ws, M13::WS_MOE);
        const int32_t* cnt = WsPtr<int32_t>(ws, M13::WS_COUNTS);
        const int32_t* inv = WsPtr<int32_t>(ws, M13::WS_INV);
        const float* wDev = WsPtr<float>(ws, M13::WS_W);
        const uint16_t* sigSrc = (sliceMode == 0) ? d.x.data() : WsPtr<uint16_t>(ws, M13::WS_XNORM);

        // counts 合法化（段序截断/dump 诊断时 counts 可能是脏数据 → 防越界分配）
        uint32_t cntSafe[M13::NUM_EXPERTS];
        uint32_t offs[M13::NUM_EXPERTS + 1];
        for (uint32_t e = 0; e < d.E; ++e) {
            const int32_t c = cnt[e];
            const bool good = (c >= 0 && c <= static_cast<int32_t>(M13::M_MAX));
            cntSafe[e] = good ? static_cast<uint32_t>(c) : 0;
            if (!good) {
                printf("[M13]   counts[%u]=%d 非法（段序截断或 kernel 未写）→ 参考链按 0 处理\n", e, c);
            }
        }
        offs[0] = 0;
        for (uint32_t e = 0; e < d.E; ++e) {
            offs[e + 1] = offs[e] + cntSafe[e];
        }
        uint32_t maxT = 1;
        for (uint32_t e = 0; e < d.E; ++e) {
            maxT = (cntSafe[e] > maxT) ? cntSafe[e] : maxT;
        }
        const size_t rowsRef = (maxT > d.m) ? maxT : d.m;   // shared 路径按 m 行使用同一缓冲

        std::vector<double> aD(static_cast<size_t>(M13::M_MAX) * H);
        std::vector<double> wD(static_cast<size_t>(M13::GU_N) * H);
        std::vector<double> guD(rowsRef * M13::GU_N);
        std::vector<double> hD(rowsRef * M13::INTER);
        std::vector<double> hqD(static_cast<size_t>(M13::M_MAX) * M13::INTER);
        std::vector<double> wDn(static_cast<size_t>(H) * M13::INTER);
        std::vector<double> yD(rowsRef * H);
        std::vector<double> yAll(static_cast<size_t>(M13::NUM_EXPERTS) * M13::M_MAX * H, 0.0);
        std::vector<uint16_t> yB16(rowsRef * H);
        std::vector<double> routedRef(static_cast<size_t>(M13::M_MAX) * H, 0.0);
        std::vector<double> sharedRef(static_cast<size_t>(M13::M_MAX) * H, 0.0);
        std::vector<double> moeRef(static_cast<size_t>(M13::M_MAX) * H, 0.0);
        std::vector<uint16_t> routedRefB16(static_cast<size_t>(M13::M_MAX) * H);
        std::vector<uint16_t> sharedRefB16(static_cast<size_t>(M13::M_MAX) * H);
        std::vector<uint16_t> moeRefB16(static_cast<size_t>(M13::M_MAX) * H);
        bool okRoutedPass = true;

        // ---- routed：逐槽位（gate_up → GU → SwiGLU → H → down → Y）----
        for (uint32_t slot = 0; slot < d.E; ++slot) {
            const uint32_t t = cntSafe[slot];
            if (t == 0) {
                continue;
            }
            H_DequantFp4(aqx + static_cast<size_t>(slot) * M13::M_MAX * H2,
                         asc + static_cast<size_t>(slot) * M13::M_MAX * M13::GU_SCALE_STRIDE, t, H2,
                         M13::GU_SCALE_STRIDE, H, aD.data());
            H_DequantWeight(d.wGu.data() + static_cast<size_t>(slot) * M13::GU_N * H2,
                            d.sGu.data() + static_cast<size_t>(slot) * M13::GU_N * M13::GU_SCALE_STRIDE, M13::GU_N, H,
                            wD.data());
            H_DgemmNT(aD.data(), wD.data(), t, M13::GU_N, H, guD.data());
            for (uint32_t lr = 0; lr < t; ++lr) {
                const uint16_t* guRowDev =
                    guDev + (static_cast<size_t>(slot) * M13::M_MAX + lr) * M13::GU_N;
                for (uint32_t i = 0; i < M13::INTER; ++i) {
                    // silu 的输入取 device 自己 bf16 化的 GU（逐 op 分段比对：每段的残差只含本段）
                    const double g = H_Bf16ToF32(guRowDev[i]);
                    const double u = H_Bf16ToF32(guRowDev[M13::INTER + i]);
                    hD[lr * M13::INTER + i] = (g / (1.0 + exp(-g))) * u;
                }
            }
            for (uint32_t lr = 0; lr < t; ++lr) {
                char tag[72];
                snprintf(tag, sizeof(tag), "GU slot%u (w4a4-ref)", slot);
                ok &= H_CmpF64Bf16Rel(tag, guDev + (static_cast<size_t>(slot) * M13::M_MAX + lr) * M13::GU_N,
                                      &guD[lr * M13::GU_N], M13::GU_N, 1e-2, 4e-3);
                snprintf(tag, sizeof(tag), "H slot%u (w4a4-ref)", slot);
                ok &= H_CmpF64Bf16Rel(tag, hSwDev + (offs[slot] + lr) * M13::INTER, &hD[lr * M13::INTER], M13::INTER,
                                      1e-2, 4e-3);
            }
            // down GEMM：消费 device 的 H_qx/scale（独立于参考的 H，验证 GEMM 与自有一致）
            H_DequantFp4(hqx + static_cast<size_t>(slot) * M13::M_MAX * (M13::INTER / 2),
                         hs + static_cast<size_t>(slot) * M13::M_MAX * M13::DN_SCALE_STRIDE, t, M13::INTER / 2,
                         M13::DN_SCALE_STRIDE, M13::INTER, hqD.data());
            H_DequantWeight(d.wDn.data() + static_cast<size_t>(slot) * H * (M13::INTER / 2),
                            d.sDn.data() + static_cast<size_t>(slot) * H * (M13::INTER / M13::GROUP), H, M13::INTER,
                            wDn.data());
            H_DgemmNT(hqD.data(), wDn.data(), t, H, M13::INTER, yD.data());
            for (uint32_t lr = 0; lr < t; ++lr) {
                char tag[72];
                snprintf(tag, sizeof(tag), "Y slot%u (w4a4-ref)", slot);
                ok &= H_CmpF64Bf16Rel(tag, yDev + (static_cast<size_t>(slot) * M13::M_MAX + lr) * H, &yD[lr * H], H,
                                      1e-2, 4e-3);
                for (uint32_t j = 0; j < H; ++j) {
                    yAll[(static_cast<size_t>(slot) * M13::M_MAX + lr) * H + j] = yD[lr * H + j];
                }
            }
        }

        // ---- routed 加权折叠（权重按 kernel 的 bf16 协议）----
        for (uint32_t t = 0; t < d.m; ++t) {
            for (uint32_t k = 0; k < d.topk; ++k) {
                const uint16_t wb = H_F32ToBf16(wDev[t * d.topk + k]);
                const double wv = H_Bf16ToF32(wb);
                const int32_t slotRow = inv[t * d.topk + k];
                if (slotRow < 0 || slotRow >= static_cast<int32_t>(M13::NUM_EXPERTS * M13::M_MAX)) {
                    printf("[M13]   routed fold FAIL: inv_slot[%u,%u]=%d out of range\n", t, k, slotRow);
                    ok = false;
                    continue;
                }
                for (uint32_t j = 0; j < H; ++j) {
                    // 用 device 自己的 bf16 Y（其正确性已由上面逐槽位 Y 比对确认）做折叠输入，
                    // 这样该比对的残差只含 fold 自身的 fp32 累加与输出 bf16 舍入
                    routedRef[t * H + j] +=
                        wv * H_Bf16ToF32(yDev[static_cast<size_t>(slotRow) * H + j]);
                }
            }
            for (uint32_t j = 0; j < H; ++j) {
                routedRefB16[t * H + j] = H_F32ToBf16(static_cast<float>(routedRef[t * H + j]));
            }
        }
        okRoutedPass &= H_CmpF64Bf16Rel("routed_output (w4a4-ref)", routedDev, routedRef.data(), static_cast<size_t>(d.m) * H,
                                        1e-2, 4e-3);
        ok &= okRoutedPass;

        // ---- shared 专家（1 槽位 = 每个 token 一行）----
        {
            H_DequantFp4(aqxS, ascS, d.m, H2, M13::GU_SCALE_STRIDE, H, aD.data());
            H_DequantWeight(d.wGuShd.data(), d.sGuShd.data(), M13::GU_N, H, wD.data());
            H_DgemmNT(aD.data(), wD.data(), d.m, M13::GU_N, H, guD.data());
            for (uint32_t r = 0; r < d.m; ++r) {
                const uint16_t* guRowDev = guShdDev + static_cast<size_t>(r) * M13::GU_N;
                for (uint32_t i = 0; i < M13::INTER; ++i) {
                    const double g = H_Bf16ToF32(guRowDev[i]);
                    const double u = H_Bf16ToF32(guRowDev[M13::INTER + i]);
                    hD[r * M13::INTER + i] = (g / (1.0 + exp(-g))) * u;
                }
            }
            for (uint32_t r = 0; r < d.m; ++r) {
                ok &= H_CmpF64Bf16Rel("GU_shd (w4a4-ref)", guShdDev + static_cast<size_t>(r) * M13::GU_N,
                                      &guD[r * M13::GU_N], M13::GU_N, 1e-2, 4e-3);
                ok &= H_CmpF64Bf16Rel("H_shd (w4a4-ref)", hSwShdDev + static_cast<size_t>(r) * M13::INTER,
                                      &hD[r * M13::INTER], M13::INTER, 1e-2, 4e-3);
            }
            H_DequantFp4(hqxS, hsS, d.m, M13::INTER / 2, M13::DN_SCALE_STRIDE, M13::INTER, hqD.data());
            H_DequantWeight(d.wDnShd.data(), d.sDnShd.data(), H, M13::INTER, wDn.data());
            H_DgemmNT(hqD.data(), wDn.data(), d.m, H, M13::INTER, yD.data());
            double sgateRef[M13::M_MAX];
            for (uint32_t r = 0; r < d.m; ++r) {
                double dot = 0.0;
                for (uint32_t j = 0; j < H; ++j) {
                    dot += H_Bf16ToF32(sigSrc[static_cast<size_t>(r) * H + j]) * H_Bf16ToF32(d.sgateW[j]);
                }
                sgateRef[r] = dot;
                // kernel 用 fp32 向量 Exp/Div 算 sigmoid → 参考按 fp32 复现（容差内等价）
                const float gv = 1.0f / (1.0f + expf(static_cast<float>(-dot)));
                for (uint32_t j = 0; j < H; ++j) {
                    // 与 kernel 同一运算式：fp32 乘积（-ffp-contract=off 禁 FMA），再 bf16 化
                    const float prod =
                        static_cast<float>(H_Bf16ToF32(yShdDev[static_cast<size_t>(r) * H + j])) *
                        static_cast<float>(gv);
                    sharedRef[r * H + j] = static_cast<double>(prod);
                    sharedRefB16[r * H + j] = H_F32ToBf16(prod);
                }
                ok &= H_CmpF64Bf16Rel("Y_shd (w4a4-ref)", yShdDev + static_cast<size_t>(r) * H, &yD[r * H], H, 1e-2,
                                      4e-3);
            }
            // sdesc 门：device 的裸点积 vs 参考
            {
                const float* sgDev = WsPtr<float>(ws, M13::WS_SGATE);
                double worst = 0.0;
                for (uint32_t r = 0; r < d.m; ++r) {
                    worst = fmax(worst, fabs(static_cast<double>(sgDev[r]) - sgateRef[r]));
                }
                const bool okSg = (worst <= 2e-2 * (fabs(sgateRef[0]) + 1.0));
                printf("[M13]   %-28s %s (sgate 裸点积 max abs diff %.3e)\n", "shared gate GEMV (w4a4-ref)",
                       okSg ? "PASS" : "FAIL", worst);
                ok &= okSg;
            }
            ok &= H_CmpF64Bf16Rel("shared_output (w4a4-ref)", sharedDev, sharedRef.data(), static_cast<size_t>(d.m) * H,
                                  1e-2, 4e-3);
        }

        // ---- moe = routed + shared ----
        for (uint32_t i = 0; i < d.m * H; ++i) {
            // kernel 内部：fp32(未 bf16 化 G) + fp32(routed bf16) → 参考按同一 fp32 加法
            const float shF = static_cast<float>(sharedRef[i]);
            const float rtF = static_cast<float>(H_Bf16ToF32(routedDev[i]));
            moeRef[i] = static_cast<double>(shF + rtF);
            moeRefB16[i] = H_F32ToBf16(shF + rtF);
        }
        // combine 段逐位判据：
        //   ① shared_dev 必须 = bf16(fp32(g · Y_shd_dev))（g = fp32 sigmoid，逐位一致）
        //   ② moe_dev   必须 = bf16(fp32(routed_dev) + G_fp32)（G_fp32 = 未 bf16 化的 gated shared）
        //   （fp32 乘法/加法次序差 → 极少数 at-tie 元素可能差 1 个 bf16 ulp，按 ulp 判据收敛）
        ok &= H_CmpBf16UlpTol("shared gating (fp32 product)", sharedDev, sharedRefB16.data(),
                              static_cast<size_t>(d.m) * H);
        ok &= H_CmpBf16UlpTol("moe combine (routed+G)", moeDev, moeRefB16.data(), static_cast<size_t>(d.m) * H);

        // ---- 与 float golden 的偏差预算：|dev-gold| 必须被 |w4a4ref-gold| 解释 ----
        {
            struct Gd {
                const char* tag;
                const uint16_t* dev;
                const uint16_t* gold;
                const uint16_t* refB16;
            };
            const Gd gds[] = {
                {"routed_output", routedDev, d.gRouted.data(), routedRefB16.data()},
                {"shared_output", sharedDev, d.gShared.data(), sharedRefB16.data()},
                {"moe_output", moeDev, d.gMoe.data(), moeRefB16.data()},
            };
            for (const Gd& gd : gds) {
                double devDev = 0.0;
                double devRef = 0.0;
                size_t viol = 0;
                size_t n = static_cast<size_t>(d.m) * H;
                for (size_t i = 0; i < n; ++i) {
                    const double gv = H_Bf16ToF32(gd.gold[i]);
                    const double ad = fabs(H_Bf16ToF32(gd.dev[i]) - gv);
                    const double ar = fabs(H_Bf16ToF32(gd.refB16[i]) - gv);
                    devDev = fmax(devDev, ad);
                    devRef = fmax(devRef, ar);
                    if (ad > 1.5 * ar + 0.02 * fabs(gv) + 5e-3) {
                        ++viol;
                    }
                }
                const bool okG = (viol == 0);
                printf("[M13]   %-28s %s (vs float golden: 偏差 %.4f ≤ 量化预算 %.4f(+容差); 违反 %zu/%zu)\n",
                       (std::string(gd.tag) + " [golden 预算]").c_str(), okG ? "PASS" : "FAIL", devDev, devRef, viol, n);
                ok &= okG;
            }
        }
    }

    aclrtFree(wsDev);
    aclrtFree(xDev);
    aclrtFree(zeroDev);
    aclrtFree(g1Dev);
    aclrtFree(g2Dev);
    aclrtFree(rwDev);
    aclrtFree(sgDev);
    aclrtFree(wguDev);
    aclrtFree(sguDev);
    aclrtFree(wdnDev);
    aclrtFree(sdnDev);
    aclrtFree(wgushdDev);
    aclrtFree(sgushdDev);
    aclrtFree(wdnshdDev);
    aclrtFree(sdnshdDev);
    return ok;
}

// ============================================================
// 量化段自检（任务 M32；用例 ④ 由 M50 补）：含 ±Inf/NaN/次正规 的激活 -> **复用 S5/S7 的
//   同一份 VecQuantStage 设备代码**（MxQuantComputeScale / MxQuantComputeDataFP4）-> 与 host
//   位精确参考逐字节比对。
//   两条实例化与正式链路同参：A 侧 <HIDDEN, GU_SCALE_STRIDE, false>（x->q）、
//   H 侧 <INTER, DN_SCALE_STRIDE, true>（gate|up->SwiGLU->q）。
//   非有限用例（M32 任务 ①②③）：1 = 整组 amax=+Inf；2 = 组内部分元素 Inf；3 = NaN 组；
//   M50 任务 ④：4 = 次正规/退化组（组 amax 指数域 < emax ⇒ halfScale = 0 ⇒ 组内码全 0）。
//   用例判据：device qx/scale 与 host 参考（官方 OCP 语义）逐字节一致；H 侧另比 SwiGLU。
// ============================================================

static constexpr uint16_t QS_POS_INF = 0x7F80;
static constexpr uint16_t QS_NEG_INF = 0xFF80;
static constexpr uint16_t QS_NAN_P = 0x7FC0;
static constexpr uint16_t QS_NAN_N = 0xFFC0;
static constexpr uint16_t QS_ONE = 0x3F80;    // bf16 1.0
static constexpr uint16_t QS_FOUR = 0x4080;   // bf16 4.0
// M50 新增用例（次正规/退化组）：bf16 次正规与最小正规 —— 组 amax 的指数域 < emax
static constexpr uint16_t QS_MIN_NORMAL = 0x0080;   // bf16 最小正规值 2^-126（指数域 = 1）
static constexpr uint16_t QS_SUB_GATE = 0x0600;     // bf16 2^-115（H 侧 SwiGLU 的 gate）
static constexpr uint16_t QS_SUB_UP = 0x3880;       // bf16 2^-14（H 侧 SwiGLU 的 up ⇒ 乘积 ≈ 2^-130 次正规）

// ---- 源激活生成（量化段输入域）：rows × K；SWIGLU=true 时源行是 gate|up 拼接（2K）----
//   每个输出 32-group 按模式覆盖量化角落（与 m2/m5 的自检生成同风格）：
//     0 : 零组——direct: 全 +0；swiglu: up=±0（与 gate 同号）-> 输出恒 +0（shared==0 路径）
//     1 : direct: amax=4.0 的 FP4 中点 tie 组（m2 同款 kPat）；swiglu: ±0.5/±1/±2/±3 小整数档
//     2 : 精确幂组（尾数 0）
//     其他: 指数窗双随机（组内相对窗 ≤31 档，覆盖 xs∈[4,8) 饱和区）
//   ★ 生成约束（避开已知 -0 角落，见 README「已知限制」）：除零组外，各组 amax 指数域 ≥ 3
//     （hs≠0，不做 x*0 的精确零乘积）；零组只含 +0（direct）或输出恒 +0（swiglu）；
//     swiglu 侧另保证 |silu(gate)*up| ≥ 2^-22（乘积不下溢到 0，否则 bf16 输出为 ±0；
//     下界由 mode 3 的 gate 指数窗 [e-6, e]（e∈[120,132]）与 up 指数窗 [eu-4, eu]（eu∈[122,126]）给出）。
static void H_GenQuantSrc(std::vector<uint16_t>& x, uint32_t rows, uint32_t k, bool swiglu, uint32_t seed)
{
    const uint32_t g = k / 32;
    const uint32_t rowLen = swiglu ? (2 * k) : k;
    x.assign(static_cast<size_t>(rows) * rowLen, 0);
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t grp = 0; grp < g; ++grp) {
            const uint32_t mode = H_Hash(i, grp, seed) % 8;
            uint16_t* gate = x.data() + static_cast<size_t>(i) * rowLen + grp * 32;
            uint16_t* up = swiglu ? (gate + k) : gate;
            if (mode == 0) {
                for (uint32_t j = 0; j < 32; ++j) {
                    const uint32_t h = H_Hash(i * 32 + j, grp, seed + 1);
                    if (swiglu) {
                        const uint32_t e = 2 + h % 60;
                        gate[j] = static_cast<uint16_t>((((h >> 8) & 1) << 15) | (e << 7) | ((h >> 9) & 0x7F));
                        up[j] = static_cast<uint16_t>(gate[j] & 0x8000);   // ±0，与 gate 同号 -> 输出 +0
                    } else {
                        gate[j] = 0x0000;                                   // 全 +0 零组
                    }
                }
                continue;
            }
            if (mode == 1) {
                if (swiglu) {
                    static const uint16_t kG[8] = {0x3F80, 0xBF80, 0x4000, 0xC000, 0x3F00, 0xBF00, 0x4040, 0xC040};
                    static const uint16_t kU[8] = {0x4000, 0x3F80, 0x4040, 0x3F00, 0xC000, 0xBF80, 0x4080, 0xC080};
                    for (uint32_t j = 0; j < 32; ++j) {
                        const uint32_t h = H_Hash(i * 32 + j, grp, seed + 2);
                        gate[j] = kG[h % 8];
                        up[j] = kU[(h >> 4) % 8];
                    }
                } else {
                    // m2 同款：amax=4.0（maxexp=0x4080 -> scale=1.0、halfScale=1.0），
                    // 7 个元素命中 FP4 档位中点/精确档，其余为 2^-126 量级的极小值（乘 1.0 后非零）
                    static const uint16_t kPat[7] = {0x4080, 0x3F00, 0x3FC0, 0x4020, 0x4060, 0x3F40, 0x3FE0};
                    for (uint32_t j = 0; j < 7; ++j) gate[j] = kPat[j];
                    for (uint32_t j = 7; j < 32; ++j) {
                        const uint32_t h = H_Hash(i * 32 + j, grp, seed + 3);
                        gate[j] = static_cast<uint16_t>(((h & 1) << 15) | (1u << 7) | ((h >> 1) & 0x7F));
                    }
                }
                continue;
            }
            if (mode == 2) {
                // 精确幂组：direct 的元素跨 15 档指数窗；swiglu 的 gate/up 都取中等量级幂
                //（|gate|∈[2^-7,1]、|up|∈[2^-7,0.5] -> 乘积 ≥ 2^-15，绝不下溢到 0）
                for (uint32_t j = 0; j < 32; ++j) {
                    const uint32_t hg = H_Hash(i * 32 + j, grp, seed + 5);
                    const uint32_t hu = H_Hash(i * 32 + j, grp, seed + 6);
                    if (swiglu) {
                        const uint32_t ge = 120 + (hg % 8);
                        const uint32_t ue = 120 + (hu % 7);
                        gate[j] = static_cast<uint16_t>((((hg >> 8) & 1) << 15) | (ge << 7));
                        up[j] = static_cast<uint16_t>((((hu >> 8) & 1) << 15) | (ue << 7));
                    } else {
                        const uint32_t e = 18 + H_Hash(i, grp, seed + 4) % 100;   // 组窗顶 18..117
                        const uint32_t ge = e - (hg % 16);                        // 相对窗 ≤15 档
                        gate[j] = static_cast<uint16_t>((((hg >> 8) & 1) << 15) | (ge << 7));
                    }
                }
                continue;
            }
            if (swiglu) {
                // gate/up 双随机，量级中等：|gate|∈[2^-13,2^5]、|up|∈[2^-9,2^-1]
                // -> 乘积 ∈ [2^-22, 2^4]，组内相对窗 ≈ 11 档：非零、覆盖 xs 饱和区
                const uint32_t e = 120 + H_Hash(i, grp, seed + 7) % 13;    // 120..132
                const uint32_t eu = 122 + H_Hash(i, grp, seed + 8) % 5;    // 122..126
                for (uint32_t j = 0; j < 32; ++j) {
                    const uint32_t hg = H_Hash(i * 32 + j, grp, seed + 9);
                    const uint32_t sub = (j == 0) ? 0 : (hg % 7);
                    const uint32_t ge = e - sub;
                    gate[j] = static_cast<uint16_t>((((hg >> 8) & 1) << 15) | (ge << 7) | ((hg >> 9) & 0x7F));
                    const uint32_t hu = H_Hash(i * 32 + j, grp, seed + 10);
                    const uint32_t usub = (j == 0) ? 0 : (hu % 5);
                    const uint32_t ue = eu - usub;
                    up[j] = static_cast<uint16_t>((((hu >> 8) & 1) << 15) | (ue << 7) | ((hu >> 9) & 0x7F));
                }
            } else {
                // direct 随机组（m2 同款）: 组内相对指数窗 ≤31 档、组 amax 指数域 e∈3..126
                //（j==0 固定为组最大元素 -> maxexp==e≥3 -> hs≠0；xs∈[2^-31,4) 非零）
                const uint32_t e = 3 + H_Hash(i, grp, seed + 7) % 124;
                for (uint32_t j = 0; j < 32; ++j) {
                    const uint32_t h = H_Hash(i * 32 + j, grp, seed + 8);
                    const uint32_t sub = (j == 0) ? 0 : (h % 32);
                    const uint32_t ge = (e > sub) ? (e - sub) : 3;
                    gate[j] = static_cast<uint16_t>((((h >> 8) & 1) << 15) | (ge << 7) | ((h >> 9) & 0x7F));
                }
            }
        }
    }
}

// ---- 非有限注入：注入组固定 grp%4==1（其余组保持正常取值，验证修复不外溢）----
//   SWIGLU=false：直接注入 x；SWIGLU=true：注入 gate|up 使源行经 SwiGLU 后为非有限
//     —— (gate=+Inf, up=1.0) -> silu(+Inf)=+Inf -> +Inf；(gate=4.0, up=-Inf) -> -Inf
static void H_InjectQuantInf(std::vector<uint16_t>& x, uint32_t rows, uint32_t k, bool swiglu, uint32_t seed,
                            uint32_t kind)
{
    if (kind == 0) return;
    const uint32_t g = k / 32;
    const uint32_t rowLen = swiglu ? (2 * k) : k;
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t grp = 1; grp < g; grp += 4) {
            uint16_t* gate = x.data() + static_cast<size_t>(i) * rowLen + grp * 32;
            uint16_t* up = swiglu ? (gate + k) : gate;
            if (kind == 1) {
                for (uint32_t j = 0; j < 32; ++j) {
                    gate[j] = QS_POS_INF;
                    up[j] = swiglu ? QS_ONE : QS_POS_INF;
                }
            } else if (kind == 2) {
                const uint32_t p0 = H_Hash(i, grp, seed + 11) % 32;
                const uint32_t p1 = (p0 + 1 + H_Hash(i, grp, seed + 12) % 31) % 32;   // 保证 p1 != p0
                gate[p0] = QS_POS_INF;
                up[p0] = swiglu ? QS_ONE : QS_POS_INF;
                gate[p1] = swiglu ? QS_FOUR : QS_NEG_INF;
                up[p1] = QS_NEG_INF;
            } else if (kind == 3) {
                for (uint32_t j = 0; j < 32; ++j) {
                    gate[j] = (j & 1) ? QS_NAN_P : QS_NAN_N;
                    // A 侧 `up` 与 `gate` 同址（rowLen 约定）⇒ 这条赋值把 ±NaN 统一成 +NaN：
                    // M50 归档 dump 实测 A 侧注入组整组 0x7FC0（README §5.4 的「0x7FC0/0xFFC0
                    // 交替」只对 H 侧成立）。行为保持不动，避免把「负 NaN 的符号位」这个既有
                    // 角落（README §6.10）拉进判据。
                    up[j] = swiglu ? QS_ONE : QS_NAN_P;
                }
            } else {
                // kind 4（M50）：次正规/退化组 —— 组内 amax 的 bf16 指数域 < emax 0x0100，
                // 官方 :402-403 把 maxexp 夹到 0x0100、:414 令 halfScale = 0 ⇒ 组内乘积恒 ±0
                // ⇒ data 码全 0（scale 字节 0）。
                //   A 侧（direct）：直接给 bf16 **正**次正规 0x0001..0x000F（含 +0）与一个最小
                //                  正规值 0x0080（指数域=1，同属被夹分支）；
                //   H 侧（swiglu）：gate=2^-115、up=2^-14 ⇒ silu(gate)·up = 2^-130，为**正次正规**
                //                   （两侧 fp32 参考位精确：exp(-2^-115)=1 ⇒ silu=g/2）。
                //   取值全非负 ⇒ 不触发 §6.10 的「零的符号位」角落（device Cast(-0)=nibble 8
                //   与 C 参考字面规则 `xs < 0` 的分歧），该角落不在 M50 判据范围内。
                for (uint32_t j = 0; j < 32; ++j) {
                    if (swiglu) {
                        gate[j] = QS_SUB_GATE;
                        up[j] = QS_SUB_UP;
                    } else {
                        gate[j] = (j == 31) ? QS_MIN_NORMAL : static_cast<uint16_t>(j % 16);
                    }
                }
            }
        }
    }
}

// ---- host 参考 1：SwiGLU（与设备 SwigluComputeTile 同序 fp32 五元组，RNE 回 bf16）----
static void H_RefSwiGlu(const uint16_t* x, uint16_t* y, uint32_t rows, uint32_t k)
{
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t j = 0; j < k; ++j) {
            const float g = H_Bf16ToF32(x[static_cast<size_t>(i) * 2 * k + j]);
            const float u = H_Bf16ToF32(x[static_cast<size_t>(i) * 2 * k + k + j]);
            const float silu = g / (1.0f + expf(-g));
            y[static_cast<size_t>(i) * k + j] = H_F32ToBf16(silu * u);
        }
    }
}

// ---- host 参考 2：官方 OCP MXFP4 量化（npu_dynamic_mx_quant round_mode="round",
//      scale_alg=0/OCP, group=32）——与 m2/m5 的 RefQuantMxfp4 逐行一致，含官方 :413 的
//      非有限 halfScale 覆盖（组 maxexp==0x7F80 -> scale=0xFF、halfScale=0x7F81）----
static uint8_t H_E2M1Code(float xs)
{
    static const float kMids[7] = {0.25f, 0.75f, 1.25f, 1.75f, 2.5f, 3.5f, 5.0f};
    const bool neg = xs < 0.0f;
    float a = neg ? -xs : xs;
    uint8_t idx = 0;
    while (idx < 7 && a >= kMids[idx]) ++idx;
    return static_cast<uint8_t>(neg ? (idx | 0x8) : idx);
}

static void H_RefQuantMxfp4(const uint16_t* x, uint8_t* qx, uint8_t* scaleRows, uint32_t rows, uint32_t k,
                            uint32_t scaleStride)
{
    const uint32_t g = k / 32;
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t grp = 0; grp < g; ++grp) {
            const uint16_t* xp = x + static_cast<size_t>(i) * k + grp * 32;
            uint16_t maxexp = 0;
            for (uint32_t j = 0; j < 32; ++j) {
                const uint16_t e = xp[j] & 0x7F80;
                if (e > maxexp) maxexp = e;
            }
            const bool isInf = (maxexp == 0x7F80);
            uint32_t me = maxexp;
            if (me < 0x0100u) me = 0x0100u;
            const uint32_t shared = me - 0x0100u;
            uint8_t sb = static_cast<uint8_t>(shared >> 7);
            if (isInf) sb = 0xFF;
            scaleRows[static_cast<size_t>(i) * scaleStride + grp] = sb;
            uint16_t hs = static_cast<uint16_t>(0x7F00u - shared);
            if (shared == 0) hs = 0;
            if (isInf) hs = 0x7F81;   // 官方 :413
            const float hsF = H_Bf16ToF32(hs);
            for (uint32_t j = 0; j < 32; j += 2) {
                const float xs0 = H_Bf16ToF32(xp[j]) * hsF;
                const float xs1 = H_Bf16ToF32(xp[j + 1]) * hsF;
                const uint8_t lo = H_E2M1Code(H_Bf16ToF32(H_F32ToBf16(xs0)));
                const uint8_t hi = H_E2M1Code(H_Bf16ToF32(H_F32ToBf16(xs1)));
                qx[static_cast<size_t>(i) * (k / 2) + (grp * 32 + j) / 2] =
                    static_cast<uint8_t>(lo | (hi << 4));
            }
        }
    }
}

// ---- 单实例化单用例：生成 -> 设备 -> 与 host 参考逐字节比对 ----
template <uint32_t K, uint32_t SCAL_STRIDE, bool SWIGLU>
static bool H_RunQuantSelfTest(aclrtStream stream, const char* side, uint32_t rows, uint32_t seed,
                               uint32_t infKind)
{
    const uint32_t k = K;
    const uint32_t rowLen = SWIGLU ? (2 * k) : k;
    const size_t srcBytes = static_cast<size_t>(rows) * rowLen * 2;
    const size_t swigluBytes = static_cast<size_t>(rows) * k * 2;
    const size_t qxBytes = static_cast<size_t>(rows) * (k / 2);
    const size_t sBytes = static_cast<size_t>(rows) * SCAL_STRIDE;

    std::vector<uint16_t> x(static_cast<size_t>(rows) * rowLen);
    std::vector<uint16_t> swigluDev(static_cast<size_t>(rows) * k, 0);
    std::vector<uint8_t> qxDev(qxBytes, 0);
    std::vector<uint8_t> sDev(sBytes, 0);
    H_GenQuantSrc(x, rows, k, SWIGLU, seed);
    H_InjectQuantInf(x, rows, k, SWIGLU, seed, infKind);

    void* srcD = nullptr;
    void* swigluD = nullptr;
    void* qxD = nullptr;
    void* sD = nullptr;
    aclrtMalloc(&srcD, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&swigluD, swigluBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&qxD, qxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&sD, sBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(srcD, srcBytes, x.data(), srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(swigluD, swigluBytes, 0, swigluBytes);
    aclrtMemset(qxD, qxBytes, 0, qxBytes);
    aclrtMemset(sD, sBytes, 0, sBytes);

    m13_quant_selftest_kernel<K, SCAL_STRIDE, SWIGLU><<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(srcD), reinterpret_cast<uint8_t*>(swigluD), reinterpret_cast<uint8_t*>(qxD),
        reinterpret_cast<uint8_t*>(sD), rows);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("[M13][FAIL] qs %s rows=%u seed=%u inf=%u launch/sync error %d\n", side, rows, seed, infKind,
               static_cast<int>(err));
        return false;
    }
    aclrtMemcpy(swigluDev.data(), swigluBytes, swigluD, swigluBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(qxDev.data(), qxBytes, qxD, qxBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(sDev.data(), sBytes, sD, sBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    // (1) SWIGLU=true：设备 SwiGLU vs host 参考（≤1 bf16 ULP；非有限归类必须一致）
    uint32_t swigluUlp = 0;
    size_t swigluExact = 0, nonFinMismatch = 0;
    if (SWIGLU) {
        std::vector<uint16_t> swigluRef(static_cast<size_t>(rows) * k, 0);
        H_RefSwiGlu(x.data(), swigluRef.data(), rows, k);
        for (size_t t = 0; t < swigluRef.size(); ++t) {
            const uint16_t a = swigluDev[t];
            const uint16_t b = swigluRef[t];
            const bool aInf = (a & 0x7FFF) == 0x7F80;
            const bool bInf = (b & 0x7FFF) == 0x7F80;
            const bool aNan = ((a & 0x7F80) == 0x7F80) && ((a & 0x007F) != 0);
            const bool bNan = ((b & 0x7F80) == 0x7F80) && ((b & 0x007F) != 0);
            uint32_t d = 0xFFFF;
            if (aInf && bInf) {
                d = (a == b) ? 0 : 1;
            } else if (aNan && bNan) {
                d = 0;                       // NaN 符号/payload 不参与比对
            } else if (!aNan && !bNan && !aInf && !bInf) {
                const int32_t dd = static_cast<int32_t>(a) - static_cast<int32_t>(b);
                d = static_cast<uint32_t>(dd < 0 ? -dd : dd);
                if ((a & 0x7FFF) == 0 && (b & 0x7FFF) == 0) d = 0;   // ±0 同档
            }
            if (d == 0) ++swigluExact;
            if (d > swigluUlp) swigluUlp = d;
            const bool an = aInf || aNan;
            const bool bn = bInf || bNan;
            if (an != bn) ++nonFinMismatch;
        }
    }

    // (2) 量化：host 参考作用在**设备自己的**量化输入上（H 侧即设备 SwiGLU 输出，m5 同口径），
    //     逐字节比对 qx 与 scale 每行前 K/32 字节
    const uint16_t* qsrc = SWIGLU ? swigluDev.data() : x.data();
    std::vector<uint8_t> refQx(qxBytes, 0);
    std::vector<uint8_t> refS(sBytes, 0);
    H_RefQuantMxfp4(qsrc, refQx.data(), refS.data(), rows, k, SCAL_STRIDE);

    size_t badQx = 0, badScale = 0, scaleOverrun = 0, badNibbleInInfGroup = 0, firstBad = 0;
    for (size_t t = 0; t < qxBytes; ++t) {
        if (qxDev[t] != refQx[t]) {
            if (badQx == 0) firstBad = t;
            ++badQx;
        }
    }
    const uint32_t g = k / 32;
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t grp = 0; grp < g; ++grp) {
            if (sDev[static_cast<size_t>(i) * SCAL_STRIDE + grp] != refS[static_cast<size_t>(i) * SCAL_STRIDE + grp]) {
                ++badScale;
            }
        }
        for (uint32_t grp = g; grp < SCAL_STRIDE; ++grp) {   // 行内 K/32 之后必须未被写（预置 0）
            if (sDev[static_cast<size_t>(i) * SCAL_STRIDE + grp] != 0) ++scaleOverrun;
        }
    }
    // 非有限组见证：device 侧这些组的 nibble 应全 0（修复前为 ±6 饱和码 0x7/0xF）
    if (infKind != 0) {
        for (uint32_t i = 0; i < rows; ++i) {
            for (uint32_t grp = 1; grp < g; grp += 4) {
                for (uint32_t j = 0; j < 32; ++j) {
                    const size_t byte = static_cast<size_t>(i) * (k / 2) + (grp * 32 + j) / 2;
                    const uint8_t nib = (j & 1) ? (qxDev[byte] >> 4) : (qxDev[byte] & 0x0F);
                    if (nib != 0) ++badNibbleInInfGroup;
                }
            }
        }
    }

    const bool ok = (badQx == 0) && (badScale == 0) && (scaleOverrun == 0) && (swigluUlp <= 1) &&
                    (nonFinMismatch == 0) && (badNibbleInInfGroup == 0);
    printf("[M13]   %-30s %s (K=%u SS=%u rows=%u seed=%u inf=%u: qx %zu B / scale %zu B bit-exact, "
           "swiglu maxULP=%u 非有限不一致=%zu, 非有限组 nibble 非零=%zu)\n",
           ("qs " + std::string(side) + " 量化段").c_str(), ok ? "PASS" : "FAIL", k, SCAL_STRIDE, rows, seed,
           infKind, qxBytes, static_cast<size_t>(rows) * g, swigluUlp, nonFinMismatch, badNibbleInInfGroup);
    if (!ok) {
        printf("[M13]     badQx=%zu (first byte %zu: got 0x%02x exp 0x%02x) badScale=%zu scaleOverrun=%zu "
               "swigluExact=%zu\n",
               badQx, firstBad, badQx ? qxDev[firstBad] : 0, badQx ? refQx[firstBad] : 0, badScale, scaleOverrun,
               swigluExact);
    }

    // dump（M13_QS_DUMP=1）：供离线复跑/独立见证
    if (getenv("M13_QS_DUMP") != nullptr) {
        char path[256];
        auto wr = [&](const char* what, const void* buf, size_t n) {
            snprintf(path, sizeof(path), "qs_%s_i%u_r%u_s%u_%s.bin", side, infKind, rows, seed, what);
            FILE* f = fopen(path, "wb");
            if (f != nullptr) {
                fwrite(buf, 1, n, f);
                fclose(f);
            }
        };
        wr("x", x.data(), srcBytes);
        wr("qx_device", qxDev.data(), qxBytes);
        wr("scale_device", sDev.data(), sBytes);
        wr("qx_ref", refQx.data(), qxBytes);
        wr("scale_ref", refS.data(), sBytes);
        if (SWIGLU) wr("swiglu_device", swigluDev.data(), swigluBytes);
    }

    aclrtFree(srcD);
    aclrtFree(swigluD);
    aclrtFree(qxD);
    aclrtFree(sD);
    return ok;
}

// ---- 自检入口（无需数据集）：A 侧/H 侧 × rows × seed × {基线, ①②③ 非有限} ----
static bool H_RunQuantSelfTestAll(aclrtStream stream)
{
    const uint32_t rowsSet[] = {1, 64};
    const uint32_t seeds[] = {0, 1};
    bool ok = true;
    for (uint32_t seed : seeds) {
        for (uint32_t rows : rowsSet) {
            for (uint32_t infKind = 0; infKind <= 4; ++infKind) {
                ok &= H_RunQuantSelfTest<M13::HIDDEN, M13::GU_SCALE_STRIDE, false>(stream, "A", rows, seed, infKind);
                ok &= H_RunQuantSelfTest<M13::INTER, M13::DN_SCALE_STRIDE, true>(stream, "H", rows, seed, infKind);
            }
        }
    }
    printf("[M13]   %-30s %s\n", "量化段自检（含 ±Inf/NaN/次正规 用例）", ok ? "PASS" : "FAIL");
    return ok;
}

int32_t main(int32_t argc, char* argv[])
{
    // 子命令 quant-inf（任务 M32；用例 ④ 由 M50 补）：跑量化段自检（含 ±Inf/NaN/次正规 用例）
    const bool quantSelfTest = (argc >= 2 && std::string(argv[1]) == "quant-inf");

    std::string dataRoot = "tools/golden/data";
    std::vector<std::string> cases;
    if (!quantSelfTest) {
        dataRoot = (argc >= 2) ? argv[1] : "tools/golden/data";
        for (int i = 2; i < argc; ++i) {
            cases.emplace_back(argv[i]);
        }
        if (cases.empty()) {
            cases = {"m1", "m33"};   // 任务书：m=1 与 m=33 两组
        }
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool allOk = true;
    if (quantSelfTest) {
        allOk &= H_RunQuantSelfTestAll(stream);
    } else {
        for (const std::string& nm : cases) {
            CaseData d;
            if (!H_LoadDataset(dataRoot + "/" + nm, d)) {
                allOk = false;
                continue;
            }
            // mode 0 = MoE slice 逐 op 对 golden；mode 1 = 全层链（router 消费 x_norm）
            allOk &= H_RunCase(stream, nm, d, 0);
            allOk &= H_RunCase(stream, nm, d, 1);
        }
    }
    printf("[M13] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
