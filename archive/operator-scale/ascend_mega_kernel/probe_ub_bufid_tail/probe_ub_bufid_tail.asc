    {"neg_skipse3_N1",     1, 1, 1, 1, 1, 0, 1, 0, 0, "skipRlsE3 + N=1 ⇒ 无第二次 acq，应正常返回（对照）"},
    {"neg_skipse3_2id_N1", 1, 1, 0, 1, 1, 0, 1, 0, 0, "skipRlsE3 + 两个 id + N=1 ⇒ 应正常返回（对照）"},
    {"ctrl_e3rls_m3",      1, 3, 1, 1, 1, 0, 0, 0, 0, "每工作项 3 次交接 + 保留 MTE3 release（对照组）"},
    {"neg_skipse3_m3",     1, 3, 1, 1, 1, 0, 1, 0, 0, "skipRlsE3 + 每工作项 3 次交接 ⇒ 看是否卡在第 2 次交接"},
};
static const uint32_t NTAIL = static_cast<uint32_t>(sizeof(TAIL_VARS) / sizeof(TAIL_VARS[0]));

struct SpVar {
    const char* name;
    uint32_t nIter, pipeSel, drainLast, tailApi, flushPipeBar, tagShift;
    const char* note;
};

// drainLast/tailApi 是历史 release 档位键；全项目 all-false 政策下 RlsApi 恒 false，不再按它们分派。
// flushPipeBar: 0=无  1=仅收尾排空  2=**两次同 pipe op 之间**排空（docs/06 的「排空配方」）
static const SpVar SP_VARS[] = {
    {"v_drain_8",      8, 0, 1, 1, 0, 0, "PIPE_V 同 pipe：Acq/写/Rls(false) ×8，最终应=8th"},
    {"v_imm_8",        8, 0, 0, 1, 0, 0, "PIPE_V 同 pipe，逐轮 Rls(false) ×8"},
    {"v_n16",         16, 0, 1, 1, 0, 0, "PIPE_V 同 pipe ×16"},
    {"v_pb_between_8", 8, 0, 1, 1, 2, 0, "PIPE_V 同 pipe + 两次 op 之间 PipeBarrier<PIPE_V>"},
    {"mte2_drain_8",   8, 1, 1, 1, 0, 0, "PIPE_MTE2 同 pipe：Acq/DataCopy/Rls(false) ×8，最终应=8th"},
    {"mte2_imm_8",     8, 1, 0, 1, 0, 0, "PIPE_MTE2 同 pipe，逐轮 Rls(false) ×8"},
    {"mte2_pb_end_8",  8, 1, 1, 1, 1, 0, "PIPE_MTE2 同 pipe + 仅收尾 PipeBarrier"},
    {"mte2_pb_between_8", 8, 1, 1, 1, 2, 0, "PIPE_MTE2 同 pipe + 两次 op 之间 PipeBarrier（docs/06 配方）"},
    {"mte2_drain_n16", 16, 1, 1, 1, 0, 0, "PIPE_MTE2 同 pipe ×16（false）"},
    {"mte2_imm_n16",   16, 1, 0, 1, 0, 0, "PIPE_MTE2 同 pipe ×16（false）"},
    {"mte2_pb_between_n16", 16, 1, 1, 1, 2, 0, "PIPE_MTE2 同 pipe ×16 + 两次 op 之间 PipeBarrier"},
    {"mte2_neg_shift", 8, 1, 1, 1, 0, 1, "可控变红：源的期望值偏 1 ⇒ 判据应红"},
    {"v_neg_shift",    8, 0, 1, 1, 0, 1, "可控变红（V 路径）：写出值偏 1 ⇒ 判据应红"},
    // ---- M133 变体② 第二构造（历史 release 档位键；全项目 all-false 政策下均落 false） ----
    {"mte2_tail_imm",     8, 1, 1, 0, 0, 0, "收尾 release 原 mode0(false) 档（现统一 false）"},
    {"mte2_tail_unlockB", 8, 1, 1, 2, 0, 0, "收尾 release 原 asc_unlock BLOCK 档（现统一 false）"},
    {"mte2_tail_unlockNB",8, 1, 1, 3, 0, 0, "收尾 release 原 asc_unlock NON_BLOCK 档（现统一 false）"},
    {"v_tail_imm",        8, 0, 1, 0, 0, 0, "收尾 release 原 mode0(false) 档（现统一 false）"},
};
static const uint32_t NSP = static_cast<uint32_t>(sizeof(SP_VARS) / sizeof(SP_VARS[0]));

int FindTail(const char* s)
{
    for (uint32_t i = 0; i < NTAIL; ++i) {
        if (strcmp(s, TAIL_VARS[i].name) == 0) return static_cast<int>(i);
    }
    return -1;
}
int FindSp(const char* s)
{
    for (uint32_t i = 0; i < NSP; ++i) {
        if (strcmp(s, SP_VARS[i].name) == 0) return static_cast<int>(i);
    }
    return -1;
}

// 期望 tag（host 复算，与 kernel 同一公式）
inline float HTag(uint32_t aiv, uint32_t iter, uint32_t shift)
{
    return static_cast<float>(aiv * 4096u + iter + 1u + shift);
}

// 输出布局：copyForm==3 时行距 = COLS（连续），否则 = PITCH
uint32_t OutPitch(uint32_t copyForm) { return (copyForm == 3u) ? COLS : PITCH; }

struct Counts {
    uint32_t elems = 0, match = 0, stale = 0, zero = 0, other = 0;
    int mismatchedTiles = 0;
    std::vector<int> tileOK;   // 每 tile: 1=全对, 0=有错, -1=未触碰（sentinel）
    std::vector<int> tagHist;  // 错元素「等于第几个 op 的 tag」的直方图（诊断用）
    uint32_t tagHistOther = 0;
};

Counts CheckTail(const std::vector<float>& hOut, uint32_t nAiv, uint32_t nIter, uint32_t perItem,
                 uint32_t copyForm)
{
    Counts c;
    const uint32_t pitch = OutPitch(copyForm);
    const uint32_t nTile = nIter * perItem;
    c.tileOK.assign(static_cast<size_t>(nAiv) * nTile, -1);
    c.tagHist.assign(nTile, 0);
    for (uint32_t a = 0; a < nAiv; ++a) {
        for (uint32_t t = 0; t < nTile; ++t) {
            const float exp = HTag(a, t, 0);
            const uint64_t base = (static_cast<uint64_t>(a) * nTile + t) * PLANE_ELEMS;
            bool all = true;
            for (uint32_t r = 0; r < ROWS; ++r) {
                for (uint32_t cc = 0; cc < COLS; ++cc) {
                    const float v = hOut[base + r * pitch + cc];
                    ++c.elems;
                    if (v == exp) { ++c.match; continue; }
                    all = false;
                    if (v == 0.0f) { ++c.zero; continue; }
                    bool tagged = false;
                    for (uint32_t j = 0; j < nTile; ++j) {
                        if (v == HTag(a, j, 0)) { ++c.tagHist[j]; tagged = true; break; }
                    }
                    if (!tagged) ++c.tagHistOther;
                    if (t > 0u && v == HTag(a, t - 1, 0)) ++c.stale;
                }
            }
            c.tileOK[static_cast<size_t>(a) * nTile + t] = all ? 1 : 0;
            if (!all) ++c.mismatchedTiles;
        }
    }
    return c;
}

Counts CheckSp(const std::vector<float>& hOut, uint32_t nAiv, uint32_t nIter)
{
    // 期望：最终 UB == 最后一次 op 的 tag = HTag(a, nIter-1, 0)（逐元素）
    Counts c;
    c.tileOK.assign(nAiv, -1);
    c.tagHist.assign(nIter, 0);
    for (uint32_t a = 0; a < nAiv; ++a) {
        const float exp = HTag(a, nIter - 1, 0);
        const uint64_t base = static_cast<uint64_t>(a) * TILE_ELEMS;
        bool all = true;
        for (uint32_t e = 0; e < TILE_ELEMS; ++e) {
            const float v = hOut[base + e];
            ++c.elems;
            if (v == exp) { ++c.match; continue; }
            all = false;
            if (v == 0.0f) { ++c.zero; continue; }
            bool tagged = false;
            for (uint32_t j = 0; j < nIter; ++j) {
                if (v == HTag(a, j, 0)) { ++c.tagHist[j]; tagged = true; break; }
            }
            if (!tagged) ++c.tagHistOther;
        }
        c.tileOK[a] = all ? 1 : 0;
        if (!all) ++c.mismatchedTiles;
    }
    return c;
}

}  // namespace

int main(int argc, char** argv)
{
    if (argc >= 2 && strcmp(argv[1], "list") == 0) {
        // list <tail|sp>：只打印变体名（供 run_probe.sh 驱动）
        const bool t = (argc >= 3 && strcmp(argv[2], "tail") == 0);
        if (t) {
            for (uint32_t i = 0; i < NTAIL; ++i) printf("%s\n", TAIL_VARS[i].name);
        } else {
            for (uint32_t i = 0; i < NSP; ++i) printf("%s\n", SP_VARS[i].name);
        }
        return 0;
    }
    if (argc < 2) {
        printf("usage: %s <tail|sp> <variantName|idx> [runNo] [outdir] [--trace]\n", argv[0]);
        printf("tail variants:\n");
        for (uint32_t i = 0; i < NTAIL; ++i) printf("  %2u  %-16s  %s\n", i, TAIL_VARS[i].name, TAIL_VARS[i].note);
        printf("sp variants:\n");
        for (uint32_t i = 0; i < NSP; ++i) printf("  %2u  %-16s  %s\n", i, SP_VARS[i].name, SP_VARS[i].note);
        return 2;
    }
    const bool isTail = (strcmp(argv[1], "tail") == 0);
    const bool isSp = (strcmp(argv[1], "sp") == 0);
    if (!isTail && !isSp) { fprintf(stderr, "mode must be tail|sp\n"); return 2; }

    const int vi = isTail ? FindTail(argv[2]) : FindSp(argv[2]);
    if (vi < 0) { fprintf(stderr, "unknown variant %s\n", argv[2]); return 2; }
    const int runNo = (argc >= 4) ? atoi(argv[3]) : 0;
    const char* outdir = (argc >= 5 && argv[4][0] != '-') ? argv[4] : ".";
    bool traceFlag = false;
    for (int i = 1; i < argc; ++i) if (strcmp(argv[i], "--trace") == 0) traceFlag = true;

    if (aclInit(nullptr) != ACL_SUCCESS) { printf("SUMMARY launch=FAILED aclInit err rc=2\n"); return 2; }
    aclrtSetDevice(0);
    int64_t aicNum = 0;
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    if (aicNum <= 0) aicNum = 28;
    const uint32_t blocks = 1u;                 // 最小复现：1 AIC = 2 AIV
    const uint32_t nAiv = 2u * blocks;

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    int rc = 0;
    if (isTail) {
        const TailVar& V = TAIL_VARS[vi];
        const uint32_t perItem = (V.handoffs == 0u) ? 1u : V.handoffs;
        const uint32_t nTile = V.nIter * perItem;
        const size_t outElems = static_cast<size_t>(nAiv) * nTile * PLANE_ELEMS;
        const size_t outBytes = outElems * 4u;
        void* dOut = nullptr;
        if (aclrtMalloc(&dOut, outBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) { printf("malloc fail\n"); return 2; }
        aclrtMemset(dOut, outBytes, 0xCD, outBytes);
        printf("[probe] mode=tail variant=%s vi=%d run=%d N=%u handoffs=%u idSame=%u apiV=%u apiE3=%u "
               "skipVrel=%u skipE3rel=%u copyForm=%u trace=%d blocks=%u\n", V.name, vi, runNo, V.nIter, perItem,
               V.idSame, V.apiV, V.apiE3, V.skipRlsV, V.skipRlsE3, V.copyForm, traceFlag ? 1 : 0, blocks);
        fflush(stdout);
        probe_tail_kernel<<<blocks, 0, stream>>>((uint8_t*)dOut, V.nIter, perItem, V.idSame, V.apiV, V.apiE3,
                                                 V.skipRlsV, V.skipRlsE3, V.copyForm, V.tagShift,
                                                 traceFlag ? 1u : 0u);
        const aclError err = aclrtSynchronizeStream(stream);
        if (err != ACL_SUCCESS) {
            printf("SUMMARY mode=tail variant=%s run=%d launch=FAILED err=%d rc=2\n", V.name, runNo, (int)err);
            aclrtDestroyStream(stream); return 2;
        }
        std::vector<float> hOut(outElems, 0.0f);
        aclrtMemcpy(hOut.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        const Counts c = CheckTail(hOut, nAiv, V.nIter, perItem, V.copyForm);
        const bool pass = (c.mismatchedTiles == 0);
        printf("SUMMARY mode=tail variant=%s run=%d N=%u tiles=%d mismatched=%d elems=%u match=%u stale=%u zero=%u "
               "histOther=%u rc=%d\n", V.name, runNo, V.nIter, static_cast<int>(nAiv * nTile), c.mismatchedTiles,
               c.elems, c.match, c.stale, c.zero, c.tagHistOther, pass ? 0 : 1);
        rc = pass ? 0 : 1;
        if (!pass) {
            for (size_t t = 0; t < c.tileOK.size(); ++t) {
                if (c.tileOK[t] != 1) { printf("TILEFAIL first idx=%zu (aiv=%zu tile=%zu)\n", t, t / nTile, t % nTile); break; }
            }
        }
        aclrtFree(dOut);
    } else {
        const SpVar& V = SP_VARS[vi];
        const size_t outElems = static_cast<size_t>(nAiv) * TILE_ELEMS;
        const size_t srcElems = static_cast<size_t>(nAiv) * V.nIter * TILE_ELEMS;
        const size_t outBytes = outElems * 4u;
        const size_t srcBytes = srcElems * 4u;
        void* dOut = nullptr; void* dSrc = nullptr;
        if (aclrtMalloc(&dOut, outBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
            aclrtMalloc(&dSrc, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) { printf("malloc fail\n"); return 2; }
        std::vector<float> hSrc(srcElems, 0.0f);
        for (uint32_t a = 0; a < nAiv; ++a) {
            for (uint32_t i = 0; i < V.nIter; ++i) {
                const float tag = HTag(a, i, V.tagShift);   // 负向对照经 tagShift 注入；MTE2 路径的值来自源
                for (uint32_t e = 0; e < TILE_ELEMS; ++e) {
                    hSrc[(static_cast<size_t>(a) * V.nIter + i) * TILE_ELEMS + e] = tag;
                }
            }
        }
        aclrtMemset(dOut, outBytes, 0xCD, outBytes);
        aclrtMemcpy(dSrc, srcBytes, hSrc.data(), srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        printf("[probe] mode=sp variant=%s vi=%d run=%d N=%u pipeSel=%u drainLast=%u tailApi=%u pb=%u trace=%d\n",
               V.name, vi, runNo, V.nIter, V.pipeSel, V.drainLast, V.tailApi, V.flushPipeBar, traceFlag ? 1 : 0);
        fflush(stdout);
        probe_sp_kernel<<<blocks, 0, stream>>>((uint8_t*)dOut, (uint8_t*)dSrc, V.nIter, V.pipeSel, V.drainLast,
                                               V.tailApi, V.flushPipeBar, V.tagShift, traceFlag ? 1u : 0u);
        const aclError err = aclrtSynchronizeStream(stream);
        if (err != ACL_SUCCESS) {
            printf("SUMMARY mode=sp variant=%s run=%d launch=FAILED err=%d rc=2\n", V.name, runNo, (int)err);
            aclrtDestroyStream(stream); return 2;
        }
        std::vector<float> hOut(outElems, 0.0f);
        aclrtMemcpy(hOut.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        const Counts c = CheckSp(hOut, nAiv, V.nIter);
        const bool pass = (c.mismatchedTiles == 0);
        printf("SUMMARY mode=sp variant=%s run=%d N=%u aivs=%u mismatched=%d elems=%u match=%u zero=%u histOther=%u rc=%d\n",
               V.name, runNo, V.nIter, nAiv, c.mismatchedTiles, c.elems, c.match, c.zero, c.tagHistOther, pass ? 0 : 1);
        if (!pass) {
            printf("HIST mode=sp variant=%s run=%d obs=[", V.name, runNo);
            for (uint32_t j = 0; j < V.nIter; ++j) printf("%d%s", c.tagHist[j], (j + 1 == V.nIter) ? "" : ",");
            printf("] other=%u (下标=第几次 op 的 tag)\n", c.tagHistOther);
        }
        rc = pass ? 0 : 1;
        aclrtFree(dOut); aclrtFree(dSrc);
    }

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return rc;
}
