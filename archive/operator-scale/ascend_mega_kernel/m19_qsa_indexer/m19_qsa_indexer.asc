/**
 * m19_qsa_indexer.asc —— Mega kernel M19：QSA indexer 前端（mix(1,2) 全核）
 *
 * 权威数学来源：/workspace/vllm/vllm/models/qwen4_exp/（nvidia/indexer_qsa.py、
 * nvidia/ops/qsa_indexer.py、nvidia/ops/qsa.py:_compress_qsa_groups_kernel、
 * common/qsa_cache.py）。完整张量级契约见 m19_qsa_indexer/README.md §1。
 *
 * 本 kernel 做的（decode 档 m=1，单 request，单层，一层 full-attention 的 indexer）：
 *   ① AIC：index_qk_proj = x[1,2560] @ W[640,2560]^T → qk[1,640] bf16
 *      （N=640 按 160 列一块切到 AIC 0..3；M tile 与其他 GEMM 段一致）
 *   ② AIV 0..3：q 头 h 的 GemmaRMSNorm(128) + partial NeoX RoPE(rotary_dim=64, pos=p)
 *   ③ AIV 4：k_raw 写 raw key ring（circular compressor state，capacity=4）；
 *      若 p ≡ 3 (mod 4) 则压缩该组：pooled = bf16(mean(raw_k[p-3..p])) →
 *      GemmaRMSNorm(128) with k_layernorm → RoPE(pos = 4g) → 写 compressed cache 行 g
 *   ④ 全体 56 AIV：对 visible_blocks = (p+1)/4 个压缩行打分
 *        score[b] = Σ_h max( dot(ck[b], q[h]), 0 )   （fp32，无 scale）
 *   ⑤ 选出 block_topk = budget/compress_ratio = 512 个 block（de facto top-512）：
 *      nibble radix 二分求「第 512 大 score 的精确 fp32 值」K（8 轮，每轮 4 bit，
 *      每轮一次 AIV all-to-all 计数），再按 score>K 升序 + (score==K 补足配额，升序)
 *      压实写出
 *   ⑥ expand：每个选中 block b → 4 个 token (4b..4b+3)，附 open group 的 causal
 *      tail（tail_start..p），末列写 count = 4·min(V,512) + tail_count
 *      输出 [2052] int32，与 vLLM packed 契约同形（见 README §1.6）
 *
 * 约束遵守（用户定）：mix(1,2) 全核；只用基础 API（无 Matmul 高阶 / TPipe / TBuf /
 * TQue / AllocTensor）；buffer id / cross core id / 地址全编译期静态；核内 BufferID，
 * 核间 CrossCore；跨 pipe 可见性一律走 BufferID（含「标量写 UB → MTE3 搬」的 PIPE_S 阻塞释放，
 * docs/05 §6.1 ⓔ）；唯一保留的 S 管事件是「标量读 V 计算结果」这一有值依赖处的 V_S（docs/05 §2 明文例外）。
 *
 * 同步表（详见 README §2.3/§4）：
 *   AIC 内：BUF_A0/1、BUF_B0/1（MTE2→MTE1）、BUF_L0_0/1（MTE1→M）、BUF_L0C（M→FIXP）
 *   AIC→AIV：CrossCore mode 2（flag 0）——先 AIC 全体 mode 0 屏障（flag 11）确保 4 个
 *            N 块全部落盘，再由每个 AIC 对自己的 2 个配对 AIV 置 1
 *   AIV 内：BUF_*（MTE2→V、V→MTE3、S→MTE3 交接，release 用阻塞释放 mode=false = CANN 默认 ASC_LOCK_BLOCK）
 *   AIV 间（M53 起只剩两处，都是 mode0）：
 *     flag 9 = B1 屏障（q/k/cache 就绪 + 输出预填完成）
 *     flag 8 = 分数交接屏障：每核写完自己的分数与 4B 「交接记号」后置位，**单发一次**
 *              （探针 probe_aiv_barrier.asc 的结论：单发可证、同片槽多轮复用不可证，见 README §3.4）
 *     flag 10 = 保留（历史口径：原 radix 的跨核计数交换已随「选择段单核化」删除）
 *   GM 交换：logits[0..V)（各核写自己那段分数）、cntGm 的 768 段（每核 4B 交接记号）、
 *            qOut / comp 行；写侧 MTE3、读侧 MTE2
 *
 * 3510 实测 quirk（沿用 m0/m7/m11 结论，本 kernel 全部规避）：
 *   1) GM 一律按 bfloat16_t 位视图寻址（fp32/int32 GlobalTensor 切片取址错误）；
 *      同一 GlobalTensor 只 SetGlobalBuffer 一次；
 *   2) AIV UB 偏移 32B 对齐；非 32B 对齐 StoreAlign 507035；
 *   3) LocalMemBar 必须在 __VEC_SCOPE__ 内；
 *   4) 同 pipe 背靠背 MTE2 不保序 → 依赖对之间插 PipeBarrier<PIPE_MTE2>；
 *   5) Reg::Arange 只填 64 lane（fp32 VL）—— 本 kernel 全部按 64-lane 分块；
 *   6) Nd2Nz 行数为 1 时退化 → GEMM 的 calcM 至少 2（m=1 时读 2 行、只写 curM 行）；
 *   7) fp32→bf16 的 Reg Cast 落在 32bit lane 低半 → 一律用整数位运算打包（RNE）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <string>

namespace {

using namespace AscendC;
using namespace AscendC::Reg;

// ============================================================
// 0. 形状常量（Qwen3.8-Flash-Next-MXFP4，config.json + checkpoint 实证）
// ============================================================

constexpr uint32_t HIDDEN = 2560;        // 层宽度（index_qk_proj 的 K）
constexpr uint32_t NH = 4;               // indexer_n_heads
constexpr uint32_t KVH = 1;              // indexer_kv_heads
constexpr uint32_t D = 128;              // indexer_head_dim
constexpr uint32_t QW = NH * D;          // 512
constexpr uint32_t QK_W = QW + KVH * D;  // 640（index_qk_proj 的 N）
constexpr uint32_t RATIO = 4;            // indexer_compress_ratio
constexpr uint32_t BUDGET = 2048;        // indexer_budget（token 数）
constexpr uint32_t BLK_TOPK = BUDGET / RATIO;        // 512
constexpr uint32_t OUT_WIDTH = BUDGET + RATIO - 1;   // 2051
constexpr uint32_t PACKED_WIDTH = OUT_WIDTH + 1;     // 2052
constexpr uint32_t ROT = 64;             // rotary_dim = int(256 * 0.25)，indexer 共用主 attention 旋转
constexpr uint32_t ROT_HALF = ROT / 2;   // 32 个频率对（neox: pair (i, i+32)）
constexpr float RMS_EPS = 1e-6f;

constexpr uint32_t M_MAX = 64;           // A 行上界（decode 档用 1；prefill 扩展复用）
constexpr uint32_t V_MAX = 65536;        // visible_blocks 上界 = max_position/ratio
constexpr uint32_t NAIV = 56;            // 56 个 AIV（28 AIC × 2）
constexpr uint32_t CCHUNK = 64;          // 每 AIV 每次处理 64 个压缩行
// 每 AIV 列上界。**必须能装下单核档的最大 V**（M53：单核是选择段的一等公民，
// 小档 V=256/2048、budget=8/32/512 全部要能 coreDiv=1 跑通）⇒ PER_MAX = 2048。
// 多核档用不到这么多列（per = AlignUp(ceil(V/coreDiv),64) = 64 @ V=2048/coreDiv=56），
// 但 UB_SCORE 是静态布局，按最大单核档预留。
constexpr uint32_t PER_MAX = 2048;

// ---- GEMM tile（与 m11_bf16_gemm 同一资源表，仅 K/N 实例不同）----
constexpr uint32_t CUBE_BLOCK = 16;
constexpr uint32_t BASE_M = 64;
constexpr uint32_t BASE_K = 64;
constexpr uint32_t BASE_N = 160;
constexpr uint32_t NLOOP = QK_W / BASE_N;   // 4 个 N 块 → AIC 0..3

// ============================================================
// 1. AIC 侧：bf16 GEMM（结构逐字来自 m11_bf16_gemm，K=2560 / N=640）
// ============================================================

constexpr uint32_t L1_A_ELEMS = BASE_M * BASE_K;
constexpr uint32_t L1_B_ELEMS = BASE_N * BASE_K;
constexpr uint32_t L1_OFF_A0 = 0;
constexpr uint32_t L1_OFF_A1 = L1_OFF_A0 + L1_A_ELEMS * 2;
constexpr uint32_t L1_B_REGION = 256 * 1024;
constexpr uint32_t L1_OFF_B0 = L1_B_REGION;
constexpr uint32_t L1_OFF_B1 = L1_B_REGION + L1_B_ELEMS * 2;

constexpr uint32_t L0_PP_BYTES = 32 * 1024;
constexpr uint32_t L0_OFF_0 = 0;
constexpr uint32_t L0_OFF_1 = L0_PP_BYTES;

constexpr MutexID BUF_A0 = 0;
constexpr MutexID BUF_A1 = 1;
constexpr MutexID BUF_B0 = 2;
constexpr MutexID BUF_B1 = 3;
constexpr MutexID BUF_L0_0 = 4;
constexpr MutexID BUF_L0_1 = 5;
constexpr MutexID BUF_L0C = 6;

// ---- CrossCore flagId（静态分配；mode0 每个 barrier 一个独立 id，逐个轮换）----
constexpr uint16_t FLAG_CV = 0;          // mode 2: AIC → 配对 2 个 AIV
constexpr uint16_t FLAG_AIC_BAR = 11;    // mode 0: AIC 间屏障（4 个 N 块全部落盘）

__aicore__ __inline__ constexpr uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ __inline__ constexpr uint32_t AlignUp(uint32_t a, uint32_t b) { return CeilDiv(a, b) * b; }
__aicore__ __inline__ constexpr uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

class QkGemm {
public:
    __aicore__ inline QkGemm() {}

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, uint32_t m, uint32_t nBlock)
    {
        aGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(a));
        bGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(b));
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(c));
        mTotal = m;
        nBlock = nBlock;
    }

    // 每个 AIC 只算自己的 1 个 N 块（AIC 0..3；其余 AIC 空转但参与 AIC 屏障）
    __aicore__ inline void Process()
    {
        if (nBlock >= NLOOP) return;
        const uint32_t mLoop = CeilDiv(mTotal, BASE_M);
        const uint32_t kLoop = HIDDEN / BASE_K;
        const uint32_t nLoop = NLOOP - nBlock;   // 单 AIC 时覆盖全部 N 块

        LocalTensor<bfloat16_t> a1Ping(TPosition::A1, L1_OFF_A0, L1_A_ELEMS);
        LocalTensor<bfloat16_t> a1Pong(TPosition::A1, L1_OFF_A1, L1_A_ELEMS);
        LocalTensor<bfloat16_t> b1Ping(TPosition::B1, L1_OFF_B0, L1_B_ELEMS);
        LocalTensor<bfloat16_t> b1Pong(TPosition::B1, L1_OFF_B1, L1_B_ELEMS);
        LocalTensor<bfloat16_t> a2Ping(TPosition::A2, L0_OFF_0, BASE_M * BASE_K);
        LocalTensor<bfloat16_t> a2Pong(TPosition::A2, L0_OFF_1, BASE_M * BASE_K);
        LocalTensor<bfloat16_t> b2Ping(TPosition::B2, L0_OFF_0, BASE_K * BASE_N);
        LocalTensor<bfloat16_t> b2Pong(TPosition::B2, L0_OFF_1, BASE_K * BASE_N);
        LocalTensor<float> cL0C(TPosition::CO1, 0, BASE_M * BASE_N);

        for (uint32_t mBlock = 0; mBlock < mLoop; ++mBlock) {
            const uint32_t curM = MinU32(mTotal - mBlock * BASE_M, BASE_M);
            const uint32_t calcM = curM < 2 ? 2 : curM;   // quirk 6：Nd2Nz 单行退化
            const uint32_t calcMAlign = AlignUp(calcM, CUBE_BLOCK);
            for (uint32_t nb = 0; nb < nLoop; ++nb) {
                const uint32_t nBlk = nBlock + nb;
                Mutex::Lock<PIPE_M>(BUF_L0C);
                for (uint32_t kBlock = 0; kBlock < kLoop; ++kBlock) {
                    const uint32_t p = kBlock & 1;
                    const MutexID bufA = p ? BUF_A1 : BUF_A0;
                    const MutexID bufB = p ? BUF_B1 : BUF_B0;
                    const MutexID bufL0 = p ? BUF_L0_1 : BUF_L0_0;
                    LocalTensor<bfloat16_t> a1 = p ? a1Pong : a1Ping;
                    LocalTensor<bfloat16_t> b1 = p ? b1Pong : b1Ping;
                    LocalTensor<bfloat16_t> a2 = p ? a2Pong : a2Ping;
                    LocalTensor<bfloat16_t> b2 = p ? b2Pong : b2Ping;

                    Mutex::Lock<PIPE_MTE2>(bufA);
                    CopyInA(a1, kBlock, mBlock, calcM);
                    Mutex::Unlock<PIPE_MTE2>(bufA);
                    Mutex::Lock<PIPE_MTE2>(bufB);
                    CopyInB(b1, kBlock, nBlk);
                    Mutex::Unlock<PIPE_MTE2>(bufB);

                    Mutex::Lock<PIPE_MTE1>(bufL0);
                    Mutex::Lock<PIPE_MTE1>(bufA);
                    Mutex::Lock<PIPE_MTE1>(bufB);
                    LoadA(a1, a2, calcMAlign);
                    LoadB(b1, b2);
                    Mutex::Unlock<PIPE_MTE1>(bufA);
                    Mutex::Unlock<PIPE_MTE1>(bufB);
                    Mutex::Unlock<PIPE_MTE1>(bufL0);

                    Mutex::Lock<PIPE_M>(bufL0);
                    MmadParams mp = {};
                    mp.m = calcM;
                    mp.n = BASE_N;
                    mp.k = BASE_K;
                    mp.cmatrixInitVal = (kBlock == 0);
                    Mmad(cL0C, a2, b2, mp);
                    Mutex::Unlock<PIPE_M>(bufL0);
                }
                Mutex::Unlock<PIPE_M>(BUF_L0C);
                Mutex::Lock<PIPE_FIX>(BUF_L0C);
                CopyOut(cL0C, mBlock, nBlk, curM, calcMAlign);
                Mutex::Unlock<PIPE_FIX>(BUF_L0C);
            }
        }
    }

private:
    __aicore__ inline void CopyInA(LocalTensor<bfloat16_t>& a1, uint32_t kBlock, uint32_t mBlock, uint32_t curM)
    {
        Nd2NzParams par = {};
        par.ndNum = 1;
        par.nValue = curM;
        par.dValue = BASE_K;
        par.srcNdMatrixStride = 0;
        par.srcDValue = HIDDEN;
        par.dstNzC0Stride = BASE_M;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        DataCopy(a1, aGm[kBlock * BASE_K + mBlock * HIDDEN * BASE_M], par);
    }

    __aicore__ inline void CopyInB(LocalTensor<bfloat16_t>& b1, uint32_t kBlock, uint32_t nBlk)
    {
        Nd2NzParams par = {};
        par.ndNum = 1;
        par.nValue = BASE_N;
        par.dValue = BASE_K;
        par.srcNdMatrixStride = 0;
        par.srcDValue = HIDDEN;
        par.dstNzC0Stride = BASE_N;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        DataCopy(b1, bGm[kBlock * BASE_K + nBlk * BASE_N * HIDDEN], par);
    }

    __aicore__ inline void LoadA(LocalTensor<bfloat16_t>& a1, LocalTensor<bfloat16_t>& a2, uint32_t calcMAlign)
    {
        LoadData2DParamsV2 lp = {};
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = calcMAlign / CUBE_BLOCK;
        lp.kStep = BASE_K / CUBE_BLOCK;
        lp.srcStride = BASE_M / CUBE_BLOCK;
        lp.dstStride = calcMAlign / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        LoadData(a2, a1[0], lp);
    }

    __aicore__ inline void LoadB(LocalTensor<bfloat16_t>& b1, LocalTensor<bfloat16_t>& b2)
    {
        LoadData2DParamsV2 lp = {};
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = BASE_N / CUBE_BLOCK;
        lp.kStep = BASE_K / CUBE_BLOCK;
        lp.srcStride = BASE_N / CUBE_BLOCK;
        lp.dstStride = BASE_N / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        LoadData(b2, b1[0], lp);
    }

    __aicore__ inline void CopyOut(LocalTensor<float>& cL0C, uint32_t mBlock, uint32_t nBlk,
                                   uint32_t curM, uint32_t calcMAlign)
    {
        FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp = {};
        fp.nSize = BASE_N;
        fp.mSize = curM;
        fp.srcStride = calcMAlign;
        fp.dstStride = QK_W;
        fp.quantPre = QuantMode_t::F322BF16;
        fp.reluScalar = 0;
        fp.vectorRelu = 0;
        fp.deqScalar = 0;
        Fixpipe(cGm[mBlock * BASE_M * QK_W + nBlk * BASE_N], cL0C, fp);
    }

private:
    GlobalTensor<bfloat16_t> aGm;
    GlobalTensor<bfloat16_t> bGm;
    GlobalTensor<bfloat16_t> cGm;
    uint32_t mTotal = 0;
    uint32_t nBlock = 0;
};

}  // namespace

namespace {

using namespace AscendC;
using namespace AscendC::Reg;

// ============================================================
// 2. AIV 侧：norm + rope + 压缩 + 打分 + 选 top-512 + expand
// ============================================================

// ---- UB 静态布局（字节偏移；32B 对齐；总 ~38KB « 248KB）
//      M53 布局改动（必要）：UB_SCORE 由 1216 列扩到 PER_MAX=2048 列（单核档要装下 V=2048 的分数）；
//      同时删掉 4 个**只写不读**的死区（原 UB_SELF/UB_IDXS/UB_TOK/UB_SELS/UB_BIG/UB_BIGN/UB_NEGV/UB_ORD4），
//      其中 UB_SELS 原本与 UB_TAIL 的后半重叠（潜在踩踏源，UB_LANEF 就落在 UB_TAIL 的跨度里）；
//      现在 UB_LANEF / UB_TRACE / UB_TAIL 各自独占，互不重叠。
constexpr uint32_t UB_GSTG  = 0;       // bf16 [128]        256B  GEMM 结果切片
constexpr uint32_t UB_WN    = 256;     // bf16 [128]        256B  1+weight
constexpr uint32_t UB_CS    = 512;     // bf16 [64]         128B  cos32|sin32 @ p
constexpr uint32_t UB_CSG   = 640;     // bf16 [64]         128B  cos32|sin32 @ 组首
constexpr uint32_t UB_KR    = 768;     // bf16 [4][128]     1024B k_raw + ring 3 行
constexpr uint32_t UB_POOL  = 1792;    // fp32 [128]        512B  pooled
constexpr uint32_t UB_KPK   = 2304;    // bf16 [128]        256B  压缩行 bf16
constexpr uint32_t UB_Q     = 2560;    // fp32 [4][128]     2048B q
constexpr uint32_t UB_CROW  = 4608;    // bf16 [64][128]    16384B
constexpr uint32_t UB_SCORE = 20992;   // fp32 [PER_MAX]    8192B 分数（单核档要装下全部 V）
constexpr uint32_t UB_LANEF = 29184;   // fp32 [64]         256B  lane 序号 0..63
                                       //   —— **选择段的"前 n 条 lane"动态掩码都由它派生**（不用 UpdateMask(变量)）；
                                       //      ScanChunk 里数值前端原有的 `UpdateMask(nc)` 未动（前端已验收）
constexpr uint32_t UB_ORD   = 29440;   // int32 [64]        256B  lane%4
constexpr uint32_t UB_OUTS  = 29696;   // int32 [64]        256B  单子块 token 暂存
constexpr uint32_t UB_TMPA  = 29952;   // fp32 [64]         256B  子块 GT 计数
constexpr uint32_t UB_TMPB  = 30208;   // fp32 [64]         256B  子块 tie 计数
constexpr uint32_t UB_TMPC  = 30464;   // fp32/int32 [64]   256B  key->float 阈值往返
constexpr uint32_t UB_CNTS  = 30720;   // fp32 [16][64]     4096B 计数槽
constexpr uint32_t UB_CNTR  = 34816;   // fp32 [4][64]      1024B 读回
constexpr uint32_t UB_TRACE = 35840;   // int32 [64]        256B  选择段每核记录（前 128B = 32 字段，
                                       //                        后 128B 供 stage 计数暂存）
constexpr uint32_t UB_TAIL  = 36096;   // int32 [512]       2048B 输出预填 / tail（独占）
constexpr uint32_t UB_TOT   = 38144;

constexpr MutexID AIV_BUF_STG  = 8;    // GEMM / ring staging（MTE2）
constexpr MutexID AIV_BUF_W    = 9;    // 权重 / cos-sin（MTE2）
constexpr MutexID AIV_BUF_CROW = 10;   // 压缩行 chunk（MTE2）
constexpr MutexID AIV_BUF_Q    = 11;   // 4 头 q 回搬（MTE2 -> V）
constexpr MutexID AIV_BUF_LOG  = 12;   // scores（V -> MTE3）
constexpr MutexID AIV_BUF_CNT  = 13;   // 计数交换（V -> MTE3；MTE2 -> V）
constexpr MutexID AIV_BUF_C2   = 14;   // c_gt/c_eq 交换
constexpr MutexID AIV_BUF_OUT  = 15;   // 输出（V -> MTE3）
constexpr MutexID AIV_BUF_RES  = 16;   // 结果打包（V -> MTE3）

constexpr uint32_t RADIX_BITS = 2;                            // 每轮 2 bit
constexpr uint32_t RADIX_NCAND = (1u << RADIX_BITS) - 1;      // 候选 d=1..3
constexpr uint32_t RADIX_PASSES = 32 / RADIX_BITS;            // 16

// ---- 选择段（M53：单核一等公民）----
constexpr uint32_t SELA_COLS = 4096;      // 单核选择每次从 GM 搬进 UB 的列数（= UB_CROW 16384B / 4B）
constexpr uint32_t SEL_CORE = 0;          // 执行选择段的核（AIV 0）—— 核号是设计参数，不是硬编码的硬件量

constexpr uint16_t FLAG_B1 = 9;
constexpr uint16_t FLAG_CNT = 10;              // 保留（历史口径；单核选择段不再需要计数交换）
constexpr uint16_t FLAG_HANDOFF = 8;           // 分数交接屏障（mode0，AIV 间）

constexpr float BIGF = 1.0e30f;

template <pipe_t pipe>
__aicore__ inline void BufAcq(MutexID id) { GetBufInternal<pipe, false>(id); }
template <pipe_t pipe>
__aicore__ inline void BufRel(MutexID id) { RlsBufInternal<pipe, false>(id); }

constexpr CastTrait castB16F32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
constexpr CastTrait castF32S32 = {RegLayout::ZERO, SatMode::NO_SAT, MaskMergeMode::ZEROING, RoundMode::CAST_RINT};
constexpr CastTrait castF32Bf16 = {RegLayout::ZERO, SatMode::NO_SAT, MaskMergeMode::ZEROING, RoundMode::CAST_RINT};
constexpr CastTrait castS32F32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING, RoundMode::CAST_RINT};

template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

__aicore__ inline void AivBarrier(uint16_t flagId)
{
    CrossCoreSetFlag<0x0, PIPE_MTE3>(flagId);
    CrossCoreWaitFlag<0x0, PIPE_MTE2>(flagId);
}

// fp32 -> bf16(RNE) -> fp32（整数位运算，m7 同款公式）
__simd_callee__ inline void RoundBf16(RegTensor<float>& v, MaskReg& m)
{
    RegTensor<int32_t> sh, one, half, t;
    Duplicate(sh, 16);
    Duplicate(one, 1);
    Duplicate(half, 0x7FFF);
    ShiftRight(t, reinterpret_cast<RegTensor<int32_t>&>(v), sh, m);
    And(t, t, one, m);
    Add(t, reinterpret_cast<RegTensor<int32_t>&>(v), t, m);
    Add(t, t, half, m);
    ShiftRight(t, t, sh, m);
    ShiftLeft(reinterpret_cast<RegTensor<int32_t>&>(v), t, sh, m);
}

__simd_callee__ inline void LoadBf16Slice(RegTensor<float>& dst, __ubuf__ bfloat16_t* src, MaskReg& m)
{
    RegTensor<bfloat16_t> t;
    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(t, src);
    Cast<float, bfloat16_t, castB16F32>(dst, t, m);
}


// V 管写完 UB 后，S 管标量读（GetValue）前需要 V_S 事件（跨 pipe 数据可见性）。
// 同处的 V 侧阻塞 release 只排空生产 pipe，scalar 侧 GetValue 不经 BufferID acquire
// ⇒ V→S 可见性无 BufferID 覆盖；按 docs/05 §2 的「有值依赖」例外保留（不属与 BufferID 重复的残留）。
__aicore__ inline void VSync()
{
    SetFlag<HardEvent::V_S>(EVENT_ID7);
    WaitFlag<HardEvent::V_S>(EVENT_ID7);
}

// 「前 n 条 lane」掩码 —— **唯一允许的动态掩码构造方式**。
// 本机实测 `UpdateMask<...>(变量)` 选中的 lane 不可靠（M35 机理 (LANEF) 的读数：`UpdateMask(aiv)`
// 选到多于 1 条 lane），且同一份 score 数据在不同次运行里会给出不同的计数 ⇒ 计数段不可确定。
// 因此全部动态掩码改为「lane 序号向量 < n」的 `CompareScalar`（M35 已验证可用）。
// 调用点必须先 `LoadAlign(laneF, reinterpret_cast<__ubuf__ float*>(UB_LANEF))`。
__simd_callee__ inline void MaskLtN(MaskReg& dst, RegTensor<float>& laneF, float n, MaskReg& full)
{
    CompareScalar<float, CMPMODE::LT>(dst, laneF, n, full);
}

class QsaIndexerAiv {
public:
    __aicore__ inline QsaIndexerAiv() {}

    __aicore__ inline void Init(
        __gm__ uint8_t* qk, __gm__ uint8_t* wq, __gm__ uint8_t* wk,
        __gm__ uint8_t* cosQ, __gm__ uint8_t* sinQ, __gm__ uint8_t* cosG, __gm__ uint8_t* sinG,
        __gm__ uint8_t* ring, __gm__ uint8_t* comp,
        __gm__ uint8_t* qOut, __gm__ uint8_t* kOut, __gm__ uint8_t* ckOut,
        __gm__ uint8_t* logits, __gm__ uint8_t* outG, __gm__ uint8_t* cntG, __gm__ uint8_t* statG,
        uint32_t vBlocks, uint32_t pos, uint32_t closes, uint32_t groupIdx, uint32_t tailStart,
        uint32_t blkTopkIn, uint32_t singleAivIn, uint32_t coreNumIn)
    {
        qkGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(qk));
        wqGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(wq));
        wkGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(wk));
        cosqGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(cosQ));
        sinqGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(sinQ));
        cosgGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(cosG));
        singGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(sinG));
        ringGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ring));
        compGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(comp));
        qOutGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(qOut));
        kOutGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(kOut));
        ckOutGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ckOut));
        logitsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(logits));
        outGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(outG));
        cntGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(cntG));
        statGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(statG));
        V = vBlocks;
        blkTopk = (blkTopkIn != 0u) ? blkTopkIn : BLK_TOPK;
        blkTopkInt = blkTopk;
        // 核数由 host 用 API（ACL_DEV_ATTR_VECTOR_CORE_NUM）取后传入 ⇒ 不硬编码 28/56
        naivTotal = (coreNumIn != 0u) ? coreNumIn : 1u;
        coreDiv = (singleAivIn != 0u) ? singleAivIn : naivTotal;   // 打分列切分（1=单核、2=两核…）
        ppos = pos;
        closesGroup = closes;
        gidx = groupIdx;
        tstart = tailStart;
        aiv = GetBlockIdx();
        per = AlignUp(CeilDiv(V, coreDiv), CCHUNK);
        c0 = aiv * per;
        c1 = MinU32(V, c0 + per);
        // coreDiv==1 时自然退化为"只有 AIV 0 有列"（c0=0<c1=V，其余核 c0>=V）
        nchunk = (c0 < c1) ? CeilDiv(c1 - c0, CCHUNK) : 0;
        nvalid = (c0 < c1) ? (c1 - c0) : 0;
    }

    __aicore__ inline void Process()
    {
        InitConsts();
        CrossCoreWaitFlag<0x2, PIPE_MTE2>(FLAG_CV);
        if (aiv == 0) PrefillOut();
        if (aiv < NH) {
            LoadCosSin(UB_CS, cosqGm, sinqGm);
            LoadWeight(UB_WN, wqGm);
            QHeadNormRope(aiv);
        } else if (aiv == NH) {
            KPath();
        }
        AivBarrier(FLAG_B1);
        LoadQ();          // 本 AIV 只算了自己那 1 个头 ⇒ 必须从 GM 取回全部 4 头（曾是 scores 乱的相关性≈0.12 的根因）
        BufAcq<PIPE_V>(AIV_BUF_Q);
        for (uint32_t ci = 0; ci < nchunk; ++ci) ScanChunk(ci);
        BufRel<PIPE_V>(AIV_BUF_Q);
        DumpLogits();               // S1：分数落 GM（并行，列切分；本核只写自己那段）
        VerifiedHandoff();          // S2：一次 AivBarrier(FLAG_HANDOFF)（+ AIV0 校验「整段无哨兵」）
        if (aiv == SEL_CORE) {      // S3/S4：**单核**选择（读 GM 分块）——与核数无关
            SelectSingleCore();
            WriteTail();
        }
        DumpStats();
        PipeBarrier<PIPE_ALL>();
    }

private:
    // ---------------- 常量 ----------------
    __aicore__ inline void InitConsts()
    {
        BufAcq<PIPE_V>(AIV_BUF_LOG);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            RegTensor<int32_t> idx, three;
            RegTensor<float> laneF0;
            Duplicate(three, 3);
            Arange(idx, 0);
            Cast<float, int32_t, castS32F32>(laneF0, idx, full);          // **lane 序号 0..63（必须在 AND 之前取）**
            StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_LANEF), laneF0, full);
            And(idx, idx, three, full);
            StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_ORD), idx, full);
            RegTensor<float> neg;
            Duplicate(neg, -1.0f);
            for (uint16_t c = 0; c < static_cast<uint16_t>(PER_MAX / CCHUNK); ++c) {
                StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_SCORE) + c * CCHUNK, neg, full);
            }
        }
        BufRel<PIPE_V>(AIV_BUF_LOG);
    }

    __aicore__ inline void LoadWeight(uint32_t off, GlobalTensor<bfloat16_t>& src)
    {
        BufAcq<PIPE_MTE2>(AIV_BUF_W);
        DataCopy(MkT<bfloat16_t>(off, D), src[0], D);
        BufRel<PIPE_MTE2>(AIV_BUF_W);
    }

    __aicore__ inline void LoadCosSin(uint32_t off, GlobalTensor<bfloat16_t>& cg, GlobalTensor<bfloat16_t>& sg)
    {
        BufAcq<PIPE_MTE2>(AIV_BUF_W);
        DataCopy(MkT<bfloat16_t>(off, ROT_HALF), cg[0], ROT_HALF);
        PipeBarrier<PIPE_MTE2>();
        DataCopy(MkT<bfloat16_t>(off + 64, ROT_HALF), sg[0], ROT_HALF);
        BufRel<PIPE_MTE2>(AIV_BUF_W);
    }

    // ---------------- P0b：输出预填 -1（2052 列 = 8208B）----------------
    __aicore__ inline void PrefillOut()
    {
        for (uint16_t c = 0; c < 4; ++c) {
            BufAcq<PIPE_V>(AIV_BUF_OUT);
            __VEC_SCOPE__ {
                MaskReg full = CreateMask<int32_t, MaskPattern::ALL>();
                RegTensor<int32_t> neg;
                Duplicate(neg, -1);
                StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_TAIL) + c * CCHUNK, neg, full);
            }
            BufRel<PIPE_V>(AIV_BUF_OUT);
        }
        BufAcq<PIPE_MTE3>(AIV_BUF_OUT);
        for (uint32_t blk = 0; blk < 8; ++blk) {   // 8 × 1024B = 8192B
            DataCopyPad(outGm[blk * 512], MkT<bfloat16_t>(UB_TAIL, 512), DataCopyExtParams{1, 1024, 0, 0, 0});
            PipeBarrier<PIPE_MTE3>();
        }
        DataCopyPad(outGm[4096], MkT<bfloat16_t>(UB_TAIL, 8), DataCopyExtParams{1, 16, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_OUT);
    }

    // ---------------- 通用 norm + partial NeoX RoPE ----------------
    template <bool SRC_BF16>
    __aicore__ inline void VecNormRope(uint32_t srcOff, uint32_t wOff, uint32_t csOff, uint32_t dstOff)
    {
        BufAcq<PIPE_V>(AIV_BUF_W);
        __ubuf__ bfloat16_t* csSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(csOff);
        __ubuf__ bfloat16_t* wSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(wOff);
        __ubuf__ float* dst = reinterpret_cast<__ubuf__ float*>(dstOff);
        __ubuf__ bfloat16_t* bSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(srcOff);
        __ubuf__ float* fSrc = reinterpret_cast<__ubuf__ float*>(srcOff);
        __VEC_SCOPE__ {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            uint32_t n32 = ROT_HALF;
            MaskReg m32 = UpdateMask<float>(n32);
            RegTensor<float> xa, xb, xc, xd, wa, wb, wc, wd, c32, s32, sq, t, rs, one, o0, o1;
            if constexpr (SRC_BF16) {
                LoadBf16Slice(xa, bSrc + 0, m32);
                LoadBf16Slice(xb, bSrc + 32, m32);
                LoadBf16Slice(xc, bSrc + 64, m32);
                LoadBf16Slice(xd, bSrc + 96, m32);
            } else {
                LoadAlign(xa, fSrc + 0);
                LoadAlign(xb, fSrc + 32);
                LoadAlign(xc, fSrc + 64);
                LoadAlign(xd, fSrc + 96);
            }
            LoadBf16Slice(wa, wSrc + 0, m32);
            LoadBf16Slice(wb, wSrc + 32, m32);
            LoadBf16Slice(wc, wSrc + 64, m32);
            LoadBf16Slice(wd, wSrc + 96, m32);
            LoadBf16Slice(c32, csSrc + 0, m32);
            LoadBf16Slice(s32, csSrc + ROT_HALF, m32);
            Mul(sq, xa, xa, m32);
            Mul(t, xb, xb, m32); Add(sq, sq, t, m32);
            Mul(t, xc, xc, m32); Add(sq, sq, t, m32);
            Mul(t, xd, xd, m32); Add(sq, sq, t, m32);
            Reduce<ReduceType::SUM, float>(rs, sq, m32);
            Muls(rs, rs, 1.0f / static_cast<float>(D), full);
            Adds(rs, rs, RMS_EPS, full);
            Sqrt(rs, rs, full);
            Duplicate(one, 1.0f);
            Div(rs, one, rs, full);
            Duplicate(t, rs, full);
            Mul(xa, xa, t, m32); Mul(xb, xb, t, m32); Mul(xc, xc, t, m32); Mul(xd, xd, t, m32);
            Adds(wa, wa, 1.0f, m32); Adds(wb, wb, 1.0f, m32);
            Adds(wc, wc, 1.0f, m32); Adds(wd, wd, 1.0f, m32);
            Mul(xa, xa, wa, m32); Mul(xb, xb, wb, m32); Mul(xc, xc, wc, m32); Mul(xd, xd, wd, m32);
            // 口径对齐（逐句对照 qsa_pre_indexer.py:112）：参考 y = (x*rrms*weight).to(cos.dtype)
            // 在 RoPE **之前**就取整到 bf16；本实现此前在 fp32 域旋转、只在写 GM 时取整。
            RoundBf16(xa, m32); RoundBf16(xb, m32); RoundBf16(xc, m32); RoundBf16(xd, m32);
            Mul(o0, xa, c32, m32);
            Mul(t, xb, s32, m32); Sub(o0, o0, t, m32);
            Mul(o1, xb, c32, m32);
            Mul(t, xa, s32, m32); Add(o1, o1, t, m32);
            StoreAlign(dst + 0, o0, m32);
            StoreAlign(dst + 32, o1, m32);
            StoreAlign(dst + 64, xc, m32);
            StoreAlign(dst + 96, xd, m32);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(AIV_BUF_W);
    }

    // fp32[128] -> bf16[128] 打包（m7 已验证的整寄存器写法：两个 64-lane 寄存器一并打包，
    // fp32[128] -> bf16[128]：官方手法（ops-transformer/posembedding/kv_rms_norm_rope_cache/
    // arch35/kv_rms_norm_rope_cache_regbase_base.h:226-231）——`Cast<bfloat16_t,float>` 得 bf16 寄存器
    // （值在 32bit lane 低半），再用 `StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>` 按 B32 打包落盘。
    // 不用手写位运算 / DeInterleave（此前误判为"DeInterleave lane 语义不同"，实为落盘指令选错）。
    __aicore__ inline void PackBf16(uint32_t fp32Off, uint32_t bf16Off)
    {
        __ubuf__ float* src = reinterpret_cast<__ubuf__ float*>(fp32Off);
        __ubuf__ bfloat16_t* dst = reinterpret_cast<__ubuf__ bfloat16_t*>(bf16Off);
        __VEC_SCOPE__ {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            RegTensor<float> v;
            RegTensor<bfloat16_t> bf;
            for (uint16_t s = 0; s < 2; ++s) {
                LoadAlign(v, src + s * 64);
                Cast<bfloat16_t, float, castF32Bf16>(bf, v, full);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(dst + s * 64, bf, full);
            }
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
    }

    // ---------------- P1a：q 单头 ----------------
    __aicore__ inline void QHeadNormRope(uint32_t head)
    {
        BufAcq<PIPE_MTE2>(AIV_BUF_STG);
        DataCopy(MkT<bfloat16_t>(UB_GSTG, D), qkGm[head * D], D);
        BufRel<PIPE_MTE2>(AIV_BUF_STG);
        BufAcq<PIPE_V>(AIV_BUF_STG);
        BufAcq<PIPE_V>(AIV_BUF_RES);          // 发布 UB_Q：MTE3 读前必须等 V 排空
        VecNormRope<true>(UB_GSTG, UB_WN, UB_CS, UB_Q + head * D * 4);
        BufRel<PIPE_V>(AIV_BUF_RES);
        BufRel<PIPE_V>(AIV_BUF_STG);
        BufAcq<PIPE_MTE3>(AIV_BUF_RES);       // 同一 id 的 V 侧阻塞 release 已承载 V→MTE3 可见性
        DataCopyPad(qOutGm[head * D * 2], MkT<bfloat16_t>(UB_Q + head * D * 4, D * 2),
                    DataCopyExtParams{1, D * 4, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_RES);
    }

    // ---------------- P1b：k 路径 ----------------
    __aicore__ inline void KPath()
    {
        BufAcq<PIPE_MTE2>(AIV_BUF_STG);
        // UB_KR slot 布局：0..2 = ring 的历史成员（位置 p-3+i），3 = 本 token 的 raw k。
        // （曾经的 bug：本 token 先落在 slot0，随后被 i=0 的历史成员 DMA 覆盖 ⇒ pooled 第 4 项是脏数据）
        DataCopy(MkT<bfloat16_t>(UB_KR + (RATIO - 1) * D * 2, D), qkGm[QW], D);
        PipeBarrier<PIPE_MTE2>();
        for (uint32_t i = 0; i < RATIO - 1; ++i) {           // 位置 p-3+i 的历史成员
            uint32_t slot = (ppos + RATIO - 1 - i) % RATIO;
            DataCopy(MkT<bfloat16_t>(UB_KR + i * D * 2, D), ringGm[slot * D], D);
            PipeBarrier<PIPE_MTE2>();
        }
        BufRel<PIPE_MTE2>(AIV_BUF_STG);
        BufAcq<PIPE_MTE3>(AIV_BUF_STG);       // 等 MTE2 把 UB_KR 搬完
        DataCopy(ringGm[(ppos % RATIO) * D], MkT<bfloat16_t>(UB_KR + (RATIO - 1) * D * 2, D), D);
        PipeBarrier<PIPE_MTE3>();
        DataCopy(kOutGm[0], MkT<bfloat16_t>(UB_KR + (RATIO - 1) * D * 2, D), D);
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_STG);
        if (closesGroup == 0) return;

        LoadCosSin(UB_CSG, cosgGm, singGm);
        LoadWeight(UB_WN, wkGm);
        BufAcq<PIPE_V>(AIV_BUF_STG);
        BufAcq<PIPE_V>(AIV_BUF_W);
        __ubuf__ bfloat16_t* src = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_KR);
        __ubuf__ float* dst = reinterpret_cast<__ubuf__ float*>(UB_POOL);
        __VEC_SCOPE__ {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            uint32_t n32 = ROT_HALF;
            MaskReg m32 = UpdateMask<float>(n32);
            RegTensor<float> a0, a1, a2, a3, i0, i1, i2, i3;
            LoadBf16Slice(a0, src + 0, m32);
            LoadBf16Slice(a1, src + 32, m32);
            LoadBf16Slice(a2, src + 64, m32);
            LoadBf16Slice(a3, src + 96, m32);
            for (uint16_t i = 1; i < RATIO; ++i) {
                LoadBf16Slice(i0, src + i * D + 0, m32);
                LoadBf16Slice(i1, src + i * D + 32, m32);
                LoadBf16Slice(i2, src + i * D + 64, m32);
                LoadBf16Slice(i3, src + i * D + 96, m32);
                Add(a0, a0, i0, m32); Add(a1, a1, i1, m32);
                Add(a2, a2, i2, m32); Add(a3, a3, i3, m32);
            }
            Muls(a0, a0, 1.0f / static_cast<float>(RATIO), m32);
            Muls(a1, a1, 1.0f / static_cast<float>(RATIO), m32);
            Muls(a2, a2, 1.0f / static_cast<float>(RATIO), m32);
            Muls(a3, a3, 1.0f / static_cast<float>(RATIO), m32);
            RoundBf16(a0, m32); RoundBf16(a1, m32); RoundBf16(a2, m32); RoundBf16(a3, m32);
            StoreAlign(dst + 0, a0, m32);
            StoreAlign(dst + 32, a1, m32);
            StoreAlign(dst + 64, a2, m32);
            StoreAlign(dst + 96, a3, m32);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(AIV_BUF_W);
        BufRel<PIPE_V>(AIV_BUF_STG);
        BufAcq<PIPE_V>(AIV_BUF_RES);          // 发布 UB_KPK
        VecNormRope<false>(UB_POOL, UB_WN, UB_CSG, UB_POOL);
        PackBf16(UB_POOL, UB_KPK);
        BufRel<PIPE_V>(AIV_BUF_RES);
        BufAcq<PIPE_MTE3>(AIV_BUF_RES);       // 同一 id 的 V 侧阻塞 release 已承载 V→MTE3 可见性
        DataCopy(compGm[static_cast<uint64_t>(gidx) * D], MkT<bfloat16_t>(UB_KPK, D), D);
        PipeBarrier<PIPE_MTE3>();
        DataCopy(ckOutGm[0], MkT<bfloat16_t>(UB_KPK, D), D);
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_RES);
    }

    // ---------------- P2：打分 ----------------
    __aicore__ inline void ScanChunk(uint32_t ci)
    {
        const uint32_t base = ci * CCHUNK;
        const uint32_t nv = (base + CCHUNK <= nvalid) ? CCHUNK : (nvalid > base ? (nvalid - base) : 0);
        if (nv == 0) return;
        BufAcq<PIPE_MTE2>(AIV_BUF_CROW);
        DataCopy(MkT<bfloat16_t>(UB_CROW, CCHUNK * D), compGm[static_cast<uint64_t>(c0 + base) * D], CCHUNK * D);
        BufRel<PIPE_MTE2>(AIV_BUF_CROW);
        PipeBarrier<PIPE_MTE2>();
        BufAcq<PIPE_V>(AIV_BUF_CROW);
        BufAcq<PIPE_V>(AIV_BUF_LOG);
        __ubuf__ bfloat16_t* crowP = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_CROW);
        __ubuf__ float* qP = reinterpret_cast<__ubuf__ float*>(UB_Q);
        __ubuf__ float* scP = reinterpret_cast<__ubuf__ float*>(UB_SCORE) + base;
        __VEC_SCOPE__ {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            RegTensor<float> q00, q01, q10, q11, q20, q21, q30, q31;
            RegTensor<float> xf0, xf1, a0, a1, a2, a3, r0, r1, r2, r3, sb;
            RegTensor<bfloat16_t> bf;
            LoadAlign(q00, qP + 0);   LoadAlign(q01, qP + 64);
            LoadAlign(q10, qP + 128); LoadAlign(q11, qP + 192);
            LoadAlign(q20, qP + 256); LoadAlign(q21, qP + 320);
            LoadAlign(q30, qP + 384); LoadAlign(q31, qP + 448);
            const uint32_t groups = (nv + 7) / 8;
            for (uint16_t g = 0; g < static_cast<uint16_t>(groups); ++g) {
                const uint32_t gb = g * 8;
                const uint32_t gv = (nv - gb < 8) ? (nv - gb) : 8;
                RegTensor<float> s0, s1, s2, s3, s4, s5, s6, s7, ov, vv;
                RegTensor<float> i01, i23, i45, i67, j0, j1, j2, j3;
                for (uint16_t k = 0; k < 8; ++k) {
                    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(bf, crowP + (gb + k) * D);
                    Cast<float, bfloat16_t, castB16F32>(xf0, bf, full);
                    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(bf, crowP + (gb + k) * D + 64);
                    Cast<float, bfloat16_t, castB16F32>(xf1, bf, full);
                    Mul(a0, xf0, q00, full); MulAddDst(a0, xf1, q01, full);
                    Mul(a1, xf0, q10, full); MulAddDst(a1, xf1, q11, full);
                    Mul(a2, xf0, q20, full); MulAddDst(a2, xf1, q21, full);
                    Mul(a3, xf0, q30, full); MulAddDst(a3, xf1, q31, full);
                    Reduce<ReduceType::SUM, float>(r0, a0, full);
                    Reduce<ReduceType::SUM, float>(r1, a1, full);
                    Reduce<ReduceType::SUM, float>(r2, a2, full);
                    Reduce<ReduceType::SUM, float>(r3, a3, full);
                    Relu(r0, r0, full); Relu(r1, r1, full); Relu(r2, r2, full); Relu(r3, r3, full);
                    Add(r0, r0, r1, full); Add(r2, r2, r3, full); Add(sb, r0, r2, full);
                    if (k == 0) Move(s0, sb, full);
                    else if (k == 1) Move(s1, sb, full);
                    else if (k == 2) Move(s2, sb, full);
                    else if (k == 3) Move(s3, sb, full);
                    else if (k == 4) Move(s4, sb, full);
                    else if (k == 5) Move(s5, sb, full);
                    else if (k == 6) Move(s6, sb, full);
                    else Move(s7, sb, full);
                }
                Interleave(i01, vv, s0, s4);
                Interleave(i23, vv, s2, s6);
                Interleave(i45, vv, s1, s5);
                Interleave(i67, vv, s3, s7);
                Interleave(j0, j1, i01, i23);
                Interleave(j2, j3, i45, i67);
                Interleave(ov, vv, j0, j2);
                if (gv < 8) {
                    uint32_t nc = gv;
                    MaskReg mgv = UpdateMask<float>(nc);
                    RegTensor<float> neg;
                    Duplicate(neg, -1.0f);
                    Select(ov, ov, neg, mgv);
                }
                uint32_t n8 = 8;
                MaskReg m8 = UpdateMask<float>(n8);
                StoreAlign(scP + gb, ov, m8);
            }
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(AIV_BUF_LOG);
        BufRel<PIPE_V>(AIV_BUF_CROW);
    }

    // 取回 4 头 q（qOut 由 AIV 0..3 各写 1 头；B1 屏障已保证其 MTE3 写落盘）
    __aicore__ inline void LoadQ()
    {
        BufAcq<PIPE_MTE2>(AIV_BUF_Q);
        DataCopy(MkT<bfloat16_t>(UB_Q, (NH * D) * 2), qOutGm[0], (NH * D) * 2);
        BufRel<PIPE_MTE2>(AIV_BUF_Q);
    }

    __aicore__ inline void DumpLogits()
    {
        if (nvalid == 0) return;
        BufAcq<PIPE_MTE3>(AIV_BUF_LOG);       // ScanChunk 的 V 侧阻塞 release 已承载 V→MTE3 可见性
        DataCopyPad(logitsGm[c0 * 2], MkT<bfloat16_t>(UB_SCORE, nvalid * 2),
                    DataCopyExtParams{1, static_cast<uint16_t>(nvalid * 4), 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_LOG);
    }

    // ============================================================
    // 选择段 —— **单核一等公民**（M53 重构）
    //
    // 为什么是单核：原实现每轮 radix 都要「56 核各写自己的计数到 GM → 全核读回求和」共 16 轮，
    // **在同一片槽上多轮复用**。本模块探针（probe_aiv_barrier.asc，6 个变体并列）实测这条用法的边界：
    //   · **单发一次交接可用**：v1（`Set<0,MTE3>(1)+Wait<0,MTE2>`，本 kernel 现在的交接用法）
    //     与 v4（官方 `SyncAll<true>()`）都是 **0/56 核违规、最少见到 56/56 槽**（每次复跑都如此）；
    //   · **同一片槽多轮复用不可证**（形态前提：每轮只挂一道"写完"屏障，读回后到下一轮写之前无屏障）：
    //     v2/v3/v5 每次都违规（本仓已归档 5 次运行里违规核 18~52/56、单次最少见到 1 个槽；
    //     只覆盖已归档运行、不作为上下界）⇒ **换成官方屏障也救不了复用**；
    //   · 对照 v0（不挂屏障）56/56 违规，证明探针敏感；
    //   · v4/v5 还排除了一种错误归因：官方形态是 mode0+flagId 14+`wait_flag_dev(PIPE_S,14)`，
    //     单发仍 0/56、循环仍违规 ⇒ 「wait 挂 MTE2 才是根因」不成立。
    //   ⇒ 结论是**适用边界**，不是"原语不可用"：本仓 `docs/06 §5.3` 早就记 mode0/mode2 直调**可用**
    //     （m0 就是"56 核写槽 → mode0 屏障 → 读回求和"并通过），`docs/06 §5.2 规则 6` 还预记了
    //     "先到的核对等不到全部 56 份数据（实测只收到 ~20/56）"——与本轮 v2/v3 的读数同量级。
    //     失败的是"复用 + 无重校验"，所以：**主 kernel 上表现为 per-AIV 的 K 随机分裂**
    //     （同一 case 连跑 3 次：分裂核与多数派 K 都不同）⇒ 选中集合不确定（B 档与自身 logits 的
    //     理想 top-512 差 84 个 block），而 token 计数却仍"看起来对"。
    // ⇒ 选择段改为**由 1 个核（SEL_CORE=0）在 GM 的分数向量上做**：核间只剩**一次交接**（正是 v1/v4
    //   证明可用的那种用法），而**选择逻辑与核数完全无关**（coreDiv 只影响打分切分）。
    //   这既是 mission 要求的「单核路径为第一等公民」，也让「多核 == 单核」成为构造性质（可实测）。
    // 注：若后续要把选择段并行化，前置条件是**带重校验的多轮交换协议**（而不是换一个屏障原语：
    //     本探针 v5 已证明官方 SyncAll 在复用下同样失败）。
    // 分工：
    //   S1（并行）打分 → DumpLogits 落 GM：每核只写自己那段列（打分逐列独立，与切分无关）
    //   S2（一次）交接：每核写完分数后写 4B「交接记号」（同 MTE3 管，顺序保证）→ 全体 barrier
    //                  → AIV0 读回记号，全到齐才继续；到不齐会写进 trace（host 自检 + oracle 兜底）
    //   S3（单核）radix 求第 blkTopk 大 key：分块读 GM，32 轮 × 1 候选（循环体约束见 ScanStage1）
    //   S4（单核）按列序压实：GT 组 rank = 运行序；tie 组 rank = gtTotal + 已用 tie 数
    // ============================================================

    // ---------------- S2：交接 ----------------
    // 记号值 = float(aiv+1) 的位型（正常浮点，避免次正规被冲洗）；region 用 cntGm 的 768 槽段
    // （原 c_gt/c_eq 交换区，单核选择后已闲置；host 每 case 会把它清 0）。
    __aicore__ inline void WriteToken()
    {
        LocalTensor<float> fv(TPosition::VECCALC, UB_TMPC, 1);
        fv.SetValue(0, static_cast<float>(aiv + 1));
        const int32_t bits = MkT<int32_t>(UB_TMPC, 1).GetValue(0);
        // 落盘源必须 32B 对齐（本模块 UB 偏移契约）：用 UB_TRACE 尾部 32B 槽
        BufAcq<PIPE_S>(AIV_BUF_CNT);           // 写侧成对（docs/05 §6.1 ⓔ：标量写 UB → 阻塞释放 → 再搬）
        MkT<int32_t>(UB_TRACE + 192, 1).SetValue(0, bits);
        BufRel<PIPE_S>(AIV_BUF_CNT);           // 阻塞释放：覆盖上面这次标量写（替代原 S_MTE3 事件对）
        BufAcq<PIPE_MTE3>(AIV_BUF_CNT);
        DataCopyPad(cntGm[768 + aiv * 2], MkT<bfloat16_t>(UB_TRACE + 192, 8),
                    DataCopyExtParams{1, 4, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_CNT);
    }

    // AIV0 读回记号区，数非 0 记号（一次 224B DMA + 一次归约，无循环）
    __aicore__ inline uint32_t CountTokens()
    {
        BufAcq<PIPE_MTE2>(AIV_BUF_CNT);
        DataCopyPad(MkT<bfloat16_t>(UB_CNTR, 128), cntGm[768],
                    DataCopyExtParams{1, static_cast<uint16_t>(naivTotal * 4), 0, 0, 0},
                    DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
        PipeBarrier<PIPE_MTE2>();
        BufRel<PIPE_MTE2>(AIV_BUF_CNT);       // 同一 id 的 MTE2 侧阻塞 release + V 侧 acq 已承载 MTE2→V 可见性
        __ubuf__ float* rd = reinterpret_cast<__ubuf__ float*>(UB_CNTR);
        BufAcq<PIPE_V>(AIV_BUF_CNT);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            MaskReg mk, m8;
            RegTensor<float> laneF, ones, acc, v;
            LoadAlign(laneF, reinterpret_cast<__ubuf__ float*>(UB_LANEF));
            MaskLtN(m8, laneF, 8.0f, full);
            MaskLtN(mk, laneF, static_cast<float>(naivTotal), full);
            Duplicate(ones, 1.0f);
            LoadAlign(v, rd);
            CompareScalar<float, CMPMODE::NE>(mk, v, 0.0f, mk);
            Reduce<ReduceType::SUM, float>(acc, ones, mk);
            StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_TMPA), acc, m8);
        }
        BufRel<PIPE_V>(AIV_BUF_CNT);
        VSync();
        return static_cast<uint32_t>(MkT<float>(UB_TMPA, 8).GetValue(0));
    }

    __aicore__ inline void VerifiedHandoff()
    {
        WriteToken();
        AivBarrier(FLAG_HANDOFF);
        if (aiv == SEL_CORE) {
            const uint32_t n = CountTokens();       // 标量算术留在循环外（见 ScanStage 注释）
            tokenSeen = n;
            handoffOK = (n >= naivTotal) ? 1u : 0u;
        }
    }

    // ---------------- S3/S4 公共原语 ----------------
    // 「把一段分数从 GM 搬进 UB_CROW」：单次 DMA，**无循环**，寄存器压力最小。
    // 注意：调用方必须在 V 侧 `BufAcq<PIPE_V>(AIV_BUF_CROW)` 后再读 UB_CROW
    // （与 ScanChunk 同款交接；缺这一步 = MTE2 未落 UB、V 已开始读 —— 实测症状是
    //  子块里只有零星几列被选中、输出少块，且加一条无关 DMA 就"消失"的 heisenbug）。
    __aicore__ inline void LoadStageOnly(uint32_t blk, uint32_t cols)
    {
        const uint32_t nvAlign = AlignUp(cols, CCHUNK);
        stageCols = cols;
        stageBase = blk * SELA_COLS;
        BufAcq<PIPE_MTE2>(AIV_BUF_CROW);
        DataCopy(MkT<bfloat16_t>(UB_CROW, nvAlign * 2), logitsGm[blk * SELA_COLS * 2], nvAlign * 2);
        PipeBarrier<PIPE_MTE2>();
        BufRel<PIPE_MTE2>(AIV_BUF_CROW);
    }

    // 「搬一块 + 单阈值计数」：循环体只有 1 比较 + 1 归约 + 1 加。
    // **这一段的循环体大小是有实测约束的**：本机编译器对 AIV 循环内的寄存器压力很敏感，
    // 只要循环体里多一条比较/多一个动态掩码，就报 `Unsupported scalar instruction in AIV loop`
    // （M53 实测：3 阈值版、带 lane 动态掩码版都过不了编译；1 阈值 + 满掩码版可以）。
    // 因此：①阈值一律在循环外算好；②循环内只用满掩码 `full`；③越界列靠 host 把整段 logits
    // 预填 NaN（0xFFFFFFFF）⇒ 与任何阈值比较都为假，不计入。
    __aicore__ inline void ScanStage1(uint32_t blk, uint32_t cols, float t1)
    {
        LoadStageOnly(blk, cols);             // 其 MTE2 侧阻塞 release + 下面 V 侧 acq 已承载 MTE2→V 可见性
        __ubuf__ float* stage = reinterpret_cast<__ubuf__ float*>(UB_CROW);
        BufAcq<PIPE_V>(AIV_BUF_CROW);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            RegTensor<float> ones, acc, r, v;
            Duplicate(ones, 1.0f);
            Duplicate(acc, 0.0f);
            const uint16_t nreg = static_cast<uint16_t>(AlignUp(cols, CCHUNK) / CCHUNK);
            for (uint16_t c = 0; c < nreg; ++c) {
                LoadAlign(v, stage + c * CCHUNK);
                MaskReg mk;
                CompareScalar<float, CMPMODE::GE>(mk, v, t1, full);
                Reduce<ReduceType::SUM, float>(r, ones, mk);
                Add(acc, acc, r, full);
            }
            StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_TMPA), acc, full);
        }
        BufRel<PIPE_V>(AIV_BUF_CROW);
        VSync();
        cnt1 = static_cast<uint32_t>(MkT<float>(UB_TMPA, 8).GetValue(0));
    }

    // ---------------- S3：radix（单核，1 bit/轮 ⇒ 32 轮）----------------
    // 「第 blkTopk 大 key」= 满足 count(key ≥ K) ≥ blkTopk 的最大 K（key 域 = int32 位型，score ≥ 0
    // ⇒ 位型序 = 数值序）。逐位贪心：能抬就抬。每轮只测 1 个候选（循环体最小，见 ScanStage1 注释）。
    __aicore__ inline void RadixSingleCore()
    {
        const uint32_t nstage = (V + SELA_COLS - 1) / SELA_COLS;
        uint32_t base = 0;
        uint32_t pass = 0;
        while (pass < 32) {
            const uint32_t shift = 31 - pass;
            const uint32_t cd = base + (1u << shift);
            const float t1 = KeyToFloat((cd > 0x7F7FFFFFu) ? 0x7FFFFFFF : static_cast<int32_t>(cd));
            uint32_t c1 = 0;
            uint32_t blk = 0;
            while (blk < nstage) {
                const uint32_t cols = MinU32(SELA_COLS, V - blk * SELA_COLS);
                ScanStage1(blk, cols, t1);
                c1 += cnt1;
                ++blk;
            }
            if (c1 >= blkTopkInt) base += (1u << shift);
            ++pass;
        }
        radixBaseEnd = base;
        candEQ = static_cast<int32_t>(base);
        candGT = (base + 1 > 0x7F7FFFFFu) ? 0x7FFFFFFF : static_cast<int32_t>(base + 1);
    }

    // ---------------- S4：按列序压实（单核：列序 = rank 序）----------------
    // 已搬好的 stage 在 UB_CROW；16 列一子块（4c ≤ 64 lane ⇒ c ≤ 16）
    __aicore__ inline void EmitStage(float thrGT, float thrEQ)
    {
        // UB_CROW 的 V 侧交接（与 ScanChunk 同款、**顺序**执行：不能跨 LoadStageOnly 的 MTE2 侧 acq
        // 去持有，否则同一 buffer id 的两侧 acq 会互等 —— 实测直接挂死）
        BufAcq<PIPE_V>(AIV_BUF_CROW);
        const uint32_t nsub = (stageCols + 15) / 16;
        uint32_t s = 0;
        while (s < nsub) {
            const uint32_t off = s * 16;
            const uint32_t nv = MinU32(16, stageCols - off);
            uint32_t cgt = 0;
            uint32_t ctie = 0;
            CountSub(off, nv, thrGT, thrEQ, cgt, ctie);
            if (cgt > 0) {
                if (gtEmitTotal == 0) firstRankBase = gtRank;
                EmitSub(off, stageBase + off, nv, cgt, true, gtRank, thrGT, thrEQ);
                gtRank += cgt;
                gtEmitTotal += cgt;
            }
            if (ctie > 0) {
                tieAll += ctie;
                if (tieUsed < need) {
                    const uint32_t take = MinU32(ctie, need - tieUsed);
                    EmitSub(off, stageBase + off, nv, take, false, gtTotal + tieUsed, thrGT, thrEQ);
                    tieUsed += take;
                }
            }
            ++s;
        }
        BufRel<PIPE_V>(AIV_BUF_CROW);
    }

    // ---------------- 选择段主入口（只由 SEL_CORE 调用）----------------
    __aicore__ inline void SelectSingleCore()
    {
        const uint32_t nstage = (V + SELA_COLS - 1) / SELA_COLS;
        if (V <= blkTopk) {                        // 可见块 ≤ 预算：全部选中（vLLM trivial 路径）
            candGT = 0;
            candEQ = -1;
            gtTotal = V;
            need = 0;
        } else {
            RadixSingleCore();                     // 第 blkTopk 大 key（单核，读 GM 分块）
            const float thr0 = KeyToFloat(candGT); // count(score > K) —— 一趟单独量
            uint32_t g = 0;
            uint32_t blk = 0;
            while (blk < nstage) {
                const uint32_t cols = MinU32(SELA_COLS, V - blk * SELA_COLS);
                ScanStage1(blk, cols, thr0);
                g += cnt1;
                ++blk;
            }
            gtTotal = g;
            need = (gtTotal >= blkTopk) ? 0u : (blkTopk - gtTotal);
        }
        const float thrGT = KeyToFloat(candGT);
        const float thrEQ = KeyToFloat(candEQ);
        uint32_t blk = 0;
        while (blk < nstage) {
            const uint32_t cols = MinU32(SELA_COLS, V - blk * SELA_COLS);
            LoadStageOnly(blk, cols);
            EmitStage(thrGT, thrEQ);
            ++blk;
        }
    }

    // ---------------- P5：压实输出 ----------------
    // 设计要点（按 tower 收口指令 a）：**每 16 列子块只做一次「打包 DMA」**，
    // 「逐元素 V/MTE3 交替」这个竞态源从结构上消失：
    //   (1) 16 列子块内选中的 block 索引用 `Squeeze` 一次压到 lane 0..c-1（官方 donor 同款：
    //       ops-transformer/attention/lightning_indexer 的 `Squeeze<T, STORE_REG>(sqz, idx, mask)`）；
    //   (2) 2 次 `Interleave` 自交错把索引 4× 复制（U 形展开），`Muls(4)` + `Add(lane%4)` 得 token；
    //   (3) 一次满掩码 `StoreAlign` 写暂存（UB_OUTS），再一次 `DataCopyPad` 写 packed 输出（16*c 字节）。
    //   c ≤ 16 保证 4c ≤ 64 lane（子块 16 列 ⇒ 恒成立）。
    // 计数与掩码：`count(key ≥ X) == count(score ≥ float(key(X)))`（score ≥ 0 ⇒ 位型序 = 数值序）；
    //   tie 掩码 = `score ≥ K` 且 **非** `score ≥ K+1`（用 GE + Not + And，不用对分数做 EQ 比较）。
    __aicore__ inline float KeyToFloat(int32_t key)
    {
        MkT<int32_t>(UB_TMPC, 1).SetValue(0, key);
        return MkT<float>(UB_TMPC, 1).GetValue(0);
    }

    // 16 列子块的 GT / tie 计数（key 域比较 → 浮点阈值比较；tie = GE(K) & !GE(K+1)）
    // （选择段单核路径：分数来源 = UB_CROW 的 stage（从 GM 搬来），off = 子块在该 stage 内的列偏移）
    __aicore__ inline void CountSub(uint32_t off, uint32_t nv, float thrGT, float thrEQ,
                                   uint32_t& cgt, uint32_t& ctie)
    {
        BufAcq<PIPE_V>(AIV_BUF_OUT);
        __ubuf__ float* sc = reinterpret_cast<__ubuf__ float*>(UB_CROW) + off;
        __VEC_SCOPE__ {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            MaskReg mNv, m8, mK, mK1, mTie;
            RegTensor<float> laneF, v, ones, cnt;
            LoadAlign(laneF, reinterpret_cast<__ubuf__ float*>(UB_LANEF));
            MaskLtN(mNv, laneF, static_cast<float>(nv), full);   // **只统计本子块的 nv 列**
            MaskLtN(m8, laneF, 8.0f, full);
            Duplicate(ones, 1.0f);
            LoadAlign(v, sc);
            CompareScalar<float, CMPMODE::GE>(mK1, v, thrGT, mNv);
            CompareScalar<float, CMPMODE::GE>(mK, v, thrEQ, mNv);
            Not(mTie, mK1, mNv);
            And(mTie, mTie, mK, mNv);
            Reduce<ReduceType::SUM, float>(cnt, ones, mK1);
            StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_TMPA), cnt, m8);
            Reduce<ReduceType::SUM, float>(cnt, ones, mTie);
            StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_TMPB), cnt, m8);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(AIV_BUF_OUT);
        VSync();
        cgt = static_cast<uint32_t>(MkT<float>(UB_TMPA, 8).GetValue(0));
        ctie = static_cast<uint32_t>(MkT<float>(UB_TMPB, 8).GetValue(0));
    }

    // 一次打包 DMA：Squeeze 压实 → 4× 展开成 token → 满掩码暂存 → 单次 DMA
    __aicore__ inline void EmitSub(uint32_t off, uint32_t gcol, uint32_t nv, uint32_t count, bool groupGt,
                                   uint32_t rankBase, float thrGT, float thrEQ)
    {
        BufAcq<PIPE_V>(AIV_BUF_OUT);
        __ubuf__ float* sc = reinterpret_cast<__ubuf__ float*>(UB_CROW) + off;
        __ubuf__ int32_t* ordP = reinterpret_cast<__ubuf__ int32_t*>(UB_ORD);
        BufAcq<PIPE_V>(AIV_BUF_RES);        // 发布 UB_OUTS
        __VEC_SCOPE__ {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            MaskReg fullI = CreateMask<int32_t, MaskPattern::ALL>();
            MaskReg mNv, mK, mK1, mTie, mSel;
            RegTensor<float> laneF, v;
            RegTensor<int32_t> idx, sq, d1, d2, vv, vv2, ord;
            LoadAlign(laneF, reinterpret_cast<__ubuf__ float*>(UB_LANEF));
            MaskLtN(mNv, laneF, static_cast<float>(nv), full);      // **只在本子块的 nv 列内选**
            LoadAlign(v, sc);
            CompareScalar<float, CMPMODE::GE>(mK1, v, thrGT, mNv);
            CompareScalar<float, CMPMODE::GE>(mK, v, thrEQ, mNv);
            Not(mTie, mK1, mNv);
            And(mTie, mTie, mK, mNv);
            mSel = groupGt ? mK1 : mTie;
            Arange(idx, static_cast<int32_t>(gcol));
            LoadAlign(ord, ordP);
            Squeeze<int32_t, Reg::GatherMaskMode::STORE_REG>(sq, idx, mSel);       // lane0..c-1 = 选中 block 索引（升序）
            Interleave(d1, vv, sq, sq);
            Interleave(d2, vv2, d1, d1);
            Muls(d2, d2, 4, fullI);
            Add(d2, d2, ord, fullI);
            StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_OUTS), d2, fullI);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(AIV_BUF_RES);
        BufRel<PIPE_V>(AIV_BUF_OUT);
        uint32_t emitCount = count;   // 同一 id 的 V 侧阻塞 release 已承载 V→MTE3 可见性（下面 BufAcq<MTE3>）
        if (rankBase >= blkTopkInt) { truncEmits += count; return; }              // 预算已满：整块不写（前面已 BufRel(RES)）
        if (rankBase + count > blkTopkInt) {                                      // 截断到剩余预算（不是整块丢弃）
            truncEmits += (rankBase + count - blkTopkInt);
            emitCount = blkTopkInt - rankBase;
        }  // 诊断：越界不写（防内存踩踏），计数上报
        BufAcq<PIPE_MTE3>(AIV_BUF_RES);
        DataCopyPad(outGm[rankBase * 8], MkT<bfloat16_t>(UB_OUTS, 64),
                    DataCopyExtParams{1, static_cast<uint16_t>(16 * emitCount), 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_RES);
    }

    // ---------------- P7：诊断 dump（前 32 个 AIV 各 32×int32 = 128B）----------------
    // 字段表（**M53 起**；与 evidence/MECHANISMS_FOUND.md 的表一致）：
    //   0 aiv  1 nvalid  2 truncEmits  3 gtEmitTotal  4 tieUsed  5 gtTotal  6 need
    //   7 handoffOK  8 tokenSeen  9 tieAll  10 firstRankBase  11 candGT  12 candEQ
    //   13 coreDiv  14 blkTopk  15 naivTotal  16 SEL_CORE
    //   17 per  18 c0  19 c1  20 nchunk  21 radixBaseEnd  22 V  23 (保留)
    // 只有 aiv == SEL_CORE 会填 3..12/15/21（选择段是单核的）；其余核只有 0/1/17..20 有意义。
    __aicore__ inline void DumpStats()
    {
        if (aiv >= 32) return;
        BufAcq<PIPE_S>(AIV_BUF_C2);           // 写侧成对（docs/05 §6.1 ⓔ：标量写 UB → 阻塞释放 → 再搬）
        LocalTensor<int32_t> st = MkT<int32_t>(UB_TRACE, 32);
        st.SetValue(0, static_cast<int32_t>(aiv));
        st.SetValue(1, static_cast<int32_t>(nvalid));
        st.SetValue(2, static_cast<int32_t>(truncEmits));
        st.SetValue(3, static_cast<int32_t>(gtEmitTotal));
        st.SetValue(4, static_cast<int32_t>(tieUsed));
        st.SetValue(5, static_cast<int32_t>(gtTotal));
        st.SetValue(6, static_cast<int32_t>(need));
        st.SetValue(7, static_cast<int32_t>(handoffOK));
        st.SetValue(8, static_cast<int32_t>(tokenSeen));
        st.SetValue(9, static_cast<int32_t>(tieAll));
        st.SetValue(10, static_cast<int32_t>(firstRankBase));
        st.SetValue(11, candGT);
        st.SetValue(12, candEQ);
        st.SetValue(13, static_cast<int32_t>(coreDiv));
        st.SetValue(14, static_cast<int32_t>(blkTopk));
        st.SetValue(15, static_cast<int32_t>(naivTotal));
        st.SetValue(16, static_cast<int32_t>(SEL_CORE));
        st.SetValue(17, static_cast<int32_t>(per));
        st.SetValue(18, static_cast<int32_t>(c0));
        st.SetValue(19, static_cast<int32_t>(c1));
        st.SetValue(20, static_cast<int32_t>(nchunk));
        st.SetValue(21, static_cast<int32_t>(radixBaseEnd));
        st.SetValue(22, static_cast<int32_t>(V));
        BufRel<PIPE_S>(AIV_BUF_C2);            // 阻塞释放：覆盖上面 23 次标量写（替代原 S_MTE3 事件对）
        BufAcq<PIPE_MTE3>(AIV_BUF_C2);
        DataCopyPad(statGm[aiv * 64], MkT<bfloat16_t>(UB_TRACE, 64), DataCopyExtParams{1, 128, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_C2);
    }

    // ---------------- P6：tail + count 列 ----------------
    __aicore__ inline void WriteTail()
    {
        uint32_t tailCount = (ppos + 1) - tstart;
        uint32_t complete = (V < blkTopk) ? V : blkTopk;
        uint32_t total = complete * RATIO + tailCount;
        __ubuf__ int32_t* tailP = reinterpret_cast<__ubuf__ int32_t*>(UB_TAIL);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            MaskReg m8;
            RegTensor<float> laneF;
            RegTensor<int32_t> t, v;
            LoadAlign(laneF, reinterpret_cast<__ubuf__ float*>(UB_LANEF));
            MaskLtN(m8, laneF, 8.0f, full);
            Arange(t, static_cast<int32_t>(tstart));
            Duplicate(v, static_cast<int32_t>(total));
            StoreAlign(tailP, t, m8);
            StoreAlign(tailP + 8, v, m8);
        }
        BufAcq<PIPE_V>(AIV_BUF_OUT);          // 发布 UB_TAIL
        BufRel<PIPE_V>(AIV_BUF_OUT);
        BufAcq<PIPE_MTE3>(AIV_BUF_OUT);
        if (tailCount > 0) {
            DataCopyPad(outGm[4096], MkT<bfloat16_t>(UB_TAIL, 8),
                        DataCopyExtParams{1, static_cast<uint16_t>(4 * tailCount), 0, 0, 0});
            PipeBarrier<PIPE_MTE3>();
        }
        DataCopyPad(outGm[4102], MkT<bfloat16_t>(UB_TAIL + 32, 8), DataCopyExtParams{1, 4, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(AIV_BUF_OUT);
    }

private:
    GlobalTensor<bfloat16_t> qkGm, wqGm, wkGm, cosqGm, sinqGm, cosgGm, singGm;
    GlobalTensor<bfloat16_t> ringGm, compGm, qOutGm, kOutGm, ckOutGm, logitsGm, outGm, cntGm, statGm;
    uint32_t V = 0, ppos = 0, closesGroup = 0, gidx = 0, tstart = 0;
    uint32_t blkTopk = BLK_TOPK;
    uint32_t blkTopkInt = BLK_TOPK;
    uint32_t coreDiv = NAIV;
    uint32_t aiv = 0, per = 0, c0 = 0, c1 = 0, nchunk = 0, nvalid = 0;
    int32_t candGT = 0, candEQ = 0;
    // ---- 选择段（M53：单核一等公民）----
    uint32_t naivTotal = 56;          // 本次 launch 的 AIV 数（host 用 API 取后传入，不硬编码）
    uint32_t stageCols = 0;           // 当前 stage 的有效列数
    uint32_t stageBase = 0;           // 当前 stage 的全局列起点
    uint32_t cnt1 = 0, cnt2 = 0, cnt3 = 0;   // ScanStage 的 3 个阈值计数
    uint32_t gtRank = 0;              // GT 组运行 rank（单核 ⇒ = 全局 rank）
    uint32_t gtEmitTotal = 0;         // 已写出的 GT 个数（期望 == gtTotal）
    uint32_t tieUsed = 0;             // 已写出的 tie 个数
    uint32_t tieAll = 0;              // 本核见到的 tie 总数（诊断：与 need 比）
    uint32_t need = 0;                // blkTopk − gtTotal
    uint32_t gtTotal = 0;             // count(score > K)
    uint32_t handoffOK = 0;           // 交接：记号是否到齐
    uint32_t tokenSeen = 0;           // AIV0 读到的记号个数（期望 = naivTotal）
    uint32_t radixBaseEnd = 0;        // radix 收敛后的 key（= candEQ 的位型）
    uint32_t truncEmits = 0;          // 截断计数（安全网；正常路径恒 0）
    uint32_t firstRankBase = 0;
};

// ============================================================
// 3. Kernel 入口（mix(1,2)：AIC 做 index_qk_proj，AIV 做 norm/rope/压缩/打分/选择）
// ============================================================

__global__ __mix__(1, 2) void m19_qsa_indexer_kernel(
    __gm__ uint8_t* x, __gm__ uint8_t* wqk, __gm__ uint8_t* wq, __gm__ uint8_t* wk,
    __gm__ uint8_t* cosQ, __gm__ uint8_t* sinQ, __gm__ uint8_t* cosG, __gm__ uint8_t* sinG,
    __gm__ uint8_t* ring, __gm__ uint8_t* comp, __gm__ uint8_t* qk,
    __gm__ uint8_t* qOut, __gm__ uint8_t* kOut, __gm__ uint8_t* ckOut,
    __gm__ uint8_t* logits, __gm__ uint8_t* outG, __gm__ uint8_t* cntG, __gm__ uint8_t* statG,
    uint32_t vBlocks, uint32_t mRows, uint32_t pos, uint32_t closes, uint32_t groupIdx, uint32_t tailStart,
    uint32_t blkTopk, uint32_t singleAiv, uint32_t coreNum)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIC {
        QkGemm gemm;
        gemm.Init(x, wqk, qk, mRows, 0u);   // TODO: N 块多 AIC 切分（当前 AIC 0 独占）
        gemm.Process();
        // 全体 AIC 的 N 块都落盘后再通知各自配对的 2 个 AIV（mode 2）
        AscendC::CrossCoreSetFlag<0x0, PIPE_FIX>(FLAG_AIC_BAR);
        AscendC::CrossCoreWaitFlag<0x0, PIPE_FIX>(FLAG_AIC_BAR);
        // 原 FIX_S 事件对已删：本处无「标量写 UB」形态（AIC 不访问 UB，docs/05 §6.1 ⓔ），
        // 屏障 set 与下面的 mode2 set 都挂在 PIPE_FIX 上 ⇒ 同 pipe 次序由 CrossCoreSetFlag 的
        // drain 触发 + PIPE_FIX 队列保序承载，FIX_S 事件对与二者重复。
        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(FLAG_CV);
    }
    if ASCEND_IS_AIV {
        QsaIndexerAiv op;
        op.Init(qk, wq, wk, cosQ, sinQ, cosG, sinG, ring, comp, qOut, kOut, ckOut, logits, outG, cntG, statG,
                vBlocks, pos, closes, groupIdx, tailStart, blkTopk, singleAiv, coreNum);
        op.Process();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

}  // namespace

// ============================================================
// 4. Host 侧：确定性输入生成 / 运行 / 自检 / dump（供 check_ref.py 交叉验证）
// ============================================================

#include <vector>

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    if ((x & 0x7F800000u) == 0x7F800000u) return static_cast<uint16_t>((x >> 16) & 0xFFFFu);
    uint32_t r = (x + 0x7FFFu + ((x >> 16) & 1u)) >> 16;
    return static_cast<uint16_t>(r & 0xFFFFu);
}

static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

// 有限 bf16 伪随机值（确定性 LCG；指数限制在 0x3C..0x43，避免 Inf/NaN）
static uint32_t LcgNext(uint32_t& s)
{
    s = s * 1664525u + 1013904223u;
    return s;
}

static uint16_t RandBf16(uint32_t& s)
{
    uint32_t r = LcgNext(s);
    uint32_t sign = (r >> 31) & 1u;
    uint32_t exp = 0x78u + ((r >> 24) & 0x07u);
    uint32_t man = (r >> 8) & 0x7Fu;
    return static_cast<uint16_t>((sign << 15) | (exp << 7) | man);
}

static void WriteFile(const char* dir, const char* name, const void* data, size_t bytes)
{
    char path[1024];
    snprintf(path, sizeof(path), "%s/%s", dir, name);
    FILE* f = fopen(path, "wb");
    if (!f) { printf("[M19] cannot write %s\n", path); return; }
    fwrite(data, 1, bytes, f);
    fclose(f);
}

static bool ReadFile(const char* path, void* data, size_t bytes)
{
    FILE* f = fopen(path, "rb");
    if (!f) return false;
    size_t n = fread(data, 1, bytes, f);
    fclose(f);
    return n == bytes;
}

struct M19Case {
    const char* name;
    uint32_t pos;
    uint32_t vblocks;
};

int32_t main(int32_t argc, char** argv)
{
    // 选择段状态（M53）：**已通过**（默认 4 档 2048/2050/1024/2048；小档矩阵 coreDiv=1..56 逐块 oracle
    // 全对；默认 4 档 9 次独立进程计数逐次相同）。M35 的 partial-landing 横幅与「未标注即拒绝运行」
    // 守卫已按 mission 要求移除 —— 去除依据见 README 顶部与 evidence/select_single_core.log。
    // 三态退出码仍有效：0 = 判据比过且通过；1 = 比过但有差异；2 = 没有真正执行比较（如输入缺失）。
    const char* outDir = getenv("M19_OUT");
    if (outDir == nullptr) outDir = "./m19_out";

    M19Case cases[4] = {
        {"A_close_2048", 8191u, 2048u},
        {"B_open_2048", 8193u, 2048u},
        {"C_small_256", 1023u, 256u},
        {"D_max_65536", 262143u, 65536u},
    };
    uint32_t runCount = 4;
    if (argc > 1) {
        int idx = atoi(argv[1]);
        if (idx >= 0 && idx < 4) { cases[0] = cases[idx]; runCount = 1; }
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    // 核数一律走 API（不硬编码 28/56）：查询必须在 aclInit/aclrtSetDevice 之后，且**必须查返回值**；
    // AIV 数拿不到时按 mix(1,2) 的 2 倍粒度兜底（并打印 WARN），绝不静默退化成 1（那会改变列切分）
    int64_t aicNum = 0, aivNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("[M19] WARN: AICORE_CORE_NUM query failed, fallback 28\n");
        aicNum = 28;
    }
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum) != ACL_SUCCESS || aivNum <= 0) {
        printf("[M19] WARN: VECTOR_CORE_NUM query failed, fallback 2*AICORE=%ld\n", 2 * aicNum);
        aivNum = 2 * aicNum;
    }
    const uint32_t numBlocks = static_cast<uint32_t>(aicNum);
    printf("[M19] AICORE=%ld VECTOR=%ld numBlocks=%u\n", aicNum, aivNum, numBlocks);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // ---- 权重（checkpoint 抽取，layer 3）----
    const size_t wqkBytes = static_cast<size_t>(QK_W) * HIDDEN * 2;
    std::vector<uint8_t> wqkHost(wqkBytes);
    std::vector<uint8_t> wqnHost(D * 2), wknHost(D * 2);
    if (!ReadFile("m19_qsa_indexer/data/layer3_index_qk_proj.bin", wqkHost.data(), wqkBytes)) {
        printf("[M19] FATAL: cannot read index_qk_proj weight\n"); return 2;
    }
    if (!ReadFile("m19_qsa_indexer/data/layer3_q_layernorm.bin", wqnHost.data(), D * 2)) {
        printf("[M19] FATAL: cannot read q_layernorm\n"); return 2;
    }
    if (!ReadFile("m19_qsa_indexer/data/layer3_k_layernorm.bin", wknHost.data(), D * 2)) {
        printf("[M19] FATAL: cannot read k_layernorm\n"); return 2;
    }

    const size_t xBytes = static_cast<size_t>(M_MAX) * HIDDEN * 2;
    const size_t compBytes = static_cast<size_t>(V_MAX) * D * 2;
    const size_t qkBytes = static_cast<size_t>(M_MAX) * QK_W * 2;
    const size_t logitsBytes = static_cast<size_t>(V_MAX) * 4;
    const size_t outBytes = static_cast<size_t>(PACKED_WIDTH) * 4;
    const size_t cntBytes = 16u * 256u;

    std::vector<uint8_t> xHost(xBytes, 0), ringHost(RATIO * D * 2), compHost(compBytes, 0);
    std::vector<uint8_t> cosQ(ROT_HALF * 2), sinQ(ROT_HALF * 2), cosG(ROT_HALF * 2), sinG(ROT_HALF * 2);
    std::vector<uint8_t> qkHost(qkBytes, 0), qOutHost(static_cast<size_t>(QW) * 4, 0);
    std::vector<uint8_t> kOutHost(D * 2, 0), ckOutHost(D * 2, 0);
    std::vector<uint8_t> logitsHost(logitsBytes, 0), outHost(outBytes, 0), cntHost(cntBytes, 0);
    std::vector<uint8_t> statHost(4096, 0);

    uint8_t* dX = nullptr; uint8_t* dWqk = nullptr; uint8_t* dWq = nullptr; uint8_t* dWk = nullptr;
    uint8_t* dCosQ = nullptr; uint8_t* dSinQ = nullptr; uint8_t* dCosG = nullptr; uint8_t* dSinG = nullptr;
    uint8_t* dRing = nullptr; uint8_t* dComp = nullptr; uint8_t* dQk = nullptr;
    uint8_t* dQOut = nullptr; uint8_t* dKOut = nullptr; uint8_t* dCkOut = nullptr;
    uint8_t* dLogits = nullptr; uint8_t* dOut = nullptr; uint8_t* dCnt = nullptr; uint8_t* dStat = nullptr;

    aclrtMalloc(reinterpret_cast<void**>(&dX), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dWqk), wqkBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dWq), D * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dWk), D * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dCosQ), ROT_HALF * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dSinQ), ROT_HALF * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dCosG), ROT_HALF * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dSinG), ROT_HALF * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dRing), RATIO * D * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dComp), compBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dQk), qkBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dQOut), static_cast<size_t>(QW) * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dKOut), D * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dCkOut), D * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dLogits), logitsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dOut), outBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dCnt), cntBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dStat), 4096, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(dWqk, wqkBytes, wqkHost.data(), wqkBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dWq, D * 2, wqnHost.data(), D * 2, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dWk, D * 2, wknHost.data(), D * 2, ACL_MEMCPY_HOST_TO_DEVICE);

    bool allOk = true;
    for (uint32_t c = 0; c < runCount; ++c) {
        const M19Case& cs = cases[c];
        const uint32_t V = (getenv("M19_V") != nullptr) ? static_cast<uint32_t>(atoi(getenv("M19_V"))) : cs.vblocks;
        const uint32_t blkTopkCfg = (getenv("M19_BUDGET") != nullptr) ? static_cast<uint32_t>(atoi(getenv("M19_BUDGET"))) / RATIO : 0u;
        uint32_t singleAivCfg = (getenv("M19_CORES") != nullptr)
                                    ? static_cast<uint32_t>(atoi(getenv("M19_CORES")))
                                    : ((getenv("M19_SINGLE") != nullptr) ? 1u : 0u);
        if (singleAivCfg && V > PER_MAX) {   // 打分列切分过细时每核列数 = AlignUp(ceil(V/coreDiv),64) 仍 ≤ PER_MAX
            printf("[M19] WARN: M19_CORES=%u 但 V=%u>%u 超出 UB_SCORE 容量（PER_MAX=2048 列），改用默认核数\n",
                   singleAivCfg, V, PER_MAX);
            singleAivCfg = 0u;
        }
        // M19_V 覆盖时 pos 必须跟着 V 走（否则「可见块数」与「序列长度」自相矛盾：
        // 例如 V=2048 却 pos=1023 ⇒ 序列只有 1024 个 token，越界 token 检查必失败）。
        // 取 pos+1 = 4V（刚好收一个完整压缩组、tail=0）⇒ visible_blocks = V 自洽。
        uint32_t pos = (getenv("M19_V") != nullptr) ? (4u * V - 1u) : cs.pos;
        if (getenv("M19_POS") != nullptr) pos = static_cast<uint32_t>(atoi(getenv("M19_POS")));  // 显式覆盖（测 tail>0 档）
        const uint32_t closes = ((pos + 1) % RATIO == 0) ? 1u : 0u;
        const uint32_t groupIdx = pos / RATIO;
        const uint32_t tailStart = ((pos + 1) / RATIO) * RATIO;

        // ---- 确定性输入 ----
        uint32_t seed = 0x12345678u + c * 7919u;
        {
            uint16_t* p = reinterpret_cast<uint16_t*>(xHost.data());
            for (size_t i = 0; i < xBytes / 2; ++i) p[i] = RandBf16(seed);
            uint16_t* r = reinterpret_cast<uint16_t*>(ringHost.data());
            for (size_t i = 0; i < RATIO * D; ++i) r[i] = RandBf16(seed);
            uint16_t* cp = reinterpret_cast<uint16_t*>(compHost.data());
            for (size_t i = 0; i < static_cast<size_t>(V) * D; ++i) cp[i] = RandBf16(seed);   // 其余为 0
        }
        auto fillCosSin = [](std::vector<uint8_t>& cb, std::vector<uint8_t>& sb, uint32_t position) {
            uint16_t* cc = reinterpret_cast<uint16_t*>(cb.data());
            uint16_t* ss = reinterpret_cast<uint16_t*>(sb.data());
            for (uint32_t j = 0; j < ROT_HALF; ++j) {
                double theta = 1.0e7;
                double ang = static_cast<double>(position) * std::pow(theta, -2.0 * j / static_cast<double>(ROT));
                cc[j] = F32ToBf16(static_cast<float>(std::cos(ang)));
                ss[j] = F32ToBf16(static_cast<float>(std::sin(ang)));
            }
        };
        fillCosSin(cosQ, sinQ, pos);
        fillCosSin(cosG, sinG, (pos + 1 >= RATIO) ? (pos - RATIO + 1) : 0u);

        aclrtMemcpy(dX, xBytes, xHost.data(), xBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dRing, RATIO * D * 2, ringHost.data(), RATIO * D * 2, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dComp, compBytes, compHost.data(), compBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dCosQ, ROT_HALF * 2, cosQ.data(), ROT_HALF * 2, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dSinQ, ROT_HALF * 2, sinQ.data(), ROT_HALF * 2, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dCosG, ROT_HALF * 2, cosG.data(), ROT_HALF * 2, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dSinG, ROT_HALF * 2, sinG.data(), ROT_HALF * 2, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dOut, outBytes, outHost.data(), outBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemset(dCnt, cntBytes, 0, cntBytes);
        aclrtMemset(dQk, qkBytes, 0, qkBytes);
        aclrtMemset(dQOut, static_cast<size_t>(QW) * 4, 0, static_cast<size_t>(QW) * 4);
        aclrtMemset(dKOut, D * 2, 0, D * 2);
        aclrtMemset(dCkOut, D * 2, 0, D * 2);
        aclrtMemset(dLogits, logitsBytes, 0xFF, logitsBytes);  // 整段预填 0xFFFFFFFF = NaN 哨兵（越界列不计入）

        m19_qsa_indexer_kernel<<<numBlocks, 0, stream>>>(
            dX, dWqk, dWq, dWk, dCosQ, dSinQ, dCosG, dSinG, dRing, dComp, dQk,
            dQOut, dKOut, dCkOut, dLogits, dOut, dCnt, dStat,
            V, 1u, pos, closes, groupIdx, tailStart, blkTopkCfg, singleAivCfg,
            static_cast<uint32_t>(aivNum));
        const aclError err = aclrtSynchronizeStream(stream);
        printf("[M19] %-14s V=%-6u pos=%-7u closes=%u tail=%u : launch %s\n",
               cs.name, V, pos, closes, (pos + 1) - tailStart, err == ACL_SUCCESS ? "OK" : "FAILED");
        if (err != ACL_SUCCESS) { allOk = false; continue; }

        aclrtMemcpy(qkHost.data(), qkBytes, dQk, qkBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(qOutHost.data(), static_cast<size_t>(QW) * 4, dQOut, static_cast<size_t>(QW) * 4, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(kOutHost.data(), D * 2, dKOut, D * 2, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(ckOutHost.data(), D * 2, dCkOut, D * 2, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(logitsHost.data(), static_cast<size_t>(V) * 4, dLogits, static_cast<size_t>(V) * 4, ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(outHost.data(), outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        std::vector<uint8_t> cntDump(4096);
        aclrtMemcpy(cntDump.data(), 4096, dCnt, 4096, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outDir, (std::string(cs.name) + "_cnt.bin").c_str(), cntDump.data(), 4096);
        aclrtMemcpy(statHost.data(), 4096, dStat, 4096, ACL_MEMCPY_DEVICE_TO_HOST);
        WriteFile(outDir, (std::string(cs.name) + "_stats.bin").c_str(), statHost.data(), 4096);

        // ---- 设备侧自检（不依赖参考实现的不变量）----
        const int32_t* o = reinterpret_cast<const int32_t*>(outHost.data());
        const uint32_t tailCount = (pos + 1) - tailStart;
        const uint32_t blkTopkEff = (blkTopkCfg != 0u) ? blkTopkCfg : BLK_TOPK;
        const uint32_t complete = (V < blkTopkEff) ? V : blkTopkEff;
        const uint32_t expectCount = complete * RATIO + tailCount;
        bool ok = true;
        if (static_cast<uint32_t>(o[OUT_WIDTH]) != expectCount) {
            printf("[M19][FAIL] %s count 列 = %d，期望 %u\n", cs.name, o[OUT_WIDTH], expectCount);
            ok = false;
        }
        // packed 布局（README §1.6）：块区 [0, 4*complete)、**tail 区固定在模型列 [BUDGET, BUDGET+tail)**、
        // count 列在 OUT_WIDTH=2051。M19_BUDGET 覆盖只改"选多少块"，不改这套固定列 ⇒ 这里按固定列检查。
        uint32_t nTokens = 0, badTok = 0;
        for (uint32_t i = 0; i < complete * RATIO; ++i) {
            if (o[i] >= 0) {
                ++nTokens;
                if (static_cast<uint32_t>(o[i]) >= tailStart + tailCount) ++badTok;   // token 上界 = p
            }
        }
        for (uint32_t i = BUDGET; i < BUDGET + tailCount; ++i) {
            if (o[i] >= 0) {
                ++nTokens;
                if (static_cast<uint32_t>(o[i]) >= tailStart + tailCount) ++badTok;
            }
        }
        if (nTokens != expectCount) { printf("[M19][FAIL] %s 有效 token 数 %u != %u\n", cs.name, nTokens, expectCount); ok = false; }
        if (badTok != 0) { printf("[M19][FAIL] %s 越界 token 数 %u\n", cs.name, badTok); ok = false; }
        for (uint32_t i = complete * RATIO; i < BUDGET; ++i) {   // 块区与固定 tail 区之间的间隙必须 -1
            if (o[i] != -1) { printf("[M19][FAIL] %s 列 %u 未填 -1（块区与 tail 区之间）\n", cs.name, i); ok = false; break; }
        }
        for (uint32_t i = BUDGET + tailCount; i < OUT_WIDTH; ++i) {
            if (o[i] != -1) { printf("[M19][FAIL] %s 列 %u 未填 -1\n", cs.name, i); ok = false; break; }
        }
        // 选中集合去重检查（block 级：4 元组内 token 不得跨 block 重号）
        // 交接校验（P2-1）：AIV0 的 stats 记录里 handoffOK=1 且 tokenSeen == AIV 数，才算"交接到齐"。
        // 这是把 kernel 侧校验真正接进判定的地方（kernel 无法跨核 kill，只能由 host 判定）。
        {
            const int32_t* st0 = reinterpret_cast<const int32_t*>(statHost.data());
            const int32_t hOk = st0[7];
            const int32_t seen = st0[8];
            if (hOk != 1 || seen != static_cast<int32_t>(aivNum)) {
                printf("[M19][FAIL] %s 交接未到齐：handoffOK=%d tokenSeen=%d（期望 1 / %ld）\n",
                       cs.name, hOk, seen, static_cast<long>(aivNum));
                ok = false;
            }
        }
        printf("[M19] %-14s 自检 %s  count=%d tokens=%u\n", cs.name, ok ? "PASS" : "FAIL", o[OUT_WIDTH], nTokens);
        allOk = allOk && ok;

        // ---- dump（供 check_ref.py）----
        char pfx[256];
        snprintf(pfx, sizeof(pfx), "%s/%s", outDir, cs.name);
        char path[1024];
        snprintf(path, sizeof(path), "%s_x.bin", pfx);
        WriteFile(outDir, (std::string(cs.name) + "_x.bin").c_str(), xHost.data(), 2u * HIDDEN * 2);
        WriteFile(outDir, (std::string(cs.name) + "_ring.bin").c_str(), ringHost.data(), RATIO * D * 2);
        WriteFile(outDir, (std::string(cs.name) + "_comp.bin").c_str(), compHost.data(), static_cast<size_t>(V) * D * 2);
        WriteFile(outDir, (std::string(cs.name) + "_cosq.bin").c_str(), cosQ.data(), ROT_HALF * 2);
        WriteFile(outDir, (std::string(cs.name) + "_sinq.bin").c_str(), sinQ.data(), ROT_HALF * 2);
        WriteFile(outDir, (std::string(cs.name) + "_cosg.bin").c_str(), cosG.data(), ROT_HALF * 2);
        WriteFile(outDir, (std::string(cs.name) + "_sing.bin").c_str(), sinG.data(), ROT_HALF * 2);
        WriteFile(outDir, (std::string(cs.name) + "_qk.bin").c_str(), qkHost.data(), QK_W * 2);
        WriteFile(outDir, (std::string(cs.name) + "_qout.bin").c_str(), qOutHost.data(), static_cast<size_t>(QW) * 4);
        WriteFile(outDir, (std::string(cs.name) + "_kout.bin").c_str(), kOutHost.data(), D * 2);
        WriteFile(outDir, (std::string(cs.name) + "_ckout.bin").c_str(), ckOutHost.data(), D * 2);
        WriteFile(outDir, (std::string(cs.name) + "_logits.bin").c_str(), logitsHost.data(), static_cast<size_t>(V) * 4);
        WriteFile(outDir, (std::string(cs.name) + "_out.bin").c_str(), outHost.data(), outBytes);
        char meta[512];
        snprintf(meta, sizeof(meta),
                 "case %s\npos %u\nvblocks %u\ncloses %u\ngroup_index %u\ntail_start %u\ntail_count %u\n"
                 "budget %u\nblk_topk %u\ncores %u\nratio %u\nheads %u\nhead_dim %u\nrotary_dim %u\nhid %u\n",
                 cs.name, pos, V, closes, groupIdx, tailStart, tailCount, BUDGET, blkTopkEff,
                 (singleAivCfg != 0u) ? singleAivCfg : static_cast<uint32_t>(aivNum),
                 RATIO, NH, D, ROT, HIDDEN);
        WriteFile(outDir, (std::string(cs.name) + "_meta.txt").c_str(), meta, strlen(meta));
    }

    printf("[M19] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
