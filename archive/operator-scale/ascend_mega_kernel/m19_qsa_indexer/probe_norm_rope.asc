/**
 * probe_norm_rope.asc —— M19 探针：AIV「128 维 GemmaRMSNorm + partial NeoX RoPE + bf16 打包」分段判定
 *
 * 动机（tower 指令 ③）：QSA indexer 前端的 q 路径已与参考对齐（rel 2.6e-3 = 参考在 RoPE 前
 * 取整 bf16 的差别），但 compressed 行 dump 出现 NaN 且**全部落在奇数维**——bf16 打包的典型症状。
 * 本探针把该段拆成 7 段，逐 lane / 逐元素判定，并对**每一段 dump 都做正确的 BufferID 交接**
 * （上一版探针的 dump 缺交接，读数不可信，这正是主 kernel 里 ck 段同类 bug 的教训）。
 *
 * 段：
 *   S0 切片搬运 lane 语义（bf16 源，唯一编码）
 *   S1 per-lane 平方和 + rstd + norm（bf16 源）      —— q 路径
 *   S2 RoPE（bf16 源）
 *   S3 4 行 bf16 均值 + Muls(1/4) + RoundBf16        —— compressed 路径第一段
 *   S4 norm + RoPE（**fp32 源**，与 KPath 同形，原地写 UB_POOL）
 *   S5 PackBf16（fp32 → 打包 bf16，与 KPath 同形）
 *   S6 RoundBf16 边界位型（尾数全 1 进位 / 零 / 次正规 / 大指数 / 负数 / 中点）
 *
 * 权威规格：`/workspace/vllm/vllm/models/qwen4_exp/nvidia/ops/qsa_pre_indexer.py::_norm_rope`
 * 约束：纯 AIV（`__vector__ __global__`，blockDim=1）；基础 API；无 TPipe/TBuf/TQue/AllocTensor；
 *       UB 偏移全静态 + 32B 对齐；每段 dump 都有 V->MTE3 BufferID 交接。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstring>
#include <cmath>

namespace {

using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t D = 128;
constexpr uint32_t HALF = 64;
constexpr uint32_t QUART = 32;
constexpr float RMS_EPS = 1e-6f;

// ---- UB 布局（字节；每段独立 staging，避免别名 + 各自 BufferID）----
constexpr uint32_t P_X   = 0;       // bf16 [128]   256B  输入行（唯一编码）
constexpr uint32_t P_W   = 256;     // bf16 [128]   256B  权重
constexpr uint32_t P_CS  = 512;     // bf16 [64]    128B  cos32|sin32
constexpr uint32_t P_TB  = 640;     // fp32 [64]    256B  RoundBf16 边界位型
constexpr uint32_t P_R4  = 896;     // bf16 [4][128] 1024B 4 行"原始 key"（唯一编码）
constexpr uint32_t P_ST0 = 1920;    // fp32 [256]   1024B S0/S1/S2 staging
constexpr uint32_t P_ST1 = 2944;    // fp32 [256]   1024B S3/S4 staging
constexpr uint32_t P_ST2 = 3968;    // bf16 [128]   256B  S5 打包结果
constexpr uint32_t P_ST3 = 4224;    // fp32 [64]    256B  S6 staging
constexpr uint32_t P_TOT = 4480;

constexpr MutexID P_BUF_IN = 0;     // MTE2 -> V
constexpr MutexID P_BUF_S0 = 2;     // V -> MTE3（S0）
constexpr MutexID P_BUF_S1 = 3;     // V -> MTE3（S1/S2）
constexpr MutexID P_BUF_S3 = 4;     // V -> MTE3（S3/S4）
constexpr MutexID P_BUF_S5 = 5;     // V -> MTE3（S5）
constexpr MutexID P_BUF_S6 = 6;     // V -> MTE3（S6）

template <pipe_t pipe>
__aicore__ inline void BufAcq(MutexID id) { GetBufInternal<pipe, false>(id); }
template <pipe_t pipe>
__aicore__ inline void BufRel(MutexID id) { RlsBufInternal<pipe, false>(id); }

template <typename T>
__aicore__ inline LocalTensor<T> PT(uint32_t off, uint32_t n)
{
    return LocalTensor<T>(TPosition::VECCALC, off, n);
}

constexpr CastTrait cB16F32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING, RoundMode::UNKNOWN};

__simd_callee__ inline void LoadSlice(RegTensor<float>& dst, __ubuf__ bfloat16_t* src, MaskReg& m)
{
    RegTensor<bfloat16_t> t;
    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(t, src);
    Cast<float, bfloat16_t, cB16F32>(dst, t, m);
}

// 与主 kernel 逐字同款：fp32 -> bf16(RNE) -> fp32（整数位打包）
__simd_callee__ inline void RoundBf16(RegTensor<float>& v, MaskReg& m)
{
    RegTensor<int32_t> sh, one, half, t;
    Duplicate(sh, 16);
    Duplicate(one, 1);
    Duplicate(half, 0x7FFF);
    ShiftRight(t, reinterpret_cast<RegTensor<int32_t>&>(v), sh, m);
    And(t, t, one, m);
    Add(t, reinterpret_cast<RegTensor<int32_t>&>(v), t, m);
    Add(t, t, half, m);
    ShiftRight(t, t, sh, m);
    ShiftLeft(reinterpret_cast<RegTensor<int32_t>&>(v), t, sh, m);
}

// 与主 kernel 逐字同款：fp32[128] -> bf16[128] 打包（4 个 32-lane slice，每 slice 16 个 int32）
__simd_callee__ inline void PackBf16(__ubuf__ float* src, __ubuf__ int32_t* dst)
{
    uint32_t n16 = 16;
    MaskReg m16 = UpdateMask<int32_t>(n16);
    RegTensor<float> v;
    RegTensor<int32_t> t, one, half, sh, ev, od, pk;
    Duplicate(sh, 16);
    Duplicate(one, 1);
    Duplicate(half, 0x7FFF);
    for (uint16_t s = 0; s < 4; ++s) {
        LoadAlign(v, src + s * 32);
        ShiftRight(t, reinterpret_cast<RegTensor<int32_t>&>(v), sh, m16);
        And(t, t, one, m16);
        Add(t, reinterpret_cast<RegTensor<int32_t>&>(v), t, m16);
        Add(t, t, half, m16);
        ShiftRight(t, t, sh, m16);
        DeInterleave(ev, od, t, t);
        ShiftLeft(od, od, sh, m16);
        Or(pk, ev, od, m16);
        StoreAlign(dst + s * 16, pk, m16);
    }
}

class NormRopeProbe {
public:
    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* cs, __gm__ uint8_t* tb,
                                __gm__ uint8_t* r4,
                                __gm__ uint8_t* oS0, __gm__ uint8_t* oS1, __gm__ uint8_t* oS3,
                                __gm__ uint8_t* oS5, __gm__ uint8_t* oS6)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x));
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(w));
        csGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(cs));
        tbGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(tb));
        r4Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(r4));
        s0Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(oS0));
        s1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(oS1));
        s3Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(oS3));
        s5Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(oS5));
        s6Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(oS6));
    }

    __aicore__ inline void Process()
    {
        BufAcq<PIPE_MTE2>(P_BUF_IN);
        DataCopy(PT<bfloat16_t>(P_X, D), xGm[0], D);
        PipeBarrier<PIPE_MTE2>();
        DataCopy(PT<bfloat16_t>(P_W, D), wGm[0], D);
        PipeBarrier<PIPE_MTE2>();
        DataCopy(PT<bfloat16_t>(P_CS, QUART), csGm[0], QUART);
        PipeBarrier<PIPE_MTE2>();
        DataCopy(PT<bfloat16_t>(P_CS + 64, QUART), csGm[QUART], QUART);
        PipeBarrier<PIPE_MTE2>();
        DataCopy(PT<bfloat16_t>(P_TB, 128), tbGm[0], 128);
        PipeBarrier<PIPE_MTE2>();
        DataCopy(PT<bfloat16_t>(P_R4, 4 * D), r4Gm[0], 4 * D);
        BufRel<PIPE_MTE2>(P_BUF_IN);

        __ubuf__ bfloat16_t* xp = reinterpret_cast<__ubuf__ bfloat16_t*>(P_X);
        __ubuf__ bfloat16_t* wp = reinterpret_cast<__ubuf__ bfloat16_t*>(P_W);
        __ubuf__ bfloat16_t* csp = reinterpret_cast<__ubuf__ bfloat16_t*>(P_CS);
        __ubuf__ bfloat16_t* r4p = reinterpret_cast<__ubuf__ bfloat16_t*>(P_R4);
        __ubuf__ float* st0 = reinterpret_cast<__ubuf__ float*>(P_ST0);
        __ubuf__ float* st1 = reinterpret_cast<__ubuf__ float*>(P_ST1);
        __ubuf__ int32_t* st2i = reinterpret_cast<__ubuf__ int32_t*>(P_ST2);
        __ubuf__ float* st3 = reinterpret_cast<__ubuf__ float*>(P_ST3);
        __ubuf__ float* tbp = reinterpret_cast<__ubuf__ float*>(P_TB);

        // ================= S0：切片搬运 lane 语义 =================
        BufAcq<PIPE_V>(P_BUF_IN);
        BufAcq<PIPE_V>(P_BUF_S0);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            uint32_t n32 = QUART;
            MaskReg m32 = UpdateMask<float>(n32);
            RegTensor<float> a0, a1, a2, a3;
            LoadSlice(a0, xp + 0, m32);
            LoadSlice(a1, xp + QUART, m32);
            LoadSlice(a2, xp + 2 * QUART, m32);
            LoadSlice(a3, xp + 3 * QUART, m32);
            StoreAlign(st0 + 0 * 64, a0, full);
            StoreAlign(st0 + 1 * 64, a1, full);
            StoreAlign(st0 + 2 * 64, a2, full);
            StoreAlign(st0 + 3 * 64, a3, full);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(P_BUF_S0);
        BufAcq<PIPE_MTE3>(P_BUF_S0);
        DataCopyPad(s0Gm[0], PT<bfloat16_t>(P_ST0, 512), DataCopyExtParams{1, 1024, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(P_BUF_S0);

        // ================= S1/S2：q 路径（bf16 源） =================
        BufAcq<PIPE_V>(P_BUF_S1);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            uint32_t n32 = QUART;
            MaskReg m32 = UpdateMask<float>(n32);
            RegTensor<float> xa, xb, xc, xd, wa, wb, wc, wd, c32, s32, sq, t, rs, one, o0, o1, y0, y1, y2, y3;
            LoadSlice(xa, xp + 0, m32);
            LoadSlice(xb, xp + QUART, m32);
            LoadSlice(xc, xp + 2 * QUART, m32);
            LoadSlice(xd, xp + 3 * QUART, m32);
            LoadSlice(wa, wp + 0, m32);
            LoadSlice(wb, wp + QUART, m32);
            LoadSlice(wc, wp + 2 * QUART, m32);
            LoadSlice(wd, wp + 3 * QUART, m32);
            LoadSlice(c32, csp + 0, m32);
            LoadSlice(s32, csp + QUART, m32);
            Mul(sq, xa, xa, m32);
            Mul(t, xb, xb, m32); Add(sq, sq, t, m32);
            Mul(t, xc, xc, m32); Add(sq, sq, t, m32);
            Mul(t, xd, xd, m32); Add(sq, sq, t, m32);
            StoreAlign(st0 + 4 * 64, sq, full);
            Reduce<ReduceType::SUM, float>(rs, sq, m32);
            Muls(rs, rs, 1.0f / static_cast<float>(D), full);
            Adds(rs, rs, RMS_EPS, full);
            Sqrt(rs, rs, full);
            Duplicate(one, 1.0f);
            Div(rs, one, rs, full);
            StoreAlign(st0 + 5 * 64, rs, full);
            Duplicate(t, rs, full);
            Mul(y0, xa, t, m32); Mul(y1, xb, t, m32);
            Mul(y2, xc, t, m32); Mul(y3, xd, t, m32);
            Adds(wa, wa, 1.0f, m32); Adds(wb, wb, 1.0f, m32);
            Adds(wc, wc, 1.0f, m32); Adds(wd, wd, 1.0f, m32);
            Mul(y0, y0, wa, m32); Mul(y1, y1, wb, m32);
            Mul(y2, y2, wc, m32); Mul(y3, y3, wd, m32);
            StoreAlign(st0 + 6 * 64 + 0, y0, m32);
            StoreAlign(st0 + 6 * 64 + 32, y1, m32);
            StoreAlign(st0 + 7 * 64 + 0, y2, m32);
            StoreAlign(st0 + 7 * 64 + 32, y3, m32);
            Mul(o0, y0, c32, m32);
            Mul(t, y1, s32, m32); Sub(o0, o0, t, m32);
            Mul(o1, y1, c32, m32);
            Mul(t, y0, s32, m32); Add(o1, o1, t, m32);
            StoreAlign(st0 + 8 * 64 + 0, o0, m32);
            StoreAlign(st0 + 8 * 64 + 32, o1, m32);
            StoreAlign(st0 + 9 * 64 + 0, y2, m32);
            StoreAlign(st0 + 9 * 64 + 32, y3, m32);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(P_BUF_S1);
        BufAcq<PIPE_MTE3>(P_BUF_S1);
        DataCopyPad(s1Gm[0], PT<bfloat16_t>(P_ST0 + 4 * 256, 512), DataCopyExtParams{1, 1280, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(P_BUF_S1);

        // ================= S3/S4/S5：compressed 路径 =================
        BufAcq<PIPE_V>(P_BUF_S3);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            uint32_t n32 = QUART;
            MaskReg m32 = UpdateMask<float>(n32);
            // S3: 4 行 bf16 均值 -> Muls(1/4) -> RoundBf16（与 KPath 同形）
            RegTensor<float> a0, a1, a2, a3, i0, i1, i2, i3;
            LoadSlice(a0, r4p + 0, m32);
            LoadSlice(a1, r4p + QUART, m32);
            LoadSlice(a2, r4p + 2 * QUART, m32);
            LoadSlice(a3, r4p + 3 * QUART, m32);
            for (uint16_t i = 1; i < 4; ++i) {
                LoadSlice(i0, r4p + i * D + 0, m32);
                LoadSlice(i1, r4p + i * D + QUART, m32);
                LoadSlice(i2, r4p + i * D + 2 * QUART, m32);
                LoadSlice(i3, r4p + i * D + 3 * QUART, m32);
                Add(a0, a0, i0, m32); Add(a1, a1, i1, m32);
                Add(a2, a2, i2, m32); Add(a3, a3, i3, m32);
            }
            Muls(a0, a0, 0.25f, m32); Muls(a1, a1, 0.25f, m32);
            Muls(a2, a2, 0.25f, m32); Muls(a3, a3, 0.25f, m32);
            RoundBf16(a0, m32); RoundBf16(a1, m32); RoundBf16(a2, m32); RoundBf16(a3, m32);
            StoreAlign(st1 + 0 * 64 + 0, a0, m32);
            StoreAlign(st1 + 0 * 64 + 32, a1, m32);
            StoreAlign(st1 + 1 * 64 + 0, a2, m32);
            StoreAlign(st1 + 1 * 64 + 32, a3, m32);
            // S4: norm+rope（fp32 源，原地；与 KPath 的 VecNormRope<false> 同形）
            RegTensor<float> xa, xb, xc, xd, wa, wb, wc, wd, c32, s32, sq, t, rs, one, o0, o1;
            __ubuf__ float* src = st1;                     // dims 0..127 落 st1[0..127]
            LoadAlign(xa, src + 0);
            LoadAlign(xb, src + 32);
            LoadAlign(xc, src + 64);
            LoadAlign(xd, src + 96);
            LoadSlice(wa, wp + 0, m32);
            LoadSlice(wb, wp + QUART, m32);
            LoadSlice(wc, wp + 2 * QUART, m32);
            LoadSlice(wd, wp + 3 * QUART, m32);
            LoadSlice(c32, csp + 0, m32);
            LoadSlice(s32, csp + QUART, m32);
            Mul(sq, xa, xa, m32);
            Mul(t, xb, xb, m32); Add(sq, sq, t, m32);
            Mul(t, xc, xc, m32); Add(sq, sq, t, m32);
            Mul(t, xd, xd, m32); Add(sq, sq, t, m32);
            Reduce<ReduceType::SUM, float>(rs, sq, m32);
            Muls(rs, rs, 1.0f / static_cast<float>(D), full);
            Adds(rs, rs, RMS_EPS, full);
            Sqrt(rs, rs, full);
            Duplicate(one, 1.0f);
            Div(rs, one, rs, full);
            Duplicate(t, rs, full);
            Mul(xa, xa, t, m32); Mul(xb, xb, t, m32); Mul(xc, xc, t, m32); Mul(xd, xd, t, m32);
            Adds(wa, wa, 1.0f, m32); Adds(wb, wb, 1.0f, m32);
            Adds(wc, wc, 1.0f, m32); Adds(wd, wd, 1.0f, m32);
            Mul(xa, xa, wa, m32); Mul(xb, xb, wb, m32); Mul(xc, xc, wc, m32); Mul(xd, xd, wd, m32);
            Mul(o0, xa, c32, m32);
            Mul(t, xb, s32, m32); Sub(o0, o0, t, m32);
            Mul(o1, xb, c32, m32);
            Mul(t, xa, s32, m32); Add(o1, o1, t, m32);
            StoreAlign(st1 + 2 * 64 + 0, o0, m32);
            StoreAlign(st1 + 2 * 64 + 32, o1, m32);
            StoreAlign(st1 + 3 * 64 + 0, xc, m32);
            StoreAlign(st1 + 3 * 64 + 32, xd, m32);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(P_BUF_S3);
        BufAcq<PIPE_MTE3>(P_BUF_S3);
        DataCopyPad(s3Gm[0], PT<bfloat16_t>(P_ST1, 512), DataCopyExtParams{1, 1024, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(P_BUF_S3);

        // S5：把 S4 的输出（st1[128..255]）打包成 bf16
        BufAcq<PIPE_V>(P_BUF_S5);
        __VEC_SCOPE__ {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            PackBf16(st1 + 2 * 64, st2i);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(P_BUF_S5);
        BufAcq<PIPE_MTE3>(P_BUF_S5);
        DataCopyPad(s5Gm[0], PT<bfloat16_t>(P_ST2, 128), DataCopyExtParams{1, 256, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(P_BUF_S5);

        // ================= S6：RoundBf16 边界位型 =================
        BufAcq<PIPE_V>(P_BUF_S6);
        __VEC_SCOPE__ {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            uint32_t n32 = QUART;
            MaskReg m32 = UpdateMask<float>(n32);
            RegTensor<float> v;
            LoadAlign(v, tbp);
            StoreAlign(st3 + 0, v, full);
            RoundBf16(v, m32);
            StoreAlign(st3 + 32, v, full);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRel<PIPE_V>(P_BUF_S6);
        BufAcq<PIPE_MTE3>(P_BUF_S6);
        DataCopyPad(s6Gm[0], PT<bfloat16_t>(P_ST3, 128), DataCopyExtParams{1, 256, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(P_BUF_S6);
        BufRel<PIPE_V>(P_BUF_IN);
        PipeBarrier<PIPE_ALL>();
    }

private:
    GlobalTensor<bfloat16_t> xGm, wGm, csGm, tbGm, r4Gm, s0Gm, s1Gm, s3Gm, s5Gm, s6Gm;
};

}  // namespace

__vector__ __global__ void norm_rope_probe_kernel(
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* cs, __gm__ uint8_t* tb, __gm__ uint8_t* r4,
    __gm__ uint8_t* oS0, __gm__ uint8_t* oS1, __gm__ uint8_t* oS3, __gm__ uint8_t* oS5, __gm__ uint8_t* oS6)
{
    AscendC::InitSocState();
    NormRopeProbe p;
    p.Init(x, w, cs, tb, r4, oS0, oS1, oS3, oS5, oS6);
    p.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host：唯一编码输入 + 逐段逐 lane 对拍
// ============================================================

static uint16_t F32ToBf16Bits(float f)
{
    uint32_t x;
    std::memcpy(&x, &f, 4);
    if ((x & 0x7F800000u) == 0x7F800000u) return static_cast<uint16_t>((x >> 16) & 0xFFFFu);
    return static_cast<uint16_t>(((x + 0x7FFFu + ((x >> 16) & 1u)) >> 16) & 0xFFFFu);
}

static float Bf16BitsToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    std::memcpy(&f, &x, 4);
    return f;
}

static uint32_t F32Bits(float f) { uint32_t x; std::memcpy(&x, &f, 4); return x; }
static float BitsF32(uint32_t x) { float f; std::memcpy(&f, &x, 4); return f; }

static int g_checks = 0, g_fails = 0, g_guards = 0;

static void Verdict(const char* tag, int bad, const char* detail)
{
    ++g_checks;
    if (bad) { ++g_fails; printf("[probe] %-22s FAIL (%d bad) %s\n", tag, bad, detail); }
    else printf("[probe] %-22s PASS %s\n", tag, detail);
}

int32_t main(int32_t argc, char** argv)
{
    const char* dumpDir = (argc > 1) ? argv[1] : nullptr;
    // ---- 唯一编码输入（bf16 精确可表示）----
    uint16_t xb[128], wb[128], csb[64], r4b[4 * 128];
    for (int j = 0; j < 128; ++j) {
        xb[j] = F32ToBf16Bits(static_cast<float>(j + 1) / 16.0f);          // 0.0625 .. 8（逐 dim 唯一）
        wb[j] = F32ToBf16Bits(static_cast<float>(j - 64) / 128.0f);
    }
    for (int j = 0; j < 32; ++j) {
        csb[j] = F32ToBf16Bits(static_cast<float>(std::cos(0.37 * (j + 1))));
        csb[32 + j] = F32ToBf16Bits(static_cast<float>(std::sin(0.37 * (j + 1))));
    }
    for (int r = 0; r < 4; ++r) {
        for (int j = 0; j < 128; ++j) {
            // 每行每 dim 唯一；含正负，量级 O(1)
            float v = static_cast<float>((r * 128 + j) % 97 - 48) / 32.0f;
            r4b[r * 128 + j] = F32ToBf16Bits(v);
        }
    }
    uint32_t tbits[32] = {
        0x3FFFFFFFu, 0x3FFF8000u, 0x3FFF8001u, 0x00000000u, 0x80000000u, 0x00000001u, 0x0000FFFFu,
        0x00800000u, 0x7F7FFFFFu, 0x7F000000u, 0x40000000u, 0xBF800000u, 0x477FFF00u, 0x40490FDBu,
        0x3F800000u, 0x33800000u, 0xFFFFFFFFu, 0xFF800000u, 0x7FC00000u, 0x3F7FFFFFu, 0xBF7FFFFFu,
        0x00000002u, 0x007FFFFFu, 0x4F000000u, 0xCF000000u, 0x3E800000u, 0xBE800000u, 0x5F000000u,
        0x3F000001u, 0x3F008000u, 0x3F00FFFFu, 0x7F800000u,
    };
    for (int i = 0; i < 32; ++i) {
        float v = BitsF32(tbits[i]);
        std::memcpy(&tbits[i], &v, 4);
    }

    size_t xBytes = 128 * 2, csBytes = 64 * 2, tbBytes = 64 * 2, r4Bytes = 4 * 128 * 2;
    size_t s0Bytes = 1024, s1Bytes = 1280, s3Bytes = 1024, s5Bytes = 256, s6Bytes = 256;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t *dX, *dW, *dCs, *dTb, *dR4, *dS0, *dS1, *dS3, *dS5, *dS6;
    aclrtMalloc(reinterpret_cast<void**>(&dX), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dW), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dCs), csBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dTb), tbBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dR4), r4Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dS0), s0Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dS1), s1Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dS3), s3Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dS5), s5Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dS6), s6Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(dX, xBytes, xb, xBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dW, xBytes, wb, xBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dCs, csBytes, csb, csBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dTb, tbBytes, tbits, tbBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dR4, r4Bytes, r4b, r4Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dS0, s0Bytes, 0, s0Bytes);
    aclrtMemset(dS1, s1Bytes, 0, s1Bytes);
    aclrtMemset(dS3, s3Bytes, 0, s3Bytes);
    aclrtMemset(dS5, s5Bytes, 0, s5Bytes);
    aclrtMemset(dS6, s6Bytes, 0, s6Bytes);

    norm_rope_probe_kernel<<<1, 0, stream>>>(dX, dW, dCs, dTb, dR4, dS0, dS1, dS3, dS5, dS6);
    const aclError err = aclrtSynchronizeStream(stream);
    printf("[probe] launch: %s\n", err == ACL_SUCCESS ? "OK" : "FAILED");
    if (err != ACL_SUCCESS) return 2;

    float s0[256], s1[320], s3[256];
    uint16_t s5[128];
    float s6[64];
    aclrtMemcpy(s0, s0Bytes, dS0, s0Bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(s1, s1Bytes, dS1, s1Bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(s3, s3Bytes, dS3, s3Bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(s5, s5Bytes, dS5, s5Bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(s6, s6Bytes, dS6, s6Bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    if (dumpDir) {
        auto wr = [&](const char* n, const void* p, size_t bytes) {
            char path[512];
            std::snprintf(path, sizeof(path), "%s/%s", dumpDir, n);
            FILE* f = std::fopen(path, "wb");
            if (f) { std::fwrite(p, 1, bytes, f); std::fclose(f); }
        };
        wr("probe_s0.bin", s0, s0Bytes);
        wr("probe_s1.bin", s1, s1Bytes);
        wr("probe_s3.bin", s3, s3Bytes);
        wr("probe_s5.bin", s5, s5Bytes);
        wr("probe_s6.bin", s6, s6Bytes);
        wr("probe_in_x.bin", xb, xBytes);
        wr("probe_in_w.bin", wb, xBytes);
        wr("probe_in_cs.bin", csb, csBytes);
        wr("probe_in_r4.bin", r4b, r4Bytes);
        wr("probe_in_tb.bin", tbits, tbBytes);
    }
    // ---- S0：4 个切片寄存器的 64 lane 逐个对拍 ----
    {
        int bad = 0; int firstBadLane = -1; int firstBadSlice = -1;
        for (int s = 0; s < 4; ++s) {
            for (int lane = 0; lane < 32; ++lane) {   // 只有 lanes 0..31 有效（Cast 用 m32）
                int srcIdx = s * 32 + lane;
                float expect = (srcIdx < 128) ? Bf16BitsToF32(xb[srcIdx]) : 0.0f;
                if (std::fabs(s0[s * 64 + lane] - expect) > 1e-6f) {
                    ++bad;
                    if (firstBadLane < 0) { firstBadLane = lane; firstBadSlice = s; }
                }
            }
        }
        char d[192];
        snprintf(d, sizeof(d), "(首个不符 slice=%d lane=%d 实测 %.5f)", firstBadSlice, firstBadLane,
                 firstBadSlice >= 0 ? s0[firstBadSlice * 64 + firstBadLane] : 0.0f);
        Verdict("S0 slice-lane", bad, d);
    }
    // ---- S1：per-lane 平方和 / rstd / norm / rope ----
    {
        double expsq[32], sum = 0.0;
        for (int j = 0; j < 32; ++j) {
            expsq[j] = 0.0;
            for (int s = 0; s < 4; ++s) {
                double v = Bf16BitsToF32(xb[s * 32 + j]);
                expsq[j] += v * v;
            }
            sum += expsq[j];
        }
        int bad = 0;
        for (int j = 0; j < 32; ++j) {
            if (std::fabs(s1[0 * 64 + j] - expsq[j]) > 1e-4 * (expsq[j] + 1.0)) ++bad;
        }
        Verdict("S1a lane-sq", bad, "");
        double rstdExp = 1.0 / std::sqrt(sum / 128.0 + 1e-6);
        printf("[probe] S1b rstd: 实测 %.9f 期望 %.9f（lanes1..3 = %.4f %.4f %.4f）\n",
               s1[1 * 64], rstdExp, s1[1 * 64 + 1], s1[1 * 64 + 2], s1[1 * 64 + 3]);
        Verdict("S1b rstd", std::fabs(s1[1 * 64] - rstdExp) > 1e-6 * rstdExp ? 1 : 0, "");
        double rrms = rstdExp;
        double maxrel = 0.0; int worst = -1;
        for (int j = 0; j < 128; ++j) {
            double y = Bf16BitsToF32(xb[j]) * rrms * (Bf16BitsToF32(wb[j]) + 1.0);
            double rel = std::fabs(s1[2 * 64 + j] - y) / (std::fabs(y) + 1e-30);
            if (rel > maxrel) { maxrel = rel; worst = j; }
        }
        char d[160];
        snprintf(d, sizeof(d), "(max rel %.3e @ dim %d)", maxrel, worst);
        Verdict("S1c norm", maxrel > 1e-6 ? 1 : 0, d);
        double maxrel2 = 0.0; int worst2 = -1;
        for (int j = 0; j < 32; ++j) {
            double c = Bf16BitsToF32(csb[j]), s = Bf16BitsToF32(csb[32 + j]);
            double y0 = Bf16BitsToF32(xb[j]) * rrms * (Bf16BitsToF32(wb[j]) + 1.0);
            double y1 = Bf16BitsToF32(xb[32 + j]) * rrms * (Bf16BitsToF32(wb[32 + j]) + 1.0);
            double o0 = y0 * c - y1 * s, o1 = y1 * c + y0 * s;
            double r = std::fabs(s1[4 * 64 + j] - o0) / (std::fabs(o0) + 1e-30);
            if (r > maxrel2) { maxrel2 = r; worst2 = j; }
            r = std::fabs(s1[4 * 64 + 32 + j] - o1) / (std::fabs(o1) + 1e-30);
            if (r > maxrel2) { maxrel2 = r; worst2 = 32 + j; }
        }
        for (int j = 64; j < 128; ++j) {
            double y = Bf16BitsToF32(xb[j]) * rrms * (Bf16BitsToF32(wb[j]) + 1.0);
            double r = std::fabs(s1[4 * 64 + j] - y) / (std::fabs(y) + 1e-30);
            if (r > maxrel2) { maxrel2 = r; worst2 = j; }
        }
        char d2[160];
        snprintf(d2, sizeof(d2), "(max rel %.3e @ dim %d)", maxrel2, worst2);
        Verdict("S2 rope", maxrel2 > 1e-6 ? 1 : 0, d2);
    }
    // ---- S3：pooled = RNE(mean(4 行))（必须逐位一致）----
    {
        int bad = 0; int first = -1;
        for (int j = 0; j < 128; ++j) {
            double acc = 0.0;
            for (int r = 0; r < 4; ++r) acc += Bf16BitsToF32(r4b[r * 128 + j]);
            float mean = static_cast<float>(acc / 4.0);
            float expect = Bf16BitsToF32(F32ToBf16Bits(mean));
            if (F32Bits(s3[j]) != F32Bits(expect)) {
                ++bad;
                if (first < 0) first = j;
            }
        }
        char d[192];
        snprintf(d, sizeof(d), "(首个不符 dim=%d 实测 0x%08X)", first, first >= 0 ? F32Bits(s3[first]) : 0u);
        Verdict("S3 pooled-RNE", bad, d);
    }
    // ---- S4：fp32 源的 norm+rope（RNE 输入，fp64 参考）----
    {
        double sum = 0.0;
        for (int j = 0; j < 128; ++j) { double v = s3[j]; sum += v * v; }
        double rrms = 1.0 / std::sqrt(sum / 128.0 + 1e-6);
        double maxrel = 0.0; int worst = -1;
        for (int j = 0; j < 128; ++j) {
            double y = s3[j] * rrms * (Bf16BitsToF32(wb[j]) + 1.0);
            double ref;
            if (j < 32) {
                ref = y * Bf16BitsToF32(csb[j]) -
                      (s3[32 + j] * rrms * (Bf16BitsToF32(wb[32 + j]) + 1.0)) * Bf16BitsToF32(csb[32 + j]);
            } else if (j < 64) {
                ref = y * Bf16BitsToF32(csb[j - 32]) +
                      (s3[j - 32] * rrms * (Bf16BitsToF32(wb[j - 32]) + 1.0)) * Bf16BitsToF32(csb[32 + j - 32]);
            } else {
                ref = y;
            }
            double rel = std::fabs(s3[128 + j] - ref) / (std::fabs(ref) + 1e-30);
            if (rel > maxrel) { maxrel = rel; worst = j; }
        }
        char d[160];
        snprintf(d, sizeof(d), "(max rel %.3e @ dim %d)", maxrel, worst);
        Verdict("S4 fp32-norm-rope", maxrel > 1e-6 ? 1 : 0, d);
        int nonfinite = 0;
        for (int j = 0; j < 128; ++j) if (!std::isfinite(s3[128 + j])) ++nonfinite;
        char d2[96];
        snprintf(d2, sizeof(d2), "(%d/128 非有限)", nonfinite);
        Verdict("S4b finite", nonfinite, d2);
    }
    // ---- S5：PackBf16 逐位 ----
    {
        int bad = 0; int first = -1;
        for (int j = 0; j < 128; ++j) {
            uint16_t expect = F32ToBf16Bits(s3[128 + j]);
            if (s5[j] != expect) {
                ++bad;
                if (first < 0) first = j;
            }
        }
        char d[192];
        snprintf(d, sizeof(d), "(首个不符 dim=%d 实测 0x%04X 期望 0x%04X)", first,
                 first >= 0 ? s5[first] : 0u, first >= 0 ? F32ToBf16Bits(s3[128 + first]) : 0u);
        Verdict("S5 packbf16", bad, d);
    }
    // ---- S6：RoundBf16 边界位型 ----
    {
        int bad = 0;
        for (int i = 0; i < 32; ++i) {
            uint32_t u = tbits[i];
            if ((u & 0x7F800000u) == 0x7F800000u) continue;    // Inf/NaN 不判（语义未定）
            uint32_t expect = ((u + 0x7FFFu + ((u >> 16) & 1u)) >> 16) << 16;
            if (F32Bits(s6[32 + i]) != expect) {
                ++bad;
                if (bad <= 3) {
                    printf("[probe]   S6 失配 i=%2d in 0x%08X out 0x%08X expect 0x%08X\n",
                           i, u, F32Bits(s6[32 + i]), expect);
                }
            }
        }
        Verdict("S6 round-boundary", bad, "");
        // guard（报告项）：S6 的输入回写是否与主机一致（证明搬运无污染）
        int echoBad = 0;
        for (int i = 0; i < 32; ++i) if (F32Bits(s6[i]) != tbits[i]) ++echoBad;
        printf("[probe] guard: S6 输入回写不一致 %d/32\n", echoBad);
        ++g_guards;
    }

    printf("[probe] ===== 判定项 %d，失败 %d；报告项 guard %d =====\n", g_checks, g_fails, g_guards);
    printf("[probe] ===== %s =====\n", g_fails == 0 ? "ALL PASS" : "FAILURES PRESENT");
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return g_fails == 0 ? 0 : 1;
}
