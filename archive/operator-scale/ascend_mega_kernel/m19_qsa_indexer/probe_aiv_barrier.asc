/**
 * probe_aiv_barrier.asc —— M53 探针：AIV 间「计数交换」的**适用边界**（不是"原语可用/不可用"）
 *
 * 背景与既有结论：本仓 `docs/06-m0-bringup.md §5.3` 记「CrossCore mode0/mode2（__mix__(1,2) 直调）可用」
 * （m0 就是 56 AIV 各写 GM 槽 → mode0 屏障 → 每核读回 56 槽求和，已 PASS），§5.2 规则 6 甚至写了本现象：
 * 「`CrossCoreSetFlag<0,MTE3>` 发出前必须确认 GM 写已落盘（`MTE3_S` 排空后再 set），否则先到的核
 *   对等不到全部 56 份数据（实测只收到 ~20/56）」。**`149b920` 曾写成"没有可靠原语"是过度概括**：
 * 正确的问法是——**同一条 mode0 屏障，在"单发一次交接"下成立吗？在"同一片槽上多轮复用"下成立吗？**
 *
 * 本探针按这个问法给出 6 个变体的**并列读数**（都带偏斜放大弱同步）：
 *   v0 = 无屏障（对照，证明探针敏感）
 *   v1 = **单发**：1 轮；`Set<0,MTE3>(1)` + `Wait<0,MTE2>(1)`        ← 主 kernel 交接段的用法
 *   v2 = **循环 4 轮复用同一片槽**：`Set<0,MTE3>(1+r%8)` + `Wait<0,MTE2>`
 *   v3 = 循环 4 轮 + set 前先 `MTE3_S` 排空（`docs/06 §5.2 规则 6` 的处方）
 *   v4 = **单发 + `SyncAll<true>()`**（框架自带的 AIV-only 全核屏障：mode0 + flagId 14 +
 *        `wait_flag_dev(PIPE_S,14)`；注意它 wait 挂 **PIPE_S**，而本模块一直挂 PIPE_MTE2）
 *   v5 = **循环 4 轮 + `SyncAll<true>()`**
 *   （v4/v5 是本轮补测的：`PIPE_S` 挂载 + flagId 14 这两个变量此前从未测过。）
 * 每变体每核记录 (变体, 核号, 违规次数, 见到的最少槽数)，轮数与变体数由 host 传入（超时可只跑前 4 个）。
 *
 * 判读：**只有"违规核数 0 且最少槽数 = naiv"才算该用法成立**。预期：单发成立、复用不成立
 * ⇒ 结论必须是**适用边界**（"多轮复用同一片槽不可证"），不是"原语不可用"。
 *
 * **适用范围前提（必读）**：本探针每轮只挂**一道「写完」屏障**（写 → 屏障 → 读回 → 下一轮写），
 * **读回之后到下一轮写之前没有屏障**。"多轮复用不可证"这一读数只在这个形态下成立；
 * 本探针**不**据此断言"就是缺一道屏障"（该假设另由 probe mission 实测，结论未出）。
 * 约束：基础 API；BufferID/flagId 编译期静态；核数由 host 用 API 取后传入（不硬编码 56）。
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdio>
#include <cstdint>
#include <cstdlib>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;
constexpr uint32_t UB_DATA = 0;      // 256B 读回区（naiv ≤ 56 槽 × 4B = 224B）
constexpr uint32_t UB_LANE = 256;    // fp32 [64] lane 序号 0..63
constexpr uint32_t UB_TMP  = 512;    // int32/fp32 [8] 标量槽
constexpr uint32_t SKEW_UB = 768;    // 空转 DMA 的 UB 落点
constexpr MutexID BUF_D = 0;
constexpr uint32_t NVAR = 6;         // 变体数上界（实际跑几个由 host 传 nvar）
constexpr uint32_t NROUND = 4;       // 每变体轮数（v1/v4 只跑 1 轮）
constexpr uint32_t SKEW_MULT = 8;    // 偏斜强度：每核每轮 (aiv%8)*SKEW_MULT 次空转 DMA

constexpr CastTrait castS32F32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING, RoundMode::CAST_RINT};

template <pipe_t pipe>
__aicore__ inline void BufAcq(MutexID id) { GetBufInternal<pipe, false>(id); }
template <pipe_t pipe>
__aicore__ inline void BufRel(MutexID id) { RlsBufInternal<pipe, false>(id); }

// 「前 n 条 lane」掩码：用 lane 序号向量比较（本机 UpdateMask(变量) 的选择不可靠）
__simd_callee__ inline void MaskLtN(MaskReg& dst, RegTensor<float>& laneF, float n, MaskReg& full)
{
    CompareScalar<float, CMPMODE::LT>(dst, laneF, n, full);
}

__aicore__ inline int32_t F32Bits(float f)
{
    LocalTensor<float> s(TPosition::VECCALC, UB_TMP, 1);
    s.SetValue(0, f);
    return LocalTensor<int32_t>(TPosition::VECCALC, UB_TMP, 1).GetValue(0);
}

__aicore__ inline void InitLane()
{
    BufAcq<PIPE_V>(BUF_D);
    __VEC_SCOPE__ {
        MaskReg full = CreateMask<float, MaskPattern::ALL>();
        RegTensor<int32_t> idx;
        RegTensor<float> laneF;
        Arange(idx, 0);
        Cast<float, int32_t, castS32F32>(laneF, idx, full);
        StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_LANE), laneF, full);
    }
    BufRel<PIPE_V>(BUF_D);
}

__aicore__ inline void Skew(uint32_t aiv, __gm__ uint8_t* tagGm)
{
    GlobalTensor<bfloat16_t> tag;
    tag.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(tagGm));
    for (uint32_t j = 0; j < (aiv % 8) * SKEW_MULT; ++j) {
        DataCopy(LocalTensor<bfloat16_t>(TPosition::VECCALC, SKEW_UB, 8), tag[0], 8);
    }
    PipeBarrier<PIPE_MTE2>();
}

__aicore__ inline void WriteSlot(__gm__ uint8_t* reg, uint32_t aiv, float token)
{
    GlobalTensor<bfloat16_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(reg));
    LocalTensor<int32_t> rec(TPosition::VECCALC, UB_TMP, 8);
    rec.SetValue(0, F32Bits(token));
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    Mutex::Lock<PIPE_MTE3>(BUF_D);
    DataCopyPad(g[aiv * 2], LocalTensor<bfloat16_t>(TPosition::VECCALC, UB_TMP, 8),
                DataCopyExtParams{1, 4, 0, 0, 0});
    PipeBarrier<PIPE_MTE3>();
    Mutex::Unlock<PIPE_MTE3>(BUF_D);
}

// 屏障变体：v0 无、v1/v2/v3 手写 mode0、v4/v5 = SyncAll<true>（框架的 AIV-only 全核屏障）
__aicore__ inline void BarrierVariant(uint32_t v, uint32_t r)
{
    if (v == 1 || v == 2) {                        // 1(单发) / 2(循环)：主 kernel 同款
        const uint16_t fid = static_cast<uint16_t>(1 + (r % 8));
        CrossCoreSetFlag<0x0, PIPE_MTE3>(fid);
        CrossCoreWaitFlag<0x0, PIPE_MTE2>(fid);
    } else if (v == 3) {                           // 3：set 前先把 GM 写照排空（docs/06 §5.2 规则 6）
        SetFlag<HardEvent::MTE3_S>(EVENT_ID3);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID3);
        const uint16_t fid = static_cast<uint16_t>(1 + (r % 8));
        CrossCoreSetFlag<0x0, PIPE_MTE3>(fid);
        CrossCoreWaitFlag<0x0, PIPE_MTE2>(fid);
    } else if (v == 4 || v == 5) {                 // 4(单发)/5(循环)：SyncAll<true>
        SyncAll<true>();
    }
}

__aicore__ inline uint32_t ReadMatch(__gm__ uint8_t* reg, uint32_t naiv, float token)
{
    GlobalTensor<bfloat16_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(reg));
    BufAcq<PIPE_MTE2>(BUF_D);
    DataCopyPad(LocalTensor<bfloat16_t>(TPosition::VECCALC, UB_DATA, 128), g[0],
                DataCopyExtParams{1, static_cast<uint16_t>(naiv * 4), 0, 0, 0},
                DataCopyPadExtParams<bfloat16_t>{false, 0, 0, 0});
    PipeBarrier<PIPE_MTE2>();
    BufRel<PIPE_MTE2>(BUF_D);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID2);      // docs/06 §4/§5：MTE2 写 UB -> V 读必须用事件
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
    __ubuf__ float* rd = reinterpret_cast<__ubuf__ float*>(UB_DATA);
    BufAcq<PIPE_V>(BUF_D);
    __VEC_SCOPE__ {
        MaskReg full = CreateMask<float, MaskPattern::ALL>();
        MaskReg mk, m8;
        RegTensor<float> laneF, ones, acc, v;
        LoadAlign(laneF, reinterpret_cast<__ubuf__ float*>(UB_LANE));
        MaskLtN(m8, laneF, 8.0f, full);
        MaskLtN(mk, laneF, static_cast<float>(naiv), full);
        Duplicate(ones, 1.0f);
        LoadAlign(v, rd);
        CompareScalar<float, CMPMODE::EQ>(mk, v, token, mk);
        Reduce<ReduceType::SUM, float>(acc, ones, mk);
        StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_TMP), acc, m8);
    }
    BufRel<PIPE_V>(BUF_D);
    SetFlag<HardEvent::V_S>(EVENT_ID7);
    WaitFlag<HardEvent::V_S>(EVENT_ID7);
    return static_cast<uint32_t>(LocalTensor<float>(TPosition::VECCALC, UB_TMP, 8).GetValue(0));
}

__aicore__ inline void WriteResult(__gm__ uint8_t* res, uint32_t v, uint32_t aiv, int32_t viol, int32_t minSeen)
{
    GlobalTensor<bfloat16_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(res));
    LocalTensor<int32_t> rec(TPosition::VECCALC, UB_TMP, 8);
    rec.SetValue(0, static_cast<int32_t>(v));
    rec.SetValue(1, static_cast<int32_t>(aiv));
    rec.SetValue(2, viol);
    rec.SetValue(3, minSeen);
    SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
    Mutex::Lock<PIPE_MTE3>(BUF_D);
    DataCopyPad(g[(v * 64 + aiv) * 8], LocalTensor<bfloat16_t>(TPosition::VECCALC, UB_TMP, 8),
                DataCopyExtParams{1, 16, 0, 0, 0});
    PipeBarrier<PIPE_MTE3>();
    Mutex::Unlock<PIPE_MTE3>(BUF_D);
}
}  // namespace

__global__ __mix__(1, 2) void aiv_barrier_probe_kernel(__gm__ uint8_t* arr, __gm__ uint8_t* res,
                                                       __gm__ uint8_t* tag, uint32_t naiv, uint32_t nvar)
{
    InitSocState();
    if ASCEND_IS_AIV {
        InitLane();
        const uint32_t aiv = GetBlockIdx();
        if (aiv < naiv) {
            for (uint32_t v = 0; v < nvar; ++v) {
                __gm__ uint8_t* reg = arr + v * 256;
                int32_t viol = 0;
                int32_t minSeen = 1 << 24;
                const uint32_t rounds = (v == 1 || v == 4) ? 1u : NROUND;   // 单发 vs 循环
                for (uint32_t r = 0; r < rounds; ++r) {
                    const float token = static_cast<float>(r + 1);
                    Skew(aiv, tag);
                    WriteSlot(reg, aiv, token);
                    BarrierVariant(v, r);
                    const uint32_t c = ReadMatch(reg, naiv, token);
                    if (c < static_cast<int32_t>(naiv)) ++viol;
                    if (static_cast<int32_t>(c) < minSeen) minSeen = static_cast<int32_t>(c);
                }
                WriteResult(res, v, aiv, viol, minSeen);
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
    PipeBarrier<PIPE_ALL>();
}

int32_t main()
{
    int64_t aic = 0, aiv = 0;
    aclInit(nullptr);
    aclrtSetDevice(0);
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aic) != ACL_SUCCESS || aic <= 0) aic = 28;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aiv) != ACL_SUCCESS || aiv <= 0) aiv = 2 * aic;
    const uint32_t naiv = static_cast<uint32_t>(aiv);
    const char* nvEnv = getenv("M19_PROBE_NVAR");
    int64_t nvarIn = (nvEnv != nullptr) ? atoll(nvEnv) : static_cast<int64_t>(NVAR);
    if (nvarIn < 1 || nvarIn > static_cast<int64_t>(NVAR)) nvarIn = NVAR;
    const uint32_t nvar = static_cast<uint32_t>(nvarIn);
    printf("[probe_bar] AICORE=%ld VECTOR=%ld naiv=%u；变体数 %u（最多 %u），每变体轮数 %u（v1/v4 单发 1 轮）\n",
           aic, aiv, naiv, nvar, NVAR, NROUND);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    const size_t arrBytes = NVAR * 256;
    const size_t resBytes = NVAR * 64 * 16;
    uint8_t *dArr = nullptr, *dRes = nullptr, *dTag = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&dArr), arrBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dRes), resBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dTag), 256, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dArr, arrBytes, 0, arrBytes);
    aclrtMemset(dRes, resBytes, 0xFF, resBytes);
    aclrtMemset(dTag, 256, 0, 256);
    aiv_barrier_probe_kernel<<<static_cast<uint32_t>(aic), 0, stream>>>(dArr, dRes, dTag, naiv, nvar);
    const aclError err = aclrtSynchronizeStream(stream);
    printf("[probe_bar] launch: %s\n", err == ACL_SUCCESS ? "OK" : "FAILED");
    if (err != ACL_SUCCESS) return 2;
    int32_t* hr = reinterpret_cast<int32_t*>(malloc(resBytes));
    aclrtMemcpy(hr, resBytes, dRes, resBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    const char* vn[NVAR] = {"v0 无屏障（对照，4 轮）",
                            "v1 **单发** 1 轮：Set<0,MTE3>(1)+Wait<0,MTE2>（主 kernel 交接段用法）",
                            "v2 循环 4 轮复用同片槽：Set<0,MTE3>(1+r%8)+Wait<0,MTE2>",
                            "v3 循环 4 轮 + set 前 MTE3_S 排空（docs/06 §5.2 规则 6）",
                            "v4 **单发** 1 轮 + SyncAll<true>()（框架 AIV-only 全核屏障，wait 挂 PIPE_S）",
                            "v5 循环 4 轮 + SyncAll<true>()"};
    int32_t rc = 0;
    for (uint32_t v = 0; v < nvar; ++v) {
        int32_t totViol = 0, nCoresViol = 0, nseen = 0, gmin = 1 << 24, maxViol = 0;
        for (uint32_t i = 0; i < naiv; ++i) {
            if (hr[(v * 64 + i) * 4 + 1] != static_cast<int32_t>(i)) continue;
            const int32_t viol = hr[(v * 64 + i) * 4 + 2];
            const int32_t ex = hr[(v * 64 + i) * 4 + 3];
            ++nseen;
            totViol += viol;
            if (viol > maxViol) maxViol = viol;
            if (viol > 0) ++nCoresViol;
            if (ex < gmin) gmin = ex;
        }
        const bool ok = (nseen == static_cast<int32_t>(naiv)) && (totViol == 0);
        printf("[probe_bar] %-64s 核 %u/%u；违规核 %d（合计 %d，单核最大 %d）；最少见到的槽数 %d ⇒ %s\n",
               vn[v], nseen, naiv, nCoresViol, totViol, maxViol, gmin, ok ? "OK" : "VIOLATION");
        // 判读：只有 v0（对照）允许违规；v1..v5 是待测用法，各自如实报
        if (v == 0 && ok) rc = 1;               // 对照若也"通过" ⇒ 探针失去敏感性
    }
    free(hr);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return rc;
}
