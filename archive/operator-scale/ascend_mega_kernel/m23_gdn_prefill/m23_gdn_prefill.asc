/**
 * m23_gdn_prefill.asc —— M115 / Wave B1 的**独立验证路**（自己的顶层目录、自己的 main()）
 *
 * 被测对象 = `m15_layer_loop/m15_gdn_prefill.h` 的 GDN prefill 段（mmad 版 chunk 扫描）。
 * 本文件只做三件事：① 生成确定性输入；② 按**真实 shape**（m=4097 与 m=1）启动 mix(1,2) 段；
 * ③ 把输入与输出落盘，交给 `check_ref.py`（numpy float64 逐句参考）判。
 *
 * 真 shape（人类裁决：「prefill 和 decode 都要照顾到，测试 m=1 和 4097」）：
 *   case "p4097"：m = 4097（= 64×64 + 1，尾 chunk 只有 1 行有效）、heads = 48
 *   case "m1"   ：m = 1（单 chunk、cv=1，状态由 h0 给入 —— decode 段复用同一段体）
 * 两档都用 m18_gdn_prefill 同一套 I/O 契约（q/k/v/g/β/h0 → o/ht），故 m18 的 fp64 参考
 * **判据部分可直接复用**；本段不含 conv1d / l2norm / gating（那是 m9 prolog 段），见 README §边界。
 *
 * 反向对照（判据非空洞）：`--mutate <k>` 在 device 侧不注入，而在 host 侧把某个输入按 k 搅动
 * （见 `MutateInputs`），从而**同一判据必然变红** —— 由 `check_ref.py --mutant` 复跑确认。
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include "m15_gdn_prefill.h"
#include "m15_gdn_prefill_host.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <vector>

__global__ __mix__(1, 2) void m23_gdn_prefill_kernel(__gm__ uint8_t* q, __gm__ uint8_t* k, __gm__ uint8_t* v,
                                                     __gm__ uint8_t* g, __gm__ uint8_t* beta,
                                                     __gm__ uint8_t* h0, __gm__ uint8_t* out,
                                                     __gm__ uint8_t* ht, __gm__ uint8_t* scratch, uint32_t m,
                                                     uint32_t heads, uint32_t tp, uint32_t qkStride,
                                                     float scale)
{
    AscendC::InitSocState();
    M15GP::GdnPrefillArgs a{q, k, v, g, beta, h0, out, ht, scratch, m, heads, tp, qkStride, scale};
    if ASCEND_IS_AIV {
        M15GP::GdnPrefillAivEntry(a);
    }
    if ASCEND_IS_AIC {
        M15GP::GdnPrefillAicEntry(a);
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// host 侧
// ============================================================

static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

static float HashU11(uint32_t i, uint32_t j, uint32_t salt)
{
    return static_cast<float>(Hash3(i, j, salt) % 1000000u) / 500000.0f - 1.0f;
}

// q/k 行：hash 向量 → l2norm（纯单位化；1/√DK 的 scale 由 kernel 的 scale 参数施加）
static void GenQk(float* dst, uint32_t dim, uint32_t row, uint32_t salt)
{
    static float x[256];
    double sum = 0.0;
    for (uint32_t i = 0; i < dim; ++i) {
        x[i] = HashU11(i, row, salt);
        sum += static_cast<double>(x[i]) * static_cast<double>(x[i]);
    }
    double lo = 1e-4, hi = 1.0;
    for (int it = 0; it < 46; ++it) {
        const double mid = 0.5 * (lo + hi);
        if (mid * mid * sum < 1.0) {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    const double y = 0.5 * (lo + hi);
    for (uint32_t i = 0; i < dim; ++i) {
        dst[i] = static_cast<float>(static_cast<double>(x[i]) * y);
    }
}

static bool WriteBin(const char* path, const void* buf, size_t bytes)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) {
        printf("[M23][FAIL] cannot open %s\n", path);
        return false;
    }
    const size_t w = fwrite(buf, 1, bytes, f);
    fclose(f);
    return w == bytes;
}

struct Case {
    const char* tag;
    uint32_t H;
    uint32_t T;
    uint32_t salt;
};

/** 反向对照：按 k 把输入搅动（1=v 翻号，2=g 置 0，3=h0 缩放）⇒ 判据必须变红。 */
static void MutateInputs(int k, std::vector<float>& v, std::vector<float>& g, std::vector<float>& h0)
{
    if (k == 0) {
        return;
    }
    if (k == 1) {
        for (size_t i = 0; i < v.size(); ++i) {
            v[i] = -v[i];
        }
    } else if (k == 2) {
        for (size_t i = 0; i < g.size(); ++i) {
            g[i] = 0.0f;
        }
    } else if (k == 3) {
        for (size_t i = 0; i < h0.size(); ++i) {
            h0[i] = 2.0f * h0[i];
        }
    }
}

static bool RunCase(aclrtStream stream, const Case& cs, uint32_t nblk, int mutate, const char* tagOverride)
{
    const uint32_t H = cs.H;
    const uint32_t T = cs.T;
    const uint32_t nk = (H + 2) / 3;
    const float scale = 1.0f / 11.313708f;   // ≈ 1/√128（与 m18 同口径）
    const uint32_t tp = ((T + 7) / 8) * 8;
    // q/k 平面尾部补 64 行（Nd2Nz 固读 64 行）且**置零**（docs/05 §5.3）
    const uint32_t Tp = T + M15GP_H::kPadRows;

    const size_t qkF = static_cast<size_t>(nk) * Tp * 128;
    const size_t vF = static_cast<size_t>(H) * T * 128;
    const size_t gbF = static_cast<size_t>(H) * tp;
    const size_t hF = static_cast<size_t>(H) * 128 * 128;
    const size_t oF = vF;
    const size_t scF = static_cast<size_t>(nblk) * M15GP_H::kSlotBytes / 4;

    std::vector<float> q(qkF, 0.0f), kk(qkF, 0.0f), v(vF), g(gbF, 0.0f), beta(gbF, 0.0f), h0(hF);
    for (uint32_t kh = 0; kh < nk; ++kh) {
        for (uint32_t t = 0; t < T; ++t) {
            GenQk(&q[(static_cast<size_t>(kh) * Tp + t) * 128], 128, t * 7 + kh, cs.salt + 0x51);
            GenQk(&kk[(static_cast<size_t>(kh) * Tp + t) * 128], 128, t * 7 + kh, cs.salt + 0x52);
        }
    }
    for (uint32_t h = 0; h < H; ++h) {
        for (uint32_t t = 0; t < T; ++t) {
            for (uint32_t i = 0; i < 128; ++i) {
                v[(static_cast<size_t>(h) * T + t) * 128 + i] = HashU11(i, t * 31 + h, cs.salt + 0x53);
            }
            g[static_cast<size_t>(h) * tp + t] =
                -0.001f - static_cast<float>(Hash3(t, h, cs.salt + 0x54) % 50000u) / 1000000.0f;
            beta[static_cast<size_t>(h) * tp + t] =
                0.05f + static_cast<float>(Hash3(t, h, cs.salt + 0x55) % 900000u) / 1000000.0f;
        }
    }
    for (uint32_t h = 0; h < H; ++h) {
        for (uint32_t i = 0; i < 128; ++i) {
            for (uint32_t j = 0; j < 128; ++j) {
                h0[(static_cast<size_t>(h) * 128 + i) * 128 + j] = 0.1f * HashU11(i * 128 + j, h, cs.salt + 0x56);
            }
        }
    }
    // 反向对照：**只搅动送设备的副本**，host 侧留着干净数据用于 dump（参考吃干净、设备吃搅动）
    // —— 原实现把两边一起搅动 ⇒ 参考与设备同错 ⇒ 负向对照咬不住（r2 复审 p2-a）。
    std::vector<float> vDev(v), gDev(g), h0Dev(h0);
    MutateInputs(mutate, vDev, gDev, h0Dev);

    std::vector<void*> dv(9, nullptr);
    std::vector<size_t> bytes = {qkF * 4, qkF * 4, vF * 4, gbF * 4, gbF * 4, hF * 4, oF * 4, hF * 4, scF * 4};
    for (size_t i = 0; i < dv.size(); ++i) {
        if (aclrtMalloc(&dv[i], bytes[i], ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
            printf("[M23][FAIL] aclrtMalloc(%zu) failed\n", bytes[i]);
            return false;
        }
    }
    bool ok = true;
    ok &= aclrtMemcpy(dv[0], bytes[0], q.data(), bytes[0], ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    ok &= aclrtMemcpy(dv[1], bytes[1], kk.data(), bytes[1], ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    ok &= aclrtMemcpy(dv[2], bytes[2], vDev.data(), bytes[2], ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    ok &= aclrtMemcpy(dv[3], bytes[3], gDev.data(), bytes[3], ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    ok &= aclrtMemcpy(dv[4], bytes[4], beta.data(), bytes[4], ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    ok &= aclrtMemcpy(dv[5], bytes[5], h0Dev.data(), bytes[5], ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    if (!ok) {
        printf("[M23][FAIL] H2D failed\n");
        return false;
    }
    aclrtMemset(dv[6], bytes[6], 0, bytes[6]);
    aclrtMemset(dv[7], bytes[7], 0, bytes[7]);
    aclrtMemset(dv[8], bytes[8], 0, bytes[8]);

    m23_gdn_prefill_kernel<<<nblk, 0, stream>>>(reinterpret_cast<uint8_t*>(dv[0]),
                                                reinterpret_cast<uint8_t*>(dv[1]),
                                                reinterpret_cast<uint8_t*>(dv[2]),
                                                reinterpret_cast<uint8_t*>(dv[3]),
                                                reinterpret_cast<uint8_t*>(dv[4]),
                                                reinterpret_cast<uint8_t*>(dv[5]),
                                                reinterpret_cast<uint8_t*>(dv[6]),
                                                reinterpret_cast<uint8_t*>(dv[7]),
                                                reinterpret_cast<uint8_t*>(dv[8]), T, H, tp, Tp, scale);
    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);
    const aclError err = aclrtSynchronizeStream(stream);
    clock_gettime(CLOCK_MONOTONIC, &t1);
    const double ms = (static_cast<double>(t1.tv_sec - t0.tv_sec) * 1e3) +
                      static_cast<double>(t1.tv_nsec - t0.tv_nsec) * 1e-6;
    if (err != ACL_SUCCESS) {
        printf("[M23][FAIL] H=%u T=%u launch/sync error %d : %s\n", H, T, static_cast<int>(err),
               aclGetRecentErrMsg());
        return false;
    }

    std::vector<float> o(oF), ht(hF);
    ok &= aclrtMemcpy(o.data(), oF * 4, dv[6], oF * 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    ok &= aclrtMemcpy(ht.data(), hF * 4, dv[7], hF * 4, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    if (!ok) {
        printf("[M23][FAIL] D2H failed\n");
        return false;
    }

    char nm[160];
    const char* tag = (tagOverride != nullptr) ? tagOverride : cs.tag;
    auto dump = [&](const char* what, const void* p, size_t n) {
        snprintf(nm, sizeof(nm), "m23_%s_%s.bin", tag, what);
        return WriteBin(nm, p, n);
    };
    // g/β 落盘用紧凑 [H,T] 布局（去掉 32B 行填充），供 Python 按 [H,T] 读
    std::vector<float> gPack(static_cast<size_t>(H) * T), bPack(static_cast<size_t>(H) * T);
    for (uint32_t h = 0; h < H; ++h) {
        for (uint32_t t = 0; t < T; ++t) {
            gPack[static_cast<size_t>(h) * T + t] = g[static_cast<size_t>(h) * tp + t];
            bPack[static_cast<size_t>(h) * T + t] = beta[static_cast<size_t>(h) * tp + t];
        }
    }
    ok &= dump("q", q.data(), qkF * 4);
    ok &= dump("k", kk.data(), qkF * 4);
    ok &= dump("v", v.data(), vF * 4);
    ok &= dump("g", gPack.data(), static_cast<size_t>(H) * T * 4);
    ok &= dump("beta", bPack.data(), static_cast<size_t>(H) * T * 4);
    ok &= dump("h0", h0.data(), hF * 4);
    ok &= dump("o", o.data(), oF * 4);
    ok &= dump("ht", ht.data(), hF * 4);
    snprintf(nm, sizeof(nm), "m23_%s_meta.txt", tag);
    {
        FILE* f = fopen(nm, "w");
        if (f != nullptr) {
            fprintf(f, "H %u\nT %u\nNK %u\nDK 128\nDV 128\nBT 64\nscale %.9g\nTP %u\nnAic %u\nnc %u\n",
                    H, T, nk, static_cast<double>(scale), tp, nblk, (T + 63) / 64);
            fclose(f);
        }
    }
    printf("[M23] %-8s H=%-2u T=%-4u blk=%-2u : %.3f ms  (o[0..3]=%.6f %.6f %.6f %.6f, %s)\n", tag, H, T, nblk,
           ms, static_cast<double>(o[0]), static_cast<double>(o[1]), static_cast<double>(o[2]),
           static_cast<double>(o[3]), ok ? "dump ok" : "DUMP FAILED");
    for (size_t i = 0; i < dv.size(); ++i) {
        aclrtFree(dv[i]);
    }
    return ok;
}

int32_t main(int argc, char** argv)
{
    int mutate = 0;
    if (argc > 1 && strcmp(argv[1], "--mutate") == 0 && argc > 2) {
        mutate = atoi(argv[2]);
    }
    const Case cases[] = {
        {"m1", 48, 1, 0x2301u},
        {"p4097", 48, 4097, 0x2302u},
    };
    constexpr uint32_t nCases = sizeof(cases) / sizeof(cases[0]);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    int64_t aicNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("[M23][FAIL] query AICORE_CORE_NUM failed\n");
        return 1;
    }
    const uint32_t nblk = static_cast<uint32_t>(aicNum);
    printf("[M23] mix(1,2) launch: nblk(AIC)=%u → AIV 线程数=%u；slot=%u B；scratch=%zu B\n", nblk, nblk * 2,
           M15GP_H::kSlotBytes, M15GP_H::GdnPrefillScratchBytes(nblk));

    // 运行期开关：只跑 p4097（让 p4097 成为**第一个且唯一一个** kernel task）。
    // 默认不设该变量 ⇒ first = 0，循环起止与改动前**逐字等价**（默认行为不变）。
    const char* onlyPEnv = getenv("M15GP_ONLY_P4097");
    const bool onlyP = (onlyPEnv != nullptr) && (strcmp(onlyPEnv, "1") == 0);
    const uint32_t firstCase = onlyP ? 1u : 0u;
    printf("[M23] M15GP_ONLY_P4097=%s ⇒ 本次跑 case [%u, %u)\n", onlyP ? "1" : "(unset)",
           firstCase, (uint32_t)nCases);

    // 一般化开关：只跑一个任意 M 的单 case（H=48）。默认不设 ⇒ 上面的两 case 行为逐字不变。
    const char* onlyMEnv = getenv("M15GP_ONLY_M");
    const int onlyM = (onlyMEnv != nullptr) ? atoi(onlyMEnv) : 0;
    if (onlyM > 0) {
        char mtag[32];
        snprintf(mtag, sizeof(mtag), "m%d", onlyM);
        printf("[M23] M15GP_ONLY_M=%d ⇒ 单 case 运行（H=48, T=%d）\n", onlyM, onlyM);
        Case one;
        one.tag = mtag;
        one.H = 48;
        one.T = (uint32_t)onlyM;
        one.salt = 0x2304u;
        const bool okM = RunCase(stream, one, nblk, mutate, mtag);
        printf("[M23] ===== %s =====\n", okM ? "ALL RUNS OK" : "FAILURES PRESENT");
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return okM ? 0 : 1;
    }

    bool allOk = true;
    for (uint32_t c = firstCase; c < nCases; ++c) {
        char tag[64];
        if (mutate != 0) {
            snprintf(tag, sizeof(tag), "%s_mut%d", cases[c].tag, mutate);
        } else {
            snprintf(tag, sizeof(tag), "%s", cases[c].tag);
        }
        allOk &= RunCase(stream, cases[c], nblk, mutate, tag);
    }
    printf("[M23] ===== %s（数值判据请运行 check_ref.py）=====\n", allOk ? "ALL RUNS OK" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
