/**
 * probe_l0.asc —— 最小 AIC 探针：L0A/L0B/L0C 的 16/17 tile 边界（人类：「直接测试硬件呀」）
 * 只做一件事：同一 [N,K] 的 B 操作数下，做 1 个或 2 个 16 行 m-tile 的 LoadData→Mmad→Fixpipe 循环，
 * 看是否复现 `mte error info: …0202ce`。arm=0 用段体现用形态（每 tile 一次 BufferID 轮转，无额外屏障）；
 * arm=1 在 tile 之间加显式 PipeBarrier（保守形态）。操作数 fp32（= 本段类型），1 个 AIC。
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdio>
#include <cstdint>
#include <cstdlib>

namespace pl0 {
using namespace AscendC;
constexpr uint32_t DK = 128, DN = 128, MT = 16;   // tile 行数 = mmad 的 m pad 粒度
constexpr uint32_t L1_A = 0, L1_B = 32768;        // L1 区（fp32：A tile 8KB、B 64KB）
constexpr uint32_t BUF_L1 = 0, BUF_L0 = 1, BUF_L0C = 2;

__global__ __cube__ void probe_l0_kernel(__gm__ float* aGm, __gm__ float* bGm, __gm__ float* cGm,
                                         uint32_t tiles, uint32_t iters, uint32_t arm)
{
    AscendC::InitSocState();
    GlobalTensor<float> ag, bg, cg;
    ag.SetGlobalBuffer(aGm);
    bg.SetGlobalBuffer(bGm);
    cg.SetGlobalBuffer(cGm);
    LocalTensor<float> l1a(TPosition::A1, L1_A, 2 * MT * DK);
    LocalTensor<float> l1b(TPosition::B1, L1_B, DN * DK);
    LocalTensor<float> l0a(TPosition::A2, 0, MT * DK);
    LocalTensor<float> l0b(TPosition::B2, 0, DN * DK);
    LocalTensor<float> l0c(TPosition::CO1, 0, MT * DN);

    {   // B 预装一次：[N,K] ND → L1 NZ
        Nd2NzParams pb = {};
        pb.ndNum = 1; pb.nValue = DN; pb.dValue = DK; pb.srcNdMatrixStride = 0; pb.srcDValue = DK;
        pb.dstNzC0Stride = DN; pb.dstNzNStride = 1; pb.dstNzMatrixStride = 0;
        DataCopy(l1b, bg[0], pb);
    }
    for (uint32_t it = 0; it < iters; ++it) {
        for (uint32_t t = 0; t < tiles; ++t) {
            {   // A tile t：[MT,K] ND → L1 NZ
                Nd2NzParams pa = {};
                pa.ndNum = 1; pa.nValue = MT; pa.dValue = DK; pa.srcNdMatrixStride = 0; pa.srcDValue = DK;
                pa.dstNzC0Stride = MT; pa.dstNzNStride = 1; pa.dstNzMatrixStride = 0;
                Mutex::Lock<PIPE_MTE2>(BUF_L1);
                DataCopy(l1a, ag[t * MT * DK], pa);
                Mutex::Unlock<PIPE_MTE2>(BUF_L1);
            }
            Mutex::Lock<PIPE_MTE1>(BUF_L0);
            Mutex::Lock<PIPE_MTE1>(BUF_L1);
            {
                LoadData2DParamsV2 lp = {};
                lp.mStartPosition = 0; lp.kStartPosition = 0;
                lp.mStep = (uint16_t)(MT / 16); lp.kStep = (uint16_t)(DK / 8);
                lp.srcStride = (int32_t)(MT / 16); lp.dstStride = (uint16_t)(MT / 16);
                lp.ifTranspose = false; lp.sid = 0;
                LoadData(l0a, l1a, lp);
            }
            {
                LoadData2DParams lb = {};
                lb.startIndex = 0; lb.repeatTimes = (uint8_t)((DN / 16) * (DK / 8));
                lb.srcStride = 1; lb.dstGap = 0; lb.ifTranspose = false;
                LoadData(l0b, l1b, lb);
            }
            Mutex::Unlock<PIPE_MTE1>(BUF_L1);
            Mutex::Unlock<PIPE_MTE1>(BUF_L0);
            {
                MmadParams mp = {};
                mp.m = (uint16_t)MT; mp.n = (uint16_t)DN; mp.k = (uint16_t)DK;
                mp.cmatrixInitVal = (t == 0); mp.cmatrixSource = false;
                Mutex::Lock<PIPE_M>(BUF_L0);
                Mmad(l0c, l0a, l0b, mp);
                Mutex::Unlock<PIPE_M>(BUF_L0);
            }
            if (arm == 1) {   // 保守形态：tile 之间显式 drain
                PipeBarrier<PIPE_M>();
                PipeBarrier<PIPE_MTE1>();
            }
            Mutex::Lock<PIPE_FIX>(BUF_L0C);
            {
                FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp = {};
                fp.nSize = (uint16_t)DN; fp.mSize = (uint16_t)MT;
                fp.srcStride = (uint16_t)MT; fp.dstStride = DN;
                fp.reluScalar = 0; fp.vectorRelu = 0; fp.deqScalar = 0;
                static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
                Fixpipe<float, float, kFixGm>(cg[0], l0c, fp);
            }
            Mutex::Unlock<PIPE_FIX>(BUF_L0C);
        }
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace pl0

int32_t main(int argc, char** argv)
{
    const uint32_t tiles = (argc > 1) ? (uint32_t)atoi(argv[1]) : 1u;
    const uint32_t iters = (argc > 2) ? (uint32_t)atoi(argv[2]) : 200u;
    const uint32_t arm = (argc > 3) ? (uint32_t)atoi(argv[3]) : 0u;
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    const size_t aF = 2 * pl0::MT * pl0::DK, bF = pl0::DN * pl0::DK, cF = pl0::MT * pl0::DN;
    float *ah = (float*)malloc(aF * 4), *bh = (float*)malloc(bF * 4);
    for (size_t i = 0; i < aF; ++i) ah[i] = 1.0f;
    for (size_t i = 0; i < bF; ++i) bh[i] = 1.0f;
    void *ad = nullptr, *bd = nullptr, *cd = nullptr;
    aclrtMalloc(&ad, aF * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&bd, bF * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&cd, cF * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(ad, aF * 4, ah, aF * 4, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bd, bF * 4, bh, bF * 4, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(cd, cF * 4, 0, cF * 4);
    printf("[PL0] tiles=%u iters=%u arm=%u (1 AIC, fp32, N=K=128, tile=16 行)\n", tiles, iters, arm);
    pl0::probe_l0_kernel<<<1, 0, stream>>>(reinterpret_cast<float*>(ad), reinterpret_cast<float*>(bd),
                                           reinterpret_cast<float*>(cd), tiles, iters, arm);
    const aclError err = aclrtSynchronizeStream(stream);
    float c0 = 0.0f;
    aclrtMemcpy(&c0, 4, cd, 4, ACL_MEMCPY_DEVICE_TO_HOST);
    if (err != ACL_SUCCESS) {
        printf("[PL0][FAIL] acl err=%d : %s\n", (int)err, aclGetRecentErrMsg());
        return 1;
    }
    printf("[PL0][OK] C[0][0]=%.1f (期望 = iters×tiles×K = %u)\n", c0, iters * tiles * pl0::DK);
    aclrtFree(ad); aclrtFree(bd); aclrtFree(cd);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
    return 0;
}
