/**
 * m23_cc_probe.asc —— M115 的最小**核间握手探针**（塔裁 ③：收 J 之前先验 mode 形态）
 *
 * 只验一件事：本段体用的那种「**AIV 写 GM → AIC 从 GM 读**」的交接，配 **mode 2** 时在多轮重复下
 * 是否成立。变量只有一个：`iters`（重复轮数）与 `variant`（AIC 侧对 GO 等几次）。
 *
 *   variant 0：2 个 AIV set(GO) → AIC 等 **1** 次；AIC set(DONE) 1 次 → 2 个 AIV 各等 1 次
 *   variant 1：2 个 AIV set(GO) → AIC 等 **2** 次；其余同上
 *
 * 判据不是数值，而是「**返回 / 不返回**」：按 iters = 4/8/12/16/24/200 扫一遍，
 * 若在某个 iters 上开始不返回，那就是**每 id 的 4 bit 计数器**（docs/05 §6.1：每 id 未配平累计 ≤15）
 * 出问题的指纹（"挂"而不是 FAIL）。
 *
 * 用法：./m23_cc_probe <variant> <iters>
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <ctime>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint8_t M2 = 2;
constexpr uint16_t F_GO = 0;
constexpr uint16_t F_DONE = 1;

__simd_vf__ inline void FillOne(__ubuf__ float* p)
{
    RegTensor<float> r;
    MaskReg m = CreateMask<float, MaskPattern::ALL>();
    Duplicate(r, 1.0f);
    StoreAlign(p, r, m);
}

__global__ __mix__(1, 2) void cc_probe_kernel(__gm__ float* gm, uint32_t variant, uint32_t iters)
{
    AscendC::InitSocState();
    const uint32_t bid = AscendC::GetBlockIdx();   // AIV 视角 ∈ [0, 2×AIC)
    GlobalTensor<float> g;
    g.SetGlobalBuffer(gm);

    if ASCEND_IS_AIV {
        if (bid > 1) {
            return;   // 只留 AICore0 的两个 AIV
        }
        LocalTensor<float> lt(TPosition::VECCALC, 0, 64);
        __ubuf__ float* ub = reinterpret_cast<__ubuf__ float*>(lt.GetPhyAddr());
        // 只在进入循环前写一次 UB（避免在 VF 循环里放标量指令）
        {
            AscendC::PipeBarrier<PIPE_ALL>();
            FillOne(ub);
            AscendC::PipeBarrier<PIPE_ALL>();
        }
        const DataCopyParams cp{1, 1, 0, 0};   // 1 块 × 32B
        for (uint32_t it = 0; it < iters; ++it) {
            AscendC::Mutex::Lock<PIPE_MTE3>(0);
            AscendC::DataCopy(g[bid * 8], lt, cp);
            AscendC::Mutex::Unlock<PIPE_MTE3>(0);
            if (variant == 3) {
                AscendC::CrossCoreSetFlag<M2, PIPE_V>(F_GO);   // 变体 3：set 挂 PIPE_V
            } else {
                AscendC::CrossCoreSetFlag<M2, PIPE_MTE3>(F_GO);
            }
            AscendC::CrossCoreWaitFlag<M2, PIPE_MTE2>(F_DONE);
        }
        return;
    }

    if ASCEND_IS_AIC {
        if (bid != 0) {
            return;   // 只留 AICore0 的 AIC
        }
        LocalTensor<float> l1(TPosition::A1, 0, 64);
        for (uint32_t it = 0; it < iters; ++it) {
            AscendC::CrossCoreWaitFlag<M2, PIPE_MTE2>(F_GO);
            if (variant == 1) {
                AscendC::CrossCoreWaitFlag<M2, PIPE_MTE2>(F_GO);   // 2 set → 2 wait 变体
            }
            // 从 GM 读回（Nd2Nz，8×8 避开"行数=1 退化"的 quirk）
            AscendC::Mutex::Lock<PIPE_MTE2>(0);
            Nd2NzParams par = {};
            par.ndNum = 1;
            par.nValue = 8;
            par.dValue = 8;
            par.srcNdMatrixStride = 0;
            par.srcDValue = 8;
            par.dstNzC0Stride = 8;
            par.dstNzNStride = 1;
            par.dstNzMatrixStride = 0;
            AscendC::DataCopy(l1, g[0], par);
            AscendC::Mutex::Unlock<PIPE_MTE2>(0);
            if (variant == 2) {
                // 变体 2：真发一次 Fixpipe（L0C→GM），set 挂 PIPE_FIX（本段体的形态）
                LocalTensor<float> l0c(TPosition::CO1, 0, 64);
                FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp = {};
                fp.nSize = 8; fp.mSize = 8; fp.srcStride = 8; fp.dstStride = 8;
                fp.reluScalar = 0; fp.vectorRelu = 0; fp.deqScalar = 0;
                static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
                AscendC::Fixpipe<float, float, kFixGm>(g[8], l0c, fp);
                AscendC::CrossCoreSetFlag<M2, PIPE_FIX>(F_DONE);   // 变体 2
            } else {
                AscendC::CrossCoreSetFlag<M2, PIPE_MTE2>(F_DONE);
            }
        }
        return;
    }
}

}  // namespace

int32_t main(int argc, char** argv)
{
    const uint32_t variant = (argc > 1) ? static_cast<uint32_t>(atoi(argv[1])) : 0u;
    const uint32_t iters = (argc > 2) ? static_cast<uint32_t>(atoi(argv[2])) : 4u;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    int64_t aicNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("[CCP][FAIL] query core num failed\n");
        return 1;
    }
    const uint32_t nblk = static_cast<uint32_t>(aicNum);
    void* dv = nullptr;
    aclrtMalloc(&dv, 4096, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dv, 4096, 0, 4096);

    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);
    cc_probe_kernel<<<nblk, 0, stream>>>(reinterpret_cast<float*>(dv), variant, iters);
    const aclError err = aclrtSynchronizeStream(stream);
    clock_gettime(CLOCK_MONOTONIC, &t1);
    const double ms = (double)(t1.tv_sec - t0.tv_sec) * 1e3 + (double)(t1.tv_nsec - t0.tv_nsec) * 1e-6;
    if (err != ACL_SUCCESS) {
        printf("[CCP][FAIL] variant=%u iters=%u err=%d : %s\n", variant, iters, (int)err, aclGetRecentErrMsg());
        return 1;
    }
    printf("[CCP] variant=%u iters=%-4u : 返回 OK, %.3f ms\n", variant, iters, ms);
    aclrtFree(dv);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
