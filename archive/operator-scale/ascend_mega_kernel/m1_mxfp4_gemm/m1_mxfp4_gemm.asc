/**
 * m1_mxfp4_gemm.asc —— Mega kernel M1：MXFP4 GEMM 单 AIC 核移植
 * （设计约束见 docs/05-megakernel-design.md；donor：asc-devkit matmul_mxfp4_basic_api_high_performance/mmad_mx.asc）
 *
 * 功能：单 AIC 核完成 C(m×N, bf16) = A(m×K, MXFP4) × B(K×N, MXFP4)^T，其中
 *   - A/B 为 e2m1 fp4（uint8 nibble 打包，lo=偶数元素、hi=奇数元素）+ e8m0 scale，K 方向 group_size=32
 *   - B 按模型原始权重 layout 以 [N, K] 存放（行主序，每行 K/2 字节），scaleB 为 [N, K/32]
 *   - m 为运行时动态值，支持 1..256：M 方向 tile 静态（baseM=256），循环 + 尾块 mask（curM）处理
 *
 * 数据通路（全部基础 API，无高阶 API / TPipe / TBuf / TQue）：
 *   GM --DataCopy(Nd2Nz 数据 + Dn2Nz scale, MTE2)--> L1
 *   L1 --LoadData(LoadData2DMxParams, MTE1)--> L0A/L0B(MX)
 *   L0 --MmadMx(M)--> L0C(fp32 累加)
 *   L0C --Fixpipe(FIXP, F322BF16)--> GM
 *
 * 同步：只用 BufferID（Mutex::Lock/Unlock，编译期静态 ID），L1/L0 双缓冲流水：
 *   BUF_A0/1、BUF_B0/1  : MTE2 生产 L1 大包 -> MTE1 消费（full/empty 交接）
 *   BUF_L0_0/1          : MTE1 生产 L0 -> M 消费
 *   BUF_L0C             : M 累加完成 -> FIXP 读回写 GM（同时挡住下一 tile 的 Mmad 覆盖 L0C）
 *
 * 编译期模板参数 <K, N> 取模型真实形状：down_proj (K=640, N=2560)、gate_up_proj (K=2560, N=1280)。
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cmath>
#include <cstdint>

// ============================================================
// 编译期常量：tile 与静态资源表（地址/BufferID 全部编译期静态分配）
// ============================================================

__aicore__ __inline__ constexpr uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ __inline__ constexpr uint32_t AlignUp(uint32_t a, uint32_t b) { return CeilDiv(a, b) * b; }
__aicore__ __inline__ constexpr uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

constexpr uint32_t CUBE_BLOCK = 16;   // cube 分形边长（元素）
constexpr uint32_t SCALE_GROUP = 32;  // MXFP4: K 方向每 32 个元素共享 1 个 scale
constexpr uint32_t BASE_M = 256;      // M 方向 tile（静态）；m ∈ [1, 256] 单 tile，尾块用 curM mask
constexpr uint32_t BASE_K = 128;      // K 方向 tile（K 必须能被 BASE_K 整除）
constexpr uint32_t BASE_N = 256;      // N 方向 tile（N 必须能被 BASE_N 整除）

// ---- L1 静态布局（字节偏移；A 区 [0,256KB)，B 区 [256KB,512KB)，与 donor 一致）----
constexpr uint32_t L1_A_DATA_BYTES = BASE_M * (BASE_K / 2);   // 一个 baseK 大包：256×64 = 16KB
constexpr uint32_t L1_A_SCAL_BYTES = BASE_M * (BASE_K / SCALE_GROUP); // 256×4 = 1KB
constexpr uint32_t L1_OFF_A0 = 0;
constexpr uint32_t L1_OFF_A1 = L1_A_DATA_BYTES;
constexpr uint32_t L1_OFF_AS0 = 2 * L1_A_DATA_BYTES;
constexpr uint32_t L1_OFF_AS1 = L1_OFF_AS0 + L1_A_SCAL_BYTES;
constexpr uint32_t L1_B_REGION = 256 * 1024;
constexpr uint32_t L1_OFF_B0 = L1_B_REGION;
constexpr uint32_t L1_OFF_B1 = L1_B_REGION + L1_A_DATA_BYTES;
constexpr uint32_t L1_OFF_BS0 = L1_B_REGION + 2 * L1_A_DATA_BYTES;
constexpr uint32_t L1_OFF_BS1 = L1_OFF_BS0 + L1_A_SCAL_BYTES;
static_assert(2 * L1_A_DATA_BYTES + 2 * L1_A_SCAL_BYTES <= 256 * 1024, "A/As ping-pong L1 footprint exceeds 256KB");

// ---- L0 静态布局（字节偏移；L0A/L0B 各 64KB，ping/pong 各 32KB）----
constexpr uint32_t L0_PP_BYTES = 32 * 1024;
constexpr uint32_t L0_OFF_0 = 0;
constexpr uint32_t L0_OFF_1 = L0_PP_BYTES;
static_assert(BASE_M * BASE_K / 2 <= L0_PP_BYTES, "A2 tile exceeds L0A half");   // fp4: 256×128 = 32KB
static_assert(BASE_K * BASE_N / 2 <= L0_PP_BYTES, "B2 tile exceeds L0B half");   // fp4: 128×256 = 32KB
// L0C（CO1）：256×256 fp32 = 256KB，偏移 0

// ---- BufferID（MutexID 有效范围 0..27，静态分配；单 AIC 核内同步）----
constexpr AscendC::MutexID BUF_A0 = 0;     // A1(+scaleA1) ping: MTE2 -> MTE1
constexpr AscendC::MutexID BUF_A1 = 1;     // A1(+scaleA1) pong
constexpr AscendC::MutexID BUF_B0 = 2;     // B1(+scaleB1) ping: MTE2 -> MTE1
constexpr AscendC::MutexID BUF_B1 = 3;     // B1(+scaleB1) pong
constexpr AscendC::MutexID BUF_L0_0 = 4;   // L0A/L0B ping: MTE1 -> M
constexpr AscendC::MutexID BUF_L0_1 = 5;   // L0A/L0B pong
constexpr AscendC::MutexID BUF_L0C = 6;    // L0C: M -> FIXP

// ============================================================
// Kernel 实现
// ============================================================

template <uint32_t K, uint32_t N>
class MXFP4Gemm {
    static constexpr uint32_t PACKED_K = K / 2;                       // 每行打包字节数（fp4x2 元素数）
    static constexpr uint32_t SCALE_K = AlignUp(K / SCALE_GROUP, 2);  // 每行 scale 字节数（2B 对齐，硬件要求）
    static_assert(K % BASE_K == 0, "K must be divisible by BASE_K");
    static_assert(N % BASE_N == 0, "N must be divisible by BASE_N");
    static_assert(BASE_K % 64 == 0, "BASE_K must be 64-aligned for b16 scale copy");
    static_assert((BASE_K / SCALE_GROUP) % 2 == 0, "scale bytes per K tile must be even");

public:
    __aicore__ inline MXFP4Gemm() {}

    __aicore__ inline void Init(
        __gm__ uint8_t* a, __gm__ uint8_t* as, __gm__ uint8_t* b, __gm__ uint8_t* bs, __gm__ uint8_t* c,
        uint32_t m)
    {
        aGMOri.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)a);
        asGMOri.SetGlobalBuffer((__gm__ fp8_e8m0_t*)as);
        bGMOri.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)b);
        bsGMOri.SetGlobalBuffer((__gm__ fp8_e8m0_t*)bs);
        cGMOri.SetGlobalBuffer((__gm__ bfloat16_t*)c);
        mTotal = m;
    }

    __aicore__ inline void Process()
    {
        const uint32_t mLoop = CeilDiv(mTotal, BASE_M);  // m ≤ 256 时为 1
        const uint32_t nLoop = N / BASE_N;
        const uint32_t kLoop = K / BASE_K;

        // L1 / L0 / L0C 静态 tensor（position + 字节偏移 + 大小，自管理地址）
        AscendC::LocalTensor<fp4x2_e2m1_t> a1Ping(AscendC::TPosition::A1, L1_OFF_A0, L1_A_DATA_BYTES);
        AscendC::LocalTensor<fp4x2_e2m1_t> a1Pong(AscendC::TPosition::A1, L1_OFF_A1, L1_A_DATA_BYTES);
        AscendC::LocalTensor<fp8_e8m0_t> as1Ping(AscendC::TPosition::A1, L1_OFF_AS0, L1_A_SCAL_BYTES);
        AscendC::LocalTensor<fp8_e8m0_t> as1Pong(AscendC::TPosition::A1, L1_OFF_AS1, L1_A_SCAL_BYTES);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Ping(AscendC::TPosition::B1, L1_OFF_B0, L1_A_DATA_BYTES);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Pong(AscendC::TPosition::B1, L1_OFF_B1, L1_A_DATA_BYTES);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Ping(AscendC::TPosition::B1, L1_OFF_BS0, L1_A_SCAL_BYTES);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Pong(AscendC::TPosition::B1, L1_OFF_BS1, L1_A_SCAL_BYTES);

        AscendC::LocalTensor<fp4x2_e2m1_t> a2Ping(AscendC::TPosition::A2, L0_OFF_0, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> a2Pong(AscendC::TPosition::A2, L0_OFF_1, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Ping(AscendC::TPosition::B2, L0_OFF_0, BASE_K * BASE_N / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Pong(AscendC::TPosition::B2, L0_OFF_1, BASE_K * BASE_N / 2);

        AscendC::LocalTensor<float> cL0C(AscendC::TPosition::CO1, 0, BASE_M * BASE_N);

        for (uint32_t mBlock = 0; mBlock < mLoop; ++mBlock) {
            const uint32_t curM = MinU32(mTotal - mBlock * BASE_M, BASE_M);  // 尾块 mask（动态 m 的核心处理）
            const uint32_t curMAlign = AlignUp(curM, CUBE_BLOCK);
            // 3510 实测：Nd2Nz/Dn2Nz 行数为 1 时不做 NZ 切分（退化为 1D 拷贝），导致 m=1 数据错位。
            // 计算侧统一提升为 >=2 行（多读的 1 行由 host 保证可读，结果行不写出），仅在 Fixpipe 用 curM mask。
            const uint32_t calcM = curM < 2 ? 2 : curM;
            for (uint32_t nBlock = 0; nBlock < nLoop; ++nBlock) {
                // M 先取 L0C 所有权：挡住上一 tile 的 Fixpipe 读、允许本 tile 累加
                AscendC::Mutex::Lock<PIPE_M>(BUF_L0C);
                for (uint32_t kBlock = 0; kBlock < kLoop; ++kBlock) {
                    const uint32_t p = kBlock & 1;
                    const AscendC::MutexID bufA = p ? BUF_A1 : BUF_A0;
                    const AscendC::MutexID bufB = p ? BUF_B1 : BUF_B0;
                    const AscendC::MutexID bufL0 = p ? BUF_L0_1 : BUF_L0_0;
                    AscendC::LocalTensor<fp4x2_e2m1_t> a1 = p ? a1Pong : a1Ping;
                    AscendC::LocalTensor<fp4x2_e2m1_t> b1 = p ? b1Pong : b1Ping;
                    AscendC::LocalTensor<fp8_e8m0_t> as1 = p ? as1Pong : as1Ping;
                    AscendC::LocalTensor<fp8_e8m0_t> bs1 = p ? bs1Pong : bs1Ping;
                    AscendC::LocalTensor<fp4x2_e2m1_t> a2 = p ? a2Pong : a2Ping;
                    AscendC::LocalTensor<fp4x2_e2m1_t> b2 = p ? b2Pong : b2Ping;

                    // ---- MTE2：GM -> L1（Nd2Nz 数据 + Dn2Nz scale），大包生产 ----
                    AscendC::Mutex::Lock<PIPE_MTE2>(bufA);
                    CopyInA(a1, as1, kBlock, mBlock, calcM);
                    AscendC::Mutex::Unlock<PIPE_MTE2>(bufA);
                    AscendC::Mutex::Lock<PIPE_MTE2>(bufB);
                    CopyInB(b1, bs1, kBlock, nBlock);
                    AscendC::Mutex::Unlock<PIPE_MTE2>(bufB);

                    // ---- MTE1：L1 -> L0（LoadData MX），消费 L1、生产 L0 ----
                    AscendC::Mutex::Lock<PIPE_MTE1>(bufL0);   // 等 M 释放 L0 缓冲
                    AscendC::Mutex::Lock<PIPE_MTE1>(bufA);    // 等 MTE2 数据就绪
                    AscendC::Mutex::Lock<PIPE_MTE1>(bufB);
                    LoadA(a1, as1, a2, curMAlign);
                    LoadB(b1, bs1, b2);
                    AscendC::Mutex::Unlock<PIPE_MTE1>(bufA);  // L1 可复用
                    AscendC::Mutex::Unlock<PIPE_MTE1>(bufB);
                    AscendC::Mutex::Unlock<PIPE_MTE1>(bufL0); // L0 数据就绪

                    // ---- M：MmadMx 累加（L0C），消费 L0 ----
                    AscendC::Mutex::Lock<PIPE_M>(bufL0);
                    AscendC::MmadParams mmadParams;
                    mmadParams.m = calcM;
                    mmadParams.n = BASE_N;
                    mmadParams.k = BASE_K;
                    mmadParams.cmatrixInitVal = (kBlock == 0);
                    AscendC::MmadMx(cL0C, a2, b2, mmadParams);
                    AscendC::Mutex::Unlock<PIPE_M>(bufL0);
                }
                // ---- FIXP：L0C -> GM（F322BF16）----
                AscendC::Mutex::Unlock<PIPE_M>(BUF_L0C);      // L0C 累加结果就绪
                AscendC::Mutex::Lock<PIPE_FIX>(BUF_L0C);
                CopyOut(cL0C, mBlock, nBlock, curM, curMAlign);
                AscendC::Mutex::Unlock<PIPE_FIX>(BUF_L0C);
            }
        }
    }

private:
    // GM -> L1：A 的一个 baseK 大包（curM 行 × BASE_K fp4）+ 对应 scale（Dn2Nz，按 b16 视图）
    __aicore__ inline void CopyInA(
        AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
        uint32_t kBlock, uint32_t mBlock, uint32_t curM)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;  // 每行本大包打包字节数
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = curM;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_M;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        // 偏移单位 = fp4 元素（kernel tensor operator[] 对 fp4x2 类型按 4bit 计）
        AscendC::DataCopy(a1, aGMOri[kBlock * BASE_K + mBlock * K * BASE_M], par);

        // scale：fp8 按 2B 连续搬运（硬件 MX 要求），视作 b16 做 Dn2Nz
        constexpr uint32_t stepScaleK = BASE_K / SCALE_GROUP;  // 本大包 scale 字节数（偶数）
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = curM;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = SCALE_K / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (mBlock * BASE_M * SCALE_K + kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> asGMB16;
        asGMB16.SetGlobalBuffer(((__gm__ half*)asGMOri.GetPhyAddr()) + scaleOffHalf, curM * (SCALE_K / 2));
        AscendC::DataCopy(as1.ReinterpretCast<half>(), asGMB16, sp);
    }

    // GM -> L1：B 按模型权重原始 layout [N, K] 存放，本次搬 baseN 行 × BASE_K fp4 + scale
    __aicore__ inline void CopyInB(
        AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
        uint32_t kBlock, uint32_t nBlock)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = BASE_N;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_N;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, bGMOri[kBlock * BASE_K + nBlock * BASE_N * K], par);

        constexpr uint32_t stepScaleK = BASE_K / SCALE_GROUP;
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = BASE_N;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = SCALE_K / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (nBlock * BASE_N * SCALE_K + kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> bsGMB16;
        bsGMB16.SetGlobalBuffer(((__gm__ half*)bsGMOri.GetPhyAddr()) + scaleOffHalf, BASE_N * (SCALE_K / 2));
        AscendC::DataCopy(bs1.ReinterpretCast<half>(), bsGMB16, sp);
    }

    // L1 -> L0：A tile（含 scale，MX 路径）
    __aicore__ inline void LoadA(
        AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
        AscendC::LocalTensor<fp4x2_e2m1_t>& a2, uint32_t curMAlign)
    {
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = curMAlign / CUBE_BLOCK;  // M 轴分形数
        lp.kStep = BASE_K / 64;             // K 轴 32B 段数
        lp.srcStride = BASE_M / CUBE_BLOCK; // 源 K 方向相邻分形间隔（512B 单位）
        lp.dstStride = curMAlign / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = curMAlign / CUBE_BLOCK;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(a2, a1[0], as1[0], lp, mx);
    }

    // L1 -> L0：B tile（N 轴 baseN 行，含 scale，MX 路径）
    __aicore__ inline void LoadB(
        AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
        AscendC::LocalTensor<fp4x2_e2m1_t>& b2)
    {
        constexpr uint32_t nFracs = BASE_N / CUBE_BLOCK;
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = nFracs;                  // N 轴分形数
        lp.kStep = BASE_K / 64;
        lp.srcStride = BASE_N / CUBE_BLOCK;
        lp.dstStride = nFracs;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = nFracs;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(b2, b1[0], bs1[0], lp, mx);
    }

    // L0C -> GM：bf16 写回（curM 行 mask，尾块不越界）
    __aicore__ inline void CopyOut(
        AscendC::LocalTensor<float>& cL0C, uint32_t mBlock, uint32_t nBlock, uint32_t curM, uint32_t curMAlign)
    {
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp;
        fp.nSize = BASE_N;
        fp.mSize = curM;
        fp.srcStride = curMAlign;
        fp.dstStride = N;
        fp.quantPre = QuantMode_t::F322BF16;
        AscendC::Fixpipe(cGMOri[mBlock * BASE_M * N + nBlock * BASE_N], cL0C, fp);
    }

private:
    AscendC::GlobalTensor<fp4x2_e2m1_t> aGMOri;
    AscendC::GlobalTensor<fp8_e8m0_t> asGMOri;
    AscendC::GlobalTensor<fp4x2_e2m1_t> bGMOri;
    AscendC::GlobalTensor<fp8_e8m0_t> bsGMOri;
    AscendC::GlobalTensor<bfloat16_t> cGMOri;
    uint32_t mTotal;
};

template <uint32_t K, uint32_t N>
__global__ __cube__ void mxfp4_gemm_kernel(
    __gm__ uint8_t* a, __gm__ uint8_t* as, __gm__ uint8_t* b, __gm__ uint8_t* bs, __gm__ uint8_t* c, uint32_t m)
{
    AscendC::InitSocState();
    MXFP4Gemm<K, N> op;
    op.Init(a, as, b, bs, c, m);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧：确定性随机输入生成 + 参考 matmul 校验
// ============================================================

// ---- e2m1 编解码（bias=1；0x7/0xF 为 NaN，生成时避开）----
static float E2M1ToFloat(uint8_t code)
{
    static const float kVal[8] = {0.0f, 0.5f, 1.0f, 1.5f, 2.0f, 3.0f, 4.0f, 0.0f /*NaN 占位，生成侧不出现*/};
    const bool sign = (code >> 3) != 0;
    float v = kVal[code & 0x7];
    return sign ? -v : v;
}

// ---- e8m0 编解码：value = 2^(bits-127)（生成范围避开 0/0xFF 与次正规）----
static float E8M0ToFloat(uint8_t bits)
{
    const int e = (int)bits - 127;
    if (e < -126) return 0.0f;
    uint32_t x = (uint32_t)(e + 127) << 23;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

// ---- bf16 编解码（C 输出）----
static uint16_t FloatToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return (uint16_t)((x + roundingBias) >> 16);
}

static float Bf16ToFloat(uint16_t h)
{
    uint32_t x = ((uint32_t)h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

// ---- 确定性伪随机（与 m0 的 DataFormula 同风格：纯公式，无 rand 状态）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

struct GemmShape {
    const char* name;
    uint32_t k;
    uint32_t n;
    double sqrtK;  // sqrt(K)，预计算（ASC host 链接无 libm）
};

// 生成 MXFP4 数据：[rows, K] fp4（nibble lohi 打包）+ [rows, K/32] e8m0 scale
static void GenMxfp4(uint8_t* data, uint8_t* scales, uint32_t rows, uint32_t k, uint32_t salt)
{
    const uint32_t kg = k / SCALE_GROUP;
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t g = 0; g < kg; ++g) {
            scales[i * kg + g] = (uint8_t)(126 + (Hash3(i, g, salt + 7) % 4));  // 2^-1 .. 2^2
        }
        for (uint32_t kk = 0; kk < k; kk += 2) {
            uint8_t lo = (uint8_t)(Hash3(i, kk, salt) & 0xF);
            uint8_t hi = (uint8_t)(Hash3(i, kk + 1, salt) & 0xF);
            if ((lo & 0x7) == 0x7) lo &= 0xE;  // 避开 NaN(0x7/0xF)
            if ((hi & 0x7) == 0x7) hi &= 0xE;
            data[i * (k / 2) + kk / 2] = (uint8_t)(lo | (hi << 4));
        }
    }
}

// 解包 MXFP4 为 double（参考计算用）
static void UnpackMxfp4(const uint8_t* data, const uint8_t* scales, uint32_t rows, uint32_t k, double* out)
{
    const uint32_t kg = k / SCALE_GROUP;
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t kk = 0; kk < k; ++kk) {
            uint8_t byte = data[i * (k / 2) + kk / 2];
            uint8_t code = (kk & 1) ? (byte >> 4) : (byte & 0xF);
            out[i * k + kk] = (double)E2M1ToFloat(code) * (double)E8M0ToFloat(scales[i * kg + kk / SCALE_GROUP]);
        }
    }
}

// 校验一个 shape × m 组合；返回 true = PASS
static bool RunCase(aclrtStream stream, const GemmShape& shape, uint32_t m)
{
    const uint32_t k = shape.k;
    const uint32_t n = shape.n;
    const uint32_t mAlloc = m < 2 ? 2 : m;  // kernel 对 m=1 会提升为 2 行计算（多读 1 行，不写出）
    const size_t aBytes = (size_t)mAlloc * k / 2;
    const size_t asBytes = (size_t)mAlloc * (k / SCALE_GROUP);
    const size_t bBytes = (size_t)n * k / 2;
    const size_t bsBytes = (size_t)n * (k / SCALE_GROUP);
    const size_t cBytes = (size_t)m * n * 2;

    uint8_t *aHost = nullptr, *asHost = nullptr, *bHost = nullptr, *bsHost = nullptr;
    uint16_t* cHost = nullptr;
    uint8_t *aDev = nullptr, *asDev = nullptr, *bDev = nullptr, *bsDev = nullptr, *cDev = nullptr;
    aclrtMallocHost((void**)&aHost, aBytes);
    aclrtMallocHost((void**)&asHost, asBytes);
    aclrtMallocHost((void**)&bHost, bBytes);
    aclrtMallocHost((void**)&bsHost, bsBytes);
    aclrtMallocHost((void**)&cHost, cBytes);
    aclrtMalloc((void**)&aDev, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&asDev, asBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bDev, bBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bsDev, bsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cDev, cBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    // 确定性随机输入（A 按 m 行真实生成，验证动态 m 不越界、不需 padding）
    GenMxfp4(aHost, asHost, m, k, 11);
    GenMxfp4(bHost, bsHost, n, k, 23);
    aclrtMemcpy(aDev, aBytes, aHost, aBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(asDev, asBytes, asHost, asBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDev, bBytes, bHost, bBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bsDev, bsBytes, bsHost, bsBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t mDev = m;
    if (k == 640 && n == 2560) {
        mxfp4_gemm_kernel<640, 2560><<<1, 0, stream>>>(aDev, asDev, bDev, bsDev, cDev, mDev);
    } else {
        mxfp4_gemm_kernel<2560, 1280><<<1, 0, stream>>>(aDev, asDev, bDev, bsDev, cDev, mDev);
    }
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M1][FAIL] %s m=%u kernel launch/sync error %d\n", shape.name, m, (int)launchErr);
        return false;
    }
    aclrtMemcpy(cHost, cBytes, cDev, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    // ---- host 参考：解包 + double matmul；参考值同样 round 到 bf16 网格，
    //      容差 = 1e-2 相对 + 累加尺度项（fp32 累加在随机符号相消下的物理误差上界）----
    double* aFull = new double[(size_t)m * k];
    double* bFull = new double[(size_t)n * k];
    UnpackMxfp4(aHost, asHost, m, k, aFull);
    UnpackMxfp4(bHost, bsHost, n, k, bFull);  // bFull 按 [N, K] 解包，B[k][n] = bFull[n*k+k]

    double* rowMaxA = new double[m];      // 每行 |A| 最大值
    double* rowMaxB = new double[n];      // B 每行（即每个 n 列）|B| 最大值
    for (uint32_t i = 0; i < m; ++i) {
        double mx = 0.0;
        for (uint32_t kk = 0; kk < k; ++kk) mx = fmax(mx, fabs(aFull[i * k + kk]));
        rowMaxA[i] = mx;
    }
    for (uint32_t j = 0; j < n; ++j) {
        double mx = 0.0;
        for (uint32_t kk = 0; kk < k; ++kk) mx = fmax(mx, fabs(bFull[(size_t)j * k + kk]));
        rowMaxB[j] = mx;
    }
    const double absTolBase = 1e-3 * shape.sqrtK;  // × maxA_i × maxB_j 后即为累加误差尺度

    bool pass = true;
    uint32_t failCount = 0;
    double maxRelDiff = 0.0;
    for (uint32_t i = 0; i < m && failCount < 5; ++i) {
        for (uint32_t j = 0; j < n; ++j) {
            double acc = 0.0;
            for (uint32_t kk = 0; kk < k; ++kk) {
                acc += aFull[i * k + kk] * bFull[(size_t)j * k + kk];
            }
            float expect = Bf16ToFloat(FloatToBf16((float)acc));  // 与硬件 F322BF16 同网格
            float got = Bf16ToFloat(cHost[(size_t)i * n + j]);
            const double tol = 1e-2 * fabs(expect) + absTolBase * rowMaxA[i] * rowMaxB[j];
            const double relDiff = fabs(got - expect) / (fabs(expect) > 1.0 ? fabs(expect) : 1.0);
            if (relDiff > maxRelDiff) maxRelDiff = relDiff;
            if (fabs(got - expect) > tol) {
                printf("[M1][FAIL] %s m=%u C[%u][%u] got %f expect %f (tol %f)\n",
                    shape.name, m, i, j, got, expect, tol);
                pass = false;
                if (++failCount >= 5) break;
            }
        }
    }
    printf("[M1] %s m=%-3u K=%u N=%u : %s (maxRelDiff %.2e, fails shown %u)\n", shape.name, m, k, n,
        pass ? "PASS" : "FAIL", maxRelDiff, failCount);

    delete[] aFull;
    delete[] bFull;
    delete[] rowMaxA;
    delete[] rowMaxB;
    aclrtFree(aDev); aclrtFreeHost(aHost);
    aclrtFree(asDev); aclrtFreeHost(asHost);
    aclrtFree(bDev); aclrtFreeHost(bHost);
    aclrtFree(bsDev); aclrtFreeHost(bsHost);
    aclrtFree(cDev); aclrtFreeHost(cHost);
    return pass;
}

int32_t main()
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const GemmShape shapes[] = {
        {"down_proj  (K=640  N=2560)", 640, 2560, 25.298221281347036},
        {"gate_up_pr (K=2560 N=1280)", 2560, 1280, 50.59644260968681},
    };
    // 覆盖：最小 m、单分形内、非 16 对齐尾块、中等 m、满 tile
    const uint32_t ms[] = {1, 2, 17, 128, 256};

    bool allOk = true;
    for (const auto& shape : shapes) {
        for (uint32_t m : ms) {
            allOk &= RunCase(stream, shape, m);
        }
    }
    printf("[M1] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
