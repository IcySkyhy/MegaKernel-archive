/**
 * m7_router_topk.asc —— Mega kernel M7：Router softmax topk（纯 AIV 核）
 * （设计约束见 docs/05-megakernel-design.md；donor：ops-transformer/moe/
 *  moe_gating_top_k_softmax_v2 arch35 perf 档 TopKFP32Perf 的 Sort32 路线 +
 *  UpdateSoftmax 基础 Adds/Exp/Muls + renorm 1/sum；被禁点改造：
 *  TQue DB=2 -> BufferID ping-pong、SetFlag/WaitFlag -> BufferID、
 *  SoftMax<> 高阶 API -> softmax_v2 的 RegBase Max/Sub/Exp 序列）
 *
 * 路由语义（M4 已定，CPU golden = tools/golden/moe_block_ref.py::router_topk）：
 *   logits  = x[m,2560] @ router_w[512,2560]^T        (bf16 输入，fp32 累加)
 *   scores  = softmax(logits) 行级（max-shift、exp；除 sum 与 renorm 抵消，
 *             kernel 内直接对 e_i = exp(l_i - max) 排序/归一）
 *   topk    = scores 降序 top-10；并列取小 expert id
 *   weights = topk scores 按 norm_topk_prob 归一（除以 top-10 的 sum），bf16 输出
 * 输出：logits [m,512] fp32 + topk_ids [m,10] int32 + topk_weights [m,10] bf16。
 * m 运行时 1..64，单 AIV 核内按 16 行 row-block 循环（最多 4 块）。
 *
 * 数据通路（全部基础 API + 指令级 intrinsic，无 TPipe/TBuf/TQue/AllocTensor）：
 *   GM --DataCopy(MTE2)--> UB(x/w bf16) --Reg LoadAlign(UNPACK)/Cast/MulAddDst-->
 *   fp32 累加 --> logits(UB) --Reg Max/Sub/Exp--> e_i(UB) --Sort32--> 16 路
 *   有序块 --MrgSort 2 路归并树 15 次--> 全序 512 对 --Reg DINTLV（Extract 的 VF 内联）-->
 *   top10 (val,idx) --Reg Div/renorm/Cast--> bf16 --DataCopy/DataCopyPad(MTE3)--> GM
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal，release 用阻塞释放，
 * mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK，阻塞至落地保证跨 pipe 可见）：
 *   BUF_X(0) x row-block MTE2->V；BUF_W0(1)/BUF_W1(2) w 行 ping-pong MTE2->V；
 *   BUF_LOG(3) logits/scores V->MTE3；BUF_TOP(4) ids/weights staging V->MTE3。
 *
 * GEMV 形态（任务书允许自选）：SmallGEMV 用向量 MAC（非 cube）。m<=64 的 router
 * 是带宽受限 GEMV（权重 2.6MB 流式），单 AIV 内 fp32 FMA（MulAddDst）即可完成，
 * 免 AIC 参与与跨核同步；权重按行流式预转 fp32，4 专家一组共享 x 载入，
 * 点积以 StoreUnAlign 连续 4 float 写出（非 32B 对齐 StoreAlign 会 507035）。
 *
 * topk 算法（donor Sort32 路线的 k=10 精确版）：Sort32 得 16 个 32 对有序块，
 * 8+4+2+1 次 2 路全量归并（validBit=0b0011，elementLengths=32）得全序 512 对，
 * 取前 64 对（Extract 的 VF 内联，见 §"前 64 对拆分"），top-10 严格精确。
 * Sort32/MrgSort 是**裁定例外**（memory-based，Reg 侧无等价物 + 官方 donor 同形），
 * 依据见两处调用点注释与 README §"向量 API 合规"；旧的「4 路 MrgSort 丢 index」
 * 表述已由 docs/05 §6.3 #19 取代（真因是当年调了 deprecated 的 MrgSort4）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <ctime>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

// ---------------- 编译期常量 ----------------
constexpr uint32_t HIDDEN = 2560;   // router K
constexpr uint32_t E = 512;         // 专家数
constexpr uint32_t KTOPK = 10;
constexpr uint32_t RB = 16;         // row-block（m<=64 -> 最多 4 块）
constexpr uint32_t VLF = 64;        // 256B 向量寄存器 fp32 lane 数
constexpr uint32_t KCHUNK = 64;     // GEMV K 分步：UNPACK 载入 + Cast = 64 连续 fp32
constexpr uint32_t NCHUNK = HIDDEN / KCHUNK;   // 40
constexpr uint32_t EGRP = 8;        // GEMV 专家分组（共享 x 载入；8 点积拼向量 store）
constexpr uint32_t SORT_BLK = E / 32;          // 16 个 32 块

// ---------------- UB 静态布局（字节偏移，32B 对齐） ----------------
// 末址 UB_END = UB_WS + RB*128*2 = 236032B = 230.5KB < 248KB ⇒ 余量 17.5KB（逐块清单见 README §设计）
constexpr uint32_t UB_XB   = 0;                          // bf16 [RB][2560]   = 80 KB
constexpr uint32_t UB_WB   = UB_XB + RB * HIDDEN * 2;    // bf16 [2][2560] ping-pong = 10 KB
constexpr uint32_t UB_WF   = UB_WB + 2 * HIDDEN * 2;     // fp32 [EGRP][2560] 预转权重 = 80 KB
constexpr uint32_t UB_LOG  = UB_WF + EGRP * HIDDEN * 4;  // fp32 [RB][512] logits = 32 KB
constexpr uint32_t UB_VAL  = UB_LOG + RB * E * 4;        // fp32 [512] e_i = 2 KB
constexpr uint32_t UB_IDX  = UB_VAL + E * 4;             // u32  [512] arange 模板 = 2 KB
constexpr uint32_t UB_TMP  = UB_IDX + E * 4;             // fp32 [1024] Sort32 对 = 4 KB
constexpr uint32_t UB_MA   = UB_TMP + 1024 * 4;          // fp32 [1024] 归并缓冲 A = 4 KB
constexpr uint32_t UB_MB   = UB_MA + 1024 * 4;           // fp32 [1024] 归并缓冲 B = 4 KB
constexpr uint32_t UB_OUTV = UB_MB + 1024 * 4;           // fp32 [64] Extract 值 = 256 B
constexpr uint32_t UB_OUTI = UB_OUTV + 64 * 4;           // u32  [64] Extract 索引 = 256 B
constexpr uint32_t UB_IDS  = UB_OUTI + 64 * 4;           // i32  [RB][128] 行 staging = 8 KB
constexpr uint32_t UB_WS   = UB_IDS + RB * 128 * 4;      // bf16 [RB][128] 行 staging = 4 KB
static_assert(UB_WS + RB * 128 * 2 <= 248 * 1024, "UB footprint exceeds 248KB");

// ---------------- BufferID ----------------
constexpr AscendC::MutexID BUF_X = 0;    // x row-block: MTE2 -> V
constexpr AscendC::MutexID BUF_W0 = 1;   // w 行 ping: MTE2 -> V
constexpr AscendC::MutexID BUF_W1 = 2;   // w 行 pong: MTE2 -> V
constexpr AscendC::MutexID BUF_LOG = 3;  // logits/scores: V -> MTE3
constexpr AscendC::MutexID BUF_TOP = 4;  // ids/weights: V -> MTE3

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);  // 阻塞释放（mode=false）：本 pipe 已发射访存落地后释放
}

constexpr CastTrait castTraitBf16ToF32 = {RegLayout::ZERO, SatMode::UNKNOWN,
                                          MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
constexpr CastTrait castTraitF32ToBf16 = {RegLayout::ZERO, SatMode::NO_SAT,
                                          MaskMergeMode::ZEROING, RoundMode::CAST_RINT};

template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

// ============================================================
// Kernel 实现
// ============================================================
class RouterTopk {
public:
    __aicore__ inline RouterTopk() {}

    __aicore__ inline void Init(__gm__ uint16_t* x, __gm__ uint16_t* w,
                                __gm__ uint16_t* logits, __gm__ int32_t* ids,
                                __gm__ uint16_t* weights, uint32_t m)
    {
        M = m;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M) * HIDDEN);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(w), static_cast<uint64_t>(E) * HIDDEN);
        logitsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(logits), static_cast<uint64_t>(M) * E);
        idsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ids), static_cast<uint64_t>(M) * KTOPK);
        weightsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(weights), static_cast<uint64_t>(M) * KTOPK);
    }

    __aicore__ inline void Process()
    {
        BuildIndexTemplate();
        const uint32_t nblk = (M + RB - 1) / RB;
        for (uint32_t b = 0; b < nblk; ++b) {
            const uint32_t b0 = b * RB;
            const uint32_t rows = (M - b0 < RB) ? (M - b0) : RB;
            CopyInX(b0, rows);
            Gemv(rows);
            for (uint32_t r = 0; r < rows; ++r) {
                SoftmaxTopkRenormRow(r);
            }
            CopyOut(b0, rows);
        }
    }

private:
    // ---- arange 索引模板（0..511），整个 kernel 建一次（同 pipe 串行，无需 BufferID） ----
    __aicore__ inline void BuildIndexTemplate()
    {
        // 3510 实测 Reg::Arange 只填 64 lane（fp32 VL），int32 128-lane 寄存器高 64 为 0，
        // 按 64-lane 分 8 块建模板（0..511），否则 idx%128∈[64,128) 的 expert id 全丢成 0
        __VEC_SCOPE__
        {
            uint32_t cnt64 = 64;
            MaskReg m64 = UpdateMask<int32_t>(cnt64);
            for (uint16_t c = 0; c < static_cast<uint16_t>(E / 64); ++c) {
                RegTensor<int32_t> rg;
                Arange(rg, static_cast<int32_t>(c * 64));
                StoreAlign((__ubuf__ int32_t*)(UB_IDX) + c * 64, rg, m64);
            }
        }
    }

    // ---- MTE2：x row-block 搬入（每行 5120B 一次拷贝，bf16 切片寻址） ----
    __aicore__ inline void CopyInX(uint32_t b0, uint32_t rows)
    {
        BufAcquire<PIPE_MTE2>(BUF_X);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> xT = MkT<bfloat16_t>(UB_XB + r * HIDDEN * 2, HIDDEN);
            DataCopy(xT, xGm[(b0 + r) * HIDDEN], HIDDEN);
        }
        BufRelease<PIPE_MTE2>(BUF_X);
    }

    // ---- MTE2：预取 w 行到 ping/pong（bf16 切片寻址） ----
    __aicore__ inline void LoadW(uint32_t e, uint32_t bufSel)
    {
        if (e >= E) return;
        if (bufSel == 0) {
            BufAcquire<PIPE_MTE2>(BUF_W0);
            LocalTensor<bfloat16_t> wT = MkT<bfloat16_t>(UB_WB, HIDDEN);
            DataCopy(wT, wGm[e * HIDDEN], HIDDEN);
            BufRelease<PIPE_MTE2>(BUF_W0);
        } else {
            BufAcquire<PIPE_MTE2>(BUF_W1);
            LocalTensor<bfloat16_t> wT = MkT<bfloat16_t>(UB_WB + HIDDEN * 2, HIDDEN);
            DataCopy(wT, wGm[e * HIDDEN], HIDDEN);
            BufRelease<PIPE_MTE2>(BUF_W1);
        }
    }

    // ---- V：w 行 bf16 -> fp32 预转（UNPACK 载入 + Cast，64 元素/步） ----
    __aicore__ inline void PrecastW(uint32_t bufSel, uint32_t slot)
    {
        const uint32_t srcOff = (bufSel == 0) ? UB_WB : (UB_WB + HIDDEN * 2);
        __ubuf__ bfloat16_t* wSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(srcOff);
        __ubuf__ float* wDst = reinterpret_cast<__ubuf__ float*>(UB_WF + slot * HIDDEN * 4);
        __VEC_SCOPE__
        {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t c = 0; c < static_cast<uint16_t>(NCHUNK); ++c) {
                RegTensor<bfloat16_t> b0;
                RegTensor<float> f0;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(b0, wSrc + c * KCHUNK);
                Cast<float, bfloat16_t, castTraitBf16ToF32>(f0, b0, full);
                StoreAlign(wDst + c * KCHUNK, f0, full);
            }
        }
    }

    // ---- 8 专家点积（1 行 x WF[0..7]）：40 步 UNPACK+Cast+fp32 MAC，8 路归约后 ----
    // 用 Interleave 树拼成 8 连续 lane，mask=8 StoreAlign 写 logP（32B 对齐，被禁写法之外的
    // 非对齐 StoreAlign 会 507035；StoreUnAlign 是整寄存器写会踩踏邻区，都不用）
    __aicore__ inline void Dot8Row(__ubuf__ bfloat16_t* xSrc, __ubuf__ float* logP)
    {
        __VEC_SCOPE__
        {
            RegTensor<float> a0, a1, a2, a3, a4, a5, a6, a7;
            RegTensor<float> xf, wf0, wf1, wf2, wf3, wf4, wf5, wf6, wf7;
            RegTensor<float> i01, i23, i45, i67, j0, j1, j2, j3, v, vv;
            RegTensor<float> s;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(a0, 0.0f); Duplicate(a1, 0.0f); Duplicate(a2, 0.0f); Duplicate(a3, 0.0f);
            Duplicate(a4, 0.0f); Duplicate(a5, 0.0f); Duplicate(a6, 0.0f); Duplicate(a7, 0.0f);
            for (uint16_t c = 0; c < static_cast<uint16_t>(NCHUNK); ++c) {
                RegTensor<bfloat16_t> xb;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(xb, xSrc + c * KCHUNK);
                Cast<float, bfloat16_t, castTraitBf16ToF32>(xf, xb, full);
                const uint32_t off = c * KCHUNK;
                LoadAlign(wf0, reinterpret_cast<__ubuf__ float*>(UB_WF + 0 * HIDDEN * 4) + off);
                LoadAlign(wf1, reinterpret_cast<__ubuf__ float*>(UB_WF + 1 * HIDDEN * 4) + off);
                LoadAlign(wf2, reinterpret_cast<__ubuf__ float*>(UB_WF + 2 * HIDDEN * 4) + off);
                LoadAlign(wf3, reinterpret_cast<__ubuf__ float*>(UB_WF + 3 * HIDDEN * 4) + off);
                LoadAlign(wf4, reinterpret_cast<__ubuf__ float*>(UB_WF + 4 * HIDDEN * 4) + off);
                LoadAlign(wf5, reinterpret_cast<__ubuf__ float*>(UB_WF + 5 * HIDDEN * 4) + off);
                LoadAlign(wf6, reinterpret_cast<__ubuf__ float*>(UB_WF + 6 * HIDDEN * 4) + off);
                LoadAlign(wf7, reinterpret_cast<__ubuf__ float*>(UB_WF + 7 * HIDDEN * 4) + off);
                MulAddDst(a0, xf, wf0, full);
                MulAddDst(a1, xf, wf1, full);
                MulAddDst(a2, xf, wf2, full);
                MulAddDst(a3, xf, wf3, full);
                MulAddDst(a4, xf, wf4, full);
                MulAddDst(a5, xf, wf5, full);
                MulAddDst(a6, xf, wf6, full);
                MulAddDst(a7, xf, wf7, full);
            }
            // 8 路归约 -> Interleave 树拼 [d0..d7]
            Reduce<ReduceType::SUM, float>(a0, a0, full);
            Reduce<ReduceType::SUM, float>(a1, a1, full);
            Reduce<ReduceType::SUM, float>(a2, a2, full);
            Reduce<ReduceType::SUM, float>(a3, a3, full);
            Reduce<ReduceType::SUM, float>(a4, a4, full);
            Reduce<ReduceType::SUM, float>(a5, a5, full);
            Reduce<ReduceType::SUM, float>(a6, a6, full);
            Reduce<ReduceType::SUM, float>(a7, a7, full);
            // Reduce 输出为标量寄存器（lane0 有效）；Interleave 树拼 8 连续 lane
            Interleave(i01, vv, a0, a4);   // [d0,d4]
            Interleave(i23, vv, a2, a6);   // [d2,d6]
            Interleave(i45, vv, a1, a5);   // [d1,d5]
            Interleave(i67, vv, a3, a7);   // [d3,d7]
            Interleave(j0, j1, i01, i23);  // [d0,d2,d4,d6]
            Interleave(j2, j3, i45, i67);  // [d1,d3,d5,d7]
            Interleave(v, vv, j0, j2);     // [d0..d7]
            uint32_t eight = EGRP;
            MaskReg m8 = UpdateMask<float>(eight);
            StoreAlign(logP, v, m8);
        }
    }

    // ---- GEMV：logits[r][e] = sum_k x[r,k]*w[e,k]（fp32 向量 MAC） ----
    __aicore__ inline void Gemv(uint32_t rows)
    {
        BufAcquire<PIPE_V>(BUF_X);
        LoadW(0, 0);
        LoadW(1, 1);
        // 协议：进入每组时 W0=w[e0]、W1=w[e0+1]（上一组尾部预取或初始化）。
        // slot s 预转 w[e0+s]（缓冲 s%2）；每次预转后 MTE2 把 w[e0+s+2] 装入该缓冲
        // （s=6/7 时即下一组的 w[e0+8]/w[e0+9] 预取；e>=E 时空操作）。BufferID 手动展开。
        for (uint32_t e0 = 0; e0 < E; e0 += EGRP) {
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 0);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 2, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 1);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 3, 1);
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 2);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 4, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 3);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 5, 1);
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 4);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 6, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 5);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 7, 1);
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 6);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 8, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 7);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 9, 1);
            // 组内 8 专家 x 全部行：共享 x 载入
            for (uint32_t r = 0; r < rows; ++r) {
                Dot8Row(reinterpret_cast<__ubuf__ bfloat16_t*>(UB_XB + r * HIDDEN * 2),
                        reinterpret_cast<__ubuf__ float*>(UB_LOG + r * E * 4) + e0);
            }
        }
        BufRelease<PIPE_V>(BUF_X);
    }

    // ---- 行内 softmax(max-shift exp) + Sort32 + 2 路归并树 + 前 64 对拆分(Extract VF 内联) + renorm ----
    __aicore__ inline void SoftmaxTopkRenormRow(uint32_t r)
    {
        const uint32_t logOff = UB_LOG + r * E * 4;
        // 1) 行 max；2) e_i = exp(l_i - max) 写入 UB_VAL（softmax 的除 sum 与 renorm 抵消）
        BufAcquire<PIPE_V>(BUF_LOG);
        __VEC_SCOPE__
        {
            RegTensor<float> v, m, mx, dm;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(m, -3.0e38f);
            for (uint16_t c = 0; c < static_cast<uint16_t>(E / VLF); ++c) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(logOff) + c * VLF);
                Max(m, m, v, full);
            }
            Reduce<ReduceType::MAX, float>(mx, m, full);
            Duplicate(dm, mx, full);
            for (uint16_t c = 0; c < static_cast<uint16_t>(E / VLF); ++c) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(logOff) + c * VLF);
                Sub(v, v, dm, full);
                StoreAlign(reinterpret_cast<__ubuf__ float*>(logOff) + c * VLF, v, full);  // logits -= max（对齐 golden 返回）
                Exp(v, v, full);
                StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_VAL) + c * VLF, v, full);
            }
        }
        // 3) Sort32：16 个 32 块内降序（值, 全局 expert id）
        //    例外依据（tower 裁定② = `docs/05` §6.1 **规则 ⓒ**「无寄存器等价物的原语例外」，仅有 Sort32/MrgSort）：
        //    Sort32 在 Reg 侧**无**等价物（CANN 9.1.0 reg_compute 穷举），官方 donor 同为
        //    memory-based（…moe_gating_top_k_softmax_v2_perf_arch35.h:187）⇒ 列入例外；
        //    仅限本 topk 排序段，不得扩散。
        {
            LocalTensor<float> valT = MkT<float>(UB_VAL, E);
            LocalTensor<float> tmpT = MkT<float>(UB_TMP, 2 * E);
            LocalTensor<uint32_t> idxT = MkT<uint32_t>(UB_IDX, E);
            Sort32(tmpT, valT, idxT, SORT_BLK);
        }
        BufRelease<PIPE_V>(BUF_LOG);
        // 4) 2 路归并树 -> 全序 512 对（UB_MB）
        MergeTree();
        // 5) 前 64 对 (value, idx) 拆分：经典 Extract 的 VF 实现内联。抄厂商 dav_3510
        //    ExtractVf 的 repeatTime=2 路径（kernel_operator_vec_gather_mask_impl.h:425-450，
        //    该分支 loopTimes=1/tail=0）：
        //    DIST_DINTLV_B32 一次载入 128 float（值/索引交错），偶 lane=value、奇 lane=idx。
        //    纯 pair 拆分、无算术 ⇒ 与经典 Extract 逐位等价（判据 T1）。
        __VEC_SCOPE__
        {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            RegTensor<float> vr, vi;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            LoadAlign<float, LoadDist::DIST_DINTLV_B32>(vr, vi, reinterpret_cast<__ubuf__ float*>(UB_MB));
            StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_OUTV), vr, full);
            StoreAlign(reinterpret_cast<__ubuf__ uint32_t*>(UB_OUTI), (RegTensor<uint32_t>&)vi, full);
        }
        // 6) renorm（除以 top-10 的 sum）+ bf16 化 + staging 写出
        BufAcquire<PIPE_V>(BUF_TOP);
        __VEC_SCOPE__
        {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            RegTensor<float> vals;
            RegTensor<int32_t> idxs;
            LoadAlign(vals, reinterpret_cast<__ubuf__ float*>(UB_OUTV));
            LoadAlign(idxs, reinterpret_cast<__ubuf__ int32_t*>(UB_OUTI));
            uint32_t cnt10 = KTOPK;
            MaskReg m10 = UpdateMask<float>(cnt10);
            RegTensor<float> s, ds;
            Reduce<ReduceType::SUM, float>(s, vals, m10);
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(ds, s, full);
            Div(vals, vals, ds, m10);
            // fp32->bf16(RNE)：Reg::Cast 一条 + pack 落盘一条（docs/05 §6.1 位宽转换行，M35
            // 确认的规范写法；范本 m8_permute.asc 的 MoeUnpermuteKernel::ComputeRow（行号提示
            // :313-314，行号随代码变动、以符号为准），本仓 m6/m12/m14 同款）。
            // 原手写整数 RNE（(bits+0x7FFF+((bits>>16)&1))>>16）+ DeInterleave 打包是多余
            // 的自造动作（M35 曾因此写出 NaN），已删除；masked（ZEROING）⇒ lane≥10 落 0。
            RegTensor<bfloat16_t> valsB16;
            Cast<bfloat16_t, float, castTraitF32ToBf16>(valsB16, vals, m10);
            MaskReg fullU = CreateMask<float, MaskPattern::ALL>();
            StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(
                reinterpret_cast<__ubuf__ bfloat16_t*>(UB_WS + r * 128 * 2), valsB16, fullU);
            MaskReg fullI = CreateMask<int32_t, MaskPattern::ALL>();
            StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_IDS + r * 128 * 4), idxs, fullI);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRelease<PIPE_V>(BUF_TOP);
    }

    // ---- 2 路归并树（MA/MB 乒乓），输出全序 512 对到 UB_MB ----
    __aicore__ inline void MergeTree()
    {
        LocalTensor<float> srcT = MkT<float>(UB_TMP, 2 * E);
        LocalTensor<float> aT = MkT<float>(UB_MA, 2 * E);
        LocalTensor<float> bT = MkT<float>(UB_MB, 2 * E);
        // 统一 elementLengths=32（3510 实测 2 路 32/64 正确；256 触发 507035）。
        // 每级归并只取输入前 32 对、输出 64 对；对 top-10 严格精确：
        // top-10(并集) ⊆ top-32(各输入) ⊆ 本级输出，归纳成立。
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 8; ++g) {   // level1: 16 块 -> 8 组, TMP -> MA
            Merge2(aT[g * 128], srcT[(2 * g) * 64], srcT[(2 * g + 1) * 64], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 4; ++g) {   // level2: 8 组 -> 4 组, MA -> MB
            Merge2(bT[g * 128], aT[(2 * g) * 128], aT[(2 * g + 1) * 128], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 2; ++g) {   // level3: 4 组 -> 2 组, MB -> MA
            Merge2(aT[g * 128], bT[(2 * g) * 128], bT[(2 * g + 1) * 128], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        Merge2(bT[0], aT[0], aT[128], 32);   // level4: 2 组 -> 1, MA -> MB
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
    }

    // 2 路归并。例外依据（tower 裁定② = `docs/05` §6.1 **规则 ⓒ**「无寄存器等价物的原语例外」，仅有 Sort32/MrgSort）：
    // MrgSort 在 Reg 侧**无**等价物（CANN 9.1.0 reg_compute 穷举），官方 donor 同为
    // memory-based（…moe_gating_top_k_softmax_v2_perf_arch35.h:225/:243）⇒ 列入例外；
    // 仅限本 topk 排序段，不得扩散。统一 validBit=0b0011（2 路）——旧注释援引的「4 路
    // validBit=15 丢 src3/src4 索引」已由 docs/05 §6.3 #19 标为待复核（M23 探针归因：当年
    // 调的是 MrgSort4，该 API 在 dav-3510 上是 deprecated 空函数体；改用 MrgSort 后正确）。
    __aicore__ inline void Merge2(const LocalTensor<float>& dst, const LocalTensor<float>& s1,
                                  const LocalTensor<float>& s2, uint32_t pairLen)
    {
        MrgSort4Info params;
        params.elementLengths[0] = static_cast<uint16_t>(pairLen);
        params.elementLengths[1] = static_cast<uint16_t>(pairLen);
        params.elementLengths[2] = 0;
        params.elementLengths[3] = 0;
        params.validBit = 0b0011;
        params.repeatTimes = 1;
        params.ifExhaustedSuspension = false;
        MrgSortSrcList<float> sl;
        sl.src1 = s1;
        sl.src2 = s2;
        sl.src3 = s2;
        sl.src4 = s2;
        MrgSort(dst, sl, params);
    }

    // ---- MTE3：logits + ids + weights 写出（GM 一律 bf16 位视图寻址） ----
    __aicore__ inline void CopyOut(uint32_t b0, uint32_t rows)
    {
        BufAcquire<PIPE_MTE3>(BUF_LOG);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> lT = MkT<bfloat16_t>(UB_LOG + r * E * 4, E * 2);
            DataCopy(logitsGm[(b0 + r) * E * 2], lT, E * 2);
        }
        BufRelease<PIPE_MTE3>(BUF_LOG);
        BufAcquire<PIPE_MTE3>(BUF_TOP);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> iT = MkT<bfloat16_t>(UB_IDS + r * 128 * 4, KTOPK * 2);
            DataCopyPad(idsGm[(b0 + r) * KTOPK * 2], iT, DataCopyExtParams{1, KTOPK * 4, 0, 0, 0});
            LocalTensor<bfloat16_t> wT = MkT<bfloat16_t>(UB_WS + r * 128 * 2, KTOPK);
            DataCopyPad(weightsGm[(b0 + r) * KTOPK], wT, DataCopyExtParams{1, KTOPK * 2, 0, 0, 0});
        }
        BufRelease<PIPE_MTE3>(BUF_TOP);
    }

private:
    uint32_t M;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<bfloat16_t> wGm;
    GlobalTensor<bfloat16_t> logitsGm;   // fp32 数据的 bf16 位视图
    GlobalTensor<bfloat16_t> idsGm;      // int32 数据的 bf16 位视图
    GlobalTensor<bfloat16_t> weightsGm;
};

} // namespace

__vector__ __global__ void router_topk_kernel(__gm__ uint16_t* x, __gm__ uint16_t* w,
                                              __gm__ uint16_t* logits, __gm__ int32_t* ids,
                                              __gm__ uint16_t* weights, uint32_t m)
{
    RouterTopk op;
    op.Init(x, w, logits, ids, weights, m);
    op.Process();
}

// ============================================================
// Host 侧：确定性输入 + kernel 运行 + 读回 + 自检 + dump
// ============================================================

static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

// 确定性伪随机（与 m2 的 Hash3 同风格）
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// 确定性 bf16 激活：指数窗 [122,132)（值域 ~[2^-5, 32]，贴近真实 RMSNorm 后激活），
// 随机符号/尾数。注意：过宽的动态范围会使 softmax 分数大量下溢成 0.0 而产生
// 大规模并列——硬件 Sort32/MrgSort 对同值对的次序不做 index tie-break（与 CANN
// donor op 一致），并列场景次序不保证；真实路由数据（logits ~±20）无此问题。
static void GenActivations(uint16_t* x, uint32_t m, uint32_t seed)
{
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const uint32_t h = Hash3(i, j, seed);
            const uint32_t exp = 122 + (h % 10);
            x[static_cast<size_t>(i) * HIDDEN + j] =
                static_cast<uint16_t>(((h >> 8) & 0x8000) | (exp << 7) | ((h >> 9) & 0x7F));
        }
    }
}

// ---- host 浮点参考：语义同 moe_block_ref.router_topk ----
static void RefRouterTopk(const uint16_t* x, const uint16_t* w, uint32_t m,
                          float* logits, int32_t* ids, float* wgt)
{
    for (uint32_t r = 0; r < m; ++r) {
        float* lr = logits + static_cast<size_t>(r) * E;
        for (uint32_t e = 0; e < E; ++e) {
            float acc = 0.f;
            for (uint32_t k = 0; k < HIDDEN; ++k) {
                acc += Bf16ToF32(x[static_cast<size_t>(r) * HIDDEN + k]) *
                       Bf16ToF32(w[static_cast<size_t>(e) * HIDDEN + k]);
            }
            lr[e] = acc;
        }
        float mx = lr[0];
        for (uint32_t e = 1; e < E; ++e) mx = fmaxf(mx, lr[e]);
        for (uint32_t e = 0; e < E; ++e) lr[e] -= mx;   // 与 moe_block_ref 返回一致（max-shift）
        float sum = 0.f;
        float sc[E];
        for (uint32_t e = 0; e < E; ++e) { sc[e] = expf(lr[e]); sum += sc[e]; }
        (void)sum;
        bool used[E] = {};
        float ws[KTOPK];
        for (uint32_t t = 0; t < KTOPK; ++t) {   // 稳定选择：严格大于 -> 并列取小 id
            int bi = -1;
            for (uint32_t e = 0; e < E; ++e) {
                if (used[e]) continue;
                if (bi < 0 || sc[e] > sc[static_cast<uint32_t>(bi)]) bi = static_cast<int>(e);
            }
            used[bi] = true;
            ids[static_cast<size_t>(r) * KTOPK + t] = bi;
            ws[t] = sc[bi];
        }
        float wsum = 0.f;
        for (uint32_t t = 0; t < KTOPK; ++t) wsum += ws[t];
        for (uint32_t t = 0; t < KTOPK; ++t)
            wgt[static_cast<size_t>(r) * KTOPK + t] = ws[t] / wsum;
    }
}

static int Bf16UlpDiff(uint16_t a, uint16_t b)
{
    const int d = static_cast<int>(a) - static_cast<int>(b);
    return d >= 0 ? d : -d;
}

static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

static void WriteJson(const char* path, const char* tensor, const char* shape, const char* dtype,
                      uint32_t elemSize, size_t sizeBytes)
{
    char full[512];
    snprintf(full, sizeof(full), "%s.json", path);
    FILE* f = fopen(full, "w");
    if (f == nullptr) return;
    fprintf(f, "{\n  \"tensor\": \"%s\",\n  \"shape\": %s,\n  \"dtype\": \"%s\",\n", tensor, shape, dtype);
    fprintf(f, "  \"elem_size\": %u,\n  \"byte_order\": \"little\",\n  \"size_bytes\": %zu\n}\n",
            elemSize, sizeBytes);
    fclose(f);
}

static bool RunCase(aclrtStream stream, const uint16_t* wHost, uint32_t m, uint32_t seed,
                    const char* outDir)
{
    const size_t xBytes = static_cast<size_t>(m) * HIDDEN * 2;
    const size_t logBytes = static_cast<size_t>(m) * E * 4;
    const size_t idsBytes = static_cast<size_t>(m) * KTOPK * 4;
    const size_t wBytes = static_cast<size_t>(m) * KTOPK * 2;

    uint16_t* xHost = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&xHost), xBytes);
    GenActivations(xHost, m, seed);
    float* logHost = nullptr;
    int32_t* idsHost = nullptr;
    uint16_t* wHostDev = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&logHost), logBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&idsHost), idsBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&wHostDev), wBytes);
    uint16_t *xDev = nullptr, *wDev = nullptr, *logDev = nullptr, *wDevOut = nullptr;
    int32_t* idsDev = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&xDev), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&wDev), static_cast<size_t>(E) * HIDDEN * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&logDev), logBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&idsDev), idsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&wDevOut), wBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDev, xBytes, xHost, xBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wDev, static_cast<size_t>(E) * HIDDEN * 2, wHost,
                static_cast<size_t>(E) * HIDDEN * 2, ACL_MEMCPY_HOST_TO_DEVICE);

    router_topk_kernel<<<1, 0, stream>>>(xDev, wDev, logDev, idsDev, wDevOut, m);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M7][FAIL] m=%u seed=%u kernel launch/sync error %d\n", m, seed, static_cast<int>(launchErr));
        aclrtFree(xDev); aclrtFreeHost(xHost);
        aclrtFree(wDev); aclrtFree(logDev); aclrtFreeHost(logHost);
        aclrtFree(idsDev); aclrtFreeHost(idsHost);
        aclrtFree(wDevOut); aclrtFreeHost(wHostDev);
        return false;
    }
    aclrtMemcpy(logHost, logBytes, logDev, logBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(idsHost, idsBytes, idsDev, idsBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(wHostDev, wBytes, wDevOut, wBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    if (outDir != nullptr) {
        char p[512];
        snprintf(p, sizeof(p), "%s/x.bin", outDir); WriteBin(p, xHost, xBytes);
        char shapeBuf[64];
        snprintf(shapeBuf, sizeof(shapeBuf), "[%u, 2560]", m);
        WriteJson(p, "x.bin", shapeBuf, "bf16", 2, xBytes);
        snprintf(p, sizeof(p), "%s/router_weight.bin", outDir);
        WriteBin(p, wHost, static_cast<size_t>(E) * HIDDEN * 2);
        WriteJson(p, "router_weight.bin", "[512, 2560]", "bf16", 2, static_cast<size_t>(E) * HIDDEN * 2);
        snprintf(p, sizeof(p), "%s/router_logits.bin", outDir); WriteBin(p, logHost, logBytes);
        snprintf(shapeBuf, sizeof(shapeBuf), "[%u, 512]", m);
        WriteJson(p, "router_logits.bin", shapeBuf, "fp32", 4, logBytes);
        snprintf(p, sizeof(p), "%s/topk_ids.bin", outDir); WriteBin(p, idsHost, idsBytes);
        snprintf(shapeBuf, sizeof(shapeBuf), "[%u, 10]", m);
        WriteJson(p, "topk_ids.bin", shapeBuf, "int32", 4, idsBytes);
        snprintf(p, sizeof(p), "%s/topk_weights.bin", outDir); WriteBin(p, wHostDev, wBytes);
        WriteJson(p, "topk_weights.bin", shapeBuf, "bf16", 2, wBytes);
    }

    float* refLog = new float[static_cast<size_t>(m) * E];
    int32_t* refIds = new int32_t[static_cast<size_t>(m) * KTOPK];
    float* refW = new float[static_cast<size_t>(m) * KTOPK];
    RefRouterTopk(xHost, wHost, m, refLog, refIds, refW);

    uint32_t fail = 0;
    float maxRel = 0.f;
    for (size_t i = 0; i < static_cast<size_t>(m) * E; ++i) {
        const float d = fabsf(logHost[i] - refLog[i]);
        const float rel = d / (fabsf(refLog[i]) + 1e-6f);
        if (rel > maxRel) maxRel = rel;
        if (d > 1e-2f && rel > 1e-2f) {   // max-shift 后近零值 rel 失真，以绝对误差为准
            if (fail < 5) printf("[M7][FAIL] m=%u seed=%u logits[%zu] got %f want %f\n", m, seed, i, logHost[i], refLog[i]);
            ++fail;
        }
    }
    uint32_t idFail = 0;
    for (size_t i = 0; i < static_cast<size_t>(m) * KTOPK; ++i) {
        if (idsHost[i] != refIds[i]) {
            if (idFail < 5) printf("[M7][FAIL] m=%u seed=%u ids[%zu] got %d want %d\n", m, seed, i, idsHost[i], refIds[i]);
            ++idFail;
        }
    }
    uint32_t wFail = 0;
    int maxUlp = 0;
    for (size_t i = 0; i < static_cast<size_t>(m) * KTOPK; ++i) {
        const uint16_t want = F32ToBf16(refW[i]);
        const int ulp = Bf16UlpDiff(wHostDev[i], want);
        if (ulp > maxUlp) maxUlp = ulp;
        if (ulp > 1) {
            if (wFail < 5) printf("[M7][FAIL] m=%u seed=%u w[%zu] got 0x%04x want 0x%04x (ulp %d)\n",
                                  m, seed, i, wHostDev[i], want, ulp);
            ++wFail;
        }
    }
    const bool pass = (fail == 0) && (idFail == 0) && (wFail == 0);
    printf("[M7] m=%-3u seed=%u : %s | logits maxRel=%.2e ids %s weights maxUlp=%d %s\n", m, seed,
           pass ? "PASS" : "FAIL", maxRel, idFail == 0 ? "exact" : "MISMATCH", maxUlp,
           wFail == 0 ? "bf16-grid-ok" : "MISMATCH");

    delete[] refLog; delete[] refIds; delete[] refW;
    aclrtFree(xDev); aclrtFreeHost(xHost);
    aclrtFree(wDev); aclrtFree(logDev); aclrtFreeHost(logHost);
    aclrtFree(idsDev); aclrtFreeHost(idsHost);
    aclrtFree(wDevOut); aclrtFreeHost(wHostDev);
    return pass;
}

static bool LoadRouterWeight(const char* path, uint16_t* w)
{
    FILE* f = fopen(path, "rb");
    if (f == nullptr) return false;
    const size_t n = fread(w, 1, static_cast<size_t>(E) * HIDDEN * 2, f);
    fclose(f);
    return n == static_cast<size_t>(E) * HIDDEN * 2;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc; (void)argv;
    const char* wPath = getenv("M7_ROUTER_W");
    if (wPath == nullptr) wPath = "m7_router_topk/data/router_weight.bin";
    const char* outDir = getenv("M7_OUT");   // 设置则逐 case dump bin 供 check_ref.py

    static uint16_t wHost[E * HIDDEN];
    if (!LoadRouterWeight(wPath, wHost)) {
        printf("[M7][FAIL] cannot load router weight %s\n", wPath);
        return 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool allOk = true;
    // 任务书要求：m=1 与 m=33；补充 m=2/16/64 覆盖动态 m 与 row-block 边界
    const uint32_t ms[] = {1, 2, 16, 33, 64};
    for (uint32_t m : ms) {
        const char* od = nullptr;
        char dir[512];
        if (outDir != nullptr) {
            snprintf(dir, sizeof(dir), "%s/m%u", outDir, m);
            char cmd[600];
            snprintf(cmd, sizeof(cmd), "mkdir -p %s", dir);
            if (system(cmd) != 0) { printf("[M7][FAIL] mkdir %s\n", dir); return 1; }
            od = dir;
        }
        allOk &= RunCase(stream, wHost, m, 7, od);
    }
    printf("[M7] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
