/**
 * m10_mmadprobe.asc —— mmad k 方向累加精度标定探针（AIC-only，最小迭代）
 *
 * 目的（M24 第九轮，tower 要求）：标定 `Mmad` 在 **k 方向累加**时的精度，用于给
 * `|out − ref| ≤ ε_total·Σ|acc·w|` 的解析界补上 mmad 项。
 *
 * 方法：A = 全 1（bf16 精确），B[n][k] 用 5 种**已知精确可表示**的分布，k ∈ {64,128,256}：
 *   d0 ones    : B = 1                    ⇒ C = k                     （恒真自检）
 *   d1 incr    : B = 1 + (k%16)·2^-11     ⇒ C = Σ_k(...) 精确可表示    （无相消的累加）
 *   d2 alt±1   : B = +1/−1 交替           ⇒ C = 0                     （完全相消）
 *   d3 absorb  : B[0]=2^15, B[k>0]=2^-24  ⇒ C = 2^15 + (k−1)·2^-24     （吸收性 ⇒ 暴露累加器位宽/归约顺序）
 *   d4 rand    : Hash3 伪随机 ∈ [−1,1]    ⇒ 与 fp64 参考比
 * 参考 = numpy **fp64**（A/B 都是 bf16 精确值，故参考本身无舍入）。
 * 判据数字：绝对误差、以及在"部分和量级"（=Σ|该项| / k 的 fp32 ulp 尺度）上的相对误差。
 *
 * 用法：./m10_mmadprobe            # 打印 15 组 conf 的误差表
 */
#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <cmath>

namespace mmp {
using namespace AscendC;

constexpr uint32_t M_DIM = 16;
constexpr uint32_t K_MAX = 256;
constexpr uint32_t N_DIM = 256;
constexpr uint32_t NDIST = 10;
constexpr uint32_t NKS = 1;
constexpr uint32_t NK[3] = {256, 128, 256};   // k=256 先用**主核已验证的 A(1,16,1,1)/B(16,16,16,16) 组合**起跑，
                                              // 跑通后再把 NKS 改成 2 加回 k=128（一次只加一个维度）

constexpr uint32_t L1_A = 24576;                            // A [16,256] bf16 = 8KB（= 主核 L1_OFF_Q，已验证的 L1 偏移）
constexpr uint32_t L1_B = 32768;                            // B [256,256] bf16 = 128KB（= 主核 L1_OFF_KV0）
constexpr uint32_t L0C_BYTES = M_DIM * N_DIM * 4;           // 16KB per conf

__aicore__ __inline__ void LoadL0A2D(const LocalTensor<uint8_t>& l0, const LocalTensor<uint8_t>& l1, uint32_t kStep)
{
    LoadData2DParamsV2 lp;
    lp.mStartPosition = 0;
    lp.kStartPosition = 0;
    lp.mStep = 1;
    lp.kStep = (uint16_t)kStep;
    lp.srcStride = 1;
    lp.dstStride = 1;
    lp.ifTranspose = false;
    lp.sid = 0;
    LoadData(l0.template ReinterpretCast<bfloat16_t>(), l1.template ReinterpretCast<bfloat16_t>(), lp);
}

// B[256,256] 行=n、列=k（与 m11 LoadB / M24 BMM1 的 B 侧已验证形态一致）
// ★ 单次装载的 L0B 占用 = (N_DIM/16)·kStep·512B：kStep=8 ⇒ 16·8·512B = 64KB（= L0B 容量上限，合法）；
//   kStep=16（一次装满 K=256）⇒ 128KB > 64KB ⇒ AICore exception **507015**。
//   故 B 必须按 k=128 半块分两次装载（主核 BMM1 同款拆分），源偏移 = ks·(128/16)·N_DIM·16 元素。
__aicore__ __inline__ void LoadL0B2D(const LocalTensor<uint8_t>& l0, const LocalTensor<uint8_t>& l1,
                                     uint32_t l1ElemOff, uint32_t kStep)
{
    LoadData2DParamsV2 lp;
    lp.mStartPosition = 0;
    lp.kStartPosition = 0;
    lp.mStep = N_DIM / 16;
    lp.kStep = (uint16_t)kStep;
    lp.srcStride = N_DIM / 16;
    lp.dstStride = N_DIM / 16;
    lp.ifTranspose = false;
    lp.sid = 0;
    LoadData(l0.template ReinterpretCast<bfloat16_t>(),
             l1.template ReinterpretCast<bfloat16_t>()[l1ElemOff], lp);
}

__global__ __cube__ void mmadprobe_kernel(__gm__ uint8_t* aGm, __gm__ uint8_t* bGm, __gm__ uint8_t* cGm)
{
    AscendC::InitSocState();
    printf("[MMADPROBE] kernel enter (bid=%u)\n", (uint32_t)GetBlockIdx());
    LocalTensor<uint8_t> l1a(TPosition::A1, L1_A, M_DIM * K_MAX * 2);
    LocalTensor<uint8_t> l1b(TPosition::B1, L1_B, K_MAX * N_DIM * 2);
    LocalTensor<uint8_t> l0a(TPosition::A2, 0, 64 * 1024);
    LocalTensor<uint8_t> l0b(TPosition::B2, 0, 64 * 1024);
    LocalTensor<uint8_t> l0c(TPosition::CO1, 0, L0C_BYTES);

    GlobalTensor<uint8_t> aG, bG;
    aG.SetGlobalBuffer(aGm);
    bG.SetGlobalBuffer(bGm);

    {   // A：16×256 全 1；B：d0 分布先搬一份，之后每个 dist 重新搬
        Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = M_DIM;
        par.dValue = K_MAX;
        par.srcNdMatrixStride = 0;
        par.srcDValue = K_MAX;
        par.dstNzC0Stride = M_DIM;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        DataCopy(l1a.template ReinterpretCast<bfloat16_t>(), aG.template ReinterpretCast<bfloat16_t>(), par);
        PipeBarrier<PIPE_MTE2>();
        printf("[MMADPROBE] A Nd2Nz done\n");
    }

    uint32_t conf = 0;
    for (uint32_t d = 0; d < NDIST; ++d) {
        {   // B 的该分布：GM 里 5 个 blob 顺序排布，每个 [256,256]
            Nd2NzParams par;
            par.ndNum = 1;
            par.nValue = N_DIM;
            par.dValue = K_MAX;
            par.srcNdMatrixStride = 0;
            par.srcDValue = K_MAX;
            par.dstNzC0Stride = N_DIM;
            par.dstNzNStride = 1;
            par.dstNzMatrixStride = 0;
            DataCopy(l1b.template ReinterpretCast<bfloat16_t>(),
                     bG.template ReinterpretCast<bfloat16_t>()[(uint64_t)d * N_DIM * K_MAX], par);
            PipeBarrier<PIPE_MTE2>();
            printf("[MMADPROBE] B Nd2Nz done d=%u\n", d);
        }
        for (uint32_t ki = 0; ki < NKS; ++ki, ++conf) {
            const uint32_t k = NK[ki];
            // A [16,256] 一次装好（kStep=16，与主核 Q/P 装载同形态）；L0A 占用 1·16·512B = 8KB
            LoadL0A2D(l0a, l1a, K_MAX / 16);
            // B 拆 k=128 半块：每块 16·8·512B = 64KB（L0B 容量上限），mmad 也相应按 k=128 两次
            for (uint32_t ks = 0; ks * 128 < k; ++ks) {
                LoadL0B2D(l0b, l1b, ks * (128 / 16) * N_DIM * 16, 128 / 16);
                PipeBarrier<PIPE_ALL>();   // 试：PIPE_MTE1 单管道栅栏不保证跨 pipe 可见性（主核用 BufferID 交接）
                printf("[MMADPROBE] L0 loaded d=%u k=%u ks=%u\n", d, k, ks);
                MmadParams mp;
                mp.m = (uint16_t)M_DIM;
                mp.n = (uint16_t)N_DIM;
                mp.k = 128;
                mp.cmatrixInitVal = (ks == 0);
                mp.cmatrixSource = false;
                Mmad(l0c.template ReinterpretCast<float>(),
                     l0a.template ReinterpretCast<bfloat16_t>()[ks * (M_DIM * 128)],
                     l0b.template ReinterpretCast<bfloat16_t>(), mp);
                PipeBarrier<PIPE_M>();
            }
            GlobalTensor<float> dst;
            dst.SetGlobalBuffer((__gm__ float*)cGm + (uint64_t)conf * M_DIM * N_DIM);
            FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
            fp.nSize = (uint16_t)N_DIM;
            fp.mSize = (uint16_t)M_DIM;
            fp.srcStride = (uint16_t)M_DIM;
            fp.dstStride = N_DIM;
            fp.reluScalar = 0;
            fp.vectorRelu = 0;
            fp.deqScalar = 0;
            static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
            Fixpipe<float, float, kFixGm>(dst, l0c.template ReinterpretCast<float>(), fp);
            PipeBarrier<PIPE_FIX>();
        }
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace mmp

static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16; h *= 2246822519u; h ^= h >> 13;
    return h;
}
static uint16_t ToBf16(float f)
{
    uint32_t x; memcpy(&x, &f, 4);
    return (uint16_t)((x + (((x >> 16) & 1) + 0x7FFF)) >> 16);
}

int32_t main(int32_t argc, char** argv)
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t aBytes = (size_t)mmp::M_DIM * mmp::K_MAX * 2;
    const size_t bBytes = (size_t)mmp::NDIST * mmp::N_DIM * mmp::K_MAX * 2;
    const size_t cBytes = (size_t)mmp::NDIST * mmp::NKS * mmp::M_DIM * mmp::N_DIM * 4;
    void *dA = nullptr, *dB = nullptr, *dC = nullptr;
    aclrtMalloc(&dA, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dB, bBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dC, cBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    uint16_t* hA = (uint16_t*)malloc(aBytes);
    uint16_t* hB = (uint16_t*)malloc(bBytes);
    float* hC = (float*)malloc(cBytes);
    // A 两种形态（用 argv[1] 选）：
    //   默认（0）= 全 1：任何 k 轴置换都不可见 ⇒ 只能测"列被丢/被重复"，不能测映射
    //   诊断（1）= **块对角**：A[m][k] = 1 iff k/16 == m ⇒ C[m][n] = 设备把哪些源列放进了它的第 m 个
    //               k 块；配 B=块签名(e4) 可**直接读出 mmad 实际用的 k 块映射**
    const bool diag = (argc > 1) && (atoi(argv[1]) == 1);
    for (uint32_t m = 0; m < mmp::M_DIM; ++m) {
        for (uint32_t k = 0; k < mmp::K_MAX; ++k) {
            const float av = diag ? ((k / 16 == m) ? 1.0f : 0.0f) : 1.0f;
            hA[m * mmp::K_MAX + k] = ToBf16(av);
        }
    }
    for (uint32_t d = 0; d < mmp::NDIST; ++d) {
        for (uint32_t n = 0; n < mmp::N_DIM; ++n) {
            for (uint32_t k = 0; k < mmp::K_MAX; ++k) {
                float v = 0.0f;
                if (d == 0) { v = 1.0f; }                                          // e0 ones（控制）
                else if (d == 1) { v = ((n == 0 && k == 0)   ? 1.0f : 0.0f); }     // e1 单格 (n0,k0)
                else if (d == 2) { v = ((n == 0 && k == 128) ? 1.0f : 0.0f); }     // e2 单格 (n0,k128)=chunk1
                else if (d == 3) { v = ((k == 0) ? 1.0f : 0.0f); }                 // e3 仅 k=0 列（全 n）
                else if (d == 4) {                                                 // e4 块签名：每 16 列一个 2 的幂
                    float p = 1.0f;
                    for (uint32_t j = 0; j < k / 16; ++j) { p *= 0.5f; }
                    v = 8.0f * p;                                                  // 列块 j 贡献 16·2^(3-j)
                }
                else if (d == 5) { v = ((k < 128) ? 1.0f : 0.0f); }                // e5 仅 chunk0
                else if (d == 6) { v = ((k >= 128) ? 1.0f : 0.0f); }               // e6 仅 chunk1
                else if (d == 7) { v = (k == 0) ? 32768.0f : 5.9604644775390625e-08f; }  // e7 absorb（原 d3）
                else if (d == 8) { v = 1.0f + (float)(k % 16) * 0.00048828125f; }  // e8 incr（原 d1，块不变性对照）
                else { v = (float)(Hash3(n, k, 7) & 0xFFFF) / 65535.0f * 2.0f - 1.0f; }  // e9 rand（原 d4）
                hB[((uint64_t)d * mmp::N_DIM + n) * mmp::K_MAX + k] = ToBf16(v);
            }
        }
    }
    aclrtMemcpy(dA, aBytes, hA, aBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dB, bBytes, hB, bBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dC, cBytes, 0, cBytes);
    mmp::mmadprobe_kernel<<<1, 0, stream>>>((uint8_t*)dA, (uint8_t*)dB, (uint8_t*)dC);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) { printf("[MMADPROBE][FAIL] sync err %d\n", (int)err); return 1; }
    aclrtMemcpy(hC, cBytes, dC, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    const char* dn[mmp::NDIST] = {"e0 ones  ", "e1 cell00", "e2 cell0128", "e3 col_k0", "e4 blksig",
                                 "e5 ch0   ", "e6 ch1   ", "e7 absorb", "e8 incr  ", "e9 rand  "};
    printf("[MMADPROBE] A=全1, B 分布 × k：设备 L0C vs fp64 参考（A/B 均为 bf16 精确值，参考无舍入）\n");
    printf("  说明：行和 C[0][n] = Σ_k B[n][k]，对 k 轴置换不变 ⇒ 只有\"某列被丢/被重复\"才能改变行和。\n");
    printf("%-10s %5s %14s %14s %12s %12s %10s %10s\n", "dist", "k", "dev C[0][0]", "ref C[0][0]",
           "absErr", "err/ulp尺度", "dev C[0][1]", "dev C[1][0]");
    for (uint32_t d = 0; d < mmp::NDIST; ++d) {
        for (uint32_t ki = 0; ki < mmp::NKS; ++ki) {
            const uint32_t k = mmp::NK[ki];
            const uint32_t conf = d * mmp::NKS + ki;
            // fp64 参考（n=0 行；diag 模式下 A[0][k] 只在 k<16 为 1）
            double ref = 0.0, absSum = 0.0;
            for (uint32_t kk = 0; kk < k; ++kk) {
                float bv;
                {
                    const uint16_t bits = hB[((uint64_t)d * mmp::N_DIM + 0) * mmp::K_MAX + kk];
                    uint32_t f = (uint32_t)bits << 16;
                    memcpy(&bv, &f, 4);
                }
                const double av = (diag && kk >= 16) ? 0.0 : 1.0;
                ref += av * (double)bv;
                absSum += fabs(av * (double)bv);
            }
            const float* c = hC + (uint64_t)conf * mmp::M_DIM * mmp::N_DIM;
            const double dev = (double)c[0];
            const double ae = fabs(dev - ref);
            const double scale = fmax(absSum / (double)k, 1e-30);
            double ulpScale = scale * 5.9604644775390625e-08;   // 2^-24
            printf("%-10s %5u %14.6g %14.6g %12.3e %12.3e %10.4g %10.4g  (C[0][0] bits 0x%08x)\n",
                   dn[d], k, dev, ref, ae, ae / fmax(ulpScale, 1e-38), (double)c[1], (double)c[mmp::N_DIM],
                   *(const uint32_t*)&c[0]);
        }
    }
    if (diag) {
        // 块对角 A + 块签名 B：C[m][0] 直接读出"设备把哪些源 16-列块放进了它的第 m 个 k 块"。
        // 映射正确时 C[m][0] = 16·(8·2^-m) = 2^(7-m) = 128,64,32,16,8,...,2^-8（每步减半）。
        const uint32_t conf = 4 * mmp::NKS;   // e4 blksig
        const float* c = hC + (uint64_t)conf * mmp::M_DIM * mmp::N_DIM;
        printf("[MMADPROBE][diag] e4 块签名的 C[m][0]（正确 = 128,64,32,...,2^-8）:\n  ");
        for (uint32_t m = 0; m < mmp::M_DIM; ++m) {
            printf("%g%s", (double)c[(uint64_t)m * mmp::N_DIM], (m + 1 == mmp::M_DIM) ? "\n" : ", ");
        }
    }
    free(hA); free(hB); free(hC);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
