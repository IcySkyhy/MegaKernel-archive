/**
 * m10_l0probe.asc —— L0B 装载几何标定探针（AIC-only，最小 2-fractal 用例）
 *
 * 目的：用"可逐点读出的构造输入"反推 `LoadData2DParamsV2` 各字段控制哪个轴。
 * 方法（tower 裁决 + docs/05 §6.1 判据："传两个不同值看结果是否变"）：
 *   - 源：GM 里一张 [32 行][32 列] bf16，元素值唯一编码 src[i][j] = i*1000 + j（bf16 精确）；
 *     Nd2Nz 进 L1（dstNzC0Stride = 32 行）→ 源 zN 的 C0 轴 = 列、行轴 = 行。
 *   - A（L0A）：m0 已实证的 16x16 单位阵装载（mStep=kStep=src=dst=1, ifTranspose=false）；
 *     mmad k=16 ⇒ L0C[m][n] = Σ_k A[m][k]·L0B[n][k] = L0B[n][m]（因为 A=I）
 *     ⇒ **L0C 直接映射出 L0B 的 (n, k) 内容**，host 反查唯一值即知每个元素来自源的哪个 (i,j)。
 *   - 逐个 conf 改 (mStep,kStep,srcStride,dstStride,ifTranspose[,srcOffset])，每次一次 LoadL0_2D + 一次 mmad
 *     + Fixpipe L0C→GM，落到 gOut[conf]。
 *
 * 用法：./m10_l0probe > 输出表；host 会打印每个 conf 的解码映射（只打印可判读的前几行/列）。
 */
#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>

namespace m10lp {
using namespace AscendC;

constexpr uint32_t ROWS = 32;    // 源行数（= B 的 N 轴）
constexpr uint32_t COLS = 32;    // 源列数（= B 的 K 轴，C0 轴）
constexpr uint32_t M_DIM = 16;   // mmad M（A 的行数）
constexpr uint32_t MM_K = 16;    // mmad K（= 1 个 k-fractal）
constexpr uint32_t NCONF = 10;

constexpr uint32_t L1_SRC = 0;                  // B 源 L1（zN）
constexpr uint32_t L1_A = 4096;                 // A 的 L1（ND->NZ）
constexpr uint32_t L0_A = 0;                    // L0A
constexpr uint32_t L0_B = 0;                    // L0B
constexpr uint32_t L0C_SLOT = M_DIM * ROWS * 4;

struct Conf {
    uint16_t mStep, kStep;
    int32_t srcStride;
    uint16_t dstStride;
    uint8_t ifTranspose;
    uint32_t srcOff;
};

__aicore__ __inline__ void RunOne(uint32_t idx, const Conf& cf, LocalTensor<uint8_t>& l0B,
                                  LocalTensor<uint8_t>& l0A, LocalTensor<uint8_t>& l0C,
                                  LocalTensor<uint8_t>& l1B, __gm__ uint8_t* outBase)
{
    LoadData2DParamsV2 lp;
    lp.mStartPosition = 0;
    lp.kStartPosition = 0;
    lp.mStep = cf.mStep;
    lp.kStep = cf.kStep;
    lp.srcStride = cf.srcStride;
    lp.dstStride = cf.dstStride;
    lp.ifTranspose = (cf.ifTranspose != 0);
    lp.sid = 0;
    LocalTensor<bfloat16_t> src = l1B.template ReinterpretCast<bfloat16_t>()[cf.srcOff];
    LocalTensor<bfloat16_t> dst = l0B.template ReinterpretCast<bfloat16_t>();
    LoadData(dst, src, lp);
    PipeBarrier<PIPE_MTE1>();

    MmadParams mp;
    mp.m = (uint16_t)M_DIM;
    mp.n = (uint16_t)ROWS;
    mp.k = (uint16_t)MM_K;
    mp.cmatrixInitVal = true;
    mp.cmatrixSource = false;
    Mmad(l0C.template ReinterpretCast<float>(), l0A.template ReinterpretCast<bfloat16_t>(),
         l0B.template ReinterpretCast<bfloat16_t>(), mp);
    PipeBarrier<PIPE_M>();

    GlobalTensor<float> out;
    out.SetGlobalBuffer((__gm__ float*)(outBase) + (uint64_t)idx * M_DIM * ROWS);
    FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
    fp.nSize = (uint16_t)ROWS;
    fp.mSize = (uint16_t)M_DIM;
    fp.srcStride = (uint16_t)M_DIM;
    fp.dstStride = ROWS;
    fp.reluScalar = 0;
    fp.vectorRelu = 0;
    fp.deqScalar = 0;
    static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
    Fixpipe<float, float, kFixGm>(out, l0C.template ReinterpretCast<float>(), fp);
    PipeBarrier<PIPE_FIX>();
}

__global__ __cube__ void l0probe_kernel(__gm__ uint8_t* src, __gm__ uint8_t* aMat, __gm__ uint8_t* out)
{
    AscendC::InitSocState();
    LocalTensor<uint8_t> l1B(TPosition::B1, L1_SRC, ROWS * COLS * 2);
    LocalTensor<uint8_t> l1A(TPosition::A1, L1_A, M_DIM * M_DIM * 2);
    LocalTensor<uint8_t> l0A(TPosition::A2, L0_A, 64 * 1024);
    LocalTensor<uint8_t> l0B(TPosition::B2, L0_B, 64 * 1024);
    LocalTensor<uint8_t> l0C(TPosition::CO1, 0, 256 * 1024);

    GlobalTensor<uint8_t> srcG, aG;
    srcG.SetGlobalBuffer(src);
    aG.SetGlobalBuffer(aMat);
    {
        Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = ROWS;        // 行 = N 轴
        par.dValue = COLS;        // 列 = K 轴（C0 轴）
        par.srcNdMatrixStride = 0;
        par.srcDValue = COLS;
        par.dstNzC0Stride = ROWS;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        DataCopy(l1B.template ReinterpretCast<bfloat16_t>(), srcG.template ReinterpretCast<bfloat16_t>(), par);
        par.nValue = M_DIM;
        par.dValue = M_DIM;
        par.srcDValue = M_DIM;
        par.dstNzC0Stride = M_DIM;
        DataCopy(l1A.template ReinterpretCast<bfloat16_t>(), aG.template ReinterpretCast<bfloat16_t>(), par);
    }
    PipeBarrier<PIPE_MTE2>();

    {   // A：m0 已实证的 16x16 装载（单位阵）
        LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = 1;
        lp.kStep = 1;
        lp.srcStride = 1;
        lp.dstStride = 1;
        lp.ifTranspose = false;
        lp.sid = 0;
        LoadData(l0A.template ReinterpretCast<bfloat16_t>(), l1A.template ReinterpretCast<bfloat16_t>(), lp);
        PipeBarrier<PIPE_MTE1>();
    }

    // conf 列表：先 (mStep,kStep,srcStride,dstStride) 各自扰动，再 ifTranspose，再源偏移
    const Conf confs[NCONF] = {
        {2, 1, 2, 2, 0, 0},   // 0 基线（BMM1 形态：mStep=N/16, kStep=K/16, src=C0stride/16, dst=N/16）
        {1, 1, 2, 2, 0, 0},   // 1 mStep 减半
        {4, 1, 2, 2, 0, 0},   // 2 mStep 加倍
        {2, 1, 1, 2, 0, 0},   // 3 srcStride 减半
        {2, 1, 4, 2, 0, 0},   // 4 srcStride 加倍
        {2, 1, 2, 1, 0, 0},   // 5 dstStride 减半
        {2, 1, 2, 4, 0, 0},   // 6 dstStride 加倍
        {2, 1, 2, 2, 1, 0},   // 7 ifTranspose 翻转
        {2, 1, 2, 2, 0, 16},  // 8 源偏移 16 元素（1 行）
        {1, 1, 1, 1, 1, 0},   // 9 m0 同款（全 1 + ifTranspose=1）
    };
    for (uint32_t i = 0; i < NCONF; ++i) {
        RunOne(i, confs[i], l0B, l0A, l0C, l1B, out);
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace m10lp

int32_t main()
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t srcBytes = (size_t)m10lp::ROWS * m10lp::COLS * 2;
    const size_t aBytes = (size_t)m10lp::M_DIM * m10lp::M_DIM * 2;
    const size_t outBytes = (size_t)m10lp::NCONF * m10lp::M_DIM * m10lp::ROWS * 4;

    void* dSrc = nullptr;
    void* dA = nullptr;
    void* dOut = nullptr;
    aclrtMalloc(&dSrc, srcBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dA, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOut, outBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    uint16_t* hSrc = (uint16_t*)malloc(srcBytes);
    uint16_t* hA = (uint16_t*)malloc(aBytes);
    float* hOut = (float*)malloc(outBytes);

    // 源：bf16 位型，值 = i*1000 + j（bf16 可精确表示 <= 65536 的整数）
    for (uint32_t i = 0; i < m10lp::ROWS; ++i) {
        for (uint32_t j = 0; j < m10lp::COLS; ++j) {
            const float v = (float)(i * 1000 + j);
            uint32_t u;
            memcpy(&u, &v, 4);
            hSrc[i * m10lp::COLS + j] = (uint16_t)(u >> 16);
        }
    }
    for (uint32_t i = 0; i < m10lp::M_DIM; ++i) {
        for (uint32_t j = 0; j < m10lp::M_DIM; ++j) {
            const float v = (i == j) ? 1.0f : 0.0f;
            uint32_t u;
            memcpy(&u, &v, 4);
            hA[i * m10lp::M_DIM + j] = (uint16_t)(u >> 16);
        }
    }

    aclrtMemcpy(dSrc, srcBytes, hSrc, srcBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dA, aBytes, hA, aBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dOut, outBytes, 0, outBytes);

    printf("[L0PROBE] 源 src[i][j] = i*1000+j（行=N 轴，列=K 轴）；A = I16；mmad m=16 n=32 k=16\n");
    m10lp::l0probe_kernel<<<1, 0, stream>>>((uint8_t*)dSrc, (uint8_t*)dA, (uint8_t*)dOut);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("[L0PROBE][FAIL] sync err %d\n", (int)err);
        return 1;
    }
    aclrtMemcpy(hOut, outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    const char* names[m10lp::NCONF] = {
        "base (2,1,2,2,T0,off0)", "mStep 1 (1,1,2,2,T0)", "mStep 4 (4,1,2,2,T0)",
        "src 1 (2,1,1,2,T0)", "srcStride 4 (2,1,4,2,T0)", "dst 1 (2,1,2,1,T0)",
        "dst 4 (2,1,2,4,T0)", "T=1  (2,1,2,2,T1)", "off=16 (2,1,2,2,T0,off16)",
        "m0 同款(1,1,1,1,T1)",
    };
    for (uint32_t c = 0; c < m10lp::NCONF; ++c) {
        printf("\n[conf %u] %s\n", c, names[c]);
        // 原始值（整数化）：源值 = i*1000+j ⇒ 能直接看出读到源的哪一行/列
        for (uint32_t m = 0; m < m10lp::M_DIM; ++m) {
            printf("   m=%2u:", m);
            for (uint32_t n = 0; n < 16; ++n) {
                printf(" %6d", (int)(hOut[(c * m10lp::M_DIM + m) * m10lp::ROWS + n] + 0.5f));
            }
            printf("\n");
        }
        uint32_t ok = 0, nz = 0;
        for (uint32_t m = 0; m < m10lp::M_DIM; ++m) {
            for (uint32_t n = 0; n < m10lp::ROWS; ++n) {
                const float v = hOut[(c * m10lp::M_DIM + m) * m10lp::ROWS + n];
                const int iv = (int)(v + 0.5f);
                if (v != 0.0f) { nz++; }
                if (iv == (int)(n * 1000 + m)) { ok++; }
            }
        }
        printf("   正确映射(i=n,j=m)命中 %u/512, 非零 %u/512\n", ok, nz);
    }
    free(hSrc);
    free(hA);
    free(hOut);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
