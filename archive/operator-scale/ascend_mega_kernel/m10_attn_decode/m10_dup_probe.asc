// m10_dup_probe: AICore exception 507015 的隔离探针（reviewer r2 提供，本仓库收录版；正文与 /tmp/m24dup/dup_probe.asc 逐字相同，仅本行加注来源与用法）
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdio>
#include <cstdlib>
#include <cstdint>

namespace dp {
using namespace AscendC;
template <pipe_t p> __aicore__ __inline__ void Acq(MutexID id) { GetBuffImpl<p, false>(id); }
template <pipe_t p> __aicore__ __inline__ void Rls(MutexID id) { ReleaseBuffImpl<p, false>(id); }

__global__ __mix__(1, 2) void dup_kernel(__gm__ uint32_t* sel, __gm__ float* out)
{
    AscendC::InitSocState();
    const uint32_t mode = sel[0];
    if ASCEND_IS_AIV {
        if (GetBlockIdx() == 0) {
            LocalTensor<float> ub(TPosition::VECCALC, 0, 512);
            LocalTensor<bfloat16_t> ubb(TPosition::VECCALC, 0, 1024);
            Acq<PIPE_V>(0);
            Duplicate(ub, 0.0f, 512);          // same in every mode (control)
            switch (mode) {
                case 0: Duplicate(ub, 1.0f, 1); break;         // calCount = 1 (claimed trigger)
                case 1: Duplicate(ub, 1.0f, 2); break;         // calCount = 2
                case 2: Duplicate(ub, 1.0f, 8); break;         // calCount = 8
                case 3: Duplicate(ub, 1.0f, 64); break;        // calCount = 64
                case 4: Duplicate(ub[8], 1.0f, 1); break;      // 32B-aligned slice, calCount 1
                case 5: Duplicate(ub[1], 1.0f, 1); break;      // 4B-aligned slice, calCount 1
                case 6: Duplicate(ub, 1.0f, 2048); break;      // calCount 2048
                case 7: Duplicate(ub[1], 1.0f, 8); break;      // 4B-aligned slice, calCount 8
                case 8: Duplicate(ub, 0.5f, 1); Exp(ub, ub, 1); break;   // calCount 1 + classic Exp(calCount=1)
                case 9:  Duplicate(ub[2], 1.0f, 1); break;    // 8B offset
                case 10: Duplicate(ub[4], 1.0f, 1); break;    // 16B offset
                case 11: Duplicate(ub[16], 1.0f, 1); break;   // 64B offset (32B-aligned)
                case 12: Duplicate(ubb[8], (bfloat16_t)1.0f, 1); break;   // bf16, 16B offset
                case 13: Duplicate(ubb[16], (bfloat16_t)1.0f, 1); break;  // bf16, 32B offset
                default: break;
            }
            Rls<PIPE_V>(0);
            Acq<PIPE_MTE3>(0);
            GlobalTensor<float> g;
            g.SetGlobalBuffer(out);
            DataCopy(g, ub, 8);
            Rls<PIPE_MTE3>(0);
        }
    }
    if ASCEND_IS_AIC { }
    AscendC::PipeBarrier<PIPE_ALL>();
}
}  // namespace dp

int32_t main(int32_t argc, char** argv)
{
    const uint32_t mode = (argc > 1) ? (uint32_t)atoi(argv[1]) : 0u;
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    void* dSel = nullptr; void* dOut = nullptr;
    aclrtMalloc(&dSel, 64, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOut, 64, ACL_MEM_MALLOC_HUGE_FIRST);
    uint32_t hSel[16] = {mode, 0};
    float hOut[16];
    for (int i = 0; i < 16; ++i) hOut[i] = -12345.0f;
    aclrtMemcpy(dSel, 64, hSel, 64, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dOut, 64, 0, 64);
    printf("[DUP mode=%u] launch\n", mode);
    fflush(stdout);
    dp::dup_kernel<<<1, 0, stream>>>((uint32_t*)dSel, (float*)dOut);
    const aclError err = aclrtSynchronizeStream(stream);
    aclrtMemcpy(hOut, 64, dOut, 64, ACL_MEMCPY_DEVICE_TO_HOST);
    printf("[DUP mode=%u] aclrtSynchronizeStream err=%d (0=OK)  out[0]=%g out[1]=%g\n", mode, (int)err, hOut[0], hOut[1]);
    fflush(stdout);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (err == ACL_SUCCESS) ? 0 : 1;
}
