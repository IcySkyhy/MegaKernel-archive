/**
 * m10_expprobe.asc —— RegBase VF `Exp` 精度标定探针（AIV-only，最小迭代）
 *
 * 目的（M24 第十一轮）：tower 假设"缺的那一项是 VF Exp 的近似误差，且只在 chunkTiles=2 的档咬人"
 * （单 tile 档的重标定因子恒为 1、那条路径没被求值；2-tile 档才真的把 `e^{m_old−m_new}` 乘进 acc）。
 * 本探针**直接测设备 VF Exp 的误差**（不靠下游反推），输入按"能打到最坏情形"选取。
 *
 * 用法：./m10_expprobe       # 打印 5 组分布上 device Exp vs fp64 exp 的误差表
 */
#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstdlib>
#include <cstdint>
#include <cstring>
#include <cmath>

namespace exp_probe {
using namespace AscendC;

constexpr uint32_t VL = 64;            // fp32 向量寄存器 lane 数
constexpr uint32_t GROUPS = 80;        // 80 组 × 64 = 5120 个输入
constexpr uint32_t TOT = GROUPS * VL;
constexpr uint32_t UB_IN = 0;
constexpr uint32_t UB_OUT = TOT * 4 + 64;

__simd_vf__ inline void ExpAll(__ubuf__ float* src, __ubuf__ float* dst)
{
    using namespace AscendC::Reg;
    __VEC_SCOPE__
    {
        RegTensor<float> v, e;
        MaskReg fullM = CreateMask<float, MaskPattern::ALL>();
        for (uint16_t g = 0; g < (uint16_t)GROUPS; ++g) {
            LoadAlign(v, src + (uint32_t)g * VL);
            Exp(e, v, fullM);
            StoreAlign(dst + (uint32_t)g * VL, e, fullM);
        }
    }
}

__global__ __vector__ void expprobe_kernel(__gm__ uint8_t* in, __gm__ uint8_t* out)
{
    AscendC::InitSocState();
    LocalTensor<uint8_t> ubi(TPosition::VECCALC, UB_IN, TOT * 4);
    LocalTensor<uint8_t> ubo(TPosition::VECCALC, UB_OUT, TOT * 4);
    GlobalTensor<float> gi, go;
    gi.SetGlobalBuffer((__gm__ float*)in);
    go.SetGlobalBuffer((__gm__ float*)out);
    // 分块搬运（单条 DataCopy 20KB 曾出现"首次运行读数异常/后续 inf"的不稳定现象，改为 512B/块 × 40）
    constexpr uint32_t CH = 128;
    LocalTensor<float> uif = ubi.template ReinterpretCast<float>();
    LocalTensor<float> uof = ubo.template ReinterpretCast<float>();
    for (uint32_t c = 0; c < TOT; c += CH) {
        DataCopy(uif[c], gi[c], CH);
    }
    PipeBarrier<PIPE_MTE2>();
    ExpAll(reinterpret_cast<__ubuf__ float*>(ubi.GetPhyAddr()),
           reinterpret_cast<__ubuf__ float*>(ubo.GetPhyAddr()));
    // V -> MTE3 跨 pipe 交接：整栅栏（只靠 PIPE_MTE1/PIPE_V 单管道栅栏不保证可见性）
    PipeBarrier<PIPE_ALL>();
    for (uint32_t c = 0; c < TOT; c += CH) {
        DataCopy(go[c], uof[c], CH);
    }
    PipeBarrier<PIPE_ALL>();
}
}  // namespace exp_probe

int32_t main()
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t n = exp_probe::TOT * 4;
    void* dI = nullptr;
    void* dO = nullptr;
    aclrtMalloc(&dI, n, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dO, n, ACL_MEM_MALLOC_HUGE_FIRST);
    float* hI = (float*)malloc(n);
    float* hO = (float*)malloc(n);

    // 输入分组（每组 64 个）
    //   g0..g7   : 重标定因子区间 x ∈ [-2, 0]（m_old−m_new 的取值范围）
    //   g8..g15  : 2 的幂边界附近 x = -k·ln2 ± δ
    //   g16..g31 : softmax E 的区间 x ∈ [-20, 0]
    //   g32..g47 : 小差值 x ∈ [-1e-3, 1e-3]（相对误差最敏感）
    //   g48..g63 : 大负 x ∈ [-100, -20]
    //   g64..g79 : 伪随机 x ∈ [-30, 0]
    const uint32_t G = exp_probe::GROUPS, L = exp_probe::VL;
    for (uint32_t g = 0; g < G; ++g) {
        for (uint32_t i = 0; i < L; ++i) {
            const uint32_t idx = g * L + i;
            float x = 0.0f;
            if (g < 8) {                       // [-2,0] 细步
                x = -2.0f + 2.0f * ((float)(g * L + i) / (float)(8 * L - 1));
            } else if (g < 16) {               // 2 的幂边界附近
                const int k = (int)(g - 8) + 1;
                const float base = -(float)k * 0.6931471805599453f;
                x = base + ((float)i / (float)L - 0.5f) * 1e-3f;
            } else if (g < 32) {               // [-20,0]
                x = -20.0f + 20.0f * ((float)(g - 16) * L + i) / (float)(16 * L - 1);
            } else if (g < 48) {               // [-1e-3,1e-3]
                x = -1e-3f + 2e-3f * ((float)(g - 32) * L + i) / (float)(16 * L - 1);
            } else if (g < 64) {               // [-100,-20]
                x = -100.0f + 80.0f * ((float)(g - 48) * L + i) / (float)(16 * L - 1);
            } else {                           // 伪随机
                uint32_t h = (idx + 1u) * 2654435761u;
                h ^= h >> 16; h *= 2246822519u; h ^= h >> 13;
                x = -30.0f * (float)(h & 0xFFFF) / 65535.0f;
            }
            hI[idx] = x;
        }
    }
    aclrtMemcpy(dI, n, hI, n, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dO, n, 0, n);
    exp_probe::expprobe_kernel<<<1, 0, stream>>>((uint8_t*)dI, (uint8_t*)dO);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) { printf("[EXPPROBE][FAIL] sync err %d\n", (int)err); return 1; }
    aclrtMemcpy(hO, n, dO, n, ACL_MEMCPY_DEVICE_TO_HOST);

    const char* names[] = {"x∈[-2,0] 重标定区间", "2 的幂边界附近", "x∈[-20,0] softmax E",
                           "x∈[-1e-3,1e-3] 小差值", "x∈[-100,-20] 大负", "x∈[-30,0] 随机"};
    const uint32_t lo[6] = {0, 8, 16, 32, 48, 64};
    const uint32_t hi[6] = {8, 16, 32, 48, 64, 80};
    printf("[EXPPROBE] 原始采样：idx in/out/exp(in)\n");
    for (uint32_t k = 0; k < 8; ++k) {
        printf("   [%u] in=%.8g out=%.8g exp(in)=%.8g   | [%u] in=%.8g out=%.8g exp=%.8g\n",
               k, hI[k], hO[k], exp((double)hI[k]), 2560 + k, hI[2560 + k], hO[2560 + k], exp((double)hI[2560 + k]));
    }
    printf("[EXPPROBE] RegBase VF Exp vs fp64 exp（ULP=2^-24 相对；fp32 的 0.5ulp ≈ 3e-8 相对）\n");
    for (int t = 0; t < 6; ++t) {
        double maxRel = 0.0, maxAbs = 0.0, sumRel = 0.0;
        uint32_t cnt = 0, over1ulp = 0, over1e4ulp = 0;
        for (uint32_t g = lo[t]; g < hi[t]; ++g) {
            for (uint32_t i = 0; i < L; ++i) {
                const uint32_t idx = g * L + i;
                const double x = (double)hI[idx];
                const double ref = exp(x);
                const double got = (double)hO[idx];
                const double ae = fabs(got - ref);
                const double rel = ae / fmax(ref, 1e-300);
                if (rel > maxRel) { maxRel = rel; }
                if (ae > maxAbs) { maxAbs = ae; }
                sumRel += rel;
                ++cnt;
                const double ulp = rel / 5.9604644775390625e-08;   // 2^-24
                if (ulp > 1.0) { ++over1ulp; }
                if (ulp > 1e4) { ++over1e4ulp; }
            }
        }
        printf("  %-24s n=%4u  maxRel=%.3e (=%.1f ulp)  meanRel=%.3e  maxAbs=%.3e  >1ulp=%u  >1e4ulp=%u\n",
               names[t], cnt, maxRel, maxRel / 5.9604644775390625e-08, sumRel / cnt, maxAbs, over1ulp, over1e4ulp);
    }
    free(hI); free(hO);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
