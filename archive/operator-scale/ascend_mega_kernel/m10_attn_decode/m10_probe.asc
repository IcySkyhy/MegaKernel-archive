/**
 * m10_probe.asc —— attention decode 用的 CrossCore 同步原语探针（mix(1,2)，28 AIC + 56 AIV）
 *
 * 背景：CANN 9.1.0 `NotifyEventImpl<modeId,pipe>` / `WaitEventImpl<modeId,pipe>` 的实际发射条件是
 *   mode != 4: `if constexpr (IsSplitVectorPipe<pipe>()) { if ASCEND_IS_AIV { ffts_cross_core_sync } }`
 *              `if constexpr (IsSplitCubePipe<pipe>())   { if ASCEND_IS_AIC { ffts_cross_core_sync } }`
 *   mode == 4: `set_intra_block / wait_intra_block`（同样按 pipe 类限核型）
 * 而 3510 的分类是
 *   IsSplitVectorPipe = {PIPE_S, PIPE_V, PIPE_MTE2, PIPE_MTE3}
 *   IsSplitCubePipe   = {PIPE_S, PIPE_MTE1, PIPE_MTE2, PIPE_FIX, PIPE_M}
 * → **AIC 上任何 CrossCoreSetFlag/WaitFlag 用 PIPE_MTE3/PIPE_V 都是空操作**；
 *   **AIV 上用 PIPE_FIX/PIPE_MTE1/PIPE_M 同理**。本探针把这条矩阵逐格实测确认。
 *
 * 用法：./m10_probe <id>  每次一个探针；挂死由外部 timeout 判定（无输出即挂死）。
 *       结果：out[0] = AIC0 完成标记，out[1+bid] = 各 AIV 完成标记；host 打印 PASS/FAIL。
 *
 * 探针表（flagId 除注明外一律用 1，与 m0 实证同 id；mode 4 用 0）：
 *   1  AIV --mode2(set PIPE_MTE3)--> AIC wait PIPE_S
 *   2  AIV --mode2(set PIPE_MTE3)--> AIC wait PIPE_FIX
 *   3  AIC --mode2(set PIPE_FIX)--> AIV wait PIPE_MTE2      （m0 检查 4 同款）
 *   4  AIC --mode2(set PIPE_MTE1)--> AIV wait PIPE_MTE2
 *   5  AIC --mode2(set PIPE_MTE3)--> AIV wait PIPE_MTE2     （预期空操作 → AIV 挂死）
 *   6  mode0 全体 AIC 屏障：set PIPE_FIX / wait PIPE_S
 *   7  mode0 全体 AIC 屏障：set PIPE_MTE2 / wait PIPE_S
 *   8  mode0 全体 AIC 屏障：set PIPE_MTE3 / wait PIPE_S     （预期空操作 → 挂死）
 *   9  mode0 全体 AIV 屏障：set PIPE_MTE3 / wait PIPE_MTE2  （m0 检查 3 同款）
 *  10  mode4 AIV → AIC：AIV set PIPE_V(id 0)，AIC wait PIPE_FIX(0) + wait PIPE_FIX(16)
 *  11  mode4 AIC → AIV：AIC set PIPE_FIX(0)/(16)，AIV wait PIPE_V(0)
 *  12  FD 收尾骨架（全用已验证 pipe）：AIV2AIC(mode2,MTE3→S) → AIC mode0 屏障(FIX/S)
 *      → AIC2AIV(mode2,FIX→MTE2) → AIV allDone(mode2,MTE3) → AIC wait PIPE_S
 *  13  AIC --mode2(set PIPE_FIX, flagId 10)--> AIV wait PIPE_MTE2(10)   （探 id 敏感度）
 */
#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstdlib>
#include <cstdint>

namespace m10probe {
using namespace AscendC;

constexpr uint16_t FID   = 1;    // m0 实证 id
constexpr uint16_t FID_HI = 10;  // 高 id 对照
constexpr uint16_t F_M4  = 0;    // mode 4 通道基址
constexpr uint32_t AIV_CH = 16;

__aicore__ __inline__ void Mark(__gm__ uint32_t* out, uint32_t slot, uint32_t val)
{
    out[slot] = val;
}

__aicore__ __inline__ void AicProbe(uint32_t p, __gm__ uint32_t* out)
{
    const uint32_t bid = GetBlockIdx();
    if (p == 1 || p == 2) {
        if (p == 1) { CrossCoreWaitFlag<0x2, PIPE_S>(FID); }
        else        { CrossCoreWaitFlag<0x2, PIPE_FIX>(FID); }
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 3 || p == 4 || p == 5) {
        const uint16_t id = (p == 5) ? FID_HI : ((p == 3) ? FID : FID);
        if (p == 3)      { CrossCoreSetFlag<0x2, PIPE_FIX>(id); }
        else if (p == 4) { CrossCoreSetFlag<0x2, PIPE_MTE1>(id); }
        else             { CrossCoreSetFlag<0x2, PIPE_MTE3>(id); }
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 6 || p == 7 || p == 8) {
        if (p == 6)      { CrossCoreSetFlag<0x0, PIPE_FIX>(FID); }
        else if (p == 7) { CrossCoreSetFlag<0x0, PIPE_MTE2>(FID); }
        else             { CrossCoreSetFlag<0x0, PIPE_MTE3>(FID); }
        CrossCoreWaitFlag<0x0, PIPE_S>(FID);
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 9) {
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 10) {
        CrossCoreWaitFlag<0x4, PIPE_FIX>(F_M4);
        CrossCoreWaitFlag<0x4, PIPE_FIX>(F_M4 + AIV_CH);
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 11) {
        CrossCoreSetFlag<0x4, PIPE_FIX>(F_M4);
        CrossCoreSetFlag<0x4, PIPE_FIX>(F_M4 + AIV_CH);
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 12) {
        CrossCoreWaitFlag<0x2, PIPE_S>(1);              // AIV partial 已落 GM
        CrossCoreSetFlag<0x0, PIPE_FIX>(0);             // 全体 AIC 屏障
        CrossCoreWaitFlag<0x0, PIPE_S>(0);
        CrossCoreSetFlag<0x2, PIPE_FIX>(2);             // 放行 AIV
        CrossCoreWaitFlag<0x2, PIPE_S>(3);              // 等 AIV 收尾
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 14) {
        CrossCoreWaitFlag<0x2, PIPE_S>(9);              // 同 12，但改用高 id
        CrossCoreSetFlag<0x0, PIPE_FIX>(8);
        CrossCoreWaitFlag<0x0, PIPE_S>(8);
        CrossCoreSetFlag<0x2, PIPE_FIX>(10);
        CrossCoreWaitFlag<0x2, PIPE_S>(11);
        if (bid == 0) { Mark(out, 0, p); }
    } else if (p == 13) {
        CrossCoreSetFlag<0x2, PIPE_FIX>(FID_HI);
        if (bid == 0) { Mark(out, 0, p); }
    } else {
        if (bid == 0) { Mark(out, 0, p); }
    }
}

__aicore__ __inline__ void AivProbe(uint32_t p, __gm__ uint32_t* out)
{
    const uint32_t bid = GetBlockIdx();
    if (p == 1 || p == 2) {
        CrossCoreSetFlag<0x2, PIPE_MTE3>(FID);
    } else if (p == 3 || p == 4 || p == 5 || p == 13) {
        const uint16_t id = (p == 13) ? FID_HI : FID;
        CrossCoreWaitFlag<0x2, PIPE_MTE2>(id);
    } else if (p == 6 || p == 7 || p == 8) {
        // AIC 屏障与 AIV 无关
    } else if (p == 9) {
        CrossCoreSetFlag<0x0, PIPE_MTE3>(FID);
        CrossCoreWaitFlag<0x0, PIPE_MTE2>(FID);
    } else if (p == 10) {
        CrossCoreSetFlag<0x4, PIPE_V>(F_M4);
    } else if (p == 11) {
        CrossCoreWaitFlag<0x4, PIPE_V>(F_M4);
    } else if (p == 12) {
        CrossCoreSetFlag<0x2, PIPE_MTE3>(1);   // partial 落 GM
        CrossCoreWaitFlag<0x2, PIPE_MTE2>(2);  // 等 AIC 放行
        CrossCoreSetFlag<0x2, PIPE_MTE3>(3);   // 收尾
    } else if (p == 14) {
        CrossCoreSetFlag<0x2, PIPE_MTE3>(9);
        CrossCoreWaitFlag<0x2, PIPE_MTE2>(10);
        CrossCoreSetFlag<0x2, PIPE_MTE3>(11);
    }
    Mark(out, 1 + bid, p);
}
}  // namespace m10probe

__global__ __mix__(1, 2) void m10_probe_kernel(__gm__ uint32_t* sel, __gm__ uint32_t* out)
{
    AscendC::InitSocState();
    const uint32_t p = sel[0];
    if ASCEND_IS_AIC { m10probe::AicProbe(p, out); }
    if ASCEND_IS_AIV { m10probe::AivProbe(p, out); }
}

int32_t main(int32_t argc, char** argv)
{
    const uint32_t probe = (argc > 1) ? (uint32_t)atoi(argv[1]) : 1u;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    void* dSel = nullptr;
    void* dOut = nullptr;
    const size_t outBytes = (size_t)(1 + 56) * 4;
    aclrtMalloc(&dSel, 64, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOut, outBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    uint32_t hSel[16] = {probe};
    uint32_t* hOut = (uint32_t*)malloc(outBytes);
    for (size_t i = 0; i < outBytes / 4; ++i) { hOut[i] = 0xEEEEEEEEu; }

    aclrtMemcpy(dSel, 64, hSel, 64, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dOut, outBytes, 0xEE, outBytes);

    printf("[PROBE %u] launch\n", probe);
    m10_probe_kernel<<<28, 0, stream>>>((uint32_t*)dSel, (uint32_t*)dOut);
    const aclError err = aclrtSynchronizeStream(stream);
    aclrtMemcpy(hOut, outBytes, dOut, outBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t aivOk = 0;
    for (uint32_t b = 0; b < 56; ++b) {
        if (hOut[1 + b] == probe) { aivOk++; }
    }
    const bool pass = (err == ACL_SUCCESS) && (hOut[0] == probe) && (aivOk == 56);
    printf("[PROBE %u] sync=%d AIC0=%u (want %u) AIVok=%u/56 -> %s\n", probe, (int)err,
           hOut[0], probe, aivOk, pass ? "PASS" : "FAIL");

    free(hOut);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return pass ? 0 : 1;
}
