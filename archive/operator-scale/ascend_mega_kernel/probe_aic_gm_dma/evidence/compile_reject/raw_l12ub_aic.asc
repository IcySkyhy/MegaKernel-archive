// raw_l12ub_aic.asc —— 编译期取证（正对照）：AIC 分支调 raw intrinsic copy_cbuf_to_ubuf（L1→UB）。
// 预期：bisheng **接受**（AIC 的 UB 写侧归 MTE1）。
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
using namespace AscendC;

__global__ __mix__(1, 2) void raw_l12ub(__gm__ uint8_t* inGm, __gm__ uint8_t* outGm)
{
    if ASCEND_IS_AIC {
        LocalTensor<uint8_t> ub(TPosition::VECIN, 0, 8192);
        LocalTensor<uint8_t> l1(TPosition::A1, 0, 8192);
        copy_cbuf_to_ubuf((__ubuf__ void*)ub.GetPhyAddr(), (__cbuf__ void*)l1.GetPhyAddr(), false, 1, 256, 0, 0);
    }
    if ASCEND_IS_AIV {
        (void)inGm; (void)outGm;
    }
}
