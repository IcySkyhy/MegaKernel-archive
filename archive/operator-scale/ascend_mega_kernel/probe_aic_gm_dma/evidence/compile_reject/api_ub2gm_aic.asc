// api_ub2gm_aic.asc —— 编译期取证：AIC 分支调**基础 API** `DataCopy(GM, UB)`（软件层，非 raw intrinsic）。
// 预期：bisheng **接受**（它编译成内联函数，里面有 `if ASCEND_IS_AIV` 的运行期门 —— 在 AIC 上被常量折叠成空）。
// 所以「编译通过」不代表「AIC 能 UB→GM」；运行期是否落盘由 probe_aic_gm_dma 的 ub2gm_api 档回答。
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
using namespace AscendC;

__global__ __mix__(1, 2) void api_ub2gm(__gm__ uint8_t* inGm, __gm__ uint8_t* outGm)
{
    if ASCEND_IS_AIC {
        LocalTensor<uint8_t> ub(TPosition::VECIN, 0, 8192);
        GlobalTensor<uint8_t> g;
        g.SetGlobalBuffer(outGm);
        DataCopy(g, ub, 2048u);
    }
    if ASCEND_IS_AIV {
        (void)inGm;
    }
}
