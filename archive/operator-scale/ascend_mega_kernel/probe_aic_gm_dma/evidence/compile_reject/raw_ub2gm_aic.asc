// raw_ub2gm_aic.asc —— 编译期取证：AIC 分支直接调 raw intrinsic copy_ubuf_to_gm（MTE3 的 UB→GM）。
// 预期：bisheng 在 AIC（__DAV_CUBE__）目标上**拒绝**该 intrinsic。命令与逐字报错见同目录 repro.sh / *.log。
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
using namespace AscendC;

__global__ __mix__(1, 2) void raw_ub2gm(__gm__ uint8_t* inGm, __gm__ uint8_t* outGm)
{
    if ASCEND_IS_AIC {
        LocalTensor<uint8_t> ub(TPosition::VECIN, 0, 8192);
        copy_ubuf_to_gm((__gm__ void*)outGm, (__ubuf__ void*)ub.GetPhyAddr(), 0, 1, 256, 0, 0);
    }
    if ASCEND_IS_AIV {
        (void)inGm;
    }
}
