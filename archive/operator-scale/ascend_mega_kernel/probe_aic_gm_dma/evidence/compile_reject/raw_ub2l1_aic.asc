// raw_ub2l1_aic.asc —— 编译期取证：AIC 分支直接调 raw intrinsic copy_ubuf_to_cbuf（UB→L1）。
// 预期：bisheng 在 AIC 目标上拒绝。
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
using namespace AscendC;

__global__ __mix__(1, 2) void raw_ub2l1(__gm__ uint8_t* inGm, __gm__ uint8_t* outGm)
{
    if ASCEND_IS_AIC {
        LocalTensor<uint8_t> ub(TPosition::VECIN, 0, 8192);
        LocalTensor<uint8_t> l1(TPosition::A1, 0, 8192);
        copy_ubuf_to_cbuf((__cbuf__ void*)l1.GetPhyAddr(), (__ubuf__ void*)ub.GetPhyAddr(), 0, 1, 256, 0, 0);
    }
    if ASCEND_IS_AIV {
        (void)inGm; (void)outGm;
    }
}
