// raw_gm2ub_aic.asc —— 编译期取证：AIC 分支直接调 raw intrinsic copy_gm_to_ubuf（GM→UB）。
// 预期：bisheng 在 AIC 目标上拒绝（UB 的 MTE2 归 AIV）。
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
using namespace AscendC;

__global__ __mix__(1, 2) void raw_gm2ub(__gm__ uint8_t* inGm, __gm__ uint8_t* outGm)
{
    if ASCEND_IS_AIC {
        LocalTensor<uint8_t> ub(TPosition::VECIN, 0, 8192);
        copy_gm_to_ubuf((__ubuf__ void*)ub.GetPhyAddr(), (__gm__ void*)inGm, 0, 1, 256, 0, 0);
    }
    if ASCEND_IS_AIV {
        (void)outGm;
    }
}
