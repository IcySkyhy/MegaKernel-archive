/**
 * probe_aic_gm_dma.asc —— M141：AIC（cube 核）UB→GM 能力的最小可证伪探针。
 *
 * 人类对 M136/M134 方向的既有纠正（逐字）：
 *   「AIC写GM用的是FIXP，而不是MTE3，所以你这个同步本来就是错的呀」。
 * 本探针只回答一个可证伪问题：**AIC 能否把数据从 UB 搬到 GM；若不能，卡在哪条腿**
 *   （指令不存在 / 编译期拒绝 / 运行期不落盘 / 需要 FIXP 而非 MTE2/MTE3）。
 * 不外推到业务核：本档是合成形状，只写设备读数直接支持的东西。
 *
 * 被测形态：`__global__ __mix__(1, 2)`，blockDim = AIC 核数，**只让 AICore 0 的 AIC 干活**
 * （除 `aiv_ub2gm` 这一条 AIV 正对照外，AIV 立即返回、不参与数据面）。
 * 形状：OUT_ELEMS = 64*64 fp32 = 16384 字节。GM 出口先由 host 预置 sentinel（-12345.0f）。
 *
 * 变体（argv[1]，完整清单 `./build/probe_aic_gm_dma list`）：
 *   fixp_l0c2gm    — 对照腿：AIC Mmad→L0C(=128) → FIXP `Fixpipe` L0C→GM（预期落盘一致）
 *   ub2gm_api      — 被测：AIC 经 L1 把已知数据填进 UB → 基础 API `DataCopy(GM, UB)`（预期不落盘）
 *   ub2gm_capi     — 被测：同上，改用 C API `asc_copy_ub2gm`（预期不落盘）
 *   aiv_ub2gm      — 正对照（AIV）：AIV `DataCopy(GM→UB)` + `DataCopy(UB→GM)`（验证该指令与判据可用）
 *   neg_fixp_short — 负对照：同 fixp_l0c2gm，但 FIXP `nSize=32`（故意写半宽）⇒ 判据必须变红
 *   aic_scalar_ub  — 隔离：AIC **标量读写 UB**（预期 aicore 异常 271、不返回；证明 AIC 无法回读自己 UB）
 *
 * 编译期硬读数（不经设备）：raw intrinsic `copy_ubuf_to_gm`（UB→GM 的 MTE3）在 AIC 分支被 bisheng
 *   **直接拒绝**；`copy_ubuf_to_cbuf`（UB→L1）、`copy_gm_to_ubuf`（GM→UB）同样被拒，而
 *   `copy_cbuf_to_ubuf`（L1→UB）与基础 API `DataCopy(GM,UB)` 被接受
 *   （原样诊断与命令见 evidence/compile_reject/）。
 *
 * 用法：./build/probe_aic_gm_dma <variant|id> [runNo] [outdir] [--trace]
 * 退出码：0 = 返回且与 host 期望逐元素一致；1 = 返回但有差异；2 = launch 失败/参数错；124（timeout）= 未返回
 *
 * 复用机制（带 文件:行；仓库内既有探针）：
 *   · 独立 __mix__(1,2) kernel + 自带 CMakeLists + run_probe.sh 的工程形态与 flock 纪律：
 *     probe_crosscore_tail/CMakeLists.txt:1-31、probe_crosscore_tail/run_probe.sh:1-96；
 *     设备槽 slot 纪律另参 probe_ub2l1/evidence/slot.sh:1-63。
 *   · host 侧 ACL 装载 / `<<<blockDim>>>` 启动 / 逐元素对拍：
 *     probe_crosscore_tail/probe_crosscore_tail.asc:600-740。
 *   · FIXP L0C→GM 对照腿的小助手（GmToL1Nz / LoadL0Bf16 / MmadBf16 / FixpToGm）：
 *     probe_crosscore_tail/probe_crosscore_tail.asc:187-273。
 *   · L1→UB 的 C API 走法 `asc_copy_l12ub`：probe_ub2l1/probe_ub2l1.asc:178-179。
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cstdint>
#include <vector>

namespace pagd {
using namespace AscendC;

// ------------------------------------------------------------------
// 形状（与 M134 同源，便于复用 FIXP 对照腿的小助手）
// ------------------------------------------------------------------
constexpr uint32_t M_DIM = 64;
constexpr uint32_t N_DIM = 64;
constexpr uint32_t K_DIM = 128;

constexpr uint32_t OUT_ELEMS = M_DIM * N_DIM;          // 4096 fp32
constexpr uint32_t OUT_BYTES = OUT_ELEMS * 4u;         // 16384

constexpr uint32_t L1_SLICE_BYTES = M_DIM * K_DIM * 2u;  // bf16 [64,128] = 16384
constexpr uint32_t L1_A0_OFF = 0;
constexpr uint32_t L1_B_OFF = L1_SLICE_BYTES;
constexpr uint32_t L1_TOTAL = L1_B_OFF + L1_SLICE_BYTES;

constexpr uint32_t L0C_SLOT_ELEMS = M_DIM * N_DIM;
constexpr uint32_t L0C_SLOT_BYTES = L0C_SLOT_ELEMS * 4u;

constexpr uint32_t UB_OFF = 0;
constexpr uint32_t UB_BYTES = OUT_BYTES;

// host 与 device 共用的常量（判据靠它们区分「落盘」与「没落盘」）
constexpr float SENTINEL = -12345.0f;   // host 预置的 GM 出口初值
constexpr float FIXP_VAL = 128.0f;      // A0=1s, B=1s, K=128 ⇒ L0C 全 128

// 已知数据模式：pat(i) = 1.0f + i（i < 2^24 时 fp32 精确 ⇒ 可逐位比较）
__aicore__ __inline__ float PatOf(uint32_t i) { return 1.0f + static_cast<float>(i); }

// ------------------------------------------------------------------
// 变体
// ------------------------------------------------------------------
enum Variant {
    V_FIXP_L0C2GM = 0,       // 对照：AIC L0C→GM 经 FIXP
    V_UB2GM_API = 1,         // 被测：AIC UB→GM 基础 API
    V_UB2GM_CAPI = 2,        // 被测：AIC UB→GM C API
    V_AIV_UB2GM = 3,         // 正对照：AIV UB→GM
    V_NEG_FIXP_SHORT = 4,    // 负对照：FIXP 半宽
    V_AIC_SCALAR_UB = 5,     // 隔离：AIC 标量读写 UB（预期 aicore 异常 271）
};

struct VarInfo { const char* name; uint32_t id; const char* note; };
const VarInfo kVariants[] = {
    {"fixp_l0c2gm", V_FIXP_L0C2GM, "AIC Mmad->L0C->FIXP->GM (control leg, expect landing)"},
    {"ub2gm_api", V_UB2GM_API, "AIC UB->GM via basic DataCopy (expect NO landing)"},
    {"ub2gm_capi", V_UB2GM_CAPI, "AIC UB->GM via C API asc_copy_ub2gm (expect NO landing)"},
    {"aiv_ub2gm", V_AIV_UB2GM, "AIV GM->UB->GM positive control (harness/instruction sanity)"},
    {"neg_fixp_short", V_NEG_FIXP_SHORT, "FIXP half-width negative control (criterion must go red)"},
    {"aic_scalar_ub", V_AIC_SCALAR_UB, "AIC scalar read/write UB (expect aicore fault 271, no return)"},
};
const uint32_t kNVar = sizeof(kVariants) / sizeof(kVariants[0]);

// ------------------------------------------------------------------
// 搬运 / cube 小助手（沿用 probe_crosscore_tail.asc:187-273 的写法）
// ------------------------------------------------------------------
template <typename T>
__aicore__ __inline__ void GmToL1Nz(const LocalTensor<uint8_t>& dstL1, const GlobalTensor<T>& srcGm,
                                    uint64_t gmElemOff, uint16_t ndNum, uint16_t rowsPerMatrix, uint32_t cols,
                                    uint64_t srcMatStride, uint64_t srcRowPitch, uint16_t dstRowsTotal)
{
    Nd2NzParams par;
    par.ndNum = ndNum;
    par.nValue = rowsPerMatrix;
    par.dValue = cols;
    par.srcNdMatrixStride = srcMatStride;
    par.srcDValue = srcRowPitch;
    par.dstNzC0Stride = dstRowsTotal;
    par.dstNzNStride = 1;
    par.dstNzMatrixStride = 16u * 16u;
    DataCopy(dstL1.template ReinterpretCast<T>(), srcGm[gmElemOff], par);
}

__aicore__ __inline__ void LoadL0Bf16(const LocalTensor<uint8_t>& dstL0, const LocalTensor<uint8_t>& srcL1,
                                      uint64_t srcElemOff, uint64_t dstElemOff, uint16_t mStep, uint16_t kStep,
                                      uint16_t srcStride, uint16_t dstStride)
{
    LocalTensor<bfloat16_t> src = srcL1.ReinterpretCast<bfloat16_t>()[srcElemOff];
    LocalTensor<bfloat16_t> dst = dstL0.ReinterpretCast<bfloat16_t>()[dstElemOff];
    LoadData2DParamsV2 lp;
    lp.mStartPosition = 0;
    lp.kStartPosition = 0;
    lp.mStep = mStep;
    lp.kStep = kStep;
    lp.srcStride = (int32_t)srcStride;
    lp.dstStride = dstStride;
    lp.ifTranspose = false;
    lp.sid = 0;
    LoadData(dst, src, lp);
}

__aicore__ __inline__ void MmadBf16(const LocalTensor<uint8_t>& cL0C, uint64_t cElemOff,
                                    const LocalTensor<uint8_t>& aL0, uint64_t aElemOff,
                                    const LocalTensor<uint8_t>& bL0)
{
    MmadParams mp;
    mp.m = (uint16_t)M_DIM;
    mp.n = (uint16_t)N_DIM;
    mp.k = (uint16_t)K_DIM;
    mp.cmatrixInitVal = true;
    mp.cmatrixSource = false;
    Mmad(cL0C.template ReinterpretCast<float>()[cElemOff],
         aL0.template ReinterpretCast<bfloat16_t>()[aElemOff],
         bL0.template ReinterpretCast<bfloat16_t>(), mp);
}

// FIXP L0C -> GM（对照腿；nSize 可改成 32 做负对照）
__aicore__ __inline__ void FixpToGm(const GlobalTensor<float>& dstGm, uint64_t gmElemOff,
                                    const LocalTensor<uint8_t>& srcL0C, uint64_t srcElemOff, uint16_t nSize)
{
    FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
    fp.nSize = nSize;
    fp.mSize = (uint16_t)M_DIM;
    fp.srcStride = (uint16_t)M_DIM;
    fp.dstStride = (uint16_t)N_DIM;
    fp.reluScalar = 0;
    fp.vectorRelu = 0;
    fp.deqScalar = 0;
    static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
    Fixpipe<float, float, kFixGm>(dstGm[gmElemOff], srcL0C.template ReinterpretCast<float>()[srcElemOff], fp);
}

// UB <- inGm（经 L1 的 AIC 通路：asc_copy_gm2l1 + asc_copy_l12ub）。
// 只用于「让 UB 里已有确定数据」，与「UB→GM 这条被测腿」无关。
__aicore__ __inline__ void FillUbFromGm(const LocalTensor<uint8_t>& l1, const LocalTensor<uint8_t>& ub,
                                        __gm__ uint8_t* inGm)
{
    asc_copy_gm2l1((__cbuf__ void*)l1.GetPhyAddr(), (__gm__ void*)inGm, 1u, OUT_BYTES, 0u, 0u, 0u);
    PipeBarrier<PIPE_ALL>();
    asc_copy_l12ub((__ubuf__ void*)ub.GetPhyAddr(), (__cbuf__ void*)l1.GetPhyAddr(), false, 1u,
                   (uint16_t)(OUT_BYTES / 32u), 0u, 0u);
    PipeBarrier<PIPE_ALL>();
}

// ------------------------------------------------------------------
// kernel
// ------------------------------------------------------------------
__global__ __mix__(1, 2) void probe_kernel(__gm__ uint8_t* aGm, __gm__ uint8_t* bGm, __gm__ uint8_t* inGm,
                                            __gm__ uint8_t* outGm, uint32_t variant, uint32_t trace)
{
    AscendC::InitSocState();

    if ASCEND_IS_AIC {
        if (GetBlockIdx() != 0u) {
            return;   // 只留 AICore 0 的 AIC
        }

        GlobalTensor<bfloat16_t> aG, bG;
        GlobalTensor<float> inG, outG;
        aG.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(aGm));
        bG.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(bGm));
        inG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inGm));
        outG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outGm));

        LocalTensor<uint8_t> l1(TPosition::A1, L1_A0_OFF, L1_TOTAL);
        LocalTensor<uint8_t> l1b(TPosition::A1, L1_B_OFF, L1_SLICE_BYTES);
        LocalTensor<uint8_t> l0a(TPosition::A2, 0, L1_SLICE_BYTES);
        LocalTensor<uint8_t> l0b(TPosition::B2, 0, L1_SLICE_BYTES);
        LocalTensor<uint8_t> l0c(TPosition::CO1, 0, L0C_SLOT_BYTES);
        LocalTensor<uint8_t> ub(TPosition::VECIN, UB_OFF, UB_BYTES);
        __ubuf__ float* ubF = reinterpret_cast<__ubuf__ float*>(ub.GetPhyAddr());

        if (trace) {
            printf("[PAGD][AIC] enter variant=%u\n", variant);
        }

        if (variant == V_FIXP_L0C2GM || variant == V_NEG_FIXP_SHORT) {
            // ---- 对照腿：A0=1s, B=1s -> L1 -> L0；Mmad -> L0C=128；FIXP -> GM ----
            GmToL1Nz<bfloat16_t>(l1, aG, 0, 1, (uint16_t)M_DIM, K_DIM, 0, K_DIM, (uint16_t)M_DIM);
            GmToL1Nz<bfloat16_t>(l1b, bG, 0, 1, (uint16_t)N_DIM, K_DIM, 0, K_DIM, (uint16_t)N_DIM);
            SetFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);
            WaitFlag<HardEvent::MTE2_MTE1>(EVENT_ID0);

            LoadL0Bf16(l0a, l1, 0, 0, (uint16_t)(M_DIM / 16u), (uint16_t)(K_DIM / 16u), (uint16_t)(M_DIM / 16u),
                       (uint16_t)(M_DIM / 16u));
            LoadL0Bf16(l0b, l1b, 0, 0, (uint16_t)(N_DIM / 16u), (uint16_t)(K_DIM / 16u), (uint16_t)(N_DIM / 16u),
                       (uint16_t)(N_DIM / 16u));
            SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
            WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);

            MmadBf16(l0c, 0, l0a, 0, l0b);
            SetFlag<HardEvent::M_FIX>(EVENT_ID0);
            WaitFlag<HardEvent::M_FIX>(EVENT_ID0);

            // 负对照：故意只写半宽（32/64 列），host 判据仍按全宽期望 ⇒ 必须变红
            const uint16_t nSize = (variant == V_NEG_FIXP_SHORT) ? (uint16_t)(N_DIM / 2u) : (uint16_t)N_DIM;
            FixpToGm(outG, 0, l0c, 0, nSize);
            PipeBarrier<PIPE_ALL>();
        } else if (variant == V_UB2GM_API) {
            FillUbFromGm(l1, ub, inGm);
            DataCopy(outG, ub.ReinterpretCast<float>(), OUT_ELEMS);   // 被测腿：基础 API UB->GM
            PipeBarrier<PIPE_ALL>();
        } else if (variant == V_UB2GM_CAPI) {
            FillUbFromGm(l1, ub, inGm);
            asc_copy_ub2gm((__gm__ void*)outGm, (__ubuf__ void*)ub.GetPhyAddr(), OUT_BYTES);  // 被测腿：C API
            PipeBarrier<PIPE_ALL>();
        } else if (variant == V_AIC_SCALAR_UB) {
            // 隔离：AIC **标量**直接读写 UB。
            // 这是「AIC 侧 UB 内容能否被回读」的直接探针；实测预期是 aicore 异常 271
            // （plog: "The address for scalar to access the internal buffer is out of bounds"）。
            for (uint32_t i = 0; i < OUT_ELEMS; ++i) {
                ubF[i] = PatOf(i);   // AIC 标量写 UB
            }
            PipeBarrier<PIPE_ALL>();
            for (uint32_t i = 0; i < OUT_ELEMS; ++i) {
                outG.SetValue(i, ubF[i]);   // 标量读回 UB -> GM
            }
            PipeBarrier<PIPE_ALL>();
        }
        if (trace) {
            printf("[PAGD][AIC] done variant=%u\n", variant);
        }
        return;
    }

    if ASCEND_IS_AIV {
        if (GetBlockIdx() > 0u) {
            return;   // 只留 AICore 0 的 AIV0
        }
        if (variant != V_AIV_UB2GM) {
            return;   // AIV 不参与其它变体的数据面
        }
        GlobalTensor<float> inG, outG;
        inG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inGm));
        outG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(outGm));
        LocalTensor<uint8_t> ub(TPosition::VECIN, UB_OFF, UB_BYTES);
        DataCopy(ub.ReinterpretCast<float>(), inG, OUT_ELEMS);   // GM->UB
        SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
        DataCopy(outG, ub.ReinterpretCast<float>(), OUT_ELEMS);  // UB->GM（AIV 上的正对照）
        PipeBarrier<PIPE_ALL>();
        return;
    }
}

// ------------------------------------------------------------------
// host 侧：变体解析 + 判据
// ------------------------------------------------------------------
__host__ int FindVariant(const char* s, uint32_t* out)
{
    for (uint32_t i = 0; i < kNVar; ++i) {
        if (strcmp(s, kVariants[i].name) == 0) { *out = kVariants[i].id; return (int)i; }
    }
    if (s[0] >= '0' && s[0] <= '9') {
        for (uint32_t i = 0; i < kNVar; ++i) {
            if ((uint32_t)atoi(s) == kVariants[i].id) { *out = kVariants[i].id; return (int)i; }
        }
    }
    return -1;
}

__host__ bool ExpectsLanding(uint32_t v)
{
    return v == V_FIXP_L0C2GM || v == V_NEG_FIXP_SHORT || v == V_AIV_UB2GM;
}

__host__ float HostPat(uint32_t i) { return 1.0f + static_cast<float>(i); }

__host__ int RunHost(int argc, char** argv)
{
    if (argc >= 2 && strcmp(argv[1], "list") == 0) {
        for (uint32_t i = 0; i < kNVar; ++i) {
            printf("  %-16s id=%u  %s\n", kVariants[i].name, kVariants[i].id, kVariants[i].note);
        }
        return 0;
    }
    if (argc < 2) {
        fprintf(stderr, "usage: %s <variant|id> [runNo] [outdir] [--trace]\n", argv[0]);
        return 2;
    }
    uint32_t vid = 0;
    const int vi = FindVariant(argv[1], &vid);
    if (vi < 0) {
        fprintf(stderr, "unknown variant: %s\n", argv[1]);
        return 2;
    }
    const int runNo = (argc >= 3) ? atoi(argv[2]) : 1;
    const char* outdir = (argc >= 4 && argv[3][0] != '-') ? argv[3] : nullptr;   // 给了就落盘 GM 出口字节
    uint32_t trace = 0;
    for (int i = 1; i < argc; ++i) {
        if (strcmp(argv[i], "--trace") == 0) trace = 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    int64_t aicNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("SUMMARY variant=%s run=%d launch=FAILED corenum rc=2\n", kVariants[vi].name, runNo);
        aclFinalize();
        return 2;
    }
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t aBytes = (size_t)M_DIM * K_DIM * sizeof(uint16_t);
    const size_t bBytes = (size_t)N_DIM * K_DIM * sizeof(uint16_t);
    const size_t ioBytes = (size_t)OUT_BYTES;

    void* dA = nullptr; void* dB = nullptr; void* dIn = nullptr; void* dOut = nullptr;
    aclrtMalloc(&dA, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dB, bBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dIn, ioBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOut, ioBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    std::vector<uint16_t> hA((size_t)M_DIM * K_DIM, 0x3F80u), hB((size_t)N_DIM * K_DIM, 0x3F80u);

    // inGm：UB 填充 / AIV 控制 / 落盘判据共用同一份已知模式（= PatOf）
    std::vector<float> hIn(OUT_ELEMS);
    for (uint32_t i = 0; i < OUT_ELEMS; ++i) {
        hIn[i] = HostPat(i);
    }
    std::vector<float> hSent(OUT_ELEMS, SENTINEL);

    aclrtMemcpy(dA, aBytes, hA.data(), aBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dB, bBytes, hB.data(), bBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dIn, ioBytes, hIn.data(), ioBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dOut, ioBytes, hSent.data(), ioBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    probe_kernel<<<(uint32_t)aicNum, 0, stream>>>(reinterpret_cast<uint8_t*>(dA), reinterpret_cast<uint8_t*>(dB),
                                                  reinterpret_cast<uint8_t*>(dIn), reinterpret_cast<uint8_t*>(dOut),
                                                  vid, trace);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("SUMMARY variant=%s run=%d launch=FAILED err=%d rc=2\n", kVariants[vi].name, runNo, (int)err);
        aclrtFree(dA); aclrtFree(dB); aclrtFree(dIn); aclrtFree(dOut);
        aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
        return 2;
    }

    std::vector<float> hOut(OUT_ELEMS);
    aclrtMemcpy(hOut.data(), ioBytes, dOut, ioBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtFree(dA); aclrtFree(dB); aclrtFree(dIn); aclrtFree(dOut);
    aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();

    if (outdir != nullptr) {
        char path[512];
        snprintf(path, sizeof(path), "%s/out_%s_run%d.bin", outdir, kVariants[vi].name, runNo);
        FILE* fp = fopen(path, "wb");
        if (fp != nullptr) {
            fwrite(hOut.data(), 1, ioBytes, fp);
            fclose(fp);
        }
    }

    const bool landing = ExpectsLanding(vid);
    uint64_t mism = 0, sentinelHits = 0, patHits = 0, fixpHits = 0, zeroHits = 0;
    for (uint32_t i = 0; i < OUT_ELEMS; ++i) {
        const float got = hOut[i];
        float exp;
        if (landing) {
            exp = (vid == V_FIXP_L0C2GM || vid == V_NEG_FIXP_SHORT) ? FIXP_VAL : HostPat(i);
        } else {
            exp = SENTINEL;
        }
        if (got != exp) ++mism;
        if (got == SENTINEL) ++sentinelHits;
        if (got == HostPat(i)) ++patHits;
        if (got == FIXP_VAL) ++fixpHits;
        if (got == 0.0f) ++zeroHits;
    }
    const uint64_t landedHits = OUT_ELEMS - sentinelHits;
    const bool ok = (mism == 0);
    printf("SUMMARY variant=%s run=%d total=%u mismatched=%llu sentinel=%llu landed=%llu pat_hits=%llu "
           "fixp_hits=%llu zeros=%llu expects_landing=%d rc=%d\n",
           kVariants[vi].name, runNo, OUT_ELEMS, (unsigned long long)mism, (unsigned long long)sentinelHits,
           (unsigned long long)landedHits, (unsigned long long)patHits, (unsigned long long)fixpHits,
           (unsigned long long)zeroHits, landing ? 1 : 0, ok ? 0 : 1);
    return ok ? 0 : 1;
}

}   // namespace pagd

__host__ int main(int argc, char** argv) { return pagd::RunHost(argc, argv); }
