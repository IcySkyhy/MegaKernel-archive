/**
 * m5_swiglu_quant.asc —— Mega kernel M5：SwiGLU 融合 MXFP4 量化 epilogue（纯 AIV 核）
 * （GEMM#1 epilogue 融合，docs/09 §3 结论：SwiGLU 必须在量化前；
 *  donor：ops-nn/activation/swiglu_group_quant arch35
 *  （VFSwiGlu base.h:186-194 / VFComputeMaxExpMXFP4Vf :281-333 /
 *   VFComputeScaleMXFP4Vf :350-409 / VFComputeDataMXFP4Vf :428-482，
 *   调度参考 swiglu_mxfp4_quant_perf.h:117-192 原地接力形态）
 *  + ops-nn/activation/swi_glu impl.hpp:54-82 五元组；
 *  量化语义与 m2_mxfp4_quant 完全一致（OCP，bit-exact 对标
 *  torch_npu.npu_dynamic_mx_quant round_mode="round", scale_alg=0, group=32））。
 *
 * 功能：单 AIV 核将 bf16 gate_up GEMM 输出 x [m, 1280]（gate|up 拼接）逐行做
 *   SwiGLU → bf16 [m, 640] → 在线 MXFP4 量化：
 *   - swigluOut [m, 640]  bfloat16：SwiGLU 结果（校验/调试输出；layer kernel 中可裁剪）
 *   - qx        [m, 320]  uint8：e2m1 nibble 打包，byte = lo | (hi << 4)，lo=偶数 k
 *   - scale     [m, 20]   uint8：E8M0（bias-127），每 32 个元素 1 个 scale；
 *             kernel 内部按 uint16 对（2 个相邻 group 打包）经 DataCopyPad 写出，
 *             字节序与 [m, 20] 展完全一致（低字节=偶数 group）
 *   - m 运行时 1..256 逐行循环；K 方向 640 = 256+256+128，尾 tile 用重叠回退窗口
 *     [384, 640)（同 m2 思路，group 对齐、逐位一致重写，无 mask、无越界读）。
 *
 * 融合结构（原地接力，quant 不进 GM）：每行每 256-tile：
 *   GM --DataCopy(MTE2)--> UB(gate|up tile)
 *      --SwiGLU 五元组(VEC, fp32 寄存器)--> UB(swiglu bf16 tile)     （接力点：quant 直接读该 UB）
 *      --MaxExp/Scale/DataFP4(VEC, 同 m2)--> UB(qx tile + scale tile)
 *      --DataCopy/DataCopyPad(MTE3)--> GM(swigluOut / qx / scale)
 *
 * SwiGLU 语义（donor VFSwiGlu，fp32 路径）：
 *   silu(g) = g / (1 + exp(-g))；y = silu(gate) * up；fp32 计算，RNE 舍入回 bf16。
 *
 * 量化语义（OCP，与 m2 逐行一致）：
 *   maxexp  = max(bf16 bits & 0x7F80)  per 32-group
 *   shared  = max(maxexp, 0x0100) - 0x0100
 *   scale   = shared >> 7             (E8M0 字节；bf16 Inf/NaN 组 -> 0xFF)
 *   halfSc  = (shared == 0) ? 0 : (组 maxexp==0x7F80 ? 0x7F81(NaN) : 0x7F00 - shared)
 *                                     (非有限组的 NaN 覆盖见官方 :413，本核同源)
 *   xs      = RNE_bf16(x * halfSc)；q = e2m1 CAST_ROUND(xs)（远离零，-0 保留符号）
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal），release 用阻塞释放
 *   （mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK），不用 set_flag/wait_flag，不挂 PIPE_S：
 *     BUF_X (id 0) : MTE2 -> V   （gate|up tile 就绪）
 *     BUF_O (id 1) : V  -> MTE3 （swiglu/qx/scale tile 就绪，兼挡下一 tile 覆写）
 *
 * 3510 quirk（docs/05 §6）：AIV kernel 用 __vector__ __global__；
 *   全部 UB buffer 偏移 32B 对齐；只用 1D 连续 DataCopy（不触 Nd2Nz 行数=1 quirk）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cmath>

// ============================================================
// 编译期常量与静态资源表（UB 偏移 / BufferID 全部编译期静态分配）
// ============================================================

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr int64_t DIGIT_TWO = 2;
constexpr uint16_t MAX_EXP_FOR_BF16 = 0x7f80;
constexpr uint16_t MAX_EXP_FOR_FP8 = 0x00ff;
constexpr uint16_t NAN_CUSTOMIZATION = 0x7f81;   // 官方同名常量，见下 halfScale 覆盖
constexpr int16_t SHR_NUM_FOR_BF16 = 7;
constexpr uint16_t BF16_EXP_BIAS = 0x7f00;
constexpr uint16_t FP4_E2M1_BF16_MAX_EXP = 0x0100;
constexpr uint32_t VL_B16 = 128;   // 每 256B 向量寄存器 bf16 lane 数

constexpr CastTrait castTraitRM_Round = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                         RoundMode::CAST_ROUND};
// SwiGLU bf16<->fp32 cast trait（donor castTraitB162B32Even / castTraitB322B16Even；
// fp32->bf16 为 RNE（CAST_RINT），与 host F32ToBf16 / numpy f32_to_bf16 一致）
constexpr CastTrait castTraitB162B32Even = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                            RoundMode::UNKNOWN};
constexpr CastTrait castTraitB322B16Even = {RegLayout::ZERO, SatMode::NO_SAT, MaskMergeMode::ZEROING,
                                            RoundMode::CAST_RINT};

constexpr uint32_t GROUP = 32;      // MXFP4: 每 32 个元素共享 1 个 scale
constexpr uint32_t TILE = 256;      // 每 tile 元素数（SwiGLU 与 quant 共用，8 组）
constexpr uint32_t INTER = 640;     // SwiGLU 输出宽度（= moe_intermediate_size）
constexpr uint32_t IN = 2 * INTER;  // gate_up GEMM 输出宽度 1280（gate|up 拼接）

// ---- UB 静态布局（字节偏移；VECCALC 空间 248KB 内；偏移 32B 对齐，供 DataCopy）----
// UB_X 区 1536B：gate tile 512B @+0，up tile 512B @+512，尾部 512B  slack 供
// UNPACK_B16 整寄存器加载越界预读（数据被 mask 丢弃，不踩后续 buffer）。
constexpr uint32_t UB_X = 4 * 1024;                 // bf16 [256] gate + [256] up
constexpr uint32_t UB_SWIGLU = UB_X + 1536;         // bf16 [256] = 512B（SwiGLU 结果，quant 原地接力源）
constexpr uint32_t UB_QX = UB_SWIGLU + 512;         // int8 [128]（256 个 fp4 打包）= 128B
constexpr uint32_t UB_SCALE = UB_QX + 128;          // uint16 [4]（8 个 E8M0 打包）= 8B
constexpr uint32_t UB_HALF = UB_SCALE + 32;         // uint16 [8]（bf16 halfScale）= 16B
static_assert(UB_HALF + 32 <= 248 * 1024, "UB footprint exceeds 248KB");

// ---- BufferID（每核用户可用 0-27，静态分配）----
constexpr AscendC::MutexID BUF_X = 0;   // gate|up tile: MTE2 -> V
constexpr AscendC::MutexID BUF_O = 1;   // swiglu/qx/scale tile: V -> MTE3

// BufferID 语义封装：acquire 立即获取；release 用阻塞模式（mode=false = CANN 默认
// ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射访存落地，对跨 pipe 消费者可见。
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// ============================================================
// Kernel 实现
// ============================================================

class SwigluMxfp4Quant {
    static constexpr uint32_t PACKED_INTER = INTER / 2;   // 每行 qx 字节数 320
    static constexpr uint32_t GP = INTER / 64;            // 每行 scale uint16 对数 10
    static constexpr uint32_t FULL_TILES = INTER / TILE;  // 2
    static constexpr uint32_t NTILES = FULL_TILES + 1;    // 3（尾块走重叠窗口 [INTER-TILE, INTER)）

public:
    __aicore__ inline SwigluMxfp4Quant() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR swiglu, GM_ADDR qx, GM_ADDR scale, uint32_t m)
    {
        M = m;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M) * IN);
        swigluGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(swiglu), static_cast<uint64_t>(M) * INTER);
        qxGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(qx), static_cast<uint64_t>(M) * PACKED_INTER);
        scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(scale), static_cast<uint64_t>(M) * GP);
    }

    __aicore__ inline void Process()
    {
        // m 运行时 1..256：逐行循环（行间无依赖，行内逐 256-tile）
        for (uint32_t row = 0; row < M; ++row) {
            for (uint32_t t = 0; t < NTILES; ++t) {
                // 尾 tile（640%256==128）取回退窗口 [INTER-TILE, INTER) = [384, 640)，
                // 与前一 tile 重叠 128 元素；group 对齐（128%32==0），重叠区量化结果逐位一致。
                const uint32_t t0 = (t < FULL_TILES) ? t * TILE : INTER - TILE;
                ProcessTile(row, t0);
            }
        }
    }

private:
    __aicore__ inline void ProcessTile(uint32_t row, uint32_t t0)
    {
        const uint64_t xOff = static_cast<uint64_t>(row) * IN + t0;            // gate 段起点
        const uint64_t swigluOff = static_cast<uint64_t>(row) * INTER + t0;
        const uint64_t qxOff = static_cast<uint64_t>(row) * PACKED_INTER + t0 / 2;
        const uint64_t sOff = static_cast<uint64_t>(row) * GP + t0 / 64;       // uint16 单位

        // UB 静态 tensor（position + 字节偏移 + 大小，自管理地址）
        LocalTensor<bfloat16_t> gateL(TPosition::VECCALC, UB_X, TILE);
        LocalTensor<bfloat16_t> upL(TPosition::VECCALC, UB_X + TILE * sizeof(bfloat16_t), TILE);
        LocalTensor<bfloat16_t> swigluL(TPosition::VECCALC, UB_SWIGLU, TILE);
        LocalTensor<int8_t> qxL(TPosition::VECCALC, UB_QX, TILE / 2);
        LocalTensor<uint16_t> scaleL(TPosition::VECCALC, UB_SCALE, TILE / GROUP / 2);
        LocalTensor<uint16_t> halfL(TPosition::VECCALC, UB_HALF, TILE / GROUP);

        __ubuf__ bfloat16_t* gateUb = reinterpret_cast<__ubuf__ bfloat16_t*>(gateL.GetPhyAddr());
        __ubuf__ bfloat16_t* upUb = reinterpret_cast<__ubuf__ bfloat16_t*>(upL.GetPhyAddr());
        __ubuf__ bfloat16_t* swigluUb = reinterpret_cast<__ubuf__ bfloat16_t*>(swigluL.GetPhyAddr());
        __ubuf__ int8_t* qxUb = reinterpret_cast<__ubuf__ int8_t*>(qxL.GetPhyAddr());
        __ubuf__ uint16_t* scaleUb = reinterpret_cast<__ubuf__ uint16_t*>(scaleL.GetPhyAddr());
        __ubuf__ uint16_t* halfUb = reinterpret_cast<__ubuf__ uint16_t*>(halfL.GetPhyAddr());

        // ---- MTE2：GM -> UB（gate|up 同 tile 各 256 元素；acquire 挡上一 tile 的 V 消费）----
        BufAcquire<PIPE_MTE2>(BUF_X);
        DataCopy(gateL, xGm[xOff], TILE);
        DataCopy(upL, xGm[xOff + INTER], TILE);
        BufRelease<PIPE_MTE2>(BUF_X);

        // ---- V：SwiGLU（fp32 五元组，结果写 UB_SWIGLU）-> quant 原地接力（同 m2 三段式）----
        BufAcquire<PIPE_V>(BUF_X);   // 等 gate|up 就位
        BufAcquire<PIPE_V>(BUF_O);   // 等上一 tile 的 MTE3 读走输出
        SwigluComputeTile(gateUb, upUb, swigluUb);
        MxQuantComputeScale(swigluUb, scaleUb, halfUb);
        MxQuantComputeDataFP4(swigluUb, halfUb, qxUb);
        BufRelease<PIPE_V>(BUF_X);   // 输入读完，MTE2 可复用
        BufRelease<PIPE_V>(BUF_O);   // 输出写完且 drain，MTE3 可读

        // ---- MTE3：UB -> GM（swiglu 512B / qx 128B 普通拷贝；scale 8B 走 DataCopyPad 紧凑拷贝）----
        BufAcquire<PIPE_MTE3>(BUF_O);
        DataCopy(swigluGm[swigluOff], swigluL, TILE);
        DataCopy(qxGm[qxOff], qxL, TILE / 2);
        DataCopyExtParams scaleCopyParams{1, (TILE / GROUP / 2) * static_cast<uint32_t>(sizeof(uint16_t)), 0, 0, 0};
        DataCopyPad<uint16_t, PaddingMode::Compact>(scaleGm[sOff], scaleL, scaleCopyParams);
        BufRelease<PIPE_MTE3>(BUF_O);
    }

    // SwiGLU 五元组（donor VFSwiGlu base.h:186-194，fp32 寄存器路径）：
    //   silu(g) = g / (1 + exp(-g))；y = silu(gate) * up
    // 每迭代 64 元素（fp32 寄存器宽度 VL_FP32=64），256-tile = 4 迭代。
    // 640 = 10×64 整除，无尾块、无 mask；bf16 加载用 donor LoadInputData 同款
    // DIST_UNPACK_B16 整寄存器加载（尾部 64 元素预读被 cast mask 丢弃）。
    __aicore__ inline void SwigluComputeTile(__ubuf__ bfloat16_t* gateUb, __ubuf__ bfloat16_t* upUb,
                                             __ubuf__ bfloat16_t* swigluUb)
    {
        constexpr uint32_t VL = 64;           // fp32 寄存器 lane 数（256B / 4B）
        constexpr uint16_t LOOP = TILE / VL;  // 4
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> tg;
            RegTensor<bfloat16_t> tu;
            RegTensor<bfloat16_t> ty;
            RegTensor<float> g;
            RegTensor<float> u;
            RegTensor<float> y;
            RegTensor<float> v;
            uint32_t vl = VL;
            MaskReg dataMask = UpdateMask<float>(vl);
            for (uint16_t j = 0; j < LOOP; ++j) {
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tg, gateUb + j * VL);
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tu, upUb + j * VL);
                Cast<float, bfloat16_t, castTraitB162B32Even>(g, tg, dataMask);
                Cast<float, bfloat16_t, castTraitB162B32Even>(u, tu, dataMask);
                Muls(v, g, -1.0f, dataMask);
                Exp(v, v, dataMask);
                Adds(v, v, 1.0f, dataMask);
                Div(v, g, v, dataMask);
                Mul(y, v, u, dataMask);
                Cast<bfloat16_t, float, castTraitB322B16Even>(ty, y, dataMask);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(swigluUb + j * VL, ty, dataMask);
            }
        }
    }

    // 以下两段为 m2_mxfp4_quant 的 MxQuantComputeScale / MxQuantComputeDataFP4 逐行移植
    // （语义 bit-exact 对标 quant_ref.py / npu_dynamic_mx_quant OCP），输入改为 SwiGLU
    // 结果 UB tile（原地接力，不进 GM）。maxexp 全程留在寄存器（3510 上 reduced maxExp
    // 经 UB 回读不相干，见 donor 注释），只把 E8M0 scale 与 bf16 halfScale 写 UB。

    // 每 32-group max bf16 指数域（ReduceDataBlock）-> E8M0 scale + bf16 halfScale。
    // 一个 256-bf16 tile = 8 组。
    __aicore__ inline void MxQuantComputeScale(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* mxScaleLocalAddr,
                                               __ubuf__ uint16_t* halfScaleLocalAddr)
    {
        constexpr uint32_t groups = TILE / GROUP;  // 8
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<uint16_t> vdExpExtract0;
            RegTensor<uint16_t> vdExpExtract1;
            RegTensor<uint16_t> expMaskBF16;
            Duplicate(expMaskBF16, MAX_EXP_FOR_BF16);
            RegTensor<uint16_t> vdMaxExp;
            MaskReg Mask = CreateMask<uint16_t, MaskPattern::ALL>();
            MaskReg cmpResult;
            MaskReg zeroMask;
            MaskReg preMaskScale;
            RegTensor<uint16_t> maxExpValue;
            Duplicate(maxExpValue, FP4_E2M1_BF16_MAX_EXP);
            RegTensor<uint16_t> sharedExp;
            RegTensor<uint16_t> scaleValue;
            RegTensor<uint16_t> scaleBias;
            Duplicate(scaleBias, BF16_EXP_BIAS);
            RegTensor<uint16_t> halfScale;
            RegTensor<uint16_t> fp8NanRegTensor;
            Duplicate(fp8NanRegTensor, MAX_EXP_FOR_FP8);
            RegTensor<uint16_t> nanRegTensor;
            Duplicate(nanRegTensor, NAN_CUSTOMIZATION);
            RegTensor<uint16_t> zeroRegTensor;
            Duplicate(zeroRegTensor, 0);

            uint32_t nGroups = groups;
            preMaskScale = UpdateMask<uint16_t>(nGroups);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            And(vdExpExtract0, (RegTensor<uint16_t>&)vdExp0, expMaskBF16, Mask);
            And(vdExpExtract1, (RegTensor<uint16_t>&)vdExp1, expMaskBF16, Mask);
            Max(vdMaxExp, vdExpExtract0, vdExpExtract1, Mask);
            ReduceDataBlock<AscendC::Reg::ReduceType::MAX>(vdMaxExp, vdMaxExp, Mask);

            // E8M0 scale + bf16 halfScale（reduced register 直接派生）
            Compare<uint16_t, CMPMODE::NE>(cmpResult, vdMaxExp, expMaskBF16, preMaskScale);
            Compare<uint16_t, CMPMODE::LE>(zeroMask, vdMaxExp, maxExpValue, preMaskScale);
            Select<uint16_t>(vdMaxExp, maxExpValue, vdMaxExp, zeroMask);
            Sub(sharedExp, vdMaxExp, maxExpValue, preMaskScale);
            ShiftRights(scaleValue, sharedExp, SHR_NUM_FOR_BF16, preMaskScale);
            Select<uint16_t>(scaleValue, scaleValue, fp8NanRegTensor, cmpResult);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK_B16>(
                mxScaleLocalAddr, scaleValue, nGroups / 2, preMaskScale);
            Compare<uint16_t, CMPMODE::NE>(zeroMask, sharedExp, zeroRegTensor, preMaskScale);
            Sub(halfScale, scaleBias, sharedExp, preMaskScale);
            // 官方 add_rms_norm_dynamic_mx_quant_common.h:412-413 同源：组内非有限（±Inf/NaN）
            // 时把 halfScale 覆盖成 NAN_CUSTOMIZATION=0x7F81（bf16 NaN），使后续 Mul(±Inf, NaN)=NaN
            // -> Cast<fp4> = 0.0；否则 Mul(±Inf, 2^-126)=±Inf -> Cast 饱和成 ±6。
            // 官方 :401 Compare<uint16_t, CMPMODE::NE>(cmpResult, vdMaxExp, expMask=0x7F80) 得到的
            // mask 在此复用（置位取 src0=halfScale，清位取 src1=nanRegTensor）。
            Select<uint16_t>(halfScale, halfScale, nanRegTensor, cmpResult);
            Select<uint16_t>(halfScale, halfScale, zeroRegTensor, zeroMask);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE>(halfScaleLocalAddr, halfScale, nGroups, preMaskScale);
        }
    }

    // bf16 * halfScale -> fp4 打包（round_mode=round，即 CAST_ROUND 远离零舍入）
    __aicore__ inline void MxQuantComputeDataFP4(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* halfScaleLocalAddr,
                                                 __ubuf__ int8_t* outLocalAddr)
    {
        __VEC_SCOPE__
        {
            MaskReg dataMask1;
            RegTensor<uint16_t> halfScaleForMul;
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<fp4x2_e2m1_t> vdExp0FP4;
            RegTensor<fp4x2_e2m1_t> vdExp1FP4;
            uint32_t totalCount = TILE;
            dataMask1 = UpdateMask<bfloat16_t>(totalCount);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            LoadAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_E2B_B16>(
                halfScaleForMul, halfScaleLocalAddr, TILE / GROUP);
            Mul(vdExp0, vdExp0, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Mul(vdExp1, vdExp1, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Interleave(vdExp0, vdExp1, vdExp0, vdExp1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp0FP4, vdExp0, dataMask1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp1FP4, vdExp1, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp0FP4, 64, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp1FP4, 64, dataMask1);
        }
    }

private:
    uint32_t M;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<bfloat16_t> swigluGm;
    GlobalTensor<int8_t> qxGm;
    GlobalTensor<uint16_t> scaleGm;
};

} // namespace

__vector__ __global__ void swiglu_mxfp4_quant_kernel(GM_ADDR x, GM_ADDR swiglu, GM_ADDR qx, GM_ADDR scale,
                                                     uint32_t m)
{
    SwigluMxfp4Quant op;
    op.Init(x, swiglu, qx, scale, m);
    op.Process();
}

// ============================================================
// Host 侧：确定性随机输入生成 + CPU 参考（SwiGLU fp32 + quant_ref.py 移植）+ 校验
// ============================================================

// ---- bf16 编解码（RNE；host 无 libm 依赖之外的位操作 + 单精度乘）----
static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

// ---- SwiGLU CPU 参考（fp32，与 kernel 五元组同运算次序：
//      silu(g)=g/(1+expf(-g))，y=silu*up，RNE 回 bf16）----
static void RefSwiglu(const uint16_t* x, uint16_t* y, uint32_t m)
{
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t j = 0; j < 640; ++j) {
            const float g = Bf16ToF32(x[static_cast<size_t>(i) * 1280 + j]);
            const float u = Bf16ToF32(x[static_cast<size_t>(i) * 1280 + 640 + j]);
            const float silu = g / (1.0f + expf(-g));
            y[static_cast<size_t>(i) * 640 + j] = F32ToBf16(silu * u);
        }
    }
}

// ---- e2m1 编码（正档 {0,.5,1,1.5,2,3,4,6}，四舍五入远离零；
//      端口 quant_ref.py 的 np.digitize：tie 归上一档）----
// 符号位取 signbit(xs)（而非 quant_ref.py 字面的 xs<0）：硬件 CAST_ROUND 对 -0 保留
// 符号（nibble 8），而 xs<0 规则会把 -0 判成 +0。m2 通过生成器避开该角落（全零组只生成
// +0）；m5 的 SwiGLU 下溢会自然产生 -0 输出（实测 kernel 与 host silu 逐位一致，含 -0），
// 故参考侧直接对齐硬件符号语义，使全链对 -0 也逐字节一致。
static uint8_t F32ToE2M1Code(float xs)
{
    static const float kMids[7] = {0.25f, 0.75f, 1.25f, 1.75f, 2.5f, 3.5f, 5.0f};
    const bool neg = std::signbit(xs);
    float a = neg ? -xs : xs;
    uint8_t idx = 0;
    while (idx < 7 && a >= kMids[idx]) ++idx;
    return static_cast<uint8_t>(neg ? (idx | 0x8) : idx);
}

// ---- quant_ref.py ocp_dynamic_mx_quant 的 C 移植（与 m2 逐行一致）：
//      x [m,K] bf16 bits -> qx [m,K/2] u8（lohi）+ scale [m,K/32] u8（E8M0）----
static void RefQuantMxfp4(const uint16_t* x, uint8_t* qx, uint8_t* scale, uint32_t m, uint32_t k)
{
    const uint32_t g = k / 32;
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t grp = 0; grp < g; ++grp) {
            const uint16_t* xp = x + static_cast<size_t>(i) * k + grp * 32;
            uint16_t maxexp = 0;
            for (uint32_t j = 0; j < 32; ++j) {
                const uint16_t e = xp[j] & 0x7F80;
                if (e > maxexp) maxexp = e;
            }
            const bool isInf = (maxexp == 0x7F80);
            uint32_t me = maxexp;
            if (me < 0x0100u) me = 0x0100u;
            const uint32_t shared = me - 0x0100u;
            uint8_t sb = static_cast<uint8_t>(shared >> 7);
            if (isInf) sb = 0xFF;
            scale[static_cast<size_t>(i) * g + grp] = sb;
            uint16_t hs = static_cast<uint16_t>(0x7F00u - shared);
            if (shared == 0) hs = 0;
            if (isInf) hs = 0x7F81;
            const float hsF = Bf16ToF32(hs);
            for (uint32_t j = 0; j < 32; j += 2) {
                const float xs0 = Bf16ToF32(xp[j]) * hsF;
                const float xs1 = Bf16ToF32(xp[j + 1]) * hsF;
                const uint8_t lo = F32ToE2M1Code(Bf16ToF32(F32ToBf16(xs0)));
                const uint8_t hi = F32ToE2M1Code(Bf16ToF32(F32ToBf16(xs1)));
                qx[static_cast<size_t>(i) * (k / 2) + (grp * 32 + j) / 2] =
                    static_cast<uint8_t>(lo | (hi << 4));
            }
        }
    }
}

// ---- 确定性伪随机（与 m1/m2 的 Hash3 同风格：纯公式，无 rand 状态）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// ---- 确定性 bf16 gate|up 生成 ----
// 按输出 32-group（行内 20 组）选模式，覆盖量化角落 + SwiGLU 动态范围：
//   0 : up = copysign(0, gate) -> 输出恒 +0 零组（scale=0 / halfScale=0 路径，
//       且杜绝 -0 乘积：硬件 CAST_ROUND(-0)=-0 与 quant_ref 的 xs<0 取符号规则不同，同 m2 避开）
//   1 : 小整数档：gate/up 取 {±0.5, ±1, ±2, ±3}，输出中等幅值
//   2 : up = ±2^k 精确幂（尾数 0），gate 组内指数窗 -> 输出 mantissa 模式平移，tie 统计命中
//   其他 : gate/up 双随机，组内指数窗 [e-31, e]（gate e∈3..116，up e∈1..8），
//       宽动态范围 -> 覆盖 xs∈[4,8) 饱和区与跨组宽窗；指数下界杜绝次正规乘积
static void GenActivations(uint16_t* x, uint32_t m, uint32_t seed)
{
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t grp = 0; grp < 20; ++grp) {
            const uint32_t mode = Hash3(i, grp, seed) % 8;
            uint16_t* gate = x + static_cast<size_t>(i) * 1280 + grp * 32;
            uint16_t* up = gate + 640;
            if (mode == 0) {
                for (uint32_t j = 0; j < 32; ++j) {
                    const uint32_t h = Hash3(i * 32 + j, grp, seed + 1);
                    const uint32_t e = 2 + h % 100;   // gate 指数 2..101
                    gate[j] = static_cast<uint16_t>(((h >> 8) & 1 << 15) | (e << 7) | ((h >> 9) & 0x7F));
                    // up = ±0 且符号与 silu(gate)（即 gate）同号 -> 输出严格 +0.0
                    up[j] = static_cast<uint16_t>((gate[j] & 0x8000));   // 仅符号位，幅值 0
                }
                continue;
            }
            if (mode == 1) {
                static const uint16_t kG[8] = {0x3F80, 0xBF80, 0x4000, 0xC000, 0x3F00, 0xBF00, 0x4040, 0xC040};
                static const uint16_t kU[8] = {0x4000, 0x3F80, 0x4040, 0x3F00, 0xC000, 0xBF80, 0x4080, 0xC080};
                for (uint32_t j = 0; j < 32; ++j) {
                    const uint32_t h = Hash3(i * 32 + j, grp, seed + 2);
                    gate[j] = kG[h % 8];
                    up[j] = kU[(h >> 4) % 8];
                }
                continue;
            }
            if (mode == 2) {
                const uint32_t e = 3 + Hash3(i, grp, seed + 3) % 114;   // gate 组窗顶 3..116
                for (uint32_t j = 0; j < 32; ++j) {
                    const uint32_t hg = Hash3(i * 32 + j, grp, seed + 4);
                    const uint32_t sub = hg % 16;
                    const uint32_t ge = (e > sub) ? (e - sub) : 2;
                    gate[j] = static_cast<uint16_t>((((hg >> 8) & 1) << 15) | (ge << 7) | ((hg >> 9) & 0x7F));
                    const uint32_t hu = Hash3(i * 32 + j, grp, seed + 5);
                    const uint32_t ue = 1 + (hu % 8);   // up = ±2^(ue-127)，精确幂
                    up[j] = static_cast<uint16_t>((((hu >> 8) & 1) << 15) | (ue << 7));
                }
                continue;
            }
            // 双随机：gate 组内指数窗 [e-31, e]（e∈3..116），up 指数窗 [eu-15, eu]（eu∈1..8）
            const uint32_t e = 3 + Hash3(i, grp, seed + 6) % 114;
            const uint32_t eu = 1 + Hash3(i, grp, seed + 7) % 8;
            for (uint32_t j = 0; j < 32; ++j) {
                const uint32_t hg = Hash3(i * 32 + j, grp, seed + 8);
                const uint32_t sub = (j == 0) ? 0 : (hg % 32);
                const uint32_t ge = (e > sub) ? (e - sub) : 2;
                gate[j] = static_cast<uint16_t>((((hg >> 8) & 1) << 15) | (ge << 7) | ((hg >> 9) & 0x7F));
                const uint32_t hu = Hash3(i * 32 + j, grp, seed + 9);
                const uint32_t usub = hu % 16;
                const uint32_t ue = (eu > usub) ? (eu - usub) : 1;
                up[j] = static_cast<uint16_t>((((hu >> 8) & 1) << 15) | (ue << 7) | ((hu >> 9) & 0x7F));
            }
        }
    }
}

// ---- 非有限（±Inf / NaN）注入（任务 M32 用例）：在 gate|up 上按输出 32-group 覆盖 ----
//   kind 1：整组 amax=+Inf —— gate 全 +Inf、up 全 1.0 -> silu(+Inf)=+Inf -> 输出整组 +Inf
//   kind 2：组内部分元素 Inf —— 一个位置 (+Inf,1.0) -> +Inf；另一个 (4.0,-Inf) -> -Inf；
//           其余元素保持正常值（组 maxexp 仍为 0x7F80）
//   kind 3：NaN 组 —— gate 全 NaN（+/- 交替）、up 一处 NaN
// 注入组固定 grp%4==1（行内 20 组 -> 5 组），其余组保持 kind 0 正常取值，验证修复不外溢。
static constexpr uint16_t BF16_POS_INF = 0x7F80;
static constexpr uint16_t BF16_NEG_INF = 0xFF80;
static constexpr uint16_t BF16_NAN_P = 0x7FC0;
static constexpr uint16_t BF16_NAN_N = 0xFFC0;
static constexpr uint16_t BF16_ONE = 0x3F80;
static constexpr uint16_t BF16_FOUR = 0x4080;

static void InjectInf(uint16_t* x, uint32_t m, uint32_t seed, uint32_t kind)
{
    if (kind == 0) return;
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t grp = 1; grp < 20; grp += 4) {
            uint16_t* gate = x + static_cast<size_t>(i) * 1280 + grp * 32;
            uint16_t* up = gate + 640;
            if (kind == 1) {
                for (uint32_t j = 0; j < 32; ++j) {
                    gate[j] = BF16_POS_INF;
                    up[j] = BF16_ONE;
                }
            } else if (kind == 2) {
                const uint32_t p0 = Hash3(i, grp, seed + 11) % 32;
                const uint32_t p1 = (p0 + 1 + Hash3(i, grp, seed + 12) % 31) % 32;   // 保证 p1 != p0
                gate[p0] = BF16_POS_INF;
                up[p0] = BF16_ONE;
                gate[p1] = BF16_FOUR;
                up[p1] = BF16_NEG_INF;
            } else {
                for (uint32_t j = 0; j < 32; ++j) {
                    gate[j] = (j & 1) ? BF16_NAN_P : BF16_NAN_N;
                    up[j] = BF16_ONE;
                }
                up[1 % 32] = BF16_NAN_P;
            }
        }
    }
}

// ---- bf16 网格 ULP 距离（容差判定用；±0 视为同档）----
static uint32_t Bf16UlpDist(uint16_t a, uint16_t b)
{
    if ((a & 0x7FFF) == 0 && (b & 0x7FFF) == 0) return 0;   // ±0 同档
    // 非有限值（指数域 0x7F80=全 1）：同类即等——NaN 的符号/payload 不参与比对
    const bool aInf = (a & 0x7FFF) == 0x7F80;
    const bool bInf = (b & 0x7FFF) == 0x7F80;
    const bool aNan = ((a & 0x7F80) == 0x7F80) && ((a & 0x007F) != 0);
    const bool bNan = ((b & 0x7F80) == 0x7F80) && ((b & 0x007F) != 0);
    if (aInf && bInf) return (a == b) ? 0 : 1;              // +Inf / -Inf 各自同档
    if (aNan && bNan) return 0;
    if (aNan || bNan) return 0xFFFF;                        // 一边 NaN 一边非 NaN：不同档
    const int32_t d = static_cast<int32_t>(a) - static_cast<int32_t>(b);
    return static_cast<uint32_t>(d < 0 ? -d : d);
}

// ---- 可选：dump 落盘 ----
static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// 校验一个 (m, seed, infKind) 组合；返回 true = PASS
//（infKind != 0 时按 InjectInf 在 gate|up 上注入 ±Inf/NaN —— 任务 M32 的 ①②③ 三类用例）
static bool RunCase(aclrtStream stream, uint32_t m, uint32_t seed, uint32_t infKind = 0)
{
    const size_t xBytes = static_cast<size_t>(m) * 1280 * 2;
    const size_t yBytes = static_cast<size_t>(m) * 640 * 2;
    const size_t qxBytes = static_cast<size_t>(m) * 320;
    const size_t sBytes = static_cast<size_t>(m) * 20;

    uint16_t* xHost = nullptr;
    uint16_t* yHost = nullptr;          // kernel SwiGLU bf16 输出
    uint8_t *qxHost = nullptr, *sHost = nullptr;
    uint8_t *xDev = nullptr, *qxDev = nullptr, *sDev = nullptr;
    uint8_t* yDev = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&xHost), xBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&yHost), yBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&qxHost), qxBytes);
    aclrtMallocHost(reinterpret_cast<void**>(&sHost), sBytes);
    aclrtMalloc(reinterpret_cast<void**>(&xDev), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&yDev), yBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&qxDev), qxBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&sDev), sBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    GenActivations(xHost, m, seed);
    InjectInf(xHost, m, seed, infKind);
    aclrtMemcpy(xDev, xBytes, xHost, xBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    swiglu_mxfp4_quant_kernel<<<1, 0, stream>>>(xDev, yDev, qxDev, sDev, m);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M5][FAIL] m=%u seed=%u inf=%u kernel launch/sync error %d\n", m, seed, infKind, (int)launchErr);
        return false;
    }
    aclrtMemcpy(yHost, yBytes, yDev, yBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(qxHost, qxBytes, qxDev, qxBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(sHost, sBytes, sDev, sBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    // 调试：M5_DUMP=1 时保存 device 输出（交叉验证/定位用，按用例命名）
    if (getenv("M5_DUMP") != nullptr) {
        char name[80];
        snprintf(name, sizeof(name), "m%u_s%u_i%u_x.bin", m, seed, infKind); WriteBin(name, xHost, xBytes);
        snprintf(name, sizeof(name), "m%u_s%u_i%u_swiglu_device.bin", m, seed, infKind);
        WriteBin(name, yHost, yBytes);
        snprintf(name, sizeof(name), "m%u_s%u_i%u_qx_device.bin", m, seed, infKind); WriteBin(name, qxHost, qxBytes);
        snprintf(name, sizeof(name), "m%u_s%u_i%u_scale_device.bin", m, seed, infKind);
        WriteBin(name, sHost, sBytes);
    }

    // ---- (a) kernel SwiGLU bf16 vs CPU 参考：bf16 网格容差（max ULP <= 1）----
    uint16_t* refY = new uint16_t[m * 640];
    RefSwiglu(xHost, refY, m);
    uint32_t maxUlp = 0;
    size_t exact = 0;
    size_t nonFinMismatch = 0;
    for (size_t i = 0; i < static_cast<size_t>(m) * 640; ++i) {
        const uint32_t d = Bf16UlpDist(yHost[i], refY[i]);
        if (d == 0) ++exact;
        if (d > maxUlp) maxUlp = d;
        const bool gn = ((yHost[i] & 0x7F80) == 0x7F80);
        const bool rn = ((refY[i] & 0x7F80) == 0x7F80);
        if (gn != rn) ++nonFinMismatch;   // 有限/非有限归类不一致：只可能是真错
    }
    const size_t totalY = static_cast<size_t>(m) * 640;
    const bool passA = (maxUlp <= 1) && (nonFinMismatch == 0);
    printf("[M5] (a) silu bf16 m=%-3u seed=%u inf=%u: maxULP=%u exact=%zu/%zu 非有限归类不一致=%zu : %s\n", m, seed,
           infKind, maxUlp, exact, totalY, nonFinMismatch, passA ? "PASS" : "FAIL");

    // ---- (b) kernel MXFP4 vs CPU 量化参考：对 kernel 自己的 bf16 输出做量化，逐字节一致 ----
    uint8_t* refQx = new uint8_t[qxBytes];
    uint8_t* refS = new uint8_t[sBytes];
    RefQuantMxfp4(yHost, refQx, refS, m, 640);

    uint32_t failCount = 0;
    for (size_t i = 0; i < qxBytes && failCount < 5; ++i) {
        if (qxHost[i] != refQx[i]) {
            printf("[M5][FAIL] m=%u seed=%u inf=%u qx[%zu] got 0x%02x expect 0x%02x\n", m, seed, infKind, i,
                   qxHost[i], refQx[i]);
            ++failCount;
        }
    }
    for (size_t i = 0; i < sBytes && failCount < 5; ++i) {
        if (sHost[i] != refS[i]) {
            printf("[M5][FAIL] m=%u seed=%u inf=%u scale[%zu] got 0x%02x expect 0x%02x\n", m, seed, infKind, i,
                   sHost[i], refS[i]);
            ++failCount;
        }
    }
    const bool passB = (failCount == 0);
    printf("[M5] (b) mxfp4  m=%-3u seed=%u inf=%u: qx %zu B + scale %zu B bit-exact : %s\n", m, seed, infKind,
           qxBytes, sBytes, passB ? "PASS" : "FAIL");

    // 非有限用例附加见证：注入组数 / device 0xFF scale 数 / 注入组 nibble 非零数
    if (infKind != 0) {
        size_t injGroups = 0, sFF = 0, refFF = 0, nibNonZero = 0, nibNonZeroRef = 0;
        for (uint32_t i = 0; i < m; ++i) {
            for (uint32_t grp = 1; grp < 20; grp += 4) {
                ++injGroups;
                if (sHost[static_cast<size_t>(i) * 20 + grp] == 0xFF) ++sFF;
                if (refS[static_cast<size_t>(i) * 20 + grp] == 0xFF) ++refFF;
                for (uint32_t j = 0; j < 32; ++j) {
                    const size_t byte = static_cast<size_t>(i) * 320 + (grp * 32 + j) / 2;
                    const uint8_t nib = (j & 1) ? (qxHost[byte] >> 4) : (qxHost[byte] & 0x0F);
                    const uint8_t nibRef = (j & 1) ? (refQx[byte] >> 4) : (refQx[byte] & 0x0F);
                    if (nib != 0) ++nibNonZero;
                    if (nibRef != 0) ++nibNonZeroRef;
                }
            }
        }
        printf("[M5]   inf=%u 注入组=%zu/组总=%u device scale=0xFF %zu 组（参考 %zu），"
               "注入组 nibble 非零 %zu/%zu（参考 %zu；修复前应为 ±6 饱和码）\n",
               infKind, injGroups, m * 20, sFF, refFF, nibNonZero, injGroups * 32, nibNonZeroRef);
    }

    delete[] refY;
    delete[] refQx;
    delete[] refS;
    aclrtFree(xDev); aclrtFreeHost(xHost);
    aclrtFree(yDev); aclrtFreeHost(yHost);
    aclrtFree(qxDev); aclrtFreeHost(qxHost);
    aclrtFree(sDev); aclrtFreeHost(sHost);
    return passA && passB;
}

int32_t main(int32_t argc, char* argv[])
{
    // dump 模式：./m5_swiglu_quant dump <m> <seed> [infKind] 写出 x.bin / swiglu_ref.bin / qx_ref.bin /
    // scale_ref.bin（host 侧 C 参考链：SwiGLU -> MXFP4 量化；供 check_ref.py 与 numpy 算法交叉验证；
    //  infKind 1/2/3 = gate|up 注入 整组 +Inf / 部分 ±Inf / NaN 组 —— 任务 M32 的 ①②③ 用例）
    if (argc >= 4 && argv[1][0] == 'd') {
        const uint32_t m = static_cast<uint32_t>(atoi(argv[2]));
        const uint32_t seed = static_cast<uint32_t>(atoi(argv[3]));
        const uint32_t infKind = (argc >= 5) ? static_cast<uint32_t>(atoi(argv[4])) : 0u;
        const size_t xBytes = static_cast<size_t>(m) * 1280 * 2;
        const size_t yBytes = static_cast<size_t>(m) * 640 * 2;
        const size_t qxBytes = static_cast<size_t>(m) * 320;
        const size_t sBytes = static_cast<size_t>(m) * 20;
        uint16_t* xHost = new uint16_t[m * 1280];
        uint16_t* yRef = new uint16_t[m * 640];
        uint8_t* qxRef = new uint8_t[qxBytes];
        uint8_t* sRef = new uint8_t[sBytes];
        GenActivations(xHost, m, seed);
        InjectInf(xHost, m, seed, infKind);
        RefSwiglu(xHost, yRef, m);
        RefQuantMxfp4(yRef, qxRef, sRef, m, 640);
        char name[80];
        snprintf(name, sizeof(name), "m%u_s%u_i%u_x.bin", m, seed, infKind);
        bool ok = WriteBin(name, xHost, xBytes);
        snprintf(name, sizeof(name), "m%u_s%u_i%u_swiglu_ref.bin", m, seed, infKind);
        ok &= WriteBin(name, yRef, yBytes);
        snprintf(name, sizeof(name), "m%u_s%u_i%u_qx_ref.bin", m, seed, infKind);
        ok &= WriteBin(name, qxRef, qxBytes);
        snprintf(name, sizeof(name), "m%u_s%u_i%u_scale_ref.bin", m, seed, infKind);
        ok &= WriteBin(name, sRef, sBytes);
        printf("[M5] dump m=%u seed=%u inf=%u -> %s\n", m, seed, infKind, ok ? "ok" : "write failed");
        delete[] xHost; delete[] yRef; delete[] qxRef; delete[] sRef;
        return ok ? 0 : 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 覆盖：任务书要求 m=1 与 m=256（多组随机种子）；补充中间 m 验证动态 m 路径
    const uint32_t ms[] = {1, 2, 17, 128, 256};
    const uint32_t seeds[] = {0, 1, 2, 3, 4};

    bool allOk = true;
    for (uint32_t seed : seeds) {
        for (uint32_t m : ms) {
            allOk &= RunCase(stream, m, seed);
        }
    }

    // ---- 非有限（±Inf / NaN）用例（任务 M32）：SwiGLU 后量化段与 host 参考逐位一致 ----
    // 三类：1=整组 amax=+Inf；2=组内只有部分元素 Inf（+Inf/-Inf 各一）；3=NaN 组
    const uint32_t infMs[] = {1, 17, 256};
    for (uint32_t infKind = 1; infKind <= 3; ++infKind) {
        for (uint32_t seed = 0; seed < 3; ++seed) {
            for (uint32_t m : infMs) {
                allOk &= RunCase(stream, m, seed, infKind);
            }
        }
    }
    printf("[M5] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
