/**
 * probe_a_mrgsort4.asc —— 探针 A：3510 MrgSort 4 路归并的 index 丢失最小复现
 *
 * 背景（docs/05 §6.3 待复核项 #19，原文未归档）：M14 router 曾试 4 路 MrgSort
 *   validBit=0b1111 + elementLengths[0..3]=32 + src1..src4 = 4 个 Sort32 产出的
 *   32 对有序块 + repeatTimes=1 + ifExhaustedSuspension=false，现象是"src3/src4
 *   胜出元素的 index 写成 UB 默认值"；最终实现退化为 2 路归并树（validBit=0b0011，
 *   src3=src4=src2 占位，m7_router_topk/m7_router_topk.asc Merge2）。
 *
 * 本探针把当时的参数与逐条变参实验在同一份输入上重跑一遍，把输出逐元素 dump。
 *
 * ---- 数据契约（关键，决定了 dump 怎么读）----
 *   "1 对" = {fp32 value, uint32 index} = 8 字节（3510 上 MrgSort 的 elementLengths
 *   单位即"对"数，每对 8 字节；m7 的 Merge2 也是这么用的：pairLen=32 → 256B/块）。
 *   4 个输入块各 32 对（256B），在 UB 里连续排布（UB_IN+0/256/512/768），
 *   与 CANN 自带 TopK 实现（topk_v220_impl.h:77-79 用同一 tmp buffer 的 offset 拼
 *   4 个 src）一致。
 *
 *   块 b、组内序 j 的输入对：value = 1000 - 4j - b、index = 1000b + j
 *     - 组内 value 严格递减（块本身有序，满足 MrgSort 对输入的"各队列有序"要求）
 *     - 4 个块的值域交错（正确归并结果 = 按 value 降序的 128 对，k 外 b 内交错）
 *     - value 与 index 双射且值域不重叠：任何"value 对不上 index"或"index 是
 *       UB 残留值"都能在 dump 里一眼看出是哪一路的哪一项串了
 *
 * ---- UB 静态布局（字节偏移，全 32B 对齐；Layout 与 Host 输入 GM 一一对应）----
 *   UB_IN   =    0   1024B  4 块输入（各 256B）
 *   UB_DST  = 1024   2048B  4 路归并 dst（输出 1024B，后 1KB 是"越界写入观察窗"）
 *   UB_DST2 = 3072   1024B  归并树第二级 dst
 *   UB_TMP  = 4096   1024B  Sort32 输出 / 临时
 *   UB_S32I = 5120   1024B  Sort32 输入（fp32[128] + u32[128]）
 *   UB_END  = 6144
 *   整个 [0, UB_END) 在核尾原样 dump 回 GM（每变体 6144B），故"没写的地方"也留证。
 *
 * ---- 变体矩阵（kernel 参数 variant；预设模式 preset 见下）----
 *   A00 2way_v3_base        2 路基线：vb=0b0011 len=[32,32,0,0] src=b0,b1（+占位）
 *   A01 2way_tree_v3        2 路归并树（m7 现行实现）：3 次 2 路归并 -> 128 对
 *   A02 4way_v15            #19 原参数：vb=0b1111 len=[32,32,32,32] src=b0..b3 rep=1
 *   A03 4way_v15_zero       同 A02，但 dst 区预置全 0（"丢写"最直观的判据）
 *   A04 4way_v15_nopreset   同 A02，但 dst 区不预置（复现"UB 默认值"原始场景）
 *   A05 4way_v15_dst2       同 A02，dst 换到 UB_DST2（换地址/对齐）
 *   A06 3way_v7             vb=0b0111 len=[32,32,32,0]（2 路好的、4 路坏的，3 路？）
 *   A07 4way_v15_ph34_l0    vb=0b1111 但 len=[32,32,0,0] src3=src4=b1（占位+零长）
 *   A08 4way_v15_ph34_l32   vb=0b1111 len=[32,32,32,32] src3=src4=b1（占位+实长）
 *   A09 4way_v15_noncontig  vb=0b1111 len=[32,32,32,32] 但 src 地址序 b0,b2,b1,b3
 *                           （非连续：检验 CheckFunProposal 里 isContinuous 那条假设）
 *   A10 2way_v3_len16       2 路 len=[16,16,0,0]（elementLengths 单位=对数？）
 *   A11 4way_v15_len16      4 路 len=[16,16,16,16]（同上，4 路；输出应为 64 对）
 *   A12 4way_v15_rep2       同 A02，repeatTimes=2
 *   A13 4way_v15_exhtrue    同 A02，ifExhaustedSuspension=true
 *   A14 sort32_layout       只跑 Sort32（4 repeat）看它输出的对布局/方向（布局真值）
 *   A15 4way_v15_sort32src  同 A02 但 4 个 src 直接取 Sort32 输出（#19 原样复现）
 *   A16 4way_v15_allb0      vb=0b1111 且 src1..4 全 = b0（第 3/4 路到底读没读）
 *   A17 4way_v15_len4       4 路 len=[4,4,4,4]（输出应为 16 对，单位判据）
 *   A18 dst_alias_src1      dst = src1 地址（4 个 src 连续占 1024B，dst=区间首址 =
 *                           原地归并；只在"dst 与 src 重叠"假设下才可能坏）
 *   A19 dst_alias_src3      dst = src3 地址（只与 src3/src4 重叠）
 *   A20 sort32_nobar        A15 去掉 Sort32→MrgSort 之间的 VEC 障碍（同步假设）
 *   A21 4way_v15_rep0       repeatTimes=0（参数打错假设）
 *   A22 2way_v3_len4x32     validBit 只开 2 路而 elementLengths 4 项全 32（参数自相矛盾）
 *   A23 4way_v15_len0_all   vb=0b1111 且 len 全 0（是否完全不动 dst）
 *   A24 4way_v15_rep2_len8  vb=0b1111、len=[8,8,8,8]、repeatTimes=2（repeat 语义判据：
 *                           "每轮写同一 dst" ⇒ 只 32 对；"每轮 src/dst 前移" ⇒ 64 对）
 *   A25 4way_v15_len8       A24 的 repeatTimes=1 对照（len=[8,8,8,8]）
 *
 *   preset：0=不预置（DMA 跳过 dst 区拷贝）1=sentinel 0xDEADBEEF/0xBEEFDEAD 2=全 0
 *           A03 用 2，A04 用 0，其余 1。
 *
 * ---- 同步（遵循 docs/05 §6 + tower 转发裁决）----
 *   只用 BufferID：BUF_IN(0)=MTE2→V（阻塞释放 false=BLOCK），BUF_OUT(1)=V→MTE3（同）。
 *   同 pipe 背靠背 DataCopy 只落在不同 buffer 上；不依赖同 pipe 复用次序。
 *   LocalMemBar 只出现在 __VEC_SCOPE__ 内（M15 实证：VF 外下发 → 507035）。
 *   归并树各级之间按 m7 现成写法插 VEC_STORE→VEC_LOAD 障碍；跨 pipe 由 BufferID 承载。
 *
 * 构建/运行见 README.md；证据落在 evidence/。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;   // LocalMemBar / MemType 在 Reg 命名空间（m2/m7 同款）

// ---------------- 几何常量 ----------------
constexpr uint32_t PAIRS = 32;                        // 每输入块 32 对
constexpr uint32_t PAIR_B = 8;                        // 1 对 = {fp32 value, u32 index}
constexpr uint32_t BLK_B = PAIRS * PAIR_B;            // 256B
constexpr uint32_t NBLK = 4;
constexpr uint32_t IN_B = NBLK * BLK_B;               // 1024B

// ---------------- UB 静态布局（字节；见文件头）----------------
constexpr uint32_t UB_IN = 0;
constexpr uint32_t UB_DST = UB_IN + IN_B;             // 1024
constexpr uint32_t UB_DST_SPAN = 2048;                // 1024B 输出 + 1KB 观察窗
constexpr uint32_t UB_DST2 = UB_DST + UB_DST_SPAN;    // 3072
constexpr uint32_t UB_DST2_SPAN = 1024;
constexpr uint32_t UB_TMP = UB_DST2 + UB_DST2_SPAN;   // 4096
constexpr uint32_t UB_TMP_SPAN = 1024;
constexpr uint32_t UB_S32I = UB_TMP + UB_TMP_SPAN;    // 5120
constexpr uint32_t UB_S32I_SPAN = 1024;
constexpr uint32_t UB_END = UB_S32I + UB_S32I_SPAN;   // 6144
static_assert(UB_END <= 192 * 1024, "UB footprint too large");

// Host 输入 GM 与 UB 布局同构：in[0,1024) 输入块；in[1024,5120) dst 预置源；
// in[5120,6144) Sort32 输入（vals fp32[128] + ids u32[128]）。
constexpr uint32_t PRESET_B = UB_S32I - UB_DST;       // 4096
constexpr uint32_t DUMP_B = UB_END;                   // 每变体 dump 6144B

constexpr uint32_t PRESET_NONE = 0;
constexpr uint32_t PRESET_SENTINEL = 1;
constexpr uint32_t PRESET_ZERO = 2;

constexpr uint32_t SENT_VAL = 0xDEADBEEFu;
constexpr uint32_t SENT_IDX = 0xBEEFDEADu;

// ---------------- BufferID ----------------
constexpr AscendC::MutexID BUF_IN = 0;    // MTE2 -> V
constexpr AscendC::MutexID BUF_OUT = 1;   // V -> MTE3

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);  // 阻塞释放（BLOCK，CANN 默认）：UB 写对跨 pipe 消费者可见
}

template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

// ---------------- 变体编号 ----------------
enum VariantId : uint32_t {
    A00_2WAY_V3 = 0,
    A01_2WAY_TREE_V3,
    A02_4WAY_V15,
    A03_4WAY_V15_ZERO,
    A04_4WAY_V15_NOPRESET,
    A05_4WAY_V15_DST2,
    A06_3WAY_V7,
    A07_4WAY_V15_PH34_L0,
    A08_4WAY_V15_PH34_L32,
    A09_4WAY_V15_NONCONTIG,
    A10_2WAY_V3_LEN16,
    A11_4WAY_V15_LEN16,
    A12_4WAY_V15_REP2,
    A13_4WAY_V15_EXHTRUE,
    A14_SORT32_LAYOUT,
    A15_4WAY_V15_SORT32SRC,
    A16_4WAY_V15_ALLB0,
    A17_4WAY_V15_LEN4,
    A18_DST_ALIAS_SRC1,
    A19_DST_ALIAS_SRC3,
    A20_SORT32_NOBAR,
    A21_4WAY_V15_REP0,
    A22_2WAY_V3_LEN4X32,
    A23_4WAY_V15_LEN0_ALL,
    A24_4WAY_V15_REP2_LEN8,
    A25_4WAY_V15_LEN8,
    N_VARIANTS
};

struct MrgSpec {
    uint32_t dst;
    uint32_t src[4];
    uint16_t len[4];
    uint16_t vb;
    uint8_t rep;
    bool exh;
};

// 单次 MrgSort（MrgSort4Info 重载 = m7/M14 当时用的那一路）
__aicore__ inline void DoMerge(const MrgSpec& s)
{
    MrgSort4Info p;
    p.elementLengths[0] = s.len[0];
    p.elementLengths[1] = s.len[1];
    p.elementLengths[2] = s.len[2];
    p.elementLengths[3] = s.len[3];
    p.validBit = s.vb;
    p.repeatTimes = s.rep;
    p.ifExhaustedSuspension = s.exh;

    MrgSortSrcList<float> sl;
    sl.src1 = MkT<float>(s.src[0], 2u * s.len[0]);
    sl.src2 = MkT<float>(s.src[1], 2u * s.len[1]);
    sl.src3 = MkT<float>(s.src[2], 2u * s.len[2]);
    sl.src4 = MkT<float>(s.src[3], 2u * s.len[3]);
    const uint32_t outFloats = 2u * static_cast<uint32_t>(s.len[0] + s.len[1] + s.len[2] + s.len[3]) * s.rep;
    MrgSort(MkT<float>(s.dst, outFloats), sl, p);
}

// VF 内 UB 写->读障碍（M15 实证：LocalMemBar 落到 __VEC_SCOPE__ 外会 507035）
#define PROBE_VECBAR() \
    __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }

// ============================================================
// Kernel
// ============================================================
class MrgSortProbe {
public:
    __aicore__ inline void Init(GM_ADDR in, GM_ADDR out, uint32_t variant, uint32_t preset)
    {
        variant_ = variant;
        preset_ = preset;
        __gm__ uint8_t* inP = reinterpret_cast<__gm__ uint8_t*>(in);
        blkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inP), 2u * PAIRS * NBLK);
        presetGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(inP + UB_DST), PRESET_B);
        s32ValGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inP + UB_S32I), PAIRS * NBLK);
        s32IdxGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(inP + UB_S32I + PAIRS * NBLK * 4),
                                  PAIRS * NBLK);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(out), DUMP_B);
    }

    __aicore__ inline void Process()
    {
        // ---- MTE2：输入块 + dst 预置 + Sort32 输入 ----
        BufAcquire<PIPE_MTE2>(BUF_IN);
        DataCopy(MkT<float>(UB_IN, 2u * PAIRS * NBLK), blkGm_[0], 2u * PAIRS * NBLK);
        if (preset_ != PRESET_NONE) {
            DataCopy(MkT<int8_t>(UB_DST, PRESET_B), presetGm_[0], PRESET_B);
        }
        DataCopy(MkT<float>(UB_S32I, PAIRS * NBLK), s32ValGm_[0], PAIRS * NBLK);
        DataCopy(MkT<uint32_t>(UB_S32I + PAIRS * NBLK * 4, PAIRS * NBLK), s32IdxGm_[0], PAIRS * NBLK);
        BufRelease<PIPE_MTE2>(BUF_IN);

        // ---- V：变体 ----
        BufAcquire<PIPE_V>(BUF_IN);
        RunVariant();
        BufRelease<PIPE_V>(BUF_IN);
        BufAcquire<PIPE_V>(BUF_OUT);
        BufRelease<PIPE_V>(BUF_OUT);

        // ---- MTE3：整段 UB 回写 GM ----
        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(outGm_[0], MkT<int8_t>(0, DUMP_B), DUMP_B);
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    __aicore__ inline void RunVariant()
    {
        const uint32_t b0 = UB_IN + 0 * BLK_B;
        const uint32_t b1 = UB_IN + 1 * BLK_B;
        const uint32_t b2 = UB_IN + 2 * BLK_B;
        const uint32_t b3 = UB_IN + 3 * BLK_B;
        const uint32_t s32 = UB_TMP;
        const uint32_t s32b1 = UB_TMP + 1 * BLK_B;
        const uint32_t s32b2 = UB_TMP + 2 * BLK_B;
        const uint32_t s32b3 = UB_TMP + 3 * BLK_B;

        MrgSpec s;
        switch (variant_) {
            case A00_2WAY_V3:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b1, b1}, {32, 32, 0, 0}, 0b0011, 1, false});
                break;
            case A01_2WAY_TREE_V3: {
                // m7 现行 2 路归并树：level1 (b0,b1)->DST[0,64)、(b2,b3)->DST[64,128)；
                // level2 (DST[0,64), DST[64,128))->DST2 = 全序 128 对
                PROBE_VECBAR();
                DoMerge(MrgSpec{UB_DST, {b0, b1, b1, b1}, {32, 32, 0, 0}, 0b0011, 1, false});
                PROBE_VECBAR();
                DoMerge(MrgSpec{UB_DST + 512, {b2, b3, b3, b3}, {32, 32, 0, 0}, 0b0011, 1, false});
                PROBE_VECBAR();
                DoMerge(MrgSpec{UB_DST2, {UB_DST, UB_DST + 512, UB_DST + 512, UB_DST + 512}, {64, 64, 0, 0},
                                0b0011, 1, false});
                PROBE_VECBAR();
                break;
            }
            case A02_4WAY_V15:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A03_4WAY_V15_ZERO:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A04_4WAY_V15_NOPRESET:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A05_4WAY_V15_DST2:
                DoMerge(MrgSpec{UB_DST2, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A06_3WAY_V7:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b2}, {32, 32, 32, 0}, 0b0111, 1, false});
                break;
            case A07_4WAY_V15_PH34_L0:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b1, b1}, {32, 32, 0, 0}, 0b1111, 1, false});
                break;
            case A08_4WAY_V15_PH34_L32:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b1, b1}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A09_4WAY_V15_NONCONTIG:
                DoMerge(MrgSpec{UB_DST, {b0, b2, b1, b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A10_2WAY_V3_LEN16:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b1, b1}, {16, 16, 0, 0}, 0b0011, 1, false});
                break;
            case A11_4WAY_V15_LEN16:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {16, 16, 16, 16}, 0b1111, 1, false});
                break;
            case A12_4WAY_V15_REP2:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 2, false});
                break;
            case A13_4WAY_V15_EXHTRUE: {
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 1, true});
                // 附带取证：exhausted 语义下读 4 个"已完成队列元素数"（VMS4_SR），
                // 落到 UB_TMP[0..3]（本变体不用 UB_TMP），供 host 判读截断原因
                uint16_t l1 = 0, l2 = 0, l3 = 0, l4 = 0;
                GetMrgSortResult(l1, l2, l3, l4);
                LocalTensor<uint32_t> reg = MkT<uint32_t>(UB_TMP, 8);
                reg.SetValue(0, l1);
                reg.SetValue(1, l2);
                reg.SetValue(2, l3);
                reg.SetValue(3, l4);
                break;
            }
            case A14_SORT32_LAYOUT:
                PROBE_VECBAR();
                Sort32(MkT<float>(UB_TMP, 2u * PAIRS * NBLK), MkT<float>(UB_S32I, PAIRS * NBLK),
                       MkT<uint32_t>(UB_S32I + PAIRS * NBLK * 4, PAIRS * NBLK), NBLK);
                PROBE_VECBAR();
                break;
            case A15_4WAY_V15_SORT32SRC:
                PROBE_VECBAR();
                Sort32(MkT<float>(UB_TMP, 2u * PAIRS * NBLK), MkT<float>(UB_S32I, PAIRS * NBLK),
                       MkT<uint32_t>(UB_S32I + PAIRS * NBLK * 4, PAIRS * NBLK), NBLK);
                PROBE_VECBAR();
                DoMerge(MrgSpec{UB_DST, {s32, s32b1, s32b2, s32b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                PROBE_VECBAR();
                break;
            case A16_4WAY_V15_ALLB0:
                DoMerge(MrgSpec{UB_DST, {b0, b0, b0, b0}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A17_4WAY_V15_LEN4:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {4, 4, 4, 4}, 0b1111, 1, false});
                break;
            case A18_DST_ALIAS_SRC1:
                // dst 与 src1 同址（4 个 src 连续占 UB_IN 1024B，dst=区间首地址 = 原地归并）
                DoMerge(MrgSpec{b0, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A19_DST_ALIAS_SRC3:
                // dst = src3 地址（只与 src3/src4 重叠）
                DoMerge(MrgSpec{b2, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A20_SORT32_NOBAR:
                // A15 去掉 Sort32 与 MrgSort 之间的 VEC_STORE->VEC_LOAD 障碍（同步假设）
                Sort32(MkT<float>(UB_TMP, 2u * PAIRS * NBLK), MkT<float>(UB_S32I, PAIRS * NBLK),
                       MkT<uint32_t>(UB_S32I + PAIRS * NBLK * 4, PAIRS * NBLK), NBLK);
                DoMerge(MrgSpec{UB_DST, {s32, s32b1, s32b2, s32b3}, {32, 32, 32, 32}, 0b1111, 1, false});
                break;
            case A21_4WAY_V15_REP0:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b1111, 0, false});
                break;
            case A22_2WAY_V3_LEN4X32:
                // validBit 只开 2 路、但 elementLengths 4 项全给 32（参数自相矛盾时的行为）
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {32, 32, 32, 32}, 0b0011, 1, false});
                break;
            case A23_4WAY_V15_LEN0_ALL:
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {0, 0, 0, 0}, 0b1111, 1, false});
                break;
            case A24_4WAY_V15_REP2_LEN8:
                // repeatTimes=2 + len=8/路：区分"每轮都写同一 dst"（只留 32 对）与
                // "每轮 src/dst 都前移"（dst 里出现第二批 32 对）
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {8, 8, 8, 8}, 0b1111, 2, false});
                break;
            case A25_4WAY_V15_LEN8:
                // A24 的 rep=1 对照：界定 rep>1 的语义
                DoMerge(MrgSpec{UB_DST, {b0, b1, b2, b3}, {8, 8, 8, 8}, 0b1111, 1, false});
                break;
            default:
                // 未知变体：什么都不做（dump 里应看到纯预置内容）
                break;
        }
    }

    uint32_t variant_ = A00_2WAY_V3;
    uint32_t preset_ = PRESET_SENTINEL;
    GlobalTensor<float> blkGm_;
    GlobalTensor<int8_t> presetGm_;
    GlobalTensor<float> s32ValGm_;
    GlobalTensor<uint32_t> s32IdxGm_;
    GlobalTensor<int8_t> outGm_;
};

}   // namespace

__vector__ __global__ void probe_a_mrgsort4_kernel(GM_ADDR in, GM_ADDR out, uint32_t variant, uint32_t preset)
{
    MrgSortProbe op;
    op.Init(in, out, variant, preset);
    op.Process();
}

// ============================================================
// Host 侧：输入生成 + 变体表 + 结果判读 + dump
// ============================================================
namespace {

struct VariantDesc {
    const char* name;
    uint32_t preset;         // 0=不预置 1=sentinel 2=全 0（host 按此填预置源）
    uint32_t dst;            // 判读的 dst 区起始（UB 字节偏移）
    uint32_t srcBlk[4];      // src1..src4 各喂哪个输入块（0..3；A15 喂 Sort32 输出块，等价）
    uint16_t lens[4];        // MrgSort elementLengths
    bool srcFromSort32;      // 4 路 src 取 Sort32 输出（A15/A20）
    bool concatGroups;       // 期望 = 各组内部有序的 4 组拼接（Sort32 输出布局，A14）
    bool checkOrder;         // 是否判读"有序且与期望一致"（false = 只记录不做断言）
};

const VariantDesc kVariants[] = {
    // name                       preset            dst       src1..4          lens              s32    grp   check
    {"A00_2way_v3_base",          PRESET_SENTINEL, UB_DST,  {0,1,1,1},  {32, 32, 0, 0},   false, false, true},
    {"A01_2way_tree_v3",          PRESET_SENTINEL, UB_DST2, {0,1,2,3},  {32, 32, 32, 32}, false, false, true},
    {"A02_4way_v15",              PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, false, false, true},
    {"A03_4way_v15_zero",         PRESET_ZERO,     UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, false, false, true},
    {"A04_4way_v15_nopreset",     PRESET_NONE,     UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, false, false, true},
    {"A05_4way_v15_dst2",         PRESET_SENTINEL, UB_DST2, {0,1,2,3},  {32, 32, 32, 32}, false, false, true},
    {"A06_3way_v7",               PRESET_SENTINEL, UB_DST,  {0,1,2,2},  {32, 32, 32, 0},  false, false, true},
    {"A07_4way_v15_ph34_l0",      PRESET_SENTINEL, UB_DST,  {0,1,1,1},  {32, 32, 0, 0},   false, false, true},
    {"A08_4way_v15_ph34_l32",     PRESET_SENTINEL, UB_DST,  {0,1,1,1},  {32, 32, 32, 32}, false, false, true},
    {"A09_4way_v15_noncontig",    PRESET_SENTINEL, UB_DST,  {0,2,1,3},  {32, 32, 32, 32}, false, false, true},
    {"A10_2way_v3_len16",         PRESET_SENTINEL, UB_DST,  {0,1,1,1},  {16, 16, 0, 0},   false, false, true},
    {"A11_4way_v15_len16",        PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {16, 16, 16, 16}, false, false, true},
    {"A12_4way_v15_rep2",         PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, false, false, false},
    {"A13_4way_v15_exhtrue",      PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, false, false, true},
    {"A14_sort32_layout",         PRESET_SENTINEL, UB_TMP,  {0,1,2,3},  {32, 32, 32, 32}, false, true,  true},
    {"A15_4way_v15_sort32src",    PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, true,  false, true},
    {"A16_4way_v15_allb0",        PRESET_SENTINEL, UB_DST,  {0,0,0,0},  {32, 32, 32, 32}, false, false, true},
    {"A17_4way_v15_len4",         PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {4, 4, 4, 4},     false, false, true},
    {"A18_dst_alias_src1",        PRESET_SENTINEL, UB_IN,   {0,1,2,3},  {32, 32, 32, 32}, false, false, false},
    {"A19_dst_alias_src3",        PRESET_SENTINEL, UB_IN + 2 * BLK_B, {0,1,2,3}, {32, 32, 32, 32}, false, false, false},
    {"A20_sort32_nobar",          PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, true,  false, true},
    {"A21_4way_v15_rep0",         PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, false, false, false},
    {"A22_2way_v3_len4x32",       PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {32, 32, 32, 32}, false, false, false},
    {"A23_4way_v15_len0_all",     PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {0, 0, 0, 0},     false, false, false},
    {"A24_4way_v15_rep2_len8",    PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {8, 8, 8, 8},     false, false, false},
    {"A25_4way_v15_len8",         PRESET_SENTINEL, UB_DST,  {0,1,2,3},  {8, 8, 8, 8},     false, false, true},
};
static_assert(sizeof(kVariants) / sizeof(kVariants[0]) == N_VARIANTS,
              "kVariants 必须覆盖 A00..A17 全部变体");
constexpr uint32_t kNVariants = sizeof(kVariants) / sizeof(kVariants[0]);

// 块 b、组内序 j 的输入对（与 kernel 头注释一致）
inline void PutWord(uint8_t* base, uint32_t wordIdx, uint32_t w)
{
    std::memcpy(base + wordIdx * 4, &w, 4);
}
struct Pair {
    float v;
    uint32_t idx;
};

// 生成 host 输入缓冲（DUMP_B 字节，布局与 UB 同构）
void GenInput(uint8_t* in, bool indexFirst, uint32_t preset)
{
    std::memset(in, 0, DUMP_B);
    // 1) 4 个 32 对输入块
    for (uint32_t b = 0; b < NBLK; ++b) {
        for (uint32_t j = 0; j < PAIRS; ++j) {
            const float v = 1000.0f - 4.0f * static_cast<float>(j) - static_cast<float>(b);
            const uint32_t idx = 1000u * b + j;
            uint32_t* w = reinterpret_cast<uint32_t*>(in + b * BLK_B + j * PAIR_B);
            uint32_t vb;
            std::memcpy(&vb, &v, 4);
            w[0] = indexFirst ? idx : vb;
            w[1] = indexFirst ? vb : idx;
        }
    }
    // 2) dst 预置源：sentinel（0xDEADBEEF/0xBEEFDEAD）或全 0（按变体 preset 填）
    for (uint32_t p = 0; p < PRESET_B / PAIR_B; ++p) {
        if (preset == PRESET_ZERO) {
            PutWord(in + UB_DST, p * 2 + 0, 0u);
            PutWord(in + UB_DST, p * 2 + 1, 0u);
        } else {
            PutWord(in + UB_DST, p * 2 + 0, SENT_VAL);
            PutWord(in + UB_DST, p * 2 + 1, SENT_IDX);
        }
    }
    // 3) Sort32 输入：组内乱序的 (value,index)，排序后应等于上面的 4 个块
    for (uint32_t b = 0; b < NBLK; ++b) {
        for (uint32_t j = 0; j < PAIRS; ++j) {
            const uint32_t k = (j * 13u) % PAIRS;      // 13 与 32 互素 -> 组内置换
            const float v = 1000.0f - 4.0f * static_cast<float>(k) - static_cast<float>(b);
            std::memcpy(in + UB_S32I + (b * PAIRS + j) * 4, &v, 4);
            PutWord(in + UB_S32I + PAIRS * NBLK * 4, b * PAIRS + j, 1000u * b + k);
        }
    }
}

// 期望输出：concatGroups 时 = 4 组各自组内有序的拼接（Sort32 输出布局）；
// 否则 = 各路 srcBlk[i] 前 lens[i] 对并起来按 value 降序（并列值不存在）。
uint32_t ExpectedPairs(const VariantDesc& d, Pair* out)
{
    Pair all[4 * PAIRS];
    uint32_t an = 0;
    if (d.concatGroups) {
        for (uint32_t b = 0; b < 4; ++b) {
            for (uint32_t j = 0; j < PAIRS; ++j) {
                all[an].v = 1000.0f - 4.0f * static_cast<float>(j) - static_cast<float>(b);
                all[an].idx = 1000u * b + j;
                ++an;
            }
        }
    } else {
        for (uint32_t i = 0; i < 4; ++i) {
            const uint32_t b = d.srcBlk[i];
            for (uint32_t j = 0; j < d.lens[i] && j < PAIRS; ++j) {
                all[an].v = 1000.0f - 4.0f * static_cast<float>(j) - static_cast<float>(b);
                all[an].idx = 1000u * b + j;
                ++an;
            }
        }
        // 选择排序（n ≤ 128）
        for (uint32_t i = 0; i < an; ++i) {
            for (uint32_t j = i + 1; j < an; ++j) {
                if (all[j].v > all[i].v) {
                    const Pair t = all[i];
                    all[i] = all[j];
                    all[j] = t;
                }
            }
        }
    }
    for (uint32_t i = 0; i < an; ++i) {
        out[i] = all[i];
    }
    return an;
}

int RunOne(aclrtStream stream, uint32_t variant, bool indexFirst, const char* dumpDir, uint8_t* inHost,
           uint8_t* outHost, uint8_t* inDev, uint8_t* outDev)
{
    const VariantDesc& d = kVariants[variant];
    std::memset(outHost, 0, DUMP_B);
    GenInput(inHost, indexFirst, d.preset);
    aclrtMemcpy(inDev, DUMP_B, inHost, DUMP_B, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(outDev, DUMP_B, 0, DUMP_B);
    probe_a_mrgsort4_kernel<<<1, 0, stream>>>(inDev, outDev, variant, d.preset);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        std::printf("[A%02u] %-24s  LAUNCH/RUN FAILED aclError=%d\n", variant, d.name,
                    static_cast<int>(launchErr));
        return 1;
    }
    aclrtMemcpy(outHost, DUMP_B, outDev, DUMP_B, ACL_MEMCPY_DEVICE_TO_HOST);

    // ---- 判读 ----
    const uint8_t* dump = outHost;
    const uint32_t* dstW = reinterpret_cast<const uint32_t*>(dump + d.dst);
    const uint32_t maxPairs = (d.dst == UB_DST) ? UB_DST_SPAN / PAIR_B : 128;   // 观察窗（对）
    Pair exp[4 * PAIRS];
    const uint32_t expN = ExpectedPairs(d, exp);

    uint32_t nSentinel = 0, nValid = 0, nIllegal = 0, matchRun = 0;
    for (uint32_t p = 0; p < maxPairs; ++p) {
        const uint32_t w0 = dstW[p * 2 + 0];
        const uint32_t w1 = dstW[p * 2 + 1];
        if (w0 == SENT_VAL && w1 == SENT_IDX) {
            ++nSentinel;
            continue;
        }
        if (w0 == 0u && w1 == 0u) {
            continue;                     // 未写（全 0 预置或未预置的初始 0）
        }
        // 是否落在输入对集合内（value/index 自洽）——"index 串路"会让这一项变非法
        float v;
        std::memcpy(&v, &w0, 4);
        const uint32_t b = w1 / 1000u;
        const uint32_t jj = w1 % 1000u;
        const bool legal = (b < 4 && jj < PAIRS &&
                            v == 1000.0f - 4.0f * static_cast<float>(jj) - static_cast<float>(b));
        if (legal) {
            ++nValid;
        } else {
            ++nIllegal;
        }
        if (p < expN && matchRun == p) {
            float ev;
            std::memcpy(&ev, &exp[p].v, 4);
            uint32_t evb;
            std::memcpy(&evb, &ev, 4);
            if (w0 == evb && w1 == exp[p].idx) {
                ++matchRun;
            }
        }
    }

    std::printf("[A%02u] %-24s src=%s preset=%u  写出的对: 合法=%u 非法=%u 残留sentinel=%u  ",
                variant, d.name, d.srcFromSort32 ? "sort32" : "hand", d.preset, nValid, nIllegal, nSentinel);
    if (d.checkOrder) {
        std::printf("前缀序匹配=%u/%u", matchRun, expN);
    } else {
        std::printf("（本变体只取证、不判序）");
    }
    if (variant == A13_4WAY_V15_EXHTRUE) {
        const uint32_t* reg = reinterpret_cast<const uint32_t*>(dump + UB_TMP);
        std::printf("  VMS4_SR[list1..4]=%u/%u/%u/%u", reg[0], reg[1], reg[2], reg[3]);
    }
    if (d.checkOrder && matchRun < expN && expN > 0) {
        // 首个不匹配位置：直接看"值对、index 串了"还是"整体没写"
        const uint32_t p = matchRun;
        const uint32_t w0 = dstW[p * 2 + 0];
        const uint32_t w1 = dstW[p * 2 + 1];
        float v = 0.0f, ev = 0.0f;
        std::memcpy(&v, &w0, 4);
        std::memcpy(&ev, &exp[p].v, 4);
        uint32_t evb = 0;
        std::memcpy(&evb, &ev, 4);
        std::printf("\n        首个不匹配 pos=%u: 得到(%g, %u) 期望(%g, %u)%s", p, static_cast<double>(v), w1,
                    static_cast<double>(ev), exp[p].idx, (w0 == evb) ? "  [value 对、index 不同]" : "");
    }
    std::printf("\n");

    if (dumpDir != nullptr) {
        char path[512];
        std::snprintf(path, sizeof(path), "%s/variant_%02u_%s.bin", dumpDir, variant, d.name);
        FILE* f = std::fopen(path, "wb");
        if (f != nullptr) {
            std::fwrite(outHost, 1, DUMP_B, f);
            std::fclose(f);
        }
        std::snprintf(path, sizeof(path), "%s/input_%s.bin", dumpDir, indexFirst ? "ifirst" : "vfirst");
        f = std::fopen(path, "wb");
        if (f != nullptr) {
            std::fwrite(inHost, 1, DUMP_B, f);
            std::fclose(f);
        }
    }
    return (matchRun == expN) ? 0 : 1;
}

}   // namespace

int main(int argc, char** argv)
{
    const char* dumpDir = nullptr;
    bool indexFirst = false;
    if (argc >= 2 && argv[1][0] != '-') {
        dumpDir = argv[1];
    }
    if (argc >= 3 && std::strcmp(argv[2], "ifirst") == 0) {
        indexFirst = true;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint8_t* inHost = new uint8_t[DUMP_B];
    uint8_t* outHost = new uint8_t[DUMP_B];
    void* inDev = nullptr;
    void* outDev = nullptr;
    aclrtMalloc(&inDev, DUMP_B, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&outDev, DUMP_B, ACL_MEM_MALLOC_HUGE_FIRST);

    std::printf("[probe A] 3510 MrgSort 变体矩阵（1 对 = %d 字节 {fp32 value, u32 index}；dump=%s；输入字序=%s）\n",
                PAIR_B, dumpDir != nullptr ? dumpDir : "(only stdout)", indexFirst ? "ifirst" : "vfirst");
    uint32_t nFail = 0;
    for (uint32_t v = 0; v < kNVariants; ++v) {
        if (!kVariants[v].checkOrder) {
            RunOne(stream, v, indexFirst, dumpDir, inHost, outHost, reinterpret_cast<uint8_t*>(inDev),
                   reinterpret_cast<uint8_t*>(outDev));
            continue;                     // 语义不明的变体只记录，不计失败
        }
        nFail += RunOne(stream, v, indexFirst, dumpDir, inHost, outHost, reinterpret_cast<uint8_t*>(inDev),
                        reinterpret_cast<uint8_t*>(outDev));
    }
    std::printf("[probe A] 变体总数=%u 未达期望=%u\n", kNVariants, nFail);

    aclrtFree(inDev);
    aclrtFree(outDev);
    delete[] inHost;
    delete[] outHost;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
