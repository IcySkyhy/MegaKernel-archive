/**
 * probe_a2_mrgsort4_api.asc —— 探针 A2：`MrgSort4` API 与 `MrgSort(MrgSort4Info)` API
 * 在同一份输入/同一组参数下的行为对照（3510）。
 *
 * 动机（docs/05 §6.3 #19 的候选根因）：#19 记录的现象是"4 路归并后 dst 里
 * src3/src4 胜出元素的 index 是 UB 默认值"。而 CANN 9.1 在 dav-3510 上把
 * *名为 `MrgSort4` 的 API* 实现成"不支持"（见下面源码定位），
 * 与真正下发 `vmrgsort4` 指令的 `MrgSort(dst, srcList, MrgSort4Info)` 是
 * 两条不同的路径：
 *
 *   asc/impl/basic_api/kernel_operator_proposal_intf_impl.h:80-112
 *     MrgSort4(dst, src, params)  ->  Vmrgsort4Cal(dstPtr, addrArray, config)   // 3 参
 *     （config 打包也不同：elementLengths 各 12bit 落在 [11:8]/[23:20]/[35:32]/[47:44]，
 *       validBit 在 bit60、exhausted 在 bit59）
 *   asc/impl/basic_api/dav_3510/kernel_operator_proposal_impl.h:41-47
 *     template <typename T> [[deprecated("...MrgSort4 is an unsupported API on current
 *     device...")]] Vmrgsort4Cal(T* dst, T* addrArray[4], uint64_t config)
 *     { ASCENDC_REPORT_NOT_SUPPORT(false, "MrgSort4"); }      // ← 函数体只有这一句
 *   asc/impl/basic_api/dav_3510/kernel_operator_proposal_impl.h:68-75
 *     Vmrgsort4Cal(T* dst, T* addrArray[4], uint64_t src1, uint64_t config)  // 4 参
 *     { if ASCEND_IS_AIV { vmrgsort4(dstLocal, addrArray, src1, config); } }  // ← 真指令
 *   asc/impl/basic_api/kernel_operator_proposal_intf_impl.h:154-198
 *     MrgSort(dst, src, params)   ->  Vmrgsort4Cal(dstPtr, addrArray, src1, config)  // 4 参 = 真指令
 *   asc/impl/basic_api/kernel_log.h:87-93 / :277
 *     ASCENDC_REPORT_NOT_SUPPORT 在 ASCENDC_CPU_DEBUG 构建里 = KERNEL_LOG + raise(SIGABRT)；
 *     在**设备构建（非 CPU_DEBUG）里展开为空**。
 *
 * 于是（本探针要实测证伪/证实的推断）：
 *   设备构建下调 `AscendC::MrgSort4(...)` 既不报错也不下发任何指令
 *   —— **静默 no-op，dst 原样不动**（"UB 默认值"）。
 *
 * 变体（kernel 参数 variant；dst 区统一用 sentinel 预置，便于判定"有没有写"）：
 *   0  A2_00_mrgsort4_api_4way   MrgSort4  API，validBit=0b1111、len=[32,32,32,32]
 *   1  A2_01_mrgsort_api_4way    MrgSort   API，同参数（对照，应 128 对全序正确）
 *   2  A2_02_mrgsort4_api_2way   MrgSort4  API，validBit=0b0011、len=[32,32,0,0]（占位）
 *   3  A2_03_mrgsort_api_2way    MrgSort   API，同参数（对照，应 64 对全序正确）
 *
 * 输入对契约与 probe_a 相同：块 b、组内序 j -> value=1000-4j-b, index=1000b+j
 * （块内按 value 严格递减 = 已排序队列）。
 *
 * UB：UB_IN=0(1024B) / UB_DST=1024(1024B) / dump [0,2048)。
 * 同步：BufferID BUF_IN(0)=MTE2→V、BUF_OUT(1)=V→MTE3（均阻塞释放 false=BLOCK；同 probe_a）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"

#include <cstdint>
#include <cstdio>
#include <cstring>

namespace {
using namespace AscendC;

constexpr uint32_t PAIRS = 32;
constexpr uint32_t PAIR_B = 8;
constexpr uint32_t BLK_B = PAIRS * PAIR_B;      // 256B
constexpr uint32_t NBLK = 4;
constexpr uint32_t UB_IN = 0;                    // 4 块 = 1024B
constexpr uint32_t UB_DST = UB_IN + NBLK * BLK_B;   // 1024
constexpr uint32_t UB_END = UB_DST + 1024;       // 2048
constexpr uint32_t SENT_VAL = 0xDEADBEEFu;
constexpr uint32_t SENT_IDX = 0xBEEFDEADu;

constexpr AscendC::MutexID BUF_IN = 0;
constexpr AscendC::MutexID BUF_OUT = 1;

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}
template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

class MrgSort4ApiProbe {
public:
    __aicore__ inline void Init(GM_ADDR in, GM_ADDR out, uint32_t variant)
    {
        variant_ = variant;
        __gm__ uint8_t* inP = reinterpret_cast<__gm__ uint8_t*>(in);
        blkGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(inP), 2u * PAIRS * NBLK);
        presetGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(inP + UB_DST), 1024);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(out), UB_END);
    }

    __aicore__ inline void Process()
    {
        BufAcquire<PIPE_MTE2>(BUF_IN);
        DataCopy(MkT<float>(UB_IN, 2u * PAIRS * NBLK), blkGm_[0], 2u * PAIRS * NBLK);
        DataCopy(MkT<int8_t>(UB_DST, 1024), presetGm_[0], 1024);
        BufRelease<PIPE_MTE2>(BUF_IN);

        BufAcquire<PIPE_V>(BUF_IN);
        const uint32_t b0 = UB_IN + 0 * BLK_B;
        const uint32_t b1 = UB_IN + 1 * BLK_B;
        const uint32_t b2 = UB_IN + 2 * BLK_B;
        const uint32_t b3 = UB_IN + 3 * BLK_B;
        MrgSort4Info p;
        MrgSortSrcList<float> sl;
        if (variant_ == 0 || variant_ == 2) {
            const bool two = (variant_ == 2);
            p.elementLengths[0] = 32;
            p.elementLengths[1] = 32;
            p.elementLengths[2] = two ? 0 : 32;
            p.elementLengths[3] = two ? 0 : 32;
            p.validBit = two ? 0b0011 : 0b1111;
            p.repeatTimes = 1;
            p.ifExhaustedSuspension = false;
            sl.src1 = MkT<float>(b0, 64);
            sl.src2 = MkT<float>(b1, 64);
            sl.src3 = MkT<float>(two ? b1 : b2, 64);
            sl.src4 = MkT<float>(two ? b1 : b3, 64);
            // ↓↓↓ 本探针本体：MrgSort4 API（dav-3510 上应落进 deprecated 的 no-op 重载）
            MrgSort4(MkT<float>(UB_DST, two ? 128 : 256), sl, p);
        } else {
            const bool two = (variant_ == 3);
            p.elementLengths[0] = 32;
            p.elementLengths[1] = 32;
            p.elementLengths[2] = two ? 0 : 32;
            p.elementLengths[3] = two ? 0 : 32;
            p.validBit = two ? 0b0011 : 0b1111;
            p.repeatTimes = 1;
            p.ifExhaustedSuspension = false;
            sl.src1 = MkT<float>(b0, 64);
            sl.src2 = MkT<float>(b1, 64);
            sl.src3 = MkT<float>(two ? b1 : b2, 64);
            sl.src4 = MkT<float>(two ? b1 : b3, 64);
            // 对照：同样参数走 MrgSort API（4 参 Vmrgsort4Cal = 真指令）
            MrgSort(MkT<float>(UB_DST, two ? 128 : 256), sl, p);
        }
        BufRelease<PIPE_V>(BUF_IN);
        BufAcquire<PIPE_V>(BUF_OUT);
        BufRelease<PIPE_V>(BUF_OUT);

        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(outGm_[0], MkT<int8_t>(0, UB_END), UB_END);
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    uint32_t variant_ = 0;
    GlobalTensor<float> blkGm_;
    GlobalTensor<int8_t> presetGm_;
    GlobalTensor<int8_t> outGm_;
};

}   // namespace

__vector__ __global__ void probe_a2_mrgsort4_api_kernel(GM_ADDR in, GM_ADDR out, uint32_t variant)
{
    MrgSort4ApiProbe op;
    op.Init(in, out, variant);
    op.Process();
}

namespace {

struct Desc {
    const char* name;
    uint32_t outPairs;    // 期望写出的对数（MrgSort4 变体按推断 = 0）
    bool expectNoop;      // true = 预期 dst 完全不被写
};

const Desc kDesc[] = {
    {"A2_00_mrgsort4_api_4way", 128, true},
    {"A2_01_mrgsort_api_4way",  128, false},
    {"A2_02_mrgsort4_api_2way",  64, true},
    {"A2_03_mrgsort_api_2way",   64, false},
};
constexpr uint32_t kN = sizeof(kDesc) / sizeof(kDesc[0]);

void GenInput(uint8_t* in, uint32_t idx)
{
    std::memset(in, 0, UB_END);
    for (uint32_t b = 0; b < NBLK; ++b) {
        for (uint32_t j = 0; j < PAIRS; ++j) {
            const float v = 1000.0f - 4.0f * static_cast<float>(j) - static_cast<float>(b);
            uint32_t vb;
            std::memcpy(&vb, &v, 4);
            uint32_t* w = reinterpret_cast<uint32_t*>(in + b * BLK_B + j * PAIR_B);
            w[0] = vb;
            w[1] = 1000u * b + j;
        }
    }
    for (uint32_t p = 0; p < 1024 / PAIR_B; ++p) {
        uint32_t* w = reinterpret_cast<uint32_t*>(in + UB_DST + p * PAIR_B);
        w[0] = SENT_VAL;
        w[1] = SENT_IDX;
    }
    (void)idx;
}

struct Pair {
    float v;
    uint32_t idx;
};

// 期望序列（真值）：2 路 = b0+b1 的降序全序（64 对）；4 路 = 四块降序全序（128 对）
uint32_t ExpectedPairs(const Desc& d, Pair* out)
{
    const uint32_t nblk = (d.outPairs > 64) ? 4 : 2;
    Pair all[4 * PAIRS];
    uint32_t an = 0;
    for (uint32_t b = 0; b < nblk; ++b) {
        for (uint32_t j = 0; j < PAIRS; ++j) {
            all[an].v = 1000.0f - 4.0f * static_cast<float>(j) - static_cast<float>(b);
            all[an].idx = 1000u * b + j;
            ++an;
        }
    }
    for (uint32_t i = 0; i < an; ++i) {
        for (uint32_t j = i + 1; j < an; ++j) {
            if (all[j].v > all[i].v) {
                const Pair t = all[i];
                all[i] = all[j];
                all[j] = t;
            }
        }
    }
    for (uint32_t i = 0; i < an; ++i) {
        out[i] = all[i];
    }
    return an;
}

}   // namespace

int main(int argc, char** argv)
{
    const char* dumpDir = (argc >= 2) ? argv[1] : nullptr;
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t* inHost = new uint8_t[UB_END];
    uint8_t* outHost = new uint8_t[UB_END];
    void* inDev = nullptr;
    void* outDev = nullptr;
    aclrtMalloc(&inDev, UB_END, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&outDev, UB_END, ACL_MEM_MALLOC_HUGE_FIRST);

    std::printf("[probe A2] MrgSort4 API vs MrgSort(MrgSort4Info) API @3510\n");
    uint32_t nFail = 0;
    for (uint32_t v = 0; v < kN; ++v) {
        GenInput(inHost, v);
        aclrtMemcpy(inDev, UB_END, inHost, UB_END, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemset(outDev, UB_END, 0, UB_END);
        probe_a2_mrgsort4_api_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(inDev),
                                                       reinterpret_cast<uint8_t*>(outDev), v);
        const aclError e = aclrtSynchronizeStream(stream);
        if (e != ACL_SUCCESS) {
            std::printf("[A2%02u] %-24s  运行失败 aclError=%d\n", v, kDesc[v].name, static_cast<int>(e));
            ++nFail;
            continue;
        }
        aclrtMemcpy(outHost, UB_END, outDev, UB_END, ACL_MEMCPY_DEVICE_TO_HOST);
        const uint32_t* dw = reinterpret_cast<const uint32_t*>(outHost + UB_DST);
        uint32_t sent = 0, illegal = 0, legal = 0, matchRun = 0;
        Pair exp[4 * PAIRS];
        const uint32_t expN = ExpectedPairs(kDesc[v], exp);
        for (uint32_t p = 0; p < 128; ++p) {
            const uint32_t w0 = dw[p * 2 + 0];
            const uint32_t w1 = dw[p * 2 + 1];
            if (w0 == SENT_VAL && w1 == SENT_IDX) {
                ++sent;
                continue;
            }
            float fv;
            std::memcpy(&fv, &w0, 4);
            const uint32_t b = w1 / 1000u, j = w1 % 1000u;
            if (b < 4 && j < PAIRS && fv == 1000.0f - 4.0f * static_cast<float>(j) - static_cast<float>(b)) {
                ++legal;
            } else {
                ++illegal;
            }
            // 期望序列逐项比对（前缀连续匹配，与 probe A 的 matchRun 同款）
            if (p < expN && matchRun == p) {
                uint32_t evb;
                std::memcpy(&evb, &exp[p].v, 4);
                if (w0 == evb && w1 == exp[p].idx) {
                    ++matchRun;
                }
            }
        }
        const bool ok = kDesc[v].expectNoop ? (sent == 128 && legal == 0 && illegal == 0) : (matchRun == expN);
        if (!ok) {
            ++nFail;
        }
        std::printf("[A2%02u] %-24s  写出=合法%u 非法%u sentinel=%u  前缀序匹配=%u/%u  %s（期望 %s）\n", v,
                    kDesc[v].name, legal, illegal, sent, matchRun, expN, ok ? "PASS" : "FAIL",
                    kDesc[v].expectNoop ? "静默 no-op = dst 全 sentinel" : "写出且与真值全序逐项一致");
        if (dumpDir != nullptr) {
            char path[512];
            std::snprintf(path, sizeof(path), "%s/a2_%02u_%s.bin", dumpDir, v, kDesc[v].name);
            FILE* f = std::fopen(path, "wb");
            if (f != nullptr) {
                std::fwrite(outHost, 1, UB_END, f);
                std::fclose(f);
            }
        }
    }
    std::printf("[probe A2] 变体总数=%u 未达期望=%u\n", kN, nFail);
    aclrtFree(inDev);
    aclrtFree(outDev);
    delete[] inHost;
    delete[] outHost;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
