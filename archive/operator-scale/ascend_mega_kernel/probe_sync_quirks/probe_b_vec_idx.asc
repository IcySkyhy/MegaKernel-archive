/**
 * probe_b_vec_idx.asc —— 探针 B：`__VEC_SCOPE__`（vector function）内以运行时变量做
 * 下标的标量加载（`w[idx]`，idx 非编译期常量）——编译合法性 + 运行时取值正确性。
 *
 * 背景（docs/05 §6.3 #23）：M15 曾报 backend 报错 "Unsupported Inst must be hoisted"，
 * 当时的规避是"topK 改模板实例化 + if-constexpr 全展开"（m8_permute.asc:36-40,205-209）。
 * 原始最小复现与完整报错文本未归档。用户 2026-09-26 的复核意见：
 *   "w[idx]，idx 非编译期常量 这个在 vector scope 内也是合法的，不过你要看看 idx 是什么
 *    类型，s16 和 s32 应该可以，64 位肯定不支持，然后详细的报错信息也可以发一下"。
 *
 * 本文件用同一段最小 kernel 覆盖两个维度（编译期以宏选择，每个组合一个可执行文件）：
 *
 *   维度 1 —— idx 类型 PROBE_B_IDX_T：int16_t / int32_t / int64_t / uint16_t / uint32_t / uint64_t
 *   维度 2 —— 写法 PROBE_B_FORM：
 *     0 raw      VF 内、**运行时界**的向量循环里直接 wP[j]（j 非编译期常量）← 探针本体
 *     1 hoistub  同样的标量加载搬到 VF **外**（标量相位）整块落到 UB 暂存，VF 内按静态地址读
 *     2 ctbound  VF 内循环、界为编译期常量，下标仍为运行时量
 *     3 constidx VF 内循环、下标为编译期常量（m8 现行写法的等价物 = 已知可行对照组）
 *     4 ubget    VF 内 LocalTensor::GetValue(j)（UB 标量读的惯用接口）
 *     5 gmget    VF 内 GlobalTensor::GetValue(j)（**标量读 GM**）← 实测就是报错源
 *                 （注意：GetValue 接口只吃 uint32_t 偏移，所以 form 4/5/6/7 里的 idx 是被强转的，
 *                   "6 个 idx 类型报同一句错"不作为类型维度的证据）
 *     6 acc      VF 内循环做"标量累加器 + UB 动态下标"，循环外一次向量落盘
 *     7 gmhoist  form 5 的标量读搬到 VF 外（hoist 到循环外的正确形式）
 *     8 gmraw    VF 内 __gm__ 裸指针 gP[j]，**IdxT 原类型、不做任何 cast**；其余与 form 0 同构
 *                 → 与 form 0（UB）只差地址空间：可把触发条件干净归到"VF 内标量读 GM"，
 *                   且 idx 类型维度由这一组（6 个真正不同类型的程序）承载
 *     9 misalign 归档靶子：VF 内 4B 步长 LoadAlign（编译通过、运行 aclError=507035）
 *
 * 另两条硬约束（都有归档 log，见 README §5）：
 *   * VF 循环的**归纳变量必须是 uint16_t**：把 form 0 的归纳变量类型换成 uint32_t（编译宏
 *     PROBE_B_LOOPVAR=uint32_t，靶子 probe_b_idx_s32_f0_u32loop）即得
 *     "error: Induction variable must have a type uint16_t"；
 *   * VF 内 LoadAlign 只吃 32B 对齐地址：form 1/7 的暂存必须按整块写，4B 步长（form 9）
 *     直接 vector core exception 507035。
 *
 * kernel 输入/输出（host 侧生成、可复算）：
 *   wGm[256] fp32: w[i] = 100.0f + i
 *   内核参数 base（运行时标量，host 传 200）、n（运行时循环界，host 传 8）
 *   期望：out[i*VL + 0] == w[base + i]（VL = 向量寄存器 fp32 lane 数 = 64）
 * 取指阶段用运行时界 n、运行时 base 都来自 kernel 实参，编译器无法常量折叠，
 *   "idx 非编译期常量"这一点由构造保证。
 *
 * 编译/运行证据由 run_probes.sh 收集（每个组合单独 target，逐 target 抓 stderr 原文）；
 * 运行正确性默认重复 PROBE_B_REPS=20 次，因为 3510 上"标量→向量"通路另有 ~1/30 间歇
 * 丢写 quirk（docs/05 §6.3 #22，M15 实测），需要区分"编译不过"与"编译过但取值偶发错"。
 *
 * 同步：BufferID BUF_W(0)=MTE2→V、BUF_O(1)=V→MTE3（均阻塞释放 false=BLOCK；同 probe_a）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

#ifndef PROBE_B_IDX_T
#define PROBE_B_IDX_T int32_t
#endif
#ifndef PROBE_B_FORM
#define PROBE_B_FORM 0
#endif
#ifndef PROBE_B_TAG
#define PROBE_B_TAG probe_b_idx_custom
#endif
#ifndef PROBE_B_LOOPVAR
#define PROBE_B_LOOPVAR uint16_t
#endif
#ifndef PROBE_B_REPS
#define PROBE_B_REPS 20
#endif

#define PROBE_B_STR_(x) #x
#define PROBE_B_STR(x) PROBE_B_STR_(x)

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

using IdxT = PROBE_B_IDX_T;
using LoopT = PROBE_B_LOOPVAR;   // VF 循环归纳变量类型（默认 uint16_t；改成 uint32_t 即复现硬约束）

constexpr uint32_t WN = 256;            // w 元素数（fp32）
constexpr uint32_t VL = 64;             // 3510 向量寄存器 fp32 lane 数（256B）
constexpr uint32_t NMAX = 8;            // 本探针迭代上限（编译期；运行时 n 由 host 传同值）
constexpr uint32_t UB_W = 0;            // fp32[256] = 1024B
constexpr uint32_t UB_SV = UB_W + WN * 4;   // fp32[NMAX*VL] 暂存块（form 1/7 用）= 1024，每块 256B
constexpr uint32_t UB_OUT = UB_SV + NMAX * VL * 4;   // fp32[NMAX*VL] = 2048B（32B 对齐）
constexpr uint32_t UB_END = UB_OUT + NMAX * VL * 4;
static_assert(UB_END <= 192 * 1024, "UB footprint too large");

constexpr AscendC::MutexID BUF_W = 0;
constexpr AscendC::MutexID BUF_O = 1;

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}
template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

class VecIdxProbe {
public:
    __aicore__ inline void Init(GM_ADDR w, GM_ADDR out, uint32_t base, uint32_t n)
    {
        base_ = base;
        n_ = n;
        n16_ = static_cast<uint16_t>(n);
        wRaw_ = reinterpret_cast<__gm__ float*>(w);      // form 8 用：GM 裸指针
        wGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(w), WN);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out), NMAX * VL);
    }

    __aicore__ inline void Process()
    {
        BufAcquire<PIPE_MTE2>(BUF_W);
        DataCopy(MkT<float>(UB_W, WN), wGm_[0], WN);
        BufRelease<PIPE_MTE2>(BUF_W);

        BufAcquire<PIPE_V>(BUF_W);
        Run();
        BufRelease<PIPE_V>(BUF_W);
        BufAcquire<PIPE_V>(BUF_O);
        BufRelease<PIPE_V>(BUF_O);

        BufAcquire<PIPE_MTE3>(BUF_O);
        DataCopy(outGm_[0], MkT<float>(UB_OUT, NMAX * VL), NMAX * VL);
        BufRelease<PIPE_MTE3>(BUF_O);
    }

private:
#if PROBE_B_FORM == 9
    __aicore__ inline void Run() { RunMisalign(); }
#elif PROBE_B_FORM >= 4
    __aicore__ inline void Run() { RunAlt(); }
#else
    __aicore__ inline void Run() { RunMain(); }
#endif
    __aicore__ inline void RunMain()
    {
        __ubuf__ float* wP = reinterpret_cast<__ubuf__ float*>(UB_W);
        __ubuf__ float* outP = reinterpret_cast<__ubuf__ float*>(UB_OUT);

#if PROBE_B_FORM == 0
        // ---- 探针本体：VF 内运行时界循环 + 动态下标标量加载 ----
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (LoopT i = 0; i < n16_; ++i) {     // VF 循环归纳变量必须是 uint16_t（改 uint32_t 即报错）
                const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
                const float wv = wP[j];              // ← idx 非编译期常量
                Duplicate(v, wv);
                StoreAlign(outP + i * VL, v, full);
            }
        }
#elif PROBE_B_FORM == 1
        // ---- 写法 1：标量加载全部搬到 VF 外（hoist out），VF 内只按静态（256B 对齐）地址读暂存 ----
        // 注意：暂存必须按整块（256B）写，因为 VF 内 LoadAlign 只接受 32B 对齐地址
        // （本探针初版用 4B 步长 LoadAlign -> 直接 vector core exception 507035）。
        __ubuf__ float* sP = reinterpret_cast<__ubuf__ float*>(UB_SV);
        for (uint32_t i = 0; i < n_ && i < NMAX; ++i) {
            const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
            const float wv = wP[j];
            for (uint32_t lane = 0; lane < VL; ++lane) {
                sP[i * VL + lane] = wv;
            }
        }
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < NMAX16; ++i) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(UB_SV) + i * VL);
                StoreAlign(outP + i * VL, v, full);
            }
        }
#elif PROBE_B_FORM == 2
        // ---- 写法 2：VF 内循环、界为编译期，下标仍为运行时量 ----
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < NMAX16; ++i) {   // 编译期界；每轮下标 base_+i 仍非编译期常量
                const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
                const float wv = wP[j];
                Duplicate(v, wv);
                StoreAlign(outP + i * VL, v, full);
            }
        }
#else
        // ---- 写法 3：对照组，下标为编译期常量（m8 现行模板展开写法）----
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < NMAX16; ++i) {
                const float wv = wP[BASE_CONST + i];   // 编译期常量下标
                Duplicate(v, wv);
                StoreAlign(outP + i * VL, v, full);
            }
        }
#endif
    }

#if PROBE_B_FORM == 4 || PROBE_B_FORM == 5 || PROBE_B_FORM == 6
    // 写法 4/5/6：AscendC 惯用的标量取数接口（LocalTensor::GetValue / GlobalTensor::GetValue）
    // 与"标量累加器 + 动态下标"形式——比裸指针 wP[j] 更接近真实 kernel 代码（m8 原始报错场景）。
    __aicore__ inline void RunAlt()
    {
        __ubuf__ float* outP = reinterpret_cast<__ubuf__ float*>(UB_OUT);
        LocalTensor<float> wT = MkT<float>(UB_W, WN);
#if PROBE_B_FORM == 4
        // form 4：UB LocalTensor::GetValue（索引接口是 uint32_t）
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < n16_; ++i) {
                const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
                const float wv = wT.GetValue(static_cast<uint32_t>(j));
                Duplicate(v, wv);
                StoreAlign(outP + i * VL, v, full);
            }
        }
#elif PROBE_B_FORM == 5
        // form 5：GM GlobalTensor::GetValue（标量读 GM，动态下标）
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            float acc = 0.0f;
            for (uint16_t i = 0; i < n16_; ++i) {
                const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
                acc += wGm_.GetValue(static_cast<uint32_t>(j));   // ← 标量读 GM，动态下标
                Duplicate(v, acc);
                StoreAlign(outP + i * VL, v, full);
            }
        }
#else
        // form 6：标量累加器 + UB 动态下标（循环里只做标量运算，循环外一次向量落盘）
        {
            float acc = 0.0f;
            for (uint16_t i = 0; i < n16_; ++i) {
                const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
                acc += wT.GetValue(static_cast<uint32_t>(j));
            }
            __VEC_SCOPE__
            {
                RegTensor<float> v;
                MaskReg full = CreateMask<float, MaskPattern::ALL>();
                Duplicate(v, acc);
                StoreAlign(outP, v, full);
            }
        }
#endif
    }
#endif

#if PROBE_B_FORM == 8
    // form 8：VF 内用 **__gm__ 裸指针 + IdxT 原类型（不做任何 cast）** 做动态下标标量读 GM，
    //         其余（循环形状、下标算术、结果进向量指令）与 form 0 完全一致。
    //         于是 form 8（GM，失败）与 form 0（UB，通过）之间**只差地址空间**，
    //         可把"触发条件"干净地归到"VF 内标量读 GM"上；且 idx 类型维度由 IdxT 原类型承载。
    __aicore__ inline void RunAlt()
    {
        __ubuf__ float* outP = reinterpret_cast<__ubuf__ float*>(UB_OUT);
        __gm__ float* gP = wRaw_;
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < n16_; ++i) {
                const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
                const float wv = gP[j];              // ← 标量读 GM，idx 非编译期常量、类型 = IdxT 原类型
                Duplicate(v, wv);
                StoreAlign(outP + i * VL, v, full);
            }
        }
    }
#endif

#if PROBE_B_FORM == 9
    // form 9：归档"VF 内 LoadAlign 地址必须 32B 对齐"的实测证据 ——
    //         标量按 **4B 步长**只暂存 1 个 float/项，VF 内也按 4B 步长 LoadAlign。
    //         编译通过，运行直接 aclError=507035（vector core exception），由 host 打印。
    __aicore__ inline void RunMisalign()
    {
        __ubuf__ float* wP = reinterpret_cast<__ubuf__ float*>(UB_W);
        __ubuf__ float* sP = reinterpret_cast<__ubuf__ float*>(UB_SV);
        for (uint32_t i = 0; i < n_ && i < NMAX; ++i) {
            const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
            sP[i] = wP[j];                            // 4B 步长暂存
        }
        __ubuf__ float* outP = reinterpret_cast<__ubuf__ float*>(UB_OUT);
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < NMAX16; ++i) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(UB_SV) + i);   // ← 4B 步长 = 非 32B 对齐
                StoreAlign(outP + i * VL, v, full);
            }
        }
    }
#endif

#if PROBE_B_FORM == 7
    // form 7：把 GM 标量读搬到 VF 外（"hoist 到循环外"的正确形式），VF 内只按静态地址读暂存
    __aicore__ inline void RunAlt()
    {
        __ubuf__ float* sP = reinterpret_cast<__ubuf__ float*>(UB_SV);
        for (uint32_t i = 0; i < n_ && i < NMAX; ++i) {
            const IdxT j = static_cast<IdxT>(base_) + static_cast<IdxT>(i);
            const float wv = wGm_.GetValue(static_cast<uint32_t>(j));
            for (uint32_t lane = 0; lane < VL; ++lane) {
                sP[i * VL + lane] = wv;
            }
        }
        __ubuf__ float* outP = reinterpret_cast<__ubuf__ float*>(UB_OUT);
        __VEC_SCOPE__
        {
            RegTensor<float> v;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < NMAX16; ++i) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(UB_SV) + i * VL);
                StoreAlign(outP + i * VL, v, full);
            }
        }
    }
#endif

    static constexpr uint32_t BASE_CONST = 200;   // 仅 form 3 用；与 host 传入的 base 同值
    static constexpr uint16_t NMAX16 = static_cast<uint16_t>(NMAX);
    __gm__ float* wRaw_ = nullptr;                // form 8：GM 裸指针（IdxT 原类型动态寻址用）
    uint32_t base_ = 0;
    uint32_t n_ = NMAX;
    uint16_t n16_ = NMAX16;
    GlobalTensor<float> wGm_;
    GlobalTensor<float> outGm_;
};

}   // namespace

__vector__ __global__ void probe_b_vec_idx_kernel(GM_ADDR w, GM_ADDR out, uint32_t base, uint32_t n)
{
    VecIdxProbe op;
    op.Init(w, out, base, n);
    op.Process();
}

namespace {

constexpr uint32_t BASE = 200;      // 运行时 base（host 传入）
constexpr uint32_t NITER = 8;       // 运行时循环界（host 传入）

}   // namespace

int main(int argc, char** argv)
{
    const char* dumpDir = (argc >= 2) ? argv[1] : nullptr;
    const uint32_t reps = (argc >= 3) ? static_cast<uint32_t>(std::atoi(argv[2])) : PROBE_B_REPS;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t wBytes = WN * sizeof(float);
    const size_t oBytes = NMAX * VL * sizeof(float);
    float* wHost = new float[WN];
    float* oHost = new float[NMAX * VL];
    for (uint32_t i = 0; i < WN; ++i) {
        wHost[i] = 100.0f + static_cast<float>(i);
    }
    void* wDev = nullptr;
    void* oDev = nullptr;
    aclrtMalloc(&wDev, wBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&oDev, oBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(wDev, wBytes, wHost, wBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    std::printf("[probe B] %s  form=%d idx=%s sizeof=%d base=%u n=%u reps=%u\n", PROBE_B_STR(PROBE_B_TAG),
                PROBE_B_FORM, PROBE_B_STR(PROBE_B_IDX_T), static_cast<int>(sizeof(IdxT)), BASE, NITER, reps);

    uint32_t bad = 0, firstBadRep = 0, firstBadIdx = 0;
    float firstBadGot = 0.0f, firstBadWant = 0.0f;
    for (uint32_t r = 0; r < reps; ++r) {
        aclrtMemset(oDev, oBytes, 0, oBytes);
        probe_b_vec_idx_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(wDev),
                                                reinterpret_cast<uint8_t*>(oDev), BASE, NITER);
        const aclError e = aclrtSynchronizeStream(stream);
        if (e != ACL_SUCCESS) {
            std::printf("[probe B] rep=%u 运行失败 aclError=%d\n", r, static_cast<int>(e));
            bad = reps;
            break;
        }
        aclrtMemcpy(oHost, oBytes, oDev, oBytes, ACL_MEMCPY_DEVICE_TO_HOST);
#if PROBE_B_FORM == 5
        // form 5 是前缀和：out[i*VL] = Σ_{k<=i} w[base+k]
        for (uint32_t i = 0; i < NITER; ++i) {
            float want = 0.0f;
            for (uint32_t k = 0; k <= i; ++k) {
                want += wHost[BASE + k];
            }
            const float got = oHost[i * VL];
            if (got != want) {
                if (bad == 0) {
                    firstBadRep = r;
                    firstBadIdx = i;
                    firstBadGot = got;
                    firstBadWant = want;
                }
                ++bad;
            }
        }
#elif PROBE_B_FORM == 6
        // form 6 只落盘一个标量和：out[0] = Σ_k w[base+k]
        {
            float want = 0.0f;
            for (uint32_t k = 0; k < NITER; ++k) {
                want += wHost[BASE + k];
            }
            for (uint32_t i = 0; i < NITER; ++i) {
                const float got = oHost[i * VL];
                if (got != want) {
                    if (bad == 0) {
                        firstBadRep = r;
                        firstBadIdx = i;
                        firstBadGot = got;
                        firstBadWant = want;
                    }
                    ++bad;
                }
            }
        }
#else
        for (uint32_t i = 0; i < NITER; ++i) {
            const float got = oHost[i * VL];
            const float want = wHost[BASE + i];
            if (got != want) {
                if (bad == 0) {
                    firstBadRep = r;
                    firstBadIdx = i;
                    firstBadGot = got;
                    firstBadWant = want;
                }
                ++bad;
            }
        }
#endif
    }
    if (bad == 0) {
        std::printf("[probe B] %s  RUN PASS：%u 次 × %u 点全部 out[i*VL]==w[base+i]\n", PROBE_B_STR(PROBE_B_TAG),
                    reps, NITER);
    } else {
        std::printf("[probe B] %s  RUN FAIL：%u/%u 点不符；首个不符 rep=%u i=%u 得到 %g 期望 %g\n",
                    PROBE_B_STR(PROBE_B_TAG), bad, reps * NITER, firstBadRep, firstBadIdx,
                    static_cast<double>(firstBadGot), static_cast<double>(firstBadWant));
    }

    if (dumpDir != nullptr) {
        char path[512];
        std::snprintf(path, sizeof(path), "%s/b_%s.bin", dumpDir, PROBE_B_STR(PROBE_B_TAG));
        FILE* f = std::fopen(path, "wb");
        if (f != nullptr) {
            std::fwrite(oHost, 1, oBytes, f);
            std::fclose(f);
        }
    }

    aclrtFree(wDev);
    aclrtFree(oDev);
    delete[] wHost;
    delete[] oHost;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (bad == 0) ? 0 : 1;
}
