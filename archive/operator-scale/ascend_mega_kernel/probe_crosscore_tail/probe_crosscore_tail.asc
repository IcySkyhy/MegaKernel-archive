/**
 * probe_crosscore_tail.asc —— M134：跨核一侧（AIC Fixpipe L0C→对侧 AIV UB + CrossCore mode 2 flagId 记账）
 *                             的最小 mix 复现路。
 *
 * 背景（M117/B3 `m=64` 挂死；M126 收尾探针未覆盖跨核一侧）：
 *   M126 把「AIV 内 `V 写 → 阻塞释放（false=BLOCK）→ MTE3 搬出`」这条交接在 N=1..64 上逐档试过，未复现挂死，
 *   并明确把「AIC Fixpipe 直写对侧 AIV UB 的跨核数据面 + CrossCore flagId 记账」列为**未覆盖的下一步**。
 *   本探针就做这一条：**不含算法**的最小 mix 核，只留跨核数据面与 mode 2 同步。
 *
 * 被测形态（base，逐字对应人类口径）：
 *   「核内 pipeline 用 BufferID，核间用 set cross core 系列」；
 *   「mode 2：单个 AIC ↔ 它所属 AICore 内 2 个 AIV（及反向）」——FIXP L0C→UB 正是这条。
 *
 *   1 AIC + 配对 2 AIV，循环 N 轮：
 *     AIC：Mmad → L0C（两个 slot，值随轮 parity 交替）→ `Fixpipe(dualDstCtl=1)` 直写两个 AIV 的 UB
 *          → mode2 set(RDY, PIPE_FIX)
 *     AIV：mode2 wait(RDY, PIPE_V) → `Acq<PIPE_V>(B_UB)` → VF 拷 UB→staging → `Rls<PIPE_V>(B_UB)`
 *          → mode2 set(FREE, PIPE_V) → DMA staging→GM log
 *     AIC 下一轮回到 `mode2 wait(FREE, PIPE_FIX)`。
 *
 * flagId 全部自管静态；BufferID / UB / L1 / L0 地址全部编译期静态；落 GM 只走 DMA。
 *
 * 变体（argv[1]；完整清单见 `./probe_crosscore_tail list`）：
 *   base            — 基线：每 AIV 独立 id（RDY0/RDY1/FREE0/FREE1），AIC 每轮等 2 个 FREE
 *   a_nowait        — AIV 去掉 RDY 方向（对比：保留 mode2 回告）
 *   b_via_gm        — 不经 dualDstCtl 直写对侧 UB：AIC Fixpipe→GM，AIV DMA GM→UB 再消费
 *   c_rotate        — RDY id 按轮 parity 轮转
 *   c_broadcast     — 单个共享 id（AIC set 一次 → 两 AIV 都 wait；两 AIV set → AIC 等 2 次）
 *   c_wait1         — AIC 每轮只等 1 个 FREE（flagId 记账欠配）
 *   d_no_acquire    — AIV 去掉目标 UB 的 Acq/Rls
 *   neg_wrongval    — 判据负向对照：host 期望值整体错位
 *   neg_nofree      — 可控挂死对照：AIV0 不 set FREE
 *   c_preset        — 复刻 M117「循环前预置 FREE」形态（mode2 回告）
 *   dbg_rdyonly     — 隔离：只留 mode2 RDY 方向，无 AIV→AIC set
 *   dbg_nosync      — 隔离：完全无跨核 flag（纯 race）
 *   dbg_nodata      — 隔离：循环体空 + 末尾 PIPE_ALL
 *   dbg_nobar       — 隔离：base 去掉末尾 PIPE_ALL
 *   c_mode4free     — 候选替代：RDY mode2 + FREE mode4（`id + 16*channel`）
 *   c_m2sameid      — 隔离：mode2 回告，两 AIV 共用同一个 id
 *   c_m2setonly     — 隔离：AIV 发 mode2 set，AIC 不 wait
 *   c_m2mte3        — 隔离：mode2 set 挂 PIPE_MTE3（复刻 probe_aic_aiv v0 配对）
 *   c_mode4full     — 候选替代：RDY 与 FREE 都用 mode4
 *   c_m2canon       — 规范 mode2 配对：1 set(AIC) ↔ 2 wait(AIV)、2 set(AIV) ↔ 1 wait(AIC)（每轮 wait 恰好 1 次）
 *
 * 关键读数（详见 README）：mode2 回告方向**每轮 wait≠1** 的变体（base/broadcast/wait1/preset/m2sameid 为 2 次、
 * m2setonly 为 0 次）在 N>=2 稳定挂死；规范配对 c_m2canon 与 mode4 回告 c_mode4free 不挂（但内容 race，门控未验证）。
 * 该口径与塔广播 20260927-tower-all-mode-2-n-set-1-wait-mode.md 同向。
 *
 * 用法：./probe_crosscore_tail <variant> <N> <runNo> [outdir] [--trace]
 * 退出码：0 = 返回且内容全对；1 = 返回但内容有差异；2 = launch 失败/参数错；124（timeout）= 未返回
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <cstdint>
#include <vector>

namespace pct {
using namespace AscendC;
using namespace AscendC::Reg;

// ------------------------------------------------------------------
// 形状（全部取 16 的倍数；M 为偶数以支持 dualDstCtl 按 M 拆两半）
// ------------------------------------------------------------------
constexpr uint32_t M_DIM = 64;
constexpr uint32_t N_DIM = 64;
constexpr uint32_t K_DIM = 128;
constexpr uint32_t AIV_ROWS = M_DIM / 2;              // 32：dualDstCtl 每个 AIV 分得的行
constexpr uint32_t HALF_ELEMS = AIV_ROWS * N_DIM;     // 2048 fp32 = 8 KB
constexpr uint32_t HALF_BYTES = HALF_ELEMS * 4u;      // 8192

// AIV UB 静态布局（自管）
constexpr uint32_t UB_SRC_OFF = 0;                    // [32,64] fp32：AIC Fixpipe 直写目标
constexpr uint32_t UB_STG_OFF = HALF_BYTES;           // [32,64] fp32：VF 消费后的 staging
constexpr uint32_t UB_TOTAL = UB_STG_OFF + HALF_BYTES;
constexpr float SENTINEL = -12345.0f;                 // AIV 预置：无 wait 时应读到它 ⇒ 判据有牙

// AIC L1 静态布局
constexpr uint32_t L1_SLICE_BYTES = M_DIM * K_DIM * 2u;   // bf16 [64,128] = 16384
constexpr uint32_t L1_A0_OFF = 0;
constexpr uint32_t L1_A1_OFF = L1_A0_OFF + L1_SLICE_BYTES;
constexpr uint32_t L1_B_OFF = L1_A1_OFF + L1_SLICE_BYTES;
constexpr uint32_t L1_TOTAL = L1_B_OFF + L1_SLICE_BYTES;

// AIC L0C：两个 slot（值随 parity 交替：even=128, odd=256）
constexpr uint32_t L0C_SLOT_ELEMS = M_DIM * N_DIM;        // 4096 fp32
constexpr uint32_t L0C_SLOT_BYTES = L0C_SLOT_ELEMS * 4u;  // 16384

// GM scratch（b_via_gm 用）：2 slot × [64,64] fp32
constexpr uint32_t SCRATCH_FLOATS = 2u * M_DIM * N_DIM;   // 8192

// ------------------------------------------------------------------
// 自管静态 BufferID（核内 token）
// ------------------------------------------------------------------
constexpr MutexID B_UB = 0;    // AIV：目标 UB（V 读 ↔ MTE3 搬出 的交接）
constexpr MutexID B_LOG = 1;   // AIV：日志 DMA
constexpr MutexID B_L0 = 2;    // AIC：L0A/L0B
constexpr MutexID B_L1 = 3;    // AIC：L1
constexpr MutexID B_C = 4;     // AIC：L0C

// ------------------------------------------------------------------
// 自管静态 CrossCore mode2 flagId（全 < 16）
// ------------------------------------------------------------------
constexpr uint16_t F_RDY0 = 0;     // AIC -> AIV0
constexpr uint16_t F_RDY1 = 1;     // AIC -> AIV1
constexpr uint16_t F_FREE0 = 2;    // AIV0 -> AIC
constexpr uint16_t F_FREE1 = 3;    // AIV1 -> AIC
constexpr uint16_t F_BC_RDY = 4;   // 广播：AIC -> 两 AIV
constexpr uint16_t F_BC_FREE = 5;  // 广播：两 AIV -> AIC
constexpr uint16_t F_ROT_RDY0 = 6; // 轮转第二组（parity1）
constexpr uint16_t F_ROT_RDY1 = 7;
constexpr uint16_t F_ROT_FREE0 = 8;
constexpr uint16_t F_ROT_FREE1 = 9;
constexpr uint16_t FAC_AIV_CH = 16;   // mode4：AIC 侧对 AIV1 通道的 flagId 偏移（M117 同款）
constexpr uint16_t F_M4_FREE = 2;     // mode4 的 AIV->AIC 通道基 id
constexpr uint16_t F_M4_RDY = 0;      // mode4 的 AIC->AIV 通道基 id

// ------------------------------------------------------------------
// 变体编号
// ------------------------------------------------------------------
enum Variant {
    V_BASE = 0,
    V_NOWAIT = 1,
    V_VIA_GM = 2,
    V_ROTATE = 3,
    V_BROADCAST = 4,
    V_WAIT1 = 5,
    V_NOACQ = 6,
    V_NEG_WRONGVAL = 7,
    V_NEG_NOFREE = 8,
    V_PRESET = 9,
    V_RDYONLY = 10,
    V_NOSYNC = 11,
    V_NODATA = 12,
    V_NOBAR = 13,
    V_MODE4FREE = 14,
    V_M2SAMEID = 15,
    V_M2SETONLY = 16,
    V_M2MTE3 = 17,
    V_MODE4FULL = 18,
    V_M2CANON = 19,
};

// ------------------------------------------------------------------
// 同步原语（阻塞释放 BLOCK，CANN ASC_LOCK_BLOCK 默认；与 acquire 侧一致，仓库同款）
// ------------------------------------------------------------------
template <pipe_t p> __aicore__ __inline__ void Acq(MutexID id) { GetBufInternal<p, false>(id); }
template <pipe_t p> __aicore__ __inline__ void Rls(MutexID id) { RlsBufInternal<p, false>(id); }

// ------------------------------------------------------------------
// VF：拷 UB→UB / 填 sentinel（RegBase，整 64 lane）
// ------------------------------------------------------------------
__simd_vf__ inline void CopyVf(__ubuf__ float* dst, __ubuf__ float* src, uint32_t words)
{
    __VEC_SCOPE__
    {
        RegTensor<float> v;
        MaskReg m = CreateMask<float, MaskPattern::ALL>();
        for (uint16_t i = 0; i < (uint16_t)(words / 64u); ++i) {
            LoadAlign(v, src + (uint32_t)i * 64u);
            StoreAlign(dst + (uint32_t)i * 64u, v, m);
        }
    }
}

__simd_vf__ inline void FillVf(__ubuf__ float* dst, float val, uint32_t words)
{
    __VEC_SCOPE__
    {
        RegTensor<float> v;
        MaskReg m = CreateMask<float, MaskPattern::ALL>();
        Duplicate(v, val, m);
        for (uint16_t i = 0; i < (uint16_t)(words / 64u); ++i) {
            StoreAlign(dst + (uint32_t)i * 64u, v, m);
        }
    }
}

// ------------------------------------------------------------------
// 搬运 / cube 小工具
// ------------------------------------------------------------------
template <typename T>
__aicore__ __inline__ void GmToL1Nz(const LocalTensor<uint8_t>& dstL1, const GlobalTensor<T>& srcGm,
                                    uint64_t gmElemOff, uint16_t ndNum, uint16_t rowsPerMatrix, uint32_t cols,
                                    uint64_t srcMatStride, uint64_t srcRowPitch, uint16_t dstRowsTotal)
{
    Nd2NzParams par;
    par.ndNum = ndNum;
    par.nValue = rowsPerMatrix;
    par.dValue = cols;
    par.srcNdMatrixStride = srcMatStride;
    par.srcDValue = srcRowPitch;
    par.dstNzC0Stride = dstRowsTotal;
    par.dstNzNStride = 1;
    par.dstNzMatrixStride = 16u * 16u;
    DataCopy(dstL1.template ReinterpretCast<T>(), srcGm[gmElemOff], par);
}

// L1 Nz -> L0（非转置；bf16 C0 = 16）
__aicore__ __inline__ void LoadL0Bf16(const LocalTensor<uint8_t>& dstL0, const LocalTensor<uint8_t>& srcL1,
                                      uint64_t srcElemOff, uint64_t dstElemOff, uint16_t mStep, uint16_t kStep,
                                      uint16_t srcStride, uint16_t dstStride)
{
    LocalTensor<bfloat16_t> src = srcL1.ReinterpretCast<bfloat16_t>()[srcElemOff];
    LocalTensor<bfloat16_t> dst = dstL0.ReinterpretCast<bfloat16_t>()[dstElemOff];
    LoadData2DParamsV2 lp;
    lp.mStartPosition = 0;
    lp.kStartPosition = 0;
    lp.mStep = mStep;
    lp.kStep = kStep;
    lp.srcStride = (int32_t)srcStride;
    lp.dstStride = dstStride;
    lp.ifTranspose = false;
    lp.sid = 0;
    LoadData(dst, src, lp);
}

__aicore__ __inline__ void MmadBf16(const LocalTensor<uint8_t>& cL0C, uint64_t cElemOff,
                                    const LocalTensor<uint8_t>& aL0, uint64_t aElemOff,
                                    const LocalTensor<uint8_t>& bL0)
{
    MmadParams mp;
    mp.m = (uint16_t)M_DIM;
    mp.n = (uint16_t)N_DIM;
    mp.k = (uint16_t)K_DIM;
    mp.cmatrixInitVal = true;
    mp.cmatrixSource = false;
    Mmad(cL0C.template ReinterpretCast<float>()[cElemOff],
         aL0.template ReinterpretCast<bfloat16_t>()[aElemOff],
         bL0.template ReinterpretCast<bfloat16_t>(), mp);
}

// FIXP L0C -> UB（dualDstCtl=1：按 M 拆两半，同时写两个 AIV 的 UB）
__aicore__ __inline__ void FixpToUb(const LocalTensor<uint8_t>& dstUb, const LocalTensor<uint8_t>& srcL0C,
                                    uint64_t srcElemOff, uint16_t nSize, uint16_t dstStride)
{
    FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
    fp.nSize = nSize;
    fp.mSize = (uint16_t)M_DIM;
    fp.srcStride = (uint16_t)M_DIM;
    fp.dstStride = dstStride;
    fp.dualDstCtl = 1;
    fp.reluScalar = 0;
    fp.vectorRelu = 0;
    fp.deqScalar = 0;
    fp.params.ndNum = 1;
    fp.params.srcNdStride = 0;
    fp.params.dstNdStride = 0;
    static constexpr FixpipeConfig kFixUb(CO2Layout::ROW_MAJOR, true);
    LocalTensor<float> src = srcL0C.template ReinterpretCast<float>()[srcElemOff];
    LocalTensor<float> dst = dstUb.template ReinterpretCast<float>();
    Fixpipe<float, float, kFixUb>(dst, src, fp);
}

// FIXP L0C -> GM（b_via_gm 的数据面；无 dualDstCtl）
__aicore__ __inline__ void FixpToGm(const GlobalTensor<float>& dstGm, uint64_t gmElemOff,
                                    const LocalTensor<uint8_t>& srcL0C, uint64_t srcElemOff)
{
    FixpipeParamsArch3510<CO2Layout::ROW_MAJOR> fp;
    fp.nSize = (uint16_t)N_DIM;
    fp.mSize = (uint16_t)M_DIM;
    fp.srcStride = (uint16_t)M_DIM;
    fp.dstStride = (uint16_t)N_DIM;
    fp.reluScalar = 0;
    fp.vectorRelu = 0;
    fp.deqScalar = 0;
    static constexpr FixpipeConfig kFixGm(CO2Layout::ROW_MAJOR, false);
    Fixpipe<float, float, kFixGm>(dstGm[gmElemOff], srcL0C.template ReinterpretCast<float>()[srcElemOff], fp);
}

// ==================================================================
// kernel
// ==================================================================
__global__ __mix__(1, 2) void cc_tail_kernel(__gm__ uint8_t* aGm, __gm__ uint8_t* bGm, __gm__ uint8_t* scratchGm,
                                             __gm__ uint8_t* logGm, uint32_t N, uint32_t variant, uint32_t trace)
{
    AscendC::InitSocState();

    const DataCopyParams cpHalf{1, (uint16_t)(HALF_BYTES / 32u), 0, 0};

    if ASCEND_IS_AIC {
        if (GetBlockIdx() != 0u) {
            return;   // 只留 AICore 0 的 AIC
        }
        GlobalTensor<bfloat16_t> aG, bG;
        GlobalTensor<float> scratchG;
        aG.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(aGm));
        bG.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(bGm));
        scratchG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratchGm));

        LocalTensor<uint8_t> l1a0(TPosition::A1, L1_A0_OFF, L1_SLICE_BYTES);
        LocalTensor<uint8_t> l1a1(TPosition::A1, L1_A1_OFF, L1_SLICE_BYTES);
        LocalTensor<uint8_t> l1b(TPosition::A1, L1_B_OFF, L1_SLICE_BYTES);
        LocalTensor<uint8_t> l0a(TPosition::A2, 0, 2u * L1_SLICE_BYTES);
        LocalTensor<uint8_t> l0b(TPosition::B2, 0, L1_SLICE_BYTES);
        LocalTensor<uint8_t> l0c(TPosition::CO1, 0, 2u * L0C_SLOT_BYTES);
        LocalTensor<uint8_t> ubDst(TPosition::VECIN, UB_SRC_OFF, HALF_BYTES);

        // ---- prologue：A0=1s, A1=2s, B=1s -> L1 -> L0；两次 Mmad 得 128 / 256 ----
        Acq<PIPE_MTE2>(B_L1);
        GmToL1Nz<bfloat16_t>(l1a0, aG, 0, 1, (uint16_t)M_DIM, K_DIM, 0, K_DIM, (uint16_t)M_DIM);
        GmToL1Nz<bfloat16_t>(l1a1, aG, (uint64_t)M_DIM * K_DIM, 1, (uint16_t)M_DIM, K_DIM, 0, K_DIM,
                             (uint16_t)M_DIM);
        GmToL1Nz<bfloat16_t>(l1b, bG, 0, 1, (uint16_t)N_DIM, K_DIM, 0, K_DIM, (uint16_t)N_DIM);
        Rls<PIPE_MTE2>(B_L1);
        PipeBarrier<PIPE_MTE2>();

        Acq<PIPE_MTE1>(B_L1);
        Acq<PIPE_MTE1>(B_L0);
        LoadL0Bf16(l0a, l1a0, 0, 0, (uint16_t)(M_DIM / 16u), (uint16_t)(K_DIM / 16u), (uint16_t)(M_DIM / 16u),
                   (uint16_t)(M_DIM / 16u));
        LoadL0Bf16(l0a, l1a1, 0, (uint64_t)M_DIM * K_DIM, (uint16_t)(M_DIM / 16u), (uint16_t)(K_DIM / 16u),
                   (uint16_t)(M_DIM / 16u), (uint16_t)(M_DIM / 16u));
        LoadL0Bf16(l0b, l1b, 0, 0, (uint16_t)(N_DIM / 16u), (uint16_t)(K_DIM / 16u), (uint16_t)(N_DIM / 16u),
                   (uint16_t)(N_DIM / 16u));
        Rls<PIPE_MTE1>(B_L0);
        Rls<PIPE_MTE1>(B_L1);

        SetFlag<HardEvent::MTE1_M>(EVENT_ID0);
        WaitFlag<HardEvent::MTE1_M>(EVENT_ID0);
        MmadBf16(l0c, 0, l0a, 0, l0b);
        MmadBf16(l0c, L0C_SLOT_ELEMS, l0a, (uint64_t)M_DIM * K_DIM, l0b);
        SetFlag<HardEvent::M_FIX>(EVENT_ID0);
        WaitFlag<HardEvent::M_FIX>(EVENT_ID0);

        if (trace) {
            printf("[PCT][AIC] enter N=%u variant=%u\n", N, variant);
        }

        for (uint32_t r = 0; r < N; ++r) {
            const uint32_t q = r & 1u;
            if (variant == V_NODATA) {
                continue;   // 隔离：只跑循环 + 末尾 PIPE_ALL，不做任何数据 op / 同步
            }
            if (trace) {
                printf("[PCT][AIC] r=%u waitFREE\n", r);
            }
            const bool skipFree = (variant == V_RDYONLY || variant == V_NOSYNC || variant == V_M2SETONLY);
            const bool waitFree = !skipFree && ((variant == V_PRESET) ? true : (r > 0u));
            if (variant == V_BROADCAST) {
                if (waitFree) {
                    CrossCoreWaitFlag<0x2, PIPE_S>(F_BC_FREE);
                    CrossCoreWaitFlag<0x2, PIPE_S>(F_BC_FREE);
                }
            } else if (variant == V_WAIT1) {
                if (waitFree) {
                    CrossCoreWaitFlag<0x2, PIPE_S>(F_FREE0);
                }
            } else if (variant == V_MODE4FREE || variant == V_MODE4FULL) {
                if (waitFree) {
                    CrossCoreWaitFlag<0x4, PIPE_FIX>(F_M4_FREE);
                    CrossCoreWaitFlag<0x4, PIPE_FIX>(F_M4_FREE + FAC_AIV_CH);
                }
            } else if (variant == V_M2SAMEID) {
                if (waitFree) {
                    CrossCoreWaitFlag<0x2, PIPE_FIX>(F_M4_FREE);
                    CrossCoreWaitFlag<0x2, PIPE_FIX>(F_M4_FREE);
                }
            } else if (variant == V_M2CANON) {
                if (waitFree) {
                    CrossCoreWaitFlag<0x2, PIPE_S>(F_BC_FREE);   // 规范配对：2 set(AIV) ↔ 1 wait(AIC)
                }
            } else {
                if (waitFree) {
                    CrossCoreWaitFlag<0x2, PIPE_S>(F_FREE0);
                    CrossCoreWaitFlag<0x2, PIPE_S>(F_FREE1);
                }
            }

            if (variant == V_VIA_GM) {
                FixpToGm(scratchG, (uint64_t)q * L0C_SLOT_ELEMS, l0c, (uint64_t)q * L0C_SLOT_ELEMS);
            } else {
                FixpToUb(ubDst, l0c, (uint64_t)q * L0C_SLOT_ELEMS, (uint16_t)N_DIM, (uint16_t)N_DIM);
            }

            if (variant == V_NOWAIT || variant == V_NOSYNC) {
                // 负向对照：去掉 RDY 方向的同步（AIC 不 set、AIV 不 wait），避免 flag 记账不平衡混入
            } else if (variant == V_MODE4FULL) {
                CrossCoreSetFlag<0x4, PIPE_FIX>(F_M4_RDY);
                CrossCoreSetFlag<0x4, PIPE_FIX>(F_M4_RDY + FAC_AIV_CH);
            } else if (variant == V_BROADCAST || variant == V_M2CANON) {
                CrossCoreSetFlag<0x2, PIPE_FIX>(F_BC_RDY);   // 规范配对：1 set(AIC) ↔ 2 wait(AIV)
            } else if (variant == V_ROTATE) {
                CrossCoreSetFlag<0x2, PIPE_FIX>(q ? (F_ROT_RDY0) : F_RDY0);
                CrossCoreSetFlag<0x2, PIPE_FIX>(q ? (F_ROT_RDY1) : F_RDY1);
            } else {
                CrossCoreSetFlag<0x2, PIPE_FIX>(F_RDY0);
                CrossCoreSetFlag<0x2, PIPE_FIX>(F_RDY1);
            }
            if (trace) {
                printf("[PCT][AIC] r=%u fixp+setRDY done\n", r);
            }
        }
        if (variant != V_NOBAR) {
            PipeBarrier<PIPE_ALL>();
        }
        if (trace) {
            printf("[PCT][AIC] loop done\n");
        }
        return;
    }

    if ASCEND_IS_AIV {
        const uint32_t bid = GetBlockIdx();
        if (bid > 1u) {
            return;   // 只留 AICore 0 的两个 AIV
        }
        const uint32_t half = bid & 1u;
        GlobalTensor<float> logG;
        GlobalTensor<float> scratchG;
        logG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(logGm));
        scratchG.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(scratchGm));

        LocalTensor<uint8_t> ubSrc(TPosition::VECIN, UB_SRC_OFF, HALF_BYTES);
        LocalTensor<uint8_t> ubStg(TPosition::VECCALC, UB_STG_OFF, HALF_BYTES);
        __ubuf__ float* srcF = reinterpret_cast<__ubuf__ float*>(ubSrc.GetPhyAddr());
        __ubuf__ float* stgF = reinterpret_cast<__ubuf__ float*>(ubStg.GetPhyAddr());

        // sentinel 预置（在 preset FREE 之前完成 ⇒ AIC 尚未写 UB）
        FillVf(srcF, SENTINEL, HALF_ELEMS);
        FillVf(stgF, 0.0f, HALF_ELEMS);
        PipeBarrier<PIPE_V>();

        // preset FREE：**仅 V_PRESET 变体**（复刻「循环前预置令牌」的 M117 形态）。
        // base 用「AIC 只从第 1 轮起等 FREE、AIV 只在前 N-1 轮 set FREE」的平衡口径，
        // 不用预置（预置会在核间 flag 计数器上留下未配平的 +1/轮）。
        if (variant == V_PRESET) {
            CrossCoreSetFlag<0x2, PIPE_V>(F_FREE0 + half);
        }

        if (trace) {
            printf("[PCT][AIV%u] enter N=%u variant=%u\n", bid, N, variant);
        }

        for (uint32_t r = 0; r < N; ++r) {
            const uint32_t q = r & 1u;
            if (variant == V_NODATA) {
                continue;
            }
            if (trace) {
                printf("[PCT][AIV%u] r=%u waitRDY\n", bid, r);
            }
            if (variant != V_NOWAIT && variant != V_NOSYNC) {
                if (variant == V_VIA_GM) {
                    if (variant == V_BROADCAST) {
                        CrossCoreWaitFlag<0x2, PIPE_MTE2>(F_BC_RDY);
                    } else {
                        CrossCoreWaitFlag<0x2, PIPE_MTE2>(F_RDY0 + half);
                    }
                } else if (variant == V_MODE4FULL) {
                    CrossCoreWaitFlag<0x4, PIPE_V>(F_M4_RDY);
                } else if (variant == V_BROADCAST || variant == V_M2CANON) {
                    CrossCoreWaitFlag<0x2, PIPE_V>(F_BC_RDY);
                } else if (variant == V_ROTATE) {
                    CrossCoreWaitFlag<0x2, PIPE_V>(q ? (F_ROT_RDY0 + half) : (F_RDY0 + half));
                } else {
                    CrossCoreWaitFlag<0x2, PIPE_V>(F_RDY0 + half);
                }
            }

            if (variant == V_VIA_GM) {
                Acq<PIPE_MTE2>(B_UB);
                DataCopy(ubSrc.template ReinterpretCast<float>(),
                         scratchG[(uint64_t)q * L0C_SLOT_ELEMS + (uint64_t)half * HALF_ELEMS],
                         DataCopyParams{1, (uint16_t)(HALF_BYTES / 32u), 0, 0});
                Rls<PIPE_MTE2>(B_UB);
                SetFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::MTE2_MTE3>(EVENT_ID0);
                Acq<PIPE_MTE3>(B_LOG);
                DataCopy(logG[((uint64_t)half * N + r) * HALF_ELEMS], ubSrc.template ReinterpretCast<float>(),
                         cpHalf);
                Rls<PIPE_MTE3>(B_LOG);
                const bool setFree = (variant != V_RDYONLY && variant != V_NOSYNC) &&
                                     ((variant == V_PRESET) ? true : (r + 1u < N));
                if (setFree) {
                    if (variant == V_NEG_NOFREE) {
                        if (half == 0u) {
                            CrossCoreSetFlag<0x2, PIPE_MTE3>(F_FREE0);
                        }
                    } else if (variant == V_BROADCAST || variant == V_M2CANON) {
                        CrossCoreSetFlag<0x2, PIPE_MTE3>(F_BC_FREE);
                    } else if (variant == V_MODE4FREE) {
                        CrossCoreSetFlag<0x4, PIPE_MTE3>(F_M4_FREE);
                    } else if (variant == V_M2SAMEID) {
                        CrossCoreSetFlag<0x2, PIPE_MTE3>(F_M4_FREE);
                    } else if (variant == V_MODE4FULL) {
                        CrossCoreSetFlag<0x4, PIPE_MTE3>(F_M4_FREE);
                    } else {
                        CrossCoreSetFlag<0x2, PIPE_MTE3>(F_FREE0 + half);
                    }
                }
            } else {
                if (variant != V_NOACQ) {
                    Acq<PIPE_V>(B_UB);
                }
                CopyVf(stgF, srcF, HALF_ELEMS);
                if (variant != V_NOACQ) {
                    Rls<PIPE_V>(B_UB);
                }
                const bool setFreeNv = (variant != V_RDYONLY && variant != V_NOSYNC) &&
                                       ((variant == V_PRESET) ? true : (r + 1u < N));
                if (setFreeNv) {
                    if (variant == V_NEG_NOFREE) {
                        if (half == 0u) {
                            CrossCoreSetFlag<0x2, PIPE_V>(F_FREE0);   // 只 AIV0 发，AIC 会等 F_FREE1 阻塞
                        }
                    } else if (variant == V_BROADCAST || variant == V_M2CANON) {
                        CrossCoreSetFlag<0x2, PIPE_V>(F_BC_FREE);
                    } else if (variant == V_MODE4FREE) {
                        CrossCoreSetFlag<0x4, PIPE_V>(F_M4_FREE);
                    } else if (variant == V_M2SAMEID) {
                        CrossCoreSetFlag<0x2, PIPE_V>(F_M4_FREE);
                    } else if (variant == V_M2MTE3) {
                        CrossCoreSetFlag<0x2, PIPE_MTE3>(F_FREE0 + half);
                    } else if (variant == V_MODE4FULL) {
                        CrossCoreSetFlag<0x4, PIPE_V>(F_M4_FREE);
                    } else {
                        CrossCoreSetFlag<0x2, PIPE_V>(F_FREE0 + half);
                    }
                }
                PipeBarrier<PIPE_V>();
                SetFlag<HardEvent::V_MTE3>(EVENT_ID0);
                WaitFlag<HardEvent::V_MTE3>(EVENT_ID0);
                Acq<PIPE_MTE3>(B_LOG);
                DataCopy(logG[((uint64_t)half * N + r) * HALF_ELEMS], ubStg.template ReinterpretCast<float>(),
                         cpHalf);
                Rls<PIPE_MTE3>(B_LOG);
            }
            if (trace) {
                printf("[PCT][AIV%u] r=%u consumed+logged\n", bid, r);
            }
        }
        if (variant != V_NOBAR) {
            PipeBarrier<PIPE_ALL>();
        }
        if (trace) {
            printf("[PCT][AIV%u] loop done\n", bid);
        }
        return;
    }
}

}  // namespace pct

// ==================================================================
// host 侧
// ==================================================================
namespace {
struct VarInfo {
    const char* name;
    uint32_t id;
    const char* note;
};

// variant id 与 pct::Variant 对齐
const VarInfo kVariants[] = {
    {"base", pct::V_BASE, "baseline: per-AIV ids, AIC waits 2 FREE, dualDstCtl->peer UB"},
    {"a_nowait", pct::V_NOWAIT, "negative: AIV drops mode2 RDY wait (expect bad/sentinel data)"},
    {"b_via_gm", pct::V_VIA_GM, "AIC Fixpipe->GM, AIV DMA GM->UB (no dualDstCtl peer-UB)"},
    {"c_rotate", pct::V_ROTATE, "RDY/FREE ids rotate by round parity"},
    {"c_broadcast", pct::V_BROADCAST, "single shared id: AIC set once -> both AIV wait"},
    {"c_wait1", pct::V_WAIT1, "AIC waits only 1 FREE per round (accounting under-count)"},
    {"d_no_acquire", pct::V_NOACQ, "AIV drops Acq/Rls on target UB"},
    {"neg_wrongval", pct::V_NEG_WRONGVAL, "control: host expectation shifted (content criterion red)"},
    {"neg_nofree", pct::V_NEG_NOFREE, "controlled hang: AIV0 never sets FREE"},
    {"c_preset", pct::V_PRESET, "M117-style preset FREE before loop (flag accounting +1/round)"},
    {"dbg_rdyonly", pct::V_RDYONLY, "isolation: only RDY handshake, no FREE direction"},
    {"dbg_nosync", pct::V_NOSYNC, "isolation: no cross-core flags at all (pure race)"},
    {"dbg_nodata", pct::V_NODATA, "isolation: loop + trailing PIPE_ALL only, no data ops"},
    {"dbg_nobar", pct::V_NOBAR, "base without the trailing PIPE_ALL (barrier hypothesis)"},
    {"c_mode4free", pct::V_MODE4FREE, "FREE direction on mode4 (M117 idiom) vs mode2"},
    {"c_m2sameid", pct::V_M2SAMEID, "mode2 FREE with both AIVs sharing one id (isolation)"},
    {"c_m2setonly", pct::V_M2SETONLY, "isolation: AIV sets mode2 FREE, AIC never waits"},
    {"c_m2mte3", pct::V_M2MTE3, "mode2 FREE with AIV set on PIPE_MTE3 (probe_aic_aiv v0 pairing)"},
    {"c_mode4full", pct::V_MODE4FULL, "candidate replacement: full M117 mode4 (id + 16*channel)"},
    {"c_m2canon", pct::V_M2CANON, "canonical mode2 pairing: 1 set(AIC)<->2 wait(AIV), 2 set(AIV)<->1 wait(AIC)"},
};
const uint32_t kNVar = sizeof(kVariants) / sizeof(kVariants[0]);
}  // namespace

static int FindVariant(const char* s, uint32_t* outId)
{
    char* end = nullptr;
    const long num = strtol(s, &end, 10);
    const bool isNumeric = (end != nullptr && *end == '\0' && end != s);
    for (uint32_t i = 0; i < kNVar; ++i) {
        if (strcmp(s, kVariants[i].name) == 0 || (isNumeric && num == (long)kVariants[i].id)) {
            *outId = kVariants[i].id;
            return (int)i;
        }
    }
    return -1;
}

int main(int argc, char** argv)
{
    if (argc >= 2 && strcmp(argv[1], "list") == 0) {
        for (uint32_t i = 0; i < kNVar; ++i) {
            printf("  %s\t\t%s\n", kVariants[i].name, kVariants[i].note);
        }
        return 0;
    }
    if (argc < 3) {
        fprintf(stderr, "usage: %s <variant|id> <N> <runNo> [outdir] [--trace]\n", argv[0]);
        for (uint32_t i = 0; i < kNVar; ++i) printf("  %s  %s\n", kVariants[i].name, kVariants[i].note);
        return 2;
    }
    uint32_t vid = 0;
    const int vi = FindVariant(argv[1], &vid);
    if (vi < 0) {
        fprintf(stderr, "unknown variant: %s\n", argv[1]);
        return 2;
    }
    const uint32_t N = (uint32_t)atoi(argv[2]);
    const int runNo = (argc >= 4) ? atoi(argv[3]) : 1;
    const char* outdir = (argc >= 5 && argv[4][0] != '-') ? argv[4] : "out_tmp";
    uint32_t trace = 0;
    for (int i = 1; i < argc; ++i) {
        if (strcmp(argv[i], "--trace") == 0) trace = 1;
    }
    if (N == 0u) {
        fprintf(stderr, "N must be > 0\n");
        return 2;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    int64_t aicNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("SUMMARY variant=%s run=%d N=%u launch=FAILED corenum rc=2\n", kVariants[vi].name, runNo, N);
        return 2;
    }
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const size_t aBytes = (size_t)2 * pct::M_DIM * pct::K_DIM * sizeof(uint16_t);   // A0 + A1
    const size_t bBytes = (size_t)pct::N_DIM * pct::K_DIM * sizeof(uint16_t);
    const size_t scratchBytes = (size_t)pct::SCRATCH_FLOATS * sizeof(float);
    const size_t logBytes = (size_t)2 * N * pct::HALF_ELEMS * sizeof(float);

    void* dA = nullptr;
    void* dB = nullptr;
    void* dScratch = nullptr;
    void* dLog = nullptr;
    aclrtMalloc(&dA, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dB, bBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dScratch, scratchBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dLog, logBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    std::vector<uint16_t> hA((size_t)2 * pct::M_DIM * pct::K_DIM);
    std::vector<uint16_t> hB((size_t)pct::N_DIM * pct::K_DIM);
    const uint16_t kOne = 0x3F80u;   // bf16 1.0
    const uint16_t kTwo = 0x4000u;   // bf16 2.0
    for (size_t i = 0; i < (size_t)pct::M_DIM * pct::K_DIM; ++i) {
        hA[i] = kOne;
        hA[(size_t)pct::M_DIM * pct::K_DIM + i] = kTwo;
    }
    for (size_t i = 0; i < (size_t)pct::N_DIM * pct::K_DIM; ++i) {
        hB[i] = kOne;
    }
    aclrtMemcpy(dA, aBytes, hA.data(), aBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dB, bBytes, hB.data(), bBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dScratch, scratchBytes, 0, scratchBytes);
    aclrtMemset(dLog, logBytes, 0, logBytes);

    pct::cc_tail_kernel<<<(uint32_t)aicNum, 0, stream>>>(reinterpret_cast<uint8_t*>(dA),
                                                         reinterpret_cast<uint8_t*>(dB),
                                                         reinterpret_cast<uint8_t*>(dScratch),
                                                         reinterpret_cast<uint8_t*>(dLog), N, vid, trace);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("SUMMARY variant=%s run=%d N=%u launch=FAILED err=%d rc=2\n", kVariants[vi].name, runNo, N,
               (int)err);
        aclrtFree(dA);
        aclrtFree(dB);
        aclrtFree(dScratch);
        aclrtFree(dLog);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return 2;
    }

    std::vector<float> hLog((size_t)2 * N * pct::HALF_ELEMS);
    aclrtMemcpy(hLog.data(), logBytes, dLog, logBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtFree(dA);
    aclrtFree(dB);
    aclrtFree(dScratch);
    aclrtFree(dLog);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    // 期望值：even r -> 128 (= K * 1*1), odd r -> 256 (= K * 2*1)
    // neg_wrongval：host 故意用错位期望，证明内容判据能变红
    const bool shift = (vid == pct::V_NEG_WRONGVAL);
    uint64_t total = 0, mism = 0, sentinelHits = 0, zeroHits = 0;
    uint32_t roundsBad = 0;
    uint32_t firstBadRound = 0xFFFFFFFFu;
    uint64_t badElemsFirstRound = 0;
    for (uint32_t r = 0; r < N; ++r) {
        const float want = ((r & 1u) ? 256.0f : 128.0f);
        uint64_t rBad = 0;
        for (uint32_t half = 0; half < 2u; ++half) {
            const float* row = &hLog[((size_t)half * N + r) * pct::HALF_ELEMS];
            for (uint32_t i = 0; i < pct::HALF_ELEMS; ++i) {
                const float got = row[i];
                const float exp = shift ? (((r & 1u) ? 128.0f : 256.0f)) : want;
                ++total;
                if (got != exp) {
                    ++mism;
                    ++rBad;
                }
                if (got == pct::SENTINEL) ++sentinelHits;
                if (got == 0.0f) ++zeroHits;
            }
        }
        if (rBad > 0) {
            ++roundsBad;
            if (firstBadRound == 0xFFFFFFFFu) {
                firstBadRound = r;
                badElemsFirstRound = rBad;
            }
        }
    }
    const bool ok = (mism == 0);
    printf(
        "SUMMARY variant=%s run=%d N=%u total=%llu mismatched=%llu rounds_bad=%u first_bad_round=%d "
        "bad_elems_first=%llu sentinel=%llu zeros=%llu rc=%d\n",
        kVariants[vi].name, runNo, N, (unsigned long long)total, (unsigned long long)mism, roundsBad,
        (firstBadRound == 0xFFFFFFFFu) ? -1 : (int)firstBadRound, (unsigned long long)badElemsFirstRound,
        (unsigned long long)sentinelHits, (unsigned long long)zeroHits, ok ? 0 : 1);
    (void)outdir;
    return ok ? 0 : 1;
}
