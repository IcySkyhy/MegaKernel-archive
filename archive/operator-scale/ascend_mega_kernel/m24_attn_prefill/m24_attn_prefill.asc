// ============================================================
// m24_attn_prefill.asc —— M116（Wave B2）的 **独立验证路**：带 main() 的自包含工程
//
// 为什么独立（`docs/15` 的 `M103-2.0` P1，塔裁 2026-09-27）：融合 TU 是串行资源，Wave B 一律不碰
// `m15_layer_loop/CMakeLists.txt`；每条 Wave B 自带 CMakeLists + 带 main() 的 .asc + 自己的判据。
// 本文件**只 include 段体头**（段体头仍交付在 `m15_layer_loop/`），**不改** `m15_layer_loop/` 的任何文件。
//
// 【被测对象（SUT）】`M15PF::AttnPrefillPhaseA`：
//   · AIC：4 个 GEMM（`Mmad`），工作项 = (mTile, nBlock)；一个 chunk = 128 行 = 2 个 m-tile
//   · AIV：(row × item) 二维工作项（56 项/行）：q/k/idxq 走 GemmaRMSNorm+partial RoPE、
//          gate/v/rawk 走抄写，rawk 落环行时在 UB 里组出 3×int64 位置尾
//   · cache 填：`M15AC::m15_attn_cache_body`（环 + 压缩行 + packed + 门控）
//              + `M15AC::MainKvFillChunk`（主 KV **逐行**落页）
//
// 【判据口径】
//   · 真值全部来自**自建的 fp64 参考**（`m15_attn_prefill_host.h`），**不读任何设备产物**；
//     `m=4097` 更**不得**对官方 QSA 输出（`docs/17 §7`：官方 `indexer_budget=2048` 是 token 预算
//     ⇒ 每行只看得到约一半历史）。参考面与设备面的**唯一**联系是"同一批声明输入"。
//   · 档位按 `docs/17 §1.1`：T1 = 逐字节（抄写段/未写区仍是毒值/门控标志）；T2′ = GEMM 元素级
//     （`|got−exact| ≤ 0.5·ulp + ε_acc·Σ|terms|`）；T3 = norm+rope 元素级
//     （`|got−ref| ≤ 14·2^-24·Σ|terms| + 1.0·ulp(ref)`，M88 的 ε 逐项推导）。
//   · **非空洞性**（`docs/17 §4`）：① **`Pf.guard.*`（真 guard，见 CheckChunk）**：设备 y0 的行不得
//     整行是毒值、独立参考的 K 槽 / 压缩行 / 池化行不得与毒值面逐字节相同 —— 这道闸专门防
//     "T3 的参考由**设备 y0** 建 ⇒ 设备 y0 全毒时两边一起毒、判据空过"（M116 复审 P2-1）；
//     它只在**契约档**跑（变异档本来就会把参考/设备值改坏，跑 guard 会把"预期变红"记成 guard 失败）；
//     ② 每个变异档必须让**至少一条**判据变红（"把被测对象弄坏必变红"）；③ 同档重跑逐字节一致。
//   · **覆盖的粒度写在 README §4**（哪一段覆盖到"全行全列"、哪一段只覆盖声明行），不在这里含糊。
//
// 【形状（真档）】big4097 = 4097 行（32×128 + 1，尾 chunk 1 行）；big4097_step = 同一序列按 chunk 逐次发射；
//   m1ctx4097 = 单行 @ pos 4096；rag65 = chunk 65 行（chunk 起点 mod 4 走遍 0/1/2/3 ⇒ 真跑到"跨 chunk
//   成员从环里读"那条腿）；m128/m64/m2 覆盖 m-tile 边界与最小档。
// ============================================================
#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <ctime>
#include <string>
#include <vector>

// 与融合 TU **同一段 include 前缀**（`m15_layer_loop.asc` 的顺序）：段体与 cache 段依赖
// `M15H::ExtBlock1`（在 `m15_hc_layer.h`）与 `BufAcquire/BufRelease`（在 `m15_gdn_layer.h`）
// —— 那是 M98 起的既有依赖，不是本 mission 引入的。
#include "m15_gdn_layer.h"
#include "m15_hc_layer.h"
#include "m15_attn_prefill_host.h"

using namespace M15PF;
using namespace M15PFH;
using namespace M15Kv;
using namespace M15AP;
using namespace M15AC;

// ============================================================
// 1. 设备入口
// ============================================================
__global__ __mix__(1, 2) void m24_attn_prefill_kernel(
    __gm__ uint8_t* x, __gm__ uint8_t* w, __gm__ uint8_t* cs, __gm__ uint8_t* posTbl, __gm__ uint8_t* y0,
    __gm__ uint8_t* out, __gm__ uint8_t* in, __gm__ uint8_t* kv, __gm__ uint8_t* comp, __gm__ uint8_t* ring,
    __gm__ uint8_t* pack, __gm__ uint8_t* packSeed, __gm__ uint8_t* pooled, __gm__ uint8_t* flag,
    uint32_t rowStart, uint32_t seqRows, uint32_t chunkRows, uint32_t nChunks, uint32_t posBase, uint32_t mut,
    uint32_t acMode)
{
    AscendC::InitSocState();
    M15PFH::PfLaunchSpec s;
    s.x = x;
    s.w = w;
    s.cs = cs;
    s.posTbl = posTbl;
    s.y0 = y0;
    s.out = out;
    s.in = in;
    s.kv = kv;
    s.comp = comp;
    s.ring = ring;
    s.pack = pack;
    s.packSeed = packSeed;
    s.pooled = pooled;
    s.flag = flag;
    s.rowStart = rowStart;
    s.seqRows = seqRows;
    s.chunkRows = chunkRows;
    s.nChunks = nChunks;
    s.posBase = posBase;
    s.mut = mut;
    s.acMode = acMode;
    M15PF::PfChunkArgs a;
    M15PFH::PfFillArgs(a, s);
    M15PF::AttnPrefillPhaseA(a);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// 2. host 侧：判据账本 + 比较原语
// ============================================================
struct Stats {
    uint32_t checks = 0;
    uint32_t fails = 0;
    uint32_t guards = 0;
    uint32_t guardFails = 0;
    std::vector<std::string> failTags;

    void Note(const char* tag, bool ok)
    {
        ++checks;
        if (!ok) {
            ++fails;
            if (failTags.size() < 32u) {
                failTags.push_back(std::string(tag));
            }
        }
    }
    // guard 的**绿也打印**一行（带 detail）：归档日志因此能直接看出"这道闸被执行了、评了什么"，
    // 而不是只看到汇总里的计数（复审 r2 的要求）。
    void Guard(const char* tag, bool ok, const char* detail = nullptr)
    {
        ++guards;
        printf("[M24][GUARD-%s] %s%s%s\n", ok ? "OK" : "FAIL", tag, (detail != nullptr) ? " " : "",
               (detail != nullptr) ? detail : "");
        if (!ok) {
            ++guardFails;
        }
    }
};

static bool ChkBytesTag(const char* tag, const uint8_t* got, const uint8_t* exp, size_t n, bool verbose)
{
    if (std::memcmp(got, exp, n) == 0) {
        return true;
    }
    size_t first = 0u;
    size_t nd = 0u;
    for (size_t i = 0; i < n; ++i) {
        if (got[i] != exp[i]) {
            if (nd == 0u) {
                first = i;
            }
            ++nd;
        }
    }
    if (verbose) {
        printf("[M24]   %-32s 字节差异 %zu/%zu（首错 @%zu got=0x%02x exp=0x%02x）\n", tag, nd, n, first, got[first],
               exp[first]);
    } else {
        printf("[M24]   %-32s 字节差异 %zu/%zu\n", tag, nd, n);
    }
    return false;
}

// T3：`|got − ref| ≤ ε·Σ|terms| + (1+slackUlp)·ulp(ref)`（ref = 参考的 **bf16 值**）
//   `slackUlp` 的用途（**不是放松，是把"上游 y0 的 1 ulp 格点翻转"从被测段里分出去**）：
//   norm+rope / 池化 的输入是 y0（bf16）。参考的 y0 = `bf16(fp64 精确积和)`，设备的 y0 =
//   `bf16(fp32 累加)` —— 两者可以在**格点边界**上差 1 ulp（M88 的 T2′ 早就允许这种翻转）。
//   1 ulp 的 bf16 输入扰动（相对 2^-8）传到 norm+rope 的输出上是**输出量级**的 2^-8 ≈ 1~2 个
//   输出 ulp ⇒ 判据必须留这个传播余量，否则量的是**上游 GEMM 的舍入边界**，不是本段的数学。
//   本段用 `slackUlp = 5`（4 个余量 + 1 个本来就允许的量化 ulp）。**y0 自身的正确性由 `Pf.y0.*`
//   的 T2′ 承担**（另有一条判据），两件事**分开判**，不合并。
static bool g_t3Verbose = false;   // M24_T3V=1：把 T3 的越界细节（最坏比值）也打出来（诊断用）

static bool ChkT3Tag(const char* tag, const uint8_t* got, const uint8_t* exp, const double* terms, uint32_t n,
                     uint32_t slackUlp, bool verbose)
{
    uint32_t bad = 0u;
    uint32_t diff = 0u;
    uint32_t firstBad = n;
    double worstRatio = 0.0;     // |Δ| / (ε·terms + (1+slack)·ulp) 的最大值（>1 就是越界）
    double worstAbs = 0.0;
    uint32_t worstIdx = 0u;
    for (uint32_t j = 0; j < n; ++j) {
        uint16_t gb;
        uint16_t eb;
        std::memcpy(&gb, got + 2u * j, 2u);
        std::memcpy(&eb, exp + 2u * j, 2u);
        if (gb == eb) {
            continue;
        }
        ++diff;
        const double g = Bf2D(gb);
        const double e = Bf2D(eb);
        const double d = (g > e) ? (g - e) : (e - g);
        const double bound = PF_EPS_T3 * terms[j] + static_cast<double>(1u + slackUlp) * BfUlp(e);
        const double ratio = (bound > 0.0) ? (d / bound) : 0.0;
        if (ratio > worstRatio) {
            worstRatio = ratio;
            worstAbs = d;
            worstIdx = j;
        }
        if (d > bound) {
            ++bad;
            if (firstBad == n) {
                firstBad = j;
            }
        }
    }
    if (bad != 0u) {
        if (verbose || g_t3Verbose) {
            printf("[M24]   %-32s T3 越界 %u/%u（差异 %u，首错 #%u，slack=%u；最坏 |Δ|=%.6g @#%u = %.2f×界）\n", tag,
                   bad, n, diff, firstBad, slackUlp, worstAbs, worstIdx, worstRatio);
        }
        return false;
    }
    if (verbose || g_t3Verbose) {
        printf("[M24]   %-32s T3 OK（差异 %u/%u，最坏 %.3f×界）\n", tag, diff, n, worstRatio);
    }
    return true;
}

// 本段所有"输入经 y0"的比较统一用这个余量（见 ChkT3Tag 的说明）
constexpr uint32_t PF_T3_SLACK_ULP = 0u;   // 0 = 最紧（1 ulp 界）。设备读数：big4097_step 的 2,097,152 个 K 槽
                                           // 元素里 1 个越界（1.33×界）⇒ 该元素按"参考 fp64 / 设备 fp32 的
                                           // 格点平局舍入方向差异"登记为已接受偏差（见 README §4/§6）

// T2′：`|got − exact| ≤ 0.5·ulp(got) + ε_acc·Σ|terms|`（exact / terms 是 fp64）
static bool ChkT2Tag(const char* tag, const uint8_t* got, const double* exact, const double* terms, uint32_t n,
                     bool verbose)
{
    uint32_t bad = 0u;
    uint32_t firstBad = n;
    for (uint32_t j = 0; j < n; ++j) {
        uint16_t gb;
        std::memcpy(&gb, got + 2u * j, 2u);
        const double g = Bf2D(gb);
        if (std::fabs(g - exact[j]) > (0.5 * BfUlp(g) + PF_EPS_ACC * terms[j])) {
            ++bad;
            if (firstBad == n) {
                firstBad = j;
            }
        }
    }
    if (bad == 0u) {
        return true;
    }
    if (verbose) {
        printf("[M24]   %-32s T2' 越界 %u/%u（首错 #%u）\n", tag, bad, n, firstBad);
    } else {
        printf("[M24]   %-32s T2' 越界 %u/%u\n", tag, bad, n);
    }
    return false;
}

// "没有额外写入"（M98 的 `nospurious` 手法）：把设备在**期望槽**上的字节抄进一个全毒值面，
// 再整面比 ⇒ 差异只可能来自"设备在期望的槽之外写了东西"。内容正确性由 T1/T3 判据承担。
static bool ChkNoSpuriousTag(const char* tag, const uint8_t* got, size_t n, uint8_t poison,
                             const std::vector<std::pair<size_t, size_t>>& allowed, bool verbose)
{
    std::vector<uint8_t> exp(n, poison);
    for (const auto& seg : allowed) {
        if (seg.second != 0u && (seg.first + seg.second) <= n) {
            std::memcpy(exp.data() + seg.first, got + seg.first, seg.second);
        }
    }
    return ChkBytesTag(tag, got, exp.data(), n, verbose);
}

// ============================================================
// 3. host 侧：夹具（确定性、纯公式、无 rand 状态）
// ============================================================
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 2246822519u;
    h ^= h >> 15;
    h *= 2246822519u;
    h ^= h >> 13;
    h *= 3266489917u;
    h ^= h >> 16;
    return h;
}

static double HashF(uint32_t i, uint32_t j, uint32_t salt)   // [-1, 1)
{
    return (static_cast<double>(Hash3(i, j, salt) % 2000001u) / 1000000.0) - 1.0;
}

static uint16_t HashBf(uint32_t i, uint32_t j, uint32_t salt, double scale)
{
    return D2Bf(HashF(i, j, salt) * scale);
}

static constexpr uint8_t M24_POISON = 0xCDu;
static constexpr uint32_t SALT_X = 0x1001u;
static constexpr uint32_t SALT_W = 0x2001u;
static constexpr uint32_t SALT_PACK = 0x3001u;

struct Fixture {
    std::vector<uint16_t> x;        // [nRows+1][AP_HIDDEN]（尾行是 `calcM=max(curM,2)` 契约的余量行）
    std::vector<uint16_t> w;        // [W_BYTES/2]
    PfCsTable cs;
    std::vector<uint32_t> posTbl;
    std::vector<uint8_t> packSeed;  // AC_PACK_BYTES
    uint32_t nRows = 0u;            // x 覆盖的行数（含余量行）

    void Build(uint32_t rows)
    {
        nRows = rows + 1u;
        x.assign(static_cast<size_t>(nRows) * AP_HIDDEN, 0u);
        for (uint32_t r = 0u; r < nRows; ++r) {
            for (uint32_t k = 0u; k < AP_HIDDEN; ++k) {
                x[static_cast<size_t>(r) * AP_HIDDEN + k] = HashBf(k, r, SALT_X, 1.0);
            }
        }
        w.assign(W_BYTES / 2u, 0u);
        for (uint32_t j = 0u; j < QG_W; ++j) {
            for (uint32_t k = 0u; k < AP_HIDDEN; ++k) {
                w[W_Q_OFF / 2u + static_cast<size_t>(j) * AP_HIDDEN + k] = HashBf(k, j, SALT_W + 1u, 0.05);
            }
        }
        for (uint32_t j = 0u; j < NKV * HD; ++j) {
            for (uint32_t k = 0u; k < AP_HIDDEN; ++k) {
                w[W_K_OFF / 2u + static_cast<size_t>(j) * AP_HIDDEN + k] = HashBf(k, j, SALT_W + 2u, 0.05);
                w[W_V_OFF / 2u + static_cast<size_t>(j) * AP_HIDDEN + k] = HashBf(k, j, SALT_W + 3u, 0.05);
            }
        }
        for (uint32_t j = 0u; j < IDX_W; ++j) {
            for (uint32_t k = 0u; k < AP_HIDDEN; ++k) {
                w[W_IDX_OFF / 2u + static_cast<size_t>(j) * AP_HIDDEN + k] = HashBf(k, j, SALT_W + 4u, 0.05);
            }
        }
        for (uint32_t i = 0u; i < HD; ++i) {
            w[W_QN_OFF / 2u + i] = HashBf(i, 0u, SALT_W + 5u, 0.2);
            w[W_KN_OFF / 2u + i] = HashBf(i, 1u, SALT_W + 5u, 0.2);
        }
        for (uint32_t i = 0u; i < IDX_D; ++i) {
            w[W_IQN_OFF / 2u + i] = HashBf(i, 2u, SALT_W + 5u, 0.2);
            w[W_IKN_OFF / 2u + i] = HashBf(i, 3u, SALT_W + 5u, 0.2);
        }
        cs.Build(PREFILL_M);
        posTbl.assign(nRows, 0u);
        for (uint32_t r = 0u; r < nRows; ++r) {
            posTbl[r] = r;
        }
        packSeed.assign(AC_PACK_BYTES, 0u);
        int32_t* pk = reinterpret_cast<int32_t*>(packSeed.data());
        for (uint32_t row = 0u; row < AC_PACK_ROWS; ++row) {
            for (uint32_t c = 0u; c < PACK_COLS; ++c) {
                pk[static_cast<size_t>(row) * PACK_COLS + c] =
                    (c == PACK_COUNT_COL) ? static_cast<int32_t>(row + 1u)
                                          : static_cast<int32_t>(Hash3(c, row, SALT_PACK) % 4097u);
            }
        }
    }
    const uint16_t* XRow(uint32_t r) const { return x.data() + static_cast<size_t>(r) * AP_HIDDEN; }
};

// ============================================================
// 4. host 侧：一行的参考产物（**带缓存**：同一行只算一次；full 档只给声明行）
// ============================================================
struct RowRef {
    bool built = false;
    bool fullBuilt = false;
    std::vector<uint8_t> kNorm;   // [2][256] bf16（norm+rope 之后）
    std::vector<double> kTerms;   // [2][256]
    std::vector<uint8_t> vRaw;    // [2][256] bf16（原样）
    std::vector<uint8_t> rawk;    // [128] bf16
    std::vector<uint8_t> ringRow; // 280 B
    std::vector<uint8_t> kvRow;   // 2048 B（输入面形态）
    // full 档
    std::vector<uint8_t> q;       // [6144]
    std::vector<double> qTerms;
    std::vector<uint8_t> gate;    // [6144]
    std::vector<uint8_t> idxq;    // [512]
    std::vector<double> idxqTerms;
    std::vector<double> y0Exact;  // [Y0_N] fp64
    std::vector<double> y0Terms;
};

struct RowCache {
    std::vector<RowRef> rows;
    uint32_t n = 0u;
    void Init(uint32_t nRows) { rows.assign(nRows, RowRef{}); n = nRows; }

    const RowRef& Get(const Fixture& F, uint32_t absRow, const uint8_t* devY0Row, bool full)
    {
        RowRef& r = rows[absRow];
        if (!r.built) {
            r.built = true;
            if (devY0Row != nullptr) {
                BuildBasicFromY0(devY0Row, F, absRow, r);
            } else {
                BuildBasicFromGemm(F, absRow, r);
            }
        }
        if (full && !r.fullBuilt) {
            r.fullBuilt = true;
            if (devY0Row != nullptr) {
                BuildFullFromY0(devY0Row, F, absRow, r);
            } else {
                BuildFull(F, absRow, r);
            }
        }
        return r;
    }

    // 跨 chunk 的压缩组成员（q < chunkStart）用**设备自己的 raw k 字节**（在同一 chunk 处理时缓存），
    // 这样压缩行的参考也只吃"本段的输入口径"，不吃上游 GEMM 的舍入边界（见 BuildBasicFromY0 的说明）。
    std::vector<std::vector<uint8_t>> devRawk;   // [absRow] 256 B（未安装时为空）
    void EnsureRawk(uint32_t nRows) { devRawk.assign(nRows, {}); }

    // ---- ① 从**设备的 y0 行**建参考（本段的"条件判据"：被测段的输入口径 = 设备实际拿到的口径）----
    // 为什么要这一条（**不是放松判据，是把上游的舍入边界分出去**）：
    //   y0 是 bf16，K = 2560，fp32 累加 ⇒ 输出末位的噪声 ~ `2^-16·K·(Σ|terms|/|out|)` ≈ **2 ulp**（本夹具
    //   的权重 x ~ U(-1,1)、w ~ U(-0.05,0.05) 下更要大）。⇒ 任何"fp64 精确和 → 舍回 bf16"的参考都会
    //   在**格点边界**上与设备差 1 ulp，而 norm+rope 会把这 256 个输入的翻转**聚合**成输出上 ~10 ulp 的
    //   差（M116 实测：K 槽上 1~2/256 元素越出 6 ulp 的余量）。
    //   ⇒ 本段把判据分成两条**互不混淆**的：
    //     · `Pf.y0.*`（T2′，声明行）：GEMM 与 fp64 精确值的差 ≤ 0.5 ulp + ε_acc·Σ|terms| —— 判上游；
    //     · 其余（本段的 norm/rope / 池化 / cache 填）：输入取**设备 y0 的字节**才判得**紧**（1 ulp 级）—— 判本段。
    static void BuildBasicFromY0(const uint8_t* y0Row, const Fixture& F, uint32_t absRow, RowRef& r)
    {
        const uint16_t* csRow = F.cs.Row(absRow);
        const uint16_t* y0 = reinterpret_cast<const uint16_t*>(y0Row);
        std::vector<uint16_t> kRaw(NKV * HD), vRaw(NKV * HD), rkRaw(IDX_D);
        std::memcpy(kRaw.data(), y0 + Y0_K, NKV * HD * ELEM_BYTES);
        std::memcpy(vRaw.data(), y0 + Y0_V, NKV * HD * ELEM_BYTES);
        std::memcpy(rkRaw.data(), y0 + Y0_IDX + IDX_Q, IDX_D * ELEM_BYTES);
        FinishRow(kRaw, vRaw, rkRaw, F, csRow, absRow, r);
    }
    void InstallDevRawk(uint32_t absRow, const uint8_t* y0Row)
    {
        if (absRow >= devRawk.size()) {
            return;
        }
        devRawk[absRow].assign(RING_KEY_DIM * ELEM_BYTES, 0u);
        const uint16_t* y0 = reinterpret_cast<const uint16_t*>(y0Row);
        std::memcpy(devRawk[absRow].data(), y0 + Y0_IDX + IDX_Q, RING_KEY_DIM * ELEM_BYTES);
    }

    // ---- ② 从 fp64 GEMM 建参考（仅用于：单次发射档的中间 chunk 态推进 / 终态内容判据）----
    static void BuildBasicFromGemm(const Fixture& F, uint32_t absRow, RowRef& r)
    {
        const uint16_t* xr = F.XRow(absRow);
        const uint16_t* csRow = F.cs.Row(absRow);
        std::vector<double> y0K, y0V, y0Rk;
        PfGemmRowRef(xr, F.w.data(), W_K_OFF, 0u, NKV * HD, y0K);
        PfGemmRowRef(xr, F.w.data(), W_V_OFF, 0u, NKV * HD, y0V);
        PfGemmRowRef(xr, F.w.data(), W_IDX_OFF, IDX_Q, IDX_D, y0Rk);
        std::vector<uint16_t> kRaw(NKV * HD), vRaw(NKV * HD), rkRaw(IDX_D);
        for (uint32_t j = 0u; j < NKV * HD; ++j) {
            kRaw[j] = D2Bf(y0K[j]);
            vRaw[j] = D2Bf(y0V[j]);
        }
        for (uint32_t j = 0u; j < IDX_D; ++j) {
            rkRaw[j] = D2Bf(y0Rk[j]);
        }
        FinishRow(kRaw, vRaw, rkRaw, F, csRow, absRow, r);
    }

    static void FinishRow(const std::vector<uint16_t>& kRaw, const std::vector<uint16_t>& vRaw,
                          const std::vector<uint16_t>& rkRaw, const Fixture& F, const uint16_t* csRow,
                          uint32_t absRow, RowRef& r)
    {
        r.kNorm.assign(NKV * HD * 2u, 0u);
        r.kTerms.assign(NKV * HD, 0.0);
        for (uint32_t h = 0u; h < NKV; ++h) {
            std::vector<uint16_t> out;
            std::vector<double> terms;
            PfNormRopeRef(kRaw.data() + h * HD, F.w.data() + W_KN_OFF / 2u, csRow, HD, AP_MODE_CONTRACT, out,
                          &terms);
            std::memcpy(r.kNorm.data() + h * HD * 2u, out.data(), HD * ELEM_BYTES);
            std::memcpy(r.kTerms.data() + h * HD, terms.data(), HD * sizeof(double));
        }
        r.vRaw.assign(NKV * HD * 2u, 0u);
        std::memcpy(r.vRaw.data(), vRaw.data(), NKV * HD * ELEM_BYTES);
        r.rawk.assign(IDX_D * 2u, 0u);
        std::memcpy(r.rawk.data(), rkRaw.data(), IDX_D * ELEM_BYTES);
        PfRingRowRef(rkRaw.data(), absRow, r.ringRow);
        std::vector<uint16_t> kNorm16(NKV * HD), vRaw16(NKV * HD);
        std::memcpy(kNorm16.data(), r.kNorm.data(), NKV * HD * ELEM_BYTES);
        std::memcpy(vRaw16.data(), r.vRaw.data(), NKV * HD * ELEM_BYTES);
        PfMkvRowRef(kNorm16.data(), vRaw16.data(), r.kvRow);
    }

    static void BuildFull(const Fixture& F, uint32_t absRow, RowRef& r)
    {
        BuildFullInner(F, absRow, r, nullptr);
    }

    // full 档：`devY0Row != nullptr` 时 q/gate/idxq 的**输入**取自设备 y0 的字节（条件判据，见上）；
    // 无论哪种口径，`y0Exact` / `y0Terms`（T2′ 的比对面）**恒来自 fp64 GEMM**。
    static void BuildFullFromY0(const uint8_t* y0RowBytes, const Fixture& F, uint32_t absRow, RowRef& r)
    {
        BuildFullInner(F, absRow, r, y0RowBytes);
    }

    static void BuildFullInner(const Fixture& F, uint32_t absRow, RowRef& r, const uint8_t* devY0Row)
    {
        const uint16_t* xr = F.XRow(absRow);
        const uint16_t* csRow = F.cs.Row(absRow);
        std::vector<uint16_t> qRaw(QG_W), idxRaw(IDX_Q);
        if (devY0Row != nullptr) {
            const uint16_t* y0 = reinterpret_cast<const uint16_t*>(devY0Row);
            std::memcpy(qRaw.data(), y0 + Y0_QG, QG_W * ELEM_BYTES);
            std::memcpy(idxRaw.data(), y0 + Y0_IDX, IDX_Q * ELEM_BYTES);
        } else {
            std::vector<double> y0Q, y0Idx;
            PfGemmRowRef(xr, F.w.data(), W_Q_OFF, 0u, QG_W, y0Q);
            PfGemmRowRef(xr, F.w.data(), W_IDX_OFF, 0u, IDX_Q, y0Idx);
            for (uint32_t j = 0u; j < QG_W; ++j) {
                qRaw[j] = D2Bf(y0Q[j]);
            }
            for (uint32_t j = 0u; j < IDX_Q; ++j) {
                idxRaw[j] = D2Bf(y0Idx[j]);
            }
        }
        r.q.assign(QW * 2u, 0u);
        r.qTerms.assign(QW, 0.0);
        r.gate.assign(QW * 2u, 0u);
        for (uint32_t h = 0u; h < NH; ++h) {
            std::vector<uint16_t> out;
            std::vector<double> terms;
            PfNormRopeRef(qRaw.data() + h * 2u * HD, F.w.data() + W_QN_OFF / 2u, csRow, HD, AP_MODE_CONTRACT,
                          out, &terms);
            std::memcpy(r.q.data() + h * HD * 2u, out.data(), HD * ELEM_BYTES);
            std::memcpy(r.qTerms.data() + h * HD, terms.data(), HD * sizeof(double));
            std::memcpy(r.gate.data() + h * HD * 2u, qRaw.data() + h * 2u * HD + HD, HD * ELEM_BYTES);
        }
        r.idxq.assign(IDX_Q * 2u, 0u);
        r.idxqTerms.assign(IDX_Q, 0.0);
        for (uint32_t h = 0u; h < IDX_NH; ++h) {
            std::vector<uint16_t> out;
            std::vector<double> terms;
            PfNormRopeRef(idxRaw.data() + h * IDX_D, F.w.data() + W_IQN_OFF / 2u, csRow, IDX_D,
                          AP_MODE_CONTRACT, out, &terms);
            std::memcpy(r.idxq.data() + h * IDX_D * 2u, out.data(), IDX_D * ELEM_BYTES);
            std::memcpy(r.idxqTerms.data() + h * IDX_D, terms.data(), IDX_D * sizeof(double));
        }
        // 整行 y0（**恒来自 fp64 GEMM**：这是 `Pf.y0.*` 的比对面，判上游）
        r.y0Exact.assign(Y0_N, 0.0);
        r.y0Terms.assign(Y0_N, 0.0);
        std::vector<double> t;
        PfGemmRowRef(xr, F.w.data(), W_Q_OFF, 0u, QG_W, t);
        PfGemmRowTerms(xr, F.w.data(), W_Q_OFF, 0u, QG_W, r.y0Terms);
        for (uint32_t j = 0u; j < QG_W; ++j) {
            r.y0Exact[Y0_QG + j] = t[j];
        }
        PfGemmRowRef(xr, F.w.data(), W_K_OFF, 0u, NKV * HD, t);
        for (uint32_t j = 0u; j < NKV * HD; ++j) {
            r.y0Exact[Y0_K + j] = t[j];
        }
        PfGemmRowTerms(xr, F.w.data(), W_K_OFF, 0u, NKV * HD, t);
        for (uint32_t j = 0u; j < NKV * HD; ++j) {
            r.y0Terms[Y0_K + j] = t[j];
        }
        PfGemmRowRef(xr, F.w.data(), W_V_OFF, 0u, NKV * HD, t);
        for (uint32_t j = 0u; j < NKV * HD; ++j) {
            r.y0Exact[Y0_V + j] = t[j];
        }
        PfGemmRowTerms(xr, F.w.data(), W_V_OFF, 0u, NKV * HD, t);
        for (uint32_t j = 0u; j < NKV * HD; ++j) {
            r.y0Terms[Y0_V + j] = t[j];
        }
        PfGemmRowRef(xr, F.w.data(), W_IDX_OFF, 0u, IDX_W, t);
        for (uint32_t j = 0u; j < IDX_W; ++j) {
            r.y0Exact[Y0_IDX + j] = t[j];
        }
        PfGemmRowTerms(xr, F.w.data(), W_IDX_OFF, 0u, IDX_W, t);
        for (uint32_t j = 0u; j < IDX_W; ++j) {
            r.y0Terms[Y0_IDX + j] = t[j];
        }
    }
};

// ============================================================
// 5. host 侧：期望态（累积）+ 一个 chunk 的期望
// ============================================================
struct RefState {
    std::vector<uint8_t> ring;   // RING_LAYER_BYTES（起点 = 毒值）
    std::vector<uint8_t> comp;   // COMP_LAYER_STRIDE
    std::vector<uint8_t> mkv;    // AC_MAIN_KV_BYTES
    void Poison()
    {
        ring.assign(RING_LAYER_BYTES, M24_POISON);
        comp.assign(COMP_LAYER_STRIDE, M24_POISON);
        mkv.assign(AC_MAIN_KV_BYTES, M24_POISON);
    }
};

struct ChunkExp {
    uint32_t chunkStart = 0u;
    uint32_t rows = 0u;
    std::vector<std::vector<uint8_t>> inRawk;       // [rows] 280 B
    std::vector<std::vector<uint8_t>> inKv;         // [rows] 2048 B（输入面形态）
    std::vector<std::vector<uint8_t>> kSlot;        // [rows] 1024 B（2 head × (K 512 B)）
    std::vector<std::vector<double>> kSlotTerms;    // [rows] 512
    std::vector<std::vector<uint8_t>> vSlot;        // [rows] 1024 B（2 head × (V 512 B)）
    std::vector<uint32_t> candP;
    std::vector<std::vector<uint8_t>> poolRow;      // [nCand] 256 B
    std::vector<std::vector<uint8_t>> compRow;      // [nCand] 256 B
    std::vector<std::vector<double>> compTerms;     // [nCand] 128
    uint32_t ringWritten = 0u;
    uint32_t ringRead = 0u;
    uint32_t compMask = 0u;
};

// 期望态**恒按契约语义**算（`apMode = 0` / 池化除 4 / RoPE 用组首）。
// 变异档因此**必然**与期望不同 ⇒ "把被测对象弄坏必变红"这条纪律可执行。
static void ExpectChunk(const Fixture& F, RowCache& rc, RefState& st, const uint8_t* devY0, uint32_t chunkStart,
                        uint32_t rows, ChunkExp& E)
{
    E.chunkStart = chunkStart;
    E.rows = rows;
    const uint32_t chunkEnd = chunkStart + rows;
    E.inRawk.assign(rows, {});
    E.inKv.assign(rows, {});
    E.kSlot.assign(rows, {});
    E.kSlotTerms.assign(rows, {});
    E.vSlot.assign(rows, {});
    for (uint32_t r = 0u; r < rows; ++r) {
        const uint8_t* y0Row = (devY0 == nullptr)
                                   ? nullptr
                                   : (devY0 + static_cast<size_t>(r) * PF_Y0_STRIDE * ELEM_BYTES);
        if (y0Row != nullptr) {
            rc.InstallDevRawk(chunkStart + r, y0Row);
        }
        const RowRef& rr = rc.Get(F, chunkStart + r, y0Row, false);
        E.inRawk[r] = rr.ringRow;
        E.inKv[r] = rr.kvRow;
        E.kSlot[r].assign(KV_HEADS * KV_HEAD_CONTENT_BYTES, 0u);
        std::memcpy(E.kSlot[r].data(), rr.kNorm.data(), KV_HEADS * KV_HEAD_CONTENT_BYTES);
        E.kSlotTerms[r] = rr.kTerms;
        E.vSlot[r].assign(KV_HEADS * KV_HEAD_CONTENT_BYTES, 0u);
        std::memcpy(E.vSlot[r].data(), rr.vRaw.data(), KV_HEADS * KV_HEAD_CONTENT_BYTES);
    }
    uint32_t candP[AC_MAX_GROUPS];
    const uint32_t nCand = PfCandidates(chunkStart, rows, candP);
    E.candP.assign(candP, candP + nCand);
    E.poolRow.assign(nCand, {});
    E.compRow.assign(nCand, {});
    E.compTerms.assign(nCand, {});
    E.ringRead = 0u;
    for (uint32_t c = 0u; c < nCand; ++c) {
        const uint32_t p = E.candP[c];
        const uint16_t* members[COMP_TOKENS_PER_STATE];
        for (uint32_t i = 0u; i < COMP_TOKENS_PER_STATE; ++i) {
            const uint32_t q = p - (COMP_TOKENS_PER_STATE - 1u) + i;
            if (q >= chunkStart) {
                const uint8_t* y0Row = (devY0 == nullptr)
                                           ? nullptr
                                           : (devY0 + static_cast<size_t>(q - chunkStart) * PF_Y0_STRIDE * ELEM_BYTES);
                const RowRef& rr = rc.Get(F, q, y0Row, false);
                members[i] = reinterpret_cast<const uint16_t*>(rr.rawk.data());
            } else {
                ++E.ringRead;   // 设备同款计数：跨 chunk 的成员
                if ((q < rc.devRawk.size()) && !rc.devRawk[q].empty()) {
                    // 该行在**更早的 chunk** 里处理过 ⇒ 用当时缓存下来的**设备 raw k 字节**
                    members[i] = reinterpret_cast<const uint16_t*>(rc.devRawk[q].data());
                } else {
                    const uint64_t off = M15KV_RING_ROW_OFF(0u, q);
                    members[i] = reinterpret_cast<const uint16_t*>(st.ring.data() + off);
                }
            }
        }
        std::vector<uint16_t> pooled;
        PfPoolRef(members, true, pooled);
        E.poolRow[c].assign(RING_KEY_DIM * ELEM_BYTES, 0u);
        std::memcpy(E.poolRow[c].data(), pooled.data(), RING_KEY_DIM * ELEM_BYTES);
        std::vector<uint16_t> comp;
        std::vector<double> terms;
        PfNormRopeRef(pooled.data(), F.w.data() + W_IKN_OFF / 2u, F.cs.Row(PfGroupFirstPos(p)), IDX_D,
                      AP_MODE_CONTRACT, comp, &terms);
        E.compRow[c].assign(RING_KEY_DIM * ELEM_BYTES, 0u);
        std::memcpy(E.compRow[c].data(), comp.data(), RING_KEY_DIM * ELEM_BYTES);
        E.compTerms[c] = terms;
    }
    // ---- 写环（累积状态；门控 = 只写本 chunk 末尾 capacity 行）----
    E.ringWritten = 0u;
    for (uint32_t r = 0u; r < rows; ++r) {
        const uint32_t q = chunkStart + r;
        if (!PfRingRowWritten(q, chunkStart, chunkEnd)) {
            continue;
        }
        const uint64_t off = M15KV_RING_ROW_OFF(0u, q);
        std::memcpy(st.ring.data() + off, E.inRawk[r].data(), RING_ROW_BYTES);
        ++E.ringWritten;
    }
    // ---- 主 KV（累积状态；一行 4 个槽，**只用宏算偏移**）----
    for (uint32_t r = 0u; r < rows; ++r) {
        const uint32_t pos = chunkStart + r;
        for (uint32_t h = 0u; h < KV_HEADS; ++h) {
            for (uint32_t kv = 0u; kv < 2u; ++kv) {
                const uint64_t off = M15KV_KV_BYTE_OFF_CONTIG(pos, h, kv, 0u);
                const uint8_t* src = ((kv == 0u) ? E.kSlot[r].data() : E.vSlot[r].data()) +
                                     static_cast<size_t>(h) * KV_HEAD_CONTENT_BYTES;
                std::memcpy(st.mkv.data() + off, src, KV_HEAD_CONTENT_BYTES);
            }
        }
    }
    // ---- 压缩行（累积状态）----
    E.compMask = 0u;
    for (uint32_t c = 0u; c < nCand; ++c) {
        const uint32_t g = M15KV_COMP_GROUP_OF(E.candP[c]);
        const uint64_t off = M15KV_COMP_ROW_OFF_PHYS(g / COMP_ROWS_PER_BLOCK, g);
        std::memcpy(st.comp.data() + off, E.compRow[c].data(), COMP_ROW_BYTES);
        E.compMask |= (1u << (g % COMP_ROWS_PER_BLOCK));
    }
}

// ============================================================
// 6. host 侧：一个 chunk 的判据（每条判据**按 chunk 聚合成一条**，日志才可读）
// ============================================================
struct DevPlanes {
    const uint8_t* in = nullptr;
    const uint8_t* kv = nullptr;
    const uint8_t* comp = nullptr;
    const uint8_t* ring = nullptr;
    const uint8_t* pack = nullptr;
    const uint8_t* pooled = nullptr;
    const int32_t* flag = nullptr;
    const uint8_t* y0 = nullptr;
    const uint8_t* out = nullptr;
};

static void CheckChunk(Stats& st, const Fixture& F, RowCache& rc, const RefState& R, const ChunkExp& E,
                       const DevPlanes& P, const std::vector<uint32_t>& fullRows, const char* tagSuffix,
                       bool verbose, const uint8_t* devY0, bool runGuards)
{
    char tag[96];
    const uint32_t rows = E.rows;

    // ---- 真 guard（**只在契约档跑**；变异档本来就会把设备值/参考值改坏）----
    // 这道闸防的是"T3 的参考由**设备 y0** 建 ⇒ 设备 y0 全毒时两边一起毒、判据空过"（复审 P2-1）。
    // 毒值位型 `0xCDCD` 的 bf16 值 ≈ −4.3e8 ⇒ 用"幅值上界"判"这一行还是毒值"比逐字节比对更稳；
    // 抽前 64 个元素即可（整行未写 ⇒ 前 64 个也全是毒值）。
    if (runGuards) {
        // ⚠ **逐行**断言（不是"至少一行"）：毒值位型 `0xCDCD` 的 bf16 值 = −1.6015625×2²⁸ ≈ −4.29916e8
        // ⇒ 阈值 1e6 对"未写过的行"必判非活、对真实的 GEMM 产物（量级 O(1)）必判活。
        // 一行都不许是毒值 ⇒ 这道闸咬得住"设备 y0 整面没写、参考与设备一起毒"这个空过形态。
        // **红方向已有设备读数**（不只是构造性论证）：`MUT_guard_nogemm` 档（`runGuards` 被
        // `Case::guardMutant` 强制打开）在设备上给出 `poisonRows=64/64`、`guardFails=2`
        // —— 见 `m24_attn_prefill/README.md` §4-C。
        // （本轮删掉了原先的 `Pf.guard.reflive`：它断言"参考 K 槽面里至少 1 字节 ≠ 0xCD"，
        //   而 K 槽参考是 norm+rope 的输出 ⇒ 恒真、虚增 guard 数。）
        uint32_t poisonRows = 0u;
        for (uint32_t r = 0u; r < rows; ++r) {
            const uint8_t* y0row = P.y0 + static_cast<size_t>(r) * PF_Y0_STRIDE * ELEM_BYTES;
            bool live = false;
            for (uint32_t j = 0u; ((j < 64u) && (2u * j + 1u < PF_Y0_STRIDE * ELEM_BYTES)); ++j) {
                uint16_t b;
                std::memcpy(&b, y0row + 2u * j, 2u);
                if (std::fabs(Bf2D(b)) < 1.0e6) {
                    live = true;
                    break;
                }
            }
            if (!live) {
                ++poisonRows;
            }
        }
        char gdet[64];
        snprintf(gdet, sizeof(gdet), "poisonRows=%u/%u(阈值 1e6)", poisonRows, rows);
        snprintf(tag, sizeof(tag), "Pf.guard.y0live.%s", tagSuffix);
        st.Guard(tag, poisonRows == 0u, gdet);   // **每一行**都必须是"活"的（逐行断言）

        if (E.candP.size() != 0u) {
            bool poolLive = false;
            for (size_t j = 0u; j < E.poolRow[0].size(); ++j) {
                if (E.poolRow[0][j] != M24_POISON) {
                    poolLive = true;
                    break;
                }
            }
            snprintf(tag, sizeof(tag), "Ac.guard.poollive.%s", tagSuffix);
            st.Guard(tag, poolLive, "池化行参考 != 毒值面");
        }
    }

    // ---- Pf.in.rawk：输入面的环行 = ① raw k 256 B（**与设备 y0 的 idx raw k 段逐字节**，
    //      这是本段自己的抄写，用设备内部一致性判，不掺 GEMM 的舍入边界）
    //      ② 位置尾 24 B（= 3×int64(pos)，与参考逐字节；它是标量算出来的值）----
    {
        uint32_t badRaw = 0u;
        uint32_t badTail = 0u;
        for (uint32_t r = 0u; r < rows; ++r) {
            const uint8_t* got = P.in + AC_IN_RAWK_OFF + static_cast<size_t>(r) * AC_IN_RAWK_STRIDE_BYTES;
            const uint8_t* y0r = P.y0 + static_cast<size_t>(r) * PF_Y0_STRIDE * ELEM_BYTES;
            const uint8_t* y0rawk = y0r + (Y0_IDX + IDX_Q) * ELEM_BYTES;
            if (std::memcmp(got, y0rawk, RING_KEY_DIM * ELEM_BYTES) != 0) {
                ++badRaw;
            }
            if (std::memcmp(got + RING_KEY_DIM * ELEM_BYTES, E.inRawk[r].data() + RING_KEY_DIM * ELEM_BYTES,
                            RING_TAIL_BYTES) != 0) {
                ++badTail;
            }
        }
        snprintf(tag, sizeof(tag), "Pf.in.rawk.%s", tagSuffix);
        st.Note(tag, (badRaw == 0u) && (badTail == 0u));
        if ((badRaw != 0u) || (badTail != 0u)) {
            printf("[M24]   %-32s raw k 不符 %u 行、位置尾不符 %u 行（共 %u 行）\n", tag, badRaw, badTail, rows);
        }
    }
    // ---- Pf.in.kv：输入面的 K/V 行（K 槽 T3 + 上游 y0 的 ulp 余量；V 槽 = **与设备 y0 的 v 段逐字节**）----
    {
        uint32_t badK = 0u;
        uint32_t badV = 0u;
        std::vector<double> terms(KV_HEAD_DIM, 0.0);
        for (uint32_t r = 0u; r < rows; ++r) {
            const uint8_t* row = P.in + AC_IN_KV_OFF + static_cast<size_t>(r) * AC_IN_KV_ROW_BYTES;
            const uint8_t* y0r = P.y0 + static_cast<size_t>(r) * PF_Y0_STRIDE * ELEM_BYTES;
            for (uint32_t h = 0u; h < KV_HEADS; ++h) {
                const uint8_t* gotK = row + static_cast<size_t>(h) * 2u * KV_HEAD_CONTENT_BYTES;
                const uint8_t* expK = E.kSlot[r].data() + static_cast<size_t>(h) * KV_HEAD_CONTENT_BYTES;
                std::memcpy(terms.data(), E.kSlotTerms[r].data() + h * KV_HEAD_DIM, KV_HEAD_DIM * sizeof(double));
                if (!ChkT3Tag("(quiet)", gotK, expK, terms.data(), KV_HEAD_DIM, PF_T3_SLACK_ULP, false)) {
                    ++badK;
                }
                const uint8_t* gotV = gotK + KV_HEAD_CONTENT_BYTES;
                const uint8_t* y0v = y0r + (Y0_V + h * HD) * ELEM_BYTES;
                if (std::memcmp(gotV, y0v, KV_HEAD_CONTENT_BYTES) != 0) {
                    ++badV;
                }
            }
        }
        snprintf(tag, sizeof(tag), "Pf.in.kv.%s", tagSuffix);
        st.Note(tag, (badK == 0u) && (badV == 0u));
        if ((badK != 0u) || (badV != 0u)) {
            printf("[M24]   %-32s K 槽不符 %u、V 槽（vs 设备 y0）不符 %u（共 %u 行）\n", tag, badK, badV, rows);
        }
    }
    // ---- Pf.in.w：输入面里的 `attn_idx_k_norm` 权重（256 B）----
    {
        const uint8_t* got = P.in + AC_IN_W_OFF;
        const uint8_t* exp = reinterpret_cast<const uint8_t*>(F.w.data() + W_IKN_OFF / 2u);
        snprintf(tag, sizeof(tag), "Pf.in.w.%s", tagSuffix);
        st.Note(tag, ChkBytesTag(tag, got, exp, AC_IN_W_BYTES, verbose));
    }
    // ---- Ac.ring：环平面（累积模型的逐字节）----
    {
        snprintf(tag, sizeof(tag), "Ac.ring.%s", tagSuffix);
        st.Note(tag, ChkBytesTag(tag, P.ring, R.ring.data(), RING_LAYER_BYTES, verbose));
    }
    // ---- Ac.pool：本 chunk 的池化行（逐字节）----
    {
        uint32_t bad = 0u;
        for (size_t c = 0u; c < E.candP.size(); ++c) {
            const uint8_t* got = P.pooled + c * RING_KEY_DIM * ELEM_BYTES;
            if (std::memcmp(got, E.poolRow[c].data(), RING_KEY_DIM * ELEM_BYTES) != 0) {
                ++bad;
            }
        }
        snprintf(tag, sizeof(tag), "Ac.pool.%s", tagSuffix);
        st.Note(tag, bad == 0u);
        if (bad != 0u) {
            printf("[M24]   %-32s 池化行不符 %u/%zu\n", tag, bad, E.candP.size());
        }
    }
    // ---- Ac.comp：本 chunk 的压缩行（T3）----
    {
        uint32_t bad = 0u;
        for (size_t c = 0u; c < E.candP.size(); ++c) {
            const uint32_t g = M15KV_COMP_GROUP_OF(E.candP[c]);
            const uint64_t off = M15KV_COMP_ROW_OFF_PHYS(g / COMP_ROWS_PER_BLOCK, g);
            if (!ChkT3Tag("(quiet)", P.comp + off, E.compRow[c].data(), E.compTerms[c].data(), RING_KEY_DIM,
                          PF_T3_SLACK_ULP, false)) {
                ++bad;
            }
        }
        snprintf(tag, sizeof(tag), "Ac.comp.%s", tagSuffix);
        st.Note(tag, bad == 0u);
        if (bad != 0u) {
            printf("[M24]   %-32s 压缩行 T3 越界 %u/%zu\n", tag, bad, E.candP.size());
        }
    }
    // ---- Ac.mkv：本 chunk 的行在主 KV 里的槽
    //      K 槽 = norm+rope 的结果（T3 + 上游 y0 的 ulp 余量）；
    //      V 槽 = **与设备 y0 的 v 段逐字节**（本段自己的抄写，判设备内部一致性）----
    {
        uint32_t badK = 0u;
        uint32_t badV = 0u;
        for (uint32_t r = 0u; r < rows; ++r) {
            const uint32_t pos = E.chunkStart + r;
            const uint8_t* y0r = P.y0 + static_cast<size_t>(r) * PF_Y0_STRIDE * ELEM_BYTES;
            for (uint32_t h = 0u; h < KV_HEADS; ++h) {
                const uint64_t offK = M15KV_KV_BYTE_OFF_CONTIG(pos, h, 0u, 0u);
                const uint8_t* expK = E.kSlot[r].data() + static_cast<size_t>(h) * KV_HEAD_CONTENT_BYTES;
                if (!ChkT3Tag("(quiet)", P.kv + offK, expK, E.kSlotTerms[r].data() + h * KV_HEAD_DIM,
                              KV_HEAD_DIM, PF_T3_SLACK_ULP, false)) {
                    ++badK;
                }
                const uint64_t offV = M15KV_KV_BYTE_OFF_CONTIG(pos, h, 1u, 0u);
                const uint8_t* y0v = y0r + (Y0_V + h * HD) * ELEM_BYTES;
                if (std::memcmp(P.kv + offV, y0v, KV_HEAD_CONTENT_BYTES) != 0) {
                    ++badV;
                }
            }
        }
        snprintf(tag, sizeof(tag), "Ac.mkv.%s", tagSuffix);
        st.Note(tag, (badK == 0u) && (badV == 0u));
        if ((badK != 0u) || (badV != 0u)) {
            printf("[M24]   %-32s K 槽 T3 越界 %u、V 槽（vs 设备 y0）逐字节不符 %u（共 %u 行 × 2 head）\n", tag,
                   badK, badV, rows);
        }
    }
    // ---- Ac.pack：packed 的 seed 行原样抄写 ----
    {
        snprintf(tag, sizeof(tag), "Ac.pack.%s", tagSuffix);
        st.Note(tag, ChkBytesTag(tag, P.pack, F.packSeed.data(), AC_PACK_BYTES, verbose));
    }
    // ---- Ac.flag：门控 8 个 lane（第 8 个 = 前端契约 lane，必须 0）----
    {
        const int32_t exp[AC_FLAG_LANES] = {
            static_cast<int32_t>(E.ringWritten), static_cast<int32_t>(E.candP.size()),
            static_cast<int32_t>(E.chunkStart),  static_cast<int32_t>(rows),
            0,                                   static_cast<int32_t>(E.ringRead),
            static_cast<int32_t>(E.compMask),    0};
        bool ok = true;
        for (uint32_t i = 0u; i < AC_FLAG_LANES; ++i) {
            if (P.flag[i] != exp[i]) {
                ok = false;
                printf("[M24]   Ac.flag.%s lane%u got=%d exp=%d\n", tagSuffix, i, static_cast<int>(P.flag[i]),
                       static_cast<int>(exp[i]));
            }
        }
        snprintf(tag, sizeof(tag), "Ac.flag.%s", tagSuffix);
        st.Note(tag, ok);
    }
    // ---- Pf.y0 / Pf.out：**声明行**的整行判据（全 13952 列）----
    for (uint32_t r : fullRows) {
        if (r >= rows) {
            continue;
        }
        const uint32_t absRow = E.chunkStart + r;
        const uint8_t* y0in = (devY0 == nullptr) ? nullptr
                                                 : (devY0 + static_cast<size_t>(r) * PF_Y0_STRIDE * ELEM_BYTES);
        const RowRef& rr = rc.Get(F, absRow, y0in, true);
        const uint8_t* y0row = P.y0 + static_cast<size_t>(r) * PF_Y0_STRIDE * ELEM_BYTES;
        snprintf(tag, sizeof(tag), "Pf.y0.r%u.%s", r, tagSuffix);
        {
            const bool okY0 = ChkT2Tag(tag, y0row, rr.y0Exact.data(), rr.y0Terms.data(), Y0_N, verbose);
            st.Note(tag, okY0);
            if (!okY0) {
                // 诊断：前 4 个元素与整行最大 |Δ|（把"整行都不同"与"边界翻转"分开）
                double maxd = 0.0;
                uint32_t argd = 0u;
                for (uint32_t j = 0u; j < Y0_N; ++j) {
                    uint16_t gb;
                    std::memcpy(&gb, y0row + 2u * j, 2u);
                    const double d = std::fabs(Bf2D(gb) - rr.y0Exact[j]);
                    if (d > maxd) {
                        maxd = d;
                        argd = j;
                    }
                }
                printf("[M24]     y0.r%u 诊断：max|Δ|=%.6g @#%u | got[0..3]=%.4g %.4g %.4g %.4g | exp[0..3]=%.4g "
                       "%.4g %.4g %.4g\n",
                       r, maxd, argd, Bf2D(*reinterpret_cast<const uint16_t*>(y0row)),
                       Bf2D(*(reinterpret_cast<const uint16_t*>(y0row) + 1u)),
                       Bf2D(*(reinterpret_cast<const uint16_t*>(y0row) + 2u)),
                       Bf2D(*(reinterpret_cast<const uint16_t*>(y0row) + 3u)), rr.y0Exact[0], rr.y0Exact[1],
                       rr.y0Exact[2], rr.y0Exact[3]);
            }
        }
        const uint8_t* outrow = P.out + static_cast<size_t>(r) * PF_OUT_STRIDE * ELEM_BYTES;
        snprintf(tag, sizeof(tag), "Pf.out.q.r%u.%s", r, tagSuffix);
        st.Note(tag, ChkT3Tag(tag, outrow + OUT_Q * ELEM_BYTES, rr.q.data(), rr.qTerms.data(), QW,
                              PF_T3_SLACK_ULP, verbose));
        // gate 是**原样抄写** ⇒ 与设备 y0 的 gate 段逐字节（设备内部一致性，不掺 GEMM 舍入）
        {
            bool okGate = true;
            for (uint32_t h = 0u; h < NH; ++h) {
                const uint8_t* got = outrow + (OUT_GATE + h * HD) * ELEM_BYTES;
                const uint8_t* src = y0row + (Y0_QG + h * 2u * HD + HD) * ELEM_BYTES;
                if (std::memcmp(got, src, HD * ELEM_BYTES) != 0) {
                    okGate = false;
                }
            }
            snprintf(tag, sizeof(tag), "Pf.out.gate.r%u.%s", r, tagSuffix);
            st.Note(tag, okGate);
        }
        snprintf(tag, sizeof(tag), "Pf.out.qidx.r%u.%s", r, tagSuffix);
        st.Note(tag, ChkT3Tag(tag, outrow + OUT_QIDX * ELEM_BYTES, rr.idxq.data(), rr.idxqTerms.data(),
                              IDX_Q, PF_T3_SLACK_ULP, verbose));
    }
}

// ============================================================
// 7. 设备缓冲 + 案例执行
// ============================================================
struct DevBuf {
    void* p = nullptr;
    size_t bytes = 0u;
    bool Alloc(size_t n)
    {
        bytes = n;
        return aclrtMalloc(&p, n, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }
    void Free()
    {
        if (p != nullptr) {
            aclrtFree(p);
            p = nullptr;
        }
    }
};

static constexpr uint32_t M24_MAX_ROWS = PREFILL_M + 1u;   // 4098（含 1 行余量）

struct Case {
    const char* name;
    uint32_t rowStart;
    uint32_t seqRows;
    uint32_t chunkRows;
    uint32_t nChunks;
    uint32_t mut;
    uint32_t acMode;
    bool step;        // true = 每个 chunk 一次 launch（逐 chunk 判据）；false = 一次 launch 跑完
    bool expectRed;   // 变异档：要求**至少一条**判据变红
    bool fullFirst;   // 第一个 chunk 上做"声明行"的整行判据
    bool fullLast;    // 最后一个 chunk 上做
    // 已知缺陷档（**期望响亮失败**）：段体对 `nChunks > 1` 有 `Trap` 硬拦（`m15_attn_prefill.h`
    // 的 `AttnPrefillPhaseA`），本档就是去打那道硬拦 —— 它**不是**契约档，但也不该把全档判成红。
    bool expectLaunchFail;
    // `guardMutant`：**变异档里也要跑 guard** 的那一类（缺省 false；聚合初始化里省略即取该值）。
    // 用途 = 让 `Pf.guard.y0live` 的**红方向**有可实跑的负向对照：唯一会造成 y0 全毒的是
    // `PF_MUT_NO_GEMM`，而它属 `expectRed` ⇒ 默认 `runGuards = !expectRed` 会让这道闸只被看到"绿"。
    bool guardMutant = false;
};

int32_t main()
{
    setvbuf(stdout, nullptr, _IOLBF, 0u);   // 行缓冲：日志边跑边落盘（设备档要能看进度）
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    int64_t aicNum = 0;
    if ((aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS) || (aicNum <= 0)) {
        printf("[M24][FAIL] query AICORE_CORE_NUM failed\n");
        return 1;
    }
    const uint32_t nblk = static_cast<uint32_t>(aicNum);
    printf("[M24] mix(1,2) launch: nblk(AIC)=%u → AIV=%u；chunk=%u 行 = %u 个 m-tile（%u 行）\n", nblk,
           nblk * 2u, PF_ROWS, PF_M_TILES, PF_M_TILE);
    printf("[M24] 形状：HIDDEN=%u NH=%u HD=%u NKV=%u IDX_NH=%u IDX_D=%u ROT=%u | item 维=%u"
           " | GEMM 项=%u（%u m-tile × %u N 块）\n",
           AP_HIDDEN, NH, HD, NKV, IDX_NH, IDX_D, ROT, PF_ITEMS, PF_GEMM_ITEMS, PF_M_TILES, PF_NBLOCKS);
    printf("[M24] cache：主 KV 层 stride=%u、压缩层 stride=%u、环层 stride=%u、packed 行=%u B\n",
           KV_LAYER_STRIDE, COMP_LAYER_STRIDE, RING_LAYER_BYTES, PACK_ROW_BYTES);

    // ---- 夹具（全案共用：x 只依赖行号；w/cs/pos 是静态输入）----
    Fixture F;
    F.Build(M24_MAX_ROWS);
    printf("[M24] 夹具：x %u 行 × %u bf16、权重平面 %u B（8 role）、cos/sin %u 行、packed seed %u B\n", F.nRows,
           AP_HIDDEN, W_BYTES, CS_NPOS, AC_PACK_BYTES);

    RowCache rc;
    rc.Init(M24_MAX_ROWS);
    rc.EnsureRawk(M24_MAX_ROWS);   // 跨 chunk 的压缩组成员用"设备自己的 raw k 字节"（见 RowCache 的说明）

    DevBuf dx, dw, dcs, dpos, dy0, dout, din, dkv, dcomp, dring, dpack, dseed, dpool, dflag;
    bool allocOk = true;
    allocOk = allocOk && dx.Alloc(static_cast<size_t>(F.nRows) * AP_HIDDEN * ELEM_BYTES);
    allocOk = allocOk && dw.Alloc(W_BYTES);
    allocOk = allocOk && dcs.Alloc(AP_CS_BYTES);
    allocOk = allocOk && dpos.Alloc(static_cast<size_t>(F.nRows) * 4u);
    allocOk = allocOk && dy0.Alloc(static_cast<size_t>(PF_ROWS) * PF_Y0_STRIDE * ELEM_BYTES);
    allocOk = allocOk && dout.Alloc(static_cast<size_t>(PF_ROWS) * PF_OUT_STRIDE * ELEM_BYTES);
    allocOk = allocOk && din.Alloc(AC_IN_BYTES);
    allocOk = allocOk && dkv.Alloc(AC_MAIN_KV_BYTES);
    allocOk = allocOk && dcomp.Alloc(COMP_LAYER_STRIDE);
    allocOk = allocOk && dring.Alloc(RING_LAYER_BYTES);
    allocOk = allocOk && dpack.Alloc(AC_PACK_BYTES);
    allocOk = allocOk && dseed.Alloc(AC_PACK_BYTES);
    allocOk = allocOk && dpool.Alloc(static_cast<size_t>(AC_MAX_GROUPS) * RING_KEY_DIM * ELEM_BYTES);
    allocOk = allocOk && dflag.Alloc(AC_FLAG_LANES * 4u);
    if (!allocOk) {
        printf("[M24][FAIL] aclrtMalloc failed\n");
        return 1;
    }
    auto h2d = [&](DevBuf& b, const void* src) {
        return aclrtMemcpy(b.p, b.bytes, src, b.bytes, ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    };
    bool ioOk = true;
    ioOk = ioOk && h2d(dx, F.x.data());
    ioOk = ioOk && h2d(dw, F.w.data());
    ioOk = ioOk && h2d(dcs, F.cs.bf.data());
    ioOk = ioOk && h2d(dpos, F.posTbl.data());
    ioOk = ioOk && h2d(dseed, F.packSeed.data());
    if (!ioOk) {
        printf("[M24][FAIL] H2D failed\n");
        return 1;
    }

    const Case cases[] = {
        // 契约档（真档）
        {"big4097_step", 0u, 4097u, PF_ROWS, 33u, 0u, 0u, true, false, true, true, false},
        // 已知缺陷档：nChunks=33 的一次性发射 —— 段体现在对它 `Trap` 硬拦 ⇒ **期望 launch 非正常结束**
        {"m1ctx4097", 4096u, 1u, 1u, 1u, 0u, 0u, true, false, true, true, false},
        {"rag65_step", 0u, 393u, 65u, 7u, 0u, 0u, true, false, true, true, false},
        {"m128", 0u, 128u, 128u, 1u, 0u, 0u, true, false, true, true, false},
        {"m64", 0u, 64u, 64u, 1u, 0u, 0u, true, false, true, true, false},
        {"m2", 0u, 2u, 2u, 1u, 0u, 0u, true, false, true, true, false},
        // 变异档（"把被测对象弄坏必变红"）：前端四个方向级 + 四条"跳过一段" + cache 的五个
        {"MUT_plaimnorm", 0u, 64u, 64u, 1u, AP_MODE_PLAIN_NORM, 0u, true, true, true, true},
        {"MUT_ropesign", 0u, 64u, 64u, 1u, AP_MODE_ROPE_SIGN, 0u, true, true, true, true},
        {"MUT_norope", 0u, 64u, 64u, 1u, AP_MODE_NO_ROPE, 0u, true, true, true, true},
        {"MUT_nogemm", 0u, 64u, 64u, 1u, PF_MUT_NO_GEMM, 0u, true, true, true, true},
        {"MUT_nokv", 0u, 64u, 64u, 1u, PF_MUT_NO_KV, 0u, true, true, true, true},
        {"MUT_norawk", 0u, 64u, 64u, 1u, PF_MUT_NO_RAWK, 0u, true, true, true, true},
        {"MUT_noqidx", 0u, 64u, 64u, 1u, PF_MUT_NO_QIDX, 0u, true, true, true, true},
        {"MUT_ac_noringstore", 0u, 64u, 64u, 1u, 0u, AC_MODE_NO_RING_STORE, true, true, true, true},
        {"MUT_ac_nocompstore", 0u, 64u, 64u, 1u, 0u, AC_MODE_NO_COMP_STORE, true, true, true, true},
        // **guard 的红方向负向对照**：不跑 GEMM ⇒ 设备 y0 停在本 case 开始时铺的毒值上
        // ⇒ `Pf.guard.y0live` 必须实测变红（`poisonRows=64/64`），`Ac.guard.poollive` 亦红。
        // （`MUT_nogemm` 打的是同一条 mut，但那一档 `runGuards=false` ⇒ 看不到 guard 的红方向。）
        {"MUT_guard_nogemm", 0u, 64u, 64u, 1u, PF_MUT_NO_GEMM, 0u, true, true, true, true, false, true},
        {"MUT_ac_sumnotmean", 0u, 64u, 64u, 1u, 0u, AC_MODE_SUM_NOT_MEAN, true, true, true, true},
        {"MUT_ac_offbyone", 0u, 64u, 64u, 1u, 0u, AC_MODE_OFFBYONE, true, true, true, true},
        {"MUT_ac_noringread", 0u, 393u, 65u, 7u, 0u, AC_MODE_NO_RING_READ, true, true, true, true, false},
        // ---- 已知缺陷档（**排在最后**：aicore exception 有污染 stream/context 的风险，
        //      按仓内先例（M98 的 `Ac.dcpad.required`）把期望 Trap 的档放在末位，避免后面连坐）----
        {"big4097_seq_refused", 0u, 4097u, PF_ROWS, 33u, 0u, 0u, false, false, false, true, true},
    };
    constexpr uint32_t nCases = sizeof(cases) / sizeof(cases[0]);
    if (std::getenv("M24_T3V") != nullptr) {
        g_t3Verbose = true;
        printf("[M24] M24_T3V=1：T3 判据打印最坏比值\n");
    }
    const char* only = std::getenv("M24_ONLY");
    if (only != nullptr) {
        printf("[M24] M24_ONLY=%s（只跑名字里含该串的案例；诊断用）\n", only);
    }

    bool allOk = true;
    for (uint32_t ci = 0u; ci < nCases; ++ci) {
        const Case& cs = cases[ci];
        if ((only != nullptr) && (std::strstr(cs.name, only) == nullptr)) {
            continue;
        }
        printf("\n[M24] ==== 案例 %s（rows=%u @%u, chunk=%u × %u, mut=0x%x, acMode=%u, %s）====\n", cs.name,
               cs.seqRows, cs.rowStart, cs.chunkRows, cs.nChunks, cs.mut, cs.acMode,
               cs.step ? "逐 chunk 发射" : "单次发射");
        Stats st;
        RefState R;
        R.Poison();
        std::vector<uint8_t> zeroIn(AC_IN_BYTES, M24_POISON);
        std::vector<uint8_t> zeroY0(static_cast<size_t>(PF_ROWS) * PF_Y0_STRIDE * ELEM_BYTES, M24_POISON);
        std::vector<uint8_t> zeroOut(static_cast<size_t>(PF_ROWS) * PF_OUT_STRIDE * ELEM_BYTES, M24_POISON);
        std::vector<uint8_t> zeroPool(static_cast<size_t>(AC_MAX_GROUPS) * RING_KEY_DIM * ELEM_BYTES, M24_POISON);
        int32_t zeroFlag[AC_FLAG_LANES] = {-1, -1, -1, -1, -1, -1, -1, -1};

        aclrtMemset(dkv.p, dkv.bytes, M24_POISON, dkv.bytes);
        aclrtMemset(dcomp.p, dcomp.bytes, M24_POISON, dcomp.bytes);
        aclrtMemset(dring.p, dring.bytes, M24_POISON, dring.bytes);
        aclrtMemset(dpack.p, dpack.bytes, M24_POISON, dpack.bytes);
        // 逐 chunk 跑
        const uint32_t totalChunks = cs.nChunks;
        std::vector<uint8_t> hkv(AC_MAIN_KV_BYTES), hcomp(COMP_LAYER_STRIDE), hring(RING_LAYER_BYTES);
        std::vector<uint8_t> hin(AC_IN_BYTES), hpoll(AC_MAX_GROUPS * RING_KEY_DIM * ELEM_BYTES);
        std::vector<uint8_t> hy0(static_cast<size_t>(PF_ROWS) * PF_Y0_STRIDE * ELEM_BYTES);
        std::vector<uint8_t> hout(static_cast<size_t>(PF_ROWS) * PF_OUT_STRIDE * ELEM_BYTES);
        std::vector<uint8_t> hpack(AC_PACK_BYTES);
        std::vector<int32_t> hflag(AC_FLAG_LANES);

        bool aborted = false;   // 已知缺陷档（期望 Trap）走到 launch 失败 ⇒ 终态判据不再做
        for (uint32_t c = 0u; c < totalChunks; ++c) {
            const uint32_t rowsOff = c * cs.chunkRows;
            if (rowsOff >= cs.seqRows) {
                break;
            }
            uint32_t rows = cs.chunkRows;
            if (rows > (cs.seqRows - rowsOff)) {
                rows = cs.seqRows - rowsOff;
            }
            const uint32_t absStart = cs.rowStart + rowsOff;
            // 每 chunk 覆写的 scratch 重置成毒值（与"每 chunk 覆写"的契约一致）
            aclrtMemcpy(din.p, din.bytes, zeroIn.data(), zeroIn.size(), ACL_MEMCPY_HOST_TO_DEVICE);
            aclrtMemcpy(dy0.p, dy0.bytes, zeroY0.data(), zeroY0.size(), ACL_MEMCPY_HOST_TO_DEVICE);
            aclrtMemcpy(dout.p, dout.bytes, zeroOut.data(), zeroOut.size(), ACL_MEMCPY_HOST_TO_DEVICE);
            aclrtMemcpy(dpool.p, dpool.bytes, zeroPool.data(), zeroPool.size(), ACL_MEMCPY_HOST_TO_DEVICE);
            aclrtMemcpy(dflag.p, dflag.bytes, zeroFlag, sizeof(zeroFlag), ACL_MEMCPY_HOST_TO_DEVICE);

            if (cs.step) {
                m24_attn_prefill_kernel<<<nblk, 0, stream>>>(
                    reinterpret_cast<uint8_t*>(dx.p), reinterpret_cast<uint8_t*>(dw.p),
                    reinterpret_cast<uint8_t*>(dcs.p), reinterpret_cast<uint8_t*>(dpos.p),
                    reinterpret_cast<uint8_t*>(dy0.p), reinterpret_cast<uint8_t*>(dout.p),
                    reinterpret_cast<uint8_t*>(din.p), reinterpret_cast<uint8_t*>(dkv.p),
                    reinterpret_cast<uint8_t*>(dcomp.p), reinterpret_cast<uint8_t*>(dring.p),
                    reinterpret_cast<uint8_t*>(dpack.p), reinterpret_cast<uint8_t*>(dseed.p),
                    reinterpret_cast<uint8_t*>(dpool.p), reinterpret_cast<uint8_t*>(dflag.p), absStart, rows,
                    rows, 1u, 0u, cs.mut, cs.acMode);
                const aclError err = aclrtSynchronizeStream(stream);
                if (err != ACL_SUCCESS) {
                    printf("[M24][FAIL] %s chunk %u launch error %d : %s\n", cs.name, c, static_cast<int>(err),
                           aclGetRecentErrMsg());
                    allOk = false;
                    break;
                }
            } else if (c == 0u) {
                m24_attn_prefill_kernel<<<nblk, 0, stream>>>(
                    reinterpret_cast<uint8_t*>(dx.p), reinterpret_cast<uint8_t*>(dw.p),
                    reinterpret_cast<uint8_t*>(dcs.p), reinterpret_cast<uint8_t*>(dpos.p),
                    reinterpret_cast<uint8_t*>(dy0.p), reinterpret_cast<uint8_t*>(dout.p),
                    reinterpret_cast<uint8_t*>(din.p), reinterpret_cast<uint8_t*>(dkv.p),
                    reinterpret_cast<uint8_t*>(dcomp.p), reinterpret_cast<uint8_t*>(dring.p),
                    reinterpret_cast<uint8_t*>(dpack.p), reinterpret_cast<uint8_t*>(dseed.p),
                    reinterpret_cast<uint8_t*>(dpool.p), reinterpret_cast<uint8_t*>(dflag.p), cs.rowStart,
                    cs.seqRows, cs.chunkRows, cs.nChunks, 0u, cs.mut, cs.acMode);
                const aclError err = aclrtSynchronizeStream(stream);
                if (err != ACL_SUCCESS) {
                    if (cs.expectLaunchFail) {
                        // **期望的响亮失败**（段体对 `nChunks > 1` 的 `Trap`；`AttnPrefillPhaseA`
                        // 的第一条语句）。⚠ 本条把 `err` 与 `aclGetRecentErrMsg()` **一起记进日志**：
                        //   · 只有这两个一起记，"这一档确实是那道 Trap"才在归档里可核；
                        //   · PASS 的条件只做**弱校验**（消息非空），**理由不是"没读数"，而是读数的性质**：
                        //     同一 tip 的设备读数里 `aclGetRecentErrMsg()` 只给**通用**码
                        //     `EZ9999: Inner Error!`（host 侧 `err=507015` 也是通用 aicore exception 码）
                        //     ⇒ 单看这两个分不出它与别的 aicore 异常；**定性靠设备错误报告**里的
                        //     `errcode 286 / "The trap instruction reports an error."`（README §4-B）
                        //     ⇒ 故不在代码里写死某个 host 侧码。
                        const char* emsg = aclGetRecentErrMsg();
                        const bool msgOk = (emsg != nullptr) && (emsg[0] != '\0');
                        printf("[M24]   %s 已知缺陷档：launch 非正常结束 err=%d msg=%s\n", cs.name,
                               static_cast<int>(err), msgOk ? emsg : "(空)");
                        printf("[M24]     （= 段体对 nChunks>1 的 Trap 硬拦；上面这对 err/msg 就是这道\n"
                               "[M24]      硬拦在归档里的指纹，下一份设备读数要与它比对）\n");
                        if (!msgOk) {
                            printf("[M24][FAIL] %s：expectLaunchFail 但拿不到最近的错误消息 ⇒ 无法判定是那道 Trap\n",
                                   cs.name);
                            allOk = false;
                        }
                    } else {
                        printf("[M24][FAIL] %s launch error %d : %s\n", cs.name, static_cast<int>(err),
                               aclGetRecentErrMsg());
                        allOk = false;
                    }
                    aborted = true;
                    break;
                }
            }
            // ---- D2H（需要设备字节的档）----
            const bool isLast = (rowsOff + rows >= cs.seqRows);
            const bool needDev = cs.step || isLast;
            if (needDev) {
                bool d2h = true;
                d2h = d2h && (aclrtMemcpy(hin.data(), hin.size(), din.p, din.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hy0.data(), hy0.size(), dy0.p, dy0.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hout.data(), hout.size(), dout.p, dout.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hkv.data(), hkv.size(), dkv.p, dkv.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hcomp.data(), hcomp.size(), dcomp.p, dcomp.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hring.data(), hring.size(), dring.p, dring.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hpack.data(), hpack.size(), dpack.p, dpack.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hpoll.data(), hpoll.size(), dpool.p, dpool.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                d2h = d2h && (aclrtMemcpy(hflag.data(), hflag.size() * 4u, dflag.p, dflag.bytes, ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS);
                if (!d2h) {
                    printf("[M24][FAIL] %s D2H failed\n", cs.name);
                    allOk = false;
                    break;
                }
            }
            // ---- 参考态推进 + 判据 ----
            // **单次发射的档**：launch 里已经跑完全部 chunk ⇒ 设备此刻是**终态**；
            //   中间 chunk 只能"推进参考态"（无设备字节可用：y0 平面只留最后一个 chunk）。
            // **逐 chunk 发射的档**：每个 chunk 单独 launch ⇒ 每轮都有设备字节 ⇒ 每轮都判。
            const uint8_t* devY0 = needDev ? hy0.data() : nullptr;
            ChunkExp E;
            ExpectChunk(F, rc, R, devY0, absStart, rows, E);
            if (!cs.step && !isLast) {
                continue;
            }

            DevPlanes P;
            P.in = hin.data();
            P.kv = hkv.data();
            P.comp = hcomp.data();
            P.ring = hring.data();
            P.pack = hpack.data();
            P.pooled = hpoll.data();
            P.flag = hflag.data();
            P.y0 = hy0.data();
            P.out = hout.data();
            std::vector<uint32_t> fullRows;
            const bool isFirst = (c == 0u);
            if ((isFirst && cs.fullFirst) || (isLast && cs.fullLast)) {
                fullRows.push_back(0u);
                fullRows.push_back(rows - 1u);
                if (rows > PF_M_TILE) {
                    fullRows.push_back(PF_M_TILE - 1u);
                    fullRows.push_back(PF_M_TILE);
                }
            }
            char suf[32];
            snprintf(suf, sizeof(suf), "c%u", c);
            CheckChunk(st, F, rc, R, E, P, fullRows, suf, false, devY0,
                       (!cs.expectRed) || cs.guardMutant);
            if (isLast && cs.step) {
                // 终态判据：把**整条序列**的累积态与设备逐项比。
                // ⚠ **只在"逐 chunk 发射"档做**：单次发射档里中间 chunk 的设备 y0 已经被覆写，
                //   参考只能吃 fp64 GEMM（含上游 ~2 ulp 的格点噪声）⇒ 这条内容判据在那里**不适用**
                //   （结构判据 `Ac.*.nospur` 与末 chunk 的 per-chunk 判据照做）。见 README §3 的划界。
                char fsuf[32];
                snprintf(fsuf, sizeof(fsuf), "final");
                // Ac.mkv.final：每一行 × 2 head（K 槽 T3 + 上游 ulp 余量、V 槽 ≤ slack ulp）
                {
                    uint32_t badK = 0u;
                    uint32_t badV = 0u;
                    std::vector<double> zeroTerms(KV_HEAD_DIM, 0.0);
                    for (uint32_t r = 0u; r < cs.seqRows; ++r) {
                        const uint32_t pos = cs.rowStart + r;
                        const RowRef& rr = rc.Get(F, pos, nullptr, false);
                        for (uint32_t h = 0u; h < KV_HEADS; ++h) {
                            const uint64_t offK = M15KV_KV_BYTE_OFF_CONTIG(pos, h, 0u, 0u);
                            if (!ChkT3Tag("(quiet)", hkv.data() + offK, R.mkv.data() + offK,
                                          rr.kTerms.data() + h * KV_HEAD_DIM, KV_HEAD_DIM, PF_T3_SLACK_ULP,
                                          false)) {
                                ++badK;
                            }
                            const uint64_t offV = M15KV_KV_BYTE_OFF_CONTIG(pos, h, 1u, 0u);
                            if (!ChkT3Tag("(quiet)", hkv.data() + offV, R.mkv.data() + offV, zeroTerms.data(),
                                          KV_HEAD_DIM, PF_T3_SLACK_ULP, false)) {
                                ++badV;
                            }
                        }
                    }
                    st.Note("Ac.mkv.final", (badK == 0u) && (badV == 0u));
                    if ((badK != 0u) || (badV != 0u)) {
                        printf("[M24]   Ac.mkv.final K 槽越界 %u、V 槽越界 %u（%u 行 × 2 head）\n", badK, badV,
                               cs.seqRows);
                    }
                }
                // Ac.comp.final：整条序列的压缩行（≤1 ulp 口径：参考本身是 bf16 值）
                {
                    const uint32_t gMax = (cs.rowStart + cs.seqRows + COMP_TOKENS_PER_STATE - 1u) /
                                          COMP_TOKENS_PER_STATE;
                    uint32_t bad = 0u;
                    for (uint32_t g = 0u; g < gMax; ++g) {
                        const uint64_t off = M15KV_COMP_ROW_OFF_PHYS(g / COMP_ROWS_PER_BLOCK, g);
                        uint32_t oneBad = 0u;
                        for (uint32_t j = 0u; j < RING_KEY_DIM; ++j) {
                            uint16_t gb;
                            uint16_t eb;
                            std::memcpy(&gb, hcomp.data() + off + 2u * j, 2u);
                            std::memcpy(&eb, R.comp.data() + off + 2u * j, 2u);
                            if (gb == eb) {
                                continue;
                            }
                            const double d = std::fabs(Bf2D(gb) - Bf2D(eb));
                            if (d > (PF_EPS_T3 * 4.0 + static_cast<double>(1u + PF_T3_SLACK_ULP) * BfUlp(Bf2D(eb)))) {
                                ++oneBad;
                            }
                        }
                        if (oneBad != 0u) {
                            ++bad;
                        }
                    }
                    st.Note("Ac.comp.final", bad == 0u);
                    if (bad != 0u) {
                        printf("[M24]   Ac.comp.final 压缩行越界 %u/%u\n", bad, gMax);
                    }
                }
                // Ac.ring.final：环终态逐字节（= R.ring）
                st.Note("Ac.ring.final", ChkBytesTag("Ac.ring.final", hring.data(), R.ring.data(),
                                                     RING_LAYER_BYTES, false));
                (void)fsuf;
            }
        }
        // ---- 最终态："期望的槽之外不得有写入"（M98 的 nospurious 手法）----
        // 只判"写没写对地方"：把设备在期望槽上的字节抄进一个全毒值面，再整面比。
        // 内容正确性由上面每 chunk 的 T1/T3 判据承担（这里不重复）。
        if (aborted) {
            printf("[M24]   %s：launch 已中止（= 期望的响亮失败）⇒ 终态判据跳过\n", cs.name);
            // ---- 复审 r2 P2-3(ii)：**Trap 之后 context 是否仍可用**（= "移到末位不再连坐"这句的可执行化）----
            // 同一个进程、同一 stream 里再发一个**最小契约档**（2 行、1 chunk、契约档语义）：
            // 它成功 ⇒ 那道 Trap 没把 stream/context 弄坏（连坐风险只由"同一次启动内的后续档"承担，
            //   而 case 列表已把该档排到末尾）；它失败 ⇒ 如实打出来（会变成一条 finding，不压）。
            m24_attn_prefill_kernel<<<nblk, 0, stream>>>(
                reinterpret_cast<uint8_t*>(dx.p), reinterpret_cast<uint8_t*>(dw.p),
                reinterpret_cast<uint8_t*>(dcs.p), reinterpret_cast<uint8_t*>(dpos.p),
                reinterpret_cast<uint8_t*>(dy0.p), reinterpret_cast<uint8_t*>(dout.p),
                reinterpret_cast<uint8_t*>(din.p), reinterpret_cast<uint8_t*>(dkv.p),
                reinterpret_cast<uint8_t*>(dcomp.p), reinterpret_cast<uint8_t*>(dring.p),
                reinterpret_cast<uint8_t*>(dpack.p), reinterpret_cast<uint8_t*>(dseed.p),
                reinterpret_cast<uint8_t*>(dpool.p), reinterpret_cast<uint8_t*>(dflag.p), 0u, 2u, 2u, 1u, 0u, 0u,
                0u);
            const aclError perr = aclrtSynchronizeStream(stream);
            const char* pmsg = aclGetRecentErrMsg();
            const bool ctxOk = (perr == ACL_SUCCESS);
            printf("[M24]   %s：Trap 之后的可用性探针（2 行 1 chunk 契约档）err=%d msg=%s ⇒ context %s\n", cs.name,
                   static_cast<int>(perr), (pmsg != nullptr) ? pmsg : "(空)", ctxOk ? "仍可用" : "不可用");
            st.Guard("posttrap.context.usable", ctxOk, ctxOk ? "Trap 后同一 stream 仍能跑契约档"
                                                            : "Trap 后同一 stream 发不起契约档（连坐风险成立）");
        } else if (hkv.size() != 0u) {
            const uint32_t rowLo = cs.rowStart;
            const uint32_t rowHi = cs.rowStart + cs.seqRows;
            std::vector<std::pair<size_t, size_t>> kvSeg;
            for (uint32_t r = rowLo; r < rowHi; ++r) {
                for (uint32_t h = 0u; h < KV_HEADS; ++h) {
                    for (uint32_t kv = 0u; kv < 2u; ++kv) {
                        kvSeg.push_back({static_cast<size_t>(M15KV_KV_BYTE_OFF_CONTIG(r, h, kv, 0u)),
                                         KV_HEAD_CONTENT_BYTES});
                    }
                }
            }
            st.Note("Ac.mkv.nospur", ChkNoSpuriousTag("Ac.mkv.nospur", hkv.data(), hkv.size(), M24_POISON, kvSeg, false));
            std::vector<std::pair<size_t, size_t>> compSeg;
            const uint32_t gMax = (rowHi + COMP_TOKENS_PER_STATE - 1u) / COMP_TOKENS_PER_STATE;
            for (uint32_t g = 0u; g < gMax; ++g) {
                compSeg.push_back({static_cast<size_t>(M15KV_COMP_ROW_OFF_PHYS(g / COMP_ROWS_PER_BLOCK, g)),
                                   COMP_ROW_BYTES});
            }
            st.Note("Ac.comp.nospur",
                    ChkNoSpuriousTag("Ac.comp.nospur", hcomp.data(), hcomp.size(), M24_POISON, compSeg, false));
            std::vector<std::pair<size_t, size_t>> ringSeg;
            for (uint32_t s = 0u; s < RING_ROWS_PER_BLOCK; ++s) {
                ringSeg.push_back({static_cast<size_t>(s) * RING_ROW_BYTES, RING_ROW_BYTES});
            }
            st.Note("Ac.ring.nospur",
                    ChkNoSpuriousTag("Ac.ring.nospur", hring.data(), hring.size(), M24_POISON, ringSeg, false));
        }
        printf("[M24]   %s：checks=%u fails=%u guards=%u(guardFails=%u)\n", cs.name, st.checks, st.fails,
               st.guards, st.guardFails);
        if (!st.failTags.empty()) {
            printf("[M24]   失败判据（前若干个）：");
            for (size_t i = 0u; i < st.failTags.size() && i < 6u; ++i) {
                printf(" %s", st.failTags[i].c_str());
            }
            printf("%s\n", (st.failTags.size() > 6u) ? " …" : "");
        }
        if (cs.expectRed) {
            bool red = (st.fails != 0u);
            // ⚠ `guardMutant` 档（= 拿它当 **guard 红方向**的负向对照）额外要求 `guardFails > 0`：
            //   否则"guard 将来被静默改坏"这一档仍会 PASS（它的 `fails` 来自别的判据）⇒ 红方向退化成快照。
            //   （复审 r3 的原话：要求 `guardFails > 0`；本轮把这条硬化进断言，而不只写进归档读数。）
            if (cs.guardMutant) {
                red = red && (st.guardFails != 0u);
            }
            printf("[M24]   %s 变异档：%s（变红判据数=%u，guardFails=%u%s）\n", cs.name,
                   red ? "PASS（判据咬住了）" : "FAIL（判据没咬住）", st.fails, st.guardFails,
                   cs.guardMutant ? "，guardMutant 档额外要求 guardFails>0" : "");
            allOk = allOk && red;
        } else {
            allOk = allOk && (st.fails == 0u) && (st.guardFails == 0u);
        }
    }
    printf("\n[M24] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");
    dx.Free(); dw.Free(); dcs.Free(); dpos.Free(); dy0.Free(); dout.Free(); din.Free(); dkv.Free();
    dcomp.Free(); dring.Free(); dpack.Free(); dseed.Free(); dpool.Free(); dflag.Free();
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
