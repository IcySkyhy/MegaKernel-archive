/**
 * m6_rmsnorm.asc —— Mega kernel M6：Add + RMSNorm 融合（层边界，纯 AIV 核）
 * （设计约束见 docs/05-megakernel-design.md；donor：ops-nn/norm/add_rms_norm
 *  op_kernel/arch35/add_rms_norm_regbase.h 的 Compute 数据流：
 *    ① CalculateXAdd     残差加（fp32 寄存器）→ 写回 residual xOut 且 UB 留 xFp32
 *    ② CalculateSquareReduceSum  二分 fold 平方和
 *    ③ ComputeRstdNewtonRaphson  NR rsqrt
 *    ④ CalculateY        y = (x·rstd)·gamma → bf16
 *  共享积木 norm/norm_common/op_kernel/reduce_common_regbase{,_part1,_part2}.h。
 *  donor 被禁点仅 wrapper 的 TPipe/TQue（EnQue/DeQue → BufferID）；arch35 文件
 *  零 SetFlag、LocalMemBar 白名单内——本工程同样遵守。）
 *
 * 功能：单 AIV 核融合计算（hidden = 2560，bf16）：
 *    xAdd      = f32(x) + f32(residual)                （fp32 寄存器相加）
 *    resOut    = xAdd                                  （fp32 写回 GM：残差出口）
 *    rstd      = 1 / sqrt(mean(xAdd²) + eps)           （fp32，mean = sum/2560）
 *    y         = bf16((xAdd·rstd)·gamma)               （bf16 写回 GM）
 *  m 为运行时参数（1..256），逐行循环；列方向 2560 = 40×64 恰为向量整数倍，
 *  无尾块 mask（mask 语义由 lifted donor 函数内的 UpdateMask/VL1 保留）。
 *
 * 数据通路（全部基础 API，无高阶 API / TPipe / TBuf / TQue / AllocTensor）：
 *   GM --DataCopy(MTE2)--> UB(x,res) --Reg::LoadAlign/Cast/Add(VEC)--> 寄存器
 *      --Reg::StoreAlign--> UB(xFp32) --DataCopy(MTE3)--> GM(resOut, fp32)
 *   UB(xFp32) --Reg 二分 fold Reduce--> UB(sumSq) --NR--> UB(rstd)
 *   UB(xFp32,rstd,gammaF32) --Reg Mul/Mul/Cast--> UB(y) --DataCopy(MTE3)--> GM
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal，= get_buf/rls_buf），
 *   不用 set_flag/wait_flag，不挂 PIPE_S。生产者 release 用阻塞释放
 *   （mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至 UB 写落地，保证对跨 pipe 读可见：
 *     BUF_X   (id 0) : MTE2 生产 x/res 行 -> V 消费
 *     BUF_OUT (id 1) : V 生产 xFp32(resOut)/y -> MTE3 消费
 *     BUF_G   (id 2) : MTE2 生产 gamma -> V 消费（kernel 开头一次）
 *
 * 3510 连续 Cast bug 规避（docs/05 §6，M10 实证）：任何两个 Cast 指令之间
 *   都隔着 LoadAlign/StoreAlign——x/res 各自 bf16→fp32 的两次 Cast 中间隔一次
 *   LoadAlign（与 donor LoadRegForDtype 排布一致）；gamma 预转 fp32 每 chunk
 *   只做一次 Cast；y 的 fp32→bf16 Cast 每 chunk 一次、与下一 chunk 的 Cast 之间
 *   隔 StoreAlign+LoadAlign+Mul+Mul。
 *
 * UB 布局全部 32B 对齐（M9 quirk：UB 偏移非 32B 对齐时 UB→GM DataCopy 直接
 *   vector core exception）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cmath>

// ============================================================
// 编译期常量与静态资源表（UB 偏移 / BufferID 全部编译期静态分配）
// ============================================================

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t HIDDEN = 2560;       // hidden size（bf16），模型形状
constexpr uint32_t VL_F32 = 64;         // 256B 向量寄存器 fp32 lane 数（donor VL_FP32）
constexpr uint16_t CHUNKS = HIDDEN / VL_F32;  // 每行 64-lane chunk 数 = 40（无尾块）
constexpr float EPS = 1e-6f;            // RMSNorm epsilon
constexpr float AVG_FACTOR = 1.0f / static_cast<float>(HIDDEN);
constexpr uint32_t FOLD_POINT = 1280;   // 二分 fold 点（donor tiling binAddQuotient）
constexpr uint32_t REDUCE_TMP_STRIDE = 24;  // ceil(foldLoops(20)/BLK_B32(8))*8

// ---- UB 静态布局（字节偏移；VECCALC 空间 248KB 内；偏移 32B 对齐，供 DataCopy）----
constexpr uint32_t UB_X1 = 0;                      // bf16 [2560] = 5120B（x 行）
constexpr uint32_t UB_X2 = UB_X1 + 2 * HIDDEN;     // bf16 [2560] = 5120B（residual 行）
constexpr uint32_t UB_XF = UB_X2 + 2 * HIDDEN;     // fp32 [2560] = 10240B（x+res fp32）
constexpr uint32_t UB_Y = UB_XF + 4 * HIDDEN;      // bf16 [2560] = 5120B（y 行）
constexpr uint32_t UB_GB = UB_Y + 2 * HIDDEN;      // bf16 [2560] = 5120B（gamma 原始）
constexpr uint32_t UB_GF = UB_GB + 2 * HIDDEN;     // fp32 [2560] = 10240B（gamma 预转 fp32）
constexpr uint32_t UB_TMP = UB_GF + 4 * HIDDEN;    // fp32 [64] = 256B（reduce 二分 partials）
constexpr uint32_t UB_RED = UB_TMP + 256;          // fp32 [64] = 256B（每行 sumSq）
constexpr uint32_t UB_RSTD = UB_RED + 256;         // fp32 [64] = 256B（每行 rstd）
static_assert(UB_RSTD + 256 <= 248 * 1024, "UB footprint exceeds 248KB");

// ---- BufferID（每核用户可用 0-27，静态分配）----
constexpr AscendC::MutexID BUF_X = 0;    // x/res 行: MTE2 -> V
constexpr AscendC::MutexID BUF_OUT = 1;  // xFp32(resOut)/y: V -> MTE3
constexpr AscendC::MutexID BUF_G = 2;    // gamma: MTE2 -> V（kernel 开头一次）

// BufferID 语义封装：acquire 立即获取；release 用阻塞模式（mode=false = CANN 默认
// ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射访存落地，对跨 pipe 消费者可见。
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// ============================================================
// Donor 计算核心 lift（ops-nn norm/norm_common/op_kernel/reduce_common_regbase*.h，
// arch35 add_rms_norm_regbase.h 的 RegBase 函数；裸指针 __ubuf__，无 TPipe/TQue）
// 适配 CANN 9.1.0 Reg API：ReduceSum→Reduce<ReduceType::SUM>、reg-UB DataCopy→
// LoadAlign/StoreAlign、Mula→Mul+Add、CompareScalar→Compares。
// ============================================================

namespace NormDonor {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t V_LENGTH = VL_F32;  // donor V_LENGTH（256B/4B）
constexpr uint16_t DICHOTOMY_ADD_COEFF = 2;

constexpr AscendC::Reg::CastTrait castTraitB162B32 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::UNKNOWN,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::UNKNOWN};
constexpr AscendC::Reg::CastTrait castTraitB322B16 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::NO_SAT,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::CAST_RINT};

template <typename T, LoadDist FLOAT_LOAD_DIST = LoadDist::DIST_NORM,
          LoadDist NON_FLOAT_LOAD_DIST = LoadDist::DIST_UNPACK_B16>
__aicore__ inline void LoadRegForDtype(__ubuf__ T* src, RegTensor<float>& dst, MaskReg& preg, uint32_t offset)
{
    if constexpr (IsSameType<T, float>::value) {
        LoadAlign<T, FLOAT_LOAD_DIST>(dst, src + offset);
    } else {
        RegTensor<T> srcReg;
        LoadAlign<T, NON_FLOAT_LOAD_DIST>(srcReg, src + offset);
        Cast<float, T, castTraitB162B32>(dst, srcReg, preg);
    }
}

template <typename T, StoreDist FLOAT_STORE_DIST = StoreDist::DIST_NORM,
          StoreDist NON_FLOAT_STORE_DIST = StoreDist::DIST_PACK_B32>
__aicore__ inline void StoreRegForDtype(__ubuf__ T* dst, RegTensor<float>& src, MaskReg& preg, uint32_t offset)
{
    if constexpr (IsSameType<T, float>::value) {
        StoreAlign<T, FLOAT_STORE_DIST>(dst + offset, src, preg);
    } else {
        RegTensor<T> dstReg;
        Cast<T, float, castTraitB322B16>(dstReg, src, preg);
        StoreAlign<T, NON_FLOAT_STORE_DIST>(dst + offset, dstReg, preg);
    }
}

// ---- 平方和二分 fold（reduce_common_regbase_part2.h，float 输入路径逐字 lift）----

template <typename T>
__aicore__ inline void CalculateSquareReduceSumLessThanVL(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                          uint16_t rows, uint32_t rowStride, uint32_t reduceNum)
{
    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> sumReg;
        MaskReg pregLoop = UpdateMask<float>(reduceNum);
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        for (uint16_t i = 0; i < rows; ++i) {
            LoadRegForDtype<T>(xPtr, xReg, pregLoop, static_cast<uint32_t>(i) * rowStride);
            Mul(xReg, xReg, xReg, pregLoop);
            Reduce<ReduceType::SUM>(sumReg, xReg, pregLoop);
            StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, sumReg, pregOne);
        }
    }
}

template <typename T>
__aicore__ inline void CalculateSquareReduceSumLessThanTwoVL(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                             uint16_t rows, uint32_t rowStride,
                                                             uint32_t reduceNum)
{
    uint32_t tailLen = reduceNum - V_LENGTH;
    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> xFoldReg;
        RegTensor<float> sumReg;
        RegTensor<float> reduceReg;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        MaskReg pregTail = UpdateMask<float>(tailLen);
        for (uint16_t i = 0; i < rows; ++i) {
            uint32_t baseOffset = static_cast<uint32_t>(i) * rowStride;
            LoadRegForDtype<T>(xPtr, xReg, pregFull, baseOffset);
            LoadRegForDtype<T>(xPtr + V_LENGTH, xFoldReg, pregTail, baseOffset);
            Mul(xReg, xReg, xReg, pregFull);
            Mul(xFoldReg, xFoldReg, xFoldReg, pregTail);
            ShiftLefts((RegTensor<uint32_t>&)xFoldReg, (RegTensor<uint32_t>&)xFoldReg, static_cast<int16_t>(0),
                       pregTail);
            Add(sumReg, xReg, xFoldReg, pregFull);
            Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
            StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
        }
    }
}

template <typename T, int32_t LAST_LOOP_NUMS>
__aicore__ inline void CalculateSquareReduceSumCommon(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                      __ubuf__ float* tmpPtr, uint16_t rows, uint32_t rowStride,
                                                      uint32_t reduceNum, uint32_t foldPoint, uint32_t tmpStride)
{
    uint16_t foldLoops = static_cast<uint16_t>((foldPoint + V_LENGTH - 1) / V_LENGTH);
    uint32_t lastNum = foldPoint / V_LENGTH;
    uint32_t tail = (reduceNum > foldPoint) ? reduceNum - foldPoint : 0;
    uint16_t tailCeilLoops = static_cast<uint16_t>((tail + V_LENGTH - 1) / V_LENGTH);
    uint16_t firstFlodWithOutAddLoops = static_cast<uint16_t>(foldLoops - tailCeilLoops);

    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> xFoldReg;
        RegTensor<float> sumReg;
        RegTensor<float> reduceReg;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        MaskReg pregLoop;

        for (uint16_t i = 0; i < rows; ++i) {
            uint32_t baseOffset = static_cast<uint32_t>(i) * rowStride;
            uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
            uint32_t sregTail = tail;
            for (uint16_t j = 0; j < tailCeilLoops; ++j) {
                pregLoop = UpdateMask<float>(sregTail);
                uint32_t offset = static_cast<uint32_t>(j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                LoadRegForDtype<T>(xPtr + foldPoint, xFoldReg, pregFull, offset);
                Mul(xFoldReg, xFoldReg, xFoldReg, pregLoop);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + j, reduceReg, pregOne);
            }
            for (uint16_t j = 0; j < firstFlodWithOutAddLoops; ++j) {
                uint32_t offset = static_cast<uint32_t>(tailCeilLoops + j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + tailCeilLoops + j,
                                                                     reduceReg, pregOne);
            }
        }
        LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        if constexpr (LAST_LOOP_NUMS == 1) {
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                LoadAlign<float>(xReg, tmpPtr + static_cast<uint32_t>(i) * tmpStride);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregLast);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        } else if constexpr (LAST_LOOP_NUMS == DICHOTOMY_ADD_COEFF) {
            lastNum -= V_LENGTH;
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
                LoadAlign<float>(xReg, tmpPtr + tmpOffset);
                LoadAlign<float>(xFoldReg, tmpPtr + tmpOffset + V_LENGTH);
                ShiftLefts((RegTensor<uint32_t>&)xFoldReg, (RegTensor<uint32_t>&)xFoldReg, static_cast<int16_t>(0),
                           pregLast);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        }
    }
}

template <typename T>
// Squares input values inside this function, then reduces each row.
__aicore__ inline void CalculateSquareReduceSum(__ubuf__ T* xPtr, __ubuf__ float* dstPtr, __ubuf__ float* tmpPtr,
                                                uint16_t rows, uint32_t rowStride, uint32_t reduceNum,
                                                uint32_t foldPoint, uint32_t tmpStride, uint32_t branchNum = 0)
{
    uint32_t reduceBranchNum = branchNum == 0 ? reduceNum : branchNum;
    if (reduceBranchNum <= V_LENGTH) {
        CalculateSquareReduceSumLessThanVL<T>(xPtr, dstPtr, rows, rowStride, reduceNum);
    } else if (reduceBranchNum <= V_LENGTH + V_LENGTH) {
        CalculateSquareReduceSumLessThanTwoVL<T>(xPtr, dstPtr, rows, rowStride, reduceNum);
    } else if (reduceBranchNum <= V_LENGTH * V_LENGTH * DICHOTOMY_ADD_COEFF) {
        CalculateSquareReduceSumCommon<T, 1>(xPtr, dstPtr, tmpPtr, rows, rowStride, reduceNum, foldPoint, tmpStride);
    } else {
        CalculateSquareReduceSumCommon<T, DICHOTOMY_ADD_COEFF>(xPtr, dstPtr, tmpPtr, rows, rowStride, reduceNum,
                                                               foldPoint, tmpStride);
    }
}

// ---- NR rsqrt（reduce_common_regbase_part1.h，逐字 lift，Mula→Mul+Add）----

template <bool NEED_MAX = true>
__aicore__ inline void ComputeRstdNewtonRaphsonReg(RegTensor<float>& var, RegTensor<float>& rstd, MaskReg& preg,
                                                   float epsilon)
{
    static constexpr float POS_INF = 3.40282366920938E+38;
    static constexpr float SCALAR1 = -0.5;
    static constexpr float SCALAR2 = 1.5;
    static constexpr float SCALAR3 = 0.5;
    static constexpr float SCALAR0 = -99.99;

    RegTensor<float> r;
    RegTensor<float> y;
    RegTensor<float> s;
    RegTensor<float> t;
    RegTensor<float> one;
    RegTensor<float> scalar1;
    RegTensor<float> t1;
    RegTensor<float> t3;
    RegTensor<float> t4;
    RegTensor<float> scalarInf;
    RegTensor<float> scalarZero;
    RegTensor<float> tmp;
    MaskReg cmpRegZero;
    MaskReg cmpRegInf;

    Duplicate(scalarInf, POS_INF, preg);
    Duplicate(scalarZero, float(0.0), preg);
    Duplicate(one, float(1.0), preg);
    Duplicate(scalar1, SCALAR3, preg);
    Duplicate(t1, SCALAR2, preg);
    Duplicate(s, float(1.0), preg);

    Adds(var, var, epsilon, preg);
    if constexpr (NEED_MAX) {
        Maxs(var, var, SCALAR0, preg);
    }
    Div(r, one, var, preg);
    Sqrt(y, r, preg);
    Muls(t, var, SCALAR1, preg);
    Mul(t, t, y, preg);
    Mul(tmp, t, y, preg);
    Add(t1, t1, tmp, preg);   // t1 = 1.5 + t*y（donor Mula）
    Mul(rstd, y, t1, preg);
    Muls(t3, var, float(-1.0), preg);
    Mul(tmp, t3, r, preg);
    Add(s, s, tmp, preg);     // s = 1 + (-var)*r（donor Mula）
    Muls(t4, rstd, float(-1.0), preg);
    Mul(tmp, t4, rstd, preg);
    Add(r, r, tmp, preg);     // r = r + (-rstd)*rstd（donor Mula）
    Mul(tmp, var, r, preg);
    Add(s, s, tmp, preg);     // s = s + var*r（donor Mula）
    Mul(s, s, rstd, preg);
    Mul(tmp, s, scalar1, preg);
    Add(rstd, rstd, tmp, preg);  // rstd = rstd + s*0.5（donor Mula）
    Compares(cmpRegZero, var, POS_INF, preg);
    Select(rstd, scalarZero, rstd, cmpRegZero);
    Compares(cmpRegInf, var, float(0.0), preg);
    Select(rstd, scalarInf, rstd, cmpRegInf);
}

template <bool NEED_MAX = true, bool NEED_AVG_FACTOR = false>
__aicore__ inline void ComputeRstdNewtonRaphson(__ubuf__ float* src, __ubuf__ float* dst, uint32_t rowCount,
                                                float epsilon, float avgFactor, uint32_t vectorLen)
{
    uint16_t loopRows = static_cast<uint16_t>((rowCount + vectorLen - 1) / vectorLen);
    __VEC_SCOPE__
    {
        RegTensor<float> var;
        RegTensor<float> rstd;
        MaskReg pregLoop;

        uint32_t sreg = rowCount;
        for (uint16_t i = 0; i < loopRows; ++i) {
            pregLoop = UpdateMask<float>(sreg);
            LoadAlign<float>(var, src + i * vectorLen);
            if constexpr (NEED_AVG_FACTOR) {
                Muls(var, var, avgFactor, pregLoop);
            }
            ComputeRstdNewtonRaphsonReg<NEED_MAX>(var, rstd, pregLoop, epsilon);
            StoreAlign<float>(dst + i * vectorLen, rstd, pregLoop);
        }
    }
}

} // namespace NormDonor

// ============================================================
// Kernel 实现
// ============================================================

class AddRmsNormKernel {
public:
    __aicore__ inline AddRmsNormKernel() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR y, GM_ADDR resOut, uint32_t m)
    {
        M = m;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M) * HIDDEN);
        resGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(residual), static_cast<uint64_t>(M) * HIDDEN);
        gammaGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(gamma), HIDDEN);
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(y), static_cast<uint64_t>(M) * HIDDEN);
        resOutGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(resOut), static_cast<uint64_t>(M) * HIDDEN);
    }

    __aicore__ inline void Process()
    {
        PrecomputeGammaF32();
        // m 运行时 1..256：逐行循环（行间无依赖；单行内 XAdd→SquareReduce→NR→Y 串行）
        for (uint32_t row = 0; row < M; ++row) {
            CopyInRow(row);
            ComputeRow();
            CopyOutRow(row);
        }
    }

private:
    // gamma bf16 → fp32 预转换（整个 kernel 只做一次；之后每行少 40 次 Cast，
    // 同时让 y 循环里每 chunk 只剩一次 fp32→bf16 Cast，彻底规避连续 Cast 风险）
    __aicore__ inline void PrecomputeGammaF32()
    {
        LocalTensor<bfloat16_t> gbL(TPosition::VECCALC, UB_GB, HIDDEN);
        LocalTensor<float> gfL(TPosition::VECCALC, UB_GF, HIDDEN);
        __ubuf__ bfloat16_t* gbUb = reinterpret_cast<__ubuf__ bfloat16_t*>(gbL.GetPhyAddr());
        __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(gfL.GetPhyAddr());

        BufAcquire<PIPE_MTE2>(BUF_G);
        DataCopy(gbL, gammaGm, HIDDEN);
        BufRelease<PIPE_MTE2>(BUF_G);

        BufAcquire<PIPE_V>(BUF_G);
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> gB16;
            RegTensor<float> gF;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < CHUNKS; ++i) {
                uint32_t offset = i * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(gB16, gbUb + offset);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(gF, gB16, maskAll);
                StoreAlign<float, StoreDist::DIST_NORM_B32>(gfUb + offset, gF, maskAll);
            }
        }
        BufRelease<PIPE_V>(BUF_G);
    }

    __aicore__ inline void CopyInRow(uint32_t row)
    {
        LocalTensor<bfloat16_t> x1L(TPosition::VECCALC, UB_X1, HIDDEN);
        LocalTensor<bfloat16_t> x2L(TPosition::VECCALC, UB_X2, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        BufAcquire<PIPE_MTE2>(BUF_X);   // 挡上一行的 V 消费
        DataCopy(x1L, xGm[off], HIDDEN);
        DataCopy(x2L, resGm[off], HIDDEN);
        BufRelease<PIPE_MTE2>(BUF_X);
    }

    // donor ①：残差加（fp32 寄存器）→ UB 留 xFp32（残差出口 fp32 直接由它 MTE3 写出）
    __aicore__ inline void CalculateXAdd(__ubuf__ bfloat16_t* x1Ub, __ubuf__ bfloat16_t* x2Ub, __ubuf__ float* xfUb)
    {
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> x1B16;
            RegTensor<bfloat16_t> x2B16;
            RegTensor<float> x1;
            RegTensor<float> x2;
            RegTensor<float> xSum;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < CHUNKS; ++i) {
                uint32_t offset = i * VL_F32;
                // 两个 bf16→fp32 Cast 之间隔一次 LoadAlign（donor LoadRegForDtype 排布，
                // 规避 3510 连续 Cast 共用保留 UB 的错乱 bug）
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(x1B16, x1Ub + offset);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(x1, x1B16, maskAll);
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(x2B16, x2Ub + offset);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(x2, x2B16, maskAll);
                Add(xSum, x1, x2, maskAll);
                StoreAlign<float, StoreDist::DIST_NORM_B32>(xfUb + offset, xSum, maskAll);
            }
        }
    }

    // donor ④：y = (x·rstd)·gamma → bf16（gamma 已预转 fp32，每 chunk 仅一次 fp32→bf16 Cast）
    __aicore__ inline void CalculateY(__ubuf__ float* xfUb, __ubuf__ float* gfUb, __ubuf__ bfloat16_t* yUb,
                                      __ubuf__ float* rstdUb)
    {
        __VEC_SCOPE__
        {
            RegTensor<float> xReg;
            RegTensor<float> gReg;
            RegTensor<float> rstdReg;
            RegTensor<float> tReg;
            RegTensor<float> yReg;
            RegTensor<bfloat16_t> yB16;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            LoadAlign<float, LoadDist::DIST_BRC_B32>(rstdReg, rstdUb);
            for (uint16_t i = 0; i < CHUNKS; ++i) {
                uint32_t offset = i * VL_F32;
                LoadAlign<float>(xReg, xfUb + offset);
                LoadAlign<float>(gReg, gfUb + offset);
                Mul(tReg, xReg, rstdReg, maskAll);
                Mul(yReg, tReg, gReg, maskAll);
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yB16, yReg, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(yUb + offset, yB16, maskAll);
            }
        }
    }

    __aicore__ inline void ComputeRow()
    {
        LocalTensor<bfloat16_t> x1L(TPosition::VECCALC, UB_X1, HIDDEN);
        LocalTensor<bfloat16_t> x2L(TPosition::VECCALC, UB_X2, HIDDEN);
        LocalTensor<float> xfL(TPosition::VECCALC, UB_XF, HIDDEN);
        LocalTensor<float> gfL(TPosition::VECCALC, UB_GF, HIDDEN);
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_Y, HIDDEN);
        LocalTensor<float> tmpL(TPosition::VECCALC, UB_TMP, 64);
        LocalTensor<float> redL(TPosition::VECCALC, UB_RED, 64);
        LocalTensor<float> rstdL(TPosition::VECCALC, UB_RSTD, 64);
        __ubuf__ bfloat16_t* x1Ub = reinterpret_cast<__ubuf__ bfloat16_t*>(x1L.GetPhyAddr());
        __ubuf__ bfloat16_t* x2Ub = reinterpret_cast<__ubuf__ bfloat16_t*>(x2L.GetPhyAddr());
        __ubuf__ float* xfUb = reinterpret_cast<__ubuf__ float*>(xfL.GetPhyAddr());
        __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(gfL.GetPhyAddr());
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(yL.GetPhyAddr());
        __ubuf__ float* tmpUb = reinterpret_cast<__ubuf__ float*>(tmpL.GetPhyAddr());
        __ubuf__ float* redUb = reinterpret_cast<__ubuf__ float*>(redL.GetPhyAddr());
        __ubuf__ float* rstdUb = reinterpret_cast<__ubuf__ float*>(rstdL.GetPhyAddr());

        BufAcquire<PIPE_V>(BUF_X);    // 等 x/res 行就位
        BufAcquire<PIPE_V>(BUF_OUT);  // 等上一行 MTE3 读完 xFp32/y 缓冲
        CalculateXAdd(x1Ub, x2Ub, xfUb);
        // donor ②：二分 fold 平方和（2560 = 2×1280 → Common<1>：20 组 partial 再归并）
        NormDonor::CalculateSquareReduceSum<float>(xfUb, redUb, tmpUb, 1, HIDDEN, HIDDEN, FOLD_POINT,
                                                   REDUCE_TMP_STRIDE);
        // donor ③：NR rsqrt（rstd = 1/sqrt(sumSq/2560 + eps)）
        NormDonor::ComputeRstdNewtonRaphson<true, true>(redUb, rstdUb, 1, EPS, AVG_FACTOR, VL_F32);
        CalculateY(xfUb, gfUb, yUb, rstdUb);
        BufRelease<PIPE_V>(BUF_X);    // x/res 消费完，MTE2 可复用
        BufRelease<PIPE_V>(BUF_OUT);  // xFp32/y 写完且 drain，MTE3 可读
    }

    __aicore__ inline void CopyOutRow(uint32_t row)
    {
        LocalTensor<float> xfL(TPosition::VECCALC, UB_XF, HIDDEN);
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_Y, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(resOutGm[off], xfL, HIDDEN);  // 残差出口 fp32（10240B）
        DataCopy(yGm[off], yL, HIDDEN);        // y bf16（5120B）
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    uint32_t M;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<bfloat16_t> resGm;
    GlobalTensor<bfloat16_t> gammaGm;
    GlobalTensor<bfloat16_t> yGm;
    GlobalTensor<float> resOutGm;
};

} // namespace

__vector__ __global__ void add_rmsnorm_residual_kernel(GM_ADDR x, GM_ADDR residual, GM_ADDR gamma, GM_ADDR y,
                                                       GM_ADDR resOut, uint32_t m)
{
    AddRmsNormKernel op;
    op.Init(x, residual, gamma, y, resOut, m);
    op.Process();
}

// ============================================================
// Host 侧：确定性输入生成 + numpy 语义 fp32 参考（内建 C 版）+ 读回校验
// ============================================================

// ---- bf16 编解码（RNE；host 全位操作，与 tools/golden/moe_block_ref.py 一致）----
static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// ---- 确定性输入生成 ----
// 每 (row, col) 元素：符号/尾数随机，指数域 e ∈ [77,177]（值域 2^-50..2^50，
// 平方后 2^-100..2^100，×2560 累加不溢出/不过小）；若干特殊行/列覆盖角落：
//   row%7==3 ：x = -residual（精确抵消 → xAdd 全 0，走 rstd=1/sqrt(eps) 路径）
//   row%7==5 ：全行同一值（均匀平方和）
// gamma：指数域 e ∈ [120,134]（≈0.5..4）随机尾数，部分取负；gamma[0]=1.0、
//   gamma[1]=-1.0、gamma[2]=2.0 精确幂（覆盖乘法精确路径）
static void GenTensors(uint16_t* x, uint16_t* res, uint16_t* gamma, uint32_t m, uint32_t seed)
{
    for (uint32_t j = 0; j < HIDDEN; ++j) {
        const uint32_t h = Hash3(0, j, seed + 77);
        if (j == 0) {
            gamma[j] = 0x3F80;  // 1.0
        } else if (j == 1) {
            gamma[j] = 0xBF80;  // -1.0
        } else if (j == 2) {
            gamma[j] = 0x4000;  // 2.0
        } else if (j % 16 == 0) {
            gamma[j] = static_cast<uint16_t>(0x3F80 | ((h >> 8) & 0x7F));  // [1,2) 精确幂+尾数
        } else {
            const uint32_t e = 120 + h % 15;
            gamma[j] = static_cast<uint16_t>((((h >> 8) & 1) << 15) | (e << 7) | ((h >> 9) & 0x7F));
        }
    }
    for (uint32_t i = 0; i < m; ++i) {
        const bool cancelRow = (i % 7 == 3);
        const bool constRow = (i % 7 == 5);
        const uint32_t hC = Hash3(i, 0, seed + 5);
        const uint16_t constVal = static_cast<uint16_t>((((hC >> 8) & 1) << 15) | (((100 + hC % 25) << 7)));
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const uint32_t h = Hash3(i, j, seed);
            const uint32_t e = 77 + h % 101;  // 2^-50 .. 2^50
            const uint16_t v = static_cast<uint16_t>((((h >> 8) & 1) << 15) | (e << 7) | ((h >> 9) & 0x7F));
            const uint16_t w = static_cast<uint16_t>(((((h >> 11) & 1)) << 15) | (e << 7) | ((h >> 12) & 0x7F));
            if (cancelRow) {
                x[i * HIDDEN + j] = v;
                res[i * HIDDEN + j] = static_cast<uint16_t>(v ^ 0x8000);  // 精确相反数
            } else if (constRow) {
                x[i * HIDDEN + j] = constVal;
                res[i * HIDDEN + j] = constVal;
            } else {
                x[i * HIDDEN + j] = v;
                res[i * HIDDEN + j] = w;
            }
        }
    }
}

// ---- numpy 语义参考的 C 移植（fp32 累加；与 check_ref.py 逐公式对应）----
static void RefAddRmsNorm(const uint16_t* x, const uint16_t* res, const uint16_t* gamma, uint16_t* y, float* resOut,
                          uint32_t m)
{
    for (uint32_t i = 0; i < m; ++i) {
        float sq = 0.0f;
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const float a = Bf16ToF32(x[i * HIDDEN + j]) + Bf16ToF32(res[i * HIDDEN + j]);
            resOut[i * HIDDEN + j] = a;
            sq += a * a;  // fp32 累加
        }
        const float mean = sq / static_cast<float>(HIDDEN);
        const float rstd = 1.0f / sqrtf(mean + 1e-6f);
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const float t = resOut[i * HIDDEN + j] * rstd * Bf16ToF32(gamma[j]);  // (x·rstd)·gamma
            y[i * HIDDEN + j] = F32ToBf16(t);
        }
    }
}

// ---- 可选：dump 模式（与 check_ref.py numpy 参考交叉验证用）----
static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// y 比较：容差 bf16 网格 1e-2 相对（ref 为 0 时要求 got 也为 0）；逐行一致。
// resOut：fp32 残差加，与参考同一 IEEE 运算，要求逐位一致。
static bool RunCase(aclrtStream stream, uint32_t m, uint32_t seed)
{
    const size_t b16Bytes = static_cast<size_t>(m) * HIDDEN * 2;
    const size_t f32Bytes = static_cast<size_t>(m) * HIDDEN * 4;

    uint16_t *xHost = nullptr, *resHost = nullptr, *gammaHost = nullptr, *yHost = nullptr;
    float* resOutHost = nullptr;
    uint16_t *xDev = nullptr, *resDev = nullptr, *gammaDev = nullptr, *yDev = nullptr;
    float* resOutDev = nullptr;
    aclrtMallocHost(reinterpret_cast<void**>(&xHost), b16Bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&resHost), b16Bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&gammaHost), HIDDEN * 2);
    aclrtMallocHost(reinterpret_cast<void**>(&yHost), b16Bytes);
    aclrtMallocHost(reinterpret_cast<void**>(&resOutHost), f32Bytes);
    aclrtMalloc(reinterpret_cast<void**>(&xDev), b16Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&resDev), b16Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&gammaDev), HIDDEN * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&yDev), b16Bytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&resOutDev), f32Bytes, ACL_MEM_MALLOC_HUGE_FIRST);

    GenTensors(xHost, resHost, gammaHost, m, seed);
    aclrtMemcpy(xDev, b16Bytes, xHost, b16Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(resDev, b16Bytes, resHost, b16Bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(gammaDev, HIDDEN * 2, gammaHost, HIDDEN * 2, ACL_MEMCPY_HOST_TO_DEVICE);

    add_rmsnorm_residual_kernel<<<1, 0, stream>>>(
        reinterpret_cast<uint8_t*>(xDev), reinterpret_cast<uint8_t*>(resDev),
        reinterpret_cast<uint8_t*>(gammaDev), reinterpret_cast<uint8_t*>(yDev),
        reinterpret_cast<uint8_t*>(resOutDev), m);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M6][FAIL] m=%u seed=%u kernel launch/sync error %d\n", m, seed, (int)launchErr);
        return false;
    }
    aclrtMemcpy(yHost, b16Bytes, yDev, b16Bytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(resOutHost, f32Bytes, resOutDev, f32Bytes, ACL_MEMCPY_DEVICE_TO_HOST);

    // 调试：M6_DUMP=1 时保存 device 输出（与 check_ref.py numpy 参考交叉验证）
    if (getenv("M6_DUMP") != nullptr) {
        char name[80];
        snprintf(name, sizeof(name), "m%u_s%u_x.bin", m, seed);       WriteBin(name, xHost, b16Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_res.bin", m, seed);     WriteBin(name, resHost, b16Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_gamma.bin", m, seed);   WriteBin(name, gammaHost, HIDDEN * 2);
        snprintf(name, sizeof(name), "m%u_s%u_y_device.bin", m, seed);     WriteBin(name, yHost, b16Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_resout_device.bin", m, seed); WriteBin(name, resOutHost, f32Bytes);
    }

    uint16_t* refY = new uint16_t[static_cast<size_t>(m) * HIDDEN];
    float* refResOut = new float[static_cast<size_t>(m) * HIDDEN];
    RefAddRmsNorm(xHost, resHost, gammaHost, refY, refResOut, m);

    // ---- resOut 逐位一致 ----
    uint32_t resOutMismatch = 0;
    for (size_t i = 0; i < static_cast<size_t>(m) * HIDDEN && resOutMismatch < 5; ++i) {
        uint32_t got, exp;
        __builtin_memcpy(&got, &resOutHost[i], 4);
        __builtin_memcpy(&exp, &refResOut[i], 4);
        if (got != exp) {
            printf("[M6][FAIL] m=%u seed=%u resOut[%zu] got %.9g expect %.9g\n", m, seed, i, resOutHost[i],
                   refResOut[i]);
            ++resOutMismatch;
        }
    }
    // ---- y 逐行一致（bf16 网格 1e-2 相对）----
    double worstRowRel = 0.0;
    uint32_t worstRow = 0;
    uint32_t yFail = 0;
    for (uint32_t i = 0; i < m; ++i) {
        double rowWorst = 0.0;
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const size_t idx = static_cast<size_t>(i) * HIDDEN + j;
            const float got = Bf16ToF32(yHost[idx]);
            const float exp = Bf16ToF32(refY[idx]);
            double rel;
            if (exp == 0.0f) {
                rel = (got == 0.0f) ? 0.0 : 1.0;
            } else {
                rel = static_cast<double>(fabsf(got - exp)) / static_cast<double>(fabsf(exp));
            }
            if (rel > rowWorst) rowWorst = rel;
            if (rel > 1e-2 && yFail < 5) {
                printf("[M6][FAIL] m=%u seed=%u y[%u][%u] got %.6g expect %.6g rel %.3g\n", m, seed, i, j, got, exp,
                       rel);
                ++yFail;
            }
        }
        if (rowWorst > worstRowRel) {
            worstRowRel = rowWorst;
            worstRow = i;
        }
    }
    const bool pass = (resOutMismatch == 0) && (yFail == 0);
    printf("[M6] m=%-3u seed=%u : %s (y worst row rel %.3g @row %u, resOut bit-exact mismatches %u)\n", m, seed,
           pass ? "PASS" : "FAIL", worstRowRel, worstRow, resOutMismatch);

    delete[] refY;
    delete[] refResOut;
    aclrtFree(xDev); aclrtFreeHost(xHost);
    aclrtFree(resDev); aclrtFreeHost(resHost);
    aclrtFree(gammaDev); aclrtFreeHost(gammaHost);
    aclrtFree(yDev); aclrtFreeHost(yHost);
    aclrtFree(resOutDev); aclrtFreeHost(resOutHost);
    return pass;
}

int32_t main(int32_t argc, char* argv[])
{
    // dump 模式：./m6_rmsnorm dump <m> <seed> 写出 x/res/gamma 输入与 C 参考 y/resout
    if (argc >= 4 && argv[1][0] == 'd') {
        const uint32_t m = static_cast<uint32_t>(atoi(argv[2]));
        const uint32_t seed = static_cast<uint32_t>(atoi(argv[3]));
        const size_t b16Bytes = static_cast<size_t>(m) * HIDDEN * 2;
        const size_t f32Bytes = static_cast<size_t>(m) * HIDDEN * 4;
        uint16_t* x = new uint16_t[b16Bytes / 2];
        uint16_t* res = new uint16_t[b16Bytes / 2];
        uint16_t* gamma = new uint16_t[HIDDEN];
        uint16_t* y = new uint16_t[b16Bytes / 2];
        float* resOut = new float[f32Bytes / 4];
        GenTensors(x, res, gamma, m, seed);
        RefAddRmsNorm(x, res, gamma, y, resOut, m);
        char name[80];
        snprintf(name, sizeof(name), "m%u_s%u_x.bin", m, seed);
        bool ok = WriteBin(name, x, b16Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_res.bin", m, seed);
        ok &= WriteBin(name, res, b16Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_gamma.bin", m, seed);
        ok &= WriteBin(name, gamma, HIDDEN * 2);
        snprintf(name, sizeof(name), "m%u_s%u_y.bin", m, seed);
        ok &= WriteBin(name, y, b16Bytes);
        snprintf(name, sizeof(name), "m%u_s%u_resout.bin", m, seed);
        ok &= WriteBin(name, resOut, f32Bytes);
        printf("[M6] dump m=%u seed=%u -> %s\n", m, seed, ok ? "ok" : "write failed");
        delete[] x; delete[] res; delete[] gamma; delete[] y; delete[] resOut;
        return ok ? 0 : 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    // 覆盖：任务书要求 m=1 与 m=256（多组随机种子）；补充中间 m 验证动态 m 路径
    const uint32_t ms[] = {1, 2, 17, 128, 256};
    const uint32_t seeds[] = {0, 1, 2, 3, 4};

    bool allOk = true;
    for (uint32_t seed : seeds) {
        for (uint32_t m : ms) {
            allOk &= RunCase(stream, m, seed);
        }
    }
    printf("[M6] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
