/**
 * m25_attn_fa_core.asc —— M117 / Wave-B3：稠密 causal prefill attention core 的**独立设备验证路**
 *
 * 本文件只做三件事，不含任何算法：
 *   ① `__global__` 入口壳（薄壳，把分核调度交给段体头 `m15_attn_fa_core.h` 的 `FaCoreBody`）；
 *   ② host 侧的 `main()`（模式分派 + 环境变量），实现在 `m15_layer_loop/m15_attn_fa_core_host.h`；
 *   ③ include 顺序：与 `m15_layer_loop.asc` 的前缀一致（段体头依赖的 `m15_attn_kv.h` 需要
 *      `m15_gdn_layer.h` / `m15_hc_layer.h` / `m15_loop_layout.h` 先到位）。
 *
 * **并入的段体头来自 `m15_layer_loop/m15_attn_fa_core.h`（融合形态的那一份，不复制）** ——
 * CMake 用 `-I ../m15_layer_loop` 引用它，于是「被测对象」与「将来融合用的那一份」不可能漂移。
 *
 * 构建（仓库根目录）：
 *   source /usr/local/Ascend/ascend-toolkit/set_env.sh
 *   cmake -B m25_attn_fa_core/build -S m25_attn_fa_core -DCMAKE_BUILD_TYPE=Release
 *   cmake --build m25_attn_fa_core/build -j4
 * 运行（**设备槽**；dump 写在 cwd 之下）：
 *   flock -w 900 /tmp/npu0.lock ./m25_attn_fa_core/build/m25_attn_fa_core core
 * 对拍：
 *   python3 m25_attn_fa_core/check_ref.py m25_attn_fa_core/out
 * 环境变量：
 *   M25FA_M="4097,1"      只跑指定 m（逗号分隔；默认 4097,1）
 *   M25FA_BLOCKS=<n>      覆盖 blockDim（默认取 ACL_DEV_ATTR_AICORE_CORE_NUM）
 *   M25FA_OUT=<dir>       落盘根目录（默认 m25_attn_fa_core/out）
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cmath>
#include <cstdint>
#include <cstring>
#include <cstdlib>

#include "m15_gdn_layer.h"
#include "m15_hc_layer.h"
#include "m15_attn_layer.h"
#include "m15_loop_layout.h"
#include "m15_attn_kv.h"

#include "m15_attn_fa_core.h"

// ============================================================
// 入口壳：调段体头的 `FaCoreBody`（参数 = 「指针 + 标量」，见融合清单 (b)）
// ============================================================
__global__ __mix__(1, 2) void m25_fa_kernel(__gm__ uint8_t* q, uint32_t qStride, __gm__ uint8_t* kv,
                                            __gm__ uint8_t* out, __gm__ uint8_t* p, __gm__ uint8_t* wit, uint32_t m,
                                            uint32_t posBase, uint32_t ctx, uint32_t lane, uint32_t nBlk)
{
    AscendC::InitSocState();
    M15FAC::FaCoreBody</*Causal=*/true>(q, qStride, kv, out, p, wit, m, posBase, ctx, lane, nBlk);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// 负向对照：关掉三角掩码（把被测对象弄坏 ⇒ 判据必须变红）
__global__ __mix__(1, 2) void m25_fa_negmask_kernel(__gm__ uint8_t* q, uint32_t qStride, __gm__ uint8_t* kv,
                                                    __gm__ uint8_t* out, __gm__ uint8_t* p, __gm__ uint8_t* wit, uint32_t m,
                                                    uint32_t posBase, uint32_t ctx, uint32_t lane, uint32_t nBlk)
{
    AscendC::InitSocState();
    M15FAC::FaCoreBody</*Causal=*/false>(q, qStride, kv, out, p, wit, m, posBase, ctx, lane, nBlk);
    AscendC::PipeBarrier<PIPE_ALL>();
}

#include "m15_attn_fa_core_host.h"

int32_t main(int32_t argc, char** argv)
{
    const char* mode = (argc >= 2) ? argv[1] : "core";
    const char* outDir = (argc >= 3) ? argv[2] : nullptr;
    if (strcmp(mode, "core") != 0 && strcmp(mode, "negmask") != 0 && strcmp(mode, "negshift") != 0 &&
        strcmp(mode, "negstart") != 0) {
        printf("[M25FA][FAIL] 未知 mode '%s'（core / negmask / negshift / negstart）\n", mode);
        return 1;
    }
    return M15FAHost::detail::Main(mode, outDir);
}
