/**
 * m17_moe_layer.asc —— M29：MoE block layer kernel（**真实 checkpoint 权重**端到端）
 * （设计：docs/12-layer-integration.md + docs/05-megakernel-design.md §2/§5/§6）
 *
 * 与 m13_moe_layer.asc 的关系：**同一个段序 S1-S10、同一套权重契约**，但把 m13 的
 * golden 缩形数据集（E=4 / topk≤4 / 合成 x）换成真实 checkpoint：
 *   * 权重来自 /workspace/Qwen3.8-Flash-Next-MXFP4 的 layer 0 MoE block，
 *     512 个专家的 packed u8（e2m1 lohi）+ e8m0 scale 全部**字节原样**装入 device GM；
 *   * E = 512、topk = 10（config.json 真实值），因此 router 段与 top-k 段按 m7 的
 *     流式/归并树实现重写（见 m17_resources.h 文件头「相对 m13 的逐条改动」）；
 *   * 层输入 x 是真实 checkpoint 的 embedding 行，两处 RMSNorm gamma 是真实
 *     hc_norm 权重的行切片 —— 整条链**无任何合成数据**（见 README「真实输入与 gamma」）。
 *
 * 相对 m13 逐字沿用的算件：S1/S10 m6 的 Add+RMSNorm、S4/S9 m8 的 permute/unpermute、
 * S5/S7 m5 的 SwiGLU+MxQuant 全 VEC 路径、S6/S8 m3 的 MXFP4GemmItem。
 *
 * 单一 __mix__(1,2) 启动内跑完整 MoE block 段序 S1-S10：
 *
 *   S1  m6#1   Add+RMSNorm（x_res + res → x_norm bf16, resOut fp32）      [AIV, 行切分]
 *   S2  m7     router：GEMV logits → softmax(max-shift) → top-k 降序 → renorm
 *              （同一 AIV0 段内顺带算共享专家 sigmoid 门 sgate[m]）        [AIV0]
 *   S3  new    routing 索引生成：计数排序 → perm_src/perm_expert/counts/
 *              offsets/inv_slot/w_tk_packed（m7↔m8 之间的缺口 glue）       [AIV0]
 *   S4  m8#1   permute：x_sorted[i] = x[perm_src[i]]（四级流水 gather）    [AIV, 行切分]
 *   S5  m2/m5  A 侧 MXFP4 全 VEC 量化：x_sorted → A_qx + A_scale，
 *              共享专家激活 x → A_qx_shd + A_scale_shd                   [AIV, 行切分]
 *   S6  m3     grouped gate_up GEMM（5 槽位 = 4 routed + 1 shared，K=2560 N=1280）[AIC]
 *   S7  m5     SwiGLU + MXFP4 全 VEC 量化：GU → H_qx + H_scale（共享同款） [AIV, 行切分]
 *   S8  m3     grouped down GEMM（5 槽位，K=640 N=2560）→ Y / Y_shd       [AIC]
 *   S9  m8#2   unpermute 加权折叠 → routed_out；shared*sgate → shared_out；
 *              moe_out = routed + shared                                  [AIV, 行切分]
 *   S10 m6#2   Add+RMSNorm（moe_out + res1(fp32) → y, resOut2 fp32）       [AIV, 行切分]
 *
 * 段边界跨核同步（docs/12 §5 标准 mix 序列）：
 *   AIV→AIC：AIV set mode2(PIPE_MTE3 drain) → AIC wait mode2(PIPE_S) →
 *            AIC set mode0(PIPE_MTE2) + wait mode0(PIPE_S)（全体 AIC 对齐）
 *   AIC→AIV：AIC set mode0(PIPE_FIX drain) + wait mode0(PIPE_S) →
 *            AIC set mode2(PIPE_MTE2) → AIV wait mode2(narrow pipe，需标量值
 *            依赖的段用 PIPE_S)
 *   段内 AIV↔AIV 交接：全体 AIV mode0 barrier（m0 实证 56 AIV 可用）
 *   set 一律挂生产 pipe（FIX/MTE3），wait 窄 pipe；相邻同步点 flagId 走旋转槽。
 *
 * 算件代码来源（均为「复制改造」，不改动原目录）：
 *   S1/S10  m6_rmsnorm（含 NormDonor 二分 fold reduce + NR rsqrt 逐字 lift）
 *   S2      m7_router_topk（GEMV 向量 MAC + Sort32/Extract topk + renorm 位打包）
 *   S4/S9   m8_permute（permute 四级流水 / unpermute 寄存器加权折叠）
 *   S5/S7   m5_swiglu_quant（SwiGLU 五元组 + MxQuant 三段式，全 VEC、无 PIPE_S）
 *   S6/S8   m3_grouped_gemm（MXFP4GemmItem：Nd2Nz/Dn2Nz → LoadData2D(Mx) →
 *           MmadMx → Fixpipe F322BF16），量化器换成 m5 全 VEC 路径（小改 C）
 *
 * 小改清单（docs/12 §6）落实：
 *   A. 元素计数 DataCopy 重载 → 一律显式 DataCopyParams/DataCopyExtParams{1,len,0,0}
 *   B. 行循环 MTE2 背靠背复用同一 UB buffer → 补 PipeBarrier<PIPE_MTE2>
 *   C. m3-AIV 标量量化器（PIPE_S）→ m5 全 VEC 量化路径（S5/S7 无 PIPE_S 挂载）
 *   D. m6 残差输入支持 fp32（S10 消费 S1 的 fp32 resOut）
 *   E. 索引读改 MTE2/标量 UB 批量（本骨架：索引数组仍按 m8 协议的标量 GM 读，
 *      w_tk_packed 协议保留；见 README「已知限制」）
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstring>
#include <cstdlib>
#include <cmath>

#include "m17_resources.h"

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M17;

// ============================================================
// 通用：pipe_t 常量（BufferID 同步封装）
// ============================================================

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);   // acquire 立即获取
}

template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);    // 阻塞释放：等本 pipe 已发射指令落地（mode=false = CANN ASC_LOCK_BLOCK 默认）
}

template <pipe_t pipe>
__aicore__ inline void MutexLock(AscendC::MutexID id)
{
    AscendC::Mutex::Lock<pipe>(id);
}

template <pipe_t pipe>
__aicore__ inline void MutexUnlock(AscendC::MutexID id)
{
    AscendC::Mutex::Unlock<pipe>(id);
}

// 显式块拷贝参数（小改 A：杜绝元素计数重载）
//   注意 DataCopyParams.blockLen 单位是 **32B 块**（CANN: blockLen = count / GetC0Count(sizeof(T))），
//   故入参统一为**字节数**，内部 /32 换算：bf16 行 HIDDEN → Block1(HIDDEN*2) = {1,160,0,0}；
//   fp32 resOut 行 → Block1(HIDDEN*4) = {1,320,0,0}；WROW_I32 → Block1(WROW_I32*4) = {1,2,0,0}。
__aicore__ inline AscendC::DataCopyParams Block1(uint32_t bytes)
{
    // 前置条件：bytes 必须是 32B 整数倍（当前 22 个点位全部整除）。非整数倍会静默少搬，
    // 必须改走 DataCopyPad —— 这里留防呆：违反时 Trap（device 报 aicore exception，便于定位）。
    if ((bytes & 31u) != 0u) {
        AscendC::Trap();
    }
    return AscendC::DataCopyParams{1, static_cast<uint16_t>(bytes / 32), 0, 0};
}

__aicore__ inline AscendC::DataCopyExtParams ExtBlock1(uint32_t bytes)
{
    return AscendC::DataCopyExtParams{1, bytes, 0, 0, 0};
}

// ============================================================
// 通用：bf16 / fp32 位运算与 cast trait
// ============================================================

__aicore__ inline float Bf16ToF32Bits(uint32_t bitsLow16)
{
    uint32_t x = bitsLow16 << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

constexpr Reg::CastTrait castTraitB162B32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                            RoundMode::UNKNOWN};
constexpr Reg::CastTrait castTraitB322B16 = {RegLayout::ZERO, SatMode::NO_SAT, MaskMergeMode::ZEROING,
                                            RoundMode::CAST_RINT};
constexpr Reg::CastTrait castTraitRM_Round = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING,
                                             RoundMode::CAST_ROUND};


// ============================================================
// AIC：grouped MXFP4 GEMM 单 work item（m3_grouped_gemm 的 MXFP4GemmItem 逐行 lift）
//   K/N 编译期常量；A_SCAL_STRIDE = A 侧 scale 行距（字节）
// ============================================================

template <uint32_t K, uint32_t N, uint32_t A_SCAL_STRIDE>
class MXFP4GemmItem {
    static constexpr uint32_t PACKED_K = K / 2;
    static constexpr uint32_t SCALE_K = K / GROUP;
    static_assert(K % BASE_K == 0, "K must be divisible by BASE_K");
    static_assert(N % BASE_N == 0, "N must be divisible by BASE_N");

public:
    __aicore__ inline MXFP4GemmItem() {}

    // 每个 work item 调用：设置该槽位的 GM 基址（每对象只 Set 一次：本 item 是常驻成员）
    __aicore__ inline void SetItem(__gm__ uint8_t* a, __gm__ uint8_t* as, __gm__ uint8_t* b, __gm__ uint8_t* bs,
                                   __gm__ uint8_t* c)
    {
        aGM.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)a);
        asGM.SetGlobalBuffer((__gm__ fp8_e8m0_t*)as);
        bGM.SetGlobalBuffer((__gm__ fp4x2_e2m1_t*)b);
        bsGM.SetGlobalBuffer((__gm__ fp8_e8m0_t*)bs);
        cGM.SetGlobalBuffer((__gm__ bfloat16_t*)c);
    }

    // 计算一个 (nBlock, curM) tile：k 循环累加 L0C → Fixpipe 写 GM
    __aicore__ inline void Run(uint32_t nBlock, uint32_t curM)
    {
        const uint32_t curMAlign = ((curM + CUBE_BLOCK - 1) / CUBE_BLOCK) * CUBE_BLOCK;
        // 3510 quirk（同 m1）：Nd2Nz/Dn2Nz 行数=1 退化，计算侧提升为 >=2 行，仅 Fixpipe 按 curM 写出
        const uint32_t calcM = curM < 2 ? 2 : curM;
        const uint32_t kLoop = K / BASE_K;

        AscendC::LocalTensor<fp4x2_e2m1_t> a1Ping(AscendC::TPosition::A1, L1_OFF_A0, L1_A_DATA);
        AscendC::LocalTensor<fp4x2_e2m1_t> a1Pong(AscendC::TPosition::A1, L1_OFF_A1, L1_A_DATA);
        AscendC::LocalTensor<fp8_e8m0_t> as1Ping(AscendC::TPosition::A1, L1_OFF_AS0, L1_A_SCAL);
        AscendC::LocalTensor<fp8_e8m0_t> as1Pong(AscendC::TPosition::A1, L1_OFF_AS1, L1_A_SCAL);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Ping(AscendC::TPosition::B1, L1_OFF_B0, L1_B_DATA);
        AscendC::LocalTensor<fp4x2_e2m1_t> b1Pong(AscendC::TPosition::B1, L1_OFF_B1, L1_B_DATA);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Ping(AscendC::TPosition::B1, L1_OFF_BS0, L1_B_SCAL);
        AscendC::LocalTensor<fp8_e8m0_t> bs1Pong(AscendC::TPosition::B1, L1_OFF_BS1, L1_B_SCAL);
        AscendC::LocalTensor<fp4x2_e2m1_t> a2Ping(AscendC::TPosition::A2, L0_OFF_0, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> a2Pong(AscendC::TPosition::A2, L0_OFF_1, BASE_M * BASE_K / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Ping(AscendC::TPosition::B2, L0_OFF_0, BASE_K * BASE_N / 2);
        AscendC::LocalTensor<fp4x2_e2m1_t> b2Pong(AscendC::TPosition::B2, L0_OFF_1, BASE_K * BASE_N / 2);
        AscendC::LocalTensor<float> cL0C(AscendC::TPosition::CO1, 0, BASE_M * BASE_N);

        MutexLock<PIPE_M>(BUF_AIC_L0C);   // 挡住上一 item 的 Fixpipe 读，允许本 tile 累加
        for (uint32_t kBlock = 0; kBlock < kLoop; ++kBlock) {
            const uint32_t p = kBlock & 1;
            const AscendC::MutexID bufA = p ? BUF_AIC_A1 : BUF_AIC_A0;
            const AscendC::MutexID bufB = p ? BUF_AIC_B1 : BUF_AIC_B0;
            const AscendC::MutexID bufL0 = p ? BUF_AIC_L01 : BUF_AIC_L00;
            AscendC::LocalTensor<fp4x2_e2m1_t> a1 = p ? a1Pong : a1Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> b1 = p ? b1Pong : b1Ping;
            AscendC::LocalTensor<fp8_e8m0_t> as1 = p ? as1Pong : as1Ping;
            AscendC::LocalTensor<fp8_e8m0_t> bs1 = p ? bs1Pong : bs1Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> a2 = p ? a2Pong : a2Ping;
            AscendC::LocalTensor<fp4x2_e2m1_t> b2 = p ? b2Pong : b2Ping;

            MutexLock<PIPE_MTE2>(bufA);
            CopyInA(a1, as1, kBlock, calcM);
            MutexUnlock<PIPE_MTE2>(bufA);
            MutexLock<PIPE_MTE2>(bufB);
            CopyInB(b1, bs1, kBlock, nBlock);
            MutexUnlock<PIPE_MTE2>(bufB);

            MutexLock<PIPE_MTE1>(bufL0);
            MutexLock<PIPE_MTE1>(bufA);
            MutexLock<PIPE_MTE1>(bufB);
            LoadA(a1, as1, a2, curMAlign);
            LoadB(b1, bs1, b2);
            MutexUnlock<PIPE_MTE1>(bufA);
            MutexUnlock<PIPE_MTE1>(bufB);
            MutexUnlock<PIPE_MTE1>(bufL0);

            MutexLock<PIPE_M>(bufL0);
            AscendC::MmadParams mmadParams;
            mmadParams.m = calcM;
            mmadParams.n = BASE_N;
            mmadParams.k = BASE_K;
            mmadParams.cmatrixInitVal = (kBlock == 0);
            AscendC::MmadMx(cL0C, a2, b2, mmadParams);
            MutexUnlock<PIPE_M>(bufL0);
        }
        MutexUnlock<PIPE_M>(BUF_AIC_L0C);   // L0C 累加结果就绪
        MutexLock<PIPE_FIX>(BUF_AIC_L0C);
        CopyOut(cL0C, nBlock, curM, curMAlign);
        MutexUnlock<PIPE_FIX>(BUF_AIC_L0C);
    }

private:
    // GM → L1：A 的一个 baseK 大包（calcM 行 × BASE_K fp4）+ scale（Dn2Nz，b16 视图）
    __aicore__ inline void CopyInA(AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
                                  uint32_t kBlock, uint32_t curM)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = curM;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_M;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, aGM[kBlock * BASE_K], par);   // 偏移按 fp4 元素（4bit）计

        constexpr uint32_t stepScaleK = BASE_K / GROUP;
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = curM;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = A_SCAL_STRIDE / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> asGMB16;
        asGMB16.SetGlobalBuffer(((__gm__ half*)asGM.GetPhyAddr()) + scaleOffHalf, curM * (A_SCAL_STRIDE / 2));
        AscendC::DataCopy(as1.ReinterpretCast<half>(), asGMB16, sp);
    }

    // GM → L1：B 按 [N, K] 原始 layout 搬 baseN 行 × BASE_K fp4 + scale
    __aicore__ inline void CopyInB(AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
                                  uint32_t kBlock, uint32_t nBlock)
    {
        constexpr uint32_t packedStepK = BASE_K / 2;
        AscendC::Nd2NzParams par;
        par.ndNum = 1;
        par.nValue = BASE_N;
        par.dValue = packedStepK;
        par.srcNdMatrixStride = 0;
        par.srcDValue = PACKED_K;
        par.dstNzC0Stride = BASE_N;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, bGM[kBlock * BASE_K + nBlock * BASE_N * K], par);

        constexpr uint32_t stepScaleK = BASE_K / GROUP;
        AscendC::Dn2NzParams sp;
        sp.dnNum = 1;
        sp.dValue = BASE_N;
        sp.nValue = stepScaleK / 2;
        sp.srcDnMatrixStride = 0;
        sp.srcDValue = SCALE_K / 2;
        sp.dstNzC0Stride = stepScaleK / 2;
        sp.dstNzNStride = 1;
        sp.dstNzMatrixStride = 0;
        const uint32_t scaleOffHalf = (nBlock * BASE_N * SCALE_K + kBlock * stepScaleK) / 2;
        AscendC::GlobalTensor<half> bsGMB16;
        bsGMB16.SetGlobalBuffer(((__gm__ half*)bsGM.GetPhyAddr()) + scaleOffHalf, BASE_N * (SCALE_K / 2));
        AscendC::DataCopy(bs1.ReinterpretCast<half>(), bsGMB16, sp);
    }

    __aicore__ inline void LoadA(AscendC::LocalTensor<fp4x2_e2m1_t>& a1, AscendC::LocalTensor<fp8_e8m0_t>& as1,
                                AscendC::LocalTensor<fp4x2_e2m1_t>& a2, uint32_t curMAlign)
    {
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = curMAlign / CUBE_BLOCK;
        lp.kStep = BASE_K / 64;
        lp.srcStride = BASE_M / CUBE_BLOCK;
        lp.dstStride = curMAlign / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = curMAlign / CUBE_BLOCK;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(a2, a1[0], as1[0], lp, mx);
    }

    __aicore__ inline void LoadB(AscendC::LocalTensor<fp4x2_e2m1_t>& b1, AscendC::LocalTensor<fp8_e8m0_t>& bs1,
                                AscendC::LocalTensor<fp4x2_e2m1_t>& b2)
    {
        constexpr uint32_t nFracs = BASE_N / CUBE_BLOCK;
        AscendC::LoadData2DParamsV2 lp;
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = nFracs;
        lp.kStep = BASE_K / 64;
        lp.srcStride = BASE_N / CUBE_BLOCK;
        lp.dstStride = nFracs;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData2DMxParams mx;
        mx.xStartPosition = 0;
        mx.yStartPosition = 0;
        mx.xStep = nFracs;
        mx.yStep = BASE_K / 64;
        mx.srcStride = BASE_K / 64;
        mx.dstStride = BASE_K / 64;
        AscendC::LoadData(b2, b1[0], bs1[0], lp, mx);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<float>& cL0C, uint32_t nBlock, uint32_t curM,
                                  uint32_t curMAlign)
    {
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp;
        fp.nSize = BASE_N;
        fp.mSize = curM;
        fp.srcStride = curMAlign;
        fp.dstStride = N;
        fp.quantPre = QuantMode_t::F322BF16;
        AscendC::Fixpipe(cGM[nBlock * BASE_N], cL0C, fp);
    }

private:
    AscendC::GlobalTensor<fp4x2_e2m1_t> aGM;
    AscendC::GlobalTensor<fp8_e8m0_t> asGM;
    AscendC::GlobalTensor<fp4x2_e2m1_t> bGM;
    AscendC::GlobalTensor<fp8_e8m0_t> bsGM;
    AscendC::GlobalTensor<bfloat16_t> cGM;
};

}  // namespace
// ============================================================
// S1/S10：Add + RMSNorm 段（m6_rmsnorm 移植；小改 D：残差输入支持 fp32）
//   ① xAdd = f32(x) + [f32(res) | res fp32] → xFp32
//   ② resOut(fp32) = xAdd      ③ rstd = 1/sqrt(mean+eps)   ④ y = bf16(xAdd·rstd·gamma)
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M17;

constexpr uint32_t VL_F32 = 64;                 // 256B 向量寄存器 fp32 lane 数
constexpr uint16_t CHUNKS_H = HIDDEN / VL_F32;  // 每行 64-lane chunk 数 = 40
constexpr float RMS_EPS = 1e-6f;
constexpr float RMS_AVG_FACTOR = 1.0f / static_cast<float>(HIDDEN);
constexpr uint32_t FOLD_POINT = 1280;           // 二分 fold 点（m6 donor tiling binAddQuotient）
constexpr uint32_t REDUCE_TMP_STRIDE = 24;      // ceil(foldLoops(20)/BLK_B32(8))*8

// ---- donorn（ops-nn norm/norm_common/op_kernel/reduce_common_regbase*.h，m6 逐字 lift）----
namespace NormDonor {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t V_LENGTH = VL_F32;
constexpr uint16_t DICHOTOMY_ADD_COEFF = 2;

constexpr AscendC::Reg::CastTrait castTraitB162B32 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::UNKNOWN,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::UNKNOWN};
constexpr AscendC::Reg::CastTrait castTraitB322B16 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::NO_SAT,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::CAST_RINT};

template <typename T, LoadDist FLOAT_LOAD_DIST = LoadDist::DIST_NORM,
          LoadDist NON_FLOAT_LOAD_DIST = LoadDist::DIST_UNPACK_B16>
__aicore__ inline void LoadRegForDtype(__ubuf__ T* src, RegTensor<float>& dst, MaskReg& preg, uint32_t offset)
{
    if constexpr (IsSameType<T, float>::value) {
        LoadAlign<T, FLOAT_LOAD_DIST>(dst, src + offset);
    } else {
        RegTensor<T> srcReg;
        LoadAlign<T, NON_FLOAT_LOAD_DIST>(srcReg, src + offset);
        Cast<float, T, castTraitB162B32>(dst, srcReg, preg);
    }
}

template <typename T, int32_t LAST_LOOP_NUMS>
__aicore__ inline void CalculateSquareReduceSumCommon(__ubuf__ T* xPtr, __ubuf__ float* dstPtr,
                                                      __ubuf__ float* tmpPtr, uint16_t rows, uint32_t rowStride,
                                                      uint32_t reduceNum, uint32_t foldPoint, uint32_t tmpStride)
{
    uint16_t foldLoops = static_cast<uint16_t>((foldPoint + V_LENGTH - 1) / V_LENGTH);
    uint32_t lastNum = foldPoint / V_LENGTH;
    uint32_t tail = (reduceNum > foldPoint) ? reduceNum - foldPoint : 0;
    uint16_t tailCeilLoops = static_cast<uint16_t>((tail + V_LENGTH - 1) / V_LENGTH);
    uint16_t firstFlodWithOutAddLoops = static_cast<uint16_t>(foldLoops - tailCeilLoops);
    (void)firstFlodWithOutAddLoops;

    __VEC_SCOPE__
    {
        RegTensor<float> xReg;
        RegTensor<float> xFoldReg;
        RegTensor<float> sumReg;
        RegTensor<float> reduceReg;
        MaskReg pregFull = CreateMask<float, MaskPattern::ALL>();
        MaskReg pregOne = CreateMask<float, MaskPattern::VL1>();
        MaskReg pregLoop;

        for (uint16_t i = 0; i < rows; ++i) {
            uint32_t baseOffset = static_cast<uint32_t>(i) * rowStride;
            uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
            uint32_t sregTail = tail;
            for (uint16_t j = 0; j < tailCeilLoops; ++j) {
                pregLoop = UpdateMask<float>(sregTail);
                uint32_t offset = static_cast<uint32_t>(j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                LoadRegForDtype<T>(xPtr + foldPoint, xFoldReg, pregFull, offset);
                Mul(xFoldReg, xFoldReg, xFoldReg, pregLoop);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + j, reduceReg, pregOne);
            }
            for (uint16_t j = 0; j < firstFlodWithOutAddLoops; ++j) {
                uint32_t offset = static_cast<uint32_t>(tailCeilLoops + j) * V_LENGTH + baseOffset;
                LoadRegForDtype<T>(xPtr, xReg, pregFull, offset);
                Mul(xReg, xReg, xReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tmpPtr + tmpOffset + tailCeilLoops + j,
                                                                     reduceReg, pregOne);
            }
        }
        LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        if constexpr (LAST_LOOP_NUMS == 1) {
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                LoadAlign<float>(xReg, tmpPtr + static_cast<uint32_t>(i) * tmpStride);
                Reduce<ReduceType::SUM>(reduceReg, xReg, pregLast);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        } else if constexpr (LAST_LOOP_NUMS == DICHOTOMY_ADD_COEFF) {
            lastNum -= V_LENGTH;
            MaskReg pregLast = UpdateMask<float>(lastNum);
            for (uint16_t i = 0; i < rows; ++i) {
                uint32_t tmpOffset = static_cast<uint32_t>(i) * tmpStride;
                LoadAlign<float>(xReg, tmpPtr + tmpOffset);
                LoadAlign<float>(xFoldReg, tmpPtr + tmpOffset + V_LENGTH);
                ShiftLefts((RegTensor<uint32_t>&)xFoldReg, (RegTensor<uint32_t>&)xFoldReg, static_cast<int16_t>(0),
                           pregLast);
                Add(sumReg, xReg, xFoldReg, pregFull);
                Reduce<ReduceType::SUM>(reduceReg, sumReg, pregFull);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstPtr + i, reduceReg, pregOne);
            }
        }
    }
}

template <typename T>
__aicore__ inline void CalculateSquareReduceSum(__ubuf__ T* xPtr, __ubuf__ float* dstPtr, __ubuf__ float* tmpPtr,
                                                uint16_t rows, uint32_t rowStride, uint32_t reduceNum,
                                                uint32_t foldPoint, uint32_t tmpStride)
{
    // 2560 = 2×1280 → 走 Common<1> 分支（与 m6 donor 调用一致）
    CalculateSquareReduceSumCommon<T, 1>(xPtr, dstPtr, tmpPtr, rows, rowStride, reduceNum, foldPoint, tmpStride);
}

template <bool NEED_MAX = true>
__aicore__ inline void ComputeRstdNewtonRaphsonReg(RegTensor<float>& var, RegTensor<float>& rstd, MaskReg& preg,
                                                   float epsilon)
{
    static constexpr float POS_INF = 3.40282366920938E+38;
    static constexpr float SCALAR1 = -0.5;
    static constexpr float SCALAR2 = 1.5;
    static constexpr float SCALAR3 = 0.5;
    static constexpr float SCALAR0 = -99.99;

    RegTensor<float> r;
    RegTensor<float> y;
    RegTensor<float> s;
    RegTensor<float> t;
    RegTensor<float> one;
    RegTensor<float> scalar1;
    RegTensor<float> t1;
    RegTensor<float> t3;
    RegTensor<float> t4;
    RegTensor<float> scalarInf;
    RegTensor<float> scalarZero;
    RegTensor<float> tmp;
    MaskReg cmpRegZero;
    MaskReg cmpRegInf;

    Duplicate(scalarInf, POS_INF, preg);
    Duplicate(scalarZero, float(0.0), preg);
    Duplicate(one, float(1.0), preg);
    Duplicate(scalar1, SCALAR3, preg);
    Duplicate(t1, SCALAR2, preg);
    Duplicate(s, float(1.0), preg);

    Adds(var, var, epsilon, preg);
    if constexpr (NEED_MAX) {
        Maxs(var, var, SCALAR0, preg);
    }
    Div(r, one, var, preg);
    Sqrt(y, r, preg);
    Muls(t, var, SCALAR1, preg);
    Mul(t, t, y, preg);
    Mul(tmp, t, y, preg);
    Add(t1, t1, tmp, preg);   // donor Mula
    Mul(rstd, y, t1, preg);
    Muls(t3, var, float(-1.0), preg);
    Mul(tmp, t3, r, preg);
    Add(s, s, tmp, preg);     // donor Mula
    Muls(t4, rstd, float(-1.0), preg);
    Mul(tmp, t4, rstd, preg);
    Add(r, r, tmp, preg);     // donor Mula
    Mul(tmp, var, r, preg);
    Add(s, s, tmp, preg);     // donor Mula
    Mul(s, s, rstd, preg);
    Mul(tmp, s, scalar1, preg);
    Add(rstd, rstd, tmp, preg);  // donor Mula
    Compares(cmpRegZero, var, POS_INF, preg);
    Select(rstd, scalarZero, rstd, cmpRegZero);
    Compares(cmpRegInf, var, float(0.0), preg);
    Select(rstd, scalarInf, rstd, cmpRegInf);
}

template <bool NEED_MAX = true, bool NEED_AVG_FACTOR = false>
__aicore__ inline void ComputeRstdNewtonRaphson(__ubuf__ float* src, __ubuf__ float* dst, uint32_t rowCount,
                                                float epsilon, float avgFactor, uint32_t vectorLen)
{
    uint16_t loopRows = static_cast<uint16_t>((rowCount + vectorLen - 1) / vectorLen);
    __VEC_SCOPE__
    {
        RegTensor<float> var;
        RegTensor<float> rstd;
        MaskReg pregLoop;

        uint32_t sreg = rowCount;
        for (uint16_t i = 0; i < loopRows; ++i) {
            pregLoop = UpdateMask<float>(sreg);
            LoadAlign<float>(var, src + i * vectorLen);
            if constexpr (NEED_AVG_FACTOR) {
                Muls(var, var, avgFactor, pregLoop);
            }
            ComputeRstdNewtonRaphsonReg<NEED_MAX>(var, rstd, pregLoop, epsilon);
            StoreAlign<float>(dst + i * vectorLen, rstd, pregLoop);
        }
    }
}

}  // namespace NormDonor

// ---- gamma bf16 → fp32 预转（每个 AIV 核一次；落在 UB_GAMMA1_F32 / UB_GAMMA2_F32）----
// m6 的 PrecomputeGammaF32 同款：整核只做一次，之后 S1/S10 每行少 40 次 Cast，
// 同时让 y 循环里每 chunk 只剩一次 fp32→bf16 Cast（规避 3510 连续 Cast quirk）。
__aicore__ inline void PrecastGammaF32(__gm__ uint8_t* gamma, uint32_t dstUbOff)
{
    AscendC::GlobalTensor<bfloat16_t> gGm;
    gGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(gamma), HIDDEN);
    LocalTensor<bfloat16_t> gbL(TPosition::VECCALC, UB_PERSIST, HIDDEN);

    BufAcquire<PIPE_MTE2>(BUF_AIV_GAMMA);
    PipeBarrier<PIPE_MTE2>();
    DataCopy(gbL, gGm, Block1(HIDDEN * 2));
    BufRelease<PIPE_MTE2>(BUF_AIV_GAMMA);

    __ubuf__ bfloat16_t* gbUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_PERSIST);
    __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(dstUbOff);
    BufAcquire<PIPE_V>(BUF_AIV_GAMMA);
    __VEC_SCOPE__
    {
        RegTensor<bfloat16_t> gB16;
        RegTensor<float> gF;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        for (uint16_t i = 0; i < CHUNKS_H; ++i) {
            uint32_t offset = static_cast<uint32_t>(i) * VL_F32;
            LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(gB16, gbUb + offset);
            Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(gF, gB16, maskAll);
            StoreAlign<float, StoreDist::DIST_NORM_B32>(gfUb + offset, gF, maskAll);
        }
    }
    BufRelease<PIPE_V>(BUF_AIV_GAMMA);
}

// ============================================================
// S1/S10：NormStage（行切分；RES_F32 = 残差输入 fp32）
// ============================================================

template <bool RES_F32>
class NormStage {
public:
    __aicore__ inline NormStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* res, __gm__ uint8_t* y, __gm__ uint8_t* resOut,
                                uint32_t gammaF32UbOff, uint32_t m)
    {
        M = m;
        gammaOff = gammaF32UbOff;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M_MAX) * HIDDEN);
        if constexpr (RES_F32) {
            resGmF.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(res), static_cast<uint64_t>(M_MAX) * HIDDEN);
        } else {
            resGmB.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(res), static_cast<uint64_t>(M_MAX) * HIDDEN);
        }
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(y), static_cast<uint64_t>(M_MAX) * HIDDEN);
        resOutGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(resOut), static_cast<uint64_t>(M_MAX) * HIDDEN);
    }

    // 行 r = bid + i*nAiv（行间无依赖）
    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        for (uint32_t row = bid; row < M; row += nAiv) {
            CopyInRow(row);
            ComputeRow();
            CopyOutRow(row);
        }
    }

private:
    __aicore__ inline void CopyInRow(uint32_t row)
    {
        LocalTensor<bfloat16_t> x1L(TPosition::VECCALC, UB_M6_X1, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0);   // 挡上一行的 V 消费
        PipeBarrier<PIPE_MTE2>();              // 小改 B：行循环同 pipe 复用同一 UB 行缓冲
        DataCopy(x1L, xGm[off], Block1(HIDDEN * 2));
        if constexpr (RES_F32) {
            LocalTensor<float> resL(TPosition::VECCALC, UB_M6_RES, HIDDEN);
            DataCopy(resL, resGmF[off], Block1(HIDDEN * 4));   // fp32 残差（小改 D）
        } else {
            LocalTensor<bfloat16_t> resL(TPosition::VECCALC, UB_M6_RES, HIDDEN);
            DataCopy(resL, resGmB[off], Block1(HIDDEN * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0);
    }

    // donor ①：残差加（fp32 寄存器）→ UB 留 xFp32（resOut fp32 直接由它 MTE3 写出）
    __aicore__ inline void CalculateXAdd(__ubuf__ bfloat16_t* x1Ub, __ubuf__ float* xfUb)
    {
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> x1B16;
            RegTensor<float> x1;
            RegTensor<float> x2;
            RegTensor<float> xSum;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t i = 0; i < CHUNKS_H; ++i) {
                uint32_t offset = static_cast<uint32_t>(i) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(x1B16, x1Ub + offset);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(x1, x1B16, maskAll);
                if constexpr (RES_F32) {
                    LoadAlign<float>(x2, reinterpret_cast<__ubuf__ float*>(UB_M6_RES) + offset);
                } else {
                    RegTensor<bfloat16_t> x2B16;
                    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(
                        x2B16, reinterpret_cast<__ubuf__ bfloat16_t*>(UB_M6_RES) + offset);
                    Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(x2, x2B16, maskAll);
                }
                Add(xSum, x1, x2, maskAll);
                StoreAlign<float, StoreDist::DIST_NORM_B32>(xfUb + offset, xSum, maskAll);
            }
        }
    }

    // donor ④：y = (x·rstd)·gamma → bf16（gamma 已预转 fp32，每 chunk 仅一次 fp32→bf16 Cast）
    __aicore__ inline void CalculateY(__ubuf__ float* xfUb, __ubuf__ bfloat16_t* yUb, __ubuf__ float* rstdUb)
    {
        __ubuf__ float* gfUb = reinterpret_cast<__ubuf__ float*>(gammaOff);
        __VEC_SCOPE__
        {
            RegTensor<float> xReg;
            RegTensor<float> gReg;
            RegTensor<float> rstdReg;
            RegTensor<float> tReg;
            RegTensor<float> yReg;
            RegTensor<bfloat16_t> yB16;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            LoadAlign<float, LoadDist::DIST_BRC_B32>(rstdReg, rstdUb);
            for (uint16_t i = 0; i < CHUNKS_H; ++i) {
                uint32_t offset = static_cast<uint32_t>(i) * VL_F32;
                LoadAlign<float>(xReg, xfUb + offset);
                LoadAlign<float>(gReg, gfUb + offset);
                Mul(tReg, xReg, rstdReg, maskAll);
                Mul(yReg, tReg, gReg, maskAll);
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yB16, yReg, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(yUb + offset, yB16, maskAll);
            }
        }
    }

    __aicore__ inline void ComputeRow()
    {
        LocalTensor<float> xfL(TPosition::VECCALC, UB_M6_XF, HIDDEN);
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_M6_Y, HIDDEN);
        LocalTensor<float> tmpL(TPosition::VECCALC, UB_M6_TMP, 64);
        LocalTensor<float> redL(TPosition::VECCALC, UB_M6_RED, 64);
        LocalTensor<float> rstdL(TPosition::VECCALC, UB_M6_RSTD, 64);
        __ubuf__ bfloat16_t* x1Ub = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_M6_X1);
        __ubuf__ float* xfUb = reinterpret_cast<__ubuf__ float*>(xfL.GetPhyAddr());
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(yL.GetPhyAddr());
        __ubuf__ float* tmpUb = reinterpret_cast<__ubuf__ float*>(tmpL.GetPhyAddr());
        __ubuf__ float* redUb = reinterpret_cast<__ubuf__ float*>(redL.GetPhyAddr());
        __ubuf__ float* rstdUb = reinterpret_cast<__ubuf__ float*>(rstdL.GetPhyAddr());

        BufAcquire<PIPE_V>(BUF_AIV_ROW0);    // 等 x/res 行就位
        BufAcquire<PIPE_V>(BUF_AIV_OUT);     // 等上一行 MTE3 读完 xFp32/y 缓冲
        CalculateXAdd(x1Ub, xfUb);
        NormDonor::CalculateSquareReduceSum<float>(xfUb, redUb, tmpUb, 1, HIDDEN, HIDDEN, FOLD_POINT,
                                                   REDUCE_TMP_STRIDE);
        NormDonor::ComputeRstdNewtonRaphson<true, true>(redUb, rstdUb, 1, RMS_EPS, RMS_AVG_FACTOR, VL_F32);
        CalculateY(xfUb, yUb, rstdUb);
        BufRelease<PIPE_V>(BUF_AIV_ROW0);    // x/res 消费完，MTE2 可复用
        BufRelease<PIPE_V>(BUF_AIV_OUT);     // xFp32/y 写完且 drain，MTE3 可读
    }

    __aicore__ inline void CopyOutRow(uint32_t row)
    {
        LocalTensor<float> xfL(TPosition::VECCALC, UB_M6_XF, HIDDEN);
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_M6_Y, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(row) * HIDDEN;
        BufAcquire<PIPE_MTE3>(BUF_AIV_OUT);
        DataCopy(resOutGm[off], xfL, Block1(HIDDEN * 4));   // 残差出口 fp32
        DataCopy(yGm[off], yL, Block1(HIDDEN * 2));        // y bf16
        BufRelease<PIPE_MTE3>(BUF_AIV_OUT);
    }

private:
    uint32_t M = 0;
    uint32_t gammaOff = 0;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<bfloat16_t> resGmB;
    AscendC::GlobalTensor<float> resGmF;
    AscendC::GlobalTensor<bfloat16_t> yGm;
    AscendC::GlobalTensor<float> resOutGm;
};

}  // namespace
// ============================================================
// S2：Router 段（m7_router_topk 移植：流式 GEMV 向量 MAC → max-shift softmax →
//     Sort32 + 2 路 MrgSort 归并树 top-10 降序 → renorm），AIV0 单核
//
//     与 m13 的差别（E=4 → 512）：m13 把 [E+1][HIDDEN] 的 router 权重**全量**预转 fp32
//     常驻 UB（E=4 时 51KB），E=512 时要 5.25MB → 必须改成 m7 的流式结构：
//       * x 行块（RT_RB=8 行）一次 MTE2 载入常驻；
//       * router 权重按「8 个专家一组」流式读入 ping/pong（bf16）→ V 预转 fp32 到 RT_WF 窗；
//       * 每组 8 个专家的点积复用同一份 x 载入（Dot8Row）。
//     top-k 也由 m13 的「单块 Sort32（只覆盖 E≤32）」换成 m7 的归并树：
//     16 个 32 块各自 Sort32 → 4 级 2 路 `MrgSort` → 根节点得**全局 top-64** → Extract 64 → 取前 10。
//     注意每级 `elementLengths=[32,32,0,0]` 只产出 64 对（不是 512 对全序）：对 top-10 已经充分，
//     归纳链为 top-10(并集) ⊆ top-32(各输入) ⊆ 本级输出 64，逐级成立。
//     API 选择说明：用 2 路 `MrgSort(dst, srcList, info)`（validBit=0b0011），**不用**
//     `AscendC::MrgSort4` —— 仓库探针档案（probe_sync_quirks A02/A15/A20，`docs/05` §6 #19）
//     实测 `MrgSort4` 在 dav-3510 上是**静默 no-op**（dst 全 sentinel、只给 deprecated 警告），
//     而**同样的 4 路参数**走 `MrgSort` 时真机完全正确（128 对全序、逐项一致）。
//     即当年"4 路丢 src3/src4 index"是本方调错 API，不是硬件限制；本实现选 2 路纯粹因为
//     top-10 用不着 4 路，且 3510 的 `elementLengths` 上限实测为 64（256 触发 507035）。
//
//     共享专家门 sgate[r] 在同一段内用同款流式点积算（权重只有 1 行，预转一次常驻
//     RT_SGWF）；sigmoid 由 S9b 的向量路径完成（与 m13 一致，避免 AIV 内标量浮点）。
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M17;

constexpr uint32_t RT_KCHUNK = 64;                     // GEMV K 分步：UNPACK 载入 64 个 bf16 → Cast 成 64 连续 fp32
constexpr uint32_t RT_NCHUNK = HIDDEN / RT_KCHUNK;     // 40
constexpr uint32_t RT_SORT_BLK = NUM_EXPERTS / 32;     // 16 个 32 块
constexpr uint32_t RT_WROW_I32 = 16;                   // RT_WS/RT_IDS 行槽位（int32 数）

class RouterStage {
public:
    __aicore__ inline RouterStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* xIn, __gm__ uint8_t* routerW, __gm__ uint8_t* sgateW,
                                __gm__ uint8_t* logits, __gm__ uint8_t* ids, __gm__ uint8_t* weights,
                                __gm__ uint8_t* sgate, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(xIn), static_cast<uint64_t>(M_MAX) * HIDDEN);
        rwGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(routerW),
                             static_cast<uint64_t>(NUM_EXPERTS) * HIDDEN);
        sgGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(sgateW), HIDDEN);
        logitsGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(logits),
                                 static_cast<uint64_t>(M_MAX) * NUM_EXPERTS);
        idsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ids), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(weights), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        sgateGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(sgate), M_MAX);
    }

    // subLimit（bring-up 旋钮）：1 = 建索引模板，2 = 顺带算共享门，3 = 全开
    __aicore__ inline void Run(uint32_t subLimit)
    {
        if (subLimit >= 1) {
            BuildIndexTemplate();
        }
        if (subLimit >= 2) {
            CopyInSgateW();
            PrecastSgate();
        }
        if (subLimit >= 3) {
            const uint32_t nblk = (M + RT_RB - 1) / RT_RB;
            for (uint32_t b = 0; b < nblk; ++b) {
                const uint32_t b0 = b * RT_RB;
                const uint32_t rows = (M - b0 < RT_RB) ? (M - b0) : RT_RB;
                CopyInXBlock(b0, rows);
                Gemv(rows);
                if (subLimit >= 2) {
                    SgateRows(rows);
                }
                for (uint32_t r = 0; r < rows; ++r) {
                    SoftmaxTopkRenormRow(r);
                }
                CopyOutBlock(b0, rows);
            }
        }
    }

private:
    // ---- 3510 实测：Reg::Arange 只填 64 lane（int32 128-lane 寄存器高 64 为 0），
    //      故按 64-lane 分 E/64 块建全局 expert id 模板，否则 idx%128∈[64,128) 的 id 全丢成 0
    __aicore__ inline void BuildIndexTemplate()
    {
        __VEC_SCOPE__
        {
            uint32_t cnt64 = 64;
            MaskReg m64 = UpdateMask<int32_t>(cnt64);
            for (uint16_t c = 0; c < static_cast<uint16_t>(NUM_EXPERTS / 64); ++c) {
                RegTensor<int32_t> rg;
                Arange(rg, static_cast<int32_t>(c * 64));
                StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(RT_IDX) + c * 64, rg, m64);
            }
        }
    }

    __aicore__ inline void CopyInXBlock(uint32_t b0, uint32_t rows)
    {
        BufAcquire<PIPE_MTE2>(BUF_AIV_RT_X);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> xT(TPosition::VECCALC, RT_XB + r * HIDDEN * 2, HIDDEN);
            DataCopy(xT, xGm[static_cast<uint64_t>(b0 + r) * HIDDEN], Block1(HIDDEN * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_RT_X);
    }

    // ---- MTE2：router 权重行 e 搬进 ping/pong ----
    __aicore__ inline void LoadW(uint32_t e, uint32_t bufSel)
    {
        if (e >= NUM_EXPERTS) {
            return;
        }
        const AscendC::MutexID id = bufSel ? BUF_AIV_RT_W1 : BUF_AIV_RT_W0;
        BufAcquire<PIPE_MTE2>(id);
        LocalTensor<bfloat16_t> wT(TPosition::VECCALC, RT_WB + bufSel * HIDDEN * 2, HIDDEN);
        DataCopy(wT, rwGm[static_cast<uint64_t>(e) * HIDDEN], Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE2>(id);
    }

    // ---- V：权重行 bf16 → fp32 预转（RT_WF 的 slot 槽）----
    __aicore__ inline void PrecastW(uint32_t bufSel, uint32_t slot)
    {
        const uint32_t srcOff = RT_WB + bufSel * HIDDEN * 2;
        __ubuf__ bfloat16_t* wSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(srcOff);
        __ubuf__ float* wDst = reinterpret_cast<__ubuf__ float*>(RT_WF + slot * HIDDEN * 4);
        __VEC_SCOPE__
        {
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t c = 0; c < static_cast<uint16_t>(RT_NCHUNK); ++c) {
                RegTensor<bfloat16_t> b0;
                RegTensor<float> f0;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(b0, wSrc + c * RT_KCHUNK);
                Cast<float, bfloat16_t, castTraitB162B32>(f0, b0, maskAll);
                StoreAlign(wDst + c * RT_KCHUNK, f0, maskAll);
            }
        }
    }

    __aicore__ inline void CopyInSgateW()
    {
        // 用**独立** UB 槽（RT_SGB）而不是复用 router 权重的 ping/pong：
        // 复用会让 MTE2 写与 V 读落在同一片 UB 上却没有 token，属未定义次序
        BufAcquire<PIPE_MTE2>(BUF_AIV_RT_SG);
        LocalTensor<bfloat16_t> wT(TPosition::VECCALC, RT_SGB, HIDDEN);
        DataCopy(wT, sgGm, Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE2>(BUF_AIV_RT_SG);
    }

    __aicore__ inline void PrecastSgate()
    {
        __ubuf__ bfloat16_t* wSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(RT_SGB);
        __ubuf__ float* wDst = reinterpret_cast<__ubuf__ float*>(RT_SGWF);
        BufAcquire<PIPE_V>(BUF_AIV_RT_SG);   // 等 MTE2 把 sgate 权重行搬完
        __VEC_SCOPE__
        {
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t c = 0; c < static_cast<uint16_t>(RT_NCHUNK); ++c) {
                RegTensor<bfloat16_t> b0;
                RegTensor<float> f0;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(b0, wSrc + c * RT_KCHUNK);
                Cast<float, bfloat16_t, castTraitB162B32>(f0, b0, maskAll);
                StoreAlign(wDst + c * RT_KCHUNK, f0, maskAll);
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_RT_SG);
    }

    // ---- 8 个专家一组的点积（共享 1 次 x 载入）：40 步 UNPACK+Cast+fp32 MAC，
    //      8 路 Reduce 后用 Interleave 树拼成 8 连续 lane，mask=8 StoreAlign 写 logits
    __aicore__ inline void Dot8Row(__ubuf__ bfloat16_t* xSrc, __ubuf__ float* logP)
    {
        __VEC_SCOPE__
        {
            RegTensor<float> a0, a1, a2, a3, a4, a5, a6, a7;
            RegTensor<float> xf, wf0, wf1, wf2, wf3, wf4, wf5, wf6, wf7;
            RegTensor<float> i01, i23, i45, i67, j0, j1, j2, j3, v, vv;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(a0, 0.0f);
            Duplicate(a1, 0.0f);
            Duplicate(a2, 0.0f);
            Duplicate(a3, 0.0f);
            Duplicate(a4, 0.0f);
            Duplicate(a5, 0.0f);
            Duplicate(a6, 0.0f);
            Duplicate(a7, 0.0f);
            for (uint16_t c = 0; c < static_cast<uint16_t>(RT_NCHUNK); ++c) {
                RegTensor<bfloat16_t> xb;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(xb, xSrc + c * RT_KCHUNK);
                Cast<float, bfloat16_t, castTraitB162B32>(xf, xb, full);
                const uint32_t off = c * RT_KCHUNK;
                LoadAlign(wf0, reinterpret_cast<__ubuf__ float*>(RT_WF + 0 * HIDDEN * 4) + off);
                LoadAlign(wf1, reinterpret_cast<__ubuf__ float*>(RT_WF + 1 * HIDDEN * 4) + off);
                LoadAlign(wf2, reinterpret_cast<__ubuf__ float*>(RT_WF + 2 * HIDDEN * 4) + off);
                LoadAlign(wf3, reinterpret_cast<__ubuf__ float*>(RT_WF + 3 * HIDDEN * 4) + off);
                LoadAlign(wf4, reinterpret_cast<__ubuf__ float*>(RT_WF + 4 * HIDDEN * 4) + off);
                LoadAlign(wf5, reinterpret_cast<__ubuf__ float*>(RT_WF + 5 * HIDDEN * 4) + off);
                LoadAlign(wf6, reinterpret_cast<__ubuf__ float*>(RT_WF + 6 * HIDDEN * 4) + off);
                LoadAlign(wf7, reinterpret_cast<__ubuf__ float*>(RT_WF + 7 * HIDDEN * 4) + off);
                MulAddDst(a0, xf, wf0, full);
                MulAddDst(a1, xf, wf1, full);
                MulAddDst(a2, xf, wf2, full);
                MulAddDst(a3, xf, wf3, full);
                MulAddDst(a4, xf, wf4, full);
                MulAddDst(a5, xf, wf5, full);
                MulAddDst(a6, xf, wf6, full);
                MulAddDst(a7, xf, wf7, full);
            }
            Reduce<ReduceType::SUM, float>(a0, a0, full);
            Reduce<ReduceType::SUM, float>(a1, a1, full);
            Reduce<ReduceType::SUM, float>(a2, a2, full);
            Reduce<ReduceType::SUM, float>(a3, a3, full);
            Reduce<ReduceType::SUM, float>(a4, a4, full);
            Reduce<ReduceType::SUM, float>(a5, a5, full);
            Reduce<ReduceType::SUM, float>(a6, a6, full);
            Reduce<ReduceType::SUM, float>(a7, a7, full);
            // 索引顺序与 m7 一致（interleave 树的 lane 顺序经 m7 真机标定：只保证 8 个
            // 点积落在 8 个连续 lane 上、顺序由 StoreAlign 的 lane 排列给出）
            Interleave(i01, vv, a0, a4);
            Interleave(i23, vv, a2, a6);
            Interleave(i45, vv, a1, a5);
            Interleave(i67, vv, a3, a7);
            Interleave(j0, j1, i01, i23);
            Interleave(j2, j3, i45, i67);
            Interleave(v, vv, j0, j2);
            uint32_t eight = RT_EGRP;
            MaskReg m8 = UpdateMask<float>(eight);
            StoreAlign(logP, v, m8);
        }
    }

    // ---- GEMV：logits[r][e] = Σ_k x[r,k]·w[e,k]（fp32 向量 MAC，权重流式）----
    // 协议（照抄 m7）：进入每组时 W0=w[e0]、W1=w[e0+1]；slot s 预转 w[e0+s]（缓冲 s%2），
    // 预转后 MTE2 把 w[e0+s+2] 装入该缓冲（s=6/7 时即下一组的预取）。
    __aicore__ inline void Gemv(uint32_t rows)
    {
        BufAcquire<PIPE_V>(BUF_AIV_RT_X);
        LoadW(0, 0);
        LoadW(1, 1);
        for (uint32_t e0 = 0; e0 < NUM_EXPERTS; e0 += RT_EGRP) {
            BufAcquire<PIPE_V>(BUF_AIV_RT_W0);
            PrecastW(0, 0);
            BufRelease<PIPE_V>(BUF_AIV_RT_W0);
            LoadW(e0 + 2, 0);
            BufAcquire<PIPE_V>(BUF_AIV_RT_W1);
            PrecastW(1, 1);
            BufRelease<PIPE_V>(BUF_AIV_RT_W1);
            LoadW(e0 + 3, 1);
            BufAcquire<PIPE_V>(BUF_AIV_RT_W0);
            PrecastW(0, 2);
            BufRelease<PIPE_V>(BUF_AIV_RT_W0);
            LoadW(e0 + 4, 0);
            BufAcquire<PIPE_V>(BUF_AIV_RT_W1);
            PrecastW(1, 3);
            BufRelease<PIPE_V>(BUF_AIV_RT_W1);
            LoadW(e0 + 5, 1);
            BufAcquire<PIPE_V>(BUF_AIV_RT_W0);
            PrecastW(0, 4);
            BufRelease<PIPE_V>(BUF_AIV_RT_W0);
            LoadW(e0 + 6, 0);
            BufAcquire<PIPE_V>(BUF_AIV_RT_W1);
            PrecastW(1, 5);
            BufRelease<PIPE_V>(BUF_AIV_RT_W1);
            LoadW(e0 + 7, 1);
            BufAcquire<PIPE_V>(BUF_AIV_RT_W0);
            PrecastW(0, 6);
            BufRelease<PIPE_V>(BUF_AIV_RT_W0);
            LoadW(e0 + 8, 0);
            BufAcquire<PIPE_V>(BUF_AIV_RT_W1);
            PrecastW(1, 7);
            BufRelease<PIPE_V>(BUF_AIV_RT_W1);
            LoadW(e0 + 9, 1);
            for (uint32_t r = 0; r < rows; ++r) {
                Dot8Row(reinterpret_cast<__ubuf__ bfloat16_t*>(RT_XB + r * HIDDEN * 2),
                        reinterpret_cast<__ubuf__ float*>(RT_LOG + r * NUM_EXPERTS * 4) + e0);
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_RT_X);
    }

    // ---- 共享专家门裸点积：sgate[r] = Σ_k x[r,k]·sgate_w[k] ----
    __aicore__ inline void SgateRows(uint32_t rows)
    {
        BufAcquire<PIPE_V>(BUF_AIV_RT_X);
        for (uint32_t r = 0; r < rows; ++r) {
            __ubuf__ bfloat16_t* xSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(RT_XB + r * HIDDEN * 2);
            __ubuf__ float* dst = reinterpret_cast<__ubuf__ float*>(RT_SG) + r;
            __VEC_SCOPE__
            {
                RegTensor<float> acc, xf, w;
                RegTensor<bfloat16_t> xb;
                MaskReg full = CreateMask<float, MaskPattern::ALL>();
                Duplicate(acc, 0.0f);
                for (uint16_t c = 0; c < static_cast<uint16_t>(RT_NCHUNK); ++c) {
                    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(xb, xSrc + c * RT_KCHUNK);
                    Cast<float, bfloat16_t, castTraitB162B32>(xf, xb, full);
                    LoadAlign(w, reinterpret_cast<__ubuf__ float*>(RT_SGWF) + c * RT_KCHUNK);
                    MulAddDst(acc, xf, w, full);
                }
                Reduce<ReduceType::SUM, float>(acc, acc, full);
                uint32_t one = 1;
                MaskReg m1 = UpdateMask<float>(one);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dst, acc, m1);
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_RT_X);
    }

    // ---- 行内 softmax(max-shift) + Sort32 + 2 路归并树 + Extract + renorm → staging ----
    __aicore__ inline void SoftmaxTopkRenormRow(uint32_t r)
    {
        const uint32_t logOff = RT_LOG + r * NUM_EXPERTS * 4;
        // 1) 行 max；2) e_i = exp(l_i - max)（softmax 的除 sum 与 renorm 抵消）→ RT_VAL
        BufAcquire<PIPE_V>(BUF_AIV_RT_LOG);
        __VEC_SCOPE__
        {
            RegTensor<float> v, m, mx, dm;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(m, -3.0e38f);
            for (uint16_t c = 0; c < static_cast<uint16_t>(NUM_EXPERTS / 64); ++c) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(logOff) + c * 64);
                Max(m, m, v, full);
            }
            Reduce<ReduceType::MAX, float>(mx, m, full);
            Duplicate(dm, mx, full);
            for (uint16_t c = 0; c < static_cast<uint16_t>(NUM_EXPERTS / 64); ++c) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(logOff) + c * 64);
                Sub(v, v, dm, full);
                StoreAlign(reinterpret_cast<__ubuf__ float*>(logOff) + c * 64, v, full);  // logits -= max
                Exp(v, v, full);
                StoreAlign(reinterpret_cast<__ubuf__ float*>(RT_VAL) + c * 64, v, full);
            }
        }
        // 3) Sort32：16 个 32 块内降序（值, 全局 expert id）
        {
            LocalTensor<float> valT(TPosition::VECCALC, RT_VAL, NUM_EXPERTS);
            LocalTensor<float> tmpT(TPosition::VECCALC, RT_TMP, 2 * NUM_EXPERTS);
            LocalTensor<uint32_t> idxT(TPosition::VECCALC, RT_IDX, NUM_EXPERTS);
            // Sort32 属 tower 裁决白名单（M44 裁定 ②：排序单元 primitive，性质等同搬运/矩阵；
            // CANN 9.1.0 头文件穷举无 Reg:: 等价物、官方 donor 同为 memory-based）。白名单仅
            // Sort32 / MrgSort 两项 —— 本段后面的经典 Extract 不在其中（见 §7 后续项）。
            Sort32(tmpT, valT, idxT, RT_SORT_BLK);
        }
        BufRelease<PIPE_V>(BUF_AIV_RT_LOG);
        // 4) 2 路归并树 → 各级 top-64；根节点输出 64 对（每级 elementLengths=[32,32,0,0]），不是 512 对全序
        MergeTree();
        // 5) Extract 前 64 对 → (RT_OUTV, RT_OUTI)
        //    ⚠ 经典（memory-based）`Extract` **不在** M44 裁定的白名单里 —— 本处是从 m7 的
        //    router 拷贝来的既有形态，按"已有的模块先报不改"属审计范围，见 README §7.13；
        //    3510 的经典 `Extract` 本身是 VF，改造时按 VF 调用形态处理。
        {
            LocalTensor<float> mT(TPosition::VECCALC, RT_MB, 2 * NUM_EXPERTS);
            LocalTensor<float> vT(TPosition::VECCALC, RT_OUTV, 64);
            LocalTensor<uint32_t> iT(TPosition::VECCALC, RT_OUTI, 64);
            Extract(vT, iT, mT, 2);
        }
        // 6) renorm（除以 top-10 的和）→ fp32 权重 + i32 expert id staging
        BufAcquire<PIPE_V>(BUF_AIV_RT_LOG);
        __VEC_SCOPE__
        {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            RegTensor<float> vals;
            RegTensor<int32_t> idxs;
            RegTensor<float> s, ds;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            // int32 的 ALL mask 是 128 lane，而 RT_IDS 行槽只有 64 个 → 必须用 64-lane mask，
            // 否则每行 store 512B、跨行越界（RT_IDS 行距只有 256B）
            uint32_t n64 = 64;
            MaskReg m64i = UpdateMask<int32_t>(n64);
            LoadAlign(vals, reinterpret_cast<__ubuf__ float*>(RT_OUTV));
            LoadAlign(idxs, reinterpret_cast<__ubuf__ int32_t*>(RT_OUTI));
            uint32_t nk = TOPK;
            MaskReg mk = UpdateMask<float>(nk);
            Reduce<ReduceType::SUM, float>(s, vals, mk);
            Duplicate(ds, s, maskAll);
            Div(vals, vals, ds, mk);
            StoreAlign(reinterpret_cast<__ubuf__ float*>(RT_WS + r * 64 * 4), vals, maskAll);
            StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(RT_IDS + r * RT_WROW_I32 * 4), idxs, m64i);
        }
        BufRelease<PIPE_V>(BUF_AIV_RT_LOG);
    }

    // ---- 2 路归并树（MA/MB 乒乓）：16 个 32 块 → 4 级归并 → 根节点 = 全局 top-64（落在 RT_MB）----
    //      每级 elementLengths=[32,32,0,0] → 输出 64 对；因此**不是** 512 对全序，而是"各级 top-64"。
    //      取前 10 仍严格正确（top-10 ⊆ 各级输入 top-32 ⊆ 本级输出 64）。
    __aicore__ inline void MergeTree()
    {
        LocalTensor<float> srcT(TPosition::VECCALC, RT_TMP, 2 * NUM_EXPERTS);
        LocalTensor<float> aT(TPosition::VECCALC, RT_MA, 2 * NUM_EXPERTS);
        LocalTensor<float> bT(TPosition::VECCALC, RT_MB, 2 * NUM_EXPERTS);
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 8; ++g) {   // level1: 16 块 → 8 组
            Merge2(aT[g * 128], srcT[(2 * g) * 64], srcT[(2 * g + 1) * 64], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 4; ++g) {   // level2: 8 组 → 4 组
            Merge2(bT[g * 128], aT[(2 * g) * 128], aT[(2 * g + 1) * 128], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 2; ++g) {   // level3: 4 组 → 2 组
            Merge2(aT[g * 128], bT[(2 * g) * 128], bT[(2 * g + 1) * 128], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        Merge2(bT[0], aT[0], aT[128], 32);   // level4: 2 组 → 1
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
    }

    // 2 路归并：走 `MrgSort(dst, srcList, MrgSort4Info)`（validBit=0b0011），**不用** `MrgSort4`
    // （后者在 dav-3510 上是 deprecated 空函数体，见 probe_sync_quirks A02/A15/A20 与 docs/05 §6 #19；
    //  同参数的 4 路 `MrgSort` 真机正确，故这里选 2 路只是够用，不是硬件限制）
    // `MrgSort` 属 tower 裁决白名单（M44 裁定 ②，与上面的 `Sort32` 同依据）
    __aicore__ inline void Merge2(const LocalTensor<float>& dst, const LocalTensor<float>& s1,
                                  const LocalTensor<float>& s2, uint32_t pairLen)
    {
        MrgSort4Info params;
        params.elementLengths[0] = static_cast<uint16_t>(pairLen);
        params.elementLengths[1] = static_cast<uint16_t>(pairLen);
        params.elementLengths[2] = 0;
        params.elementLengths[3] = 0;
        params.validBit = 0b0011;
        params.repeatTimes = 1;
        params.ifExhaustedSuspension = false;
        MrgSortSrcList<float> sl;
        sl.src1 = s1;
        sl.src2 = s2;
        sl.src3 = s2;
        sl.src4 = s2;
        MrgSort(dst, sl, params);
    }

    __aicore__ inline void CopyOutBlock(uint32_t b0, uint32_t rows)
    {
        LocalTensor<float> sgAll(TPosition::VECCALC, RT_SG, RT_RB);
        BufAcquire<PIPE_MTE3>(BUF_AIV_RT_LOG);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<float> logitsL(TPosition::VECCALC, RT_LOG + r * NUM_EXPERTS * 4, NUM_EXPERTS);
            LocalTensor<int32_t> idsL(TPosition::VECCALC, RT_IDS + r * RT_WROW_I32 * 4, RT_WROW_I32);
            LocalTensor<float> wsL(TPosition::VECCALC, RT_WS + r * 64 * 4, RT_WROW_I32);
            DataCopyPad(logitsGm[static_cast<uint64_t>(b0 + r) * NUM_EXPERTS], logitsL,
                        ExtBlock1(NUM_EXPERTS * 4));
            DataCopyPad(idsGm[static_cast<uint64_t>(b0 + r) * TOPK], idsL, ExtBlock1(TOPK * 4));
            DataCopyPad(wGm[static_cast<uint64_t>(b0 + r) * TOPK], wsL, ExtBlock1(TOPK * 4));
        }
        DataCopyPad(sgateGm[b0], sgAll, ExtBlock1(rows * 4));
        BufRelease<PIPE_MTE3>(BUF_AIV_RT_LOG);
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<bfloat16_t> rwGm;
    AscendC::GlobalTensor<bfloat16_t> sgGm;
    AscendC::GlobalTensor<float> logitsGm;
    AscendC::GlobalTensor<int32_t> idsGm;
    AscendC::GlobalTensor<float> wGm;
    AscendC::GlobalTensor<float> sgateGm;
};

// ============================================================
// S3：routing 索引生成（m7 ↔ m8 之间的缺口 glue；m8#1 只消费 perm_src/counts，
//     m8#2 消费 inv_slot/w_tk_packed，没有任何算件产生它们 → 本段补齐）
//     计数排序（stable，按 expert id 分组）与 moe_block_ref.py::moe_permute 同语义；
//     标量实现（E=512 / m*TOPK ≤ 640）；counts/offsets/cursor 放 UB 静态槽位
//     （m13 用的是栈数组，E=512 时 3×512×4B = 6KB 会压垮 AIV 标量栈），
//     UB 写 → MTE3 出（m3-AIV 同款 PIPE_S→MTE3 握手）
// ============================================================

class IndexGenStage {
public:
    __aicore__ inline IndexGenStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* ids, __gm__ uint8_t* weights, __gm__ uint8_t* counts,
                                __gm__ uint8_t* offsets, __gm__ uint8_t* permSrc, __gm__ uint8_t* permExp,
                                __gm__ uint8_t* inv, __gm__ uint8_t* wtk, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        idsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ids), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(weights), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), NUM_EXPERTS);
        offsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(offsets), NUM_EXPERTS + IG_DIAG_SLOT_END);
        permSrcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permSrc), TOTAL_MAX);
        permExpGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permExp), TOTAL_MAX);
        invGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(inv), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wtkGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(wtk), static_cast<uint64_t>(M_MAX) * 16);
    }

    __aicore__ inline uint32_t OobCount() const { return oobCountUb; }

    // subLimit：与 RouterStage 同一 bring-up 旋钮（运行时值；7/8/9 分别为索引数组/counts/诊断槽门控）
    __aicore__ inline void Run(uint32_t subLimit)
    {
        // router 的 MTE3 GM 写排空后再做标量 GM 读（同核次序）
        SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);

        const uint32_t S = M * TOPK;
        uint32_t badIds = 0;   // 脏 ids 计数：诊断槽上报 + 落位循环的短路条件
        __ubuf__ int32_t* srcUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_SRC);
        __ubuf__ int32_t* expUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_EXP);
        __ubuf__ int32_t* invUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_INV);
        __ubuf__ int32_t* wtkUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_WTK);
        __ubuf__ int32_t* cntUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_CNT);
        __ubuf__ int32_t* offUb = cntUb + IG_CNT_OFF_SLOT;
        __ubuf__ int32_t* curUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_CUR);

        for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
            cntUb[e] = 0;
        }
        for (uint32_t s = 0; s < S; ++s) {
            const int32_t e = idsGm.GetValue(s);
            if (e < 0 || e >= static_cast<int32_t>(NUM_EXPERTS)) {
                ++badIds;   // 防御：脏 ids 时不做越界写
                continue;
            }
            cntUb[e] = cntUb[e] + 1;
        }
        oobCountUb = badIds;   // 诊断槽（badIds != 0 时下面的落位循环整体短路）
        // 诊断槽的 UB 标量写必须落在 MutexLock/Unlock<PIPE_S> **之内或之前**：
        // MTE3 读 UB 的次序由「S 侧 unlock（阻塞释放）→ MTE3 acquire」保证，若把这次标量写
        // 放到 unlock 之后（m13 原样），就会与 DataCopyPad 抢跑 —— 实测 m=8 时诊断槽读到
        // 上一段遗留的 UB 残值（0x3ec5be6f），落盘 sha256 逐次不同。
        {
            __ubuf__ int32_t* bUb = reinterpret_cast<__ubuf__ int32_t*>(UB_IG_CNT);
            bUb[IG_CNT_DIAG_SLOT] = static_cast<int32_t>(badIds);
        }
        offUb[0] = 0;
        for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
            offUb[e + 1] = offUb[e] + cntUb[e];
        }

        MutexLock<PIPE_S>(BUF_AIV_IDX);
        for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
            curUb[e] = offUb[e];
        }
        // w_tk_packed 的尾部（k ∈ [TOPK,16)）内核不写，但 MTE3 会按 M*16 个 int32 整段拷出 →
        // 若不先清零，落盘内容就是上一段留下的 UB 残值，落盘 sha256 会**逐次不同**（实测只此一处）。
        for (uint32_t i = 0; i < M * 16; ++i) {
            wtkUb[i] = 0;
        }
        for (uint32_t t = 0; t < M; ++t) {
            for (uint32_t k = 0; k < TOPK; ++k) {
                const uint32_t s = t * TOPK + k;
                const int32_t e = idsGm.GetValue(s);
                if (e < 0 || e >= static_cast<int32_t>(NUM_EXPERTS) || badIds != 0) {
                    // 与计数循环对称的防御：脏 ids 时 cursor[e]/off[e]/invUb[s] 一律不越界
                    ++badIds;
                    continue;
                }
                const uint32_t pos = static_cast<uint32_t>(curUb[e]);
                curUb[e] = static_cast<int32_t>(pos + 1);
                srcUb[pos] = static_cast<int32_t>(t);
                expUb[pos] = e;
                // Y 布局是 [slot][M_MAX][HIDDEN]（槽位 padding）→ inv 存 padding 行号
                invUb[s] = static_cast<int32_t>(static_cast<uint32_t>(e) * M_MAX +
                                               (pos - static_cast<uint32_t>(offUb[e])));
                // bf16(RNE) 权重位打包进 int32 低 16 位（m8 w_tk_packed 协议）
                const float f = wGm.GetValue(s);
                uint32_t bits;
                __builtin_memcpy(&bits, &f, 4);
                const uint32_t rounded = (bits + 0x7FFFu + ((bits >> 16) & 1u)) >> 16;
                wtkUb[t * 16 + k] = static_cast<int32_t>(rounded & 0xFFFFu);
            }
        }
        MutexUnlock<PIPE_S>(BUF_AIV_IDX);
        if (subLimit < 7) {
            return;
        }

        // UB → GM（PIPE_S 写 → MTE3 读的 BufferID 握手，m3-AIV 同款）
        LocalTensor<int32_t> srcL(TPosition::VECCALC, UB_IG_SRC, S);
        LocalTensor<int32_t> expL(TPosition::VECCALC, UB_IG_EXP, S);
        LocalTensor<int32_t> invL(TPosition::VECCALC, UB_IG_INV, S);
        LocalTensor<int32_t> wtkL(TPosition::VECCALC, UB_IG_WTK, M * 16);
        LocalTensor<int32_t> cntL(TPosition::VECCALC, UB_IG_CNT, IG_CNT_DIAG_SLOT + 1);
        BufAcquire<PIPE_MTE3>(BUF_AIV_IDX);
        DataCopyPad(permSrcGm[0], srcL, ExtBlock1(S * 4));
        // perm_expert 在 kernel 链内**没有消费者**（链上只需要 perm_src/counts/inv_slot/w_tk）：
        // 落盘它是为了 host 不变量判据与 check_ref.py 逐位核对路由分组（生产自同一计数排序）
        DataCopyPad(permExpGm[0], expL, ExtBlock1(S * 4));
        DataCopyPad(invGm[0], invL, ExtBlock1(S * 4));
        DataCopyPad(wtkGm[0], wtkL, ExtBlock1(M * 16 * 4));
        if (subLimit < 8) {
            BufRelease<PIPE_MTE3>(BUF_AIV_IDX);
            return;
        }
        DataCopyPad(countsGm[0], cntL, ExtBlock1(NUM_EXPERTS * 4));
        DataCopyPad(offsGm[0], cntL[IG_CNT_OFF_SLOT], ExtBlock1((NUM_EXPERTS + 1) * 4));
        if (subLimit >= 9) {
            // 诊断槽：GM 目的必须放在 offsets[E+1] 之**后**（m13 把它写进 offs[8]，
            // 会覆盖真正的 offsets[8]；本实现挪到第 E+8 个 int32 = (E+8)*4 字节，32B 对齐）。
            // UB 侧的值已在 MutexLock<PIPE_S> 区之前写好（见 Run 开头），此处只搬。
            DataCopyPad(offsGm[IG_DIAG_GM_SLOT], cntL[IG_CNT_DIAG_SLOT], ExtBlock1(4));
        }
        BufRelease<PIPE_MTE3>(BUF_AIV_IDX);
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    uint32_t oobCountUb = 0;
    AscendC::GlobalTensor<int32_t> idsGm;
    AscendC::GlobalTensor<float> wGm;
    AscendC::GlobalTensor<int32_t> countsGm;
    AscendC::GlobalTensor<int32_t> offsGm;
    AscendC::GlobalTensor<int32_t> permSrcGm;
    AscendC::GlobalTensor<int32_t> permExpGm;
    AscendC::GlobalTensor<int32_t> invGm;
    AscendC::GlobalTensor<int32_t> wtkGm;
};

}  // namespace
// ============================================================
// S4：permute（m8_permute kernel #1 移植：x_sorted[i] = x[perm_src_token[i]]，
//     纯带宽逐行 gather，四级流水 + 小改 B 的 MTE2 排空）
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M17;

constexpr uint32_t PERM_STAGES = 4;

class PermuteStage {
public:
    __aicore__ inline PermuteStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* x, __gm__ uint8_t* permSrc, __gm__ uint8_t* counts,
                                __gm__ uint8_t* xSorted, uint32_t numExperts, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        E = numExperts;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M_MAX) * HIDDEN);
        srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permSrc), TOTAL_MAX);
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), numExperts);
        xSortedGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(xSorted), static_cast<uint64_t>(TOTAL_MAX) * HIDDEN);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        uint32_t total = 0;
        for (uint32_t e = 0; e < E; ++e) {
            total += static_cast<uint32_t>(countsGm.GetValue(e));
        }
        TOTAL = total;
        const uint32_t myRows = (total > bid) ? (total - bid - 1) / nAiv + 1 : 0;
        for (uint32_t s = 0; s < PERM_STAGES && s < myRows; ++s) {
            CopyIn(bid + s * nAiv, s);
        }
        for (uint32_t r = 0; r < myRows; ++r) {
            const uint32_t stage = r % PERM_STAGES;
            CopyOut(bid + r * nAiv, stage);
            if (r + PERM_STAGES < myRows) {
                CopyIn(bid + (r + PERM_STAGES) * nAiv, stage);
            }
        }
    }

    __aicore__ inline uint32_t Total() const { return TOTAL; }

private:
    __aicore__ inline void CopyIn(uint32_t row, uint32_t stage)
    {
        LocalTensor<bfloat16_t> bufL(TPosition::VECCALC, UB_PM_ROW + stage * HIDDEN * 2, HIDDEN);
        const int32_t src = srcGm.GetValue(row);   // 标量 GM 读（地址计算，值依赖合法）
        BufAcquire<PIPE_MTE2>(BUF_AIV_PERM0 + stage);
        PipeBarrier<PIPE_MTE2>();                  // 小改 B
        DataCopy(bufL, xGm[static_cast<uint64_t>(src) * HIDDEN], Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE2>(BUF_AIV_PERM0 + stage);
    }

    __aicore__ inline void CopyOut(uint32_t row, uint32_t stage)
    {
        LocalTensor<bfloat16_t> bufL(TPosition::VECCALC, UB_PM_ROW + stage * HIDDEN * 2, HIDDEN);
        BufAcquire<PIPE_MTE3>(BUF_AIV_PERM0 + stage);
        DataCopy(xSortedGm[static_cast<uint64_t>(row) * HIDDEN], bufL, Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE3>(BUF_AIV_PERM0 + stage);
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    uint32_t E = 1;
    uint32_t TOTAL = 0;
    AscendC::GlobalTensor<bfloat16_t> xGm;
    AscendC::GlobalTensor<int32_t> srcGm;
    AscendC::GlobalTensor<int32_t> countsGm;
    AscendC::GlobalTensor<bfloat16_t> xSortedGm;
};

// ============================================================
// S5/S7：行级 MXFP4 量化（m5_swiglu_quant 的 SwiGLU 五元组 + MxQuant 三段式）
//   小改 C：全 VEC 路径，**无 PIPE_S 挂载**（m3-AIV 的标量量化器被替换）
//   SWIGLU=true 时先做 SwiGLU（源为 gate|up 拼接行）+ 写 swiglu 输出（H 抽点用）
//   PAD_SRC/PAD_DST：源/目标是「按槽位 MAXM 行 padding」的布局（routed 路径），
//   否则是紧凑 m 行布局（shared 专家路径）
// ============================================================

template <uint32_t K, uint32_t SCAL_STRIDE, bool SWIGLU, bool PAD_SRC, bool PAD_DST>
class VecQuantStage {
public:
    static constexpr uint32_t TILE = 256;
    static constexpr uint32_t FULL_TILES = K / TILE;
    static constexpr uint32_t NTILES = (K % TILE == 0) ? FULL_TILES : FULL_TILES + 1;
    static constexpr uint32_t PACKED_K = K / 2;
    static constexpr uint32_t SRC_ROW = SWIGLU ? (2 * K) : K;   // gate|up vs 单段
    static constexpr uint32_t GP = K / GROUP;                   // 每行 scale 有效字节数

    __aicore__ inline VecQuantStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* src, __gm__ uint8_t* swigluOut, __gm__ uint8_t* qx,
                                __gm__ uint8_t* scale, __gm__ uint8_t* counts, uint32_t m, uint32_t topk)
    {
        M = m;
        TOPK = topk;
        srcGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(src),
                              static_cast<uint64_t>(TOTAL_MAX) * SRC_ROW);
        swigluGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(swigluOut),
                                 static_cast<uint64_t>(TOTAL_MAX) * K);
        qxGm.SetGlobalBuffer(reinterpret_cast<__gm__ int8_t*>(qx), static_cast<uint64_t>(TOTAL_MAX) * PACKED_K);
        scaleGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint16_t*>(scale),
                               static_cast<uint64_t>(TOTAL_MAX) * (SCAL_STRIDE / 2));
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), NUM_EXPERTS);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        uint32_t startOff[NUM_EXPERTS + 1];
        startOff[0] = 0;
        uint32_t rows = M;
        if constexpr (PAD_DST) {
            for (uint32_t e = 0; e < NUM_EXPERTS; ++e) {
                startOff[e + 1] = startOff[e] + static_cast<uint32_t>(countsGm.GetValue(e));
            }
            rows = startOff[NUM_EXPERTS];
        }
        for (uint32_t r = bid; r < rows; r += nAiv) {
            uint32_t slot = 0;
            uint32_t lr = r;
            if constexpr (PAD_DST) {
                while (slot < NUM_EXPERTS - 1 && r >= startOff[slot + 1]) {
                    ++slot;
                }
                lr = r - startOff[slot];
            }
            const uint32_t srcRow = PAD_SRC ? (slot * M_MAX + lr) : r;
            const uint32_t dstRow = PAD_DST ? (slot * M_MAX + lr) : r;
            for (uint32_t t = 0; t < NTILES; ++t) {
                // 尾 tile 回退窗口（K % TILE != 0 时），group 对齐 → 重叠区结果逐位一致
                const uint32_t t0 = (t < FULL_TILES) ? t * TILE : (K - TILE);
                ProcessTile(r, srcRow, dstRow, t0);
            }
        }
    }

private:
    __aicore__ inline void ProcessTile(uint32_t packedRow, uint32_t srcRow, uint32_t dstRow, uint32_t t0)
    {
        const uint64_t xOff = static_cast<uint64_t>(srcRow) * SRC_ROW + t0;
        const uint64_t hOff = static_cast<uint64_t>(packedRow) * K + t0;
        const uint64_t qxOff = static_cast<uint64_t>(dstRow) * PACKED_K + t0 / 2;
        const uint64_t sOff = static_cast<uint64_t>(dstRow) * (SCAL_STRIDE / 2) + t0 / GROUP / 2;

        LocalTensor<bfloat16_t> gateL(TPosition::VECCALC, UB_QT_GATE, TILE);
        LocalTensor<bfloat16_t> upL(TPosition::VECCALC, UB_QT_GATE + TILE * 2, TILE);
        LocalTensor<bfloat16_t> swigluL(TPosition::VECCALC, UB_QT_SWIGLU, TILE);
        LocalTensor<int8_t> qxL(TPosition::VECCALC, UB_QT_QX, TILE / 2);
        LocalTensor<uint16_t> scaleL(TPosition::VECCALC, UB_QT_SCALE, TILE / GROUP / 2);
        LocalTensor<uint16_t> halfL(TPosition::VECCALC, UB_QT_HALF, TILE / GROUP);

        __ubuf__ bfloat16_t* gateUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_QT_GATE);
        __ubuf__ bfloat16_t* upUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_QT_GATE + TILE * 2);
        __ubuf__ bfloat16_t* swigluUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_QT_SWIGLU);
        __ubuf__ int8_t* qxUb = reinterpret_cast<__ubuf__ int8_t*>(UB_QT_QX);
        __ubuf__ uint16_t* scaleUb = reinterpret_cast<__ubuf__ uint16_t*>(UB_QT_SCALE);
        __ubuf__ uint16_t* halfUb = reinterpret_cast<__ubuf__ uint16_t*>(UB_QT_HALF);

        // ---- MTE2：GM → UB ----
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0);
        PipeBarrier<PIPE_MTE2>();   // 小改 B：tile 循环同 pipe 复用同一 UB tile
        DataCopy(gateL, srcGm[xOff], Block1(TILE * 2));
        if constexpr (SWIGLU) {
            DataCopy(upL, srcGm[xOff + K], Block1(TILE * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0);

        // ---- V：SwiGLU（可选）→ MxQuant scale → MxQuant data（原地接力）----
        BufAcquire<PIPE_V>(BUF_AIV_ROW0);
        BufAcquire<PIPE_V>(BUF_AIV_OUT);
        if constexpr (SWIGLU) {
            SwigluComputeTile(gateUb, upUb, swigluUb);
            MxQuantComputeScale(swigluUb, scaleUb, halfUb);
            MxQuantComputeDataFP4(swigluUb, halfUb, qxUb);
        } else {
            MxQuantComputeScale(gateUb, scaleUb, halfUb);
            MxQuantComputeDataFP4(gateUb, halfUb, qxUb);
        }
        BufRelease<PIPE_V>(BUF_AIV_ROW0);
        BufRelease<PIPE_V>(BUF_AIV_OUT);

        // ---- MTE3：UB → GM ----
        BufAcquire<PIPE_MTE3>(BUF_AIV_OUT);
        if constexpr (SWIGLU) {
            DataCopy(swigluGm[hOff], swigluL, Block1(TILE * 2));
        }
        DataCopy(qxGm[qxOff], qxL, Block1(TILE / 2));   // int8：TILE/2 字节 = 4 个 32B 块
        DataCopyPad<uint16_t, PaddingMode::Compact>(scaleGm[sOff], scaleL, ExtBlock1(TILE / GROUP));
        BufRelease<PIPE_MTE3>(BUF_AIV_OUT);
    }

    // SwiGLU 五元组（donor VFSwiGlu；m5 逐字 lift）：silu(g) = g/(1+exp(-g))，y = silu(gate)*up
    __aicore__ inline void SwigluComputeTile(__ubuf__ bfloat16_t* gateUb, __ubuf__ bfloat16_t* upUb,
                                             __ubuf__ bfloat16_t* swigluUb)
    {
        constexpr uint32_t VL = 64;
        constexpr uint16_t LOOP = TILE / VL;
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> tg;
            RegTensor<bfloat16_t> tu;
            RegTensor<bfloat16_t> ty;
            RegTensor<float> g;
            RegTensor<float> u;
            RegTensor<float> y;
            RegTensor<float> v;
            uint32_t vl = VL;
            MaskReg dataMask = UpdateMask<float>(vl);
            for (uint16_t j = 0; j < LOOP; ++j) {
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tg, gateUb + j * VL);
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(tu, upUb + j * VL);
                Cast<float, bfloat16_t, castTraitB162B32>(g, tg, dataMask);
                Cast<float, bfloat16_t, castTraitB162B32>(u, tu, dataMask);
                Muls(v, g, -1.0f, dataMask);
                Exp(v, v, dataMask);
                Adds(v, v, 1.0f, dataMask);
                Div(v, g, v, dataMask);
                Mul(y, v, u, dataMask);
                Cast<bfloat16_t, float, castTraitB322B16>(ty, y, dataMask);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(swigluUb + j * VL, ty, dataMask);
            }
        }
    }

    // 以下两段为 m2_mxfp4_quant → m5 的 MxQuantComputeScale / MxQuantComputeDataFP4 逐字移植
    // ±Inf/NaN 平价修复（与 main 的 m5/m13 同源；依据为官方 `add_rms_norm_dynamic_mx_quant_common.h`
    // 的 `NAN_CUSTOMIZATION` 覆盖路径，行号随上游变动、以符号为准）：
    // 组内出现非有限值时把 halfScale 覆盖成 NAN_CUSTOMIZATION(0x7f81 = bf16 NaN)，
    // 使后续 Mul(±Inf, NaN)=NaN → Cast<fp4> = 0.0；否则 Mul(±Inf, 2^-126)=±Inf → Cast 饱和成 ±6。
    __aicore__ inline void MxQuantComputeScale(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* mxScaleLocalAddr,
                                               __ubuf__ uint16_t* halfScaleLocalAddr)
    {
        constexpr uint32_t groups = TILE / GROUP;
        constexpr uint16_t MAX_EXP_FOR_BF16 = 0x7f80;
        constexpr uint16_t MAX_EXP_FOR_FP8 = 0x00ff;
        constexpr uint16_t NAN_CUSTOMIZATION = 0x7f81;
        constexpr int16_t SHR_NUM_FOR_BF16 = 7;
        constexpr uint16_t BF16_EXP_BIAS = 0x7f00;
        constexpr uint16_t FP4_E2M1_BF16_MAX_EXP = 0x0100;
        constexpr uint32_t VL_B16 = 128;
        constexpr int64_t DIGIT_TWO = 2;
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<uint16_t> vdExpExtract0;
            RegTensor<uint16_t> vdExpExtract1;
            RegTensor<uint16_t> expMaskBF16;
            Duplicate(expMaskBF16, MAX_EXP_FOR_BF16);
            RegTensor<uint16_t> vdMaxExp;
            MaskReg Mask = CreateMask<uint16_t, MaskPattern::ALL>();
            MaskReg cmpResult;
            MaskReg zeroMask;
            MaskReg preMaskScale;
            RegTensor<uint16_t> maxExpValue;
            Duplicate(maxExpValue, FP4_E2M1_BF16_MAX_EXP);
            RegTensor<uint16_t> sharedExp;
            RegTensor<uint16_t> scaleValue;
            RegTensor<uint16_t> scaleBias;
            Duplicate(scaleBias, BF16_EXP_BIAS);
            RegTensor<uint16_t> halfScale;
            RegTensor<uint16_t> fp8NanRegTensor;
            Duplicate(fp8NanRegTensor, MAX_EXP_FOR_FP8);
            RegTensor<uint16_t> nanRegTensor;
            Duplicate(nanRegTensor, NAN_CUSTOMIZATION);
            RegTensor<uint16_t> zeroRegTensor;
            Duplicate(zeroRegTensor, 0);

            uint32_t nGroups = groups;
            preMaskScale = UpdateMask<uint16_t>(nGroups);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            And(vdExpExtract0, (RegTensor<uint16_t>&)vdExp0, expMaskBF16, Mask);
            And(vdExpExtract1, (RegTensor<uint16_t>&)vdExp1, expMaskBF16, Mask);
            Max(vdMaxExp, vdExpExtract0, vdExpExtract1, Mask);
            ReduceDataBlock<AscendC::Reg::ReduceType::MAX>(vdMaxExp, vdMaxExp, Mask);

            Compare<uint16_t, CMPMODE::NE>(cmpResult, vdMaxExp, expMaskBF16, preMaskScale);
            Compare<uint16_t, CMPMODE::LE>(zeroMask, vdMaxExp, maxExpValue, preMaskScale);
            Select<uint16_t>(vdMaxExp, maxExpValue, vdMaxExp, zeroMask);
            Sub(sharedExp, vdMaxExp, maxExpValue, preMaskScale);
            ShiftRights(scaleValue, sharedExp, SHR_NUM_FOR_BF16, preMaskScale);
            Select<uint16_t>(scaleValue, scaleValue, fp8NanRegTensor, cmpResult);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK_B16>(
                mxScaleLocalAddr, scaleValue, nGroups / 2, preMaskScale);
            Compare<uint16_t, CMPMODE::NE>(zeroMask, sharedExp, zeroRegTensor, preMaskScale);
            Sub(halfScale, scaleBias, sharedExp, preMaskScale);
            // 官方 `add_rms_norm_dynamic_mx_quant_common.h` 的 `NAN_CUSTOMIZATION` 覆盖路径同源
            // （行号随上游变动、以符号为准）：组内非有限（±Inf/NaN）时复用上面
            // `Compare(cmpResult, vdMaxExp, expMaskBF16)` 得到的 `cmpResult`
            // （vdMaxExp != expMask）把 halfScale 覆盖成 NaN
            Select<uint16_t>(halfScale, halfScale, nanRegTensor, cmpResult);
            Select<uint16_t>(halfScale, halfScale, zeroRegTensor, zeroMask);
            StoreAlign<uint16_t, PostLiteral::POST_MODE_UPDATE>(halfScaleLocalAddr, halfScale, nGroups, preMaskScale);
        }
    }

    __aicore__ inline void MxQuantComputeDataFP4(__ubuf__ bfloat16_t* srcAddr, __ubuf__ uint16_t* halfScaleLocalAddr,
                                                 __ubuf__ int8_t* outLocalAddr)
    {
        constexpr uint32_t VL_B16 = 128;
        constexpr int64_t DIGIT_TWO = 2;
        __VEC_SCOPE__
        {
            MaskReg dataMask1;
            RegTensor<uint16_t> halfScaleForMul;
            RegTensor<bfloat16_t> vdExp0;
            RegTensor<bfloat16_t> vdExp1;
            RegTensor<fp4x2_e2m1_t> vdExp0FP4;
            RegTensor<fp4x2_e2m1_t> vdExp1FP4;
            uint32_t totalCount = TILE;
            dataMask1 = UpdateMask<bfloat16_t>(totalCount);
            LoadAlign<bfloat16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_DINTLV_B16>(
                vdExp0, vdExp1, srcAddr, VL_B16 * DIGIT_TWO);
            LoadAlign<uint16_t, PostLiteral::POST_MODE_UPDATE, LoadDist::DIST_E2B_B16>(
                halfScaleForMul, halfScaleLocalAddr, TILE / GROUP);
            Mul(vdExp0, vdExp0, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Mul(vdExp1, vdExp1, (RegTensor<bfloat16_t>&)halfScaleForMul, dataMask1);
            Interleave(vdExp0, vdExp1, vdExp0, vdExp1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp0FP4, vdExp0, dataMask1);
            Cast<fp4x2_e2m1_t, bfloat16_t, castTraitRM_Round>(vdExp1FP4, vdExp1, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp0FP4, 64, dataMask1);
            StoreAlign<int8_t, PostLiteral::POST_MODE_UPDATE, StoreDist::DIST_PACK4_B32>(
                outLocalAddr, (RegTensor<int8_t>&)vdExp1FP4, 64, dataMask1);
        }
    }

private:
    uint32_t M = 0;
    uint32_t TOPK = 1;
    AscendC::GlobalTensor<bfloat16_t> srcGm;
    AscendC::GlobalTensor<bfloat16_t> swigluGm;
    AscendC::GlobalTensor<int8_t> qxGm;
    AscendC::GlobalTensor<uint16_t> scaleGm;
    AscendC::GlobalTensor<int32_t> countsGm;
};

}  // namespace
// ============================================================
// S9a：unpermute 加权折叠（m8_permute kernel #2 移植；topK 模板实例化 1..TOPK_MAX）
//   routed_out[t] = bf16( Σ_k fp32(bf16 w[t,k]) * fp32(y_sorted[inv[t,k]]) )
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M17;

constexpr uint32_t U_STAGES = 2;
constexpr uint32_t WROW_I32 = 16;     // 权重行 int32 槽位数（64B，DataCopy 32B 对齐）
constexpr uint32_t UB_U_OUT = TOPK_MAX * HIDDEN * 2;
constexpr uint32_t UB_U_WROW = UB_U_OUT + HIDDEN * 2;
// TOPK_MAX = 10 → y 行缓冲 10×HIDDEN bf16 = 51200B；w_tk 行槽 WROW_I32=16 个 int32 装得下
// 10 个 bf16 权重（一个权重一个 int32 槽：bf16 位模式放低 16 位；只用前 TOPK_MAX 个，其余清零；
// 见 IndexGenStage 的 w_tk_packed）
static_assert(WROW_I32 >= TOPK_MAX, "w_tk_packed 行槽位不足以装下 TOPK_MAX 个 bf16");
static_assert(UB_UP_STAGE1 + U_STAGE_B <= UB_BYTES_TOTAL, "unpermute 双 stage 超出 UB");

template <uint32_t TK>
__aicore__ inline void FmaChunk(RegTensor<float>& acc, RegTensor<float>& yF, RegTensor<bfloat16_t>& yB16,
                                RegTensor<int32_t>& wRaw, RegTensor<float>& wF, __ubuf__ bfloat16_t* yUb,
                                __ubuf__ int32_t* wRowUb, MaskReg& maskAll, uint32_t off)
{
    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(yB16, yUb + TK * HIDDEN + off);
    Cast<float, bfloat16_t, castTraitB162B32>(yF, yB16, maskAll);
    LoadAlign<int32_t, LoadDist::DIST_BRC_B32>(wRaw, wRowUb + TK);
    ShiftLefts((RegTensor<uint32_t>&)wF, (RegTensor<uint32_t>&)wRaw, static_cast<int16_t>(16), maskAll);
    Mul(yF, yF, wF, maskAll);
    Add(acc, acc, yF, maskAll);
}

template <uint32_t TK>
class UnpermuteStage {
public:
    __aicore__ inline UnpermuteStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* ySorted, __gm__ uint8_t* invSlot, __gm__ uint8_t* wtk,
                                __gm__ uint8_t* out, uint32_t m)
    {
        M = m;
        // Y 是 [slot][M_MAX][HIDDEN] 的 padding 布局（slot ∈ [0, NUM_EXPERTS)），
        // inv_slot 里存的就是这个展开后的行号 —— m13 写 M_MAX*TOPK_MAX 是 E=4 时的巧合
        // （4*64 = 4*64），E=512 时必须按 NUM_EXPERTS*M_MAX 声明视图尺寸
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ySorted),
                            static_cast<uint64_t>(NUM_EXPERTS) * M_MAX * HIDDEN);
        slotGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(invSlot), static_cast<uint64_t>(M_MAX) * TOPK_MAX);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(wtk), static_cast<uint64_t>(M_MAX) * WROW_I32);
        outGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(out), static_cast<uint64_t>(M_MAX) * HIDDEN);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        const uint32_t myRows = (M > bid) ? (M - bid - 1) / nAiv + 1 : 0;
        for (uint32_t r = 0; r < myRows; ++r) {
            const uint32_t t = bid + r * nAiv;
            const uint32_t stage = r % U_STAGES;
            CopyIn(t, stage);
            ComputeRow(stage);
            CopyOut(t, stage);
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t t, uint32_t stage)
    {
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_UP_STAGE0 + stage * U_STAGE_B, TOPK_MAX * HIDDEN);
        LocalTensor<int32_t> wL(TPosition::VECCALC, UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_WROW, WROW_I32);
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0 + stage);
        PipeBarrier<PIPE_MTE2>();   // 小改 B
        DataCopy(wL, wGm[static_cast<uint64_t>(t) * WROW_I32], Block1(WROW_I32 * 4));
        for (uint32_t k = 0; k < TK; ++k) {
            const int32_t slot = slotGm.GetValue(static_cast<uint64_t>(t) * TK + k);   // 标量 GM 读→地址
            DataCopy(yL[k * HIDDEN], yGm[static_cast<uint64_t>(slot) * HIDDEN], Block1(HIDDEN * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0 + stage);
    }

    __aicore__ inline void ComputeRow(uint32_t stage)
    {
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_UP_STAGE0 + stage * U_STAGE_B);
        __ubuf__ bfloat16_t* outUb =
            reinterpret_cast<__ubuf__ bfloat16_t*>(UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_OUT);
        __ubuf__ int32_t* wRowUb =
            reinterpret_cast<__ubuf__ int32_t*>(UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_WROW);

        BufAcquire<PIPE_V>(BUF_AIV_ROW0 + stage);
        __VEC_SCOPE__
        {
            RegTensor<float> acc;
            RegTensor<float> yF;
            RegTensor<float> wF;
            RegTensor<int32_t> wRaw;
            RegTensor<bfloat16_t> yB16;
            RegTensor<bfloat16_t> outB16;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t c = 0; c < CHUNKS_H; ++c) {
                const uint32_t off = static_cast<uint32_t>(c) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(yB16, yUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(yF, yB16, maskAll);
                LoadAlign<int32_t, LoadDist::DIST_BRC_B32>(wRaw, wRowUb);
                ShiftLefts((RegTensor<uint32_t>&)wF, (RegTensor<uint32_t>&)wRaw, static_cast<int16_t>(16), maskAll);
                Mul(acc, yF, wF, maskAll);   // k = 0 直写 acc
                if constexpr (TK > 1) FmaChunk<1>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 2) FmaChunk<2>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 3) FmaChunk<3>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                // TOPK_MAX = 10（真实模型 top-10）→ k 链展开到 9
                if constexpr (TK > 4) FmaChunk<4>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 5) FmaChunk<5>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 6) FmaChunk<6>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 7) FmaChunk<7>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 8) FmaChunk<8>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 9) FmaChunk<9>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                Cast<bfloat16_t, float, castTraitB322B16>(outB16, acc, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(outUb + off, outB16, maskAll);
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_ROW0 + stage);
    }

    __aicore__ inline void CopyOut(uint32_t t, uint32_t stage)
    {
        LocalTensor<bfloat16_t> outL(TPosition::VECCALC, UB_UP_STAGE0 + stage * U_STAGE_B + UB_U_OUT, HIDDEN);
        BufAcquire<PIPE_MTE3>(BUF_AIV_ROW0 + stage);
        DataCopy(outGm[static_cast<uint64_t>(t) * HIDDEN], outL, Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE3>(BUF_AIV_ROW0 + stage);
    }

private:
    uint32_t M = 0;
    AscendC::GlobalTensor<bfloat16_t> yGm;
    AscendC::GlobalTensor<int32_t> slotGm;
    AscendC::GlobalTensor<int32_t> wGm;
    AscendC::GlobalTensor<bfloat16_t> outGm;
};

// ============================================================
// S9b：combine（shared_out = sigmoid(sgate)·shared_mlp；moe_out = routed + shared_out）
//   sgate 的 sigmoid 在这里用向量做（S2 只出裸点积，避免 AIV 内标量浮点）
// ============================================================

class CombineStage {
public:
    __aicore__ inline CombineStage() {}

    __aicore__ inline void Init(__gm__ uint8_t* routed, __gm__ uint8_t* shdMlp, __gm__ uint8_t* sgate,
                                __gm__ uint8_t* sharedOut, __gm__ uint8_t* moeOut, uint32_t m)
    {
        M = m;
        routedGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(routed), static_cast<uint64_t>(M_MAX) * HIDDEN);
        shdGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(shdMlp), static_cast<uint64_t>(M_MAX) * HIDDEN);
        sgateGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(sgate), M_MAX);
        sharedGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(sharedOut), static_cast<uint64_t>(M_MAX) * HIDDEN);
        moeGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(moeOut), static_cast<uint64_t>(M_MAX) * HIDDEN);
    }

    __aicore__ inline void Run(uint32_t bid, uint32_t nAiv)
    {
        for (uint32_t t = bid; t < M; t += nAiv) {
            CopyInRow(t);
            ComputeRow();
            CopyOutRow(t);
        }
    }

private:
    __aicore__ inline void CopyInRow(uint32_t t)
    {
        LocalTensor<bfloat16_t> rtL(TPosition::VECCALC, UB_CB_ROUTED, HIDDEN);
        LocalTensor<bfloat16_t> shL(TPosition::VECCALC, UB_CB_SHARED, HIDDEN);
        LocalTensor<float> sgL(TPosition::VECCALC, UB_CB_G, 64);
        const uint64_t off = static_cast<uint64_t>(t) * HIDDEN;
        // 整行（MTE2 写 → V 就地改 → MTE3 读）必须共用一个 BufferID：
        // 否则下一行的 MTE2 会抢在 MTE3 读之前覆盖 UB_CB_ROUTED/SHARED
        BufAcquire<PIPE_MTE2>(BUF_AIV_ROW0);
        PipeBarrier<PIPE_MTE2>();   // 小改 B
        DataCopy(rtL, routedGm[off], Block1(HIDDEN * 2));
        DataCopy(shL, shdGm[off], Block1(HIDDEN * 2));
        // 单值 4B / 非 32B 对齐地址：必须走 DataCopyPad（非原子 DataCopy 会报地址未对齐）
        DataCopyPad(sgL, sgateGm[t], ExtBlock1(4), DataCopyPadExtParams<float>{false, 0, 0, 0});
        BufRelease<PIPE_MTE2>(BUF_AIV_ROW0);
    }

    __aicore__ inline void ComputeRow()
    {
        __ubuf__ bfloat16_t* rtUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_CB_ROUTED);
        __ubuf__ bfloat16_t* shUb = reinterpret_cast<__ubuf__ bfloat16_t*>(UB_CB_SHARED);
        __ubuf__ float* sgUb = reinterpret_cast<__ubuf__ float*>(UB_CB_G);

        BufAcquire<PIPE_V>(BUF_AIV_ROW0);   // 与 MTE2 写、MTE3 读共用同一 token
        __VEC_SCOPE__
        {
            RegTensor<float> g;
            RegTensor<float> one;
            RegTensor<float> shF;
            RegTensor<float> rtF;
            RegTensor<bfloat16_t> shB;
            RegTensor<bfloat16_t> rtB;
            RegTensor<bfloat16_t> outB;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            Duplicate(one, 1.0f);
            LoadAlign<float, LoadDist::DIST_BRC_B32>(g, sgUb);   // 门裸点积广播
            Muls(g, g, -1.0f, maskAll);
            Exp(g, g, maskAll);
            Adds(g, g, 1.0f, maskAll);
            Div(g, one, g, maskAll);                             // sigmoid = 1/(1+exp(-x))
            for (uint16_t c = 0; c < CHUNKS_H; ++c) {
                const uint32_t off = static_cast<uint32_t>(c) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(shB, shUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(shF, shB, maskAll);
                Mul(shF, shF, g, maskAll);
                Cast<bfloat16_t, float, castTraitB322B16>(outB, shF, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(shUb + off, outB, maskAll);  // 原地写回
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(rtB, rtUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(rtF, rtB, maskAll);
                Add(shF, shF, rtF, maskAll);
                Cast<bfloat16_t, float, castTraitB322B16>(outB, shF, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(rtUb + off, outB, maskAll);  // 复用 routed 缓冲
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_ROW0);
    }

    __aicore__ inline void CopyOutRow(uint32_t t)
    {
        // shared 结果原地写在 UB_CB_SHARED，moe 结果写在 UB_CB_ROUTED
        LocalTensor<bfloat16_t> shL(TPosition::VECCALC, UB_CB_SHARED, HIDDEN);
        LocalTensor<bfloat16_t> moeL(TPosition::VECCALC, UB_CB_ROUTED, HIDDEN);
        const uint64_t off = static_cast<uint64_t>(t) * HIDDEN;
        BufAcquire<PIPE_MTE3>(BUF_AIV_ROW0);
        DataCopy(sharedGm[off], shL, Block1(HIDDEN * 2));
        DataCopy(moeGm[off], moeL, Block1(HIDDEN * 2));
        BufRelease<PIPE_MTE3>(BUF_AIV_ROW0);
    }

private:
    uint32_t M = 0;
    AscendC::GlobalTensor<bfloat16_t> routedGm;
    AscendC::GlobalTensor<bfloat16_t> shdGm;
    AscendC::GlobalTensor<float> sgateGm;
    AscendC::GlobalTensor<bfloat16_t> sharedGm;
    AscendC::GlobalTensor<bfloat16_t> moeGm;
};

}  // namespace
// ============================================================
// MoE layer kernel：段序编排 + 跨核同步（单一 __mix__(1,2) 启动）
// ============================================================

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M17;

// 段形状的编译期常量（gate_up: K=2560 N=1280；down: K=640 N=2560）
constexpr uint32_t GU_NBLK = GU_N / BASE_N;       // 5
constexpr uint32_t DN_NBLK = HIDDEN / BASE_N;     // 10
constexpr uint32_t NUM_SLOTS = NUM_EXPERTS + 1;   // routed 专家 + shared 专家
constexpr uint32_t GU_ITEMS = NUM_SLOTS * GU_NBLK;
constexpr uint32_t DN_ITEMS = NUM_SLOTS * DN_NBLK;

struct MoeLayerPtrs {
    __gm__ uint8_t* ws;
    __gm__ uint8_t* xLayer;     // 层输入激活 [M_MAX, HIDDEN] bf16
    __gm__ uint8_t* resZero;    // 全 0 残差（S1 的残差入口）
    __gm__ uint8_t* gamma1;
    __gm__ uint8_t* gamma2;
    __gm__ uint8_t* routerW;
    __gm__ uint8_t* sgateW;
    __gm__ uint8_t* wGu;
    __gm__ uint8_t* sGu;
    __gm__ uint8_t* wDn;
    __gm__ uint8_t* sDn;
    __gm__ uint8_t* wGuShd;
    __gm__ uint8_t* sGuShd;
    __gm__ uint8_t* wDnShd;
    __gm__ uint8_t* sDnShd;
    uint32_t m;
    uint32_t topk;
    uint32_t sliceMode;   // 0 = MoE slice 直接消费 golden x（逐 op 对齐 golden）
                          // 1 = 全层链（router 消费 S1 的 x_norm）
    uint32_t stageLimit;  // 段序截断（bring-up 定位用；8 = 全链）
    uint32_t subLimit;    // S2/S3 段内截断（bring-up 定位用；9 = 全开）
};

class MoeLayerChain {
public:
    __aicore__ inline MoeLayerChain() {}

    __aicore__ inline void Init(const MoeLayerPtrs& args)
    {
        p = args;
        ws = args.ws;

        // S1 m6#1：x = 层输入，res = 0，gamma1
        norm1.Init(args.xLayer, args.resZero, ws + WS_XNORM, ws + WS_RES1, UB_GAMMA1_F32, args.m);
        // S10 m6#2：x = moe_out，res = S1 的 fp32 resOut（小改 D），gamma2
        norm2.Init(ws + WS_MOE, ws + WS_RES1, ws + WS_YFINAL, ws + WS_RES2, UB_GAMMA2_F32, args.m);

        __gm__ uint8_t* sliceSrc = args.sliceMode ? (ws + WS_XNORM) : args.xLayer;

        // S2/S3（AIV0）
        router.Init(sliceSrc, args.routerW, args.sgateW, ws + WS_LOGITS, ws + WS_IDS, ws + WS_W, ws + WS_SGATE,
                    args.m, args.topk);
        idxGen.Init(ws + WS_IDS, ws + WS_W, ws + WS_COUNTS, ws + WS_OFFSETS, ws + WS_PERM_SRC, ws + WS_PERM_EXP,
                    ws + WS_INV, ws + WS_WTK, args.m, args.topk);
        // S4 permute
        perm.Init(sliceSrc, ws + WS_PERM_SRC, ws + WS_COUNTS, ws + WS_XSORT, NUM_EXPERTS, args.m, args.topk);
        // S5 A 侧量化（routed + shared）
        quantA.Init(ws + WS_XSORT, nullptr, ws + WS_AQ, ws + WS_AS, ws + WS_COUNTS, args.m, args.topk);
        quantAShd.Init(sliceSrc, nullptr, ws + WS_AQ_SHD, ws + WS_AS_SHD, ws + WS_COUNTS, args.m, args.topk);
        // S7 SwiGLU + 量化（routed + shared）
        quantH.Init(ws + WS_GU, ws + WS_H, ws + WS_HQ, ws + WS_HS, ws + WS_COUNTS, args.m, args.topk);
        quantHShd.Init(ws + WS_GU_SHD, ws + WS_H_SHD, ws + WS_HQ_SHD, ws + WS_HS_SHD, ws + WS_COUNTS, args.m,
                       args.topk);
        // S8/S9
        PrepareUnpermute(args);
    }

    // ---- AIV 侧 ----
    __aicore__ inline void ProcessAiv()
    {
        const uint32_t bid = AscendC::GetBlockIdx();          // 0 .. 2*numBlocks-1
        const uint32_t nAiv = AscendC::GetBlockNum() * 2;
        const bool isPrimary = (bid == 0);

        // gamma bf16 → fp32 预转（每核一次）
        PrecastGammaF32(p.gamma1, UB_GAMMA1_F32);
        PrecastGammaF32(p.gamma2, UB_GAMMA2_F32);

        // ---------- S1：m6#1 ----------
        if (p.stageLimit >= 1) {
            norm1.Run(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(0);   // 等 x_norm/res1 全体就位
        }

        // ---------- S2/S3：router + 索引生成（AIV0）----------
        if (p.stageLimit >= 2) {
            if (isPrimary) {
                router.Run(p.subLimit);
                if (p.subLimit >= 6) {
                    idxGen.Run(p.subLimit);
                }
            }
            BarrierAiv<PIPE_S>(1);      // perm_src/counts 的标量 GM 读需要 PIPE_S 值依赖
        }

        // ---------- S4：permute ----------
        if (p.stageLimit >= 3) {
            perm.Run(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(2);
        }

        // ---------- S5：A 侧 MXFP4 全 VEC 量化 ----------
        if (p.stageLimit >= 4) {
            quantA.Run(bid, nAiv);
            quantAShd.Run(bid, nAiv);
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE3>(FLAG_M2_RING[0]);   // A 就绪 → 配对 AIC
        }

        // ---------- S7：SwiGLU + MXFP4 量化（等 GU）----------
        if (p.stageLimit >= 5) {
            CrossCoreWaitFlag<CC_MODE2, PIPE_MTE2>(FLAG_M2_RING[1]);
            quantH.Run(bid, nAiv);
            quantHShd.Run(bid, nAiv);
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE3>(FLAG_M2_RING[2]);   // H 就绪 → 配对 AIC
        }

        // ---------- S9a：unpermute 加权折叠（等 Y）----------
        if (p.stageLimit >= 6) {
            CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_M2_RING[3]);     // inv_slot/w_tk 标量读
            RunUnpermute(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(3);
        }

        // ---------- S9b：combine ----------
        if (p.stageLimit >= 7) {
            combine.Run(bid, nAiv);
            BarrierAiv<PIPE_MTE2>(0);
        }

        // ---------- S10：m6#2 ----------
        if (p.stageLimit >= 8) {
            norm2.Run(bid, nAiv);
        }
    }

    // ---- AIC 侧 ----
    __aicore__ inline void ProcessAic()
    {
        const uint32_t bid = AscendC::GetBlockIdx();          // 0 .. numBlocks-1
        const uint32_t numBlocks = AscendC::GetBlockNum();
        AscendC::GlobalTensor<uint32_t> countsGm;
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(ws + WS_COUNTS), NUM_EXPERTS);

        if (p.stageLimit < 5) {
            return;
        }
        // ---------- 等 S5 的 A 就绪 ----------
        CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_M2_RING[0]);
        CrossCoreSetFlag<CC_MODE0, PIPE_MTE2>(FLAG_AIC_SEG_RING[0]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[0]);

        // ---------- S6：grouped gate_up GEMM（槽位 = 4 routed + 1 shared）----------
        for (uint32_t item = bid; item < GU_ITEMS; item += numBlocks) {
            const uint32_t slot = item / GU_NBLK;
            const uint32_t nb = item % GU_NBLK;
            const bool shd = (slot == NUM_EXPERTS);
            const uint32_t t = shd ? p.m : countsGm.GetValue(slot);
            if (t == 0) {
                continue;   // 空槽位：A 区未被量化器写、curM=0 无需计算
            }
            gemmGu.SetItem(shd ? (ws + WS_AQ_SHD) : (ws + WS_AQ + slot * M_MAX * (HIDDEN / 2)),
                           shd ? (ws + WS_AS_SHD) : (ws + WS_AS + slot * M_MAX * GU_SCALE_STRIDE),
                           shd ? p.wGuShd : (p.wGu + slot * GU_N * (HIDDEN / 2)),
                           shd ? p.sGuShd : (p.sGu + slot * GU_N * GU_SCALE_STRIDE),
                           shd ? (ws + WS_GU_SHD) : (ws + WS_GU + slot * M_MAX * GU_N * 2));
            gemmGu.Run(nb, t);
        }
        CrossCoreSetFlag<CC_MODE0, PIPE_FIX>(FLAG_AIC_SEG_RING[1]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[1]);
        CrossCoreSetFlag<CC_MODE2, PIPE_MTE2>(FLAG_M2_RING[1]);   // GU 就绪 → 配对 AIV

        if (p.stageLimit < 6) {
            return;
        }
        // ---------- 等 S7 的 H 就绪 ----------
        CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_M2_RING[2]);
        CrossCoreSetFlag<CC_MODE0, PIPE_MTE2>(FLAG_AIC_SEG_RING[2]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[2]);

        // ---------- S8：grouped down GEMM ----------
        for (uint32_t item = bid; item < DN_ITEMS; item += numBlocks) {
            const uint32_t slot = item / DN_NBLK;
            const uint32_t nb = item % DN_NBLK;
            const bool shd = (slot == NUM_EXPERTS);
            const uint32_t t = shd ? p.m : countsGm.GetValue(slot);
            if (t == 0) {
                continue;
            }
            gemmDn.SetItem(shd ? (ws + WS_HQ_SHD) : (ws + WS_HQ + slot * M_MAX * (INTER / 2)),
                           shd ? (ws + WS_HS_SHD) : (ws + WS_HS + slot * M_MAX * DN_SCALE_STRIDE),
                           shd ? p.wDnShd : (p.wDn + slot * HIDDEN * (INTER / 2)),
                           shd ? p.sDnShd : (p.sDn + slot * HIDDEN * (INTER / GROUP)),
                           shd ? (ws + WS_Y_SHD) : (ws + WS_Y + slot * M_MAX * HIDDEN * 2));
            gemmDn.Run(nb, t);
        }
        CrossCoreSetFlag<CC_MODE0, PIPE_FIX>(FLAG_AIC_SEG_RING[3]);
        CrossCoreWaitFlag<CC_MODE0, PIPE_S>(FLAG_AIC_SEG_RING[3]);
        CrossCoreSetFlag<CC_MODE2, PIPE_MTE2>(FLAG_M2_RING[3]);   // Y 就绪 → 配对 AIV
    }

private:
    // 全体 AIV mode 0 barrier（wait 挂窄 pipe；需标量值依赖的段用 PIPE_S）
    template <pipe_t WAIT_PIPE>
    __aicore__ inline void BarrierAiv(uint32_t slot)
    {
        CrossCoreSetFlag<CC_MODE0, PIPE_MTE3>(FLAG_AIV_SEG_RING[slot]);
        CrossCoreWaitFlag<CC_MODE0, WAIT_PIPE>(FLAG_AIV_SEG_RING[slot]);
    }

    // topK 运行时 → 模板分发（m8#2 同款：k 链全展开，下标皆编译期）
    // 真实模型 topk = 10 → 1..10 全部实例化（m13 只到 4）
    __aicore__ inline void RunUnpermute(uint32_t bid, uint32_t nAiv)
    {
        switch (p.topk) {
            case 1: unperm1.Run(bid, nAiv); break;
            case 2: unperm2.Run(bid, nAiv); break;
            case 3: unperm3.Run(bid, nAiv); break;
            case 4: unperm4.Run(bid, nAiv); break;
            case 5: unperm5.Run(bid, nAiv); break;
            case 6: unperm6.Run(bid, nAiv); break;
            case 7: unperm7.Run(bid, nAiv); break;
            case 8: unperm8.Run(bid, nAiv); break;
            case 9: unperm9.Run(bid, nAiv); break;
            default: unperm10.Run(bid, nAiv); break;
        }
    }

public:
    // Init 中把 topK 分发到模板实例（避免 Init 里做 switch）
    __aicore__ inline void PrepareUnpermute(const MoeLayerPtrs& args)
    {
        unperm1.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm2.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm3.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm4.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm5.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm6.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm7.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm8.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm9.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        unperm10.Init(ws + WS_Y, ws + WS_INV, ws + WS_WTK, ws + WS_ROUTED, args.m);
        combine.Init(ws + WS_ROUTED, ws + WS_Y_SHD, ws + WS_SGATE, ws + WS_SHARED, ws + WS_MOE, args.m);
    }

private:
    MoeLayerPtrs p;
    __gm__ uint8_t* ws = nullptr;

    NormStage<false> norm1;      // 残差 bf16（全 0）
    NormStage<true> norm2;       // 残差 fp32（小改 D）
    RouterStage router;
    IndexGenStage idxGen;
    PermuteStage perm;
    VecQuantStage<HIDDEN, GU_SCALE_STRIDE, false, false, true> quantA;
    VecQuantStage<HIDDEN, GU_SCALE_STRIDE, false, false, false> quantAShd;
    VecQuantStage<INTER, DN_SCALE_STRIDE, true, true, true> quantH;
    VecQuantStage<INTER, DN_SCALE_STRIDE, true, false, false> quantHShd;
    UnpermuteStage<1> unperm1;
    UnpermuteStage<2> unperm2;
    UnpermuteStage<3> unperm3;
    UnpermuteStage<4> unperm4;
    UnpermuteStage<5> unperm5;
    UnpermuteStage<6> unperm6;
    UnpermuteStage<7> unperm7;
    UnpermuteStage<8> unperm8;
    UnpermuteStage<9> unperm9;
    UnpermuteStage<10> unperm10;
    CombineStage combine;
    MXFP4GemmItem<HIDDEN, GU_N, GU_SCALE_STRIDE> gemmGu;
    MXFP4GemmItem<INTER, HIDDEN, DN_SCALE_STRIDE> gemmDn;
};

}  // namespace

__global__ __mix__(1, 2) void m17_moe_layer_kernel(
    __gm__ uint8_t* ws, __gm__ uint8_t* xLayer, __gm__ uint8_t* resZero, __gm__ uint8_t* gamma1,
    __gm__ uint8_t* gamma2, __gm__ uint8_t* routerW, __gm__ uint8_t* sgateW, __gm__ uint8_t* wGu, __gm__ uint8_t* sGu,
    __gm__ uint8_t* wDn, __gm__ uint8_t* sDn, __gm__ uint8_t* wGuShd, __gm__ uint8_t* sGuShd, __gm__ uint8_t* wDnShd,
    __gm__ uint8_t* sDnShd, uint32_t m, uint32_t topk, uint32_t sliceMode, uint32_t stageLimit, uint32_t subLimit)
{
    AscendC::InitSocState();
    MoeLayerPtrs args;
    args.ws = ws;
    args.xLayer = xLayer;
    args.resZero = resZero;
    args.gamma1 = gamma1;
    args.gamma2 = gamma2;
    args.routerW = routerW;
    args.sgateW = sgateW;
    args.wGu = wGu;
    args.sGu = sGu;
    args.wDn = wDn;
    args.sDn = sDn;
    args.wGuShd = wGuShd;
    args.sGuShd = sGuShd;
    args.wDnShd = wDnShd;
    args.sDnShd = sDnShd;
    args.m = m;
    args.topk = topk;
    args.sliceMode = sliceMode;
    args.stageLimit = stageLimit;
    args.subLimit = subLimit;

    MoeLayerChain op;
    op.Init(args);
    op.PrepareUnpermute(args);
    if ASCEND_IS_AIV {
        op.ProcessAiv();
    }
    if ASCEND_IS_AIC {
        op.ProcessAic();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// 探针 kernel：MXFP4 权重 nibble 解包自检（纯 cube，复用 MXFP4GemmItem）
//
//   取 A = [64, 2560] 的**单位阵** fp4 编码（e2m1 的 1.0 = code 0b0010，K 方向 lohi 打包，
//   scale 全 0x7f = 2^0），B = 真实 checkpoint 的 gate_up packed/scale 切片：
//       C[i][n] = Σ_k A[i][k]·dequant(B[n][k]) = dequant(B[n][i])   （i < 64）
//   累加是 fp32，除 k=i 外全是「0×值」的精确 0 → C 就是**设备侧按硬件 e2m1/e8m0 语义**
//   解出来的权重值（bf16 可精确表示）。host 把 C 落盘，check_ref.py 用 numpy 独立解包
//   同一段源字节并逐位比对 → 同时证明：
//     (1) 设备读到的 packed/scale 字节就是源切片字节；
//     (2) lo-hi nibble 打包顺序（byte 的低半 = K 偶数位）成立；
//     (3) e2m1 码字语义与 e8m0（2^(b-127)）scale 语义成立。
// ============================================================

constexpr uint32_t PROBE_M = 64;   // ≤ BASE_M（单 tile）

__global__ __cube__ void m17_weight_probe_kernel(__gm__ uint8_t* aPacked, __gm__ uint8_t* aScale,
                                                 __gm__ uint8_t* bPacked, __gm__ uint8_t* bScale,
                                                 __gm__ uint8_t* cOut)
{
    AscendC::InitSocState();
    MXFP4GemmItem<M17::HIDDEN, M17::GU_N, M17::GU_SCALE_STRIDE> item;
    item.SetItem(aPacked, aScale, bPacked, bScale, cOut);
    item.Run(0, PROBE_M);
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧：真实 checkpoint（manifest pread）→ device GM → kernel → 落盘/判据
//   * 权重字节**原样**搬运，不做任何离线转换；唯一 host 组板是共享专家的
//     gate/up 行拼接（checkpoint 是独立 gate_proj/up_proj → 拼成与 routed 的
//     merged gate_up_proj 同形态，权重字节不变）。
//   * 逐字节证据三条腿：(a) manifest 里 Python 独立算出的 sha256；(b) host pread 后
//     复算 sha256 + 与 (a) 比对；(c) device GM 整段 D2H 回来 memcmp + sha256。
//   * 数值判据（量化预算口径）在 check_ref.py（numpy 独立参考链）；host 只做
//     不变量自检（ids 范围/唯一、counts 与 perm 一致、perm 分组有序、x_sorted
//     gather 逐位、w_tk 打包、残差位一致）以免明显坏态跑到 Python 侧才暴露。
// ============================================================

#include <string>
#include <vector>
#include <map>
#include <cstdint>
#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <cmath>
#include <chrono>
#include <cstdarg>
#include <cerrno>
#include <algorithm>
#include <fcntl.h>
#include <unistd.h>
#include <sys/stat.h>

// ---------------- SHA-256（自检代替第三方库） ----------------
namespace {

inline uint32_t H_Ror(uint32_t x, uint32_t n) { return (x >> n) | (x << (32u - n)); }

const uint32_t H_K256[64] = {
    0x428a2f98u, 0x71374491u, 0xb5c0fbcfu, 0xe9b5dba5u, 0x3956c25bu, 0x59f111f1u, 0x923f82a4u, 0xab1c5ed5u,
    0xd807aa98u, 0x12835b01u, 0x243185beu, 0x550c7dc3u, 0x72be5d74u, 0x80deb1feu, 0x9bdc06a7u, 0xc19bf174u,
    0xe49b69c1u, 0xefbe4786u, 0x0fc19dc6u, 0x240ca1ccu, 0x2de92c6fu, 0x4a7484aau, 0x5cb0a9dcu, 0x76f988dau,
    0x983e5152u, 0xa831c66du, 0xb00327c8u, 0xbf597fc7u, 0xc6e00bf3u, 0xd5a79147u, 0x06ca6351u, 0x14292967u,
    0x27b70a85u, 0x2e1b2138u, 0x4d2c6dfcu, 0x53380d13u, 0x650a7354u, 0x766a0abbu, 0x81c2c92eu, 0x92722c85u,
    0xa2bfe8a1u, 0xa81a664bu, 0xc24b8b70u, 0xc76c51a3u, 0xd192e819u, 0xd6990624u, 0xf40e3585u, 0x106aa070u,
    0x19a4c116u, 0x1e376c08u, 0x2748774cu, 0x34b0bcb5u, 0x391c0cb3u, 0x4ed8aa4au, 0x5b9cca4fu, 0x682e6ff3u,
    0x748f82eeu, 0x78a5636fu, 0x84c87814u, 0x8cc70208u, 0x90befffau, 0xa4506cebu, 0xbef9a3f7u, 0xc67178f2u};

struct HSha256 {
    uint32_t h[8];
    uint64_t total;
    uint8_t buf[64];
    size_t n;

    void Init()
    {
        h[0] = 0x6a09e667u;
        h[1] = 0xbb67ae85u;
        h[2] = 0x3c6ef372u;
        h[3] = 0xa54ff53au;
        h[4] = 0x510e527fu;
        h[5] = 0x9b05688cu;
        h[6] = 0x1f83d9abu;
        h[7] = 0x5be0cd19u;
        total = 0;
        n = 0;
    }

    void Block(const uint8_t* p)
    {
        uint32_t w[64];
        for (uint32_t i = 0; i < 16; ++i) {
            w[i] = (static_cast<uint32_t>(p[i * 4]) << 24) | (static_cast<uint32_t>(p[i * 4 + 1]) << 16) |
                   (static_cast<uint32_t>(p[i * 4 + 2]) << 8) | static_cast<uint32_t>(p[i * 4 + 3]);
        }
        for (uint32_t i = 16; i < 64; ++i) {
            const uint32_t s0 = H_Ror(w[i - 15], 7) ^ H_Ror(w[i - 15], 18) ^ (w[i - 15] >> 3);
            const uint32_t s1 = H_Ror(w[i - 2], 17) ^ H_Ror(w[i - 2], 19) ^ (w[i - 2] >> 10);
            w[i] = w[i - 16] + s0 + w[i - 7] + s1;
        }
        uint32_t a = h[0], b = h[1], c = h[2], d = h[3], e = h[4], f = h[5], g = h[6], hh = h[7];
        for (uint32_t i = 0; i < 64; ++i) {
            const uint32_t S1 = H_Ror(e, 6) ^ H_Ror(e, 11) ^ H_Ror(e, 25);
            const uint32_t ch = (e & f) ^ ((~e) & g);
            const uint32_t t1 = hh + S1 + ch + H_K256[i] + w[i];
            const uint32_t S0 = H_Ror(a, 2) ^ H_Ror(a, 13) ^ H_Ror(a, 22);
            const uint32_t mj = (a & b) ^ (a & c) ^ (b & c);
            const uint32_t t2 = S0 + mj;
            hh = g;
            g = f;
            f = e;
            e = d + t1;
            d = c;
            c = b;
            b = a;
            a = t1 + t2;
        }
        h[0] += a;
        h[1] += b;
        h[2] += c;
        h[3] += d;
        h[4] += e;
        h[5] += f;
        h[6] += g;
        h[7] += hh;
    }

    void Update(const void* data, size_t len)
    {
        const uint8_t* p = static_cast<const uint8_t*>(data);
        total += len;
        while (len > 0) {
            const size_t take = (len < 64 - n) ? len : (64 - n);
            __builtin_memcpy(buf + n, p, take);
            n += take;
            p += take;
            len -= take;
            if (n == 64) {
                Block(buf);
                n = 0;
            }
        }
    }

    void Final(uint8_t out[32])
    {
        const uint64_t bits = total * 8u;
        uint8_t pad = 0x80;
        Update(&pad, 1);
        pad = 0;
        while (n != 56) {
            Update(&pad, 1);
        }
        uint8_t lenb[8];
        for (uint32_t i = 0; i < 8; ++i) {
            lenb[i] = static_cast<uint8_t>(bits >> (56 - 8 * i));
        }
        Update(lenb, 8);
        for (uint32_t i = 0; i < 8; ++i) {
            out[i * 4] = static_cast<uint8_t>(h[i] >> 24);
            out[i * 4 + 1] = static_cast<uint8_t>(h[i] >> 16);
            out[i * 4 + 2] = static_cast<uint8_t>(h[i] >> 8);
            out[i * 4 + 3] = static_cast<uint8_t>(h[i]);
        }
    }
};

std::string H_Sha256Hex(const void* data, size_t len)
{
    HSha256 s;
    s.Init();
    s.Update(data, len);
    uint8_t d[32];
    s.Final(d);
    char hex[65];
    for (uint32_t i = 0; i < 32; ++i) {
        static const char* kHexDigits = "0123456789abcdef";
        hex[i * 2] = kHexDigits[d[i] >> 4];
        hex[i * 2 + 1] = kHexDigits[d[i] & 0xF];
    }
    hex[64] = 0;
    return std::string(hex);
}

// SHA-256 自检（"abc" 的已知向量）：host 的字节同一性判据全靠它，先验一遍
bool H_SelfTestSha256()
{
    const std::string got = H_Sha256Hex("abc", 3);
    return got == "ba7816bf8f01cfea414140de5dae2223b00361a396177a9cb410ff61f20015ad";
}

float H_Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

uint16_t H_F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t bias = ((x >> 16) & 1u) + 0x7FFFu;
    return static_cast<uint16_t>((x + bias) >> 16);
}

// ---------------- 文件 IO（pread；不经过 page-cache 以外的任何抽象） ----------------
bool H_ReadAll(const std::string& path, std::vector<uint8_t>& out)
{
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) {
        return false;
    }
    fseek(f, 0, SEEK_END);
    const long sz = ftell(f);
    fseek(f, 0, SEEK_SET);
    if (sz < 0) {
        fclose(f);
        return false;
    }
    out.resize(static_cast<size_t>(sz));
    const size_t r = out.empty() ? 0 : fread(out.data(), 1, out.size(), f);
    fclose(f);
    return r == out.size();
}

bool H_PRead(const std::string& path, uint64_t off, void* dst, size_t bytes)
{
    const int fd = open(path.c_str(), O_RDONLY);
    if (fd < 0) {
        return false;
    }
    uint8_t* p = static_cast<uint8_t*>(dst);
    size_t left = bytes;
    uint64_t cur = off;
    while (left > 0) {
        const ssize_t r = pread(fd, p, left, static_cast<off_t>(cur));
        if (r <= 0) {
            close(fd);
            return false;
        }
        p += r;
        cur += static_cast<uint64_t>(r);
        left -= static_cast<size_t>(r);
    }
    close(fd);
    return true;
}

bool H_WriteFile(const std::string& path, const void* data, size_t bytes)
{
    FILE* f = fopen(path.c_str(), "wb");
    if (f == nullptr) {
        return false;
    }
    const size_t w = bytes == 0 ? 0 : fwrite(data, 1, bytes, f);
    fclose(f);
    return w == bytes;
}

bool H_WriteText(const std::string& path, const std::string& text)
{
    return H_WriteFile(path, text.data(), text.size());
}

// ---------------- manifest ----------------
struct MTensor {
    std::string role;
    std::string file;
    uint64_t offset = 0;
    uint64_t bytes = 0;
    std::string dtype;
    uint32_t rows = 0;
    uint32_t cols = 0;
    std::string sha256;
};

struct Manifest {
    std::string modelDir;
    uint32_t layer = 0;
    uint32_t hidden = 0;
    uint32_t inter = 0;
    uint32_t group = 0;
    std::map<std::string, MTensor> byRole;
};

bool H_ParseManifest(const std::string& path, Manifest& m)
{
    std::vector<uint8_t> raw;
    if (!H_ReadAll(path, raw)) {
        printf("[M17][FAIL] cannot read manifest %s\n", path.c_str());
        return false;
    }
    std::string text(raw.begin(), raw.end());
    size_t pos = 0;
    while (pos < text.size()) {
        size_t eol = text.find('\n', pos);
        if (eol == std::string::npos) {
            eol = text.size();
        }
        const std::string line = text.substr(pos, eol - pos);
        pos = eol + 1;
        if (line.empty() || line[0] == '#') {
            continue;
        }
        std::map<std::string, std::string> kv;
        // 按空格切 token，再按 '=' 切 key/value（行首的裸 token "tensor" 被忽略）
        size_t i = 0;
        while (i < line.size()) {
            while (i < line.size() && line[i] == ' ') {
                ++i;
            }
            size_t j = i;
            while (j < line.size() && line[j] != ' ') {
                ++j;
            }
            if (j > i) {
                const std::string tok = line.substr(i, j - i);
                const size_t eq = tok.find('=');
                if (eq != std::string::npos) {
                    kv[tok.substr(0, eq)] = tok.substr(eq + 1);
                }
            }
            i = j;
        }
        if (kv.count("role")) {
            MTensor t;
            t.role = kv["role"];
            t.file = kv.count("file") ? kv["file"] : "";
            t.offset = kv.count("offset") ? strtoull(kv["offset"].c_str(), nullptr, 10) : 0;
            t.bytes = kv.count("bytes") ? strtoull(kv["bytes"].c_str(), nullptr, 10) : 0;
            t.dtype = kv.count("dtype") ? kv["dtype"] : "";
            t.rows = kv.count("rows") ? static_cast<uint32_t>(strtoul(kv["rows"].c_str(), nullptr, 10)) : 0;
            t.cols = kv.count("cols") ? static_cast<uint32_t>(strtoul(kv["cols"].c_str(), nullptr, 10)) : 0;
            t.sha256 = kv.count("sha256") ? kv["sha256"] : "-";
            m.byRole[t.role] = t;
        } else {
            if (kv.count("model_dir")) {
                m.modelDir = kv["model_dir"];
            } else if (kv.count("layer")) {
                m.layer = static_cast<uint32_t>(strtoul(kv["layer"].c_str(), nullptr, 10));
            } else if (kv.count("hidden")) {
                m.hidden = static_cast<uint32_t>(strtoul(kv["hidden"].c_str(), nullptr, 10));
            } else if (kv.count("inter")) {
                m.inter = static_cast<uint32_t>(strtoul(kv["inter"].c_str(), nullptr, 10));
            } else if (kv.count("group")) {
                m.group = static_cast<uint32_t>(strtoul(kv["group"].c_str(), nullptr, 10));
            }
        }
    }
    return m.byRole.size() > 0;
}

}  // namespace

// ============================================================
// Host 主流程
// ============================================================

namespace {

struct UploadRec {
    std::string role;
    void* dev = nullptr;
    size_t bytes = 0;
    const std::vector<uint8_t>* host = nullptr;
};

// workspace 段落表（check_ref.py 按名字取切片；off/size 直接取自 M17 常量，单一真相源）
struct WsSeg {
    const char* name;
    uint32_t off;
    uint32_t sz;
    const char* layout;
};

const WsSeg kSegs[] = {
    {"x_norm", M17::WS_XNORM, M17::SZ_XNORM, "[M_MAX=64, HIDDEN] bf16"},
    {"res1", M17::WS_RES1, M17::SZ_RES1, "[M_MAX, HIDDEN] fp32"},
    {"logits", M17::WS_LOGITS, M17::SZ_LOGITS, "[M_MAX, E=512] fp32 (max-shifted)"},
    {"topk_ids", M17::WS_IDS, M17::SZ_IDS, "[M_MAX, TOPK=10] i32 降序"},
    {"topk_weights", M17::WS_W, M17::SZ_W, "[M_MAX, TOPK=10] fp32 (renorm)"},
    {"perm_src", M17::WS_PERM_SRC, M17::SZ_PERM, "[TOTAL_MAX=640] i32"},
    {"perm_expert", M17::WS_PERM_EXP, M17::SZ_PERM, "[TOTAL_MAX] i32"},
    {"counts", M17::WS_COUNTS, M17::SZ_COUNTS, "[E] i32"},
    {"offsets", M17::WS_OFFSETS, M17::SZ_OFFSETS, "[E+1] i32（+32B 诊断槽）"},
    {"inv_slot", M17::WS_INV, M17::SZ_INV, "[M_MAX, TOPK] i32（Y 的展开行号）"},
    {"w_tk_packed", M17::WS_WTK, M17::SZ_WTK, "[M_MAX, 16] i32（bf16 位在低 16 位）"},
    {"sgate", M17::WS_SGATE, M17::SZ_SGATE, "[M_MAX] fp32 共享门裸点积"},
    {"x_sorted", M17::WS_XSORT, M17::SZ_XSORT, "[TOTAL_MAX, HIDDEN] bf16"},
    {"aq", M17::WS_AQ, M17::SZ_AQ, "[E, M_MAX, HIDDEN/2] u8（槽位 padding）"},
    {"as", M17::WS_AS, M17::SZ_AS, "[E, M_MAX, 80] u8"},
    {"aq_shd", M17::WS_AQ_SHD, M17::SZ_AQ_SHD, "[M_MAX, HIDDEN/2] u8"},
    {"as_shd", M17::WS_AS_SHD, M17::SZ_AS_SHD, "[M_MAX, 80] u8"},
    {"gu", M17::WS_GU, M17::SZ_GU, "[E, M_MAX, GU_N=1280] bf16"},
    {"gu_shd", M17::WS_GU_SHD, M17::SZ_GU_SHD, "[M_MAX, GU_N] bf16"},
    {"h_swiglu", M17::WS_H, M17::SZ_H, "[TOTAL_MAX, INTER=640] bf16"},
    {"h_swiglu_shd", M17::WS_H_SHD, M17::SZ_H_SHD, "[M_MAX, INTER] bf16"},
    {"hq", M17::WS_HQ, M17::SZ_HQ, "[E, M_MAX, INTER/2] u8"},
    {"hs", M17::WS_HS, M17::SZ_HS, "[E, M_MAX, 32] u8（20 有效）"},
    {"hq_shd", M17::WS_HQ_SHD, M17::SZ_HQ_SHD, "[M_MAX, INTER/2] u8"},
    {"hs_shd", M17::WS_HS_SHD, M17::SZ_HS_SHD, "[M_MAX, 32] u8"},
    {"y", M17::WS_Y, M17::SZ_Y, "[E, M_MAX, HIDDEN] bf16"},
    {"y_shd", M17::WS_Y_SHD, M17::SZ_Y_SHD, "[M_MAX, HIDDEN] bf16"},
    {"routed", M17::WS_ROUTED, M17::SZ_ROUTED, "[M_MAX, HIDDEN] bf16"},
    {"shared", M17::WS_SHARED, M17::SZ_SHARED, "[M_MAX, HIDDEN] bf16"},
    {"moe", M17::WS_MOE, M17::SZ_MOE, "[M_MAX, HIDDEN] bf16"},
    {"y_final", M17::WS_YFINAL, M17::SZ_YFINAL, "[M_MAX, HIDDEN] bf16"},
    {"res2", M17::WS_RES2, M17::SZ_RES2, "[M_MAX, HIDDEN] fp32"},
};

// ---- 落盘：整段 workspace + 段落 sha256 清单 ----
std::string H_DumpWorkspace(const std::string& dir, const std::string& tag, const std::vector<uint8_t>& ws,
                            uint32_t m, uint32_t topk)
{
    const std::string bin = dir + "/ws_" + tag + ".bin";
    if (!H_WriteFile(bin, ws.data(), ws.size())) {
        printf("[M17][dump] cannot write %s\n", bin.c_str());
        return std::string();
    }
    printf("[M17][dump] workspace (%u bytes) → %s\n", static_cast<unsigned>(ws.size()), bin.c_str());

    std::string meta;
    char buf[512];
    snprintf(buf, sizeof(buf),
             "# M17 device workspace layout —— 由 kernel 的 M17 常量直接打印，勿手改\n"
             "ws_bytes=%u\nm=%u\ntopk=%u\nhidden=%u\ninter=%u\ngu_n=%u\nnum_experts=%u\nm_max=%u\ngroup=%u\n"
             "ws_bin=%s\n",
             static_cast<unsigned>(ws.size()), m, topk, M17::HIDDEN, M17::INTER, M17::GU_N, M17::NUM_EXPERTS,
             M17::M_MAX, M17::GROUP, bin.c_str());
    meta += buf;
    for (const WsSeg& s : kSegs) {
        snprintf(buf, sizeof(buf), "seg %s off=%u size=%u layout=%s\n", s.name, s.off, s.sz, s.layout);
        meta += buf;
        const std::string sh = H_Sha256Hex(ws.data() + s.off, s.sz);
        snprintf(buf, sizeof(buf), "sha %s %s\n", s.name, sh.c_str());
        meta += buf;
    }
    const std::string metapath = dir + "/ws_meta_" + tag + ".txt";
    H_WriteText(metapath, meta);
    printf("[M17][dump] meta → %s（%zu 段 sha256）\n", metapath.c_str(), sizeof(kSegs) / sizeof(kSegs[0]));
    return meta;
}

// ---- device GM 回读 → 与 host 缓冲逐字节比对 + sha256（byte identity 第二/三条腿） ----
bool H_VerifyDeviceBytes(aclrtStream stream, std::vector<UploadRec>& recs, const std::string& logPath)
{
    (void)stream;
    std::vector<uint8_t> scratch(64u << 20);
    std::string log;
    bool allOk = true;
    size_t totalBytes = 0;
    for (UploadRec& r : recs) {
        if (r.bytes == 0) {
            continue;
        }
        HSha256 hasher;
        hasher.Init();
        size_t diff = 0;
        size_t firstDiff = 0;
        // 分块 D2H（避免为 838MB 的专家权重再开一块同样大的临时缓冲）+ 流式 sha256
        for (size_t off = 0; off < r.bytes; off += scratch.size()) {
            const size_t take = (r.bytes - off < scratch.size()) ? (r.bytes - off) : scratch.size();
            if (aclrtMemcpy(scratch.data(), take, static_cast<uint8_t*>(r.dev) + off, take,
                            ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
                printf("[M17][FAIL] D2H readback failed for %s @%zu\n", r.role.c_str(), off);
                return false;
            }
            hasher.Update(scratch.data(), take);
            if (r.host != nullptr && diff == 0 &&
                __builtin_memcmp(scratch.data(), r.host->data() + off, take) != 0) {
                for (size_t i = 0; i < take; ++i) {
                    if (scratch[i] != (*r.host)[off + i]) {
                        firstDiff = off + i;
                        ++diff;
                        break;
                    }
                }
            }
        }
        uint8_t dig[32];
        hasher.Final(dig);
        char hexd[65];
        for (uint32_t i = 0; i < 32; ++i) {
            static const char* kHexDigits = "0123456789abcdef";
            hexd[i * 2] = kHexDigits[dig[i] >> 4];
            hexd[i * 2 + 1] = kHexDigits[dig[i] & 0xF];
        }
        hexd[64] = 0;
        const bool ok = (diff == 0);
        allOk = allOk && ok;
        totalBytes += r.bytes;
        char buf[512];
        snprintf(buf, sizeof(buf),
                 "[M17][bytes] %-22s %10zu B  D2H==HOST %s (diff %zu%s)  sha256(device D2H)=%s\n", r.role.c_str(),
                 r.bytes, ok ? "OK  " : "FAIL", diff,
                 diff ? (std::string(", first@") + std::to_string(firstDiff)).c_str() : "", hexd);
        printf("%s", buf);
        log += buf;
    }
    char buf[256];
    snprintf(buf, sizeof(buf), "[M17][bytes] 合计逐字节核对 %zu B（%.3f GiB），全部一致 = %s\n", totalBytes,
             static_cast<double>(totalBytes) / 1073741824.0, allOk ? "YES" : "NO");
    printf("%s", buf);
    log += buf;
    if (!logPath.empty()) {
        H_WriteText(logPath, log);
    }
    return allOk;
}

}  // namespace

// ============================================================
// 不变量自检（host，不依赖 numpy；数值判据归 check_ref.py）
// ============================================================

namespace {

int H_Pass = 0;
int H_Fail = 0;

void H_Chk(bool ok, const char* fmt, ...);

void H_Chk(bool ok, const char* fmt, ...)
{
    char msg[512];
    va_list ap;
    va_start(ap, fmt);
    vsnprintf(msg, sizeof(msg), fmt, ap);
    va_end(ap);
    printf("[M17]   %-46s %s\n", msg, ok ? "PASS" : "FAIL");
    if (ok) {
        ++H_Pass;
    } else {
        ++H_Fail;
    }
}

const uint16_t* AsU16(const std::vector<uint8_t>& ws, uint32_t off) { return reinterpret_cast<const uint16_t*>(ws.data() + off); }
const int32_t* AsI32(const std::vector<uint8_t>& ws, uint32_t off) { return reinterpret_cast<const int32_t*>(ws.data() + off); }
const float* AsF32(const std::vector<uint8_t>& ws, uint32_t off) { return reinterpret_cast<const float*>(ws.data() + off); }

// e2m1 码字 → 幅值（bit3 = sign）
double H_E2M1(uint8_t code)
{
    static const double mag[8] = {0.0, 0.5, 1.0, 1.5, 2.0, 3.0, 4.0, 6.0};
    const double v = mag[code & 7u];
    return (code & 8u) ? -v : v;
}

double H_E8M0(uint8_t b) { return std::ldexp(1.0, static_cast<int>(b) - 127); }

bool H_HostInvariants(const std::vector<uint8_t>& ws, uint32_t m, uint32_t topk)
{
    const uint32_t H = M17::HIDDEN;
    const uint32_t E = M17::NUM_EXPERTS;
    const uint32_t TK = topk;
    const uint32_t S = m * TK;
    const int32_t* ids = AsI32(ws, M17::WS_IDS);
    const float* wts = AsF32(ws, M17::WS_W);
    const float* logits = AsF32(ws, M17::WS_LOGITS);
    const int32_t* counts = AsI32(ws, M17::WS_COUNTS);
    const int32_t* offs = AsI32(ws, M17::WS_OFFSETS);
    const int32_t* psrc = AsI32(ws, M17::WS_PERM_SRC);
    const int32_t* pexp = AsI32(ws, M17::WS_PERM_EXP);
    const int32_t* inv = AsI32(ws, M17::WS_INV);
    const int32_t* wtk = AsI32(ws, M17::WS_WTK);
    const uint16_t* xnorm = AsU16(ws, M17::WS_XNORM);
    const uint16_t* xsort = AsU16(ws, M17::WS_XSORT);
    const float* sgate = AsF32(ws, M17::WS_SGATE);
    const uint16_t* moe = AsU16(ws, M17::WS_MOE);
    const uint16_t* yfin = AsU16(ws, M17::WS_YFINAL);
    const uint16_t* routed = AsU16(ws, M17::WS_ROUTED);
    const uint16_t* shared = AsU16(ws, M17::WS_SHARED);
    const float* res2 = AsF32(ws, M17::WS_RES2);

    printf("[M17] ---- host 不变量自检（m=%u topk=%u）----\n", m, TK);
    // 诊断槽（IG 越界计数）：非 0 说明 ids 越界，后面的判据都不可信
    const int32_t diag = offs[M17::IG_DIAG_GM_SLOT];
    H_Chk(diag == 0, "IG 越界计数 diag == 0 (got %d)", diag);

    int64_t sumCnt = 0;
    int32_t recomputed[M17::NUM_EXPERTS + 1];
    recomputed[0] = 0;
    for (uint32_t e = 0; e < E; ++e) {
        sumCnt += counts[e];
        recomputed[e + 1] = static_cast<int32_t>(sumCnt);
    }
    H_Chk(sumCnt == static_cast<int64_t>(S), "counts 求和 == m*topk (%lld vs %u)", static_cast<long long>(sumCnt), S);
    int offBad = 0;
    for (uint32_t e = 0; e <= E; ++e) {
        if (offs[e] != recomputed[e]) {
            ++offBad;
        }
    }
    H_Chk(offBad == 0, "offsets 与 counts 前缀和一致 (bad %d)", offBad);
    int cntOver = 0;
    for (uint32_t e = 0; e < E; ++e) {
        if (counts[e] < 0 || counts[e] > static_cast<int32_t>(M17::BASE_M)) {
            ++cntOver;
        }
    }
    H_Chk(cntOver == 0, "每个槽位 t_e ∈ [0, BASE_M=64] (bad %d)", cntOver);

    // ids 范围 + 行内唯一
    int idBad = 0;
    for (uint32_t t = 0; t < m; ++t) {
        for (uint32_t k = 0; k < TK; ++k) {
            const int32_t e = ids[t * TK + k];
            if (e < 0 || e >= static_cast<int32_t>(E)) {
                ++idBad;
                continue;
            }
            for (uint32_t k2 = k + 1; k2 < TK; ++k2) {
                if (ids[t * TK + k2] == e) {
                    ++idBad;
                }
            }
        }
    }
    H_Chk(idBad == 0, "topk_ids ∈ [0,E) 且行内唯一 (bad %d)", idBad);

    // perm 按 expert 分组有序 + perm_src 组内严格递增
    int permBad = 0;
    uint32_t p = 0;
    for (uint32_t e = 0; e < E; ++e) {
        int32_t prev = -1;
        for (int32_t c = 0; c < counts[e]; ++c, ++p) {
            if (pexp[p] != static_cast<int32_t>(e)) {
                ++permBad;
            }
            if (psrc[p] <= prev) {
                ++permBad;
            }
            prev = psrc[p];
        }
    }
    H_Chk(permBad == 0, "perm 按 (expert, token) 分组有序 (bad %d)", permBad);

    // perm_src/perm_expert 与 ids 一致
    int permIdBad = 0;
    for (uint32_t t = 0; t < m; ++t) {
        for (uint32_t k = 0; k < TK; ++k) {
            bool found = false;
            for (uint32_t q = 0; q < S; ++q) {
                if (psrc[q] == static_cast<int32_t>(t) && pexp[q] == ids[t * TK + k]) {
                    found = true;
                    break;
                }
            }
            if (!found) {
                ++permIdBad;
            }
        }
    }
    H_Chk(permIdBad == 0, "每个 (token, expert) 都在 perm 里出现 (bad %d)", permIdBad);

    // inv_slot 与 perm 自洽（inv = e*M_MAX + 组内行号）
    int invBad = 0;
    p = 0;
    for (uint32_t e = 0; e < E; ++e) {
        for (int32_t c = 0; c < counts[e]; ++c, ++p) {
            const uint32_t t = static_cast<uint32_t>(psrc[p]);
            for (uint32_t k = 0; k < TK; ++k) {
                if (ids[t * TK + k] == static_cast<int32_t>(e)) {
                    const int32_t want = static_cast<int32_t>(e * M17::M_MAX + static_cast<uint32_t>(c));
                    if (inv[t * TK + k] != want) {
                        ++invBad;
                    }
                }
            }
        }
    }
    H_Chk(invBad == 0, "inv_slot 与 perm 自洽 (bad %d)", invBad);

    // x_sorted == gather(x_norm, perm_src)（逐位）
    int xsBad = 0;
    for (uint32_t q = 0; q < S; ++q) {
        const uint16_t* src = xnorm + static_cast<size_t>(psrc[q]) * H;
        const uint16_t* dst = xsort + static_cast<size_t>(q) * H;
        for (uint32_t i = 0; i < H; ++i) {
            if (src[i] != dst[i]) {
                ++xsBad;
                break;
            }
        }
    }
    H_Chk(xsBad == 0, "x_sorted == gather(x_norm, perm_src) 逐位 (bad %d)", xsBad);

    // w_tk_packed 低 16 位 == bf16(topk_weights)
    int wtkBad = 0;
    for (uint32_t t = 0; t < m; ++t) {
        for (uint32_t k = 0; k < TK; ++k) {
            const uint16_t want = H_F32ToBf16(wts[t * TK + k]);
            if ((wtk[t * 16 + k] & 0xFFFF) != static_cast<int32_t>(want)) {
                ++wtkBad;
            }
        }
    }
    H_Chk(wtkBad == 0, "w_tk_packed 低 16 位 == bf16(topk_weights) (bad %d)", wtkBad);

    // 有限性 + 权重归一
    int nonFinite = 0;
    double worstNorm = 0.0;
    for (uint32_t t = 0; t < m; ++t) {
        double ssum = 0.0;
        for (uint32_t k = 0; k < TK; ++k) {
            const float f = wts[t * TK + k];
            if (!std::isfinite(f) || f <= 0.0f) {
                ++nonFinite;
            }
            ssum += f;
        }
        worstNorm = std::max(worstNorm, std::fabs(ssum - 1.0));
        if (!std::isfinite(sgate[t])) {
            ++nonFinite;
        }
        for (uint32_t i = 0; i < H; ++i) {
            if (!std::isfinite(H_Bf16ToF32(moe[t * H + i])) || !std::isfinite(H_Bf16ToF32(yfin[t * H + i])) ||
                !std::isfinite(H_Bf16ToF32(routed[t * H + i])) || !std::isfinite(H_Bf16ToF32(shared[t * H + i])) ||
                !std::isfinite(res2[t * H + i])) {
                ++nonFinite;
            }
        }
    }
    for (size_t i = 0; i < static_cast<size_t>(m) * E; ++i) {
        if (!std::isfinite(logits[i])) {
            ++nonFinite;
        }
    }
    H_Chk(nonFinite == 0, "logits/权重/输出全体有限 (bad %d)", nonFinite);
    H_Chk(worstNorm < 1e-3, "topk_weights 行和 ≈ 1 (max |Σ-1| = %.3g)", worstNorm);

    // 真实权重下 router 应有的"非退化"形态：top-10 的权重量级不应全为 1/512
    {
        double wmin = 1e9, wmax = 0.0;
        for (uint32_t t = 0; t < m; ++t) {
            for (uint32_t k = 0; k < TK; ++k) {
                const double v = wts[t * TK + k];
                wmin = std::min(wmin, v);
                wmax = std::max(wmax, v);
            }
        }
        printf("[M17]   [报告] topk_weights 区间 [%.6g, %.6g]（真实 512 专家 top-10 的期望量级 1e-1..1e-3）\n",
               wmin, wmax);
    }
    return H_Fail == 0;
}

// ============================================================
// 权重 nibble 解包自检（host 侧期望值；device 侧由 cube 探针给出）
//   C[i][n] = dequant(W_e[n][i])，i < 64，n < 256（BASE_N）
// ============================================================
void H_ProbeExpect(const std::vector<uint8_t>& wGu, const std::vector<uint8_t>& sGu, uint32_t expert,
                   const uint16_t* gotC, uint32_t* mismatch, uint32_t* skipped)
{
    const uint32_t H = M17::HIDDEN;
    const uint32_t packedRow = H / 2;   // 1280
    const size_t base = static_cast<size_t>(expert) * M17::GU_N * packedRow;
    const size_t sbase = static_cast<size_t>(expert) * M17::GU_N * M17::GU_SCALE_STRIDE;
    *mismatch = 0;
    *skipped = 0;
    for (uint32_t n = 0; n < M17::BASE_N; ++n) {
        for (uint32_t i = 0; i < PROBE_M; ++i) {
            const uint8_t byte = wGu[base + static_cast<size_t>(n) * packedRow + i / 2];
            const uint8_t nib = (i % 2 == 0) ? static_cast<uint8_t>(byte & 0xF) : static_cast<uint8_t>(byte >> 4);
            const uint8_t sc = sGu[sbase + static_cast<size_t>(n) * M17::GU_SCALE_STRIDE + i / M17::GROUP];
            if (sc == 0 || sc == 255) {
                ++(*skipped);
                continue;
            }
            const double want = H_E2M1(nib) * H_E8M0(sc);
            const uint16_t wantBits = H_F32ToBf16(static_cast<float>(want));
            const uint16_t gotBits = gotC[i * M17::GU_N + n];
            // ±0 视为相等（硬件把 e2m1 的 -0 归成 +0；数值语义一致）
            const bool bothZero = ((wantBits & 0x7FFFu) == 0) && ((gotBits & 0x7FFFu) == 0);
            if (!bothZero && wantBits != gotBits) {
                if (*mismatch < 5) {
                    printf("[M17]     probe C[%u][%u] want %04x (%.6g) got %04x (%.6g) nib=%u sc=0x%02x\n", i, n,
                           wantBits, want, gotBits, static_cast<double>(H_Bf16ToF32(gotBits)), nib, sc);
                }
                ++(*mismatch);
            }
        }
    }
}

}  // namespace

// ============================================================
// main：真实权重 → device → kernel → dump/判据（+ 解包探针）
// ============================================================

namespace {

bool H_MkdirP(const std::string& path)
{
    std::string cur;
    for (size_t i = 0; i < path.size(); ++i) {
        cur += path[i];
        if (path[i] == '/' && cur.size() > 1) {
            mkdir(cur.c_str(), 0755);
        }
    }
    return mkdir(path.c_str(), 0755) == 0 || errno == EEXIST;
}

}  // namespace

int main(int argc, char** argv)
{
    std::string manifestPath = "m17_moe_real/m17_weight_manifest.txt";
    uint32_t layer = 0;
    bool layerSet = false;
    uint32_t token = 1000;
    uint32_t m = 1;
    uint32_t stageLimit = 8;
    uint32_t subLimit = 9;
    bool doDump = true;
    bool doProbe = true;
    bool doByteCheck = true;
    std::string dumpDir = "/tmp/m17_dump";

    for (int i = 1; i < argc; ++i) {
        const std::string a = argv[i];
        auto next = [&](void) -> const char* { return (i + 1 < argc) ? argv[++i] : nullptr; };
        if (a == "--layer") {
            const char* v = next();
            layer = static_cast<uint32_t>(atoi(v ? v : "0"));
            layerSet = true;
        } else if (a == "--token") {
            const char* v = next();
            token = static_cast<uint32_t>(atoi(v ? v : "0"));
        } else if (a == "--m") {
            const char* v = next();
            const long mv = (v != nullptr) ? atol(v) : 1;
            // 夹紧 + 显式拒绝：m > M_MAX 会走出各 SZ_* 段的分配（槽位行数、perm 容量都是
            // 按 M_MAX 编译期定的），不能静默截断
            if (mv < 1 || mv > static_cast<long>(M17::M_MAX)) {
                printf("[M17][FAIL] --m=%ld 超出实现包络 [1, M_MAX=%u]（BASE_M 单 tile；"
                       "prefill m>64 未实现，见 README §7.2）\n", mv, M17::M_MAX);
                return 2;
            }
            m = static_cast<uint32_t>(mv);
        } else if (a == "--stage") {
            const char* v = next();
            stageLimit = static_cast<uint32_t>(atoi(v ? v : "8"));
        } else if (a == "--sub") {
            const char* v = next();
            subLimit = static_cast<uint32_t>(atoi(v ? v : "9"));
        } else if (a == "--dumpdir") {
            const char* v = next();
            if (v != nullptr) {
                dumpDir = v;
            }
        } else if (a == "--no-dump") {
            doDump = false;
        } else if (a == "--no-probe") {
            doProbe = false;
        } else if (a == "--no-bytecheck") {
            doByteCheck = false;
        } else if (a.size() > 0 && a[0] != '-') {
            manifestPath = a;
        }
    }

    printf("[M17] ================ M29 MoE block 真实权重端到端 ================\n");
    if (!H_SelfTestSha256()) {
        printf("[M17][FAIL] SHA-256 自检失败（\\\"abc\\\" 向量不符）—— 后续字节判据不可信\n");
        return 1;
    }
    printf("[M17] SHA-256 自检 PASS（\"abc\" 向量）\n");

    Manifest mf;
    if (!H_ParseManifest(manifestPath, mf)) {
        return 1;
    }
    if (!layerSet) {
        layer = mf.layer;
    }
    printf("[M17] manifest=%s  model_dir=%s  layer=%u  token=%u  m=%u  stageLimit=%u subLimit=%u\n",
           manifestPath.c_str(), mf.modelDir.c_str(), layer, token, m, stageLimit, subLimit);
    printf("[M17] checkpoint 形状：hidden=%u inter=%u group=%u E=%u topk=%u\n", mf.hidden, mf.inter, mf.group,
           M17::NUM_EXPERTS, M17::TOPK_MAX);

    const char* kRoles[] = {"router_w",     "sgate_w",     "gu_packed",  "gu_scale",      "dn_packed",
                            "dn_scale",     "shd_gate",    "shd_up",     "shd_down",      "shd_gate_scale",
                            "shd_up_scale", "shd_down_scale", "gamma1",  "gamma2"};
    std::map<std::string, std::vector<uint8_t>> W;
    printf("[M17] ---- 从真实 checkpoint pread 权重（字节原样，与 manifest 的 Python sha256 比对）----\n");
    bool byteOk = true;
    size_t weightBytes = 0;
    for (const char* role : kRoles) {
        if (mf.byRole.count(role) == 0) {
            printf("[M17][FAIL] manifest 缺 role=%s\n", role);
            return 1;
        }
        const MTensor& t = mf.byRole[role];
        std::vector<uint8_t>& buf = W[role];
        buf.resize(static_cast<size_t>(t.bytes));
        const std::string path = mf.modelDir + "/" + t.file;
        if (!H_PRead(path, t.offset, buf.data(), buf.size())) {
            printf("[M17][FAIL] pread 失败 role=%s %s@%llu (%llu B)\n", role, path.c_str(),
                   static_cast<unsigned long long>(t.offset), static_cast<unsigned long long>(t.bytes));
            return 1;
        }
        const std::string got = H_Sha256Hex(buf.data(), buf.size());
        bool ok;
        if (t.sha256 == "-") {
            ok = true;   // x_embed 的行切片是运行时决定的，没有预置哈希
        } else {
            ok = (got == t.sha256);
        }
        byteOk = byteOk && ok;
        weightBytes += buf.size();
        printf("[M17][src] %-16s %10llu B  sha256=%s %s\n", role, static_cast<unsigned long long>(t.bytes),
               got.c_str(), t.sha256 == "-" ? "(no expected)" : (ok ? "== manifest" : "!= manifest!!"));
    }
    printf("[M17][src] 合计 %zu B（%.3f GiB），与 manifest 的 Python 独立 sha256 全部一致 = %s\n", weightBytes,
           static_cast<double>(weightBytes) / 1073741824.0, byteOk ? "YES" : "NO");
    if (!byteOk) {
        return 1;
    }

    // ---- 共享专家 gate|up 行拼接（checkpoint 是独立 gate_proj/up_proj）----
    const size_t guRow = M17::HIDDEN / 2;
    const size_t guSRow = M17::GU_SCALE_STRIDE;
    std::vector<uint8_t> wGuShd(static_cast<size_t>(M17::GU_N) * guRow);
    std::vector<uint8_t> sGuShd(static_cast<size_t>(M17::GU_N) * guSRow);
    for (uint32_t r = 0; r < M17::INTER; ++r) {
        __builtin_memcpy(wGuShd.data() + r * guRow, W["shd_gate"].data() + r * guRow, guRow);
        __builtin_memcpy(wGuShd.data() + (M17::INTER + r) * guRow, W["shd_up"].data() + r * guRow, guRow);
        __builtin_memcpy(sGuShd.data() + r * guSRow, W["shd_gate_scale"].data() + r * guSRow, guSRow);
        __builtin_memcpy(sGuShd.data() + (M17::INTER + r) * guSRow, W["shd_up_scale"].data() + r * guSRow, guSRow);
    }
    printf("[M17] 共享专家 gate|up 行拼接：w [%u,%u] → [%u,%u]，scale [%u,%u] → [%u,%u]（权重字节不变）\n",
           M17::INTER, M17::HIDDEN / 2, M17::GU_N, M17::HIDDEN / 2, M17::INTER, M17::GU_SCALE_STRIDE, M17::GU_N,
           M17::GU_SCALE_STRIDE);

    // ---- 层输入 x = 真实 embedding 第 token..token+m-1 行（其余行 0 padding 到 M_MAX）----
    {
        const MTensor& t = mf.byRole["x_embed"];
        const size_t rowBytes = static_cast<size_t>(t.cols) * 2;
        if (static_cast<uint64_t>(token) + m > t.rows) {
            printf("[M17][FAIL] token+m 超出 embedding 行数（%u+%u > %u）\n", token, m, t.rows);
            return 1;
        }
        std::vector<uint8_t>& xb = W["x"];
        xb.assign(static_cast<size_t>(M17::M_MAX) * M17::HIDDEN * 2, 0);
        const std::string path = mf.modelDir + "/" + t.file;
        if (!H_PRead(path, t.offset + static_cast<uint64_t>(token) * rowBytes, xb.data(),
                     static_cast<size_t>(m) * rowBytes)) {
            printf("[M17][FAIL] pread x rows 失败\n");
            return 1;
        }
        printf("[M17][src] x (%u 行 embed_tokens[%u..%u)) sha256=%s\n", m, token, token + m - 1,
               H_Sha256Hex(xb.data(), static_cast<size_t>(m) * rowBytes).c_str());
    }

    // ---- ACL 初始化 / device 缓冲 ----
    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[M17][FAIL] aclInit failed\n");
        return 1;
    }
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        printf("[M17][FAIL] aclrtSetDevice failed\n");
        return 1;
    }
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        printf("[M17][FAIL] aclrtCreateStream failed\n");
        return 1;
    }
    int64_t aicNum = 0;
    const aclError aicErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    if (aicErr != ACL_SUCCESS || aicNum <= 0) {
        printf("[M17][FAIL] aclrtGetDeviceInfo(AICORE_CORE_NUM) failed (err %d)\n", static_cast<int>(aicErr));
        return 1;
    }
    const uint32_t numBlocks = static_cast<uint32_t>(aicNum);
    printf("[M17] device: %u AIC（mix(1,2) → %u AIV）；workspace = %u B（%.1f MB）\n", numBlocks, 2 * numBlocks,
           static_cast<unsigned>(M17::WS_BYTES), static_cast<double>(M17::WS_BYTES) / 1048576.0);

    void* wsDev = nullptr;
    if (aclrtMalloc(&wsDev, M17::WS_BYTES, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || wsDev == nullptr) {
        printf("[M17][FAIL] aclrtMalloc workspace (%u B) failed\n", static_cast<unsigned>(M17::WS_BYTES));
        return 1;
    }
    aclrtMemset(wsDev, M17::WS_BYTES, 0xCD, M17::WS_BYTES);   // 污染，防假 PASS

    std::vector<UploadRec> recs;
    auto upload = [&](const char* role, const std::vector<uint8_t>& host) -> void* {
        void* dev = nullptr;
        if (aclrtMalloc(&dev, host.size(), ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS || dev == nullptr) {
            printf("[M17][FAIL] aclrtMalloc(%s, %zu) failed\n", role, host.size());
            return nullptr;
        }
        if (aclrtMemcpy(dev, host.size(), host.data(), host.size(), ACL_MEMCPY_HOST_TO_DEVICE) != ACL_SUCCESS) {
            printf("[M17][FAIL] H2D failed for %s (%zu B)\n", role, host.size());
            return nullptr;
        }
        recs.push_back(UploadRec{role, dev, host.size(), &host});
        return dev;
    };

    std::vector<uint8_t> zeroRes(static_cast<size_t>(M17::M_MAX) * M17::HIDDEN * 2, 0);
    void* xDev = upload("x_embed_rows", W["x"]);
    void* zeroDev = upload("res_zero", zeroRes);
    void* g1Dev = upload("gamma1", W["gamma1"]);
    void* g2Dev = upload("gamma2", W["gamma2"]);
    void* rwDev = upload("router_w", W["router_w"]);
    void* sgDev = upload("sgate_w", W["sgate_w"]);
    void* wguDev = upload("experts.gate_up_proj", W["gu_packed"]);
    void* sguDev = upload("experts.gate_up_proj.scale", W["gu_scale"]);
    void* wdnDev = upload("experts.down_proj", W["dn_packed"]);
    void* sdnDev = upload("experts.down_proj.scale", W["dn_scale"]);
    void* wgushdDev = upload("shared.gate_up", wGuShd);
    void* sgushdDev = upload("shared.gate_up.scale", sGuShd);
    void* wdnshdDev = upload("shared.down", W["shd_down"]);
    void* sdnshdDev = upload("shared.down.scale", W["shd_down_scale"]);
    if (xDev == nullptr || zeroDev == nullptr || g1Dev == nullptr || g2Dev == nullptr || rwDev == nullptr ||
        sgDev == nullptr || wguDev == nullptr || sguDev == nullptr || wdnDev == nullptr || sdnDev == nullptr ||
        wgushdDev == nullptr || sgushdDev == nullptr || wdnshdDev == nullptr || sdnshdDev == nullptr) {
        return 1;
    }

    H_MkdirP(dumpDir);
    // ---- device GM 回读 → 逐字节核对（byte identity 的第二条腿）----
    if (doByteCheck) {
        printf("[M17] ---- device GM D2H 回读逐字节核对（含 1.24GiB 专家权重全量）----\n");
        if (!H_VerifyDeviceBytes(stream, recs, dumpDir + "/weight_bytecheck.log")) {
            printf("[M17][FAIL] device 侧权重字节与源切片不一致\n");
            return 1;
        }
    }

    // ---- 主 kernel ----
    printf("[M17] ---- 启动 m17_moe_layer_kernel（mix(1,2)，段序 S1-S10）----\n");
    const auto t0 = std::chrono::steady_clock::now();
    m17_moe_layer_kernel<<<numBlocks, 0, stream>>>(
        reinterpret_cast<uint8_t*>(wsDev), reinterpret_cast<uint8_t*>(xDev), reinterpret_cast<uint8_t*>(zeroDev),
        reinterpret_cast<uint8_t*>(g1Dev), reinterpret_cast<uint8_t*>(g2Dev), reinterpret_cast<uint8_t*>(rwDev),
        reinterpret_cast<uint8_t*>(sgDev), reinterpret_cast<uint8_t*>(wguDev), reinterpret_cast<uint8_t*>(sguDev),
        reinterpret_cast<uint8_t*>(wdnDev), reinterpret_cast<uint8_t*>(sdnDev),
        reinterpret_cast<uint8_t*>(wgushdDev), reinterpret_cast<uint8_t*>(sgushdDev),
        reinterpret_cast<uint8_t*>(wdnshdDev), reinterpret_cast<uint8_t*>(sdnshdDev), m, M17::TOPK_MAX, 1u,
        stageLimit, subLimit);
    aclError err = aclrtSynchronizeStream(stream);
    const double ms = std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - t0).count();
    if (err != ACL_SUCCESS) {
        printf("[M17][FAIL] kernel launch/sync error %d (stageLimit=%u subLimit=%u)\n", static_cast<int>(err),
               stageLimit, subLimit);
        printf("[M17] recent err msg: %s\n", aclGetRecentErrMsg());
        return 1;
    }
    // host 墙钟**不构成证据**（tower 规则：共享卡上实测 24× 抖动）→ 每次运行都印原值并
    // 明确标注不可作为性能证据；抖动范围见 evidence/accept_run_m1_m64.log 的「连跑块」与 README §7.5
    printf("[M17] kernel 完成：host 墙钟 %.3f ms（含 launch/同步）—— host 墙钟在共享卡上"
           "**不构成证据**（抖动范围见 README §7.5），本 mission 不作任何性能断言\n", ms);

    std::vector<uint8_t> ws(M17::WS_BYTES);
    if (aclrtMemcpy(ws.data(), M17::WS_BYTES, wsDev, M17::WS_BYTES, ACL_MEMCPY_DEVICE_TO_HOST) != ACL_SUCCESS) {
        printf("[M17][FAIL] D2H workspace 失败\n");
        return 1;
    }
    char tag[128];
    snprintf(tag, sizeof(tag), "layer%u_tok%u_m%u", layer, token, m);
    if (doDump) {
        H_DumpWorkspace(dumpDir, tag, ws, m, M17::TOPK_MAX);
    }

    bool ok = true;
    const int passBeforeInv = H_Pass;
    ok = H_HostInvariants(ws, m, M17::TOPK_MAX) && ok;
    const int nInvPass = H_Pass - passBeforeInv;   // 不变量判据条数（不含后面的 cube 解包探针）
    const int nInvFail = H_Fail;

    // ---- nibble 解包探针（cube；A=单位阵）----
    if (doProbe) {
        printf("[M17] ---- MXFP4 权重 nibble 解包探针（cube：A=单位阵 → C[i][n]=dequant(W_e[n][i])）----\n");
        const size_t aPackedBytes = static_cast<size_t>(PROBE_M) * (M17::HIDDEN / 2);
        const size_t aScaleBytes = static_cast<size_t>(PROBE_M) * M17::GU_SCALE_STRIDE;
        const size_t cBytes = static_cast<size_t>(PROBE_M) * M17::GU_N * 2;
        std::vector<uint8_t> aPacked(aPackedBytes, 0);
        for (uint32_t i = 0; i < PROBE_M; ++i) {
            // e2m1 的 1.0 = code 0b0010；K 方向 lohi：偶 k 在低半字节。
            // 单位阵 → 第 i 行第 i 个 K 位置为 1.0，其余为 0。
            // 注意必须按行距 HIDDEN/2 = 1280B 定位（首版漏了行距，只有第 0 行有非零）
            aPacked[static_cast<size_t>(i) * (M17::HIDDEN / 2) + i / 2] =
                static_cast<uint8_t>((i % 2 == 0) ? 0x02 : 0x20);
        }
        std::vector<uint8_t> aScale(aScaleBytes, 0x7f);   // 2^0 = 1
        void* aP = nullptr;
        void* aS = nullptr;
        void* cDev = nullptr;
        aclrtMalloc(&aP, aPacked.size(), ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&aS, aScale.size(), ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMalloc(&cDev, cBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        aclrtMemcpy(aP, aPacked.size(), aPacked.data(), aPacked.size(), ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(aS, aScale.size(), aScale.data(), aScale.size(), ACL_MEMCPY_HOST_TO_DEVICE);
        // B = 真实 checkpoint 的 gate_up 第 0 个专家（packed + scale 指针已是 device 上的原样字节）
        m17_weight_probe_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(aP), reinterpret_cast<uint8_t*>(aS),
                                                 reinterpret_cast<uint8_t*>(wguDev), reinterpret_cast<uint8_t*>(sguDev),
                                                 reinterpret_cast<uint8_t*>(cDev));
        err = aclrtSynchronizeStream(stream);
        if (err != ACL_SUCCESS) {
            printf("[M17][FAIL] probe kernel error %d: %s\n", static_cast<int>(err), aclGetRecentErrMsg());
            return 1;
        }
        std::vector<uint8_t> cHost(cBytes);
        aclrtMemcpy(cHost.data(), cBytes, cDev, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);
        uint32_t mismatch = 0;
        uint32_t skipped = 0;
        H_ProbeExpect(W["gu_packed"], W["gu_scale"], 0, reinterpret_cast<const uint16_t*>(cHost.data()), &mismatch,
                      &skipped);
        H_Chk(mismatch == 0, "解包探针 C[i][n] == host 独立解包（%u/%u 不符，%u 跳过）", mismatch,
              static_cast<unsigned>(PROBE_M) * static_cast<unsigned>(M17::BASE_N), skipped);
        if (doDump) {
            H_WriteFile(dumpDir + "/probe_c_bf16.bin", cHost.data(), cHost.size());
            char spec[512];
            snprintf(spec, sizeof(spec),
                     "# M17 权重解包探针规格\n"
                     "expert=0（gate_up_proj 第 0 个专家，真实 checkpoint 字节）\n"
                     "probe_m=%u  probe_n_bases=BASE_N=%u\n"
                     "A = [%u, HIDDEN=%u] 单位阵 fp4（1.0 → code 0b0010，K 方向 lohi），scale 全 0x7f(=2^0)\n"
                     "C[i][n] = dequant(W_expert0[n][i])，i<%u，n<%u，bf16；行主序 [%u][GU_N=%u]，只有前 %u 列有效\n"
                     "C 文件：probe_c_bf16.bin（%zu B）\n",
                     PROBE_M, M17::BASE_N, PROBE_M, M17::HIDDEN, PROBE_M, M17::BASE_N, PROBE_M, M17::GU_N,
                     M17::BASE_N, cBytes);
            H_WriteText(dumpDir + "/probe_spec.txt", spec);
            printf("[M17][dump] probe_c_bf16.bin（%zu B）+ probe_spec.txt\n", cBytes);
        }
        ok = (mismatch == 0) && ok;
    }

    // ---- 关键数值摘要（供人眼快速判断"真实权重是否真的跑通"）----
    {
        const uint16_t* moe = reinterpret_cast<const uint16_t*>(ws.data() + M17::WS_MOE);
        const uint16_t* yfin = reinterpret_cast<const uint16_t*>(ws.data() + M17::WS_YFINAL);
        const float* logits = reinterpret_cast<const float*>(ws.data() + M17::WS_LOGITS);
        const int32_t* ids = reinterpret_cast<const int32_t*>(ws.data() + M17::WS_IDS);
        printf("[M17] ---- 数值摘要 ----\n");
        printf("[M17]   logits[0][top-10 ids] 行 max-shift 后：");
        double lmin = 1e30, lmax = -1e30;
        for (uint32_t e = 0; e < M17::NUM_EXPERTS; ++e) {
            lmin = std::min(lmin, static_cast<double>(logits[e]));
            lmax = std::max(lmax, static_cast<double>(logits[e]));
        }
        printf("min=%.4f max=%.4f\n", lmin, lmax);
        printf("[M17]   top-10 ids =");
        for (uint32_t k = 0; k < M17::TOPK_MAX; ++k) {
            printf(" %d", ids[k]);
        }
        printf("\n[M17]   moe[0][0..3]  = %.6g %.6g %.6g %.6g (bf16)\n", static_cast<double>(H_Bf16ToF32(moe[0])),
               static_cast<double>(H_Bf16ToF32(moe[1])), static_cast<double>(H_Bf16ToF32(moe[2])),
               static_cast<double>(H_Bf16ToF32(moe[3])));
        double acc = 0.0;
        for (uint32_t i = 0; i < M17::HIDDEN; ++i) {
            const double v = H_Bf16ToF32(moe[i]);
            acc += v * v;
        }
        printf("[M17]   moe[0] rms = %.6g；y_final[0] rms = ", std::sqrt(acc / M17::HIDDEN));
        acc = 0.0;
        for (uint32_t i = 0; i < M17::HIDDEN; ++i) {
            const double v = H_Bf16ToF32(yfin[i]);
            acc += v * v;
        }
        printf("%.6g\n", std::sqrt(acc / M17::HIDDEN));
    }

    printf("[M17] ================ 结果：host 判据 %d PASS / %d FAIL（其中不变量 %d 条 + cube 解包探针 %d 条）"
           "================\n",
           H_Pass, H_Fail, nInvPass, H_Pass - nInvPass);
    printf("[M17]   不变量 %d PASS / %d FAIL；解包探针 %d PASS / %d FAIL（--no-probe 时无探针）\n",
           nInvPass, nInvFail, H_Pass - nInvPass, H_Fail - nInvFail);
    if (doDump) {
        printf("[M17][dump] dump 目录 %s（ws_%s.bin + ws_meta_%s.txt + weight_bytecheck.log）\n",
               dumpDir.c_str(), tag, tag);
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (ok && H_Fail == 0) ? 0 : 1;
}
