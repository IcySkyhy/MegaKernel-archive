// ============================================================
// m27_hc_prefill.asc —— M119（Wave B5）**hc prefill 行分块（m-tile）的独立验证路**
//
// 被测对象 = `m15_layer_loop/m15_hc_prefill.h`（段体）+ `m15_hc_prefill_host.h`（host 几何/Plan）。
// 本目录**自成工程**（不碰 `m15_layer_loop/CMakeLists.txt`），本文件是唯一带 `main()` 的 TU。
//
// 它做三件事：
//   1. **设备入口** `m27_hc_prefill_kernel`：把指针/标量填成 `M15H::HcPF::Plan` 后调段体（段体不吃 LayerArgs）；
//   2. **host 数据**：确定性输入（纯公式，无 rand 状态）+ 权重（真实 checkpoint 切片 or 合成两档）；
//   3. **落盘**：把输入 / 权重 / 每个边界的输出（hcp/blk/injw/rstd）与（小 m 档）整块 arena 写成
//      `<case>_<tag>_<suffix>.bin` + `.meta` + `m27_layout.txt`；
//      **判据在 python**（`check_ref.py`，复用 `m20_hyperconn/check_ref.py::reference` 的独立
//      numpy float64 参考）—— 本文件只负责"把可判的东西摆到盘上"。
//
// 两个边界（**层内 handoff，zero-copy**）：
//   边界 #1（tag=a1）：hIn = 桩输入 H，bo = 桩 pending BO，ij = 独立 [m,16] 平面；
//   边界 #2（tag=a2，`M27_CHAIN=1`）：hIn = **边界 #1 的 arena 里的 H' 平铺面**（零拷贝、
//     直接就是 `arena1` 的第 0 行起），bo = 桩子层出口，ij = **边界 #1 重定位出来的平铺 ij 面**
//     （`ijFlat`；源 = 边界 #1 的 `OH[:,320:324)`）—— 即 M58 主张的"层内 handoff 不走 host"
//     在 prefill 尺度上的形态。
//     **为什么不直接把 arena 的 OH 区当 ij 源**：那块区在 arena 里**不持久**（块 t 的 OH inj 列
//     被块 t+17 附近的 H' 写覆盖）—— m=257 档实测只有 **22.2% 的行**等于参考的 OH inj 列。
//     若直接读它，A2 的判据会"两边都用同一份被覆盖的数据"而**假绿**；本路把重定位后的平铺面
//     落盘成 `<case>_a2_ij`，判据侧**再拿它跟参考的 OH inj 列比一次**（`a1.ij_handoff` 判定项）。
//
// 用法（见 README）：
//   source /usr/local/Ascend/ascend-toolkit/set_env.sh
//   cmake -B m27_hc_prefill/build -S m27_hc_prefill -DCMAKE_BUILD_TYPE=Release && cmake --build ... -j4
//   flock -w 900 /tmp/npu0.lock bash -c 'cd /tmp/m27_out && M27_DUMP=1 <build>/m27_hc_prefill'
//   python3.12 m27_hc_prefill/check_ref.py /tmp/m27_out            # 三态退出码
// env：M27_CASES=a,b（档过滤）M27_CHAIN=0/1 M27_SYNTH=1 M27_DUMP=1
//      M27_MUTANT=rowsteal|norel|ijfromoh（三个负向对照：块推进量少一行 / 关掉重定位 / ij 退回读 arena 的 OH 列）
//      M27_MUTANT=sinkreloc：掩码保持 0xF、把四个重定位落点旁路到 scratch ⇒ 被消费的四个平面留毒值
//      （= "重定位的输出没有到达该到的地方" 的值级负向对照；与 norel 的"掩码=0 ⇒ SKIP"是两种对照）
//      M27_ONLY_IJFLAT=1：只把 ij handoff 面当重定位目标（其余三个传 nullptr）—— P2-1 点名的配置，
//      判据侧据此把 blk/injw/rstd 的判定项记 SKIP（而不是把"没搬"误判成红）
//      M27_ARENA_MAX_BYTES=<n>（整块 arena 落盘的阈值，缺省 32MB）M27_LAYER=<n>（权重层号）
// ============================================================

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <algorithm>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

// 包含顺序（**硬要求**）：`m15_hc_layer.h` 是 `lift_hc_segment.py` 的机械产物、**没有 include
// guard** ⇒ 必须先于 `m15_hc_prefill.h` 包含；后者不自带对它的 include（与 m15_ple_wire.h 同款）。
#include "m15_hc_layer.h"           // donor：M15H::HyperConnOp / HcPtrs / BarrierAiv / …
#include "m15_hc_prefill.h"         // 被测对象（段体）
#include "m15_hc_prefill_host.h"    // host 几何 / Plan 组装 / 自检 / 布局落盘

// ============================================================
// P2-1 的**零设备**覆盖：重定位门限（`NeedReloc`）在**全部 16 种配置**上逐个钉死。
// 根因是"Body 的要不要搬"与"RelocateTile 的能不能早退"曾经是两处独立条件（且已漂移，前者漏了
// `p.ijFlat`）⇒ 现在两处共用同一个谓词，这里把谓词的真值表编成编译期断言：**构建不过 = 门限漂移**。
// 于是一个"只传 ij handoff 面、其余三个留 nullptr"的配置**不可能**再静默跳过重定位。
// ============================================================
namespace M27RelocGate {
using M15H::HcPF::NeedReloc;
constexpr bool Bit(uint32_t mask, uint32_t i) { return ((mask >> i) & 1u) != 0u; }
// 期望值 = 四个目标里"有没有非空的"（与 RelocateTile 的早退条件逐位同源）
constexpr bool Expect(uint32_t mask) { return Bit(mask, 0) || Bit(mask, 1) || Bit(mask, 2) || Bit(mask, 3); }
template <uint32_t MASK>
constexpr bool Ok()
{
    return NeedReloc(Bit(MASK, 0), Bit(MASK, 1), Bit(MASK, 2), Bit(MASK, 3)) == Expect(MASK);
}
static_assert(M27RelocGate::Ok<0x0>(), "四个目标都空 ⇒ 不进重定位 pass");
static_assert(M27RelocGate::Ok<0x1>(), "只传 blk ⇒ 必须进 pass");
static_assert(M27RelocGate::Ok<0x2>(), "只传 injw ⇒ 必须进 pass");
static_assert(M27RelocGate::Ok<0x4>(), "只传 rstd ⇒ 必须进 pass");
static_assert(M27RelocGate::Ok<0x8>(), "**只传 ijFlat（P2-1 点名的配置）⇒ 必须进 pass**");
static_assert(M27RelocGate::Ok<0x3>() && M27RelocGate::Ok<0x5>() && M27RelocGate::Ok<0x6>() &&
                  M27RelocGate::Ok<0x7>() && M27RelocGate::Ok<0x9>() && M27RelocGate::Ok<0xA>() &&
                  M27RelocGate::Ok<0xB>() && M27RelocGate::Ok<0xC>() && M27RelocGate::Ok<0xD>() &&
                  M27RelocGate::Ok<0xE>() && M27RelocGate::Ok<0xF>(),
              "其余 11 种组合也必须与 RelocateTile 的早退条件一致（16/16 覆盖）");
}  // namespace M27RelocGate

// ============================================================
// 设备入口（__mix__(1,2)：AIC:AIV = 1:2，核数由 host 用 API 取）
// ============================================================
extern "C" __global__ __mix__(1, 2) void m27_hc_prefill_kernel(
    __gm__ uint8_t* hIn, __gm__ uint8_t* bo, __gm__ uint8_t* ij, __gm__ uint8_t* wDown, __gm__ uint8_t* wInj,
    __gm__ uint8_t* wUp, __gm__ uint8_t* hcNorm, __gm__ uint8_t* arena, __gm__ uint8_t* blk,
    __gm__ uint8_t* injw, __gm__ uint8_t* rstd, __gm__ uint8_t* ijFlat, uint32_t hInTileStride,
    uint32_t boTileStride, uint32_t ijTileStride, uint32_t ijStride, uint32_t m, uint32_t mode)
{
    AscendC::InitSocState();
    // 设备入口组装 Plan（host 侧不构造 Plan：`__gm__` 是地址空间限定符，见段体头的 §接口约定）
    const M15H::HcPF::Plan p = M15H::HcPF::MakePlan(hIn, bo, ij, wDown, wInj, wUp, hcNorm, arena, blk, injw,
                                                    rstd, ijFlat, hInTileStride, boTileStride, ijTileStride,
                                                    ijStride, m, mode);
    M15H::HcPF::Body(p);
}

// ============================================================
// Host 侧
// ============================================================
using M15L::HcPfH::Align512;
using M15L::HcPfH::MT;
using M15L::HcPfH::ROW_HID;
using M15L::HcPfH::ROW_HP;
using M15L::HcPfH::TILE_STRIDE;

// ---- 形状（唯一源 = m15_hc_resources.h；本文件不写第二份数字）----
constexpr uint32_t HYPER = M15H::HYPER;
constexpr uint32_t HID = M15H::HID;
constexpr uint32_t HC = M15H::HC;
constexpr uint32_t LOWRANK = M15H::LOWRANK;
constexpr uint32_t M_MAX = M15H::M_MAX;
constexpr uint32_t INJ_STRIDE = M15H::IJ_STRIDE;
constexpr uint32_t INJW_SLOT = M15H::INJW_SLOT;
constexpr uint32_t OH_W = M15H::OH_W;
constexpr uint32_t OH_INJ = M15H::OH_INJ;
constexpr uint32_t WINJ_ROWS = 16u;   // donor 的 CopyInB 恒读 16 行（checkpoint 只有 INJ_N=4 行）
static_assert(WINJ_ROWS * HYPER * 2u == 327680u, "wInj 槽必须正好 16 行 × HYPER × 2B");

// ---- 确定性伪随机（m0/m1/m11/m20 同风格：纯公式，无 rand 状态）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

static uint16_t F32ToBf16Bits(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t bias = ((x >> 16) & 1u) + 0x7FFFu;
    return static_cast<uint16_t>((x + bias) >> 16);
}

static float Bf16BitsToF32(uint16_t h)
{
    const uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

// 生成一片 bf16（行主序；`amp` 为均匀分布的半宽，取值 = amp * q，q ∈ [-1,1] 的 1001 档）
static void GenBf16(std::vector<uint16_t>& out, uint32_t rows, uint32_t cols, uint32_t salt, double amp)
{
    out.assign(static_cast<size_t>(rows) * cols, 0u);
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t j = 0; j < cols; ++j) {
            const uint32_t h = Hash3(i, j, salt);
            const int32_t q = static_cast<int32_t>(h % 2001u) - 1000;
            const double v = amp * static_cast<double>(q) / 1000.0;
            out[static_cast<size_t>(i) * cols + j] = F32ToBf16Bits(static_cast<float>(v));
        }
    }
}

// ---- 权重 manifest（只读；格式见 m15_layer_loop/weights_manifest.txt 的头注释）----
struct M27Tensor {
    uint32_t layer = 0;
    std::string role;
    std::string file;
    uint64_t offset = 0;
    uint64_t bytes = 0;
};
struct M27Manifest {
    std::string modelDir;
    std::vector<M27Tensor> tensors;
};

static bool ManiKv(const std::string& line, const char* key, std::string& out)
{
    const std::string k = std::string(key) + "=";
    const size_t p = line.find(k);
    if (p == std::string::npos) {
        return false;
    }
    size_t e = line.find(' ', p);
    if (e == std::string::npos) {
        e = line.size();
    }
    out = line.substr(p + k.size(), e - (p + k.size()));
    return true;
}
static uint64_t ManiU64(const std::string& line, const char* key)
{
    std::string s;
    return ManiKv(line, key, s) ? strtoull(s.c_str(), nullptr, 10) : 0ull;
}

static bool LoadManifest(const char* path, M27Manifest& M)
{
    FILE* f = fopen(path, "rb");
    if (f == nullptr) {
        return false;
    }
    std::string text;
    char buf[4096];
    size_t n = 0;
    while ((n = fread(buf, 1, sizeof(buf), f)) > 0) {
        text.append(buf, n);
    }
    fclose(f);
    size_t p = 0;
    while (p <= text.size()) {
        size_t e = text.find('\n', p);
        if (e == std::string::npos) {
            e = text.size();
        }
        const std::string line = text.substr(p, e - p);
        p = e + 1;
        if (line.empty() || line[0] == '#') {
            continue;
        }
        if (line.rfind("model_dir=", 0) == 0) {
            M.modelDir = line.substr(10);
        } else if (line.rfind("tensor ", 0) == 0) {
            M27Tensor T;
            T.layer = static_cast<uint32_t>(ManiU64(line, "layer"));
            ManiKv(line, "role", T.role);
            ManiKv(line, "file", T.file);
            T.offset = ManiU64(line, "offset");
            T.bytes = ManiU64(line, "bytes");
            M.tensors.push_back(T);
        }
    }
    return !M.modelDir.empty() && !M.tensors.empty();
}

static const M27Tensor* FindTensor(const M27Manifest& M, uint32_t layer, const char* role, uint64_t want)
{
    for (const M27Tensor& T : M.tensors) {
        if (T.layer == layer && T.role == role && T.bytes == want) {
            return &T;
        }
    }
    return nullptr;
}

static bool ReadTensor(const M27Manifest& M, const M27Tensor& T, std::vector<uint8_t>& dst, std::string& err)
{
    const std::string path = M.modelDir + "/" + T.file;
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) {
        err = "cannot open " + path;
        return false;
    }
    dst.resize(static_cast<size_t>(T.bytes));
    if (fseek(f, static_cast<long>(T.offset), SEEK_SET) != 0) {
        fclose(f);
        err = "fseek failed";
        return false;
    }
    const size_t got = fread(dst.data(), 1, dst.size(), f);
    fclose(f);
    if (got != dst.size()) {
        err = "short read";
        return false;
    }
    return true;
}

// 一个边界的权重（设备槽形态：wInj 已补到 16 行、行 [4,16) 为 0）
struct WSet {
    std::vector<uint16_t> norm;   // [HYPER]
    std::vector<uint16_t> down;   // [LOWRANK, HYPER]
    std::vector<uint16_t> up;     // [UP_N, UP_K]
    std::vector<uint16_t> inj;    // [16, HYPER]
    bool real = false;
};

static void WSetSynth(WSet& W, uint32_t salt)
{
    W.real = false;
    GenBf16(W.norm, 1, HYPER, salt + 11u, 0.5);
    GenBf16(W.down, LOWRANK, HYPER, salt + 21u, 0.03);
    GenBf16(W.up, HYPER, LOWRANK, salt + 31u, 0.03);
    std::vector<uint16_t> inj4;
    GenBf16(inj4, M15H::INJ_N, HYPER, salt + 41u, 0.5);
    W.inj.assign(static_cast<size_t>(WINJ_ROWS) * HYPER, 0u);
    std::copy(inj4.begin(), inj4.end(), W.inj.begin());
}

// `boundary`：0 = attn 边界（role 前缀 attn_hc_*）、1 = mlp 边界（mlp_hc_*）
static bool WSetReal(const M27Manifest& M, uint32_t layer, uint32_t boundary, WSet& W, std::string& err)
{
    const char* pre = (boundary == 0u) ? "attn_hc_" : "mlp_hc_";
    const uint64_t bNorm = static_cast<uint64_t>(HYPER) * 2u;
    const uint64_t bDown = static_cast<uint64_t>(LOWRANK) * HYPER * 2u;
    const uint64_t bUp = static_cast<uint64_t>(HYPER) * LOWRANK * 2u;
    const uint64_t bInj = static_cast<uint64_t>(M15H::INJ_N) * HYPER * 2u;
    const struct { const char* role; uint64_t bytes; } spec[4] = {
        {"norm", bNorm}, {"down", bDown}, {"up", bUp}, {"inj", bInj}};
    std::vector<uint8_t> raw[4];
    for (uint32_t i = 0; i < 4u; ++i) {
        const std::string role = std::string(pre) + spec[i].role;
        const M27Tensor* T = FindTensor(M, layer, role.c_str(), spec[i].bytes);
        if (T == nullptr) {
            err = "manifest 缺 role=" + role;
            return false;
        }
        if (!ReadTensor(M, *T, raw[i], err)) {
            return false;
        }
    }
    auto to16 = [](const std::vector<uint8_t>& b) {
        std::vector<uint16_t> v(b.size() / 2u);
        __builtin_memcpy(v.data(), b.data(), b.size());
        return v;
    };
    W.norm = to16(raw[0]);
    W.down = to16(raw[1]);
    W.up = to16(raw[2]);
    const std::vector<uint16_t> inj4 = to16(raw[3]);
    W.inj.assign(static_cast<size_t>(WINJ_ROWS) * HYPER, 0u);
    std::copy(inj4.begin(), inj4.end(), W.inj.begin());   // 行 [INJ_N, 16) 保持 0（donor 契约）
    W.real = true;
    return true;
}

// ---- 落盘工具（<name>.bin + <name>.bin.meta：`<name> <dims...> <dtype>`，与 m20 同格式）----
static uint32_t gDumpCount = 0;
static void Wr(const char* name, const void* p, size_t bytes, const char* dims, const char* dtype)
{
    const std::string fn = std::string(name) + ".bin";
    FILE* f = fopen(fn.c_str(), "wb");
    if (f == nullptr) {
        printf("[m27][FAIL] 打不开 %s\n", fn.c_str());
        return;
    }
    fwrite(p, 1, bytes, f);
    fclose(f);
    FILE* fm = fopen((fn + ".meta").c_str(), "w");
    if (fm != nullptr) {
        fprintf(fm, "%s %s %s\n", name, dims, dtype);
        fclose(fm);
    }
    ++gDumpCount;
}

static uint64_t HashBytes(const void* p, size_t n)
{
    const uint8_t* q = static_cast<const uint8_t*>(p);
    uint64_t h = 1469598103934665603ull;
    for (size_t i = 0; i < n; ++i) {
        h ^= q[i];
        h *= 1099511628211ull;
    }
    return h;
}

static bool AllEq(const std::vector<uint8_t>& v, uint8_t val)
{
    for (uint8_t b : v) {
        if (b != val) {
            return false;
        }
    }
    return true;
}

// ============================================================
// 一个 case 的一次边界运行
// ============================================================
struct Dev {
    void* p = nullptr;
    size_t bytes = 0;
};

static Dev Alloc(size_t bytes, std::vector<uint8_t>* initFrom)
{
    Dev d;
    d.bytes = bytes;
    if (aclrtMalloc(&d.p, bytes, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        printf("[m27][FAIL] aclrtMalloc(%zu) 失败\n", bytes);
        d.p = nullptr;
        return d;
    }
    std::vector<uint8_t> z(bytes, 0u);
    if (initFrom != nullptr) {
        z = *initFrom;
    }
    aclrtMemcpy(d.p, bytes, z.data(), bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    return d;
}

static void Free(Dev& d)
{
    if (d.p != nullptr) {
        aclrtFree(d.p);
        d.p = nullptr;
    }
}

struct Args {
    uint32_t m = 1;
    uint32_t mode = M15H::MODE_COMBINE_MIX;
    const char* name = "case";
};

static uint32_t gRisk = 0;   // 报告项：跑过的 launch 次数

static bool RunBoundary(aclrtStream stream, uint32_t aicNum, const Args& A, const char* tag, Dev& hIn, Dev& bo,
                        Dev& ij, uint32_t ijStride, uint32_t ijTileStride, Dev& wNorm, Dev& wDown, Dev& wInj,
                        Dev& wUp, Dev& arena, Dev& blk, Dev& injw, Dev& rstd, Dev& ijFlat, uint32_t relocMask,
                        uint32_t mutateRowSteal, bool legacyIj, bool sinkDest, const Dev& sink)
{
    // ij 源有两种，但**都是平铺面**（OH 列的 handoff 由上一个边界重定位成平铺 ij 面，见 PROLOGUE ④）
    M15L::HcPfH::Geom g = M15L::HcPfH::GeomFlat(A.m, A.mode, ijStride);
    g.ijTileStride = ijTileStride;
    if ((g.ijTileStride % 32u) != 0u) {
        printf("[m27][FAIL] %s/%s ijTileStride 非 32B 倍数\n", A.name, tag);
        return false;
    }
    if (mutateRowSteal != 0u) {
        // 负向对照：块推进量各少一行（块与块重叠一行）⇒ 第 2 块起的输入错位。
        // 单块档（m ≤ MT）**不受影响**（块 0 的推进量用不到）——这一点在 README 里写清。
        g.hInTileStride -= ROW_HP;
        g.boTileStride -= ROW_HID;
    }
    auto alc = [](const Dev& d, bool use) {
        M15L::HcPfH::Alloc a;
        a.bytes = use ? d.bytes : 0u;
        a.aligned = ((reinterpret_cast<uint64_t>(d.p) & 31u) == 0u);
        return a;
    };
    auto has = [&](uint32_t bit) { return (relocMask & (1u << bit)) != 0u; };
    // `sinkDest`（负向对照 `sinkreloc`）：**掩码不变（0xF，契约仍要求四个面有值）**，但把四个落点
    // 全部旁路到一块 scratch ⇒ 被消费的四个平面**保持毒值** ⇒ 判据按契约照跑，应在**值级**变红。
    // 与 `norel`（掩码=0 = 调用方明确不要 ⇒ 判据记 SKIP + 毒值见证）是**两种不同的对照**：
    // 前者咬"重定位的输出有没有到达该到的地方"，后者咬"掩码 plumbing 有没有被尊重"。
    const std::string err = M15L::HcPfH::ValidateGeom(g, alc(arena, true), alc(blk, has(0)), alc(injw, has(1)),
                                                      alc(rstd, has(2)), legacyIj);
    if (!err.empty()) {
        printf("[m27][FAIL] %s/%s 几何自检失败：%s\n", A.name, tag, err.c_str());
        return false;
    }
    m27_hc_prefill_kernel<<<aicNum, 0, stream>>>(
        reinterpret_cast<uint8_t*>(hIn.p), reinterpret_cast<uint8_t*>(bo.p), reinterpret_cast<uint8_t*>(ij.p),
        reinterpret_cast<uint8_t*>(wDown.p), reinterpret_cast<uint8_t*>(wInj.p), reinterpret_cast<uint8_t*>(wUp.p),
        reinterpret_cast<uint8_t*>(wNorm.p), reinterpret_cast<uint8_t*>(arena.p),
        has(0) ? reinterpret_cast<uint8_t*>(sinkDest ? sink.p : blk.p) : nullptr,
        has(1) ? reinterpret_cast<uint8_t*>(sinkDest ? sink.p : injw.p) : nullptr,
        has(2) ? reinterpret_cast<uint8_t*>(sinkDest ? sink.p : rstd.p) : nullptr,
        has(3) ? reinterpret_cast<uint8_t*>(sinkDest ? sink.p : ijFlat.p) : nullptr, g.hInTileStride,
        g.boTileStride,
        g.ijTileStride, g.ijStride, g.m, g.mode);
    ++gRisk;
    return true;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc;
    (void)argv;
    const bool dump = (getenv("M27_DUMP") != nullptr);
    const bool synth = (getenv("M27_SYNTH") != nullptr);
    const bool chain = (getenv("M27_CHAIN") == nullptr) || (atoi(getenv("M27_CHAIN")) != 0);
    const char* filt = getenv("M27_CASES");
    const char* mut = getenv("M27_MUTANT");
    const uint32_t mutateRowSteal = (mut != nullptr && strcmp(mut, "rowsteal") == 0) ? 1u : 0u;
    const bool noReloc = (mut != nullptr && strcmp(mut, "norel") == 0);
    const bool legacyIjFromOh = (mut != nullptr && strcmp(mut, "ijfromoh") == 0);
    // 重定位目标的位掩码：bit0=blk / bit1=injw / bit2=rstd / bit3=ijFlat
    //   `M27_MUTANT=norel` ⇒ 0（四个都空：连 BarrierAiv 都不做）
    //   `M27_ONLY_IJFLAT=1` ⇒ 只留 bit3（**P2-1 点名的配置**：按 README §5(b) 省掉 blk/injw/rstd，
    //     只为 H2 传 ij handoff 面 —— 修前这一档会静默跳过重定位、ij 面留毒值）
    uint32_t relocMask = 0xFu;
    if (noReloc) {
        relocMask = 0x0u;
    }
    if (getenv("M27_ONLY_IJFLAT") != nullptr) {
        relocMask = 0x8u;
    }
    // `sinkreloc`：掩码保持 0xF（契约仍要求四个面有值），只把落点旁路到 scratch ⇒ 值级红
    const bool sinkReloc = (mut != nullptr && strcmp(mut, "sinkreloc") == 0);
    const uint32_t layer = (getenv("M27_LAYER") != nullptr) ? static_cast<uint32_t>(atoi(getenv("M27_LAYER"))) : 0u;
    const uint64_t arenaDumpMax = (getenv("M27_ARENA_MAX_BYTES") != nullptr)
                                      ? strtoull(getenv("M27_ARENA_MAX_BYTES"), nullptr, 10)
                                      : (32ull << 20);
    const uint32_t ijStride = INJ_STRIDE;

    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[m27][FAIL] aclInit failed\n");
        return 1;
    }
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        printf("[m27][FAIL] aclrtSetDevice failed\n");
        aclFinalize();
        return 1;
    }
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        printf("[m27][FAIL] aclrtCreateStream failed\n");
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }
    int64_t aicNum = 0;
    int64_t aivNum = 0;
    const aclError aicErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    const aclError aivErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum);
    if (aicErr != ACL_SUCCESS || aivErr != ACL_SUCCESS || aicNum <= 0 || aivNum != 2 * aicNum) {
        printf("[m27][FAIL] 核数读取失败/不成 2:1（aic=%lld aiv=%lld）\n", (long long)aicNum, (long long)aivNum);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }
    printf("[m27] 核数（API 取得）：AIC=%lld AIV=%lld（mix(1,2) 启动 numBlocks=AIC 数）\n", (long long)aicNum,
           (long long)aivNum);
    printf("[m27] 块几何：MT=%u TILE_STRIDE=%u WS_BYTES=%u UB_PEAK_PF=%u（UB_BYTES_TOTAL=%u）\n", MT,
           TILE_STRIDE, M15H::WS_BYTES, M15H::HcPF::UB_PEAK_PF, M15H::UB_BYTES_TOTAL);

    if (dump) {
        // 每个 case 写**自己**一份元数据文件（`m27_case_<名>.txt`）。
        // 不用"全局清单 + 每次调用截断"：那样**第二次调用会把第一批的元数据抹掉**（M119 实测栽过一次：
        // 小档 + m=4097 分批跑 ⇒ 判据只看见最后一批）。判据侧改为 glob `m27_case_*.txt` ⇒ 分批/补跑都成立。
        FILE* f = fopen("m27_cases.txt", "w");
        if (f != nullptr) {
            fprintf(f, "# 已被 `m27_case_*.txt` 取代（每个 case 一份元数据；分批跑不再互相覆盖）\n");
            fclose(f);
        }
    }

    // ---- 权重（两个边界各一套）----
    WSet W1;
    WSet W2;
    bool realW = false;
    std::string werr;
    if (!synth) {
        M27Manifest M;
        const char* mp = getenv("M27_MANIFEST");
        const char* mpath = (mp != nullptr) ? mp : "m15_layer_loop/weights_manifest.txt";
        if (!LoadManifest(mpath, M)) {
            werr = std::string("manifest 不可读：") + mpath;
        } else if (!WSetReal(M, layer, 0u, W1, werr) || !WSetReal(M, layer, 1u, W2, werr)) {
            // werr 已填
        } else {
            realW = true;
        }
    }
    if (!realW) {
        printf("[m27] 权重 = **合成**（原因：%s）\n", werr.empty() ? "M27_SYNTH=1" : werr.c_str());
        WSetSynth(W1, 101u);
        WSetSynth(W2, 202u);
    } else {
        printf("[m27] 权重 = 真实 checkpoint 切片（layer=%u；attn 边界用 attn_hc_*、mlp 边界用 mlp_hc_*）\n",
               layer);
    }

    Dev wNorm1 = Alloc(W1.norm.size() * 2u, nullptr);
    Dev wDown1 = Alloc(W1.down.size() * 2u, nullptr);
    Dev wUp1 = Alloc(W1.up.size() * 2u, nullptr);
    Dev wInj1 = Alloc(W1.inj.size() * 2u, nullptr);
    Dev wNorm2 = Alloc(W2.norm.size() * 2u, nullptr);
    Dev wDown2 = Alloc(W2.down.size() * 2u, nullptr);
    Dev wUp2 = Alloc(W2.up.size() * 2u, nullptr);
    Dev wInj2 = Alloc(W2.inj.size() * 2u, nullptr);
    aclrtMemcpy(wNorm1.p, wNorm1.bytes, W1.norm.data(), wNorm1.bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wDown1.p, wDown1.bytes, W1.down.data(), wDown1.bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wUp1.p, wUp1.bytes, W1.up.data(), wUp1.bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wInj1.p, wInj1.bytes, W1.inj.data(), wInj1.bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wNorm2.p, wNorm2.bytes, W2.norm.data(), wNorm2.bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wDown2.p, wDown2.bytes, W2.down.data(), wDown2.bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wUp2.p, wUp2.bytes, W2.up.data(), wUp2.bytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wInj2.p, wInj2.bytes, W2.inj.data(), wInj2.bytes, ACL_MEMCPY_HOST_TO_DEVICE);

    struct Case {
        const char* name;
        uint32_t m;
        uint32_t mode;
    };
    const Case cases[] = {
        {"m1", 1u, M15H::MODE_COMBINE_MIX},      {"m1_mix", 1u, M15H::MODE_MIX},
        {"m1_conly", 1u, M15H::MODE_COMBINE_ONLY}, {"m9", 9u, M15H::MODE_COMBINE_MIX},
        {"m33", 33u, M15H::MODE_COMBINE_MIX},    {"m64", 64u, M15H::MODE_COMBINE_MIX},
        {"m257", 257u, M15H::MODE_COMBINE_MIX},  {"m4097", 4097u, M15H::MODE_COMBINE_MIX},
        {"m4097_mix", 4097u, M15H::MODE_MIX},
    };

    bool allOk = true;
    for (const Case& cs : cases) {
        if (filt != nullptr) {
            const std::string fl = std::string(",") + filt + ",";
            const std::string me = std::string(",") + cs.name + ",";
            if (fl.find(me) == std::string::npos) {
                continue;
            }
        }
        const uint32_t m = cs.m;
        const uint64_t arenaBytes = M15L::HcPfH::ArenaBytes(m);
        const uint64_t arenaAlloc = M15L::HcPfH::ArenaBytesAligned(m);
        const uint64_t hInBytes = M15L::HcPfH::HpPlaneBytes(m);
        const uint64_t boBytes = M15L::HcPfH::HidPlaneBytes(m);
        const uint64_t ijBytes = M15L::HcPfH::IjPlaneBytes(m, ijStride);
        const uint64_t blkBytes = M15L::HcPfH::HidPlaneBytes(m);
        const uint64_t injwBytes = M15L::HcPfH::InjwPlaneBytes(m);
        const uint64_t rstdBytes = M15L::HcPfH::RstdPlaneBytes(m);
        printf("[m27] ==== case %s：m=%u mode=%u tiles=%u arena=%.2f MB ====\n", cs.name, m, cs.mode,
               M15L::HcPfH::TileCount(m), static_cast<double>(arenaBytes) / 1048576.0);

        // ---- 输入（确定性）----
        std::vector<uint16_t> hIn;
        std::vector<uint16_t> bo;
        std::vector<uint16_t> ij;
        std::vector<uint16_t> boAttn;
        GenBf16(hIn, m, HYPER, 0x51u, 1.0);
        GenBf16(bo, m, HID, 0x52u, 1.0);
        GenBf16(ij, static_cast<uint32_t>(ijBytes / (ijStride * 2u)), ijStride, 0x53u, 1.0);
        GenBf16(boAttn, m, HID, 0x54u, 1.1);
        hIn.resize(static_cast<size_t>(m) * HYPER);
        bo.resize(static_cast<size_t>(m) * HID);
        boAttn.resize(static_cast<size_t>(m) * HID);

        // ---- 设备缓冲 ----
        Dev dHIn = Alloc(hInBytes, nullptr);
        Dev dBo = Alloc(boBytes, nullptr);
        Dev dIj = Alloc(ijBytes, nullptr);
        Dev dBoAttn = Alloc(boBytes, nullptr);
        Dev dArena1 = Alloc(arenaAlloc, nullptr);
        Dev dArena2 = Alloc(arenaAlloc, nullptr);
        std::vector<uint8_t> poison(static_cast<size_t>(blkBytes), 0xCDu);
        Dev dBlk1 = Alloc(blkBytes, &poison);
        Dev dBlk2 = Alloc(blkBytes, &poison);
        std::vector<uint8_t> poisonW(static_cast<size_t>(injwBytes), 0xCDu);
        std::vector<uint8_t> poisonR(static_cast<size_t>(rstdBytes), 0xCDu);
        Dev dInjw1 = Alloc(injwBytes, &poisonW);
        Dev dInjw2 = Alloc(injwBytes, &poisonW);
        Dev dRstd1 = Alloc(rstdBytes, &poisonR);
        Dev dRstd2 = Alloc(rstdBytes, &poisonR);
        // 边界 #1 的重定位目标之一：平铺 ij 面（32 B/行，前 INJ_N 列有效；含 donor 恒读 M_MAX 行的余量）
        const uint64_t ijFlatBytes = M15L::HcPfH::IjFlatPlaneBytes(m);
        // `sinkreloc`（负向对照）的旁路 scratch：四类落点共用、大小取最宽的一个；只写不读
        const uint64_t sinkBytes = std::max(std::max(blkBytes, injwBytes), std::max(rstdBytes, ijFlatBytes));
        Dev dSink = Alloc(static_cast<size_t>(sinkBytes), nullptr);
        const uint64_t ijOutBytes = static_cast<uint64_t>(m) * M15H::INJ_N * 2u;
        std::vector<uint8_t> poisonO(static_cast<size_t>(ijFlatBytes), 0xCDu);
        Dev dIjFlat = Alloc(ijFlatBytes, &poisonO);
        if (dHIn.p == nullptr || dBo.p == nullptr || dIj.p == nullptr || dBoAttn.p == nullptr ||
            dArena1.p == nullptr || dArena2.p == nullptr || dBlk1.p == nullptr || dBlk2.p == nullptr ||
            dInjw1.p == nullptr || dInjw2.p == nullptr || dRstd1.p == nullptr || dRstd2.p == nullptr ||
            dIjFlat.p == nullptr || dSink.p == nullptr) {
            allOk = false;
            break;
        }
        aclrtMemcpy(dHIn.p, hInBytes, hIn.data(), hInBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dBo.p, boBytes, bo.data(), boBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dIj.p, ijBytes, ij.data(), ijBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(dBoAttn.p, boBytes, boAttn.data(), boBytes, ACL_MEMCPY_HOST_TO_DEVICE);

        Args A;
        A.m = m;
        A.mode = cs.mode;
        A.name = cs.name;

        // ---- 边界 #1 ----
        if (!RunBoundary(stream, static_cast<uint32_t>(aicNum), A, "a1", dHIn, dBo, dIj, ijStride,
                         M15H::HcPF::FlatIjTileStride(ijStride), wNorm1, wDown1, wInj1, wUp1, dArena1, dBlk1,
                         dInjw1, dRstd1, dIjFlat, relocMask, mutateRowSteal, false, sinkReloc, dSink)) {
            allOk = false;
            break;
        }
        // ---- 边界 #2（层内 handoff：hIn = 边界 #1 的 H' 平铺面；ij = 边界 #1 重定位的平铺 ij 面）----
        Dev dNoIjFlat;   // 边界 #2 没有下一个边界 ⇒ 不需要再产出 ij 面
        dNoIjFlat.p = nullptr;
        dNoIjFlat.bytes = 0u;
        if (chain && cs.mode != M15H::MODE_MIX && cs.mode != M15H::MODE_COMBINE_ONLY) {
            // ij 源 = 边界 #1 重定位出来的**平铺 ij 面**（零拷贝 handoff 的载体；见文件头 PROLOGUE）。
            // `M27_MUTANT=ijfromoh` = **负向对照**：把 A2 的 ij 源换回"直接读 arena 的 OH 列"
            // （已撤回的旧路径）⇒ **改前**读数（同一批判据由绿变红）；A1 的 ij handoff 面照旧产出
            // （它的判定项保持绿 ⇒ 说明红的是"ij 源"而不是"重定位本身"）。
            Dev dIjLegacy;
            dIjLegacy.p = static_cast<uint8_t*>(dArena1.p) + M15H::HcPF::OhInjOff();
            dIjLegacy.bytes = 0u;
            Dev& dIjA2 = legacyIjFromOh ? dIjLegacy : dIjFlat;
            const uint32_t ijStrideA2 = legacyIjFromOh ? OH_W : INJ_STRIDE;
            const uint32_t ijTileA2 = legacyIjFromOh ? M15H::HcPF::TILE_STRIDE
                                                     : M15H::HcPF::FlatIjTileStride(INJ_STRIDE);
            if (!RunBoundary(stream, static_cast<uint32_t>(aicNum), A, "a2", dArena1, dBoAttn, dIjA2, ijStrideA2,
                             ijTileA2, wNorm2, wDown2, wInj2, wUp2, dArena2,
                             dBlk2, dInjw2, dRstd2, dNoIjFlat, relocMask, 0u, legacyIjFromOh, sinkReloc,
                             dSink)) {
                allOk = false;
                break;
            }
        }
        if (aclrtSynchronizeStream(stream) != ACL_SUCCESS) {
            printf("[m27][FAIL] synchronize 失败（case %s）\n", cs.name);
            allOk = false;
            break;
        }

        // ---- D2H + 落盘 ----
        std::vector<uint8_t> arena1H(static_cast<size_t>(arenaBytes));
        std::vector<uint8_t> arena2H(static_cast<size_t>(arenaBytes));
        std::vector<uint8_t> hcp1(static_cast<size_t>(hInBytes));
        std::vector<uint8_t> hcp2(static_cast<size_t>(hInBytes));
        aclrtMemcpy(arena1H.data(), arena1H.size(), dArena1.p, arena1H.size(), ACL_MEMCPY_DEVICE_TO_HOST);
        aclrtMemcpy(arena2H.data(), arena2H.size(), dArena2.p, arena2H.size(), ACL_MEMCPY_DEVICE_TO_HOST);
        std::copy(arena1H.begin(), arena1H.begin() + hcp1.size(), hcp1.begin());
        std::copy(arena2H.begin(), arena2H.begin() + hcp2.size(), hcp2.begin());

        // 判据侧要用的平铺 ij 面（= 边界 #1 的 OH inj 列重定位结果）：直接从设备读回**整块面**。
        // ⚠ 这块面的**行距是 32 B**（IJ_STRIDE 元素、只有前 INJ_N 列有效）⇒ 落盘必须按 (m, IJ_STRIDE)
        //   写、判据侧再切前 INJ_N 列。**不能**只搬前 m*INJ_N*2 字节（那是"把 32B 行距当 8B 行距读"，
        //   M119 第二版就栽在这：m=9 档只有第 0 行的 4 个值对，逐位率恰好 = 4/36）。
        std::vector<uint8_t> ijOh(static_cast<size_t>(m) * M15H::IJ_STRIDE * 2u, 0u);
        aclrtMemcpy(ijOh.data(), ijOh.size(), dIjFlat.p, ijOh.size(), ACL_MEMCPY_DEVICE_TO_HOST);

        // ---- host 侧"响亮失败"三条（判据在 python；这三条只保证"摆上台面的东西真的被写过"）----
        {
            bool ok1 = false;
            if (cs.mode == M15H::MODE_MIX) {
                // mode 0（mix-only）不产出 combine ⇒ H' 不物化：**块 0..(WS_XN/TILE_STRIDE-1) 的 HCP 行**
                // 必须仍是零（没有任何写碰过它们）。更靠后的 HCP 行会被**更早块**的 scratch
                // （XN/X2 区）覆盖成非零 —— 那是 arena 的行页布局的必然，不是本档的失败
                // （mode MIX 的消费方本来就该用 `hIn`，与 decode 的 hcpFromWs=false 分支同口径）。
                const uint64_t safeRows = (static_cast<uint64_t>(M15H::WS_XN / M15H::HcPF::TILE_STRIDE)) * MT;
                const size_t safeBytes = static_cast<size_t>((m < safeRows) ? m : safeRows) * ROW_HP;
                bool zero = true;
                for (size_t b = 0; b < safeBytes; ++b) {
                    if (hcp1[b] != 0u) {
                        zero = false;
                        break;
                    }
                }
                ok1 = zero;
                printf("[m27] A1 HCP 未被写出（mode MIX；只查前 %llu 行 = 无更早块 scratch 覆盖的行）：%s\n",
                       (unsigned long long)(safeRows < m ? safeRows : m), zero ? "OK" : "FAIL");
            } else {
                ok1 = !AllEq(hcp1, 0u) && (HashBytes(hcp1.data(), hcp1.size()) != 0u);
                printf("[m27] A1 HCP 已写出：%s\n", ok1 ? "OK" : "FAIL");
            }
            allOk = allOk && ok1;
            std::vector<uint8_t> blkH(static_cast<size_t>(blkBytes));
            std::vector<uint8_t> injwH(static_cast<size_t>(injwBytes));
            std::vector<uint8_t> rstdH(static_cast<size_t>(rstdBytes));
            aclrtMemcpy(blkH.data(), blkH.size(), dBlk1.p, blkH.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            aclrtMemcpy(injwH.data(), injwH.size(), dInjw1.p, injwH.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            aclrtMemcpy(rstdH.data(), rstdH.size(), dRstd1.p, rstdH.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            // 哪些张量在**这一档 mode** 下本来就该被写出（由 donor 的段序决定，见 README §4.3）：
            //   mode MIX(0)          ：不跑 W0/combine ⇒ injw 不写；norm/silu/gate 照跑 ⇒ blk/rstd 写
            //   mode COMBINE_ONLY(3) ：只跑 W0+S1 ⇒ 只写 injw 与 H'（blk/rstd 不写）
            const bool wantBlk = (cs.mode != M15H::MODE_COMBINE_ONLY);
            const bool wantInjw = (cs.mode != M15H::MODE_MIX);
            const bool wantRstd = (cs.mode != M15H::MODE_COMBINE_ONLY);
            // ij handoff 面：只有会产出 injection logits 的档才写；写了就必须不再是毒值
            bool okIJ = true;
            if (cs.mode != M15H::MODE_MIX && cs.mode != M15H::MODE_COMBINE_ONLY) {
                std::vector<uint8_t> ijH(static_cast<size_t>(m) * M15H::IJ_STRIDE * 2u, 0u);
                aclrtMemcpy(ijH.data(), ijH.size(), dIjFlat.p, ijH.size(), ACL_MEMCPY_DEVICE_TO_HOST);
                okIJ = !AllEq(ijH, 0xCDu);
            }
            const bool okB = wantBlk ? !AllEq(blkH, 0xCDu) : true;
            const bool okI = wantInjw ? !AllEq(injwH, 0xCDu) : true;
            const bool okR = wantRstd ? !AllEq(rstdH, 0xCDu) : true;
            printf("[m27] A1 重定位（应写出的张量不再是毒值；want blk/injw/rstd=%u/%u/%u）："
                   "blk=%s injw=%s rstd=%s\n",
                   wantBlk ? 1u : 0u, wantInjw ? 1u : 0u, wantRstd ? 1u : 0u, okB ? "OK" : "FAIL",
                   okI ? "OK" : "FAIL", okR ? "OK" : "FAIL");
            printf("[m27] A1 ij handoff 面（不再是毒值）：%s\n", okIJ ? "OK" : "FAIL");
            allOk = allOk && okB && okI && okR && okIJ;
        }

        if (dump) {
            char nm[160];
            char dims[96];
            auto shp2 = [&](uint32_t r, uint32_t c) { snprintf(dims, sizeof(dims), "%u %u", r, c); };
            snprintf(nm, sizeof(nm), "%s_a1_hin", cs.name);
            Wr(nm, hIn.data(), hInBytes, (shp2(m, HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "%s_a1_bo", cs.name);
            Wr(nm, bo.data(), boBytes, (shp2(m, HID), dims), "BF16");
            snprintf(nm, sizeof(nm), "%s_a1_ij", cs.name);
            Wr(nm, ij.data(), static_cast<size_t>(m) * ijStride * 2u, (shp2(m, ijStride), dims), "BF16");
            snprintf(nm, sizeof(nm), "%s_a1_hcp", cs.name);
            Wr(nm, hcp1.data(), hcp1.size(), (shp2(m, HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "%s_a2_hin", cs.name);
            Wr(nm, hcp1.data(), hcp1.size(), (shp2(m, HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "%s_a2_bo", cs.name);
            Wr(nm, boAttn.data(), boBytes, (shp2(m, HID), dims), "BF16");
            snprintf(nm, sizeof(nm), "%s_a1_ij_handoff", cs.name);   // 边界 #1 产出的平铺 ij 面（m 行 × 32 B）
            Wr(nm, ijOh.data(), ijOh.size(), (shp2(m, M15H::IJ_STRIDE), dims), "BF16");
            snprintf(nm, sizeof(nm), "%s_a2_hcp", cs.name);
            Wr(nm, hcp2.data(), hcp2.size(), (shp2(m, HYPER), dims), "BF16");
            std::vector<uint8_t> v(static_cast<size_t>(blkBytes));
            aclrtMemcpy(v.data(), v.size(), dBlk1.p, v.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            snprintf(nm, sizeof(nm), "%s_a1_blk", cs.name);
            Wr(nm, v.data(), v.size(), (shp2(m, HID), dims), "BF16");
            aclrtMemcpy(v.data(), v.size(), dBlk2.p, v.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            snprintf(nm, sizeof(nm), "%s_a2_blk", cs.name);
            Wr(nm, v.data(), v.size(), (shp2(m, HID), dims), "BF16");
            v.assign(static_cast<size_t>(injwBytes), 0u);
            aclrtMemcpy(v.data(), v.size(), dInjw1.p, v.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            snprintf(nm, sizeof(nm), "%s_a1_injw", cs.name);
            Wr(nm, v.data(), v.size(), (shp2(m, HC * INJW_SLOT), dims), "F32");
            aclrtMemcpy(v.data(), v.size(), dInjw2.p, v.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            snprintf(nm, sizeof(nm), "%s_a2_injw", cs.name);
            Wr(nm, v.data(), v.size(), (shp2(m, HC * INJW_SLOT), dims), "F32");
            // rstd：平面上有 m+1 行（成对搬会多写 16 B），**落盘只写前 m 行** ——
            // 文件的字节数必须与 meta 里的形状严格一致（否则判据侧 reshape 会失败）
            const size_t rstdOut = static_cast<size_t>(m) * HC * 4u;
            v.assign(static_cast<size_t>(rstdBytes), 0u);
            aclrtMemcpy(v.data(), v.size(), dRstd1.p, v.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            snprintf(nm, sizeof(nm), "%s_a1_rstd", cs.name);
            Wr(nm, v.data(), rstdOut, (shp2(m, HC), dims), "F32");
            aclrtMemcpy(v.data(), v.size(), dRstd2.p, v.size(), ACL_MEMCPY_DEVICE_TO_HOST);
            snprintf(nm, sizeof(nm), "%s_a2_rstd", cs.name);
            Wr(nm, v.data(), rstdOut, (shp2(m, HC), dims), "F32");
            // 权重（一份，所有 case 共用）
            auto shp1 = [&](uint32_t c) { snprintf(dims, sizeof(dims), "1 %u", c); };
            snprintf(nm, sizeof(nm), "w_a1_norm");
            Wr(nm, W1.norm.data(), W1.norm.size() * 2u, (shp1(HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "w_a1_down");
            Wr(nm, W1.down.data(), W1.down.size() * 2u, (shp2(LOWRANK, HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "w_a1_up");
            Wr(nm, W1.up.data(), W1.up.size() * 2u, (shp2(HYPER, LOWRANK), dims), "BF16");
            snprintf(nm, sizeof(nm), "w_a1_inj");
            Wr(nm, W1.inj.data(), W1.inj.size() * 2u, (shp2(WINJ_ROWS, HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "w_a2_norm");
            Wr(nm, W2.norm.data(), W2.norm.size() * 2u, (shp1(HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "w_a2_down");
            Wr(nm, W2.down.data(), W2.down.size() * 2u, (shp2(LOWRANK, HYPER), dims), "BF16");
            snprintf(nm, sizeof(nm), "w_a2_up");
            Wr(nm, W2.up.data(), W2.up.size() * 2u, (shp2(HYPER, LOWRANK), dims), "BF16");
            snprintf(nm, sizeof(nm), "w_a2_inj");
            Wr(nm, W2.inj.data(), W2.inj.size() * 2u, (shp2(WINJ_ROWS, HYPER), dims), "BF16");
            // arena（小档）：判据侧据此复算"阻塞布局"与"被覆盖"两件事
            if (arenaBytes <= arenaDumpMax) {
                snprintf(nm, sizeof(nm), "%s_arena1", cs.name);
                snprintf(dims, sizeof(dims), "%llu", (unsigned long long)arenaBytes);
                Wr(nm, arena1H.data(), arena1H.size(), dims, "U8");
                snprintf(nm, sizeof(nm), "%s_arena2", cs.name);
                Wr(nm, arena2H.data(), arena2H.size(), dims, "U8");
            }
        }

        // ---- case 头 ----
        if (dump) {
            char cp[128];
            snprintf(cp, sizeof(cp), "m27_case_%s.txt", cs.name);
            FILE* f = fopen(cp, "w");
            if (f != nullptr) {
                fprintf(f, "case %s m %u mode %u mt %u tiles %u arena_bytes %llu real_w %u chain %u "
                           "mutant %s ub_peak_pf %u arena_dumped %u reloc_mask %u\n",
                        cs.name, m, cs.mode, MT, M15L::HcPfH::TileCount(m),
                        (unsigned long long)arenaBytes, realW ? 1u : 0u, chain ? 1u : 0u,
                        (mut != nullptr) ? mut : "none", M15H::HcPF::UB_PEAK_PF,
                        (arenaBytes <= arenaDumpMax) ? 1u : 0u, relocMask);
                fclose(f);
            }
            char lp[128];
            snprintf(lp, sizeof(lp), "m27_layout_%s.txt", cs.name);
            FILE* fl = fopen(lp, "w");
            if (fl != nullptr) {
                const M15L::HcPfH::Geom g = M15L::HcPfH::GeomFlat(m, cs.mode, ijStride);
                M15L::HcPfH::DumpLayout(fl, cs.name, g, (arenaBytes <= arenaDumpMax), chain);
                fprintf(fl, "hin_a2_is_arena1=%u\nmutant=%s\nreloc_blk=%u reloc_injw=%u reloc_rstd=%u\n",
                        chain ? 1u : 0u, (mut != nullptr) ? mut : "none", noReloc ? 0u : 1u,
                        noReloc ? 0u : 1u, noReloc ? 0u : 1u);
                fclose(fl);
            }
        }

        Free(dHIn);
        Free(dBo);
        Free(dIj);
        Free(dBoAttn);
        Free(dArena1);
        Free(dArena2);
        Free(dBlk1);
        Free(dBlk2);
        Free(dInjw1);
        Free(dInjw2);
        Free(dRstd1);
        Free(dRstd2);
        Free(dSink);
        Free(dIjFlat);
        printf("[m27] case %s 完成（dump=%s 文件数=%u）\n", cs.name, dump ? "on" : "off", gDumpCount);
    }

    Free(wNorm1);
    Free(wDown1);
    Free(wUp1);
    Free(wInj1);
    Free(wNorm2);
    Free(wDown2);
    Free(wUp2);
    Free(wInj2);
    printf("[m27] 共 %u 次 launch；dump 文件 %u 个\n", gRisk, gDumpCount);
    printf("[m27] ===== %s（host 侧自检）=====\n", allOk ? "OK" : "FAIL");
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
