/**
 * m26_moe_prefill.asc —— M118（B4）MoE **prefill 段**的独立验证工程（含 `main()`）
 *
 * 被测对象 = `m15_layer_loop/m15_moe_prefill.h`（交付到融合 TU 的**同一份头**），
 * 本工程只是它的独立靶场（`docs/15` §M103-2.0 的 P1：Wave B 一律不碰 `m15_layer_loop/CMakeLists.txt`）。
 *
 * 真实 shape（人类裁决②：打通阶段也要用真实 shape）：
 *   `E = 512`、`topk = 10`、`HIDDEN = 2560`、`INTER = 640`、MXFP4(group=32)；
 *   m 按 `MT = 64` 行分块（运行期 m ∈ [1, 4097]）。
 * 真实权重（不做任何合成）：`m17_moe_real/m17_weight_manifest.txt` 指向的
 *   `/workspace/Qwen3.8-Flash-Next-MXFP4` 里 layer 0 的 `mlp.gate.weight`（router W，512×2560 bf16）
 *   与 `mlp.shared_expert_gate.weight`（共享门，1×2560 bf16）；
 *   输入 x = `embed_tokens.weight` 的真实行（layer 0 的层输入）。
 *
 * 本轮验的是 **S2（router）**：`x[MT,2560] bf16 @ W[E_PAD,2560]^T bf16 → logits fp32`（AIC 上的 `Mmad`）
 *   + AIV 的 softmax/top-k/renorm（`Sort32`/`MrgSort` 裁定例外路径）。
 *   `m15_moe_prefill.h` 里 S1/S3–S10 的段体已交付（见该文件的段序头注），本靶场按 `--stage` 逐段扩展。
 *
 * 判据（`docs/17`）：判定项 / 报告项 / guard 三类，见 `check_ref.py`。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>
#include <map>
#include <sys/stat.h>
#include <fcntl.h>
#include <unistd.h>

// **必须先于 m15_moe_prefill.h**：这两个头没有 include guard，提供全局作用域的 pipeline 帮手
#include "m15_gdn_layer.h"
#include "m15_hc_layer.h"
// **必须先于 m15_moe_prefill.h**：后者在 :66 include `m15_layer_resources.h`，而资源表 §4 的
// `FLAG_SEQ[]` 直接引用 `M85P::FLAG_B2/B3/B4`（`:728-737`）。`M85P` 只由 `m15_ple_wire.h` 提供
// ⇒ 缺这一行则 §4 起报 `use of undeclared identifier 'M85P'`（及其级联的 `sizeof`/`static_assert`
// 报错）。`m15_ple_wire.h` 本身要求先有 `m15_hc_layer.h`（它复用 `M15H::NormDonor`/`BarrierAiv`
// 等），上面的包含序已满足。
#include "m15_ple_wire.h"
#include "m15_moe_prefill.h"

// ============================================================
// device kernel
// ============================================================
__global__ __mix__(1, 2) void m26_router_kernel(__gm__ uint8_t* ws, __gm__ uint8_t* x, __gm__ uint8_t* wpad,
                                                __gm__ uint8_t* gamma1, __gm__ uint8_t* resZero,
                                                __gm__ uint8_t* yLayer, uint32_t m, uint32_t stageLimit)
{
    AscendC::InitSocState();
    // stageLimit=3：**链路臂** —— 跑 `MoePrefillChain` 的 S1 + S2/S2b + S3 + S4（stageLimit=3），
    // 也就是**唯一**会执行 `ig.Run()` 的臂。r1 复审 P1-1 指出：原来的 stage-2 臂只跑
    // `RouterMmadStage`+`RouterTopkStage`，**从不执行 S3**，所以"S3 由 AIV0 单核标量读全量
    // ids/weights（由全部 AIV 写）"这条跨核依赖在设备档里完全没有覆盖 ⇒ 本臂就是为了咬住它。
    // AIC 侧 sl=3 时只跑 router 就返回（`ProcessAic` 的 `sl < 5` 提前返回），故不需要真 MoE 权重。
    if (stageLimit == 3u) {
        M15MP::MoePrefillPtrs pf = {};
        pf.ws = ws;
        pf.xLayer = x;
        pf.yLayer = yLayer;
        pf.resZero = resZero;
        pf.gamma1 = gamma1;
        pf.gamma2 = gamma1;      // S10 在 sl=3 不跑，只为 Init 传参
        pf.routerWpad = wpad;
        pf.wGu = x; pf.sGu = x; pf.wDn = x; pf.sDn = x;
        pf.wGuShd = x; pf.sGuShd = x; pf.wDnShd = x; pf.sDnShd = x;
        pf.m = m;
        pf.topk = M15PFR::TOPK;
        pf.stageLimit = 3u;
        M15MP::MoePrefillChain chain;
        chain.Init(pf);
        if ASCEND_IS_AIV {
            chain.ProcessAiv();
        }
        if ASCEND_IS_AIC {
            chain.ProcessAic();
        }
    }
    if ASCEND_IS_AIC {
        if (stageLimit == 2u) {
            M15MP::RouterMmadStage r;
            r.Init(x, wpad, ws + M15PFR::PWS_LOGITS, m);
            const uint32_t bid = AscendC::GetBlockIdx();
            const uint32_t nb = AscendC::GetBlockNum();
            for (uint32_t j = bid; j < M15PFR::RB_NBLK; j += nb) {
                r.RunTile(j);
            }
            // 全体 AIC 对齐 → 再逐个 AIC set mode-2（每个 AIC 覆盖它配对的 2 个 AIV ⇒ 全体 AIV 都被唤醒）
            AscendC::CrossCoreSetFlag<M15PFR::PFR_CC_MODE0, PIPE_FIX>(M15PFR::PFR_FLAG_AIC_RING[0]);
            AscendC::CrossCoreWaitFlag<M15PFR::PFR_CC_MODE0, PIPE_S>(M15PFR::PFR_FLAG_AIC_RING[0]);
            AscendC::CrossCoreSetFlag<M15PFR::PFR_CC_MODE2, PIPE_MTE2>(M15PFR::PFR_FLAG_M2_RING[0]);
        }
    }
    if ASCEND_IS_AIV {
        // stageLimit=4：**活性探针** —— AIV 只把 logits 的一行 8 字节 DMA 到 sgate 平面（不等 AIC）
        if (stageLimit == 4u) {
            AscendC::LocalTensor<float> bL(TPosition::VECCALC, M15PFR::UB_PERSIST, 32);
            AscendC::GlobalTensor<float> lg;
            lg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws + M15PFR::PWS_LOGITS));
            AscendC::GlobalTensor<float> sg;
            sg.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws + M15PFR::PWS_SGATE));
            BufAcquire<PIPE_MTE2>(M15PFR::PFR_BUF_ROW0);
            PipeBarrier<PIPE_MTE2>();
            DataCopyPad(bL, lg[static_cast<uint64_t>(AscendC::GetBlockIdx()) * M15PFR::E_PAD], M15M::ExtBlock1(32),
                        DataCopyPadExtParams<float>{false, 0, 0, 0});
            BufRelease<PIPE_MTE2>(M15PFR::PFR_BUF_ROW0);
            BufAcquire<PIPE_MTE3>(M15PFR::PFR_BUF_ROW1);
            DataCopyPad(sg[AscendC::GetBlockIdx() * 8u], bL, M15M::ExtBlock1(32));
            BufRelease<PIPE_MTE3>(M15PFR::PFR_BUF_ROW1);
        }
        if (stageLimit == 2u) {
            AscendC::CrossCoreWaitFlag<M15PFR::PFR_CC_MODE2, PIPE_MTE2>(M15PFR::PFR_FLAG_M2_RING[0]);
            M15MP::RouterTopkStage t;
            t.Init(ws + M15PFR::PWS_LOGITS, ws + M15PFR::PWS_IDS, ws + M15PFR::PWS_W, ws + M15PFR::PWS_SGATE, m);
            t.Run(AscendC::GetBlockIdx(), AscendC::GetBlockNum() * 2u);
        }
    }
    // stageLimit=99：**只编译不运行**的实例化臂 —— 把整条 S1–S10 链的代码生成纳入编译单元，
    // 使 `MoePrefillChain`（含 `IndexGenP`/`VecQuantP`/`UnpermuteStage<1..10>` 的展开）真正被实例化。
    // 本轮**不执行**它（指针全空），见 README「未完成项」。
    if (stageLimit == 99u) {
        M15MP::MoePrefillPtrs pf = {};
        pf.ws = ws;
        pf.xLayer = x;
        pf.yLayer = x;
        pf.resZero = x;
        pf.gamma1 = x;
        pf.gamma2 = x;
        pf.routerWpad = wpad;
        pf.wGu = x; pf.sGu = x; pf.wDn = x; pf.sDn = x;
        pf.wGuShd = x; pf.sGuShd = x; pf.wDnShd = x; pf.sDnShd = x;
        pf.m = m;
        pf.topk = M15PFR::TOPK;
        pf.stageLimit = 8u;
        M15MP::MoePrefillChain chain;
        chain.Init(pf);
        if ASCEND_IS_AIV {
            chain.ProcessAiv();
        }
        if ASCEND_IS_AIC {
            chain.ProcessAic();
        }
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// host 侧：manifest / pread / 组板 / 启动 / 落盘
// ============================================================
namespace {

struct MTensor {
    std::string file;
    uint64_t off = 0;
    uint64_t bytes = 0;
    std::string dtype;
    uint64_t rows = 0;
    uint64_t cols = 0;
    uint64_t row0 = 0;
    uint64_t nrows = 0;
};

bool HPread(const std::string& path, uint64_t off, void* dst, size_t bytes)
{
    const int fd = ::open(path.c_str(), O_RDONLY);
    if (fd < 0) {
        return false;
    }
    size_t done = 0;
    while (done < bytes) {
        const ssize_t n = ::pread(fd, static_cast<uint8_t*>(dst) + done, bytes - done,
                                  static_cast<off_t>(off + done));
        if (n <= 0) {
            ::close(fd);
            return false;
        }
        done += static_cast<size_t>(n);
    }
    ::close(fd);
    return true;
}

bool HParseManifest(const std::string& path, std::map<std::string, MTensor>& tensors, std::string& modelDir)
{
    FILE* fp = ::fopen(path.c_str(), "r");
    if (fp == nullptr) {
        return false;
    }
    char line[4096];
    while (::fgets(line, sizeof(line), fp) != nullptr) {
        std::string s(line);
        if (s.empty() || s[0] == '#') {
            continue;
        }
        if (s.rfind("model_dir=", 0) == 0) {
            modelDir = s.substr(10);
            while (!modelDir.empty() && (modelDir.back() == '\n' || modelDir.back() == '\r')) {
                modelDir.pop_back();
            }
            continue;
        }
        if (s.rfind("tensor ", 0) != 0) {
            continue;
        }
        MTensor t;
        std::string role;
        size_t p = 7;
        while (p < s.size()) {
            const size_t eq = s.find('=', p);
            if (eq == std::string::npos) {
                break;
            }
            const std::string k = s.substr(p, eq - p);
            size_t end = s.find(' ', eq);
            if (end == std::string::npos) {
                end = s.size();
            }
            std::string v = s.substr(eq + 1, end - eq - 1);
            while (!v.empty() && (v.back() == '\n' || v.back() == '\r')) {
                v.pop_back();
            }
            if (k == "role") {
                role = v;
            } else if (k == "file") {
                t.file = v;
            } else if (k == "offset") {
                t.off = std::strtoull(v.c_str(), nullptr, 10);
            } else if (k == "bytes") {
                t.bytes = std::strtoull(v.c_str(), nullptr, 10);
            } else if (k == "dtype") {
                t.dtype = v;
            } else if (k == "rows") {
                t.rows = std::strtoull(v.c_str(), nullptr, 10);
            } else if (k == "cols") {
                t.cols = std::strtoull(v.c_str(), nullptr, 10);
            } else if (k == "row0") {
                t.row0 = std::strtoull(v.c_str(), nullptr, 10);
            } else if (k == "nrows") {
                t.nrows = std::strtoull(v.c_str(), nullptr, 10);
            }
            p = end + 1;
        }
        if (!role.empty()) {
            tensors[role] = t;
        }
    }
    ::fclose(fp);
    return true;
}

bool HWriteBin(const std::string& path, const void* data, size_t bytes)
{
    FILE* fp = ::fopen(path.c_str(), "wb");
    if (fp == nullptr) {
        return false;
    }
    const size_t n = ::fwrite(data, 1, bytes, fp);
    ::fclose(fp);
    return n == bytes;
}

uint16_t HToU16(const void* p) { uint16_t v; std::memcpy(&v, p, 2); return v; }
float HToF32(const void* p) { float v; std::memcpy(&v, p, 4); return v; }

}  // namespace

int32_t main(int32_t argc, char** argv)
{
    std::string manifest = "../m17_moe_real/m17_weight_manifest.txt";
    std::string outDir = "m26_out";
    uint32_t m = M15PFR::MT;
    uint32_t stageLimit = 2u;
    for (int32_t i = 1; i < argc; ++i) {
        const std::string a = argv[i];
        if (a == "--manifest" && i + 1 < argc) {
            manifest = argv[++i];
        } else if (a == "--out" && i + 1 < argc) {
            outDir = argv[++i];
        } else if (a == "--m" && i + 1 < argc) {
            m = static_cast<uint32_t>(std::strtoul(argv[++i], nullptr, 10));
        } else if (a == "--stage" && i + 1 < argc) {
            stageLimit = static_cast<uint32_t>(std::strtoul(argv[++i], nullptr, 10));
        } else {
            std::printf("unknown arg: %s\n", a.c_str());
            return 2;
        }
    }
    if (m < 1u || m > M15PFR::MT) {
        std::printf("m must be in [1, %u] for the single-tile harness (got %u)\n", M15PFR::MT, m);
        return 2;
    }

    std::map<std::string, MTensor> tensors;
    std::string modelDir;
    if (!HParseManifest(manifest, tensors, modelDir)) {
        std::printf("FAIL: cannot read manifest %s\n", manifest.c_str());
        return 2;
    }
    if (tensors.count("router_w") == 0 || tensors.count("sgate_w") == 0 || tensors.count("x_embed") == 0 ||
        modelDir.empty()) {
        std::printf("FAIL: manifest lacks router_w / sgate_w / x_embed / model_dir\n");
        return 2;
    }

    // ---- 组板：真实权重 → W_pad[E_PAD=640, HIDDEN] bf16（行 0..511 = 专家；行 512 = 共享门；其余复制行 512）----
    const size_t kRowBytes = static_cast<size_t>(M15PFR::HIDDEN) * 2u;
    std::vector<uint8_t> wPad(static_cast<size_t>(M15PFR::E_PAD) * kRowBytes, 0u);
    {
        const MTensor& rt = tensors["router_w"];
        const std::string rp = modelDir + "/" + rt.file;
        if (rt.bytes != static_cast<uint64_t>(M15PFR::E) * kRowBytes) {
            std::printf("FAIL: router_w bytes %llu != %zu\n", static_cast<unsigned long long>(rt.bytes),
                        static_cast<size_t>(M15PFR::E) * kRowBytes);
            return 2;
        }
        if (!HPread(rp, rt.off, wPad.data(), static_cast<size_t>(rt.bytes))) {
            std::printf("FAIL: pread router_w\n");
            return 2;
        }
        const MTensor& st = tensors["sgate_w"];
        std::vector<uint8_t> sg(kRowBytes, 0u);
        if (!HPread(modelDir + "/" + st.file, st.off, sg.data(), kRowBytes)) {
            std::printf("FAIL: pread sgate_w\n");
            return 2;
        }
        std::memcpy(wPad.data() + static_cast<size_t>(M15PFR::E) * kRowBytes, sg.data(), kRowBytes);
        for (uint32_t r = M15PFR::E + 1u; r < M15PFR::E_PAD; ++r) {   // pad 行：让 mmad 读到可读字节
            std::memcpy(wPad.data() + static_cast<size_t>(r) * kRowBytes, sg.data(), kRowBytes);
        }
    }

    // ---- S1 的 gamma1（真实 checkpoint 的 hc_norm 行切片）× resZero（全 0）× y 出口 ----
    std::vector<uint8_t> g1Host(kRowBytes, 0u);
    {
        const MTensor& gt = tensors["gamma1"];
        if (!HPread(modelDir + "/" + gt.file, gt.off, g1Host.data(), kRowBytes)) {
            std::printf("FAIL: pread gamma1\n");
            return 2;
        }
    }
    std::vector<uint8_t> zeroHost(static_cast<size_t>(M15PFR::MT) * kRowBytes, 0u);
    std::vector<uint8_t> yHost(static_cast<size_t>(M15PFR::MT) * kRowBytes, 0u);

    // ---- 输入 x：真实 embedding 的 MT 行（`calcM >= 2` 的 quirk 保证可读）----
    std::vector<uint8_t> xHost(static_cast<size_t>(M15PFR::MT) * kRowBytes, 0u);
    {
        const MTensor& xt = tensors["x_embed"];
        if (!HPread(modelDir + "/" + xt.file, xt.off, xHost.data(), xHost.size())) {
            std::printf("FAIL: pread x_embed (first %u rows)\n", M15PFR::MT);
            return 2;
        }
    }

    // ---- device 缓冲 ----
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    int64_t aicNum = 0;
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    const uint32_t nblk = static_cast<uint32_t>(aicNum);

    void* wsDev = nullptr;
    void* xDev = nullptr;
    void* wDev = nullptr;
    const size_t wsBytes = M15PFR::PWS_BYTES;
    const size_t logitsBytes = static_cast<size_t>(M15PFR::SZ_LOGITS);
    const size_t idsBytes = static_cast<size_t>(M15PFR::SZ_IDS);
    const size_t wBytes = static_cast<size_t>(M15PFR::SZ_W);
    const size_t sgBytes = static_cast<size_t>(M15PFR::MT) * 4u;
    aclrtMalloc(&wsDev, wsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&xDev, xHost.size() * 2u, ACL_MEM_MALLOC_HUGE_FIRST);   // 2×：给 calcM 的多读留余量
    aclrtMalloc(&wDev, wPad.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    void* g1Dev = nullptr;
    void* zDev = nullptr;
    void* yDev = nullptr;
    aclrtMalloc(&g1Dev, g1Host.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&zDev, zeroHost.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&yDev, yHost.size(), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(g1Dev, g1Host.size(), g1Host.data(), g1Host.size(), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(zDev, zeroHost.size(), zeroHost.data(), zeroHost.size(), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(yDev, yHost.size(), yHost.data(), yHost.size(), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(wsDev, wsBytes, 0xCD, wsBytes);                        // 毒化：防"看起来对"
    aclrtMemcpy(xDev, xHost.size(), xHost.data(), xHost.size(), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(xDev, xHost.size(), xHost.data(), xHost.size(), ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wDev, wPad.size(), wPad.data(), wPad.size(), ACL_MEMCPY_HOST_TO_DEVICE);

    m26_router_kernel<<<nblk, 0, stream>>>(reinterpret_cast<uint8_t*>(wsDev), reinterpret_cast<uint8_t*>(xDev),
                                           reinterpret_cast<uint8_t*>(wDev), reinterpret_cast<uint8_t*>(g1Dev),
                                           reinterpret_cast<uint8_t*>(zDev), reinterpret_cast<uint8_t*>(yDev),
                                           m, stageLimit);
    aclrtSynchronizeStream(stream);

    // ---- D2H + 落盘 ----
    std::vector<uint8_t> logitsH(logitsBytes, 0u);
    std::vector<uint8_t> idsH(idsBytes, 0u);
    std::vector<uint8_t> wH(wBytes, 0u);
    std::vector<uint8_t> sgH(sgBytes, 0u);
    aclrtMemcpy(logitsH.data(), logitsBytes, reinterpret_cast<uint8_t*>(wsDev) + M15PFR::PWS_LOGITS, logitsBytes,
                ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(idsH.data(), idsBytes, reinterpret_cast<uint8_t*>(wsDev) + M15PFR::PWS_IDS, idsBytes,
                ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(wH.data(), wBytes, reinterpret_cast<uint8_t*>(wsDev) + M15PFR::PWS_W, wBytes,
                ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(sgH.data(), sgBytes, reinterpret_cast<uint8_t*>(wsDev) + M15PFR::PWS_SGATE, sgBytes,
                ACL_MEMCPY_DEVICE_TO_HOST);

    // ---- stage 3（链路臂）的 S3/S4 产物：计数排序的**索引数据**（推导正确性的一条独立判据）----
    std::vector<uint8_t> cntH, offH, psrcH, pexpH, invH, xnH, xsH;
    if (stageLimit == 3u) {
        cntH.resize(M15PFR::SZ_COUNTS);
        offH.resize(M15PFR::SZ_OFFSETS);
        psrcH.resize(M15PFR::SZ_PERM);
        pexpH.resize(M15PFR::SZ_PERM);
        invH.resize(M15PFR::SZ_INV);
        xnH.resize(static_cast<size_t>(M15PFR::MT) * M15PFR::HIDDEN * 2u);
        xsH.resize(static_cast<size_t>(M15PFR::TP_MAX) * M15PFR::HIDDEN * 2u);
        auto dp = [&](void* dst, size_t n, uint32_t off) {
            aclrtMemcpy(dst, n, reinterpret_cast<uint8_t*>(wsDev) + off, n, ACL_MEMCPY_DEVICE_TO_HOST);
        };
        dp(cntH.data(), cntH.size(), M15PFR::PWS_COUNTS);
        dp(offH.data(), offH.size(), M15PFR::PWS_OFFSETS);
        dp(psrcH.data(), psrcH.size(), M15PFR::PWS_PERM_SRC);
        dp(pexpH.data(), pexpH.size(), M15PFR::PWS_PERM_EXP);
        dp(invH.data(), invH.size(), M15PFR::PWS_INV);
        dp(xnH.data(), xnH.size(), M15PFR::PWS_XNORM);
        dp(xsH.data(), xsH.size(), M15PFR::PWS_XSORT);
    }

    ::mkdir(outDir.c_str(), 0755);
    HWriteBin(outDir + "/m26_x.bin", xHost.data(), xHost.size());
    HWriteBin(outDir + "/m26_wpad.bin", wPad.data(), wPad.size());
    HWriteBin(outDir + "/m26_logits.bin", logitsH.data(), logitsBytes);
    HWriteBin(outDir + "/m26_ids.bin", idsH.data(), idsBytes);
    HWriteBin(outDir + "/m26_w.bin", wH.data(), wBytes);
    HWriteBin(outDir + "/m26_sgate.bin", sgH.data(), sgBytes);
    if (stageLimit == 3u) {
        HWriteBin(outDir + "/m26_counts.bin", cntH.data(), cntH.size());
        HWriteBin(outDir + "/m26_offsets.bin", offH.data(), offH.size());
        HWriteBin(outDir + "/m26_perm_src.bin", psrcH.data(), psrcH.size());
        HWriteBin(outDir + "/m26_perm_exp.bin", pexpH.data(), pexpH.size());
        HWriteBin(outDir + "/m26_inv.bin", invH.data(), invH.size());
        HWriteBin(outDir + "/m26_xnorm.bin", xnH.data(), xnH.size());
        HWriteBin(outDir + "/m26_xsorted.bin", xsH.data(), xsH.size());
    }
    {
        FILE* fp = ::fopen((outDir + "/m26_meta.txt").c_str(), "w");
        if (fp != nullptr) {
            std::fprintf(fp,
                         "m=%u\nstage=%u\ntopk=%u\nE=%u\nE_PAD=%u\nMT=%u\nTP_MAX=%u\nhidden=%u\nnblk=%u\n",
                         m, stageLimit, static_cast<uint32_t>(M15PFR::TOPK), static_cast<uint32_t>(M15PFR::E),
                         static_cast<uint32_t>(M15PFR::E_PAD), static_cast<uint32_t>(M15PFR::MT),
                         static_cast<uint32_t>(M15PFR::TP_MAX), static_cast<uint32_t>(M15PFR::HIDDEN), nblk);
            std::fclose(fp);
        }
    }

    // ---- host 侧 guard（非空洞性；真正的判定在 check_ref.py）----
    int32_t bad = 0;
    {
        // G1：logits 的 [0, m) 行必须非毒值、且行内跨专家非常量
        const float* lg = reinterpret_cast<const float*>(logitsH.data());
        const float poison = -2.9096115e+11f;   // 0xCDCDCDCD 当 fp32 读
        uint32_t nonConst = 0;
        for (uint32_t r = 0; r < m; ++r) {
            const float* row = lg + static_cast<size_t>(r) * M15PFR::E_PAD;
            float lo = row[0];
            float hi = row[0];
            for (uint32_t c = 0; c < M15PFR::E; ++c) {
                if (row[c] != row[c] || row[c] == poison) {
                    ++bad;
                }
                if (row[c] < lo) { lo = row[c]; }
                if (row[c] > hi) { hi = row[c]; }
            }
            if (hi - lo > 1e-3f) {
                ++nonConst;
            }
        }
        std::printf("G1 logits[0,%u) poison/NaN=%d, rows with spread>1e-3: %u/%u\n", m, bad, nonConst, m);
        // G2：ids 必须落在 [0, E)，且同一行内互异
        const int32_t* idp = reinterpret_cast<const int32_t*>(idsH.data());
        uint32_t badId = 0;
        uint32_t dupRow = 0;
        for (uint32_t r = 0; r < m; ++r) {
            for (uint32_t k = 0; k < M15PFR::TOPK; ++k) {
                const int32_t v = idp[r * M15PFR::TOPK + k];
                if (v < 0 || v >= static_cast<int32_t>(M15PFR::E)) {
                    ++badId;
                }
                for (uint32_t j = 0; j < k; ++j) {
                    if (idp[r * M15PFR::TOPK + j] == v) { ++dupRow; }
                }
            }
        }
        std::printf("G2 ids out-of-range=%u, in-row duplicates=%u\n", badId, dupRow);
        // G3：weights 之和 ≈ 1（renorm 的**非空洞**见证）
        const float* wp = reinterpret_cast<const float*>(wH.data());
        float worst = 0.0f;
        for (uint32_t r = 0; r < m; ++r) {
            float s = 0.0f;
            for (uint32_t k = 0; k < M15PFR::TOPK; ++k) {
                s += wp[r * M15PFR::TOPK + k];
            }
            const float d = (s > 1.0f) ? (s - 1.0f) : (1.0f - s);
            if (d > worst) { worst = d; }
        }
        std::printf("G3 max |sum(topk_w) - 1| = %.3e\n", static_cast<double>(worst));
        // G4：毒化区的见证 —— ws 的尾部未用区必须仍是 0xCD（证明没有越界写）
        std::vector<uint8_t> tail(64u, 0u);
        aclrtMemcpy(tail.data(), tail.size(), reinterpret_cast<uint8_t*>(wsDev) + (wsBytes - 64u), tail.size(),
                    ACL_MEMCPY_DEVICE_TO_HOST);
        uint32_t cdCount = 0;
        for (size_t i = 0; i < tail.size(); ++i) {
            if (tail[i] == 0xCDu) { ++cdCount; }
        }
        std::printf("G4 ws tail still poisoned: %u/64 bytes\n", cdCount);
        if (bad != 0 || badId != 0 || dupRow != 0 || cdCount != 64u) {
            std::printf("HARNESS: red (see counts above)\n");
        } else {
            std::printf("HARNESS: green\n");
        }
    }

    aclrtFree(wsDev);
    aclrtFree(xDev);
    aclrtFree(wDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return 0;
}
