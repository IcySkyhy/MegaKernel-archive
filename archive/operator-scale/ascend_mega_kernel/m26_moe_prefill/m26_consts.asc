// m26_consts.asc —— 只打印 `m15_moe_prefill_res.h` 的编译期读数（**不碰设备**、不需要锁）
// 为什么要单独一个 TU：提交进证据的读数必须是**编译期常量本身**打出来的，不是手算的
// （`docs/15` M103-2.1 的 P2-1 就是手算错：20,979,200 vs 真值 20,976,640）。
#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>

#include "m15_gdn_layer.h"
#include "m15_hc_layer.h"
// **必须先于 m15_moe_prefill.h**：后者引入 `m15_layer_resources.h`，其 §4 `FLAG_SEQ[]` 引用
// `M85P::FLAG_B2/B3/B4`（`:728-737`），而 `M85P` 只由 `m15_ple_wire.h` 提供（该头要求先有
// `m15_hc_layer.h`，上面的包含序已满足）。
#include "m15_ple_wire.h"
#include "m15_moe_prefill.h"

int32_t main(int32_t, char**)
{
    std::printf("E=%u TOPK=%u MT=%u E_PAD=%u TP_MAX=%u M_PREFILL=%u PF_BLK_MAX=%u\n",
                (uint32_t)M15PFR::E, (uint32_t)M15PFR::TOPK, (uint32_t)M15PFR::MT, (uint32_t)M15PFR::E_PAD,
                (uint32_t)M15PFR::TP_MAX, (uint32_t)M15PFR::M_PREFILL, (uint32_t)M15PFR::PF_BLK_MAX);
    std::printf("RB_K=%u RB_N=%u RB_KBLK=%u RB_NBLK=%u\n", (uint32_t)M15PFR::RB_K, (uint32_t)M15PFR::RB_N,
                (uint32_t)M15PFR::RB_KBLK, (uint32_t)M15PFR::RB_NBLK);
    std::printf("PWS_BYTES=%u  (host: M15PFH::WsBytes=%zu)\n", (uint32_t)M15PFR::PWS_BYTES,
                (size_t)M15PFR::PWS_BYTES);
    std::printf("PF_UB_PEAK=%u  UB_BYTES_TOTAL=%u  UB_RT_END(decode MoE)=%u\n", (uint32_t)M15PFR::PF_UB_PEAK,
                (uint32_t)M15PFR::UB_BYTES_TOTAL, (uint32_t)M15M::UB_RT_END);
    std::printf("L1R_END=%u  L0C tile=%u  L1_BYTES_TOTAL=%u\n", (uint32_t)M15PFR::L1R_END,
                (uint32_t)(M15PFR::MT * M15PFR::RB_N * 4u), (uint32_t)M15M::L1_BYTES_TOTAL);
    std::printf("MOE_W_PREFILL_STRIDE=%u  MWP_WGU_BYTES=%u  (owner: m15_layer_resources.h)\n",
                (uint32_t)M15L::MOE_W_PREFILL_STRIDE, (uint32_t)M15L::MWP_WGU_BYTES);
    return 0;
}
