/**
 * m8_permute.asc —— Mega kernel M8：MoE 专家槽位重排 / 反重排（纯 AIV 核 ×2）
 * （设计约束见 docs/05-megakernel-design.md §5；donor：docs/09 §2
 *   permute  = ops-transformer/moe/moe_token_permute_with_routing_map
 *              op_kernel/arch35/gather_v2_simd_two_dim.h:148
 *              （Gatherv2SimdTwoDim NoSplitColProcess 逐行 gather 主循环 :148-194）
 *   unpermute= ops-transformer/moe/moe_token_unpermute_with_routing_map_not_pad.h:21
 *              （scatter + probs 加权折叠）
 *   donor 被禁点：TPipe/TQueBind/TBuf、AllocTensor、18 处 SetFlag/WaitFlag
 *              ——本工程全部转 BufferID，遵守同禁单。）
 *
 * 槽位布局语义（docs/05 §5：decode 静态 schedule 按专家槽位划分，运行时按路由
 * 结果重排；golden 生成器 tools/golden/moe_block_ref.py moe_permute 同款）：
 *   topk_ids[m,topK] 按分数降序（并列取小 expert id）；重排后第 i 个 sorted slot
 *   属于专家 perm_expert[i]，其源 token 为 perm_src_token[i]；同一专家的槽位
 *   连续排列，expert_token_counts[e] = 该专家槽位数，Σt_e = m*topK。
 *
 * kernel #1 permute（逐行 gather，纯 MTE2→UB→MTE3 带宽操作，docs/09 §2 建议
 * "permute 先做独立 phase"）：
 *     x_sorted[i, :] = x[perm_src_token[i], :]        i ∈ [0, Σt_e)
 *   Σt_e 运行时由每核自 GM expert_token_counts 标量读入（GlobalTensor::GetValue，
 *   m3_grouped_gemm 同款用法）并求和；重排行按核 stride 划分（行间无依赖）。
 *
 * kernel #2 unpermute（probs 加权折叠，写回 [m,2560]）：
 *     out[t, :] = Σ_k w[t,k] * y_sorted[slot(t,k), :]
 *   其中 slot(t,k) = token t 的第 k 个 topk 专家在 sorted 序列中的槽位
 *   （host 由 perm_src_token/perm_expert/topk_ids 预计算 inv_slot [m,topK]）；
 *   w[t,k] = bf16_RNE(topk_weights[t,k])，host 打包为 [m,16] int32（低 16 位 =
 *   bf16 位，行距 64B），随 y 行同批 MTE2 拷入 UB——kernel 内零标量权重读取
 *   （标量→向量跨 pipe 数据流在 3510 上实测间歇性丢写/错值，bisect 实证；
 *   w 经 LoadAlign DIST_BRC_B32 广播 + ShiftLefts<<16 位精确还原，m6 同款技巧）。
 *   donor 的"逐 slot scatter+折叠"实现为按输出行 gather（每输出行 disjoint，
 *   免 GM 原子加）；折叠统一按 k 升序、与参考同序——topK=2 时由 fp32 加法
 *   交换律与任意 scatter 次序逐位等价，topK>2 的次序契约即 k 升序）。
 *   topK 为模板参数（1..10 共 10 个实例，host switch 分发）：k 链全展开后所有
 *   下标为编译期常量——向量循环内禁止动态下标标量加载（bisect 实证 backend
 *   报错 "Unsupported Inst must be hoisted"）；寄存器折叠累加，无 UB acc 往返。
 *
 * 数值契约（与 numpy 参考逐位一致的前提）：
 *   acc = Σ_k  fp32(bf16 w_k) * fp32(bf16 y_k)     （fp32 乘法分别舍入）
 *   out = bf16_RNE(acc)                            （fp32 加法分别舍入）
 *   kernel 内 Mul/Add 为独立向量指令（无 FMA 融合）；host C 参考以
 *   -ffp-contract=off 编译，保证同一 IEEE 运算序列。
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal），release 用阻塞模式
 * （mode=false = CANN 默认 ASC_LOCK_BLOCK；true=NON_BLOCK）；无 set_flag/wait_flag，不挂 PIPE_S 事件同步。
 *
 * 3510 连续 Cast bug 规避（docs/05 §6，M10 实证）：unpermute 计算循环内任意两个
 *   Cast 之间都隔着 LoadAlign/Mul/Add/ShiftLefts，全 kernel 无相邻 Cast。
 *
 * UB 布局全部 32B 对齐（M9 quirk：UB 偏移非 32B 对齐时 UB→GM DataCopy 直接
 *   vector core exception）；行 2560×bf16 = 5120B 恰为 32B 整数倍。
 *
 * 设计包络（docs/05 §5 decode 规模）：m ≤ 64、topK ≤ 10、Σt_e ≤ 640
 *   （512 专家 top-10 → 重排行数 ≤ 640）；UB 按 topK≤10 / 双缓冲静态分配。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

// ============================================================
// 编译期常量与静态资源表（UB 偏移 / BufferID 全部编译期静态分配）
// ============================================================

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t HIDDEN = 2560;            // hidden size（bf16），模型形状
constexpr uint32_t ROW_B = 2 * HIDDEN;       // 一行 bf16 = 5120B（32B 整数倍）
constexpr uint32_t VL_F32 = 64;              // 256B 向量寄存器 fp32 lane 数
constexpr uint16_t CHUNKS = HIDDEN / VL_F32; // 每行 64-lane chunk 数 = 40（无尾块）

constexpr uint32_t MAX_TOPK = 10;            // decode top-10 包络
constexpr uint32_t MAX_TOTAL = 640;          // m≤64 × top-10 → Σt_e ≤ 640
constexpr uint32_t MAX_EXPERTS = 512;        // docs/05：512 专家
constexpr uint32_t MAX_CORES = 28;           // 950PR 单芯片 AIC/AIV-group 数
constexpr uint32_t MAX_M = 64;               // decode 包络 m ≤ 64

// ---- UB 静态布局（字节偏移；VECCALC 空间 248KB 内；偏移 32B 对齐，供 DataCopy）----

// kernel #1 permute：4 级行缓冲流水（纯 DMA 操作，级数深掩盖 MTE2/MTE3 延迟）
constexpr uint32_t STAGES_P = 4;
constexpr uint32_t UB_P_ROW0 = 0;                       // 4 × 5120B = 20480B
static_assert(UB_P_ROW0 + STAGES_P * ROW_B <= 248 * 1024, "permute UB overflow");

// kernel #2 unpermute：双缓冲（每 stage：topK 行 y + 1 行 out + 权重行 64B）
//   权重行随 y 行同批 MTE2 拷入（host 将 bf16 权重位打包进 int32 低 16 位，
//   [m,16] 行距 64B 对齐）——kernel 内零标量权重读取，V 区纯向量指令，
//   消除标量→向量跨 pipe 数据流（3510 上实测间歇性丢写/错值，bisect 实证）。
constexpr uint32_t STAGES_U = 2;
constexpr uint32_t WROW_I32 = 16;                          // 每行权重槽位数（64B，DataCopy 32B 对齐）
constexpr uint32_t U_STAGE_B = (MAX_TOPK + 1) * ROW_B + 4 * WROW_I32;  // 11×5120 + 64 = 56384B
constexpr uint32_t UB_U_Y0 = 0;                    // stage s: y 行 k @ s*U_STAGE_B + k*ROW_B
constexpr uint32_t UB_U_OUT = MAX_TOPK * ROW_B;    // stage s: out 行 @ s*U_STAGE_B + UB_U_OUT
constexpr uint32_t UB_U_WROW = (MAX_TOPK + 1) * ROW_B;  // stage s: 权重行 int32[16] @ s*U_STAGE_B + UB_U_WROW
static_assert(STAGES_U * U_STAGE_B <= 248 * 1024, "unpermute UB overflow");

// ---- BufferID（每核用户可用 0-27，静态分配）----
constexpr AscendC::MutexID BUF_P0 = 0;    // kernel #1 行缓冲 0-3（MTE2 → MTE3）
constexpr AscendC::MutexID BUF_U0 = 0;    // kernel #2 stage 0/1（MTE2 → V → MTE3）

// BufferID 语义封装：acquire 立即获取；release 用阻塞模式（mode=false = CANN 默认
// ASC_LOCK_BLOCK；true=NON_BLOCK），阻塞至本 pipe 已发射访存落地，对跨 pipe 消费者可见。
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// ---- Cast traits（lift 自 m6 → donor reduce_common_regbase 同款）----
constexpr AscendC::Reg::CastTrait castTraitB162B32 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::UNKNOWN,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::UNKNOWN};
constexpr AscendC::Reg::CastTrait castTraitB322B16 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::NO_SAT,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::CAST_RINT};

// ============================================================
// Kernel #1：permute（逐行 gather，MTE2→UB→MTE3，4 级流水）
// ============================================================

class MoePermuteKernel {
public:
    __aicore__ inline MoePermuteKernel() {}

    __aicore__ inline void Init(GM_ADDR x, GM_ADDR sortedToken, GM_ADDR counts, GM_ADDR xSorted,
                                uint32_t numExperts)
    {
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x));
        sortedTokenGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(sortedToken));
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), numExperts);
        xSortedGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(xSorted));
        E = numExperts;
    }

    __aicore__ inline void Process()
    {
        // Σt_e 运行时从 GM counts 读入（每核独立读，m3_grouped_gemm countsGM.GetValue 同款）
        uint32_t total = 0;
        for (uint32_t e = 0; e < E; ++e) {
            total += static_cast<uint32_t>(countsGm.GetValue(e));
        }
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t nblk = AscendC::GetBlockNum();
        const uint32_t myRows = (total > bid) ? (total - bid - 1) / nblk + 1 : 0;

        // 流水 prologue：填充前 min(STAGES, myRows) 级
        for (uint32_t s = 0; s < STAGES_P && s < myRows; ++s) {
            CopyIn(bid + s * nblk, s);
        }
        for (uint32_t r = 0; r < myRows; ++r) {
            const uint32_t stage = r % STAGES_P;
            CopyOut(bid + r * nblk, stage);
            if (r + STAGES_P < myRows) {
                CopyIn(bid + (r + STAGES_P) * nblk, stage);  // 复用刚 drain 的缓冲级
            }
        }
    }

private:
    __aicore__ inline void CopyIn(uint32_t row, uint32_t stage)
    {
        LocalTensor<bfloat16_t> bufL(TPosition::VECCALC, UB_P_ROW0 + stage * ROW_B, HIDDEN);
        const int32_t src = sortedTokenGm.GetValue(row);  // gather 源行（标量 GM 读）
        BufAcquire<PIPE_MTE2>(BUF_P0 + stage);
        DataCopy(bufL, xGm[static_cast<uint64_t>(src) * HIDDEN], HIDDEN);
        BufRelease<PIPE_MTE2>(BUF_P0 + stage);
    }

    __aicore__ inline void CopyOut(uint32_t row, uint32_t stage)
    {
        LocalTensor<bfloat16_t> bufL(TPosition::VECCALC, UB_P_ROW0 + stage * ROW_B, HIDDEN);
        BufAcquire<PIPE_MTE3>(BUF_P0 + stage);
        DataCopy(xSortedGm[static_cast<uint64_t>(row) * HIDDEN], bufL, HIDDEN);
        BufRelease<PIPE_MTE3>(BUF_P0 + stage);
    }

private:
    uint32_t E;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<int32_t> sortedTokenGm;
    GlobalTensor<int32_t> countsGm;
    GlobalTensor<bfloat16_t> xSortedGm;
};

// ============================================================
// Kernel #2：unpermute（按输出行 gather + per-slot bf16 加权折叠）
//   按 topK 模板实例化（host 端 1..10 分发）：k 循环全展开后所有标量下标为
//   编译期常量（向量循环内禁止动态下标标量加载，bisect 实证 backend 报错
//   "Unsupported Inst must be hoisted"）；寄存器折叠累加，无 UB acc 往返、
//   无 LocalMemBar（跨 __VEC_SCOPE__ 抽取的 store→load 屏障在 3510 上不可靠，
//   实测丢写——正确性优先直接消除该 hazard）。
// ============================================================

// 单条加权折叠：acc += fp32(w_k) * fp32(y_k)；K 为编译期常量行号。
// wRaw = int32 低 16 位打包的 bf16 权重位（LoadAlign DIST_BRC_B32 广播），
// <<16 即 Bf16ToF32（位精确，含符号/指数/尾数；m6 ShiftLefts 位技巧同款）。
template <uint32_t K>
__aicore__ inline void FmaChunk(RegTensor<float>& acc, RegTensor<float>& yF, RegTensor<bfloat16_t>& yB16,
                                RegTensor<int32_t>& wRaw, RegTensor<float>& wF, __ubuf__ bfloat16_t* yUb,
                                __ubuf__ int32_t* wRowUb, MaskReg& maskAll, uint32_t off)
{
    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(yB16, yUb + K * HIDDEN + off);
    Cast<float, bfloat16_t, castTraitB162B32>(yF, yB16, maskAll);
    LoadAlign<int32_t, LoadDist::DIST_BRC_B32>(wRaw, wRowUb + K);
    ShiftLefts((RegTensor<uint32_t>&)wF, (RegTensor<uint32_t>&)wRaw, static_cast<int16_t>(16), maskAll);
    Mul(yF, yF, wF, maskAll);
    Add(acc, acc, yF, maskAll);
}

template <uint32_t TK>
class MoeUnpermuteKernel {
public:
    __aicore__ inline MoeUnpermuteKernel() {}

    // ySorted [total,2560] bf16；outTokenSlot [m,TK] int32（= inv_slot）；
    // wTkPacked [m,16] int32（低 16 位 = bf16 权重位，行距 64B）；out [m,2560] bf16
    __aicore__ inline void Init(GM_ADDR ySorted, GM_ADDR outTokenSlot, GM_ADDR wTkPacked, GM_ADDR out,
                                uint32_t m)
    {
        yGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ySorted));
        slotGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(outTokenSlot));
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(wTkPacked));
        outGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(out));
        M = m;
    }

    __aicore__ inline void Process()
    {
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t nblk = AscendC::GetBlockNum();
        const uint32_t myRows = (M > bid) ? (M - bid - 1) / nblk + 1 : 0;

        for (uint32_t r = 0; r < myRows; ++r) {
            const uint32_t t = bid + r * nblk;
            const uint32_t stage = r % STAGES_U;
            CopyIn(t, stage);
            ComputeRow(stage);
            CopyOut(t, stage);
        }
    }

private:
    // MTE2：topK 个源 slot 行 + 该行权重行（64B）同批拷入 UB（一次握手）
    __aicore__ inline void CopyIn(uint32_t t, uint32_t stage)
    {
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_U_Y0 + stage * U_STAGE_B, MAX_TOPK * HIDDEN);
        LocalTensor<int32_t> wL(TPosition::VECCALC, UB_U_Y0 + stage * U_STAGE_B + UB_U_WROW, WROW_I32);
        BufAcquire<PIPE_MTE2>(BUF_U0 + stage);
        DataCopy(wL, wGm[static_cast<uint64_t>(t) * WROW_I32], WROW_I32);
        for (uint32_t k = 0; k < TK; ++k) {
            const int32_t slot = slotGm.GetValue(static_cast<uint64_t>(t) * TK + k);  // 标量 GM 读→地址
            DataCopy(yL[k * HIDDEN], yGm[static_cast<uint64_t>(slot) * HIDDEN], HIDDEN);
        }
        BufRelease<PIPE_MTE2>(BUF_U0 + stage);
    }

    // V：out = bf16( Σ_k fp32(w_k) * fp32(y_k) )（chunk-outer × k 全展开，acc 驻留向量寄存器；
    //    fp32 加法次序 = k 升序，与参考同一 IEEE 序列；全向量指令，无标量数据流）
    __aicore__ inline void ComputeRow(uint32_t stage)
    {
        LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_U_Y0 + stage * U_STAGE_B, MAX_TOPK * HIDDEN);
        LocalTensor<bfloat16_t> outL(TPosition::VECCALC, UB_U_Y0 + stage * U_STAGE_B + UB_U_OUT, HIDDEN);
        LocalTensor<int32_t> wL(TPosition::VECCALC, UB_U_Y0 + stage * U_STAGE_B + UB_U_WROW, WROW_I32);
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(yL.GetPhyAddr());
        __ubuf__ bfloat16_t* outUb = reinterpret_cast<__ubuf__ bfloat16_t*>(outL.GetPhyAddr());
        __ubuf__ int32_t* wRowUb = reinterpret_cast<__ubuf__ int32_t*>(wL.GetPhyAddr());

        BufAcquire<PIPE_V>(BUF_U0 + stage);
        __VEC_SCOPE__
        {
            RegTensor<float> acc;
            RegTensor<float> yF;
            RegTensor<float> wF;
            RegTensor<int32_t> wRaw;
            RegTensor<bfloat16_t> yB16;
            RegTensor<bfloat16_t> outB16;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t c = 0; c < CHUNKS; ++c) {
                const uint32_t off = static_cast<uint32_t>(c) * VL_F32;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(yB16, yUb + off);
                Cast<float, bfloat16_t, castTraitB162B32>(yF, yB16, maskAll);
                LoadAlign<int32_t, LoadDist::DIST_BRC_B32>(wRaw, wRowUb);
                ShiftLefts((RegTensor<uint32_t>&)wF, (RegTensor<uint32_t>&)wRaw, static_cast<int16_t>(16),
                           maskAll);
                Mul(acc, yF, wF, maskAll);  // k = 0 直写 acc
                if constexpr (TK > 1) FmaChunk<1>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 2) FmaChunk<2>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 3) FmaChunk<3>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 4) FmaChunk<4>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 5) FmaChunk<5>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 6) FmaChunk<6>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 7) FmaChunk<7>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 8) FmaChunk<8>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                if constexpr (TK > 9) FmaChunk<9>(acc, yF, yB16, wRaw, wF, yUb, wRowUb, maskAll, off);
                Cast<bfloat16_t, float, castTraitB322B16>(outB16, acc, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(outUb + off, outB16, maskAll);
            }
        }
        BufRelease<PIPE_V>(BUF_U0 + stage);
    }

    __aicore__ inline void CopyOut(uint32_t t, uint32_t stage)
    {
        LocalTensor<bfloat16_t> outL(TPosition::VECCALC, UB_U_Y0 + stage * U_STAGE_B + UB_U_OUT, HIDDEN);
        BufAcquire<PIPE_MTE3>(BUF_U0 + stage);
        DataCopy(outGm[static_cast<uint64_t>(t) * HIDDEN], outL, HIDDEN);
        BufRelease<PIPE_MTE3>(BUF_U0 + stage);
    }

private:
    uint32_t M;
    GlobalTensor<bfloat16_t> yGm;
    GlobalTensor<int32_t> slotGm;
    GlobalTensor<int32_t> wGm;
    GlobalTensor<bfloat16_t> outGm;
};

} // namespace

__vector__ __global__ void moe_permute_kernel(GM_ADDR x, GM_ADDR sortedToken, GM_ADDR counts, GM_ADDR xSorted,
                                              uint32_t numExperts)
{
    MoePermuteKernel op;
    op.Init(x, sortedToken, counts, xSorted, numExperts);
    op.Process();
}

template <uint32_t TK>
__vector__ __global__ void moe_unpermute_kernel(GM_ADDR ySorted, GM_ADDR outTokenSlot, GM_ADDR sortedWeight,
                                                GM_ADDR out, uint32_t m)
{
    MoeUnpermuteKernel<TK> op;
    op.Init(ySorted, outTokenSlot, sortedWeight, out, m);
    op.Process();
}

// ============================================================
// Host 侧：消费 tools/golden/data/{m1,m33} golden bins + 内建 C 参考 + 读回校验
// ============================================================

// ---- bf16 编解码（RNE；host 全位操作，与 tools/golden/moe_block_ref.py 一致）----
static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// ---- golden bins 加载（布局见 tools/golden/data/<case>/manifest.json，形状由文件大小推断）----
struct Dataset {
    uint32_t m = 0;
    uint32_t topK = 0;
    uint32_t E = 0;
    uint32_t total = 0;
    std::vector<uint16_t> x;             // [m,2560] bf16
    std::vector<int32_t> permSrcToken;   // [total]
    std::vector<int32_t> permExpert;     // [total]
    std::vector<int32_t> counts;         // [E]
    std::vector<uint16_t> xSortedGolden; // [total,2560] bf16
    std::vector<int32_t> topkIds;        // [m,topK]
    std::vector<float> topkWeights;      // [m,topK]
};

static bool ReadBin(const std::string& path, void* buf, size_t bytes)
{
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) return false;
    const size_t r = fread(buf, 1, bytes, f);
    fclose(f);
    return r == bytes;
}

static bool FileSize(const std::string& path, size_t& size)
{
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) return false;
    fseek(f, 0, SEEK_END);
    const long sz = ftell(f);
    fclose(f);
    if (sz < 0) return false;
    size = static_cast<size_t>(sz);
    return true;
}

static bool LoadDataset(const std::string& dir, Dataset& ds)
{
    // x.bin：先校验尺寸（2560×2B 整行、非空、m ≤ MAX_M），再读入——畸形文件走 FAIL 路径而非越界
    size_t xBytes = 0;
    if (!FileSize(dir + "/x.bin", xBytes)) { printf("[M8][FAIL] open %s/x.bin\n", dir.c_str()); return false; }
    if (xBytes == 0 || xBytes % (static_cast<size_t>(HIDDEN) * 2) != 0) {
        printf("[M8][FAIL] x.bin size %zu not a non-zero multiple of %u*2\n", xBytes, HIDDEN);
        return false;
    }
    ds.m = static_cast<uint32_t>(xBytes / (static_cast<size_t>(HIDDEN) * 2));
    if (ds.m > MAX_M) {
        printf("[M8][FAIL] m=%u exceeds envelope %u\n", ds.m, MAX_M);
        return false;
    }
    ds.x.resize(static_cast<size_t>(ds.m) * HIDDEN);
    if (!ReadBin(dir + "/x.bin", ds.x.data(), xBytes)) { printf("[M8][FAIL] read x.bin\n"); return false; }

    auto load32 = [&](const char* name, std::vector<int32_t>& v) {
        size_t bytes = 0;
        if (!FileSize(dir + "/" + name, bytes)) { printf("[M8][FAIL] open %s\n", name); return false; }
        if (bytes % 4 != 0) { printf("[M8][FAIL] %s size %zu not multiple of 4\n", name, bytes); return false; }
        v.resize(bytes / 4);
        return ReadBin(dir + "/" + name, v.data(), bytes);
    };
    if (!load32("perm_src_token.bin", ds.permSrcToken)) return false;
    if (!load32("perm_expert.bin", ds.permExpert)) return false;
    if (!load32("expert_token_counts.bin", ds.counts)) return false;
    if (!load32("topk_ids.bin", ds.topkIds)) return false;

    size_t wBytes = 0;
    if (!FileSize(dir + "/topk_weights.bin", wBytes)) {
        printf("[M8][FAIL] open topk_weights.bin\n");
        return false;
    }
    if (wBytes % 4 != 0) {
        printf("[M8][FAIL] topk_weights.bin size %zu not multiple of 4\n", wBytes);
        return false;
    }
    ds.topkWeights.resize(wBytes / 4);
    if (!ReadBin(dir + "/topk_weights.bin", ds.topkWeights.data(), wBytes)) {
        printf("[M8][FAIL] read topk_weights.bin\n");
        return false;
    }

    ds.total = static_cast<uint32_t>(ds.permSrcToken.size());
    ds.E = static_cast<uint32_t>(ds.counts.size());
    if (ds.total == 0 || ds.topkIds.size() % ds.m != 0) {
        printf("[M8][FAIL] %s: topk_ids size %zu not a multiple of m=%u\n", dir.c_str(), ds.topkIds.size(),
               ds.m);
        return false;
    }
    ds.topK = static_cast<uint32_t>(ds.topkIds.size()) / ds.m;

    // 形状自洽（先校验尺寸，后续 BuildRouting/校验循环才解引用）
    if (ds.permExpert.size() != ds.permSrcToken.size()) {
        printf("[M8][FAIL] %s: perm_expert size %zu != perm_src_token size %u\n", dir.c_str(),
               ds.permExpert.size(), ds.total);
        return false;
    }
    if (ds.topkWeights.size() != static_cast<size_t>(ds.m) * ds.topK) {
        printf("[M8][FAIL] %s: topk_weights size %zu != m*topK=%u\n", dir.c_str(), ds.topkWeights.size(),
               ds.m * ds.topK);
        return false;
    }

    ds.xSortedGolden.resize(static_cast<size_t>(ds.total) * HIDDEN);
    if (!ReadBin(dir + "/x_sorted.bin", ds.xSortedGolden.data(), ds.xSortedGolden.size() * 2)) {
        printf("[M8][FAIL] read x_sorted.bin\n");
        return false;
    }

    // 包络校验（UB 静态分配与 decode 设计的前提）
    if (ds.topK == 0 || ds.topK > MAX_TOPK || ds.total > MAX_TOTAL || ds.total != ds.m * ds.topK ||
        ds.E == 0 || ds.E > MAX_EXPERTS) {
        printf("[M8][FAIL] %s: envelope violated (m=%u topK=%u E=%u total=%u)\n", dir.c_str(), ds.m, ds.topK,
               ds.E, ds.total);
        return false;
    }
    // 槽位布局一致性：counts 非负、累计 ≤ total（防 off+i 越界），perm_expert 按专家分组且与 counts 吻合
    uint32_t off = 0;
    for (uint32_t e = 0; e < ds.E; ++e) {
        if (ds.counts[e] < 0) {
            printf("[M8][FAIL] %s: expert_token_counts[%u] = %d < 0\n", dir.c_str(), e, ds.counts[e]);
            return false;
        }
        const uint32_t cnt = static_cast<uint32_t>(ds.counts[e]);
        if (cnt > ds.total - off) {
            printf("[M8][FAIL] %s: sum(counts) overflow at expert %u (off=%u cnt=%u total=%u)\n", dir.c_str(),
                   e, off, cnt, ds.total);
            return false;
        }
        for (uint32_t i = 0; i < cnt; ++i) {
            if (static_cast<uint32_t>(ds.permExpert[off + i]) != e) {
                printf("[M8][FAIL] %s: perm_expert not grouped by expert at slot %u\n", dir.c_str(), off + i);
                return false;
            }
        }
        off += cnt;
    }
    if (off != ds.total) { printf("[M8][FAIL] %s: sum(counts)=%u != total=%u\n", dir.c_str(), off, ds.total); return false; }
    return true;
}

// ---- host 预计算：inv_slot [m,topK] + 权重行打包 [m,16] int32（低 16 位 = bf16 位）----
// inv_slot[t*topK+j] = token t 的第 j 个 topk 专家在 sorted 序列中的槽位 i。
// wTkPacked[t*16+j]  = bf16_RNE(topk_weights[t,j]) 位（kernel #2 权重行 MTE2 整行拷贝；
//                      int32 打包纯为 GM 侧 4B 对齐，kernel 内 <<16 位精确还原）。
static bool BuildRouting(const Dataset& ds, std::vector<int32_t>& invSlot, std::vector<int32_t>& wTkPacked)
{
    invSlot.assign(static_cast<size_t>(ds.m) * ds.topK, -1);
    wTkPacked.assign(static_cast<size_t>(ds.m) * WROW_I32, 0);
    for (uint32_t i = 0; i < ds.total; ++i) {
        const int32_t t = ds.permSrcToken[i];
        const int32_t e = ds.permExpert[i];
        if (t < 0 || static_cast<uint32_t>(t) >= ds.m) {  // 先校验下标，再解引用 topk_ids/topk_weights
            printf("[M8][FAIL] slot %u: src token %d out of range [0,%u)\n", i, t, ds.m);
            return false;
        }
        int32_t j = -1;
        for (uint32_t k = 0; k < ds.topK; ++k) {
            if (ds.topkIds[static_cast<size_t>(t) * ds.topK + k] == e) { j = static_cast<int32_t>(k); break; }
        }
        if (j < 0) {
            printf("[M8][FAIL] slot %u: (t=%d,e=%d) not found in topk_ids\n", i, t, e);
            return false;
        }
        invSlot[static_cast<size_t>(t) * ds.topK + j] = static_cast<int32_t>(i);
        wTkPacked[static_cast<size_t>(t) * WROW_I32 + j] = F32ToBf16(ds.topkWeights[static_cast<size_t>(t) * ds.topK + j]);
    }
    for (size_t i = 0; i < invSlot.size(); ++i) {
        if (invSlot[i] < 0) { printf("[M8][FAIL] inv_slot[%zu] unset\n", i); return false; }
    }
    return true;
}

// ---- 确定性合成 y_sorted（公式哈希，无 rand 状态；m6 GenTensors 同款分布）----
// 指数域 e ∈ [77,177]（值域 2^-50..2^50；加权 Σ 不溢出/不过小）。
static void GenSyntheticY(std::vector<uint16_t>& y, uint32_t total, uint32_t seed)
{
    y.resize(static_cast<size_t>(total) * HIDDEN);
    for (uint32_t i = 0; i < total; ++i) {
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const uint32_t h = Hash3(i, j, seed);
            const uint32_t e = 77 + h % 101;
            y[static_cast<size_t>(i) * HIDDEN + j] =
                static_cast<uint16_t>((((h >> 8) & 1) << 15) | (e << 7) | ((h >> 9) & 0x7F));
        }
    }
}

// ---- numpy 语义参考的 C 移植（unpermute 折叠公式；与 check_ref.py 逐公式对应）----
// 编译需 -ffp-contract=off：禁止 host 编译器把 w*y+acc 融合成 FMA，
// 保证与 kernel 内独立 Mul/Add 向量指令同一 IEEE 运算序列（逐位一致前提）。
static void RefUnpermute(const uint16_t* y, const int32_t* invSlot, const int32_t* wTkPacked, uint16_t* out,
                         uint32_t m, uint32_t topK)
{
    for (uint32_t t = 0; t < m; ++t) {
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            float acc = 0.0f;
            for (uint32_t k = 0; k < topK; ++k) {
                const int32_t slot = invSlot[static_cast<size_t>(t) * topK + k];
                const float w = Bf16ToF32(static_cast<uint16_t>(wTkPacked[static_cast<size_t>(t) * WROW_I32 + k]));
                const float yv = Bf16ToF32(y[static_cast<size_t>(slot) * HIDDEN + j]);
                const float p = w * yv;
                acc = acc + p;
            }
            out[static_cast<size_t>(t) * HIDDEN + j] = F32ToBf16(acc);
        }
    }
}

static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// ---- kernel #1：permute，device vs golden x_sorted 逐位一致 ----
static bool RunPermute(aclrtStream stream, const Dataset& ds, const std::string& tag)
{
    const size_t xBytes = static_cast<size_t>(ds.m) * ROW_B;
    const size_t sBytes = static_cast<size_t>(ds.total) * ROW_B;
    uint16_t *xDev = nullptr, *sDev = nullptr;
    int32_t *pstDev = nullptr, *cntDev = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&xDev), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&sDev), sBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&pstDev), ds.total * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&cntDev), ds.E * 4, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDev, xBytes, ds.x.data(), xBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(pstDev, ds.total * 4, ds.permSrcToken.data(), ds.total * 4, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(cntDev, ds.E * 4, ds.counts.data(), ds.E * 4, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(sDev, sBytes, 0xCD, sBytes);  // 污染输出，防止假 PASS

    const uint32_t blk = ds.total < MAX_CORES ? ds.total : MAX_CORES;
    moe_permute_kernel<<<blk, 0, stream>>>(reinterpret_cast<uint8_t*>(xDev), reinterpret_cast<uint8_t*>(pstDev),
                                           reinterpret_cast<uint8_t*>(cntDev), reinterpret_cast<uint8_t*>(sDev),
                                           ds.E);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("[M8][FAIL] %s permute launch/sync error %d\n", tag.c_str(), (int)err);
        aclrtFree(xDev); aclrtFree(sDev); aclrtFree(pstDev); aclrtFree(cntDev);
        return false;
    }

    std::vector<uint16_t> got(ds.total * HIDDEN);
    aclrtMemcpy(got.data(), sBytes, sDev, sBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    uint32_t mismatch = 0;
    for (size_t i = 0; i < static_cast<size_t>(ds.total) * HIDDEN && mismatch < 5; ++i) {
        if (got[i] != ds.xSortedGolden[i]) {
            printf("[M8][FAIL] %s x_sorted[%zu] got 0x%04x expect 0x%04x\n", tag.c_str(), i, got[i],
                   ds.xSortedGolden[i]);
            ++mismatch;
        }
    }
    const bool pass = mismatch == 0;
    printf("[M8] %s permute   : %s (x_sorted vs golden bit-exact, %u mismatches, blk=%u)\n", tag.c_str(),
           pass ? "PASS" : "FAIL", mismatch, blk);

    const bool dump = getenv("M8_DUMP") != nullptr;
    if (dump) {
        const std::string fn = tag + "_perm_device.bin";
        WriteBin(fn.c_str(), got.data(), sBytes);
    }

    aclrtFree(xDev); aclrtFree(sDev); aclrtFree(pstDev); aclrtFree(cntDev);
    return pass;
}

// ---- kernel #2：unpermute，device vs C 参考（numpy 公式移植）逐位一致 ----
static bool RunUnpermute(aclrtStream stream, const Dataset& ds, const uint16_t* y, const int32_t* invSlot,
                         const int32_t* wTkPacked, const std::string& tag, const std::string& dumpSuffix)
{
    const size_t sBytes = static_cast<size_t>(ds.total) * ROW_B;
    const size_t oBytes = static_cast<size_t>(ds.m) * ROW_B;
    const size_t wBytes = static_cast<size_t>(ds.m) * WROW_I32 * 4;
    uint16_t *yDev = nullptr, *oDev = nullptr;
    int32_t *wDev = nullptr, *slotDev = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&yDev), sBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&slotDev), ds.m * ds.topK * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&wDev), wBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&oDev), oBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(yDev, sBytes, y, sBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(slotDev, ds.m * ds.topK * 4, invSlot, ds.m * ds.topK * 4, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wDev, wBytes, wTkPacked, wBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    const uint32_t blk = ds.m < MAX_CORES ? ds.m : MAX_CORES;
    const uint32_t iters = getenv("M8_STRESS") ? static_cast<uint32_t>(atoi(getenv("M8_STRESS"))) : 1u;

    std::vector<uint16_t> ref(ds.m * HIDDEN);
    RefUnpermute(y, invSlot, wTkPacked, ref.data(), ds.m, ds.topK);

    uint32_t failIters = 0;
    for (uint32_t it = 0; it < iters; ++it) {
        aclrtMemset(oDev, oBytes, 0xCD, oBytes);  // 污染输出，防止假 PASS
        #define M8_LAUNCH_UNPERMUTE(TKV)                                                                     \
            moe_unpermute_kernel<TKV><<<blk, 0, stream>>>(                                                   \
                reinterpret_cast<uint8_t*>(yDev), reinterpret_cast<uint8_t*>(slotDev),                       \
                reinterpret_cast<uint8_t*>(wDev), reinterpret_cast<uint8_t*>(oDev), ds.m)
        switch (ds.topK) {
            case 1: M8_LAUNCH_UNPERMUTE(1); break;
            case 2: M8_LAUNCH_UNPERMUTE(2); break;
            case 3: M8_LAUNCH_UNPERMUTE(3); break;
            case 4: M8_LAUNCH_UNPERMUTE(4); break;
            case 5: M8_LAUNCH_UNPERMUTE(5); break;
            case 6: M8_LAUNCH_UNPERMUTE(6); break;
            case 7: M8_LAUNCH_UNPERMUTE(7); break;
            case 8: M8_LAUNCH_UNPERMUTE(8); break;
            case 9: M8_LAUNCH_UNPERMUTE(9); break;
            case 10: M8_LAUNCH_UNPERMUTE(10); break;
            default:
                printf("[M8][FAIL] topK=%u unsupported (1..10)\n", ds.topK);
                aclrtFree(yDev); aclrtFree(slotDev); aclrtFree(wDev); aclrtFree(oDev);
                return false;
        }
        #undef M8_LAUNCH_UNPERMUTE
        const aclError err = aclrtSynchronizeStream(stream);
        if (err != ACL_SUCCESS) {
            printf("[M8][FAIL] %s unpermute launch/sync error %d\n", tag.c_str(), (int)err);
            aclrtFree(yDev); aclrtFree(slotDev); aclrtFree(wDev); aclrtFree(oDev);
            return false;
        }

        std::vector<uint16_t> got(ds.m * HIDDEN);
        aclrtMemcpy(got.data(), oBytes, oDev, oBytes, ACL_MEMCPY_DEVICE_TO_HOST);

        uint32_t mismatch = 0;
        size_t firstBad = 0;
        for (size_t i = 0; i < static_cast<size_t>(ds.m) * HIDDEN && mismatch < 5; ++i) {
            if (got[i] != ref[i]) {
                if (mismatch == 0) firstBad = i;
                if (failIters == 0) {
                    printf("[M8][FAIL] %s out[%zu] got 0x%04x (%.6g) expect 0x%04x (%.6g)\n", tag.c_str(), i,
                           got[i], Bf16ToF32(got[i]), ref[i], Bf16ToF32(ref[i]));
                }
                ++mismatch;
            }
        }
        if (mismatch != 0) {
            ++failIters;
            if (failIters == 1) {
                printf("[M8][DIAG] iter=%u first bad idx=%zu (row %zu); bad rows:", it, firstBad,
                       firstBad / HIDDEN);
                for (size_t i = 0; i < static_cast<size_t>(ds.m); ++i) {
                    for (size_t j = 0; j < HIDDEN; ++j) {
                        if (got[i * HIDDEN + j] != ref[i * HIDDEN + j]) { printf(" %zu", i); break; }
                    }
                }
                printf("\n");
                WriteBin("/tmp/m8_fail.bin", got.data(), oBytes);
            }
        } else if (getenv("M8_DUMP") != nullptr) {
            const std::string fn = tag + dumpSuffix;
            WriteBin(fn.c_str(), got.data(), oBytes);
        }
    }
    const bool pass = failIters == 0;
    printf("[M8] %s unpermute : %s (out vs C-ref bit-exact, %u/%u iters failed, blk=%u)\n", tag.c_str(),
           pass ? "PASS" : "FAIL", failIters, iters, blk);

    aclrtFree(yDev); aclrtFree(slotDev); aclrtFree(wDev); aclrtFree(oDev);
    return pass;
}

int32_t main(int32_t argc, char* argv[])
{
    const std::string dataRoot = (argc >= 2) ? argv[1] : "tools/golden/data";
    std::vector<std::string> cases;
    for (int i = 2; i < argc; ++i) cases.emplace_back(argv[i]);
    if (cases.empty()) { cases = {"m1", "m33"}; }  // 任务书：m=1 与 m=33 两组

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    bool allOk = true;
    for (const std::string& name : cases) {
        const std::string dir = dataRoot + "/" + name;
        Dataset ds;
        if (!LoadDataset(dir, ds)) { allOk = false; continue; }
        std::vector<int32_t> invSlot;
        std::vector<int32_t> wTkPacked;
        if (!BuildRouting(ds, invSlot, wTkPacked)) { allOk = false; continue; }
        printf("[M8] case %s: m=%u topK=%u E=%u total=%u\n", name.c_str(), ds.m, ds.topK, ds.E, ds.total);

        // permute：device vs golden x_sorted（bitwise）
        allOk &= RunPermute(stream, ds, name);

        // unpermute 变体 A：y_sorted = golden x_sorted（golden 派生确定性激活）
        allOk &= RunUnpermute(stream, ds, ds.xSortedGolden.data(), invSlot.data(), wTkPacked.data(), name,
                              "_unperm_goldy_device.bin");

        // unpermute 变体 B：合成 y_sorted（hash 确定性；覆盖非 golden 激活）
        std::vector<uint16_t> ySynth;
        GenSyntheticY(ySynth, ds.total, 20260926);
        allOk &= RunUnpermute(stream, ds, ySynth.data(), invSlot.data(), wTkPacked.data(), name,
                              "_unperm_synth_device.bin");
        if (getenv("M8_DUMP") != nullptr) {
            WriteBin((name + "_y_synth.bin").c_str(), ySynth.data(), ySynth.size() * 2);
        }
    }
    printf("[M8] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
