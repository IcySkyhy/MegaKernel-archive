/**
 * m22_router512.asc —— M22：**真实规模** MoE router（512 专家 / top-10）
 *
 * 目标模型 Qwen3.8-Flash-Next-MXFP4 的 `model.language_model.layers.0.mlp.gate.weight`
 * = bf16 [512, 2560]。路由语义与 M4 定的 CPU golden（tools/golden/moe_block_ref.py
 * ::router_topk）逐句一致：
 *   logits  = x[m,2560] @ router_w[512,2560]^T        (bf16 输入，fp32 累加)
 *   scores  = softmax(logits) 行级（max-shift；除 sum 与 renorm 抵消）
 *   topk    = scores 降序 top-10；并列取小 expert id
 *   weights = topk scores 归一到行和 1（norm_topk_prob），bf16 输出
 *
 * 移植自 m7_router_topk（M42 任务 1：复制进自己目录再改；m7 源文件不动）。
 * 逐文件差异见 README「移植边界」表。本文件相对 m7 的三处实质改动：
 *
 *   ① **RB 16 -> 8**（m22_resources.h）：为契约输出段腾 UB 余量；
 *   ② **归并树编译期可选**（M22_MERGE_MODE=2 复用 m7 的 2 路树；=4 用 4 路树，
 *      由 probe_sync_quirks 探针 A 的实证支撑——见 README「归并树」节与每级代价表）；
 *   ③ **新增契约输出段**（M40 MoE 段的输入契约）：每专家 token 计数（count 模式
 *      group_list）、紧凑专家槽起点（独占前缀和）、active_num / 活跃专家数、
 *      count 模式 int64 编码投影、以及 (expert, token) 稳定序的 perm_src/perm_expert。
 *
 * 权重 staging（M42 任务 3）：**绝不**一次性把 512×2560 fp32 预转进 UB
 * （那需要 5.25MB ≫ 248KB，正是 m13 缩形档布局在真实规模下失效的原因）。
 * 本实现按行 staging：权重行以 bf16 ping-pong（UB_WB，2×5120B）从 GM 流入，
 * 向量侧只保留**固定 8 行**的 fp32 解包窗（UB_WF，80KB，与专家总数无关）。
 * UB 总占用 178.6KB / 248KB 可用（m22_resources.h 末尾逐块预算表）。
 * L1（512KB/AIC）占用 **0 字节**——本核是纯 AIV 向量 GEMV，不用 cube、不搬 L1。
 *
 * 数据通路（全部基础 API + 指令级 intrinsic，无 TPipe/TBuf/TQue/AllocTensor）：
 *   GM --DataCopy(MTE2)--> UB(x 块 bf16 / w 行 bf16) --Reg LoadAlign(UNPACK)/Cast/
 *   MulAddDst--> fp32 累加 --> logits(UB) --Reg Max/Sub/Exp--> e_i --Sort32--> 16 个
 *   32 对有序块 --MrgSort 树--> 全序 --Extract--> top-10 --Reg Div/位打包--> bf16
 *   --DataCopy/DataCopyPad(MTE3)--> GM；随后标量段读回 ids 做计数/落位。
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal；release 用阻塞释放，mode=false = CANN 默认 ASC_LOCK_BLOCK）：
 *   BUF_X(0) x 块 MTE2->V；BUF_W0/W1(1,2) w 行 ping-pong MTE2->V；
 *   BUF_LOG(3) logits V->MTE3；BUF_TOP(4) ids/weights V->MTE3，之后再被 PIPE_S 取
 *   （**值依赖**：标量要消费 MTE3 写出的 ids —— docs/05 §2 允许的 PIPE_S 例外；
 *   用 BUF_TOP 的阻塞释放 + PIPE_S get 表达，**不用** set/wait flag）；
 *   BUF_RT(5) 计数段标量写 UB -> MTE3 出 GM 的握手。
 *
 * 3510 实测 quirk 规避（沿用 m7，逐条见 README）：bf16 位视图寻址、LocalMemBar 必须在
 * __VEC_SCOPE__ 内、非 32B 对齐 StoreAlign 507035、4 路 MrgSort4 API 是 no-op（用
 * MrgSort+MrgSort4Info）、Reg::Arange 只填 64 lane、fp32->bf16 cast 落偶位（位运算打包）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>
#include <cstring>
#include <cmath>
#include <ctime>
#include <vector>
#include <sys/stat.h>     // mkdir(2)：host dump 目录创建不走 shell

#include "m22_resources.h"

namespace {
using namespace AscendC;
using namespace AscendC::Reg;
using namespace M22;

constexpr CastTrait castTraitBf16ToF32 = {RegLayout::ZERO, SatMode::UNKNOWN,
                                          MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
constexpr CastTrait castTraitF32ToBf16 = {RegLayout::ZERO, SatMode::NO_SAT,
                                          MaskMergeMode::ZEROING, RoundMode::CAST_RINT};

template <typename T>
__aicore__ inline LocalTensor<T> MkT(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<T>(TPosition::VECCALC, byteOff, count);
}

// BufferID 原语：get（等 token 空闲）/ 阻塞释放（mode=false = CANN 默认 ASC_LOCK_BLOCK；等本 pipe 已发射访存落地后释放）
template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// 公开 Mutex::Lock/Unlock 的 mode 硬编码为 0（docs/05 §6.1）——标量段（PIPE_S）用它，
// 与 m13 的 IndexGenStage 同款；阻塞释放语义只用于 MTE2/V/MTE3 生产侧（BufRelease）。
template <pipe_t pipe>
__aicore__ inline void MutexLock(AscendC::MutexID id)
{
    AscendC::Mutex::Lock<pipe>(id);
}
template <pipe_t pipe>
__aicore__ inline void MutexUnlock(AscendC::MutexID id)
{
    AscendC::Mutex::Unlock<pipe>(id);
}

// ============================================================
// Kernel 实现
// ============================================================
class Router512 {
public:
    __aicore__ inline Router512() {}

    __aicore__ inline void Init(__gm__ uint16_t* x, __gm__ uint16_t* w,
                               __gm__ uint16_t* logits, __gm__ int32_t* ids,
                               __gm__ uint16_t* weights, __gm__ int32_t* counts,
                               __gm__ int32_t* slotBase, __gm__ int32_t* permSrc,
                               __gm__ int32_t* permExp, __gm__ int32_t* group64,
                               __gm__ int32_t* scalars, uint32_t m)
    {
        M = m;
        xGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(x), static_cast<uint64_t>(M) * HIDDEN);
        wGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(w), static_cast<uint64_t>(E) * HIDDEN);
        logitsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(logits), static_cast<uint64_t>(M) * E);
        idsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ids), static_cast<uint64_t>(M) * KTOPK);
        weightsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(weights), static_cast<uint64_t>(M) * KTOPK);
        countsGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(counts), E);
        baseGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(slotBase), E);
        permSrcGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permSrc), static_cast<uint64_t>(M) * KTOPK);
        permExpGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(permExp), static_cast<uint64_t>(M) * KTOPK);
        group64Gm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(group64), static_cast<uint64_t>(E) * 2);
        sclGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(scalars), 16);
        // ids 的标量读视图（标量段用；每对象只 SetGlobalBuffer 一次 —— 3510 quirk #21）
        idsRdGm.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ids), static_cast<uint64_t>(M) * KTOPK);
    }

    __aicore__ inline void Process()
    {
        BuildIndexTemplate();
        const uint32_t nblk = (M + RB - 1) / RB;
        for (uint32_t b = 0; b < nblk; ++b) {
            const uint32_t b0 = b * RB;
            const uint32_t rows = (M - b0 < RB) ? (M - b0) : RB;
            CopyInX(b0, rows);
            Gemv(rows);
            for (uint32_t r = 0; r < rows; ++r) {
                SoftmaxTopkRenormRow(r);
            }
            CopyOut(b0, rows);
        }
        RouteCounts();
    }

private:
    // ---- arange 索引模板（0..511），整个 kernel 建一次（同 pipe 串行，无需 BufferID） ----
    __aicore__ inline void BuildIndexTemplate()
    {
        // 3510 实测 Reg::Arange 只填 64 lane（fp32 VL），按 64-lane 分 8 块建模板
        __VEC_SCOPE__
        {
            uint32_t cnt64 = 64;
            MaskReg m64 = UpdateMask<int32_t>(cnt64);
            for (uint16_t c = 0; c < static_cast<uint16_t>(E / 64); ++c) {
                RegTensor<int32_t> rg;
                Arange(rg, static_cast<int32_t>(c * 64));
                StoreAlign((__ubuf__ int32_t*)(UB_IDX) + c * 64, rg, m64);
            }
        }
    }

    // ---- MTE2：x row-block 搬入（每行 5120B 一次拷贝，bf16 切片寻址） ----
    __aicore__ inline void CopyInX(uint32_t b0, uint32_t rows)
    {
        BufAcquire<PIPE_MTE2>(BUF_X);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> xT = MkT<bfloat16_t>(UB_XB + r * HIDDEN * 2, HIDDEN);
            DataCopy(xT, xGm[(b0 + r) * HIDDEN], HIDDEN);
        }
        BufRelease<PIPE_MTE2>(BUF_X);
    }

    // ---- MTE2：预取 w 行到 ping/pong（bf16 切片寻址） ----
    __aicore__ inline void LoadW(uint32_t e, uint32_t bufSel)
    {
        if (e >= E) return;
        if (bufSel == 0) {
            BufAcquire<PIPE_MTE2>(BUF_W0);
            LocalTensor<bfloat16_t> wT = MkT<bfloat16_t>(UB_WB, HIDDEN);
            DataCopy(wT, wGm[e * HIDDEN], HIDDEN);
            BufRelease<PIPE_MTE2>(BUF_W0);
        } else {
            BufAcquire<PIPE_MTE2>(BUF_W1);
            LocalTensor<bfloat16_t> wT = MkT<bfloat16_t>(UB_WB + HIDDEN * 2, HIDDEN);
            DataCopy(wT, wGm[e * HIDDEN], HIDDEN);
            BufRelease<PIPE_MTE2>(BUF_W1);
        }
    }

    // ---- V：w 行 bf16 -> fp32 预转（UNPACK 载入 + Cast，64 元素/步） ----
    __aicore__ inline void PrecastW(uint32_t bufSel, uint32_t slot)
    {
        const uint32_t srcOff = (bufSel == 0) ? UB_WB : (UB_WB + HIDDEN * 2);
        __ubuf__ bfloat16_t* wSrc = reinterpret_cast<__ubuf__ bfloat16_t*>(srcOff);
        __ubuf__ float* wDst = reinterpret_cast<__ubuf__ float*>(UB_WF + slot * HIDDEN * 4);
        __VEC_SCOPE__
        {
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t c = 0; c < static_cast<uint16_t>(NCHUNK); ++c) {
                RegTensor<bfloat16_t> b0;
                RegTensor<float> f0;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(b0, wSrc + c * KCHUNK);
                Cast<float, bfloat16_t, castTraitBf16ToF32>(f0, b0, full);
                StoreAlign(wDst + c * KCHUNK, f0, full);
            }
        }
    }

    // ---- 8 专家点积（1 行 x WF[0..7]）：40 步 UNPACK+Cast+fp32 MAC，8 路归约后 ----
    // Interleave 树拼成 8 连续 lane，mask=8 StoreAlign 写 logP（32B 对齐）
    __aicore__ inline void Dot8Row(__ubuf__ bfloat16_t* xSrc, __ubuf__ float* logP)
    {
        __VEC_SCOPE__
        {
            RegTensor<float> a0, a1, a2, a3, a4, a5, a6, a7;
            RegTensor<float> xf, wf0, wf1, wf2, wf3, wf4, wf5, wf6, wf7;
            RegTensor<float> i01, i23, i45, i67, j0, j1, j2, j3, v, vv;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(a0, 0.0f); Duplicate(a1, 0.0f); Duplicate(a2, 0.0f); Duplicate(a3, 0.0f);
            Duplicate(a4, 0.0f); Duplicate(a5, 0.0f); Duplicate(a6, 0.0f); Duplicate(a7, 0.0f);
            for (uint16_t c = 0; c < static_cast<uint16_t>(NCHUNK); ++c) {
                RegTensor<bfloat16_t> xb;
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(xb, xSrc + c * KCHUNK);
                Cast<float, bfloat16_t, castTraitBf16ToF32>(xf, xb, full);
                const uint32_t off = c * KCHUNK;
                LoadAlign(wf0, reinterpret_cast<__ubuf__ float*>(UB_WF + 0 * HIDDEN * 4) + off);
                LoadAlign(wf1, reinterpret_cast<__ubuf__ float*>(UB_WF + 1 * HIDDEN * 4) + off);
                LoadAlign(wf2, reinterpret_cast<__ubuf__ float*>(UB_WF + 2 * HIDDEN * 4) + off);
                LoadAlign(wf3, reinterpret_cast<__ubuf__ float*>(UB_WF + 3 * HIDDEN * 4) + off);
                LoadAlign(wf4, reinterpret_cast<__ubuf__ float*>(UB_WF + 4 * HIDDEN * 4) + off);
                LoadAlign(wf5, reinterpret_cast<__ubuf__ float*>(UB_WF + 5 * HIDDEN * 4) + off);
                LoadAlign(wf6, reinterpret_cast<__ubuf__ float*>(UB_WF + 6 * HIDDEN * 4) + off);
                LoadAlign(wf7, reinterpret_cast<__ubuf__ float*>(UB_WF + 7 * HIDDEN * 4) + off);
                MulAddDst(a0, xf, wf0, full);
                MulAddDst(a1, xf, wf1, full);
                MulAddDst(a2, xf, wf2, full);
                MulAddDst(a3, xf, wf3, full);
                MulAddDst(a4, xf, wf4, full);
                MulAddDst(a5, xf, wf5, full);
                MulAddDst(a6, xf, wf6, full);
                MulAddDst(a7, xf, wf7, full);
            }
            Reduce<ReduceType::SUM, float>(a0, a0, full);
            Reduce<ReduceType::SUM, float>(a1, a1, full);
            Reduce<ReduceType::SUM, float>(a2, a2, full);
            Reduce<ReduceType::SUM, float>(a3, a3, full);
            Reduce<ReduceType::SUM, float>(a4, a4, full);
            Reduce<ReduceType::SUM, float>(a5, a5, full);
            Reduce<ReduceType::SUM, float>(a6, a6, full);
            Reduce<ReduceType::SUM, float>(a7, a7, full);
            // Reduce 输出为标量寄存器（lane0 有效）；Interleave 树拼 8 连续 lane
            Interleave(i01, vv, a0, a4);   // [d0,d4]
            Interleave(i23, vv, a2, a6);   // [d2,d6]
            Interleave(i45, vv, a1, a5);   // [d1,d5]
            Interleave(i67, vv, a3, a7);   // [d3,d7]
            Interleave(j0, j1, i01, i23);  // [d0,d2,d4,d6]
            Interleave(j2, j3, i45, i67);  // [d1,d3,d5,d7]
            Interleave(v, vv, j0, j2);     // [d0..d7]
            uint32_t eight = EGRP;
            MaskReg m8 = UpdateMask<float>(eight);
            StoreAlign(logP, v, m8);
        }
    }

    // ---- GEMV：logits[r][e] = sum_k x[r,k]*w[e,k]（fp32 向量 MAC，权重按行流式） ----
    __aicore__ inline void Gemv(uint32_t rows)
    {
        BufAcquire<PIPE_V>(BUF_X);
        LoadW(0, 0);
        LoadW(1, 1);
        // 协议：进入每组时 W0=w[e0]、W1=w[e0+1]（上一组尾部预取或初始化）。
        // slot s 预转 w[e0+s]（缓冲 s%2）；每次预转后 MTE2 把 w[e0+s+2] 装入该缓冲。
        for (uint32_t e0 = 0; e0 < E; e0 += EGRP) {
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 0);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 2, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 1);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 3, 1);
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 2);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 4, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 3);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 5, 1);
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 4);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 6, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 5);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 7, 1);
            BufAcquire<PIPE_V>(BUF_W0);
            PrecastW(0, 6);
            BufRelease<PIPE_V>(BUF_W0);
            LoadW(e0 + 8, 0);
            BufAcquire<PIPE_V>(BUF_W1);
            PrecastW(1, 7);
            BufRelease<PIPE_V>(BUF_W1);
            LoadW(e0 + 9, 1);
            // 组内 8 专家 x 全部行：共享 x 载入
            for (uint32_t r = 0; r < rows; ++r) {
                Dot8Row(reinterpret_cast<__ubuf__ bfloat16_t*>(UB_XB + r * HIDDEN * 2),
                        reinterpret_cast<__ubuf__ float*>(UB_LOG + r * E * 4) + e0);
            }
        }
        BufRelease<PIPE_V>(BUF_X);
    }

    // ---- 行内 softmax(max-shift exp) + Sort32 + 归并树 + Extract + renorm ----
    __aicore__ inline void SoftmaxTopkRenormRow(uint32_t r)
    {
        const uint32_t logOff = UB_LOG + r * E * 4;
        // 1) 行 max；2) e_i = exp(l_i - max) 写入 UB_VAL（softmax 的除 sum 与 renorm 抵消）
        BufAcquire<PIPE_V>(BUF_LOG);
        __VEC_SCOPE__
        {
            RegTensor<float> v, m, mx, dm;
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(m, -3.0e38f);
            for (uint16_t c = 0; c < static_cast<uint16_t>(E / VLF); ++c) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(logOff) + c * VLF);
                Max(m, m, v, full);
            }
            Reduce<ReduceType::MAX, float>(mx, m, full);
            Duplicate(dm, mx, full);
            for (uint16_t c = 0; c < static_cast<uint16_t>(E / VLF); ++c) {
                LoadAlign(v, reinterpret_cast<__ubuf__ float*>(logOff) + c * VLF);
                Sub(v, v, dm, full);
                StoreAlign(reinterpret_cast<__ubuf__ float*>(logOff) + c * VLF, v, full);  // logits -= max
                Exp(v, v, full);
                StoreAlign(reinterpret_cast<__ubuf__ float*>(UB_VAL) + c * VLF, v, full);
            }
        }
        // 3) Sort32：16 个 32 块内降序（值, 全局 expert id）
        {
            LocalTensor<float> valT = MkT<float>(UB_VAL, E);
            LocalTensor<float> tmpT = MkT<float>(UB_TMP, 2 * E);
            LocalTensor<uint32_t> idxT = MkT<uint32_t>(UB_IDX, E);
            Sort32(tmpT, valT, idxT, SORT_BLK);
        }
        BufRelease<PIPE_V>(BUF_LOG);
        // 4) 归并树 -> 全序
        MergeTree();
        // 5) Extract 前 64 对 -> (OUTV, OUTI)
        {
            LocalTensor<float> mT = MkT<float>(UB_MB, 2 * E);
            LocalTensor<float> vT = MkT<float>(UB_OUTV, 64);
            LocalTensor<uint32_t> iT = MkT<uint32_t>(UB_OUTI, 64);
            Extract(vT, iT, mT, 2);
        }
        // 6) renorm（除以 top-10 的 sum）+ bf16 化 + staging 写出
        BufAcquire<PIPE_V>(BUF_TOP);
        __VEC_SCOPE__
        {
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
            RegTensor<float> vals;
            RegTensor<int32_t> idxs;
            LoadAlign(vals, reinterpret_cast<__ubuf__ float*>(UB_OUTV));
            LoadAlign(idxs, reinterpret_cast<__ubuf__ int32_t*>(UB_OUTI));
            uint32_t cnt10 = KTOPK;
            MaskReg m10 = UpdateMask<float>(cnt10);
            RegTensor<float> s, ds;
            Reduce<ReduceType::SUM, float>(s, vals, m10);
            MaskReg full = CreateMask<float, MaskPattern::ALL>();
            Duplicate(ds, s, full);
            Div(vals, vals, ds, m10);
            // fp32->bf16(RNE) 用纯整型向量位运算（3510 实测 fp32->bf16 cast 落 32bit lane
            // 低半/偶位，直接 store 有空洞；M10 实测连续基础 Cast 亦不稳）
            RegTensor<int32_t> t16, t1, rnd, ev, od, pk;
            Duplicate(t16, 16);
            Duplicate(t1, 1);
            ShiftRight(t16, (RegTensor<int32_t>&)vals, t16, m10);
            And(t16, t16, t1, m10);
            Add(rnd, (RegTensor<int32_t>&)vals, t16, m10);
            Duplicate(t16, 0x7FFF);
            Add(rnd, rnd, t16, m10);
            Duplicate(t16, 16);
            ShiftRight(rnd, rnd, t16, m10);   // rnd lane j = bf16_j（低 16 位）
            DeInterleave(ev, od, rnd, rnd);
            Duplicate(t16, 16);
            ShiftLeft(od, od, t16, m10);
            Or(pk, ev, od, m10);              // pk lane j = bf16[2j] | bf16[2j+1]<<16
            MaskReg fullU = CreateMask<int32_t, MaskPattern::ALL>();
            StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_WS + r * 128 * 2), pk, fullU);
            MaskReg fullI = CreateMask<int32_t, MaskPattern::ALL>();
            StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_IDS + r * 128 * 4), idxs, fullI);
            LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
        }
        BufRelease<PIPE_V>(BUF_TOP);
    }

#if M22_MERGE_MODE == 4
    // ---- 4 路归并树（2 级：16 块 -> 4 组 -> 1 组）----
    // 正确性依据（probe_sync_quirks 探针 A，A02/A15/A20 三变体、逐元素 dump 归档）：
    // 4 路 MrgSort(validBit=0b1111, elementLengths 全 32, rep=1, exhausted=false) 在
    // dav-3510 上完全正确；当年 #19 的"丢 src3/src4 索引"是误用 MrgSort4 API（静默 no-op）。
    // 每级取输入前 32 对、输出 Σlen = 128 对：top-10(并集) ⊆ top-32(各输入) 归纳成立。
    __aicore__ inline void MergeTree()
    {
        LocalTensor<float> srcT = MkT<float>(UB_TMP, 2 * E);
        LocalTensor<float> aT = MkT<float>(UB_MA, 2 * E);
        LocalTensor<float> bT = MkT<float>(UB_MB, 2 * E);
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 4; ++g) {   // level1: 16 块 -> 4 组（每组 128 对 = 256 float）
            Merge4(aT[g * 256], srcT[(4 * g + 0) * 64], srcT[(4 * g + 1) * 64],
                   srcT[(4 * g + 2) * 64], srcT[(4 * g + 3) * 64], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        Merge4(bT[0], aT[0], aT[256], aT[512], aT[768], 32);   // level2: 4 组 -> 128 对
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
    }

    __aicore__ inline void Merge4(const LocalTensor<float>& dst, const LocalTensor<float>& s1,
                                  const LocalTensor<float>& s2, const LocalTensor<float>& s3,
                                  const LocalTensor<float>& s4, uint32_t pairLen)
    {
        MrgSort4Info params;
        params.elementLengths[0] = static_cast<uint16_t>(pairLen);
        params.elementLengths[1] = static_cast<uint16_t>(pairLen);
        params.elementLengths[2] = static_cast<uint16_t>(pairLen);
        params.elementLengths[3] = static_cast<uint16_t>(pairLen);
        params.validBit = 0b1111;         // 4 路全开；任一路 len=0 会整段静默不写（探针 A07）
        params.repeatTimes = 1;
        params.ifExhaustedSuspension = false;
        MrgSortSrcList<float> sl;
        sl.src1 = s1;
        sl.src2 = s2;
        sl.src3 = s3;
        sl.src4 = s4;
        MrgSort(dst, sl, params);
    }
#else
    // ---- m7 现行 2 路归并树（8+4+2+1 次；每级取输入前 32 对、输出 64 对）----
    __aicore__ inline void MergeTree()
    {
        LocalTensor<float> srcT = MkT<float>(UB_TMP, 2 * E);
        LocalTensor<float> aT = MkT<float>(UB_MA, 2 * E);
        LocalTensor<float> bT = MkT<float>(UB_MB, 2 * E);
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 8; ++g) {   // level1: 16 块 -> 8 组, TMP -> MA
            Merge2(aT[g * 128], srcT[(2 * g) * 64], srcT[(2 * g + 1) * 64], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 4; ++g) {   // level2: 8 组 -> 4 组, MA -> MB
            Merge2(bT[g * 128], aT[(2 * g) * 128], aT[(2 * g + 1) * 128], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        for (uint32_t g = 0; g < 2; ++g) {   // level3: 4 组 -> 2 组, MB -> MA
            Merge2(aT[g * 128], bT[(2 * g) * 128], bT[(2 * g + 1) * 128], 32);
        }
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
        Merge2(bT[0], aT[0], aT[128], 32);   // level4: 2 组 -> 1, MA -> MB
        __VEC_SCOPE__ { LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>(); }
    }

    __aicore__ inline void Merge2(const LocalTensor<float>& dst, const LocalTensor<float>& s1,
                                  const LocalTensor<float>& s2, uint32_t pairLen)
    {
        MrgSort4Info params;
        params.elementLengths[0] = static_cast<uint16_t>(pairLen);
        params.elementLengths[1] = static_cast<uint16_t>(pairLen);
        params.elementLengths[2] = 0;
        params.elementLengths[3] = 0;
        params.validBit = 0b0011;
        params.repeatTimes = 1;
        params.ifExhaustedSuspension = false;
        MrgSortSrcList<float> sl;
        sl.src1 = s1;
        sl.src2 = s2;
        sl.src3 = s2;
        sl.src4 = s2;
        MrgSort(dst, sl, params);
    }
#endif

    // ---- MTE3：logits + ids + weights 写出（GM 一律 bf16 位视图寻址） ----
    __aicore__ inline void CopyOut(uint32_t b0, uint32_t rows)
    {
        BufAcquire<PIPE_MTE3>(BUF_LOG);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> lT = MkT<bfloat16_t>(UB_LOG + r * E * 4, E * 2);
            DataCopy(logitsGm[(b0 + r) * E * 2], lT, E * 2);
        }
        BufRelease<PIPE_MTE3>(BUF_LOG);
        BufAcquire<PIPE_MTE3>(BUF_TOP);
        for (uint32_t r = 0; r < rows; ++r) {
            LocalTensor<bfloat16_t> iT = MkT<bfloat16_t>(UB_IDS + r * 128 * 4, KTOPK * 2);
            DataCopyPad(idsGm[(b0 + r) * KTOPK * 2], iT, DataCopyExtParams{1, KTOPK * 4, 0, 0, 0});
            LocalTensor<bfloat16_t> wT = MkT<bfloat16_t>(UB_WS + r * 128 * 2, KTOPK);
            DataCopyPad(weightsGm[(b0 + r) * KTOPK], wT, DataCopyExtParams{1, KTOPK * 2, 0, 0, 0});
        }
        BufRelease<PIPE_MTE3>(BUF_TOP);
    }

    // ---- 契约输出段（M40 MoE 段输入契约）----
    //
    // 输入：GM 上的 topk_ids[m,10]（本核 MTE3 刚写出）。消费前必须等 MTE3 落地：
    // 用 BUF_TOP 的阻塞释放 + 本侧 PIPE_S get 表达（值依赖 → docs/05 §2 允许的
    // PIPE_S 例外），**不引入 set/wait flag**。
    //
    // 产出（逐项与 M40 契约对应）：
    //   UB_CNT/countsGm   : 每专家 token 计数（**count 模式** group_list 载荷，Σ = m*topk）
    //   UB_BASE/baseGm    : 独占前缀和 = **紧凑专家槽**起点（非"每专家固定槽"）
    //   UB_G64/group64Gm  : 官方 count 模式编码（int64[512]，低位=count、高位=0）
    //   permSrcGm/permExpGm: (expert, token) 稳定序的槽位->源 token / 专家 id
    //   sclGm[0] = active_num（官方语义 = m*topk，扩展槽总数）
    //   sclGm[1] = 活跃专家数（count 模式循环上界）；sclGm[2] = 脏 id 诊断；sclGm[3] = Σt_e
    __aicore__ inline void RouteCounts()
    {
        const uint32_t S = M * KTOPK;

        // 1) 等 ids 的 MTE3 GM 写落地（BUF_TOP 的阻塞释放已保证），再进标量段
        MutexLock<PIPE_S>(BUF_TOP);
        MutexLock<PIPE_S>(BUF_RT);

        __ubuf__ int32_t* cnt = reinterpret_cast<__ubuf__ int32_t*>(UB_CNT);
        __ubuf__ int32_t* base = reinterpret_cast<__ubuf__ int32_t*>(UB_BASE);
        __ubuf__ int32_t* cur = reinterpret_cast<__ubuf__ int32_t*>(UB_CUR);
        __ubuf__ int32_t* scl = reinterpret_cast<__ubuf__ int32_t*>(UB_SCL);
        __ubuf__ int32_t* g64 = reinterpret_cast<__ubuf__ int32_t*>(UB_G64);

        for (uint32_t e = 0; e < E; ++e) {
            cnt[e] = 0;
        }
        uint32_t badId = 0;
        for (uint32_t s = 0; s < S; ++s) {
            const int32_t e = idsRdGm.GetValue(s);
            if (e >= 0 && e < static_cast<int32_t>(E)) {
                cnt[e] = cnt[e] + 1;
            } else {
                ++badId;
            }
        }
        uint32_t off = 0;      // Σt_e
        uint32_t nAct = 0;     // 活跃专家数
        for (uint32_t e = 0; e < E; ++e) {
            const int32_t c = cnt[e];
            base[e] = static_cast<int32_t>(off);
            cur[e] = static_cast<int32_t>(off);
            off += static_cast<uint32_t>(c);
            if (c > 0) {
                ++nAct;
            }
            // count 模式 int64 group_list：低 32 位 = count，高 32 位 = 0（count >= 0）
            g64[2 * e] = c;
            g64[2 * e + 1] = 0;
        }
        // 落位：按 (token, rank) 遍历 + 每专家游标 → 槽位序 = (expert, token) 稳定序，
        // 与 golden moe_block_ref.moe_permute 的 stable argsort 同语义
        for (uint32_t t = 0; t < M; ++t) {
            for (uint32_t k = 0; k < KTOPK; ++k) {
                const int32_t e = idsRdGm.GetValue(t * KTOPK + k);
                if (e < 0 || e >= static_cast<int32_t>(E)) {
                    continue;
                }
                const uint32_t pos = static_cast<uint32_t>(cur[e]);
                cur[e] = static_cast<int32_t>(pos + 1);
                permSrcGm.SetValue(pos, static_cast<int32_t>(t));
                permExpGm.SetValue(pos, e);
            }
        }
        scl[0] = static_cast<int32_t>(S);          // active_num（官方语义）
        scl[1] = static_cast<int32_t>(nAct);       // 活跃专家数
        scl[2] = static_cast<int32_t>(badId);      // 诊断（恒 0）
        scl[3] = static_cast<int32_t>(off);        // Σt_e（恒 == S，guard）

        MutexUnlock<PIPE_S>(BUF_RT);
        // 2) UB -> GM（PIPE_S 标量写 -> MTE3 读的 BufferID 握手）
        BufAcquire<PIPE_MTE3>(BUF_RT);
        LocalTensor<int32_t> cntL = MkT<int32_t>(UB_CNT, E);
        LocalTensor<int32_t> baseL = MkT<int32_t>(UB_BASE, E);
        LocalTensor<int32_t> g64L = MkT<int32_t>(UB_G64, 2 * E);
        LocalTensor<int32_t> sclL = MkT<int32_t>(UB_SCL, 4);
        DataCopyPad(countsGm[0], cntL, DataCopyExtParams{1, E * 4, 0, 0, 0});
        DataCopyPad(baseGm[0], baseL, DataCopyExtParams{1, E * 4, 0, 0, 0});
        DataCopyPad(group64Gm[0], g64L, DataCopyExtParams{1, E * 8, 0, 0, 0});
        DataCopyPad(sclGm[0], sclL, DataCopyExtParams{1, 16, 0, 0, 0});
        BufRelease<PIPE_MTE3>(BUF_RT);
        MutexUnlock<PIPE_S>(BUF_TOP);
    }

private:
    uint32_t M = 0;
    GlobalTensor<bfloat16_t> xGm;
    GlobalTensor<bfloat16_t> wGm;
    GlobalTensor<bfloat16_t> logitsGm;   // fp32 数据的 bf16 位视图
    GlobalTensor<bfloat16_t> idsGm;      // int32 数据的 bf16 位视图
    GlobalTensor<bfloat16_t> weightsGm;
    GlobalTensor<int32_t> countsGm;
    GlobalTensor<int32_t> baseGm;
    GlobalTensor<int32_t> permSrcGm;
    GlobalTensor<int32_t> permExpGm;
    GlobalTensor<int32_t> group64Gm;     // int64[E] 的 int32 位视图（低位在前）
    GlobalTensor<int32_t> sclGm;
    GlobalTensor<int32_t> idsRdGm;       // ids 的标量读视图
};

} // namespace

__vector__ __global__ void router512_kernel(__gm__ uint16_t* x, __gm__ uint16_t* w,
                                           __gm__ uint16_t* logits, __gm__ int32_t* ids,
                                           __gm__ uint16_t* weights, __gm__ int32_t* counts,
                                           __gm__ int32_t* slotBase, __gm__ int32_t* permSrc,
                                           __gm__ int32_t* permExp, __gm__ int32_t* group64,
                                           __gm__ int32_t* scalars, uint32_t m)
{
    Router512 op;
    op.Init(x, w, logits, ids, weights, counts, slotBase, permSrc, permExp, group64, scalars, m);
    op.Process();
}

// ============================================================
// Host 侧：输入生成 + kernel 运行 + 读回 + 三层自检 + dump
// ============================================================

static float Bf16ToF32(uint16_t h)
{
    uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

// 确定性伪随机（与 m7 的 Hash3 同款，保证与 m7 输入逐字节一致）
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// 档位 A：确定性 bf16 激活（指数窗 [122,132)，值域 ~[2^-5, 32]）——与 m7 逐字节一致，
// 用于「移植等价性」对照与真实路由分布（logits ~±20，无并列）。
static void GenActivationsUniform(uint16_t* x, uint32_t m, uint32_t seed)
{
    for (uint32_t i = 0; i < m; ++i) {
        for (uint32_t j = 0; j < HIDDEN; ++j) {
            const uint32_t h = Hash3(i, j, seed);
            const uint32_t exp = 122 + (h % 10);
            x[static_cast<size_t>(i) * HIDDEN + j] =
                static_cast<uint16_t>(((h >> 8) & 0x8000) | (exp << 7) | ((h >> 9) & 0x7F));
        }
    }
}

// 档位 B：非均匀分布用例的**受控**输入。gate 权重取"合成 one-hot"（W[e][k] = 1 当 k==e
// 否则 0，e < 512 ≤ 2560），于是 logit[t][e] == x[t][e] 精确成立 ⇒ 可以逐 token 指定
// 命中哪些专家、各得几个槽位，覆盖「活跃专家数可变 / 每专家 token 数不均 / 含空专家 /
// 含单 token 专家」四类边界。logit 值取 12.0 - 0.5*rank（bf16 精确），同一个 token 内
// 10 个 logit 互不相同且间隔 0.5，无并列歧义。
static bool BuildProfile(uint32_t kind, uint32_t m, std::vector<int32_t>& counts, const char** desc)
{
    counts.assign(E, 0);
    const uint32_t S = m * KTOPK;
    uint32_t used = 0;
    switch (kind) {
        case 0: {   // 全单槽：S 个专家各 1（要求 S ≤ E）
            if (S > E) {
                return false;
            }
            for (uint32_t e = 0; e < S; ++e) {
                counts[e] = 1;
            }
            *desc = "全单槽（每活跃专家恰好 1 槽，无重槽）";
            break;
        }
        case 1: {   // 重量 3 / 2 + 单槽
            counts[0] = 3; counts[1] = 2; used = 5;
            for (uint32_t e = 2; used < S; ++e) { counts[e] = 1; ++used; }
            *desc = "重槽 3/2 + 单槽（含 502 级空专家）";
            break;
        }
        case 2: {   // 重量 20 / 10 / 2 / 1 + 单槽
            counts[0] = 20; counts[1] = 10; counts[2] = 2; counts[3] = 1; used = 33;
            for (uint32_t e = 4; used < S; ++e) { counts[e] = 1; ++used; }
            *desc = "重槽 20/10/2/1 + 单槽";
            break;
        }
        case 3: {   // 重量 60/30/8/4 + 二槽 + 单槽（含空专家，全部 c_e ≤ m）
            counts[0] = 60; counts[1] = 30; counts[2] = 8; counts[3] = 4; used = 102;
            for (uint32_t e = 4; e < 4 + 138; ++e) { counts[e] = 2; used += 2; }
            for (uint32_t e = 4 + 138; used < S; ++e) { counts[e] = 1; ++used; }
            *desc = "重槽 60/30/8/4 + 二槽 138 + 单槽（含 108 级空专家）";
            break;
        }
        default:
            return false;
    }
    uint32_t sum = 0;
    for (uint32_t e = 0; e < E; ++e) {
        if (counts[e] > static_cast<int32_t>(m)) {
            return false;   // c_e > m 会让同一 token 的"发牌"撞到同一专家两次
        }
        sum += static_cast<uint32_t>(counts[e]);
    }
    return sum == S;
}

// 受控输入生成：先按 profile 铺 expert-major 的槽位表，再以 "发牌"（token t 取位置
// t, t+m, ..., t+9m）把槽位分给 token —— 每个 token 恰好 10 槽、总数与 profile 严格相等，
// 且不可能违反（构造性保证，无贪心失败风险）。
static void GenSyntheticOneHot(uint32_t kind, uint32_t m, uint16_t* x,
                               std::vector<int32_t>& profile, const char** desc)
{
    const uint32_t S = m * KTOPK;
    (void)BuildProfile(kind, m, profile, desc);
    std::vector<int32_t> slotExpert(S);
    {
        uint32_t s = 0;
        for (uint32_t e = 0; e < E; ++e) {
            for (int32_t j = 0; j < profile[e]; ++j) {
                slotExpert[s++] = static_cast<int32_t>(e);
            }
        }
    }
    for (size_t i = 0; i < static_cast<size_t>(m) * HIDDEN; ++i) {
        x[i] = F32ToBf16(0.0f);
    }
    for (uint32_t t = 0; t < m; ++t) {
        for (uint32_t r = 0; r < KTOPK; ++r) {
            const int32_t e = slotExpert[t + r * m];
            x[static_cast<size_t>(t) * HIDDEN + e] = F32ToBf16(12.0f - 0.5f * static_cast<float>(r));
        }
    }
}

static void GenOneHotWeight(uint16_t* w)
{
    for (uint32_t e = 0; e < E; ++e) {
        for (uint32_t k = 0; k < HIDDEN; ++k) {
            w[static_cast<size_t>(e) * HIDDEN + k] = F32ToBf16(k == e ? 1.0f : 0.0f);
        }
    }
}

// ---- host 浮点参考：语义同 moe_block_ref.router_topk ----
static void RefRouterTopk(const uint16_t* x, const uint16_t* w, uint32_t m,
                          float* logits, int32_t* ids, float* wgt)
{
    for (uint32_t r = 0; r < m; ++r) {
        float* lr = logits + static_cast<size_t>(r) * E;
        for (uint32_t e = 0; e < E; ++e) {
            float acc = 0.f;
            for (uint32_t k = 0; k < HIDDEN; ++k) {
                acc += Bf16ToF32(x[static_cast<size_t>(r) * HIDDEN + k]) *
                       Bf16ToF32(w[static_cast<size_t>(e) * HIDDEN + k]);
            }
            lr[e] = acc;
        }
        float mx = lr[0];
        for (uint32_t e = 1; e < E; ++e) mx = fmaxf(mx, lr[e]);
        for (uint32_t e = 0; e < E; ++e) lr[e] -= mx;   // 与 moe_block_ref 返回一致（max-shift）
        float sc[E];
        for (uint32_t e = 0; e < E; ++e) {
            // 设备口径建模：softmax 分数落在 fp32 次正规区（< 2^-126）时硬件 FTZ flush 成 0
            // （docs/05 §6.1「fp32 次正规 FTZ 是硬件模式，不在规避范围」）。不建模这一条，
            // 参考会保留 1e-38..1e-45 的次正规值并据此排序，而设备把它们全看成 0 后按
            // 同值次序取小 id —— m=4097 真实权重档实测 20/4097 行 top-10 集合因此不同。
            const float v = expf(lr[e]);
            sc[e] = (v < 1.1754944e-38f) ? 0.0f : v;
        }
        bool used[E] = {};
        float ws[KTOPK];
        for (uint32_t t = 0; t < KTOPK; ++t) {   // 稳定选择：严格大于 -> 并列取小 id
            int bi = -1;
            for (uint32_t e = 0; e < E; ++e) {
                if (used[e]) continue;
                if (bi < 0 || sc[e] > sc[static_cast<uint32_t>(bi)]) bi = static_cast<int>(e);
            }
            used[bi] = true;
            ids[static_cast<size_t>(r) * KTOPK + t] = bi;
            ws[t] = sc[bi];
        }
        float wsum = 0.f;
        for (uint32_t t = 0; t < KTOPK; ++t) wsum += ws[t];
        for (uint32_t t = 0; t < KTOPK; ++t)
            wgt[static_cast<size_t>(r) * KTOPK + t] = ws[t] / wsum;
    }
}

// ---- host 参考：计数排序（= moe_block_ref.moe_permute 的 stable 语义）----
static void RefCountsPerm(const int32_t* ids, uint32_t m, int32_t* counts, int32_t* base,
                          int32_t* permSrc, int32_t* permExp)
{
    const uint32_t S = m * KTOPK;
    for (uint32_t e = 0; e < E; ++e) counts[e] = 0;
    for (uint32_t s = 0; s < S; ++s) counts[ids[s]] += 1;
    int32_t off = 0;
    for (uint32_t e = 0; e < E; ++e) { base[e] = off; off += counts[e]; }
    std::vector<int32_t> cur(base, base + E);
    for (uint32_t t = 0; t < m; ++t) {
        for (uint32_t k = 0; k < KTOPK; ++k) {
            const int32_t e = ids[static_cast<size_t>(t) * KTOPK + k];
            const int32_t pos = cur[e]++;
            permSrc[pos] = static_cast<int32_t>(t);
            permExp[pos] = e;
        }
    }
}

static int Bf16UlpDiff(uint16_t a, uint16_t b)
{
    const int d = static_cast<int>(a) - static_cast<int>(b);
    return d >= 0 ? d : -d;
}

static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// 逐级 mkdir(2)（不用 system("mkdir -p …")：M22_OUT 里的 shell 元字符不得被解释）
static void MakeDirs(const char* path)
{
    char buf[1024];
    snprintf(buf, sizeof(buf), "%s", path);
    for (char* p = buf + 1; *p != '\0'; ++p) {
        if (*p == '/') {
            *p = '\0';
            mkdir(buf, 0755);
            *p = '/';
        }
    }
    mkdir(buf, 0755);
}

static void WriteJson(const char* path, const char* tensor, const char* shape, const char* dtype,
                      uint32_t elemSize, size_t sizeBytes)
{
    char full[1024];
    snprintf(full, sizeof(full), "%s.json", path);
    FILE* f = fopen(full, "w");
    if (f == nullptr) return;
    fprintf(f, "{\n  \"tensor\": \"%s\",\n  \"shape\": %s,\n  \"dtype\": \"%s\",\n", tensor, shape, dtype);
    fprintf(f, "  \"elem_size\": %u,\n  \"byte_order\": \"little\",\n  \"size_bytes\": %zu\n}\n",
            elemSize, sizeBytes);
    fclose(f);
}

struct CaseCfg {
    const char* name;
    uint32_t m;
    uint32_t seed;
    uint32_t gen;       // 0 = uniform（真实权重档）；1 = 受控 one-hot 档
    uint32_t profile;   // gen==1 时：profile 种类
};

// 用例表：真实 checkpoint 权重档（含 decode m=1 / prefill m=4097）+ 受控非均匀档
static const CaseCfg kCases[] = {
    {"real_m1",    1,    7, 0, 0},
    {"real_m2",    2,    7, 0, 0},
    {"real_m16",   16,   7, 0, 0},
    {"real_m33",   33,   7, 0, 0},
    {"real_m64",   64,   7, 0, 0},
    {"real_m4097", 4097, 5, 0, 0},
    {"nu_m1",      1,    7, 1, 0},
    {"nu_m7",      7,    7, 1, 1},
    {"nu_m33",     33,   11, 1, 2},
    {"nu_m64",     64,   13, 1, 3},
};

struct DevOut {
    std::vector<uint16_t> logBits;   // bf16 位视图（每 fp32 占 2 个 uint16）
    std::vector<int32_t> ids;
    std::vector<uint16_t> wbits;
    std::vector<int32_t> counts;
    std::vector<int32_t> base;
    std::vector<int32_t> permSrc;
    std::vector<int32_t> permExp;
    std::vector<int64_t> group64;
    std::vector<int32_t> scl;
    double ms = 0.0;
};

static bool RunDevice(aclrtStream stream, const uint16_t* xHost, const uint16_t* wHost,
                      const CaseCfg& c, DevOut& o)
{
    const uint32_t m = c.m;
    const size_t xBytes = static_cast<size_t>(m) * HIDDEN * 2;
    const size_t logBytes = static_cast<size_t>(m) * E * 4;
    const size_t idsBytes = static_cast<size_t>(m) * KTOPK * 4;
    const size_t wBytes = static_cast<size_t>(m) * KTOPK * 2;

    uint16_t* xDev = nullptr;
    uint16_t* wDev = nullptr;
    uint16_t* logDev = nullptr;
    int32_t* idsDev = nullptr;
    uint16_t* wOutDev = nullptr;
    int32_t* cntDev = nullptr;
    int32_t* baseDev = nullptr;
    int32_t* psDev = nullptr;
    int32_t* peDev = nullptr;
    int32_t* g64Dev = nullptr;
    int32_t* sclDev = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&xDev), xBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&wDev), static_cast<size_t>(E) * HIDDEN * 2, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&logDev), logBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&idsDev), idsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&wOutDev), wBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&cntDev), E * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&baseDev), E * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&psDev), static_cast<size_t>(m) * KTOPK * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&peDev), static_cast<size_t>(m) * KTOPK * 4, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&g64Dev), static_cast<size_t>(E) * 8, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&sclDev), 64, ACL_MEM_MALLOC_HUGE_FIRST);

    aclrtMemcpy(xDev, xBytes, xHost, xBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(wDev, static_cast<size_t>(E) * HIDDEN * 2, wHost,
                static_cast<size_t>(E) * HIDDEN * 2, ACL_MEMCPY_HOST_TO_DEVICE);

    struct timespec t0, t1;
    clock_gettime(CLOCK_MONOTONIC, &t0);
    router512_kernel<<<1, 0, stream>>>(xDev, wDev, logDev, idsDev, wOutDev, cntDev, baseDev,
                                       psDev, peDev, g64Dev, sclDev, m);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    clock_gettime(CLOCK_MONOTONIC, &t1);
    o.ms = (t1.tv_sec - t0.tv_sec) * 1e3 + (t1.tv_nsec - t0.tv_nsec) / 1e6;
    if (launchErr != ACL_SUCCESS) {
        printf("[M22][FAIL] %s: kernel launch/sync error %d\n", c.name, static_cast<int>(launchErr));
        return false;
    }

    o.logBits.assign(logBytes / 2, 0);
    o.ids.assign(idsBytes / 4, 0);
    o.wbits.assign(wBytes / 2, 0);
    o.counts.assign(E, 0);
    o.base.assign(E, 0);
    o.permSrc.assign(static_cast<size_t>(m) * KTOPK, 0);
    o.permExp.assign(static_cast<size_t>(m) * KTOPK, 0);
    o.group64.assign(E, 0);
    o.scl.assign(16, 0);
    aclrtMemcpy(o.logBits.data(), logBytes, logDev, logBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.ids.data(), idsBytes, idsDev, idsBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.wbits.data(), wBytes, wOutDev, wBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.counts.data(), E * 4, cntDev, E * 4, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.base.data(), E * 4, baseDev, E * 4, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.permSrc.data(), static_cast<size_t>(m) * KTOPK * 4, psDev,
                static_cast<size_t>(m) * KTOPK * 4, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.permExp.data(), static_cast<size_t>(m) * KTOPK * 4, peDev,
                static_cast<size_t>(m) * KTOPK * 4, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.group64.data(), static_cast<size_t>(E) * 8, g64Dev,
                static_cast<size_t>(E) * 8, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(o.scl.data(), 64, sclDev, 64, ACL_MEMCPY_DEVICE_TO_HOST);

    aclrtFree(xDev); aclrtFree(wDev); aclrtFree(logDev); aclrtFree(idsDev); aclrtFree(wOutDev);
    aclrtFree(cntDev); aclrtFree(baseDev); aclrtFree(psDev); aclrtFree(peDev);
    aclrtFree(g64Dev); aclrtFree(sclDev);
    return true;
}

// 单用例：跑设备 + 三层自检 + 可选 dump。返回值 = 判定项是否全过。
static bool RunCase(aclrtStream stream, const uint16_t* wReal, const CaseCfg& c,
                    const char* outDir, uint32_t& judgedTotal, uint32_t& judgedPass,
                    uint32_t& guardTotal, uint32_t& guardPass)
{
    const uint32_t m = c.m;
    const size_t xBytes = static_cast<size_t>(m) * HIDDEN * 2;
    std::vector<uint16_t> xHost(static_cast<size_t>(m) * HIDDEN, 0);
    std::vector<uint16_t> wHost(static_cast<size_t>(E) * HIDDEN, 0);
    const char* pdesc = "";
    std::vector<int32_t> profile;
    if (c.gen == 0) {
        GenActivationsUniform(xHost.data(), m, c.seed);
        memcpy(wHost.data(), wReal, static_cast<size_t>(E) * HIDDEN * 2);
    } else {
        GenSyntheticOneHot(c.profile, m, xHost.data(), profile, &pdesc);
        GenOneHotWeight(wHost.data());
    }

    DevOut o;
    if (!RunDevice(stream, xHost.data(), wHost.data(), c, o)) {
        return false;
    }

    // ---- 参考 ----
    std::vector<float> refLog(static_cast<size_t>(m) * E, 0.f);
    std::vector<int32_t> refIds(static_cast<size_t>(m) * KTOPK, 0);
    std::vector<float> refW(static_cast<size_t>(m) * KTOPK, 0.f);
    RefRouterTopk(xHost.data(), wHost.data(), m, refLog.data(), refIds.data(), refW.data());
    std::vector<int32_t> refCnt(E, 0), refBase(E, 0);
    std::vector<int32_t> refPS(static_cast<size_t>(m) * KTOPK, 0), refPE(static_cast<size_t>(m) * KTOPK, 0);
    RefCountsPerm(refIds.data(), m, refCnt.data(), refBase.data(), refPS.data(), refPE.data());

    // ---- 判定项 J1..J10 ----
    // J1 = T3（docs/17 §1.1：长 fp32 累加链）：逐元素 |dev - ref| ≤ ε·Σ|terms| + 0.5·ulp(out)。
    //   ε 的来源逐项列出：
    //     * 设备侧：GEMV 是 40 深 lane 链（40 × 2^-24）+ 64 lane 树形归约（6 层 × 2^-24）；
    //     * 参考侧：host 参考是 2560 次顺序相加（2560 × 2^-24）——参考链更长，故必须在 ε 里计。
    //   Σ|x_k·w_e,k| 用上界 Rmax[t]·Wsum[e]（≤ max_k|x_k| · Σ_k|w_ek|），避免再算一遍 5.4G 次乘加。
    const double kEps = (40.0 + 6.0 + 2560.0) * 5.9604644775390625e-08;   // 2^-24
    std::vector<double> rmax(m, 0.0), wsum(E, 0.0);
    for (uint32_t t = 0; t < m; ++t) {
        double mx = 0.0;
        for (uint32_t k = 0; k < HIDDEN; ++k) {
            const double a = fabs(static_cast<double>(Bf16ToF32(xHost[static_cast<size_t>(t) * HIDDEN + k])));
            if (a > mx) mx = a;
        }
        rmax[t] = mx;
    }
    for (uint32_t e = 0; e < E; ++e) {
        double s = 0.0;
        for (uint32_t k = 0; k < HIDDEN; ++k) {
            s += fabs(static_cast<double>(Bf16ToF32(wHost[static_cast<size_t>(e) * HIDDEN + k])));
        }
        wsum[e] = s;
    }
    const float* logDev = reinterpret_cast<const float*>(o.logBits.data());
    float maxLogAbs = 0.f;
    double t3Util = 0.0;          // 最大「界占用」（T3 的衰减量度，报告项）
    uint32_t t3Bad = 0;           // 越界元素个数（判定项）
    double t3MaxBound = 0.0;
    for (uint32_t t = 0; t < m; ++t) {
        for (uint32_t e = 0; e < E; ++e) {
            const size_t i = static_cast<size_t>(t) * E + e;
            const double d = fabs(static_cast<double>(logDev[i]) - static_cast<double>(refLog[i]));
            if (d > maxLogAbs) maxLogAbs = static_cast<float>(d);
            int ex = 0;
            frexp(fabs(static_cast<double>(refLog[i])), &ex);
            const double bound = kEps * rmax[t] * wsum[e] + 0.5 * ldexp(1.0, ex - 24);
            if (bound > 0.0) {
                const double u = d / bound;
                if (u > t3Util) t3Util = u;
            }
            if (bound > t3MaxBound) t3MaxBound = bound;
            if (d > bound) ++t3Bad;
        }
    }
    const bool j1 = (t3Bad == 0);

    uint32_t idBad = 0;
    for (size_t i = 0; i < o.ids.size(); ++i) {
        if (o.ids[i] != refIds[i]) ++idBad;
    }
    const bool j2 = (idBad == 0);

    int maxUlp = 0;
    uint32_t wBad = 0;
    for (size_t i = 0; i < o.wbits.size(); ++i) {
        const uint16_t want = F32ToBf16(refW[i]);
        const int ulp = Bf16UlpDiff(o.wbits[i], want);
        if (ulp > maxUlp) maxUlp = ulp;
        if (ulp > 1) ++wBad;
    }
    const bool j3 = (wBad == 0);

    const bool j4 = std::equal(o.counts.begin(), o.counts.end(), refCnt.begin());
    const bool j5 = std::equal(o.base.begin(), o.base.end(), refBase.begin());
    const bool j6 = std::equal(o.permSrc.begin(), o.permSrc.end(), refPS.begin());
    const bool j7 = std::equal(o.permExp.begin(), o.permExp.end(), refPE.begin());

    bool j8 = true;
    for (uint32_t e = 0; e < E; ++e) {
        if (o.group64[e] != static_cast<int64_t>(o.counts[e])) j8 = false;
    }
    uint32_t sumCnt = 0;
    for (uint32_t e = 0; e < E; ++e) sumCnt += static_cast<uint32_t>(o.counts[e]);
    const bool j9 = (o.scl[0] == static_cast<int32_t>(m * KTOPK)) &&
                    (o.scl[3] == static_cast<int32_t>(m * KTOPK));
    const bool j10 = (sumCnt == m * KTOPK);

    // ---- guard / 报告项 ----
    uint32_t nEmpty = 0, nSingle = 0, maxCnt = 0;
    for (uint32_t e = 0; e < E; ++e) {
        if (o.counts[e] == 0) ++nEmpty;
        if (o.counts[e] == 1) ++nSingle;
        if (static_cast<uint32_t>(o.counts[e]) > maxCnt) maxCnt = static_cast<uint32_t>(o.counts[e]);
    }
    // g1: 诊断槽恒 0（脏 id 计数）  g2: Σt_e 与 active_num 一致（kernel 内自报）
    const bool g1 = (o.scl[2] == 0);
    const bool g2 = (o.scl[1] > 0 && o.scl[1] <= static_cast<int32_t>(E));
    // g3: perm 覆盖性（perm_src 落在 [0,m)、perm_exp 落在 [0,512) 且与 counts 自洽）
    bool g3 = true;
    std::vector<int32_t> cntCheck(E, 0);
    for (size_t s = 0; s < o.permSrc.size(); ++s) {
        if (o.permSrc[s] < 0 || o.permSrc[s] >= static_cast<int32_t>(m)) g3 = false;
        if (o.permExp[s] < 0 || o.permExp[s] >= static_cast<int32_t>(E)) g3 = false;
        cntCheck[o.permExp[s]] += 1;
    }
    for (uint32_t e = 0; e < E; ++e) {
        if (cntCheck[e] != o.counts[e]) g3 = false;
    }
    // g4: logits 非空洞（top-10 的 max-shift 值域合理：最大 lane 恰为 0，其余 < 0）
    bool g4 = true;
    for (uint32_t r = 0; r < m; ++r) {
        float mx = -1e30f;
        for (uint32_t e = 0; e < E; ++e) mx = fmaxf(mx, logDev[static_cast<size_t>(r) * E + e]);
        if (fabsf(mx) > 1e-6f) { g4 = false; break; }
    }

    const bool judgedOk = j1 && j2 && j3 && j4 && j5 && j6 && j7 && j8 && j9 && j10;
    const bool guardOk = g1 && g2 && g3 && g4;
    judgedTotal += 10; guardTotal += 4;
    judgedPass += judgedOk ? 10 : (j1 + j2 + j3 + j4 + j5 + j6 + j7 + j8 + j9 + j10);
    guardPass += (g1 + g2 + g3 + g4);

    printf("[M22] %-11s m=%-4u %-4s | %s | J:%d%d%d%d%d%d%d%d%d%d | G:%d%d%d%d | "
           "logMaxAbs=%.2e idsBad=%u wUlp=%d nAct=%d nEmpty=%u nSingle=%u maxCnt=%u t=%.1fms\n",
           c.name, m, c.gen == 0 ? "real" : "onehot", judgedOk ? "PASS" : "FAIL",
           j1, j2, j3, j4, j5, j6, j7, j8, j9, j10, g1, g2, g3, g4,
           maxLogAbs, idBad, maxUlp, o.scl[1], nEmpty, nSingle, maxCnt, o.ms);
    printf("        T3(logits): 界占用 %.4f%%  越界元素 %u  最大元素界 %.3e  "
           "(m7 兼容绝对口径 max abs %.2e, 报告项)\n",
           t3Util * 100.0, t3Bad, t3MaxBound, maxLogAbs);
    if (c.gen == 1) {
        printf("        profile: %s\n", pdesc);
    }

    if (outDir != nullptr) {
        char p[1024];
        auto put = [&](const char* nm, const void* buf, size_t n, const char* shape,
                       const char* dt, uint32_t es) {
            snprintf(p, sizeof(p), "%s/%s", outDir, nm);
            if (!WriteBin(p, buf, n)) printf("[M22][WARN] write %s failed\n", p);
            WriteJson(p, nm, shape, dt, es, n);
        };
        char shapeBuf[128];
        if (c.gen == 0) {
            snprintf(p, sizeof(p), "%s/x.bin", outDir);
            WriteBin(p, xHost.data(), xBytes);
            snprintf(shapeBuf, sizeof(shapeBuf), "[%u, 2560]", m);
            WriteJson(p, "x.bin", shapeBuf, "bf16", 2, xBytes);
        } else if (m <= 64) {
            snprintf(p, sizeof(p), "%s/x.bin", outDir);
            WriteBin(p, xHost.data(), xBytes);
            snprintf(shapeBuf, sizeof(shapeBuf), "[%u, 2560]", m);
            WriteJson(p, "x.bin", shapeBuf, "bf16", 2, xBytes);
        }
        snprintf(shapeBuf, sizeof(shapeBuf), "[%u, 512]", m);
        put("router_logits.bin", o.logBits.data(), static_cast<size_t>(m) * E * 4, shapeBuf, "fp32", 4);
        snprintf(shapeBuf, sizeof(shapeBuf), "[%u, 10]", m);
        put("topk_ids.bin", o.ids.data(), static_cast<size_t>(m) * KTOPK * 4, shapeBuf, "int32", 4);
        put("topk_weights.bin", o.wbits.data(), static_cast<size_t>(m) * KTOPK * 2, shapeBuf, "bf16", 2);
        put("expert_counts.bin", o.counts.data(), E * 4, "[512]", "int32", 4);
        put("expert_slot_base.bin", o.base.data(), E * 4, "[512]", "int32", 4);
        snprintf(shapeBuf, sizeof(shapeBuf), "[%u]", m * KTOPK);
        put("perm_src_token.bin", o.permSrc.data(), static_cast<size_t>(m) * KTOPK * 4, shapeBuf, "int32", 4);
        put("perm_expert.bin", o.permExp.data(), static_cast<size_t>(m) * KTOPK * 4, shapeBuf, "int32", 4);
        put("group_list_i64.bin", o.group64.data(), static_cast<size_t>(E) * 8, "[512]", "int64", 8);
        put("route_scalars.bin", o.scl.data(), 16, "[4]", "int32", 4);
    }
    return judgedOk && guardOk;
}

// 确定性实测：同用例连跑两遍，逐字节比较
static bool CheckDeterminism(aclrtStream stream, const uint16_t* wReal, const CaseCfg& c)
{
    std::vector<uint16_t> xHost(static_cast<size_t>(c.m) * HIDDEN, 0);
    std::vector<uint16_t> wHost(static_cast<size_t>(E) * HIDDEN, 0);
    const char* pdesc = "";
    std::vector<int32_t> profile;
    if (c.gen == 0) {
        GenActivationsUniform(xHost.data(), c.m, c.seed);
        memcpy(wHost.data(), wReal, static_cast<size_t>(E) * HIDDEN * 2);
    } else {
        GenSyntheticOneHot(c.profile, c.m, xHost.data(), profile, &pdesc);
        GenOneHotWeight(wHost.data());
    }
    DevOut a, b;
    if (!RunDevice(stream, xHost.data(), wHost.data(), c, a)) return false;
    if (!RunDevice(stream, xHost.data(), wHost.data(), c, b)) return false;
    const bool same = (a.logBits == b.logBits) && (a.ids == b.ids) && (a.wbits == b.wbits) &&
                      (a.counts == b.counts) && (a.base == b.base) && (a.permSrc == b.permSrc) &&
                      (a.permExp == b.permExp) && (a.group64 == b.group64) && (a.scl == b.scl);
    printf("[M22] determinism %-11s : %s\n", c.name, same ? "PASS" : "FAIL");
    return same;
}

static bool LoadRouterWeight(const char* path, uint16_t* w)
{
    FILE* f = fopen(path, "rb");
    if (f == nullptr) return false;
    const size_t n = fread(w, 1, static_cast<size_t>(E) * HIDDEN * 2, f);
    fclose(f);
    return n == static_cast<size_t>(E) * HIDDEN * 2;
}

int32_t main(int32_t argc, char* argv[])
{
    (void)argc; (void)argv;
    const char* wPath = getenv("M22_ROUTER_W");
    if (wPath == nullptr) wPath = "m22_router512/data/router_weight.bin";
    const char* outDir = getenv("M22_OUT");

    static uint16_t wHost[E * HIDDEN];
    if (!LoadRouterWeight(wPath, wHost)) {
        printf("[M22][FAIL] cannot load router weight %s\n", wPath);
        return 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    printf("[M22] merge mode = %d (%s)\n", MERGE_MODE,
           MERGE_MODE == 4 ? "4-way, 2 levels" : "2-way, 4 levels (m7)");

    uint32_t judgedTotal = 0, judgedPass = 0, guardTotal = 0, guardPass = 0;
    bool allOk = true;
    for (const CaseCfg& c : kCases) {
        const char* od = nullptr;
        char dir[1024];
        if (outDir != nullptr) {
            snprintf(dir, sizeof(dir), "%s/%s", outDir, c.name);
            MakeDirs(dir);          // 不拼 shell：M22_OUT 里的元字符不得被解释
            od = dir;
        }
        allOk &= RunCase(stream, wHost, c, od, judgedTotal, judgedPass, guardTotal, guardPass);
    }

    // 非空洞性：确定性 + 输入敏感性
    const bool gDet = CheckDeterminism(stream, wHost, kCases[3]);      // real_m33
    const bool gDet2 = CheckDeterminism(stream, wHost, kCases[8]);     // nu_m33
    CaseCfg s8 = kCases[3];
    s8.seed = 8;
    std::vector<uint16_t> xa(static_cast<size_t>(s8.m) * HIDDEN, 0);
    std::vector<uint16_t> xb(static_cast<size_t>(s8.m) * HIDDEN, 0);
    GenActivationsUniform(xa.data(), s8.m, 7);
    GenActivationsUniform(xb.data(), s8.m, 8);
    DevOut oa, ob;
    bool sensOk = RunDevice(stream, xa.data(), wHost, kCases[3], oa) &&
                  RunDevice(stream, xb.data(), wHost, s8, ob) && (oa.ids != ob.ids);
    printf("[M22] input-sensitivity (seed 7 vs 8, m=33) ids differ : %s\n", sensOk ? "PASS" : "FAIL");

    printf("[M22] ===== judged %u/%u + 4*%u case-guard, extra guards det=%d/%d sens=%d | %s =====\n",
           judgedPass, judgedTotal, guardTotal / (guardTotal ? 1 : 1), gDet ? 1 : 0, gDet2 ? 1 : 0,
           sensOk ? 1 : 0, (allOk && gDet && gDet2 && sensOk) ? "ALL PASS" : "FAILURES PRESENT");
    printf("[M22] guards (report-only): per-case g1..g4 passed %u/%u; determinism(+2) sensitivity(+1)\n",
           guardPass, guardTotal);

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (allOk && gDet && gDet2 && sensOk) ? 0 : 1;
}
