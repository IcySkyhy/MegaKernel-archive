/**
 * m20_hyperconn.asc —— Mega kernel M36：hyper-connection 融合 kernel（decode 档 m=1，bf16）
 *
 * 规格来源（官方 vLLM 是唯一权威）：
 *   common/hyperconnection.py  —— GatedResidual.mix / .combine 的精确数学
 *   nvidia/ops/hc.py           —— 实际运行时 triton 核（逐句对照见 README §1）
 *   nvidia/model.py            —— 层序：attn_hc.combine_and_mix → attn → mlp_hc.combine_and_mix → mlp
 *   checkpoint                 —— 张量形状实测（README §1.2）
 *
 * 一个 kernel 完成一次 hc 边界（vLLM 侧一个模块级算子）的三档语义（runtime mode）：
 *   MODE_MIX         = 0  第 0 层 attn 的 mix（无 pending combine）
 *   MODE_COMBINE_MIX = 1  层内 attn/mlp（use_combine=true：产出 injection logits）
 *   MODE_FINAL_MIX   = 2  全局 hyper_connection_mixer（use_combine=false：不产出 injection）
 *
 * 段序（单次 __mix__(1,2) 内；AIC:AIV = 1:2 编译期定死）：
 *   W0 [AIV]    IW：injW[m,4] = 2·sigmoid(IJ[m,4]/HC)                     （仅 mode 1/2）
 *   S1 [AIV]    combine：H'[m,d] = bf16( f32(H[m,d]) + f32(BO[m,j])·injW[m,s] )
 *                        d = s·HID+j；4 路残差流进 → 出                     （仅 mode 1/2）
 *   S2 [AIV]    grouped GemmaRMSNorm：per (token,stream) 组（HID=2560）
 *               rstd = 1/sqrt(mean(H'²)+eps)；XN = bf16((H'·rstd) + (H'·rstd)·γ)
 *   S3 [AIC]    down+inject GEMM：OH[m,324] = XN[m,10240]·[Wdown;Winj]^T   （3 N-tile）
 *   S4 [AIV]    silu：LS[m,r] = bf16( u·sigmoid(u) )，u = f32(lora_r)/HC
 *   S5 [AIC]    up GEMM：GATE[m,10240] = LS[m,320]·Wup[10240,320]^T        （64 N-tile）
 *   S6 [AIV]    gate mix：BLK[m,j] = bf16( (1/HC)·Σ_s sigmoid(g_s)·xn_s )
 *
 * 数据通路（全程基础 API，无高阶 API / TPipe / TBuf / TQue / AllocTensor）：
 *   AIV: GM --DataCopy(MTE2)--> UB --Reg::LoadAlign/Cast + 向量指令--> 寄存器 --StoreAlign--> UB --DataCopy(MTE3)--> GM
 *   AIC: GM --DataCopy(Nd2Nz, MTE2)--> L1 --LoadData(LoadData2DParamsV2, MTE1)--> L0A/L0B
 *        --Mmad(M)--> L0C(fp32) --Fixpipe(FIXP, F322BF16)--> GM
 *
 * 同步（docs/05 §6 全部硬约束）：
 *   - 核内：BufferID（GetBufInternal/RlsBufInternal，阻塞释放 mode=false = CANN 默认 ASC_LOCK_BLOCK）；同 pipe 复用同一 buffer
 *     的段循环入口补 PipeBarrier<PIPE_MTE2>（§6.2 第 1 条）。
 *   - 核间：一律 CrossCore。段间交接用标准 mix 序列（AIV 全体 barrier mode0 → set mode2 →
 *     对侧 wait mode2）；GEMM 后 AIC 先 mode0 barrier（set 挂 PIPE_FIX 排空 FIXP 写 GM）再 set mode2。
 *   - **pipe 类必须与核型匹配**：AIV 侧只用 S/V/MTE2/MTE3；AIC 侧只用 S/MTE1/MTE2/FIX/M。
 *     本工程 grep 自查见 README §3。
 *   - 「wait 后紧接 set」的同步点 wait 挂 PIPE_S（M10 例外）；纯数据等待挂最窄 pipe。
 *   - flagId 0-15 一次性分配、不复用，相邻同步点必不同（m20_resources.h §3）。
 *
 * 算件来源（全部「复制改造」，donor 目录未改动）：
 *   AIV 向量/norm 段  m6_rmsnorm.asc（NormDonor：RegBase LoadAlign/Cast/Reduce + NR rsqrt 逐字 lift）
 *   AIV sigmoid 段    m5_swiglu_quant / m12_rmsnorm_gated（Muls(-1)/Exp/Adds(+1)/Div 排布）
 *   AIC GEMM 段       m11_bf16_gemm.asc → HcBf16Gemm（Nd2Nz → LoadData2D → Mmad → Fixpipe F322BF16）
 *   段序/同步组织     m14_gdn_layer.asc（BarrierAiv/BarrierAic + 标准 mix 序列）
 *
 * 已披露的偏离与限制（详见 README §6）：
 *   1. WInj 按 16 行读取（checkpoint 只有 [4,10240]）：host 侧必须保证 wInj ≥16 行可读，
 *      行 4..15 取值不参与有效输出（建议置 0）——与 m11「m=1 提升为 2 行、多读的行由 host 保证可读」同款契约。
 *   2. m ≤ 64（BASE_M 单 tile）；m > 64（prefill）需加 M-tile 外层循环，接口已留（见 README §9.3 prefill 扩展）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdio>
#include <cstdint>
#include <cstring>
#include <cstdlib>
#include <cmath>
#include <vector>
#include <string>
#include <utility>

#include "m20_resources.h"

namespace {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M20;

// ============================================================
// 通用：BufferID 封装 / 显式块拷贝参数 / CrossCore barrier 封装
// ============================================================

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);   // acquire 立即获取
}

template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);    // 阻塞释放（mode=false = CANN ASC_LOCK_BLOCK 默认；跨 pipe 交接）
}

template <pipe_t pipe>
__aicore__ inline void MutexLock(AscendC::MutexID id)
{
    AscendC::Mutex::Lock<pipe>(id);
}

template <pipe_t pipe>
__aicore__ inline void MutexUnlock(AscendC::MutexID id)
{
    AscendC::Mutex::Unlock<pipe>(id);
}

// 显式块拷贝参数（杜绝元素计数重载：其 DataCopyParams 只填 blockLen，其余字段未初始化）。
// DataCopyParams.blockLen 单位 = 32B 块，故入参统一为字节数、内部 /32 换算。
__aicore__ inline AscendC::DataCopyParams Block1(uint32_t bytes)
{
    if ((bytes & 31u) != 0u) {
        AscendC::Trap();   // 非 32B 整数倍必须走 DataCopyPad
    }
    return AscendC::DataCopyParams{1, static_cast<uint16_t>(bytes / 32), 0, 0};
}

__aicore__ inline AscendC::DataCopyExtParams ExtBlock1(uint32_t bytes)
{
    return AscendC::DataCopyExtParams{1, bytes, 0, 0, 0};
}

// AIV 段内 mode-0 barrier：全体 AIV 到齐（set 挂生产 pipe MTE3：MTE3 写 GM 排空）
template <pipe_t WAIT_PIPE, uint16_t FLAG>
__aicore__ inline void BarrierAiv()
{
    AscendC::CrossCoreSetFlag<CC_MODE0, PIPE_MTE3>(FLAG);
    AscendC::CrossCoreWaitFlag<CC_MODE0, WAIT_PIPE>(FLAG);
}

// AIC 段内 mode-0 barrier：全体 AIC 到齐；SET_PIPE 取 PIPE_FIX 时表示 FIXP 写 GM 已排空
template <pipe_t WAIT_PIPE, pipe_t SET_PIPE, uint16_t FLAG>
__aicore__ inline void BarrierAic()
{
    AscendC::CrossCoreSetFlag<CC_MODE0, SET_PIPE>(FLAG);
    AscendC::CrossCoreWaitFlag<CC_MODE0, WAIT_PIPE>(FLAG);
}

__aicore__ __inline__ constexpr uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ __inline__ constexpr uint32_t AlignUp(uint32_t a, uint32_t b) { return CeilDiv(a, b) * b; }
__aicore__ __inline__ constexpr uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

// ============================================================
// NormDonor（m6_rmsnorm.asc 逐字 lift；被禁的仅 TPipe/TQue wrapper）
// ============================================================
namespace NormDonor {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t V_LENGTH = VL_F32;

constexpr AscendC::Reg::CastTrait castTraitB162B32 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::UNKNOWN,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::UNKNOWN};
constexpr AscendC::Reg::CastTrait castTraitB322B16 = {AscendC::Reg::RegLayout::ZERO,
                                                      AscendC::Reg::SatMode::NO_SAT,
                                                      AscendC::Reg::MaskMergeMode::ZEROING,
                                                      AscendC::RoundMode::CAST_RINT};

template <typename T, LoadDist FLOAT_LOAD_DIST = LoadDist::DIST_NORM,
          LoadDist NON_FLOAT_LOAD_DIST = LoadDist::DIST_UNPACK_B16>
__aicore__ inline void LoadRegForDtype(__ubuf__ T* src, RegTensor<float>& dst, MaskReg& preg, uint32_t offset)
{
    if constexpr (IsSameType<T, float>::value) {
        LoadAlign<T, FLOAT_LOAD_DIST>(dst, src + offset);
    } else {
        RegTensor<T> srcReg;
        LoadAlign<T, NON_FLOAT_LOAD_DIST>(srcReg, src + offset);
        Cast<float, T, castTraitB162B32>(dst, srcReg, preg);
    }
}

// NR rsqrt（reduce_common_regbase_part1.h，m6 逐字 lift，Mula→Mul+Add）
__aicore__ inline void ComputeRstdNewtonRaphsonReg(RegTensor<float>& var, RegTensor<float>& rstd, MaskReg& preg,
                                                   float epsilon)
{
    static constexpr float POS_INF = 3.40282366920938E+38;
    static constexpr float SCALAR1 = -0.5;
    static constexpr float SCALAR2 = 1.5;
    static constexpr float SCALAR3 = 0.5;
    static constexpr float SCALAR0 = -99.99;

    RegTensor<float> r;
    RegTensor<float> y;
    RegTensor<float> s;
    RegTensor<float> t;
    RegTensor<float> one;
    RegTensor<float> scalar1;
    RegTensor<float> t1;
    RegTensor<float> t3;
    RegTensor<float> t4;
    RegTensor<float> scalarInf;
    RegTensor<float> scalarZero;
    RegTensor<float> tmp;
    MaskReg cmpRegZero;
    MaskReg cmpRegInf;

    Duplicate(scalarInf, POS_INF, preg);
    Duplicate(scalarZero, float(0.0), preg);
    Duplicate(one, float(1.0), preg);
    Duplicate(scalar1, SCALAR3, preg);
    Duplicate(t1, SCALAR2, preg);
    Duplicate(s, float(1.0), preg);

    Adds(var, var, epsilon, preg);
    Maxs(var, var, SCALAR0, preg);
    Div(r, one, var, preg);
    Sqrt(y, r, preg);
    Muls(t, var, SCALAR1, preg);
    Mul(t, t, y, preg);
    Mul(tmp, t, y, preg);
    Add(t1, t1, tmp, preg);   // t1 = 1.5 + t*y
    Mul(rstd, y, t1, preg);
    Muls(t3, var, float(-1.0), preg);
    Mul(tmp, t3, r, preg);
    Add(s, s, tmp, preg);     // s = 1 + (-var)*r
    Muls(t4, rstd, float(-1.0), preg);
    Mul(tmp, t4, rstd, preg);
    Add(r, r, tmp, preg);     // r = r + (-rstd)*rstd
    Mul(tmp, var, r, preg);
    Add(s, s, tmp, preg);     // s = s + var*r
    Mul(s, s, rstd, preg);
    Mul(tmp, s, scalar1, preg);
    Add(rstd, rstd, tmp, preg);   // rstd = rstd + s*0.5
    Compares(cmpRegZero, var, POS_INF, preg);
    Select(rstd, scalarZero, rstd, cmpRegZero);
    Compares(cmpRegInf, var, float(0.0), preg);
    Select(rstd, scalarInf, rstd, cmpRegInf);
}

// sigmoid(x) = 1/(1+exp(-x))（m5/m12 实证排布，fp32）
__aicore__ inline void SigmoidReg(RegTensor<float>& dst, RegTensor<float>& src, RegTensor<float>& one,
                                  MaskReg& preg)
{
    Muls(dst, src, -1.0f, preg);
    Exp(dst, dst, preg);
    Adds(dst, dst, 1.0f, preg);
    Div(dst, one, dst, preg);
}

}  // namespace NormDonor

// ============================================================
// AIC：bf16 GEMM（m11 Bf16Gemm → 层内核 RunTile 版）
//   C[m, NSTRIDE] = A[m, K] · B[N, K]^T
//   B_DUAL=true 时 B 有两个来源（down | inject）：n-tile 落在 LOWRANK 内取 b0，否则取 b1
// ============================================================
template <uint32_t K, uint32_t NSTRIDE, bool B_DUAL>
class HcBf16Gemm {
    static_assert(K % BASE_K == 0, "K must be divisible by BASE_K");

public:
    __aicore__ inline HcBf16Gemm() {}

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b0, __gm__ uint8_t* b1, __gm__ uint8_t* c,
                                uint32_t m)
    {
        aGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(a));
        b0Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(b0));
        if constexpr (B_DUAL) {
            b1Gm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(b1));
        }
        cGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(c));
        mTotal = m;
    }

    // 层内核：mLoop 必须为 1（m ≤ BASE_M = 64），一个 n-tile 由调用者（按 bid 条带）给定
    __aicore__ inline void RunTile(uint32_t nt, uint32_t nSize)
    {
        const uint32_t kLoop = K / BASE_K;
        const uint32_t curM = MinU32(mTotal, BASE_M);
        // 3510 实测（m1 契约）：Nd2Nz 行数为 1 时退化为 1D 拷贝、m=1 数据错位。
        // 计算侧统一提升为 ≥2 行（多读的行由 host 保证可读），仅在 Fixpipe 用 curM mask。
        const uint32_t calcM = curM < 2 ? 2 : curM;
        const uint32_t calcMAlign = AlignUp(calcM, CUBE_BLOCK);

        AscendC::LocalTensor<bfloat16_t> a1Ping(TPosition::A1, L1_OFF_A0, L1_A_ELEMS);
        AscendC::LocalTensor<bfloat16_t> a1Pong(TPosition::A1, L1_OFF_A1, L1_A_ELEMS);
        AscendC::LocalTensor<bfloat16_t> b1Ping(TPosition::B1, L1_OFF_B0, L1_B_ELEMS);
        AscendC::LocalTensor<bfloat16_t> b1Pong(TPosition::B1, L1_OFF_B1, L1_B_ELEMS);

        AscendC::LocalTensor<bfloat16_t> a2Ping(TPosition::A2, L0_OFF_0, BASE_M * BASE_K);
        AscendC::LocalTensor<bfloat16_t> a2Pong(TPosition::A2, L0_OFF_1, BASE_M * BASE_K);
        AscendC::LocalTensor<bfloat16_t> b2Ping(TPosition::B2, L0_OFF_0, BASE_K * BASE_N);
        AscendC::LocalTensor<bfloat16_t> b2Pong(TPosition::B2, L0_OFF_1, BASE_K * BASE_N);

        AscendC::LocalTensor<float> cL0C(TPosition::CO1, 0, BASE_M * BASE_N);

        MutexLock<PIPE_M>(BUF_AIC_L0C);   // M 先取 L0C 所有权：挡住上一 tile 的 Fixpipe 读
        for (uint32_t kBlock = 0; kBlock < kLoop; ++kBlock) {
            const uint32_t p = kBlock & 1;
            const AscendC::MutexID bufA = p ? BUF_AIC_A1 : BUF_AIC_A0;
            const AscendC::MutexID bufB = p ? BUF_AIC_B1 : BUF_AIC_B0;
            const AscendC::MutexID bufL0 = p ? BUF_AIC_L01 : BUF_AIC_L00;
            AscendC::LocalTensor<bfloat16_t> a1 = p ? a1Pong : a1Ping;
            AscendC::LocalTensor<bfloat16_t> b1 = p ? b1Pong : b1Ping;
            AscendC::LocalTensor<bfloat16_t> a2 = p ? a2Pong : a2Ping;
            AscendC::LocalTensor<bfloat16_t> b2 = p ? b2Pong : b2Ping;

            // ---- MTE2：GM -> L1（Nd2Nz），大包生产 ----
            MutexLock<PIPE_MTE2>(bufA);
            CopyInA(a1, kBlock, calcM);
            MutexUnlock<PIPE_MTE2>(bufA);
            MutexLock<PIPE_MTE2>(bufB);
            CopyInB(b1, kBlock, nt);
            MutexUnlock<PIPE_MTE2>(bufB);

            // ---- MTE1：L1 -> L0（LoadData），消费 L1、生产 L0 ----
            MutexLock<PIPE_MTE1>(bufL0);
            MutexLock<PIPE_MTE1>(bufA);
            MutexLock<PIPE_MTE1>(bufB);
            LoadA(a1, a2, calcMAlign);
            LoadB(b1, b2);
            MutexUnlock<PIPE_MTE1>(bufA);
            MutexUnlock<PIPE_MTE1>(bufB);
            MutexUnlock<PIPE_MTE1>(bufL0);

            // ---- M：Mmad 累加（L0C fp32），消费 L0 ----
            MutexLock<PIPE_M>(bufL0);
            AscendC::MmadParams mp = {};
            mp.m = calcM;
            mp.n = BASE_N;
            mp.k = BASE_K;
            mp.cmatrixInitVal = (kBlock == 0);
            AscendC::Mmad(cL0C, a2, b2, mp);
            MutexUnlock<PIPE_M>(bufL0);
        }
        MutexUnlock<PIPE_M>(BUF_AIC_L0C);
        MutexLock<PIPE_FIX>(BUF_AIC_L0C);
        CopyOut(cL0C, nt, nSize, curM, calcMAlign);
        MutexUnlock<PIPE_FIX>(BUF_AIC_L0C);
    }

private:
    __aicore__ inline void CopyInA(AscendC::LocalTensor<bfloat16_t>& a1, uint32_t kBlock, uint32_t curM)
    {
        AscendC::Nd2NzParams par = {};
        par.ndNum = 1;
        par.nValue = curM;             // 行数（调用侧传 calcM≥2）
        par.dValue = BASE_K;           // 每行元素数（bf16 按元素计）
        par.srcNdMatrixStride = 0;
        par.srcDValue = K;
        par.dstNzC0Stride = BASE_M;    // L1 NZ 布局按满 tile 行距（与 LoadA 的 srcStride 配套）
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, aGm[kBlock * BASE_K], par);
    }

    __aicore__ inline void CopyInB(AscendC::LocalTensor<bfloat16_t>& b1, uint32_t kBlock, uint32_t nt)
    {
        AscendC::Nd2NzParams par = {};
        par.ndNum = 1;
        par.dValue = BASE_K;
        par.srcNdMatrixStride = 0;
        par.srcDValue = K;
        par.dstNzC0Stride = BASE_N;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        // nt 落在 [0, LOWRANK/BASE_N) 内 → Wdown 的满 BASE_N 行；否则 → Winj 的 INJ_N 行
        if constexpr (B_DUAL) {
            if ((nt + 1) * BASE_N <= LOWRANK) {
                par.nValue = BASE_N;
                AscendC::DataCopy(b1, b0Gm[kBlock * BASE_K + nt * BASE_N * K], par);
            } else {
                // 读 16 行（checkpoint 只有 INJ_N=4 行，host 契约保证 ≥16 行可读且行 [4,16) 为 0）：
                // L0C 的列 [4,16) 由 0·x 精确得 0 → OH 的 padding 列 [324,336) 恒为 0，
                // 输出字节确定性成立。若只读 4 行，列 4..15 会取自 L1 残留（有限但随调度变化），
                // 输出虽不影响有效列却破坏重复运行的逐字节一致性。
                par.nValue = 16;
                AscendC::DataCopy(b1, b1Gm[kBlock * BASE_K], par);
            }
        } else {
            par.nValue = BASE_N;
            AscendC::DataCopy(b1, b0Gm[kBlock * BASE_K + nt * BASE_N * K], par);
        }
    }

    __aicore__ inline void LoadA(AscendC::LocalTensor<bfloat16_t>& a1, AscendC::LocalTensor<bfloat16_t>& a2,
                                 uint32_t calcMAlign)
    {
        AscendC::LoadData2DParamsV2 lp = {};
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = calcMAlign / CUBE_BLOCK;
        lp.kStep = BASE_K / CUBE_BLOCK;
        lp.srcStride = BASE_M / CUBE_BLOCK;
        lp.dstStride = calcMAlign / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData(a2, a1[0], lp);
    }

    __aicore__ inline void LoadB(AscendC::LocalTensor<bfloat16_t>& b1, AscendC::LocalTensor<bfloat16_t>& b2)
    {
        AscendC::LoadData2DParamsV2 lp = {};
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = BASE_N / CUBE_BLOCK;
        lp.kStep = BASE_K / CUBE_BLOCK;
        lp.srcStride = BASE_N / CUBE_BLOCK;
        lp.dstStride = BASE_N / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData(b2, b1[0], lp);
    }

    __aicore__ inline void CopyOut(AscendC::LocalTensor<float>& cL0C, uint32_t nt, uint32_t nSize, uint32_t curM,
                                   uint32_t calcMAlign)
    {
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp = {};
        // 该结构体仅 reluScalar/vectorRelu/deqScalar 三个成员无 NSDMI，均显式清零
        fp.nSize = nSize;
        fp.mSize = curM;
        fp.srcStride = calcMAlign;
        fp.dstStride = NSTRIDE;
        fp.quantPre = QuantMode_t::F322BF16;
        fp.reluScalar = 0;
        fp.vectorRelu = 0;
        fp.deqScalar = 0;
        AscendC::Fixpipe(cGm[nt * BASE_N], cL0C, fp);
    }

private:
    AscendC::GlobalTensor<bfloat16_t> aGm;
    AscendC::GlobalTensor<bfloat16_t> b0Gm;
    AscendC::GlobalTensor<bfloat16_t> b1Gm;
    AscendC::GlobalTensor<bfloat16_t> cGm;
    uint32_t mTotal;
};

}  // namespace

// ============================================================
// M36 段序实现（单一 __mix__(1,2)）
// ============================================================

namespace {

struct HcPtrs {
    __gm__ uint8_t* hIn;     // 4 路残差流输入 H [M_MAX, HYPER] bf16
    __gm__ uint8_t* bo;      // pending block output [M_MAX, HID] bf16（mode 1/2 用）
    __gm__ uint8_t* ij;      // pending injection logits [M_MAX, IJ_STRIDE] bf16（mode 1/2 用）
    __gm__ uint8_t* wDown;   // input_mix_weight_down [LOWRANK, HYPER] bf16（checkpoint 原样）
    __gm__ uint8_t* wInj;    // block_inject_weight [>=16, HYPER] bf16（checkpoint 为 [INJ_N,HYPER]）
    __gm__ uint8_t* wUp;     // input_mix_weight_up [UP_N, UP_K] bf16（checkpoint 原样）
    __gm__ uint8_t* hcNorm;  // hc_norm [HYPER] bf16（per-branch mixed affine）
    __gm__ uint8_t* ws;      // GM workspace（偏移见 m20_resources.h §4）
    uint32_t m;              // token 数（1..M_MAX）
    uint32_t mode;           // MODE_MIX / MODE_COMBINE_MIX / MODE_FINAL_MIX
    uint32_t stageLimit;     // 段序截断（bring-up 定位；7 = 全开）
};

class HyperConnOp {
public:
    __aicore__ inline HyperConnOp() {}

    __aicore__ inline void Init(const HcPtrs& a)
    {
        p = a;
        ws = a.ws;
        hInGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(a.hIn));
        boGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(a.bo));
        ijGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(a.ij));
        hcNormGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(a.hcNorm));
        hcpGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws + WS_HCP));
        xnGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws + WS_XN));
        rstdGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws + WS_RSTD));
        injwGm.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(ws + WS_INJW));
        ohGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws + WS_OH));
        lsGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws + WS_LS));
        gateGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws + WS_GATE));
        blkGm.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ws + WS_BLK));
        down.Init(ws + WS_XN, a.wDown, a.wInj, ws + WS_OH, a.m);
        up.Init(ws + WS_LS, a.wUp, nullptr, ws + WS_GATE, a.m);
    }

    // ------------------------------------------------------------
    // AIV：段序
    // ------------------------------------------------------------
    __aicore__ inline void ProcessAiv()
    {
        const uint32_t bid = AscendC::GetBlockIdx();       // 0 .. 2*numBlocks-1
        const uint32_t nAiv = AscendC::GetBlockNum() * 2;  // mix(1,2)：AIV 线程数 = 2×AIC 数
        const bool useCombine = (p.mode != MODE_MIX);

        if (p.stageLimit >= 1 && useCombine) {
            InjwStage(bid, nAiv);
        }
        if (p.stageLimit >= 2) {
            if (useCombine) {
                CombineStage(bid, nAiv);
            }
            // 段内 barrier：全体 AIV 到齐后 H' 才全量可见（S2 的组可能跨 AIV 的 S1 产出）
            BarrierAiv<PIPE_MTE2, FLAG_AV0>();
        }
        if (p.stageLimit >= 3) {
            if (useCombine) {
                NormStage(bid, nAiv, hcpGm);
            } else {
                NormStage(bid, nAiv, hInGm);
            }
            BarrierAiv<PIPE_MTE2, FLAG_AV1>();   // XN 全量落盘
        }
        if (p.stageLimit >= 4) {
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE3>(FLAG_A2C_XN);
            CrossCoreWaitFlag<CC_MODE2, PIPE_MTE2>(FLAG_C2A_OH);
        }
        if (p.stageLimit >= 5) {
            SiluStage(bid, nAiv);
            BarrierAiv<PIPE_MTE2, FLAG_AV2>();   // LS 全量落盘
        }
        if (p.stageLimit >= 6) {
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE3>(FLAG_A2C_LS);
            CrossCoreWaitFlag<CC_MODE2, PIPE_MTE2>(FLAG_C2A_GATE);
        }
        if (p.stageLimit >= 7) {
            GateMixStage(bid, nAiv);
        }
    }

    // ------------------------------------------------------------
    // AIC：两段 GEMM（N-tile 按 bid 条带；每个 AIC 只跑自己的 tile）
    // ------------------------------------------------------------
    __aicore__ inline void ProcessAic()
    {
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t nAic = AscendC::GetBlockNum();

        if (p.stageLimit >= 4) {
            CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_A2C_XN);   // wait 后紧接 set → 挂 PIPE_S
            BarrierAic<PIPE_S, PIPE_MTE2, FLAG_AC0>();
            // mode 2（use_combine=false）不产出 injection：只跑 down 的 2 个 N-tile
            const uint32_t nDtiles = (p.mode == MODE_FINAL_MIX) ? (LOWRANK / BASE_N) : DN_NTILES;
            for (uint32_t nt = bid; nt < nDtiles; nt += nAic) {
                const uint32_t ns = (nDtiles == DN_NTILES && nt == DN_NTILES - 1) ? DN_LAST_NSIZE : BASE_N;
                down.RunTile(nt, ns);
            }
            // FIXP 写 GM 排空 + 全体 AIC 对齐（AIV 侧要读任意列，必须全体到齐）
            BarrierAic<PIPE_S, PIPE_FIX, FLAG_AC1>();
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE2>(FLAG_C2A_OH);
        }
        if (p.stageLimit >= 6) {
            CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_A2C_LS);
            BarrierAic<PIPE_S, PIPE_MTE2, FLAG_AC2>();
            for (uint32_t nt = bid; nt < UP_NTILES; nt += nAic) {
                up.RunTile(nt, BASE_N);
            }
            BarrierAic<PIPE_S, PIPE_FIX, FLAG_AC3>();
            CrossCoreSetFlag<CC_MODE2, PIPE_MTE2>(FLAG_C2A_GATE);
        }
    }

private:
    // ---- W0：injW = 2·sigmoid(IJ/HC)。
    //   实现要点（bring-up 实测 + tower 裁定「先隔离再入库」）：S1 里 injW 从 **V 自己写出**的
    //   32B 对齐槽做 BRC 广播。原实现是「W0 用 MTE3 把表写 GM、S1 用 MTE2 取回再 BRC」，该形态
    //   实测非确定性错读（部分 chunk 退化为 out = h）；**但该路径同时含两个可疑因子——
    //   (i) 同核 MTE3→GM→MTE2 回环没有任何跨 pipe 排序原语（生产者/消费者用了两个不同 BufferID）
    //   与 (ii) BRC 读 MTE2 搬进的 UB 槽的可见性——当时的修法同时去掉了两者，故本条《尚未隔离》，
    //   **不作为平台行为引用**（详见 README §4.1）。
    //   现状实现：每个 (token,stream) 一次 VL1 掩码单元素载入 + 单元素 32B 槽落盘，
    //   得到「每个 (token,stream) 一个 32B 槽、有效值在槽首」的全表供 S1 BRC。
    __aicore__ inline void InjwStage(uint32_t /*bid*/, uint32_t /*nAiv*/)
    {
        AscendC::LocalTensor<bfloat16_t> ijL(TPosition::VECCALC, UB_IW_IJ, M_MAX * IJ_STRIDE);
        AscendC::LocalTensor<float> tabL(TPosition::VECCALC, UB_IW_TAB, UB_IWTAB_SLOTS * INJW_SLOT);
        __ubuf__ bfloat16_t* ijUb = reinterpret_cast<__ubuf__ bfloat16_t*>(ijL.GetPhyAddr());
        __ubuf__ float* tabUb = reinterpret_cast<__ubuf__ float*>(tabL.GetPhyAddr());

        BufAcquire<PIPE_MTE2>(BUF_AIV_IJ);
        PipeBarrier<PIPE_MTE2>();
        AscendC::DataCopy(ijL, ijGm[0], Block1(M_MAX * IJ_STRIDE * 2));
        BufRelease<PIPE_MTE2>(BUF_AIV_IJ);

        const uint16_t mU = static_cast<uint16_t>(p.m);
        BufAcquire<PIPE_V>(BUF_AIV_IJ);
        BufAcquire<PIPE_V>(BUF_AIV_SG);
        __VEC_SCOPE__
        {
            RegTensor<bfloat16_t> jb16;
            RegTensor<float> v, one, idx, zero, sel, red;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
            MaskReg cmpS;
            Duplicate(one, 1.0f, maskAll);
            Duplicate(zero, 0.0f, maskAll);
            Arange(idx, 0.0f);   // idx 各 lane = 该 lane 的序号（用于按 lane 选流）
            // M36 review P1：先把**整张表**按 32B 槽整槽清零。
            // 否则每个槽只写 4B（`DIST_FIRST_ELEMENT_B32` 只落槽首），槽的 [4,32) 保留 UB 残留 ⇒
            // dump 出来的 GM `injw` 张量含未初始化字节 ⇒ 同一二进制重复运行哈希不同、
            // 归档 manifest 永远复现不出。清零后「每槽 32B 全由本 kernel 写出」，确定性与可复现性成立。
            // （掩码用 VL8：8×fp32 = 32B = 恰好一个槽，不会溢出到相邻槽。）
            {
                // 掩码 VL8 ⇒ 每次只写 8 个 fp32（**不是** VL_F32=64），故步长必须取 INJW_SLOT。
                // （首版误用步长 VL_F32 ⇒ 只覆盖了槽 0、8、16… 共 32/256 个槽，槽 [1..7] 的尾部仍是残留，
                //   实测表现正是「槽 0 确定、槽 1-3 非确定」。）
                MaskReg mask8 = CreateMask<float, MaskPattern::VL8>();
                for (uint16_t c = 0; c < static_cast<uint16_t>(UB_IWTAB_SLOTS); ++c) {
                    StoreAlign<float, StoreDist::DIST_NORM_B32>(tabUb + static_cast<uint32_t>(c) * INJW_SLOT, zero,
                                                               mask8);
                }
            }
            for (uint16_t mi = 0; mi < mU; ++mi) {
                // 一行 IJ（32B，天然对齐）→ 4 个 sigmoid 落在 lane 0..3
                LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(jb16, ijUb + mi * IJ_STRIDE);
                Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(v, jb16, maskAll);
                Muls(v, v, 1.0f / static_cast<float>(HC), maskAll);
                NormDonor::SigmoidReg(v, v, one, maskAll);
                Muls(v, v, 2.0f, maskAll);
                // 按流抽取 lane s → 该流独有的 32B 槽首。
                // 注意：`StoreDist::DIST_FIRST_ELEMENT_B32` **按定义只写元素 0**（名字即语义；m6_rmsnorm
                // 的 6 处用法都是「Reduce 得标量 + VL1 掩码 + 本 dist」，与此一致）⇒ 用它做 lane 选择
                // 属**误用**（tower 裁定，非平台差异）——改为
                // 「掩码 Select 清零其它 lane → Reduce<SUM> 归约到 lane 0 → 单元素落盘」。
                // 另外 s 必须编译期常量展开（VF 内动态标量会触发
                // 「Unsupported scalar instruction in AIV loop」，docs/05 §6.3 #23 同类）。
                Compares(cmpS, idx, 0.0f, maskAll);
                Select(sel, v, zero, cmpS);
                Reduce<ReduceType::SUM>(red, sel, maskAll);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tabUb + (mi * HC + 0) * INJW_SLOT, red,
                                                                     maskOne);
                Compares(cmpS, idx, 1.0f, maskAll);
                Select(sel, v, zero, cmpS);
                Reduce<ReduceType::SUM>(red, sel, maskAll);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tabUb + (mi * HC + 1) * INJW_SLOT, red,
                                                                     maskOne);
                Compares(cmpS, idx, 2.0f, maskAll);
                Select(sel, v, zero, cmpS);
                Reduce<ReduceType::SUM>(red, sel, maskAll);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tabUb + (mi * HC + 2) * INJW_SLOT, red,
                                                                     maskOne);
                Compares(cmpS, idx, 3.0f, maskAll);
                Select(sel, v, zero, cmpS);
                Reduce<ReduceType::SUM>(red, sel, maskAll);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(tabUb + (mi * HC + 3) * INJW_SLOT, red,
                                                                     maskOne);
            }
        }
        BufRelease<PIPE_V>(BUF_AIV_IJ);
        BufRelease<PIPE_V>(BUF_AIV_SG);

        BufAcquire<PIPE_MTE3>(BUF_AIV_SG);
        AscendC::DataCopy(injwGm[0], tabL, Block1(static_cast<uint32_t>(p.m) * HC * INJW_SLOT * 4));
        BufRelease<PIPE_MTE3>(BUF_AIV_SG);
    }

    // ---- S1：combine（4 路残差流进 → H' 出），item = 整行第 c 个 64 元素 chunk ----
    __aicore__ inline void CombineStage(uint32_t bid, uint32_t nAiv)
    {
        AscendC::LocalTensor<bfloat16_t> hL(TPosition::VECCALC, UB_S1_HB, CHUNK);
        AscendC::LocalTensor<bfloat16_t> boL(TPosition::VECCALC, UB_S1_BOB, CHUNK);
        AscendC::LocalTensor<bfloat16_t> obL(TPosition::VECCALC, UB_S1_OB, CHUNK);
        __ubuf__ bfloat16_t* hUb = reinterpret_cast<__ubuf__ bfloat16_t*>(hL.GetPhyAddr());
        __ubuf__ bfloat16_t* boUb = reinterpret_cast<__ubuf__ bfloat16_t*>(boL.GetPhyAddr());
        __ubuf__ bfloat16_t* obUb = reinterpret_cast<__ubuf__ bfloat16_t*>(obL.GetPhyAddr());
        AscendC::LocalTensor<float> tabL(TPosition::VECCALC, UB_IW_TAB, UB_IWTAB_SLOTS * INJW_SLOT);
        __ubuf__ float* iwTabUb = reinterpret_cast<__ubuf__ float*>(tabL.GetPhyAddr());

        const uint32_t nItems = p.m * NCH_D;
        for (uint32_t i = bid; i < nItems; i += nAiv) {
            const uint32_t mi = i / NCH_D;
            const uint32_t c = i - mi * NCH_D;
            const uint32_t s = c / NCH_H;          // 第几路残差流
            const uint32_t jj = c - s * NCH_H;     // 流内 chunk 号

            PipeBarrier<PIPE_MTE2>();   // 同 pipe 复用同一 UB 行缓冲（docs/05 §6.2 第 1 条）
            BufAcquire<PIPE_MTE2>(BUF_AIV_H);
            AscendC::DataCopy(hL, hInGm[mi * HYPER + c * CHUNK], Block1(CHUNK * 2));
            BufRelease<PIPE_MTE2>(BUF_AIV_H);
            BufAcquire<PIPE_MTE2>(BUF_AIV_BO);
            AscendC::DataCopy(boL, boGm[mi * HID + jj * CHUNK], Block1(CHUNK * 2));
            BufRelease<PIPE_MTE2>(BUF_AIV_BO);

            BufAcquire<PIPE_V>(BUF_AIV_H);
            BufAcquire<PIPE_V>(BUF_AIV_BO);
            BufAcquire<PIPE_V>(BUF_AIV_OB);
            __VEC_SCOPE__
            {
                RegTensor<float> w, hr, bor, t;
                RegTensor<bfloat16_t> ob16;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                LoadAlign<float, LoadDist::DIST_BRC_B32>(w, iwTabUb + (mi * HC + s) * INJW_SLOT);
                NormDonor::LoadRegForDtype<bfloat16_t>(hUb, hr, maskAll, 0);
                NormDonor::LoadRegForDtype<bfloat16_t>(boUb, bor, maskAll, 0);
                Mul(t, bor, w, maskAll);              // bo · injW[s]
                Add(t, hr, t, maskAll);               // h + bo·injW[s]
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(ob16, t, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(obUb, ob16, maskAll);
            }
            BufRelease<PIPE_V>(BUF_AIV_H);
            BufRelease<PIPE_V>(BUF_AIV_BO);
            BufRelease<PIPE_V>(BUF_AIV_OB);

            BufAcquire<PIPE_MTE3>(BUF_AIV_OB);
            AscendC::DataCopy(hcpGm[mi * HYPER + c * CHUNK], obL, Block1(CHUNK * 2));
            BufRelease<PIPE_MTE3>(BUF_AIV_OB);
        }
    }

    // ---- S2：per (token,stream) 的 GemmaRMSNorm（HID=2560 一组常驻 UB，纯 V 两遍）----
    __aicore__ inline void NormStage(uint32_t bid, uint32_t nAiv, AscendC::GlobalTensor<bfloat16_t>& srcGm)
    {
        AscendC::LocalTensor<bfloat16_t> xL(TPosition::VECCALC, UB_S2_XB, HID);
        AscendC::LocalTensor<bfloat16_t> wL(TPosition::VECCALC, UB_S2_WB, HID);
        AscendC::LocalTensor<bfloat16_t> yL(TPosition::VECCALC, UB_S2_YB, HID);
        AscendC::LocalTensor<float> rsL(TPosition::VECCALC, UB_S2_RS, 8);
        __ubuf__ bfloat16_t* xUb = reinterpret_cast<__ubuf__ bfloat16_t*>(xL.GetPhyAddr());
        __ubuf__ bfloat16_t* wUb = reinterpret_cast<__ubuf__ bfloat16_t*>(wL.GetPhyAddr());
        __ubuf__ bfloat16_t* yUb = reinterpret_cast<__ubuf__ bfloat16_t*>(yL.GetPhyAddr());
        __ubuf__ float* rsUb = reinterpret_cast<__ubuf__ float*>(rsL.GetPhyAddr());

        const uint32_t nGroups = p.m * HC;
        for (uint32_t g = bid; g < nGroups; g += nAiv) {
            const uint32_t mi = g / HC;
            const uint32_t s = g - mi * HC;

            PipeBarrier<PIPE_MTE2>();
            BufAcquire<PIPE_MTE2>(BUF_AIV_X);
            AscendC::DataCopy(xL, srcGm[mi * HYPER + s * HID], Block1(HID * 2));
            BufRelease<PIPE_MTE2>(BUF_AIV_X);
            BufAcquire<PIPE_MTE2>(BUF_AIV_WB);
            AscendC::DataCopy(wL, hcNormGm[s * HID], Block1(HID * 2));
            BufRelease<PIPE_MTE2>(BUF_AIV_WB);

            BufAcquire<PIPE_V>(BUF_AIV_X);
            BufAcquire<PIPE_V>(BUF_AIV_WB);
            BufAcquire<PIPE_V>(BUF_AIV_Y);
            // pass A：平方和（依赖把 bf16 舍入后的值平方——与 triton 一致）
            __VEC_SCOPE__
            {
                RegTensor<float> acc, xr, t, red;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
                Duplicate(acc, 0.0f, maskAll);
                for (uint16_t c = 0; c < NCH_H; ++c) {
                    NormDonor::LoadRegForDtype<bfloat16_t>(xUb, xr, maskAll, c * CHUNK);
                    Mul(t, xr, xr, maskAll);
                    Add(acc, acc, t, maskAll);
                }
                Reduce<ReduceType::SUM>(red, acc, maskAll);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb, red, maskOne);
            }
            // pass A2：rstd = NR rsqrt(sum/HID + eps)
            __VEC_SCOPE__
            {
                RegTensor<float> v, rstd;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
                LoadAlign<float, LoadDist::DIST_BRC_B32>(v, rsUb);
                Muls(v, v, 1.0f / static_cast<float>(HID), maskAll);
                NormDonor::ComputeRstdNewtonRaphsonReg(v, rstd, maskAll, EPS);
                StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb, rstd, maskOne);
            }
            // pass B：y = (x·rstd) + (x·rstd)·gamma → bf16（Gemma 仿射以 y + y·w 表达，同 triton）
            __VEC_SCOPE__
            {
                RegTensor<float> rstd, xr, wr, t, y;
                RegTensor<bfloat16_t> yb16;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                LoadAlign<float, LoadDist::DIST_BRC_B32>(rstd, rsUb);
                for (uint16_t c = 0; c < NCH_H; ++c) {
                    NormDonor::LoadRegForDtype<bfloat16_t>(xUb, xr, maskAll, c * CHUNK);
                    NormDonor::LoadRegForDtype<bfloat16_t>(wUb, wr, maskAll, c * CHUNK);
                    Mul(t, xr, rstd, maskAll);
                    Mul(y, t, wr, maskAll);
                    Add(y, t, y, maskAll);
                    Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb16, y, maskAll);
                    StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(yUb + c * CHUNK, yb16, maskAll);
                }
            }
            BufRelease<PIPE_V>(BUF_AIV_X);
            BufRelease<PIPE_V>(BUF_AIV_WB);
            BufRelease<PIPE_V>(BUF_AIV_Y);

            BufAcquire<PIPE_MTE3>(BUF_AIV_Y);
            AscendC::DataCopy(xnGm[mi * HYPER + s * HID], yL, Block1(HID * 2));
            BufRelease<PIPE_MTE3>(BUF_AIV_Y);
            // rstd 证据张量（4B）
            BufAcquire<PIPE_MTE3>(BUF_AIV_RS);
            AscendC::DataCopyPad(rstdGm[g], rsL, ExtBlock1(4));
            BufRelease<PIPE_MTE3>(BUF_AIV_RS);
        }
    }

    // ---- S4：silu(lora/HC)，item = lowrank 行的第 c 个 chunk ----
    __aicore__ inline void SiluStage(uint32_t bid, uint32_t nAiv)
    {
        AscendC::LocalTensor<bfloat16_t> lL(TPosition::VECCALC, UB_S4_LB, CHUNK);
        AscendC::LocalTensor<bfloat16_t> sL(TPosition::VECCALC, UB_S4_SB, CHUNK);
        __ubuf__ bfloat16_t* lUb = reinterpret_cast<__ubuf__ bfloat16_t*>(lL.GetPhyAddr());
        __ubuf__ bfloat16_t* sUb = reinterpret_cast<__ubuf__ bfloat16_t*>(sL.GetPhyAddr());

        const uint32_t nItems = p.m * NCH_R;
        for (uint32_t i = bid; i < nItems; i += nAiv) {
            const uint32_t mi = i / NCH_R;
            const uint32_t c = i - mi * NCH_R;

            PipeBarrier<PIPE_MTE2>();
            BufAcquire<PIPE_MTE2>(BUF_AIV_LB);
            AscendC::DataCopy(lL, ohGm[mi * OH_W + OH_LORA + c * CHUNK], Block1(CHUNK * 2));
            BufRelease<PIPE_MTE2>(BUF_AIV_LB);

            BufAcquire<PIPE_V>(BUF_AIV_LB);
            BufAcquire<PIPE_V>(BUF_AIV_SB);
            __VEC_SCOPE__
            {
                RegTensor<float> xr, u, sg, one, y;
                RegTensor<bfloat16_t> yb16;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                Duplicate(one, 1.0f, maskAll);
                NormDonor::LoadRegForDtype<bfloat16_t>(lUb, xr, maskAll, 0);
                Muls(u, xr, 1.0f / static_cast<float>(HC), maskAll);   // u = lora/HC
                NormDonor::SigmoidReg(sg, u, one, maskAll);
                Mul(y, u, sg, maskAll);                              // u·sigmoid(u)
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb16, y, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(sUb, yb16, maskAll);
            }
            BufRelease<PIPE_V>(BUF_AIV_LB);
            BufRelease<PIPE_V>(BUF_AIV_SB);

            BufAcquire<PIPE_MTE3>(BUF_AIV_SB);
            AscendC::DataCopy(lsGm[mi * LOWRANK + c * CHUNK], sL, Block1(CHUNK * 2));
            BufRelease<PIPE_MTE3>(BUF_AIV_SB);
        }
    }

    // ---- S6：gate mix，item = 输出行第 c 个 chunk（4 路并列读-算-累加）----
    __aicore__ inline void GateMixStage(uint32_t bid, uint32_t nAiv)
    {
        AscendC::LocalTensor<bfloat16_t> gL(TPosition::VECCALC, UB_S6_GB, HC * CHUNK);
        AscendC::LocalTensor<bfloat16_t> xL(TPosition::VECCALC, UB_S6_XB, HC * CHUNK);
        AscendC::LocalTensor<bfloat16_t> oL(TPosition::VECCALC, UB_S6_OB, CHUNK);
        __ubuf__ bfloat16_t* gUb = reinterpret_cast<__ubuf__ bfloat16_t*>(gL.GetPhyAddr());
        __ubuf__ bfloat16_t* xUb = reinterpret_cast<__ubuf__ bfloat16_t*>(xL.GetPhyAddr());
        __ubuf__ bfloat16_t* oUb = reinterpret_cast<__ubuf__ bfloat16_t*>(oL.GetPhyAddr());

        const uint32_t nItems = p.m * NCH_H;
        for (uint32_t i = bid; i < nItems; i += nAiv) {
            const uint32_t mi = i / NCH_H;
            const uint32_t c = i - mi * NCH_H;

            PipeBarrier<PIPE_MTE2>();
            BufAcquire<PIPE_MTE2>(BUF_AIV_GB);
            for (uint32_t s = 0; s < HC; ++s) {
                AscendC::DataCopy(gL[s * CHUNK], gateGm[mi * UP_N + s * HID + c * CHUNK], Block1(CHUNK * 2));
            }
            BufRelease<PIPE_MTE2>(BUF_AIV_GB);
            BufAcquire<PIPE_MTE2>(BUF_AIV_XB);
            for (uint32_t s = 0; s < HC; ++s) {
                AscendC::DataCopy(xL[s * CHUNK], xnGm[mi * HYPER + s * HID + c * CHUNK], Block1(CHUNK * 2));
            }
            BufRelease<PIPE_MTE2>(BUF_AIV_XB);

            BufAcquire<PIPE_V>(BUF_AIV_GB);
            BufAcquire<PIPE_V>(BUF_AIV_XB);
            BufAcquire<PIPE_V>(BUF_AIV_OB2);
            __VEC_SCOPE__
            {
                RegTensor<float> acc, gr, xr, sg, one, t;
                RegTensor<bfloat16_t> ob16;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                Duplicate(one, 1.0f, maskAll);
                Duplicate(acc, 0.0f, maskAll);
                // 累加顺序 s=0..HC-1 后统一 /HC —— 与 triton _hc_gate_mix_kernel 逐句一致
                for (uint16_t s = 0; s < static_cast<uint16_t>(HC); ++s) {
                    NormDonor::LoadRegForDtype<bfloat16_t>(gUb, gr, maskAll, s * CHUNK);
                    NormDonor::LoadRegForDtype<bfloat16_t>(xUb, xr, maskAll, s * CHUNK);
                    NormDonor::SigmoidReg(sg, gr, one, maskAll);
                    Mul(t, sg, xr, maskAll);
                    Add(acc, acc, t, maskAll);
                }
                Muls(acc, acc, 1.0f / static_cast<float>(HC), maskAll);
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(ob16, acc, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(oUb, ob16, maskAll);
            }
            BufRelease<PIPE_V>(BUF_AIV_GB);
            BufRelease<PIPE_V>(BUF_AIV_XB);
            BufRelease<PIPE_V>(BUF_AIV_OB2);

            BufAcquire<PIPE_MTE3>(BUF_AIV_OB2);
            AscendC::DataCopy(blkGm[mi * HID + c * CHUNK], oL, Block1(CHUNK * 2));
            BufRelease<PIPE_MTE3>(BUF_AIV_OB2);
        }
    }

private:
    HcPtrs p;
    __gm__ uint8_t* ws = nullptr;
    AscendC::GlobalTensor<bfloat16_t> hInGm;
    AscendC::GlobalTensor<bfloat16_t> boGm;
    AscendC::GlobalTensor<bfloat16_t> ijGm;
    AscendC::GlobalTensor<bfloat16_t> hcNormGm;
    AscendC::GlobalTensor<bfloat16_t> hcpGm;
    AscendC::GlobalTensor<bfloat16_t> xnGm;
    AscendC::GlobalTensor<float> rstdGm;
    AscendC::GlobalTensor<float> injwGm;
    AscendC::GlobalTensor<bfloat16_t> ohGm;
    AscendC::GlobalTensor<bfloat16_t> lsGm;
    AscendC::GlobalTensor<bfloat16_t> gateGm;
    AscendC::GlobalTensor<bfloat16_t> blkGm;
    HcBf16Gemm<DN_K, OH_W, true> down;
    HcBf16Gemm<UP_K, UP_N, false> up;
};

}  // namespace

// ============================================================
// 入口：单一 __mix__(1,2)（AIC:AIV = 1:2 编译期定死；核数由 host 用 API 取）
// ============================================================
extern "C" __global__ __mix__(1, 2) void m20_hyperconn_kernel(
    __gm__ uint8_t* hIn, __gm__ uint8_t* bo, __gm__ uint8_t* ij, __gm__ uint8_t* wDown, __gm__ uint8_t* wInj,
    __gm__ uint8_t* wUp, __gm__ uint8_t* hcNorm, __gm__ uint8_t* ws, uint32_t m, uint32_t mode,
    uint32_t stageLimit)
{
    AscendC::InitSocState();
    HcPtrs args;
    args.hIn = hIn;
    args.bo = bo;
    args.ij = ij;
    args.wDown = wDown;
    args.wInj = wInj;
    args.wUp = wUp;
    args.hcNorm = hcNorm;
    args.ws = ws;
    args.m = m;
    args.mode = mode;
    args.stageLimit = stageLimit;

    HyperConnOp op;
    op.Init(args);
    if ASCEND_IS_AIV {
        op.ProcessAiv();
    }
    if ASCEND_IS_AIC {
        op.ProcessAic();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧：确定性数据生成 / double 参考 / 逐张量判据 / dump
//   - 参考全部用 double 逐句实现 README §1.3 的伪码（与 vLLM 语义一一对应）
//   - 判据：bf16 位模式的单调整数映射（Bf16Key）上的 ulp 距离 + 逐位一致率
// ============================================================

// ---- bf16 编解码（RNE，与硬件 F322BF16 同网格；m11 同款）----
static uint16_t F32ToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    const uint32_t roundingBias = ((x >> 16) & 1u) + 0x7FFFu;
    return static_cast<uint16_t>((x + roundingBias) >> 16);
}

static float Bf16ToF32(uint16_t h)
{
    const uint32_t x = static_cast<uint32_t>(h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

// bf16 位模式 → 单调整数键（ulp 距离用）；±0 映射到同一点
static int32_t Bf16Key(uint16_t b)
{
    return (b & 0x8000u) ? -static_cast<int32_t>(b & 0x7FFFu) : static_cast<int32_t>(b & 0x7FFFu);
}

// 确定性伪随机（m0/m1/m11 同风格：纯公式，无 rand 状态）
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

// 生成档：0 = 小整数（|v| ≤ 8）；1 = 真实量级（均匀 ±scale）；2 = 权重全零（激活仍为整数档）
enum GenKind { GEN_INT = 0, GEN_REAL = 1, GEN_ZEROW = 2, GEN_EXACT0 = 3 };

struct TensorGen {
    uint32_t salt;
    double scale;   // GEN_REAL 用；GEN_INT / GEN_EXACT0 忽略
    bool zero;      // GEN_ZEROW 下该张量置零
};

static double GenVal(const TensorGen& tg, uint32_t kind, uint32_t i, uint32_t j)
{
    if (tg.zero) {
        return 0.0;
    }
    const uint32_t h = Hash3(i, j, tg.salt);
    if (kind == GEN_REAL) {
        const int32_t q = static_cast<int32_t>(h % 2001u) - 1000;
        return tg.scale * static_cast<double>(q) / 1000.0;
    }
    const int32_t q = static_cast<int32_t>(h % 17u) - 8;
    return static_cast<double>(q);
}

// hc_norm 用：真实档下带均值偏移（checkpoint 实测 mean −0.064 / std 0.473）
static double GenNormVal(const TensorGen& tg, uint32_t kind, uint32_t j)
{
    const uint32_t h = Hash3(7u, j, tg.salt);
    if (kind == GEN_REAL) {
        const int32_t q = static_cast<int32_t>(h % 2001u) - 1000;
        return -0.064 + 0.820 * static_cast<double>(q) / 1000.0;
    }
    const int32_t q = static_cast<int32_t>(h % 5u) - 2;   // 整数档：[-2,2]
    return static_cast<double>(q);
}

static double SigmoidD(double x) { return 1.0 / (1.0 + std::exp(-x)); }

// 舍入到 bf16 网格（RNE）后以 double 返回 —— 参考里每一次「落盘 bf16」都必须过这一步
static double RndBf16(double x) { return static_cast<double>(Bf16ToF32(F32ToBf16(static_cast<float>(x)))); }

// ============================================================
// 判据计数器（docs/17 §2.1 分栏 + §2.2「计数必须可复算」）
//   判定项 = docs/17 分档判据（T1/T2′/T3/T4），决定 PASS/FAIL
//   报告项 = 观测值（逐位率 / maxUlp / maxAbs / 归一化绝对误差 / ε / maxRatio），**不参与 PASS/FAIL**
//   guard  = 结构性前提（非空洞性、跨 case 判别力、有限性、中间量合理性），单列
// ============================================================
static uint32_t gJudge = 0;      // 判定项 checks
static uint32_t gJudgeFail = 0;  // 判定项 fails
static uint32_t gReport = 0;     // 报告项条数
static uint32_t gGuard = 0;      // guard checks
static uint32_t gGuardFail = 0;  // guard fails

static void CountJudge(bool ok)
{
    ++gJudge;
    if (!ok) {
        ++gJudgeFail;
    }
}

static void CountGuard(bool ok)
{
    ++gGuard;
    if (!ok) {
        ++gGuardFail;
    }
}

// ---- 判据累计器 ----
// 判据口径（与 m6/m13/m14 同构，另加「显著元素」门限）：
//   * 主判据 = 逐位一致率 + 显著元素上的 bf16 ulp 距离（≤1 ulp）
//   * 显著性门限 atol = 1e-6 × 该张量参考值绝对值上界：
//     3510 向量单元 fp32 结果对次正规数 FTZ（docs/05 §6.1「fp32 次正规 FTZ 为硬件模式」，
//     m12 README 已记录同款现象），且参考在 double 下做累加——「参考≈0」的元素上
//     双边舍入路径不同（|Δ| ~1e-38 或 ~1e-11），不应计入 ulp 判据。
struct Judge {
    const char* name;
    uint32_t total = 0;
    uint32_t exact = 0;       // 全量逐位一致
    uint32_t signif = 0;      // 良态元素（|ref| > 5% 张量尺度）
    uint32_t signifExact = 0;
    int32_t maxUlp = 0;       // 仅良态元素
    double maxAbs = 0.0;
    double scale = 0.0;       // 参考值绝对上界（张量尺度）
    bool nonFinite = false;
    bool pass = true;
};

static int32_t dbgLeft = 3;

// 判据口径（bf16 输出 + double 参考；GEMM 段存在相消导致小元素相对误差大）：
//   1) 归一化绝对误差 maxAbs / scale ≤ 1e-2 —— bf16 网格 2^-8 = 0.39%，1e-2 约等于其 2.5 倍；
//   2) 良态元素（|ref| > 5% 张量尺度）上：逐位一致率 ≥ 99.9% 且最大 bf16 ulp 距离 ≤ 2；
//   3) 无 ±Inf/NaN。
//   另：3510 向量单元对 fp32 次正规结果 FTZ（硬件模式，docs/05 §6.1），且参考在 double 下累加，
//       「参考≈0」的元素双边舍入路径本就不同（实测 |Δ| ~1e-38 ~ 1e-11），故按尺度而非逐位严判。
static void JudgeBuf(Judge& jd, const uint16_t* got, const double* exp, size_t n)
{
    for (size_t k = 0; k < n; ++k) {
        const double a = std::fabs(exp[k]);
        if (a > jd.scale) {
            jd.scale = a;
        }
    }
    const double sigThresh = jd.scale * 0.05;
    for (size_t k = 0; k < n; ++k) {
        const float g = Bf16ToF32(got[k]);
        if (!std::isfinite(g)) {
            jd.nonFinite = true;
        }
        const uint16_t e = F32ToBf16(static_cast<float>(exp[k]));
        const int32_t d = Bf16Key(got[k]) - Bf16Key(e);
        const int32_t a = d < 0 ? -d : d;
        ++jd.total;
        if (a == 0) {
            ++jd.exact;
        }
        const double ab = std::fabs(static_cast<double>(g) - exp[k]);
        if (ab > jd.maxAbs) {
            jd.maxAbs = ab;
        }
        const bool sig = std::fabs(exp[k]) > sigThresh;
        if (sig) {
            ++jd.signif;
            if (a > jd.maxUlp) {
                jd.maxUlp = a;
            }
            if (a == 0) {
                ++jd.signifExact;
            }
            if (a > 2 && dbgLeft > 0) {
                printf("[M20][dbg] %s k=%zu got=0x%04x(%.6g) exp=%.6g ulp=%d\n", jd.name, k, got[k], (double)g,
                       exp[k], a);
                --dbgLeft;
            }
        }
    }
}

// **报告项**（docs/17 §1.1：`≤1ulp 比例` / `maxRel` / 位级一致率全部降为报告项）。
// 本函数只打印观测值，不产生 PASS/FAIL；该张量的判据由对应的 T1/T2′/T3 判定项承担。
// 仅把 `nonFinite` 作为 guard（输出出现 ±Inf/NaN 是结构性错误）。
static void JudgeReport(Judge& jd)
{
    const double frac = jd.total ? static_cast<double>(jd.exact) / static_cast<double>(jd.total) : 0.0;
    const double sfrac = jd.signif ? static_cast<double>(jd.signifExact) / static_cast<double>(jd.signif) : 1.0;
    const double normAbs = jd.scale > 0.0 ? jd.maxAbs / jd.scale : 0.0;
    ++gReport;
    CountGuard(!jd.nonFinite);
    printf("[M20]   报告 %-7s n=%-7u 逐位=%-7u(%.4f) | 良态=%-7u 逐位=%-7u(%.4f) ulpMax(良态)=%-3d | "
           "maxAbs=%.3e scale=%.3e 归一=%.3e\n",
           jd.name, jd.total, jd.exact, frac, jd.signif, jd.signifExact, sfrac, jd.maxUlp, jd.maxAbs, jd.scale,
           normAbs);
}

// ---- docs/17 §1.1 T3 判据（长 fp32 链 / 含超越函数近似）----
// 逐元素判 |bf16(device) − ref| ≤ ε·Σ|terms| + 1.0·ulp_bf16（见下方舍入项推导），违反数必须为 0。
// FTZ 子条款（docs/05 §6.1 硬件行为）：|ref| < 2^-116（fp32 中间量会落次正规区）时本判据不适用，
// 改为要求 |out| ≤ 2^-116（设备把次正规结果刷成 0）。
constexpr double FTZ_THRESH = 1.0e-35;   // ≈2^-116

// bf16 的 ulp：bf16 = 1 符号 + 8 指数 + **7 个显式尾数位**（+1 隐式 ⇒ 有效位 8），
// 故 x ∈ [2^(e-1), 2^e)（frexp 的 e）时 ulp = 2^(e-1-7) = 2^(e-8)。
// 注：M36 第 1 轮评审后修正——此前误写为 2^(e-1-8)（**只有真值的一半**），
//     会把 T3 的舍入项低估 2 倍，导致「贴 bf16 中点」的元素被误报为违反。
static double BfUlp(double x)
{
    const double a = std::fabs(x);
    if (a == 0.0) {
        return 0.0;
    }
    int e = 0;
    std::frexp(a, &e);              // a = f·2^e, f ∈ [0.5,1) ⇒ a ∈ [2^(e-1), 2^e)
    return std::ldexp(1.0, e - 8);  // 7 个显式尾数位
}

static void JudgeT3(const char* name, const uint16_t* got, const double* exp, const double* sumAbs, size_t n,
                    double eps, bool& okOut)
{   // docs/17 §1.1 T3 判定项：逐元素 |bf16(dev) − ref| ≤ ε·Σ|terms| + 0.5·ulp_bf16(ref)，违反数必须 0

    uint32_t viol = 0;
    uint32_t ftz = 0;
    uint32_t ftzViol = 0;
    double maxRatio = 0.0;
    size_t worstK = 0;
    for (size_t k = 0; k < n; ++k) {
        const double ref = exp[k];
        const double g = static_cast<double>(Bf16ToF32(got[k]));
        if (!std::isfinite(g)) {
            okOut = false;
        }
        if (std::fabs(ref) < FTZ_THRESH) {
            ++ftz;
            if (std::fabs(g) > FTZ_THRESH) {
                ++ftzViol;
            }
            continue;
        }
        // 舍入项取 **1.0·ulp**（不是 0.5）：设备把 fp32 结果舍到 bf16（≤0.5 ulp），
        // 参考把 double 结果舍到 bf16（≤0.5 ulp），两者可落在同一 bf16 中点的异侧 ⇒ 合计 ≤1 ulp。
        // 实测 real_m1 的 k=7253 就是这种**贴 bf16 中点**的元素：设备侧 fp32 值恰落在中点
        // （ties-to-even 向下），参考在 midpoint 上方 8.7e-9 处向上舍 ⇒ 二者正好差 1 ulp。
        // 取 max(ulp(got), ulp(ref)) 覆盖跨 binade 的情形。这类元素的最大比值会接近 1.0，
        // 是**紧界的必然表现**（界不可再收紧），不是异常。
        const double ulpOut = BfUlp(g) > BfUlp(ref) ? BfUlp(g) : BfUlp(ref);
        const double bound = eps * sumAbs[k] + 1.0 * ulpOut;
        const double d = std::fabs(g - ref);
        const double ratio = d / bound;
        if (ratio > maxRatio) {
            maxRatio = ratio;
            worstK = k;
        }
        if (d > bound) {
            ++viol;
            if (viol <= 3) {
                printf("[M20][dbgT3] %s k=%zu got=%.9g ref=%.9g |d|=%.4g sumAbs=%.6g eps*sa=%.4g ulp=%.4g "
                       "bound=%.4g\n", name, k, g, ref, d, sumAbs[k], eps * sumAbs[k], ulpOut, bound);
            }
        }
    }
    const bool ok = (viol == 0) && (ftzViol == 0);
    CountJudge(ok);
    if (!ok) {
        okOut = false;
    }
    printf("[M20]   T3 JUDGE %-8s ε=%.2e n=%-7zu 违反=%-5u (maxRatio=%.3f @k=%zu) FTZ区=%-5u 其中越界=%u  %s\n",
           name, eps, n, viol, maxRatio, worstK, ftz, ftzViol, ok ? "PASS" : "FAIL");
}

static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) {
        return false;
    }
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

static void WriteMeta(const char* path, const char* name, const char* shape, const char* dtype)
{
    FILE* f = fopen(path, "w");
    if (f == nullptr) {
        return;
    }
    fprintf(f, "%s %s %s\n", name, shape, dtype);
    fclose(f);
}

// ---- 设备输出偏移（与 m20_resources.h §4 同源）----
struct HcView {
    const uint16_t* hcp;    // [M_MAX, HYPER]
    const uint16_t* xn;     // [M_MAX, HYPER]
    const float* rstd;      // [M_MAX*HC]
    const float* injw;      // [M_MAX, HC, INJW_SLOT] fp32（有效值在每槽首）
    const uint16_t* oh;     // [M_MAX, OH_W]
    const uint16_t* ls;     // [M_MAX, LOWRANK]
    const uint16_t* gate;   // [M_MAX, UP_N]
    const uint16_t* blk;    // [M_MAX, HID]
};

static HcView MakeView(const uint8_t* ws)
{
    HcView v;
    v.hcp = reinterpret_cast<const uint16_t*>(ws + WS_HCP);
    v.xn = reinterpret_cast<const uint16_t*>(ws + WS_XN);
    v.rstd = reinterpret_cast<const float*>(ws + WS_RSTD);
    v.injw = reinterpret_cast<const float*>(ws + WS_INJW);
    v.oh = reinterpret_cast<const uint16_t*>(ws + WS_OH);
    v.ls = reinterpret_cast<const uint16_t*>(ws + WS_LS);
    v.gate = reinterpret_cast<const uint16_t*>(ws + WS_GATE);
    v.blk = reinterpret_cast<const uint16_t*>(ws + WS_BLK);
    return v;
}

// ============================================================
// double 参考（逐句实现 README §1.3；与 vLLM 语义一一对应）
// ============================================================
struct HcRef {
    std::vector<double> hc;     // [m, HYPER]
    std::vector<double> xn;     // [m, HYPER]
    std::vector<double> rstd;   // [m, HC]
    std::vector<double> lora;   // [m, DN_N]
    std::vector<double> ls;     // [m, LOWRANK]
    std::vector<double> gate;   // [m, UP_N]
    std::vector<double> blk;    // [m, HID]
    std::vector<double> injw;   // [m, HC]
    // T3 界用：各段逐元素的 Σ|terms|（docs/17 §1.1：界 = ε·Σ|terms| + 0.5·ulp(out)）
    std::vector<double> saHcp;   // h' 的 Σ|terms| = |h| + |bo·w|（相消区判据用）
    std::vector<double> saXn;
    std::vector<double> saLora;
    std::vector<double> saLs;
    std::vector<double> saGate;
    std::vector<double> saBlk;
};

// 前置声明（ReferenceNoMidRound 复用 Reference 的 W0/S3~S6 段）
static void Reference(uint32_t m, uint32_t mode, const uint16_t* hIn, const uint16_t* bo, const uint16_t* ij,
                      const uint16_t* wdown, const uint16_t* winj, const uint16_t* wup, const uint16_t* norm,
                      HcRef& r);

// 「不复刻 combine→RMSNorm 中间 bf16 舍入」的对照参考（只在 S1 与 S2 的交界处不同）
static void ReferenceNoMidRound(uint32_t m, uint32_t mode, const uint16_t* hIn, const uint16_t* bo, const uint16_t* ij,
                                const uint16_t* wdown, const uint16_t* winj, const uint16_t* wup,
                                const uint16_t* norm, HcRef& r)
{
    Reference(m, mode, hIn, bo, ij, wdown, winj, wup, norm, r);
    if (mode == MODE_MIX) {
        return;   // 无 combine 段
    }
    // 用「未舍入」的 H' 重算 S2，其余段（S1 输出、S3~S6）保持 Reference 的结果不变是不够严谨的，
    // 故此处只重算 S1→S2 两段，后续段沿用 Reference（判别性判据只比较 xn）。
    std::vector<double> hcRaw(static_cast<size_t>(m) * HYPER, 0.0);
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t d = 0; d < HYPER; ++d) {
            const double h = static_cast<double>(Bf16ToF32(hIn[static_cast<size_t>(mi) * HYPER + d]));
            const uint32_t s = d / HID;
            const uint32_t j = d % HID;
            const double b = static_cast<double>(Bf16ToF32(bo[static_cast<size_t>(mi) * HID + j]));
            hcRaw[static_cast<size_t>(mi) * HYPER + d] = h + b * r.injw[mi * HC + s];   // ← 不舍回 bf16
        }
    }
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t s = 0; s < HC; ++s) {
            const size_t base = static_cast<size_t>(mi) * HYPER + static_cast<size_t>(s) * HID;
            double ss = 0.0;
            for (uint32_t j = 0; j < HID; ++j) {
                const double x = hcRaw[base + j];
                ss += x * x;
            }
            const double rrms = 1.0 / std::sqrt(ss / static_cast<double>(HID) + static_cast<double>(EPS));
            for (uint32_t j = 0; j < HID; ++j) {
                const double w = static_cast<double>(Bf16ToF32(norm[static_cast<size_t>(s) * HID + j]));
                const double t = hcRaw[base + j] * rrms;
                r.xn[base + j] = RndBf16(t + t * w);
            }
        }
    }
}

static void Reference(uint32_t m, uint32_t mode, const uint16_t* hIn, const uint16_t* bo, const uint16_t* ij,
                      const uint16_t* wdown, const uint16_t* winj, const uint16_t* wup, const uint16_t* norm,
                      HcRef& r)
{
    const size_t mD = static_cast<size_t>(m) * HYPER;
    const size_t mH = static_cast<size_t>(m) * HID;
    r.hc.assign(mD, 0.0);
    r.xn.assign(mD, 0.0);
    r.rstd.assign(static_cast<size_t>(m) * HC, 0.0);
    r.lora.assign(static_cast<size_t>(m) * DN_N, 0.0);
    r.ls.assign(static_cast<size_t>(m) * LOWRANK, 0.0);
    r.gate.assign(static_cast<size_t>(m) * UP_N, 0.0);
    r.blk.assign(mH, 0.0);
    r.injw.assign(static_cast<size_t>(m) * HC, 0.0);
    r.saHcp.assign(mD, 0.0);
    r.saXn.assign(mD, 0.0);
    r.saLora.assign(static_cast<size_t>(m) * DN_N, 0.0);
    r.saLs.assign(static_cast<size_t>(m) * LOWRANK, 0.0);
    r.saGate.assign(static_cast<size_t>(m) * UP_N, 0.0);
    r.saBlk.assign(mH, 0.0);

    // ---- W0：injW = 2·sigmoid(IJ/HC) ----
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t s = 0; s < HC; ++s) {
            const double x = static_cast<double>(Bf16ToF32(ij[static_cast<size_t>(mi) * IJ_STRIDE + s]));
            r.injw[mi * HC + s] = 2.0 * SigmoidD(x / static_cast<double>(HC));
        }
    }
    // ---- S1：H' = bf16( H + BO·injW[s] )（mode 0 跳过 combine → H' = H）----
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t d = 0; d < HYPER; ++d) {
            const double h = static_cast<double>(Bf16ToF32(hIn[static_cast<size_t>(mi) * HYPER + d]));
            if (mode == MODE_MIX) {
                r.hc[static_cast<size_t>(mi) * HYPER + d] = h;
            } else {
                const uint32_t s = d / HID;
                const uint32_t j = d % HID;
                const double b = static_cast<double>(Bf16ToF32(bo[static_cast<size_t>(mi) * HID + j]));
                const double bw = b * r.injw[mi * HC + s];
                r.hc[static_cast<size_t>(mi) * HYPER + d] = RndBf16(h + bw);
                r.saHcp[static_cast<size_t>(mi) * HYPER + d] = std::fabs(h) + std::fabs(bw);
            }
        }
    }
    // ---- S2：per (token,stream) 分组 GemmaRMSNorm ----
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t s = 0; s < HC; ++s) {
            const size_t base = static_cast<size_t>(mi) * HYPER + static_cast<size_t>(s) * HID;
            double ss = 0.0;
            for (uint32_t j = 0; j < HID; ++j) {
                const double x = r.hc[base + j];
                ss += x * x;
            }
            const double var = ss / static_cast<double>(HID);
            const double rrms = 1.0 / std::sqrt(var + static_cast<double>(EPS));
            r.rstd[mi * HC + s] = rrms;
            for (uint32_t j = 0; j < HID; ++j) {
                // hc_norm 是 per-branch affine（宽 HYPER，按展平 d = s*HID + j 取）
                const double w = static_cast<double>(Bf16ToF32(norm[static_cast<size_t>(s) * HID + j]));
                const double t = r.hc[base + j] * rrms;
                const double y = t + t * w;
                r.xn[base + j] = RndBf16(y);
                // Σ|terms| 含一阶上游映射项：H' 的 ≤2 bf16 ulp 经 `x·rrms` 与 `rrms`（整组缩放）
                // 两条路径映射到 xn，量级 ≈ |xn| 本身
                r.saXn[base + j] = std::fabs(t) + std::fabs(t * w) + std::fabs(r.xn[base + j]);
            }
        }
    }
    // ---- S3：down+inject 合并 GEMM（[Wdown; Winj]，N = 324）----
    for (uint32_t mi = 0; mi < m; ++mi) {
        const size_t xBase = static_cast<size_t>(mi) * HYPER;
        for (uint32_t n = 0; n < DN_N; ++n) {
            double acc = 0.0;
            const bool isInj = (n >= LOWRANK);
            const size_t wRow = isInj ? static_cast<size_t>(n - LOWRANK) : static_cast<size_t>(n);
            const uint16_t* wsrc = isInj ? winj : wdown;
            for (uint32_t k = 0; k < DN_K; ++k) {
                acc += r.xn[xBase + k] * static_cast<double>(Bf16ToF32(wsrc[wRow * HYPER + k]));
            }
            r.lora[static_cast<size_t>(mi) * DN_N + n] = RndBf16(acc);
        }
    }
    // lora/inject 的 Σ|terms| 单列一遍（不改变上面的累加语义）
    for (uint32_t mi = 0; mi < m; ++mi) {
        const size_t xBase = static_cast<size_t>(mi) * HYPER;
        for (uint32_t n = 0; n < DN_N; ++n) {
            const bool isInj = (n >= LOWRANK);
            const size_t wRow = isInj ? static_cast<size_t>(n - LOWRANK) : static_cast<size_t>(n);
            const uint16_t* wsrc = isInj ? winj : wdown;
            double sa = 0.0;
            for (uint32_t k = 0; k < DN_K; ++k) {
                sa += std::fabs(r.xn[xBase + k]) * std::fabs(static_cast<double>(Bf16ToF32(wsrc[wRow * HYPER + k])));
            }
            r.saLora[static_cast<size_t>(mi) * DN_N + n] = sa;
        }
    }
    // ---- S4：silu(lora/HC)（u = lora/HC 为 2 的幂次乘，fp32 精确）----
    double uScale = 0.0;
    for (double x : r.lora) {
        const double u = std::fabs(x) / static_cast<double>(HC);
        if (u > uScale) {
            uScale = u;
        }
    }
    double gScale = 0.0;
    for (double x : r.ls) {
        (void)x;
    }
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t rr = 0; rr < LOWRANK; ++rr) {
            const double u = r.lora[static_cast<size_t>(mi) * DN_N + rr] / static_cast<double>(HC);
            const double y = u * SigmoidD(u);
            r.ls[static_cast<size_t>(mi) * LOWRANK + rr] = RndBf16(y);
            // 上游 lora 的 ≤1 bf16 ulp 经 silu 的导数传播：|d(uσ)/du| · scale(u)
            {
                const double sg = SigmoidD(u);
                const double dyd = sg * (1.0 + u * (1.0 - sg));
                r.saLs[static_cast<size_t>(mi) * LOWRANK + rr] = std::fabs(dyd) * uScale;
            }
        }
    }
    // ---- S5：up GEMM（gate = LS · Wup^T）----
    for (uint32_t mi = 0; mi < m; ++mi) {
        const size_t lBase = static_cast<size_t>(mi) * LOWRANK;
        for (uint32_t n = 0; n < UP_N; ++n) {
            double acc = 0.0;
            for (uint32_t k = 0; k < UP_K; ++k) {
                acc += r.ls[lBase + k] * static_cast<double>(Bf16ToF32(wup[static_cast<size_t>(n) * UP_K + k]));
            }
            r.gate[static_cast<size_t>(mi) * UP_N + n] = RndBf16(acc);
        }
    }
    for (uint32_t mi = 0; mi < m; ++mi) {
        const size_t lBase = static_cast<size_t>(mi) * LOWRANK;
        for (uint32_t n = 0; n < UP_N; ++n) {
            double sa = 0.0;
            for (uint32_t k = 0; k < UP_K; ++k) {
                sa += std::fabs(r.ls[lBase + k]) * std::fabs(static_cast<double>(Bf16ToF32(wup[static_cast<size_t>(n) * UP_K + k])));
            }
            r.saGate[static_cast<size_t>(mi) * UP_N + n] = sa;
        }
    }
    // ---- S6：gate mix（Σ_s sigmoid(g_s)·xn_s，最后统一 /HC）----
    double gSc = 0.0;
    for (double x : r.gate) {
        const double a = std::fabs(x);
        if (a > gSc) {
            gSc = a;
        }
    }
    double xSc = 0.0;
    for (double x : r.xn) {
        const double a = std::fabs(x);
        if (a > xSc) {
            xSc = a;
        }
    }
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t j = 0; j < HID; ++j) {
            double acc = 0.0;
            for (uint32_t s = 0; s < HC; ++s) {
                const double g = r.gate[static_cast<size_t>(mi) * UP_N + static_cast<size_t>(s) * HID + j];
                const double x = r.xn[static_cast<size_t>(mi) * HYPER + static_cast<size_t>(s) * HID + j];
                acc += SigmoidD(g) * x;
            }
            r.blk[static_cast<size_t>(mi) * HID + j] = RndBf16(acc / static_cast<double>(HC));
            // Σ|terms| 含：4 项绝对值 + 上游 gate/xn 各 ≤1 bf16 ulp 经偏导的传播
            {
                double sa = 0.0;
                for (uint32_t s2 = 0; s2 < HC; ++s2) {
                    const double gv = r.gate[static_cast<size_t>(mi) * UP_N + static_cast<size_t>(s2) * HID + j];
                    const double xv = r.xn[static_cast<size_t>(mi) * HYPER + static_cast<size_t>(s2) * HID + j];
                    const double sg = SigmoidD(gv);
                    sa += (std::fabs(sg * xv) + std::fabs(sg * (1.0 - sg)) * gSc * std::fabs(xv) +
                           std::fabs(sg) * xSc) /
                          static_cast<double>(HC);
                }
                r.saBlk[static_cast<size_t>(mi) * HID + j] = sa;
            }
        }
    }
}

// ============================================================
// Host 输入装载 / 判据执行 / dump
// ============================================================

struct CaseSpec {
    const char* name;
    uint32_t kind;    // GenKind
    uint32_t m;
    uint32_t mode;    // MODE_*
    bool strictHcp;   // true = H' 必须逐位一致（GEN_EXACT0 档可证明）
    bool zeroWCheck;  // true = lora/inject 必须逐位为 0
};

struct CaseInputs {
    std::vector<uint16_t> hIn;
    std::vector<uint16_t> bo;
    std::vector<uint16_t> ij;
    std::vector<uint16_t> wDown;
    std::vector<uint16_t> wInj;   // 16 行（前 INJ_N 行有效，其余 0）
    std::vector<uint16_t> wUp;
    std::vector<uint16_t> norm;
};

static void BuildInputs(const CaseSpec& cs, CaseInputs& in)
{
    const uint32_t kind = cs.kind;
    TensorGen gH{11u, 2.0, false};
    TensorGen gBO{23u, 2.0, false};
    TensorGen gIJ{31u, 4.0, (kind == GEN_EXACT0)};
    TensorGen gWD{41u, 0.051, (kind == GEN_ZEROW)};
    TensorGen gWI{53u, 0.019, (kind == GEN_ZEROW)};
    TensorGen gWU{67u, 0.116, (kind == GEN_ZEROW)};
    TensorGen gN{79u, 0.0, false};

    in.hIn.assign(static_cast<size_t>(M_MAX) * HYPER, 0);
    for (uint32_t mi = 0; mi < M_MAX; ++mi) {
        for (uint32_t d = 0; d < HYPER; ++d) {
            in.hIn[static_cast<size_t>(mi) * HYPER + d] = F32ToBf16(static_cast<float>(GenVal(gH, kind, mi, d)));
        }
    }
    in.bo.assign(static_cast<size_t>(M_MAX) * HID, 0);
    for (uint32_t mi = 0; mi < M_MAX; ++mi) {
        for (uint32_t j = 0; j < HID; ++j) {
            in.bo[static_cast<size_t>(mi) * HID + j] = F32ToBf16(static_cast<float>(GenVal(gBO, kind, mi, j)));
        }
    }
    in.ij.assign(static_cast<size_t>(M_MAX) * IJ_STRIDE, 0);
    for (uint32_t mi = 0; mi < M_MAX; ++mi) {
        for (uint32_t c = 0; c < HC; ++c) {
            in.ij[static_cast<size_t>(mi) * IJ_STRIDE + c] = F32ToBf16(static_cast<float>(GenVal(gIJ, kind, mi, c)));
        }
    }
    in.wDown.assign(static_cast<size_t>(LOWRANK) * HYPER, 0);
    for (uint32_t r = 0; r < LOWRANK; ++r) {
        for (uint32_t k = 0; k < HYPER; ++k) {
            in.wDown[static_cast<size_t>(r) * HYPER + k] = F32ToBf16(static_cast<float>(GenVal(gWD, kind, r, k)));
        }
    }
    // WInj 物理 16 行（checkpoint 只有 INJ_N 行；行 [INJ_N,16) 置 0 → L0C 余列恰好为 0）
    in.wInj.assign(static_cast<size_t>(16) * HYPER, 0);
    for (uint32_t r = 0; r < INJ_N; ++r) {
        for (uint32_t k = 0; k < HYPER; ++k) {
            in.wInj[static_cast<size_t>(r) * HYPER + k] = F32ToBf16(static_cast<float>(GenVal(gWI, kind, r, k)));
        }
    }
    in.wUp.assign(static_cast<size_t>(UP_N) * UP_K, 0);
    for (uint32_t n = 0; n < UP_N; ++n) {
        for (uint32_t k = 0; k < UP_K; ++k) {
            in.wUp[static_cast<size_t>(n) * UP_K + k] = F32ToBf16(static_cast<float>(GenVal(gWU, kind, n, k)));
        }
    }
    in.norm.assign(HYPER, 0);
    for (uint32_t j = 0; j < HYPER; ++j) {
        in.norm[j] = F32ToBf16(static_cast<float>(GenNormVal(gN, kind, j)));
    }
}

// ---- 非空洞性（参考侧）：逐个输入张量加扰动，最终 blk 必须显著变化 ----
static bool NonVacuityReference(const CaseSpec& cs, const CaseInputs& in)
{
    HcRef base;
    Reference(cs.m, cs.mode, in.hIn.data(), in.bo.data(), in.ij.data(), in.wDown.data(), in.wInj.data(),
              in.wUp.data(), in.norm.data(), base);

    struct Probe {
        const char* name;
        int which;
    };
    const Probe probes[] = {{"hc_norm", 0}, {"wDown", 1}, {"wUp", 2}, {"wInj", 3}, {"BO", 4}, {"IJ", 5}};
    bool ok = true;
    printf("[M20]   -- 参考侧非空洞性（单输入整张量 ×1.5 → 任一输出最大绝对变化）--\n");
    for (const Probe& pr : probes) {
        CaseInputs p = in;
        auto bump = [](std::vector<uint16_t>& v, size_t idx, double f) {
            const double x = static_cast<double>(Bf16ToF32(v[idx]));
            v[idx] = F32ToBf16(static_cast<float>(x * f));
        };
        std::vector<uint16_t>* target = nullptr;
        switch (pr.which) {
            case 0: target = &p.norm; break;
            case 1: target = &p.wDown; break;
            case 2: target = &p.wUp; break;
            case 3: target = &p.wInj; break;
            case 4: target = &p.bo; break;
            default: target = &p.ij; break;
        }
        for (size_t k = 0; k < target->size(); ++k) {   // 整张量 ×1.5（单元素扰动经 10240 维点积后不可辨）
            bump(*target, k, 1.5);
        }
        HcRef alt;
        Reference(cs.m, cs.mode, p.hIn.data(), p.bo.data(), p.ij.data(), p.wDown.data(), p.wInj.data(),
                  p.wUp.data(), p.norm.data(), alt);
        double maxd = 0.0;
        auto scan = [&maxd](const std::vector<double>& a, const std::vector<double>& b) {
            for (size_t k = 0; k < a.size(); ++k) {
                const double d = std::fabs(a[k] - b[k]);
                if (d > maxd) {
                    maxd = d;
                }
            }
        };
        scan(base.hc, alt.hc);
        scan(base.xn, alt.xn);
        scan(base.lora, alt.lora);
        scan(base.ls, alt.ls);
        scan(base.gate, alt.gate);
        scan(base.blk, alt.blk);
        const bool sens = maxd > 1e-3;
        CountGuard(sens);
        if (!sens) {
            ok = false;
        }
        printf("[M20]     %-8s Δout(maxAbs over all outputs)=%.6e  %s\n", pr.name, maxd,
               sens ? "sensitive" : "INSENSITIVE");
    }
    return ok;
}

static void AppendOhLora(const HcRef& r, uint32_t m, std::vector<double>& out)
{
    out.resize(static_cast<size_t>(m) * LOWRANK);
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t c = 0; c < LOWRANK; ++c) {
            out[static_cast<size_t>(mi) * LOWRANK + c] = r.lora[static_cast<size_t>(mi) * DN_N + c];
        }
    }
}

static void AppendOhInj(const HcRef& r, uint32_t m, std::vector<double>& out)
{
    out.resize(static_cast<size_t>(m) * INJ_N);
    for (uint32_t mi = 0; mi < m; ++mi) {
        for (uint32_t c = 0; c < INJ_N; ++c) {
            out[static_cast<size_t>(mi) * INJ_N + c] = r.lora[static_cast<size_t>(mi) * DN_N + LOWRANK + c];
        }
    }
}

// 张量「非空洞」检查：参考若非常量，Device 输出也必须非常量（解析常量张量不算退化）
static bool NonVacuousTensor(const char* name, const uint16_t* p, const double* exp, size_t n)
{
    bool devDiff = false;
    uint16_t first = p[0];
    for (size_t k = 1; k < n; ++k) {
        if (p[k] != first) {
            devDiff = true;
            break;
        }
    }
    const uint16_t e0 = F32ToBf16(static_cast<float>(exp[0]));
    bool refDiff = false;
    for (size_t k = 1; k < n; ++k) {
        if (F32ToBf16(static_cast<float>(exp[k])) != e0) {
            refDiff = true;
            break;
        }
    }
    const bool ok = devDiff || (!refDiff);
    CountGuard(ok);
    printf("[M20]   guard   %-10s dev=%s ref=%s  %s\n", name, devDiff ? "non-const" : "CONST",
           refDiff ? "non-const" : "const", ok ? "OK" : "DEGENERATE(设备常量而参考非常量)");
    return ok;
}

// 设备侧 blk 指纹（RunCase 内更新，main 做跨 case 判别力检查）
static uint64_t gBlkHash = 0;
static bool gMidRoundDiscr = false;   // 至少一个 case 上「中间 bf16 舍入」的判别性成立

static uint32_t m_of(const CaseSpec& cs) { return cs.m; }

// ============================================================
// 单 case 执行
// ============================================================
static bool RunCase(aclrtStream stream, const CaseSpec& cs, uint32_t stageLimit, bool dump, uint32_t aicNum)
{
    const uint32_t m = cs.m;
    CaseInputs in;
    BuildInputs(cs, in);

    const size_t bH = in.hIn.size() * 2;
    const size_t bBO = in.bo.size() * 2;
    const size_t bIJ = in.ij.size() * 2;
    const size_t bWD = in.wDown.size() * 2;
    const size_t bWI = in.wInj.size() * 2;
    const size_t bWU = in.wUp.size() * 2;
    const size_t bN = in.norm.size() * 2;

    uint8_t *dH = nullptr, *dBO = nullptr, *dIJ = nullptr, *dWD = nullptr, *dWI = nullptr, *dWU = nullptr,
                   *dN = nullptr, *dWS = nullptr;
    auto cleanUp = [&]() {
        if (dH) aclrtFree(dH);
        if (dBO) aclrtFree(dBO);
        if (dIJ) aclrtFree(dIJ);
        if (dWD) aclrtFree(dWD);
        if (dWI) aclrtFree(dWI);
        if (dWU) aclrtFree(dWU);
        if (dN) aclrtFree(dN);
        if (dWS) aclrtFree(dWS);
    };
    if (aclrtMalloc(reinterpret_cast<void**>(&dH), bH, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dBO), bBO, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dIJ), bIJ, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dWD), bWD, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dWI), bWI, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dWU), bWU, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dN), bN, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS ||
        aclrtMalloc(reinterpret_cast<void**>(&dWS), WS_BYTES + 64, ACL_MEM_MALLOC_HUGE_FIRST) != ACL_SUCCESS) {
        printf("[M20][FAIL] aclrtMalloc failed\n");
        cleanUp();
        return false;
    }
    aclrtMemcpy(dH, bH, in.hIn.data(), bH, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dBO, bBO, in.bo.data(), bBO, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dIJ, bIJ, in.ij.data(), bIJ, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dWD, bWD, in.wDown.data(), bWD, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dWI, bWI, in.wInj.data(), bWI, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dWU, bWU, in.wUp.data(), bWU, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(dN, bN, in.norm.data(), bN, ACL_MEMCPY_HOST_TO_DEVICE);
    {
        std::vector<uint8_t> zeroWs(WS_BYTES + 64, 0);   // workspace 清零：保证 mode 0 不比较区不出现旧值
        aclrtMemcpy(dWS, zeroWs.size(), zeroWs.data(), zeroWs.size(), ACL_MEMCPY_HOST_TO_DEVICE);
    }

    printf("[M20] === case %s : kind=%u m=%u mode=%u stageLimit=%u aicNum=%u ===\n", cs.name, cs.kind, m, cs.mode,
           stageLimit, aicNum);
    m20_hyperconn_kernel<<<aicNum, 0, stream>>>(dH, dBO, dIJ, dWD, dWI, dWU, dN, dWS, m, cs.mode, stageLimit);
    const aclError lerr = aclrtSynchronizeStream(stream);
    if (lerr != ACL_SUCCESS) {
        printf("[M20][FAIL] kernel launch/sync error %d\n", static_cast<int>(lerr));
        cleanUp();
        return false;
    }

    std::vector<uint8_t> wsHost(WS_BYTES + 64);
    aclrtMemcpy(wsHost.data(), wsHost.size(), dWS, wsHost.size(), ACL_MEMCPY_DEVICE_TO_HOST);
    const HcView v = MakeView(wsHost.data());

    // ---- double 参考 ----
    HcRef ref;
    dbgLeft = 8;
    Reference(m, cs.mode, in.hIn.data(), in.bo.data(), in.ij.data(), in.wDown.data(), in.wInj.data(),
              in.wUp.data(), in.norm.data(), ref);

    // ---- 判据 ----
    bool allOk = true;
    Judge jInjw;
    jInjw.name = "Injw";
    double maxInjwRel = 0.0;
    for (uint32_t mi = 0; mi < (cs.mode == MODE_MIX ? 0u : m); ++mi) {
        for (uint32_t s = 0; s < HC; ++s) {
            const double g = static_cast<double>(v.injw[(mi * HC + s) * INJW_SLOT]);
            const double e = ref.injw[mi * HC + s];
            const double rel = std::fabs(g - e) / (std::fabs(e) > 1e-30 ? std::fabs(e) : 1e-30);
            if (rel > maxInjwRel) {
                maxInjwRel = rel;
            }
        }
    }
    (void)jInjw;
    if (cs.mode == MODE_MIX) {
        printf("[M20]   injw (fp32) 该档无 W0 段（mode 0 跳过 combine）→ 不判定\n");
    } else {
        printf("[M20]   injw (fp32) maxRel=%.3e  %s\n", maxInjwRel, maxInjwRel <= 1e-6 ? "PASS" : "FAIL");
        CountGuard(maxInjwRel <= 1e-6);   // guard：injW 是中间量（fp32），容差用于确认无结构性错误
        if (maxInjwRel > 1e-6) {
            allOk = false;
        }
    }

    Judge jHcp;
    jHcp.name = "h'";
    Judge jXn;
    jXn.name = "xn";
    Judge jLs;
    jLs.name = "ls";
    Judge jGate;
    jGate.name = "gate";
    Judge jBlk;
    jBlk.name = "blk";
    Judge jLora;
    jLora.name = "lora";
    Judge jInjOut;
    jInjOut.name = "inject";

    if (cs.mode != MODE_MIX) {
        JudgeBuf(jHcp, v.hcp, ref.hc.data(), static_cast<size_t>(m) * HYPER);
        JudgeReport(jHcp);
        // h' 归 **T3**（不是 T2′）：`h + BO·injW` 两个量级相当的项相消，结果可远小于 Σ|terms|
        //   ⇒ ulp 判据在相消区不可达（实测 real_m33 有 1 个元素 |out|≈3.1e-6 而 Σ|terms|≈4，
        //     4 bf16 ulp 差异全部来自 fp32 的两次舍入，与 double 参考无关）。
        //   界：ε_acc = 2 次 fp32 舍入（2·2^-24）+ injW 的 fp32-vs-double 相对不确定度（≤1.04e-7）。
        //   ε 的实测口径见 README §7.4；纯加乘段的 100% 逐位判据在 GEN_EXACT0 档另出（T1）。
        JudgeT3("h'", v.hcp, ref.hc.data(), ref.saHcp.data(), static_cast<size_t>(m) * HYPER,
                2.0 * 0x1p-24 + 1.04e-7, allOk);
        if (cs.strictHcp) {
            // docs/17 T1：GEN_EXACT0 档下 IJ≡0 ⇒ injW = 2·sigmoid(0) = 1.0 精确，
            // H/BO 为小整数 ⇒ bf16(fp32(H+BO)) 与 double 同值 ⇒ 可证明逐位
            const bool t1 = (jHcp.exact == jHcp.total);
            CountJudge(t1);
            printf("[M20]   T1 JUDGE %-8s 逐位一致=%u/%u  %s\n", "h'(exact0)", jHcp.exact, jHcp.total,
                   t1 ? "PASS" : "FAIL");
            if (!t1) {
                allOk = false;
            }
        }
    }
    JudgeBuf(jXn, v.xn, ref.xn.data(), static_cast<size_t>(m) * HYPER);
    JudgeReport(jXn);
    // T3：ε = 上游 H' 的 ≤2 bf16 ulp 传播（2·2^-8）+ NR-rsqrt 相对误差（1e-7）+ 2 次 fp32 舍入（2·2^-24）
    JudgeT3("xn", v.xn, ref.xn.data(), ref.saXn.data(), static_cast<size_t>(m) * HYPER,
            2.0 * 0x1p-8 + 1.0e-7 + 2.0 * 0x1p-24, allOk);

    double maxRstdRel = 0.0;
    for (uint32_t k = 0; k < m * HC; ++k) {
        const double rel = std::fabs(static_cast<double>(v.rstd[k]) - ref.rstd[k]) / ref.rstd[k];
        if (rel > maxRstdRel) {
            maxRstdRel = rel;
        }
    }
    // rstd 是逐元素缩放因子（fp32）：NR-rsqrt 与 double 1/sqrt 的差异 + 参考用 double 累加方差，
    // 实测 maxRel ≤ 2.3e-5（远低于 bf16 网格 3.9e-3）。
    printf("[M20]   %-10s (fp32) maxRel=%.3e  %s\n", "rstd", maxRstdRel, maxRstdRel <= 1e-4 ? "PASS" : "FAIL");
    CountGuard(maxRstdRel <= 1e-4);   // guard：rstd 是中间量（fp32）
    if (maxRstdRel > 1e-4) {
        allOk = false;
    }

    std::vector<double> expLora, expInj;
    AppendOhLora(ref, m, expLora);
    AppendOhInj(ref, m, expInj);
    {
        std::vector<uint16_t> got(static_cast<size_t>(m) * LOWRANK);
        for (uint32_t mi = 0; mi < m; ++mi) {
            for (uint32_t c = 0; c < LOWRANK; ++c) {
                got[static_cast<size_t>(mi) * LOWRANK + c] = v.oh[static_cast<size_t>(mi) * OH_W + OH_LORA + c];
            }
        }
        JudgeBuf(jLora, got.data(), expLora.data(), got.size());
        JudgeReport(jLora);
        {   // T3：mmad 累加（K/8 次 fp32 舍入）+ 上游 xn 的 ≤2 bf16 ulp 传播
            std::vector<double> sa(static_cast<size_t>(m) * LOWRANK);
            for (uint32_t mi = 0; mi < m; ++mi) {
                for (uint32_t c = 0; c < LOWRANK; ++c) {
                    sa[static_cast<size_t>(mi) * LOWRANK + c] = ref.saLora[static_cast<size_t>(mi) * DN_N + c];
                }
            }
            JudgeT3("lora", got.data(), expLora.data(), sa.data(), got.size(),
                    (static_cast<double>(DN_K) / 8.0) * 0x1p-24 + 2.0 * 0x1p-8, allOk);
        }
        if (cs.zeroWCheck) {
            bool z = true;
            for (uint16_t x : got) {
                if (x != 0) { z = false; break; }
            }
            printf("[M20]   T1 JUDGE %-8s 逐位为 0：%s\n", "lora≡0", z ? "PASS" : "FAIL");
            CountJudge(z);
            allOk = allOk && z;
        }
    }
    if (cs.mode != MODE_FINAL_MIX) {
        std::vector<uint16_t> got(static_cast<size_t>(m) * INJ_N);
        for (uint32_t mi = 0; mi < m; ++mi) {
            for (uint32_t c = 0; c < INJ_N; ++c) {
                got[static_cast<size_t>(mi) * INJ_N + c] = v.oh[static_cast<size_t>(mi) * OH_W + OH_INJ + c];
            }
        }
        JudgeBuf(jInjOut, got.data(), expInj.data(), got.size());
        JudgeReport(jInjOut);
        {
            std::vector<double> sa(static_cast<size_t>(m) * INJ_N);
            for (uint32_t mi = 0; mi < m; ++mi) {
                for (uint32_t c = 0; c < INJ_N; ++c) {
                    sa[static_cast<size_t>(mi) * INJ_N + c] = ref.saLora[static_cast<size_t>(mi) * DN_N + LOWRANK + c];
                }
            }
            JudgeT3("inject", got.data(), expInj.data(), sa.data(), got.size(),
                    (static_cast<double>(DN_K) / 8.0) * 0x1p-24 + 2.0 * 0x1p-8, allOk);
        }
        if (cs.zeroWCheck) {
            bool z = true;
            for (uint16_t x : got) {
                if (x != 0) { z = false; break; }
            }
            printf("[M20]   T1 JUDGE %-8s 逐位为 0：%s\n", "inject≡0", z ? "PASS" : "FAIL");
            CountJudge(z);
            allOk = allOk && z;
        }
    }
    JudgeBuf(jLs, v.ls, ref.ls.data(), static_cast<size_t>(m) * LOWRANK);
    JudgeReport(jLs);
    // T3：VF Exp 精度（m24 实测 ≤1.6 ulp → 1.6·2^-24）+ 上游 lora 的 ≤2 bf16 ulp 传播 + 4 次 fp32 舍入
    JudgeT3("ls", v.ls, ref.ls.data(), ref.saLs.data(), static_cast<size_t>(m) * LOWRANK,
            6.0 * 0x1p-24 + 1.0 * 0x1p-8, allOk);
    JudgeBuf(jGate, v.gate, ref.gate.data(), static_cast<size_t>(m) * UP_N);
    JudgeReport(jGate);
    JudgeT3("gate", v.gate, ref.gate.data(), ref.saGate.data(), static_cast<size_t>(m) * UP_N,
            (static_cast<double>(UP_K) / 8.0) * 0x1p-24 + 2.0 * 0x1p-8, allOk);
    JudgeBuf(jBlk, v.blk, ref.blk.data(), static_cast<size_t>(m) * HID);
    JudgeReport(jBlk);
    // T3：4 路 VF Exp（4×1.6·2^-24）+ 上游 gate 与 xn 各 ≤2 bf16 ulp 传播 + 5 次 fp32 舍入
    // ε：4 路 VF Exp（4×1.6·2^-24）+ 4 项累加 + 除法 8 次 fp32 舍入（12·2^-24）
    //    + 上游 gate 与 xn 各 **≤2** bf16 ulp 经偏导传播（2·2^-8，与 gate/xn 行同档，实测二者 maxUlp=2）
    JudgeT3("blk", v.blk, ref.blk.data(), ref.saBlk.data(), static_cast<size_t>(m) * HID,
            12.0 * 0x1p-24 + 2.0 * 0x1p-8, allOk);


    // ---- (A) combine→RMSNorm 之间的 bf16 舍入必须复刻：判别性判据 ----
    // docs/14 §3.2 / tower M36 硬约束：hc_combine_norm 在 combine 结果与组内 RMSNorm 之间插了一次
    // bf16 舍入（V-N:ops/hc.py:325-327）。这里同时算「复刻舍入」与「不复制舍入」两条参考：
    //   ① 两条参考必须有实质性差异（否则判据是空洞的）；
    //   ② 设备必须只与「复刻舍入」那条一致。
    if (cs.mode != MODE_MIX) {
        HcRef refNo;
        ReferenceNoMidRound(m, cs.mode, in.hIn.data(), in.bo.data(), in.ij.data(), in.wDown.data(),
                            in.wInj.data(), in.wUp.data(), in.norm.data(), refNo);
        size_t ndiff = 0;
        for (size_t k = 0; k < static_cast<size_t>(m) * HYPER; ++k) {
            if (F32ToBf16(static_cast<float>(ref.xn[k])) != F32ToBf16(static_cast<float>(refNo.xn[k]))) {
                ++ndiff;
            }
        }
        // 设备与两条参考的 ulp 距离（良态元素）
        auto ulpVec = [m](const HcView& vw, const std::vector<double>& e) {
            std::vector<int32_t> d(static_cast<size_t>(m) * HYPER, 0);
            for (size_t k = 0; k < d.size(); ++k) {
                d[k] = Bf16Key(vw.xn[k]) - Bf16Key(F32ToBf16(static_cast<float>(e[k])));
            }
            return d;
        };
        const std::vector<int32_t> dWith = ulpVec(v, ref.xn);
        const std::vector<int32_t> dNo = ulpVec(v, refNo.xn);
        int32_t maxWith = 0, maxNo = 0;
        size_t closerToWith = 0, closerToNo = 0;
        for (size_t k = 0; k < dWith.size(); ++k) {
            const int32_t a = dWith[k] < 0 ? -dWith[k] : dWith[k];
            const int32_t b = dNo[k] < 0 ? -dNo[k] : dNo[k];
            if (a > maxWith) maxWith = a;
            if (b > maxNo) maxNo = b;
            if (F32ToBf16(static_cast<float>(ref.xn[k])) != F32ToBf16(static_cast<float>(refNo.xn[k]))) {
                if (a < b) ++closerToWith;
                else if (b < a) ++closerToNo;
            }
        }
        printf("[M20]   (A) 中间舍入判别：两条参考差异元素 %zu/%zu；设备 vs 复刻舍入 maxUlp=%d，"
               "vs 不复刻 maxUlp=%d；差异元素上更贴近复刻/不复刻 = %zu/%zu\n",
               ndiff, static_cast<size_t>(m) * HYPER, maxWith, maxNo, closerToWith, closerToNo);
        // 判据：① 两条参考的差异必须实质性（≥5% 元素，否则判据空洞）；
        //      ② 设备与「复刻舍入」参考的最大 ulp ≤2；
        //      ③ 在两条参考不同的元素上，设备必须 ≥99% 站「复刻舍入」这一侧。
        // （实测 closerToNo=1/2740=0.036%：该元素处两条参考差 ≥3 bf16 网格，设备落在两者之间的
        //  舍入边界上——单独看它不构成「设备没复刻舍入」的证据，判据用比例而非零容忍。）
        const double diffFrac = static_cast<double>(ndiff) / static_cast<double>(dWith.size());
        const double winFrac = ndiff ? static_cast<double>(closerToWith) / static_cast<double>(ndiff) : 0.0;
        if (ndiff == 0) {
            printf("[M20]       两条参考在本档无差异（整数数据下中间舍入常不改变取值）→ 本档不适用（跳过）\n");
        } else {
            const bool discr = (diffFrac >= 0.05) && (winFrac >= 0.99);
            CountJudge(discr);   // 判定项（docs/14 §3.2 / tower 硬约束的判别性判据）
            printf("[M20]       差异占比=%.4f 站复刻侧比例=%.4f  判别性：%s\n", diffFrac, winFrac,
                   discr ? "PASS" : "FAIL");
            if (discr) {
                gMidRoundDiscr = true;
            } else {
                allOk = false;
            }
        }
    }

    // ---- 设备侧 blk 指纹（跨 case 判别力，main 里两两比对）----
    {
        uint64_t hsh = 1469598103934665603ull;
        for (size_t k = 0; k < static_cast<size_t>(m) * HID; ++k) {
            hsh = (hsh ^ v.blk[k]) * 1099511628211ull;
        }
        gBlkHash = hsh;
    }

    // ---- 设备侧非空洞性 ----
    printf("[M20]   -- 设备侧非空洞性 --\n");
    allOk = allOk && NonVacuousTensor("xn", v.xn, ref.xn.data(), static_cast<size_t>(m) * HYPER);
    allOk = allOk && NonVacuousTensor("gate", v.gate, ref.gate.data(), static_cast<size_t>(m) * UP_N);
    allOk = allOk && NonVacuousTensor("blk", v.blk, ref.blk.data(), static_cast<size_t>(m) * HID);
    if (cs.mode != MODE_MIX) {
        allOk = allOk && NonVacuousTensor("h'", v.hcp, ref.hc.data(), static_cast<size_t>(m) * HYPER);
    }

    // ---- dump（check_ref.py 用）----
    if (dump) {
        char path[256];
        const char* nm = cs.name;
        auto wb = [&](const char* suffix, const void* buf, size_t n, const char* shape, const char* dtype) {
            snprintf(path, sizeof(path), "m20_%s_%s.bin", nm, suffix);
            const bool ok = WriteBin(path, buf, n);
            snprintf(path, sizeof(path), "m20_%s_%s.bin.meta", nm, suffix);
            WriteMeta(path, suffix, shape, dtype);
            printf("[M20] dump %s%s -> %s\n", nm, suffix, ok ? "ok" : "write failed");
        };
        char sh[128];
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, HYPER);
        wb("hin", in.hIn.data(), bH, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, HID);
        wb("bo", in.bo.data(), bBO, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, IJ_STRIDE);
        wb("ij", in.ij.data(), bIJ, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", LOWRANK, HYPER);
        wb("wdown", in.wDown.data(), bWD, sh, "bf16");
        snprintf(sh, sizeof(sh), "16 %u", HYPER);
        wb("winj", in.wInj.data(), bWI, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", UP_N, UP_K);
        wb("wup", in.wUp.data(), bWU, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u", HYPER);
        wb("hc_norm", in.norm.data(), bN, sh, "bf16");

        snprintf(sh, sizeof(sh), "%u %u", M_MAX, HYPER);
        wb("hcp", v.hcp, static_cast<size_t>(M_MAX) * HYPER * 2, sh, "bf16");
        wb("xn", v.xn, static_cast<size_t>(M_MAX) * HYPER * 2, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, HC);
        wb("rstd", v.rstd, static_cast<size_t>(M_MAX) * HC * 4, sh, "fp32");
        snprintf(sh, sizeof(sh), "%u %u %u", M_MAX, HC, INJW_SLOT);
        wb("injw", v.injw, static_cast<size_t>(M_MAX) * HC * INJW_SLOT * 4, sh, "fp32");
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, OH_W);
        wb("oh", v.oh, static_cast<size_t>(M_MAX) * OH_W * 2, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, LOWRANK);
        wb("ls", v.ls, static_cast<size_t>(M_MAX) * LOWRANK * 2, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, UP_N);
        wb("gate", v.gate, static_cast<size_t>(M_MAX) * UP_N * 2, sh, "bf16");
        snprintf(sh, sizeof(sh), "%u %u", M_MAX, HID);
        wb("blk", v.blk, static_cast<size_t>(M_MAX) * HID * 2, sh, "bf16");

        FILE* fm = fopen("m20_case.txt", "w");
        if (fm != nullptr) {
            fprintf(fm, "name %s\nkind %u\nm %u\nmode %u\nstage_limit %u\n", cs.name, cs.kind, m, cs.mode,
                    stageLimit);
            fclose(fm);
        }
    }

    cleanUp();
    return allOk;
}

int32_t main(int32_t argc, char* argv[])
{
    uint32_t stageLimit = 7;
    if (getenv("M20_STAGE_LIMIT") != nullptr) {
        stageLimit = static_cast<uint32_t>(atoi(getenv("M20_STAGE_LIMIT")));
    }
    const bool dump = (getenv("M20_DUMP") != nullptr);

    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[M20][FAIL] aclInit failed\n");
        return 1;
    }
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        printf("[M20][FAIL] aclrtSetDevice failed\n");
        aclFinalize();
        return 1;
    }
    aclrtStream stream = nullptr;
    if (aclrtCreateStream(&stream) != ACL_SUCCESS) {
        printf("[M20][FAIL] aclrtCreateStream failed\n");
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }

    // 核数一律用 API 取，禁止硬编码
    int64_t aicNum = 0;
    int64_t aivNum = 0;
    const aclError aicErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    const aclError aivErr = aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum);
    if (aicErr != ACL_SUCCESS || aicNum <= 0) {
        printf("[M20][FAIL] 取 AIC 核数失败 err=%d aicNum=%lld\n", static_cast<int>(aicErr),
               static_cast<long long>(aicNum));
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }
    if (aivErr != ACL_SUCCESS || aivNum != 2 * aicNum) {
        printf("[M20][FAIL] AIV 核数与 AIC 不成 2:1 err=%d aivNum=%lld aicNum=%lld\n", static_cast<int>(aivErr),
               static_cast<long long>(aivNum), static_cast<long long>(aicNum));
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return 1;
    }
    printf("[M20] 核数（API 取得）：AIC=%lld AIV=%lld（mix(1,2) 启动 numBlocks=AIC 数）\n",
           static_cast<long long>(aicNum), static_cast<long long>(aivNum));
    printf("[M20] WS_BYTES=%u  UB_USED=%u  L1_USED=%u\n", WS_BYTES, UB_BYTES_USED,
           L1_B_REGION + 2 * L1_B_ELEMS * 2);

    const CaseSpec cases[] = {
        {"exact0", GEN_EXACT0, 1, MODE_COMBINE_MIX, true, false},
        {"exact0m33", GEN_EXACT0, 33, MODE_COMBINE_MIX, true, false},
        {"int", GEN_INT, 1, MODE_COMBINE_MIX, false, false},
        {"int_mix", GEN_INT, 1, MODE_MIX, false, false},
        {"int_final", GEN_INT, 1, MODE_FINAL_MIX, false, false},
        {"real_m1", GEN_REAL, 1, MODE_COMBINE_MIX, false, false},
        {"real_m2", GEN_REAL, 2, MODE_COMBINE_MIX, false, false},
        {"real_m33", GEN_REAL, 33, MODE_COMBINE_MIX, false, false},
        {"real_m64", GEN_REAL, 64, MODE_COMBINE_MIX, false, false},
        {"real_mix", GEN_REAL, 1, MODE_MIX, false, false},
        {"real_final", GEN_REAL, 1, MODE_FINAL_MIX, false, false},
        {"zerow", GEN_ZEROW, 1, MODE_COMBINE_MIX, false, true},
    };

    bool allOk = true;
    // 参考侧非空洞性：对 real_m1 单次探针（参考不依赖设备，只跑一次）
    {
        CaseInputs probeIn;
        const CaseSpec probeCs = {"real_m1", GEN_REAL, 1, MODE_COMBINE_MIX, false, false};
        BuildInputs(probeCs, probeIn);
        allOk = NonVacuityReference(probeCs, probeIn);
    }

    // M20_CASE=<前缀> 只跑匹配的 case（bring-up 定位用；不设则全跑）
    const char* caseFilter = getenv("M20_CASE");

    // 跨 case 判别力：设备 blk 指纹按 case 记录，既要求组内可区分（不同 m / 不同 mode / 零权重档），
    // 也要求与 ref 一致时不是「恒定输出」假装通过
    std::vector<std::pair<std::string, uint64_t>> blkHashes;
    std::vector<uint64_t> blkKey;   // (kind, m) 指纹：同组不同 mode 的 BLK 预期相同
    for (const CaseSpec& cs : cases) {
        if (caseFilter != nullptr && strcmp(cs.name, caseFilter) != 0) {
            continue;
        }
        gBlkHash = 0;
        const bool ok = RunCase(stream, cs, stageLimit, dump, static_cast<uint32_t>(aicNum));
        allOk = allOk && ok;
        blkHashes.emplace_back(cs.name, gBlkHash);
        blkKey.push_back(static_cast<uint64_t>(cs.kind) * 1000u + m_of(cs));
    }
    // 注意：mode 1 与 mode 2 在同一 (kind, m) 下的 BLK **本就应完全相同**——use_combine=false
    // 只是不产出 injection logits，而 injection 在本 op 内不参与下游计算（延迟到下一层 combine），
    // 因此判别力检查只在「(kind, m) 不同」的 case 之间做。
    bool discOk = true;
    for (size_t i = 0; i < blkHashes.size(); ++i) {
        for (size_t j = i + 1; j < blkHashes.size(); ++j) {
            if (blkKey[i] == blkKey[j]) {
                continue;   // 同 (kind, m) 不同 mode：BLK 相同是正确行为
            }
            if (blkHashes[i].second == blkHashes[j].second) {
                printf("[M20][FAIL] 判别力不足：case %s 与 %s 的设备 blk 指纹相同（0x%016llx）\n",
                       blkHashes[i].first.c_str(), blkHashes[j].first.c_str(),
                       (unsigned long long)blkHashes[i].second);
                allOk = false;
                discOk = false;
            }
        }
    }
    CountGuard(discOk);
    printf("[M20] 跨 case 判别力：%zu 个 case（不同 (kind,m) 组间）设备 blk 指纹两两互异 → %s\n",
           blkHashes.size(), discOk ? "OK" : "FAIL");

    printf("[M20] 中间 bf16 舍入判别（docs/14 §3.2 / tower 硬约束）：%s\n",
           gMidRoundDiscr ? "至少一个 case 上判别性成立 PASS" : "未能建立判别性 FAIL");
    CountJudge(gMidRoundDiscr);   // 全局判定项：至少一个 case 建立判别性
    allOk = allOk && gMidRoundDiscr;

    // docs/17 §2.2：计数必须可复算 —— 三类分别打印
    printf("[M20] 计数：判定项 %u checks / %u fails；报告项 %u 条（不参与 PASS/FAIL）；"
           "guard %u checks / %u fails\n",
           gJudge, gJudgeFail, gReport, gGuard, gGuardFail);
    allOk = allOk && (gJudgeFail == 0) && (gGuardFail == 0);

    printf("[M20] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
