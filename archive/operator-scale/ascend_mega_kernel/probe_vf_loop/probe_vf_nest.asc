/**
 * probe_vf_nest.asc —— 探针：`__simd_vf__`（寄存器 VF）内层循环上界依赖外层归纳变量时，
 * 内层**实际执行了几次**（M34 finding 的最小复现；直接读 trip count，不靠下游数值反推）。
 *
 * 背景（finding 原文，M34/agent-gdnprefill）：
 *   `for (uint16_t i = 0; i < rows; ++i) { for (uint16_t j = 0; j < i; ++j) {...} }`
 *   在 3510 上实测「内层少执行一次」（丢 `j=i-1` 项），u 误差 7e-2（幅值 0.99）；
 *   内层上界改编译期常量后 u 误差 8.7e-8 全 PASS。
 *
 * 读数形式（finding 要求的「能直接读出 trip count」）：
 *   VF 内**不能用标量指令**（实测：VF 循环体内任何标量运算/标量 store 都报
 *   `Unsupported scalar instruction in AIV loop`，见 README §变体矩阵里的 b2 靶子），
 *   所以计数只能用向量寄存器：
 *     内层每轮 `Adds(cnt, cnt, 1.0f)`         ⇒ 外层每行落盘的 cnt[i] == 内层 trip count
 *     内层每轮 `Add(tri, tri, cnt, allF)`     ⇒ tri[i] == Σ_{k≤t} k = t(t+1)/2（自洽校验）
 *   PROBE_BODY=1/3 再加一条数据面读数：
 *     内层每轮 `MulAddDst(accA, av, one)`     ⇒ accA[i] == Σ_{j∈S} a[i][j]（S = 实际执行的 j 集合）
 *     结合 cnt 可**精确反解 Σ_{j∈S} j** ⇒ 判定执行的 j 是不是前缀 0..t-1（丢的是不是最后一项）
 *     内层每轮 `MulAddDst(acc, av, xj)`       ⇒ acc[i][lane] == Σ_{j∈S} a[i][j]·x[j][lane]
 *
 * 判据（host 侧，整数精确，无浮点容差）：
 *   a[i][j] = i*4 + j + 1 ≤ 256、x[j][lane] = j*8 + lane + 1 ≤ 576 ⇒ 单项乘积 ≤ 147456、
 *   64 项和 ≤ 9.4e6 < 2^24 ⇒ fp32 内**序列和精确**（与累加顺序 / FMA 融合无关）。
 *
 * 变体维度（编译期宏；每个组合一个可执行文件，见 CMakeLists.txt）：
 *   PROBE_OUTER 外层形式
 *     0 = 运行期 uint16_t 变量（rows 由 kernel 实参传入）   ← finding 的原形态
 *     1 = 同 0，且内层循环加 `#pragma unroll`
 *     2 = 编译期常量上界（模板参数 CTK = PROBE_CT_ROWS）    ← donor `InverseAIVVF<32>` 形态
 *     3 = 运行期 uint32_t 归纳变量，但地址算术走 uint16_t 中间量（实测**能编译**）
 *     4 = 运行期 int32_t 归纳变量，地址算术同上（实测**能编译**）
 *     5 = 运行期 uint32_t 归纳变量，且**归纳变量直接进地址算术**（复现 M23 的
 *         「Induction variable must have a type uint16_t」约束的靶子）
 *   PROBE_INNER 内层上界表达式
 *     0 = `j < i`            （原文形态；上界=外层归纳变量）
 *     1 = `j < i - 1`（**带保护**：i==0 时取 0）。注意**不带保护**的 `j < i-1` 在 i=0 时
 *         uint16 下溢 ⇒ 界变 65535 ⇒ j 进 `xP + j*VL` 的地址远超 UB ⇒ 507035；
 *         原始日志 evidence/unguarded_inner1/inner1_unguarded_rep1.log.txt
 *     2 = `j < i + 1`
 *     3 = `j < rows16`       （上界**不**依赖外层归纳变量 —— finding 里的对照形态）
 *     4 = `hi = (uint16_t)i;` 提出到内层循环外，再 `j < hi`（值同 0，形式不同）
 *     5 = `hi = (uint32_t)i;` 同上，但上界变量是 u32（类型维度）
 *     6 = `hi = (int32_t)i;`  同上，但上界变量是 i32（类型维度）
 *     7 = `j + 1 < i`        （"i-1"的另一种写法：减一放进比较里，不下溢）
 *   PROBE_BODY 内层循环体
 *     0 = 只做向量计数（隔离「循环控制流」本身）
 *     1 = m18 `TrilSolveVF` 同形态（LoadAlign BRC + LoadAlign + MulAddDst）+ 计数
 *     2 = 纯标量计数（**预期编译失败**，归档靶子：VF 循环内标量指令不受支持）
 *     5 = body 2 + **标量 store**（`mkP[...] = j`）（**预期编译失败**，归档靶子：
 *         证「标量 store 也不行」而不只是标量算术）
 *     3 = body 1 + 行 store→load 依赖（m18 的行前代：本行结果写回 x[i]、后续行从 x[j] 读）
 *         —— 检验「丢最后一项」是否其实是内存可见性问题而不是 trip count
 *     4 = body 0/1 + **逐轮序号标记落盘**（仪器无关读数）：内层每轮把「本轮序号」这个
 *         loop-carried 寄存器 StoreAlign 到 `mk[i*ROW_W+j]` 槽位（地址含 j，值不含 j ⇒ 不违反
 *         「VF 循环内不得有标量指令」）。跑完后 mk 槽位非 0 即「该 j 执行过」，
 *         槽位里的**值**＝第几次执行 ⇒ 可区分「丢最后一项」与「编译器把首轮 peel 出去」。
 *         该变体每个槽位 256B，故 rows 只测 {0..4}（UB 预算 64KB）。
 *   注：BODY=4 的标记是**副作用读数**（不依赖计数器），是计数读数的独立交叉验证。
 *   rows ∈ {0,1,2,3,4,64}（运行期传入；编译期态取 PROBE_CT_ROWS ∈ {1,2,3,4,64}）
 *
 * 同步：只用 BufferID（GetBufInternal/RlsBufInternal），不用 set_flag/wait_flag，
 *   不挂 PIPE_S；release 用阻塞释放（BLOCK，mode=false，CANN ASC_LOCK_BLOCK 默认）。同 m18 / probe_sync_quirks 的约定。
 *
 * 编译/运行证据由 run_probes.sh 收集（逐 target 完整编译日志 + 5 次独立进程运行 + sha256）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

#ifndef PROBE_OUTER
#define PROBE_OUTER 0
#endif
#ifndef PROBE_INNER
#define PROBE_INNER 0
#endif
#ifndef PROBE_BODY
#define PROBE_BODY 0
#endif
#ifndef PROBE_CT_ROWS
#define PROBE_CT_ROWS 4
#endif
#ifndef PROBE_TAG
#define PROBE_TAG probe_vf_nest_custom
#endif

#define PROBE_STR_(x) #x
#define PROBE_STR(x) PROBE_STR_(x)

// `#pragma unroll` 只加在内层循环上（PROBE_OUTER==1）
#if PROBE_OUTER == 1
#define PROBE_UNROLL _Pragma("unroll")
#else
#define PROBE_UNROLL
#endif

namespace {

using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t VL = 64;          // 3510 fp32 向量寄存器 lane 数（256B / 4B）
constexpr uint32_t ROW_W = 64;       // 行宽 / 内层最大执行轮数（= m18 的 BT=64；名字不能叫 BT：
                                     //   编译器 cce_aicore_intrinsics.h 里已有全局 BT，会歧义）
constexpr uint32_t RMAX = 64;        // 最大行数（= finding 里 rows 的运行期取值）
constexpr uint32_t ASTRIDE = ROW_W;  // A 的行步长（元素）
constexpr uint32_t AXROWS = RMAX + 1;   // 多留一行余量：`j < i+1` 会读到行尾之后一格
constexpr uint32_t XXROWS = ROW_W + 1;

// ---- UB 静态布局（字节偏移，全部 32B 对齐；全静态自管理，无 TPipe/TBuf/AllocTensor）----
constexpr uint32_t UB_A = 0;                                      // fp32[AXROWS*ASTRIDE] = 16640B
constexpr uint32_t UB_X = UB_A + AXROWS * ASTRIDE * 4;             // fp32[XXROWS*VL]      = 16640B
constexpr uint32_t UB_CNT = UB_X + XXROWS * VL * 4;                // fp32[RMAX*VL]        = 16384B
constexpr uint32_t UB_TRI = UB_CNT + RMAX * VL * 4;
constexpr uint32_t UB_ACC = UB_TRI + RMAX * VL * 4;
constexpr uint32_t UB_ACCA = UB_ACC + RMAX * VL * 4;
constexpr uint32_t MKROWS = 4;                     // BODY=4 的标记矩阵行数（UB 预算）
constexpr uint32_t UB_MK = UB_ACCA + RMAX * VL * 4;   // BODY=4：fp32[MKROWS*ROW_W*VL]
#if PROBE_BODY == 4
constexpr uint32_t UB_END = UB_MK + MKROWS * ROW_W * VL * 4;
#else
constexpr uint32_t UB_END = UB_ACCA + RMAX * VL * 4;
#endif
static_assert(UB_END <= 248 * 1024, "UB footprint too large");

constexpr uint32_t GM_A_ELEMS = AXROWS * ASTRIDE;   // 4160
constexpr uint32_t GM_X_ELEMS = XXROWS * VL;        // 4160
constexpr uint32_t MK_ELEMS = MKROWS * ROW_W * VL;     // BODY=4 用
#if PROBE_BODY == 4
constexpr uint32_t GM_O_ELEMS = 4 * RMAX * VL + MK_ELEMS;   // cnt | tri | acc | accA | mk
#else
constexpr uint32_t GM_O_ELEMS = 4 * RMAX * VL;              // cnt | tri | acc | accA
#endif

constexpr AscendC::MutexID BUF_IN = 0;    // MTE2 → V
constexpr AscendC::MutexID BUF_OUT = 1;   // V → MTE3

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);  // 阻塞释放（BLOCK，CANN ASC_LOCK_BLOCK 默认）
}
__aicore__ inline LocalTensor<float> Lt(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<float>(TPosition::VECCALC, byteOff, count);
}
__aicore__ inline __ubuf__ float* P(uint32_t byteOff)
{
    return reinterpret_cast<__ubuf__ float*>(byteOff);
}

/**
 * 本探针的 VF 主体。
 * RowsT = 外层归纳变量类型（uint16_t 合法；uint32_t/int32_t → 预期编译失败靶子）。
 * CTK   = 0 表示外层上界取运行期实参 rows；非 0 表示编译期常量（模板常量形态）。
 */
template <typename RowsT, uint16_t CTK>
__simd_vf__ inline void RunNestVF(__ubuf__ float* aP, __ubuf__ float* xP, __ubuf__ float* cntP,
                                  __ubuf__ float* triP, __ubuf__ float* accP, __ubuf__ float* accAP,
                                  __ubuf__ float* mkP, RowsT rows)
{
    RegTensor<float> cnt, tri, acc, accA, av, xj, one, xi, mk;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    Duplicate(one, 1.0f);
    const RowsT outerBound = (CTK == 0) ? rows : static_cast<RowsT>(CTK);
    const uint16_t rows16 = static_cast<uint16_t>(outerBound);

    for (RowsT i = 0; i < outerBound; ++i) {
        const uint16_t i16 = static_cast<uint16_t>(i);
#if PROBE_OUTER == 5
        const uint32_t ri32 = static_cast<uint32_t>(i);   // 归纳变量（u32）直接进地址算术
#else
        const uint32_t ri32 = static_cast<uint32_t>(i16);
#endif
        Duplicate(cnt, 0.0f);
        Duplicate(tri, 0.0f);
        Duplicate(acc, 0.0f);
        Duplicate(accA, 0.0f);
#if PROBE_BODY == 4
        Duplicate(mk, 0.0f);                               // 本轮序号（从 1 开始）
#endif
#if PROBE_BODY == 2 || PROBE_BODY == 5
        uint32_t cntS = 0;
        uint32_t sjS = 0;
#endif
#if PROBE_INNER == 0
        PROBE_UNROLL
        for (uint16_t j = 0; j < i16; ++j) {
#elif PROBE_INNER == 1
        // `j < i-1`：i=0 时 uint16 下溢 ⇒ 界变 65535 ⇒ j 进 xP+j*VL 的地址远超 UB ⇒ 507035
        // （该形态**不可测**，原始日志留 evidence/unguarded_inner1/）。这里用**带保护的**形态。
        const uint16_t hiM1 = (i16 == 0) ? static_cast<uint16_t>(0) : static_cast<uint16_t>(i16 - 1);
        PROBE_UNROLL
        for (uint16_t j = 0; j < hiM1; ++j) {
#elif PROBE_INNER == 2
        PROBE_UNROLL
        for (uint16_t j = 0; j < static_cast<uint16_t>(i16 + 1); ++j) {
#elif PROBE_INNER == 7
        // "i-1" 的另一种写法：把减一放到比较里（不产生下溢，界仍依赖外层归纳变量）
        PROBE_UNROLL
        for (uint16_t j = 0; j + 1 < i16; ++j) {
#elif PROBE_INNER == 3
        PROBE_UNROLL
        for (uint16_t j = 0; j < rows16; ++j) {
#elif PROBE_INNER == 4
        const uint16_t hi = i16;                           // 上界提出到内层循环外（u16）
        PROBE_UNROLL
        for (uint16_t j = 0; j < hi; ++j) {
#elif PROBE_INNER == 5
        const uint32_t hi = static_cast<uint32_t>(i16);    // 上界提出到内层循环外（u32 类型）
        PROBE_UNROLL
        for (uint16_t j = 0; j < hi; ++j) {
#elif PROBE_INNER == 6
        const int32_t hi = static_cast<int32_t>(i16);      // 上界提出到内层循环外（i32 类型）
        PROBE_UNROLL
        for (uint16_t j = 0; j < hi; ++j) {
#endif
#if PROBE_BODY == 2 || PROBE_BODY == 5
            cntS = cntS + 1;                               // 纯标量计数（预期编译失败）
            sjS = sjS + static_cast<uint32_t>(j);
#if PROBE_BODY == 5
            mkP[ri32 * ROW_W + static_cast<uint32_t>(j)] = static_cast<float>(j);  // 标量 store（靶子）
#endif
#else
            Adds(cnt, cnt, 1.0f, allF);                    // 向量计数：trip count
            Add(tri, tri, cnt, allF);                      // Σ_{k≤t} k
#endif
#if PROBE_BODY == 1 || PROBE_BODY == 3
            // m18 TrilSolveVF 内层循环体的同形态（BRC 广播取 a[i][j]，另一寄存器取 x[j]）
            LoadAlign<float, LoadDist::DIST_BRC_B32>(av, aP + ri32 * ASTRIDE + j);
            LoadAlign(xj, xP + static_cast<uint32_t>(j) * VL);
            MulAddDst(acc, av, xj, allF);
            MulAddDst(accA, av, one, allF);                // Σ a[i][j]（可反解 Σj）
#endif
#if PROBE_BODY == 4
            // 仪器无关读数：把「本轮序号」落盘到 (i,j) 专属 256B 槽位（地址含 j、值不含 j，
            // 故不违反「VF 循环内不得有标量指令」）。槽位非 0 ⇒ 该 j 执行过；槽位值 ⇒ 第几次。
            Adds(mk, mk, 1.0f, allF);
            StoreAlign(mkP + (ri32 * ROW_W + static_cast<uint32_t>(j)) * VL, mk, allF);
#endif
        }
#if PROBE_BODY == 2 || PROBE_BODY == 5
        Duplicate(cnt, static_cast<float>(cntS));
        Duplicate(tri, static_cast<float>(sjS));
#endif
        StoreAlign(cntP + ri32 * VL, cnt, allF);
        StoreAlign(triP + ri32 * VL, tri, allF);
        StoreAlign(accP + ri32 * VL, acc, allF);
        StoreAlign(accAP + ri32 * VL, accA, allF);
#if PROBE_BODY == 3
        // m18 的行前代：x[i] -= Σ_{j∈S} a[i][j]·x[j]，写回后供后续行读取
        LoadAlign(xi, xP + ri32 * VL);
        Sub(xi, xi, acc, allF);
        StoreAlign(xP + ri32 * VL, xi, allF);
        LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
#endif
    }
}

// count 个 fp32 置 0（count 必须是 64 的倍数）—— BODY=4 的标记矩阵清零用（m18 ZeroVF 同款）
__simd_vf__ inline void ZeroVF(__ubuf__ float* ptr, uint32_t count)
{
    RegTensor<float> z;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    Duplicate(z, 0.0f);
    for (uint16_t t = 0; t < static_cast<uint16_t>(count / VL); ++t) {
        StoreAlign(ptr + static_cast<uint32_t>(t) * VL, z, allF);
    }
}

class VfNestProbe {
public:
    __aicore__ inline void Init(GM_ADDR a, GM_ADDR x, GM_ADDR out)
    {
        aGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(a), GM_A_ELEMS);
        xGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(x), GM_X_ELEMS);
        oGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out), GM_O_ELEMS);
    }

    __aicore__ inline void Process(uint32_t rows)
    {
        BufAcquire<PIPE_MTE2>(BUF_IN);
        DataCopy(Lt(UB_A, GM_A_ELEMS), aGm_[0], GM_A_ELEMS);
        DataCopy(Lt(UB_X, GM_X_ELEMS), xGm_[0], GM_X_ELEMS);
        BufRelease<PIPE_MTE2>(BUF_IN);

        BufAcquire<PIPE_V>(BUF_IN);
        __ubuf__ float* aP = P(UB_A);
        __ubuf__ float* xP = P(UB_X);
#if PROBE_BODY == 4
        ZeroVF(P(UB_MK), MK_ELEMS);
#endif
#if PROBE_OUTER == 3
        RunNestVF<uint32_t, 0>(aP, xP, P(UB_CNT), P(UB_TRI), P(UB_ACC), P(UB_ACCA), P(UB_MK), rows);
#elif PROBE_OUTER == 5
        RunNestVF<uint32_t, 0>(aP, xP, P(UB_CNT), P(UB_TRI), P(UB_ACC), P(UB_ACCA), P(UB_MK), rows);
#elif PROBE_OUTER == 4
        RunNestVF<int32_t, 0>(aP, xP, P(UB_CNT), P(UB_TRI), P(UB_ACC), P(UB_ACCA), P(UB_MK),
                              static_cast<int32_t>(rows));
#elif PROBE_OUTER == 2
        RunNestVF<uint16_t, PROBE_CT_ROWS>(aP, xP, P(UB_CNT), P(UB_TRI), P(UB_ACC), P(UB_ACCA), P(UB_MK),
                                           static_cast<uint16_t>(rows));
#else
        RunNestVF<uint16_t, 0>(aP, xP, P(UB_CNT), P(UB_TRI), P(UB_ACC), P(UB_ACCA), P(UB_MK),
                               static_cast<uint16_t>(rows));
#endif
        BufRelease<PIPE_V>(BUF_IN);

        BufAcquire<PIPE_V>(BUF_OUT);
        BufRelease<PIPE_V>(BUF_OUT);   // BLOCK 阻塞释放：VFC 落盘的 UB 对 MTE3 可见

        const uint32_t n = rows * VL;  // VL=64 ⇒ 恒 32B 对齐
        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(oGm_[0], Lt(UB_CNT, n), n);
        DataCopy(oGm_[RMAX * VL], Lt(UB_TRI, n), n);
        DataCopy(oGm_[2 * RMAX * VL], Lt(UB_ACC, n), n);
        DataCopy(oGm_[3 * RMAX * VL], Lt(UB_ACCA, n), n);
#if PROBE_BODY == 3
        DataCopy(xGm_[0], Lt(UB_X, GM_X_ELEMS), GM_X_ELEMS);   // 行前代后的 x（就地更新）
#endif
#if PROBE_BODY == 4
        DataCopy(oGm_[4 * RMAX * VL], Lt(UB_MK, MK_ELEMS), MK_ELEMS);   // 标记矩阵
#endif
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    GlobalTensor<float> aGm_, xGm_, oGm_;
};

}   // namespace

__vector__ __global__ void probe_vf_nest_kernel(GM_ADDR a, GM_ADDR x, GM_ADDR out, uint32_t rows)
{
    VfNestProbe op;
    op.Init(a, x, out);
    op.Process(rows);
}

// ============================================================
// host 侧：生成输入、逐 rows 跑一次、逐行判读
// ============================================================
namespace {

// 行 i 的期望内层 trip count（按 PROBE_INNER 的语义）
uint32_t ExpCnt(uint32_t i, uint32_t rows)
{
#if PROBE_INNER == 0 || PROBE_INNER == 4 || PROBE_INNER == 5 || PROBE_INNER == 6
    return i;
#elif PROBE_INNER == 1 || PROBE_INNER == 7
    return (i >= 1) ? (i - 1) : 0u;
#elif PROBE_INNER == 2
    return i + 1;
#else
    return rows;
#endif
}

float AVal(uint32_t i, uint32_t j) { return static_cast<float>(i * 4 + j + 1); }
float XVal(uint32_t j, uint32_t lane) { return static_cast<float>(j * 8 + lane + 1); }

uint32_t Fnv1a(const float* buf, uint32_t n)
{
    uint32_t h = 2166136261u;
    const unsigned char* p = reinterpret_cast<const unsigned char*>(buf);
    for (uint32_t i = 0; i < n * 4; ++i) {
        h ^= p[i];
        h *= 16777619u;
    }
    return h;
}

// 1 行 1 lane 的参考点积：Σ_{j<t} a[i][j]·x[j][lane]（整数域 ⇒ 精确，与累加顺序/FMA 无关）
float RefAcc1(uint32_t i, uint32_t lane, uint32_t t, const float* xh)
{
    float s = 0.0f;
    for (uint32_t j = 0; j < t; ++j) {
        s += AVal(i, j) * xh[j * VL + lane];
    }
    return s;
}

// acc[i][:] 相对参考 t 的最大绝对偏差
float MaxDiff(const float* accI, uint32_t i, uint32_t t, const float* xh)
{
    float mx = 0.0f;
    for (uint32_t lane = 0; lane < VL; ++lane) {
        const float s = RefAcc1(i, lane, t, xh);
        const float d = (accI[lane] > s) ? (accI[lane] - s) : (s - accI[lane]);
        if (d > mx) {
            mx = d;
        }
    }
    return mx;
}

// Σ_{j<t} a[i][j] = t·(4i+1) + t(t-1)/2（整数精确）
float SumAExp(uint32_t i, uint32_t t) { return static_cast<float>(t * (4 * i + 1) + (t * (t - 1)) / 2); }

uint32_t RowList(uint32_t* out)
{
#if PROBE_OUTER == 2
    out[0] = PROBE_CT_ROWS;
    return 1;
#elif PROBE_BODY == 4
    // 标记矩阵每槽位 256B，UB 只放得下 MKROWS=4 行
    out[0] = 0;
    out[1] = 1;
    out[2] = 2;
    out[3] = 3;
    out[4] = 4;
    return 5;
#else
    static const uint32_t all[] = {0, 1, 2, 3, 4, 64};
    uint32_t n = 0;
    for (uint32_t k = 0; k < sizeof(all) / sizeof(all[0]); ++k) {
        // 退化边界 0/1 全部保留：INNER=1 用**带保护**的界（i==0 时取 0），不再需要跳过 rows=1
        out[n++] = all[k];
    }
    return n;
#endif
}

}   // namespace

int main(int argc, char** argv)
{
    const char* dumpDir = (argc >= 2) ? argv[1] : nullptr;
    const uint32_t runIdx = (argc >= 3) ? static_cast<uint32_t>(std::atoi(argv[2])) : 0;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* aHost = new float[GM_A_ELEMS];
    float* xHost = new float[GM_X_ELEMS];
    float* xInit = new float[GM_X_ELEMS];
    float* oHost = new float[GM_O_ELEMS];
    float* xRef = new float[GM_X_ELEMS];
    std::memset(aHost, 0, GM_A_ELEMS * sizeof(float));
    std::memset(xHost, 0, GM_X_ELEMS * sizeof(float));
    for (uint32_t i = 0; i < AXROWS; ++i) {
        for (uint32_t j = 0; j < ASTRIDE; ++j) {
            aHost[i * ASTRIDE + j] = AVal(i, j);
        }
    }
    for (uint32_t j = 0; j < XXROWS; ++j) {
        for (uint32_t lane = 0; lane < VL; ++lane) {
            xHost[j * VL + lane] = XVal(j, lane);
        }
    }
    std::memcpy(xInit, xHost, GM_X_ELEMS * sizeof(float));

    void* aDev = nullptr;
    void* xDev = nullptr;
    void* oDev = nullptr;
    aclrtMalloc(&aDev, GM_A_ELEMS * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&xDev, GM_X_ELEMS * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&oDev, GM_O_ELEMS * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);

    std::printf("[probe vf nest] tag=%s outer=%d inner=%d body=%d ct_rows=%d\n", PROBE_STR(PROBE_TAG),
                PROBE_OUTER, PROBE_INNER, PROBE_BODY, PROBE_CT_ROWS);

    uint32_t rowsList[8];
    const uint32_t nRows = RowList(rowsList);
    uint32_t failRows = 0;

    for (uint32_t ri = 0; ri < nRows; ++ri) {
        const uint32_t rows = rowsList[ri];
        std::memcpy(xHost, xInit, GM_X_ELEMS * sizeof(float));   // body 3 会就地改 x
        aclrtMemcpy(aDev, GM_A_ELEMS * sizeof(float), aHost, GM_A_ELEMS * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemcpy(xDev, GM_X_ELEMS * sizeof(float), xHost, GM_X_ELEMS * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtMemset(oDev, GM_O_ELEMS * sizeof(float), 0, GM_O_ELEMS * sizeof(float));
        probe_vf_nest_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(aDev), reinterpret_cast<uint8_t*>(xDev),
                                               reinterpret_cast<uint8_t*>(oDev), rows);
        const aclError e = aclrtSynchronizeStream(stream);
        if (e != ACL_SUCCESS) {
            std::printf("  rows=%-2u 运行失败 aclError=%d\n", rows, static_cast<int>(e));
            ++failRows;
            continue;
        }
        aclrtMemcpy(oHost, GM_O_ELEMS * sizeof(float), oDev, GM_O_ELEMS * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);
        if (PROBE_BODY == 3) {
            aclrtMemcpy(xHost, GM_X_ELEMS * sizeof(float), xDev, GM_X_ELEMS * sizeof(float),
                        ACL_MEMCPY_DEVICE_TO_HOST);
        }

        const float* cnt = oHost;
        const float* tri = oHost + RMAX * VL;
        const float* acc = oHost + 2 * RMAX * VL;
        const float* accA = oHost + 3 * RMAX * VL;

        uint32_t laneBad = 0;
        uint32_t mism = 0;
        uint32_t shortByOne = 0;
        uint32_t triBad = 0;
        std::printf("  rows=%-2u\n    i      :", rows);
        for (uint32_t i = 0; i < rows; ++i) {
            std::printf(" %u", i);
        }
        std::printf("\n    cnt    :");
        for (uint32_t i = 0; i < rows; ++i) {
            std::printf(" %u", static_cast<uint32_t>(cnt[i * VL]));
        }
        std::printf("\n    expect :");
        for (uint32_t i = 0; i < rows; ++i) {
            std::printf(" %u", ExpCnt(i, rows));
        }
        std::printf("\n    tri    :");
        for (uint32_t i = 0; i < rows; ++i) {
            std::printf(" %u", static_cast<uint32_t>(tri[i * VL]));
        }
        std::printf("\n");
        for (uint32_t i = 0; i < rows; ++i) {
            const uint32_t got = static_cast<uint32_t>(cnt[i * VL]);
            const uint32_t want = ExpCnt(i, rows);
            for (uint32_t lane = 0; lane < VL; ++lane) {
                if (cnt[i * VL + lane] != cnt[i * VL]) {
                    ++laneBad;
                }
            }
            if (static_cast<uint32_t>(tri[i * VL]) != (got * (got + 1)) / 2) {
                ++triBad;
                std::printf("    TRI-ODD i=%u cnt=%u tri=%u ≠ t(t+1)/2=%u\n", i, got,
                            static_cast<uint32_t>(tri[i * VL]), (got * (got + 1)) / 2);
            }
            if (got != want) {
                ++mism;
                if (got + 1u == want) {
                    ++shortByOne;   // 「比期望少执行一次」的行
                }
                if (mism <= 8) {
                    std::printf("    MISMATCH i=%u cnt=%u expect=%u\n", i, got, want);
                }
            }
        }

        // ---- 数据面 ----
        if (PROBE_BODY == 1 || PROBE_BODY == 3) {
            // accA ⇒ 实际执行的 j 集合 S：Σ_{j∈S} a[i][j] = |S|(4i+1) + Σ_{j∈S} j
            uint32_t jsetOdd = 0;
            for (uint32_t i = 0; i < rows; ++i) {
                const uint32_t got = static_cast<uint32_t>(cnt[i * VL]);
                const float sumA = accA[i * VL];      // lane 无关（a 只依赖 i,j）
                const float wantPrefix = SumAExp(i, got);
                if (sumA != wantPrefix) {
                    ++jsetOdd;
                    const float derivedSj = sumA - static_cast<float>(got * (4 * i + 1));   // Σ_{j∈S} j
                    std::printf("    JSET-ODD i=%u cnt=%u Σa=%.0f（前缀应为 %.0f）⇒ Σj=%.0f（前缀应为 %u）\n",
                                i, got, static_cast<double>(sumA), static_cast<double>(wantPrefix),
                                static_cast<double>(derivedSj), (got * (got - 1)) / 2);
                }
            }
            if (PROBE_BODY == 1) {
                float dCnt = 0.0f;
                float dCntM1 = 0.0f;
                float dExp = 0.0f;
                for (uint32_t i = 0; i < rows; ++i) {
                    const uint32_t got = static_cast<uint32_t>(cnt[i * VL]);
                    const float a1 = MaxDiff(acc + i * VL, i, got, xInit);
                    const float a2 = MaxDiff(acc + i * VL, i, (got > 0) ? (got - 1) : 0u, xInit);
                    const float a3 = MaxDiff(acc + i * VL, i, ExpCnt(i, rows), xInit);
                    dCnt = (a1 > dCnt) ? a1 : dCnt;
                    dCntM1 = (a2 > dCntM1) ? a2 : dCntM1;
                    dExp = (a3 > dExp) ? a3 : dExp;
                }
                std::printf("    acc_maxdiff vs ref(cnt)=%.1f  ref(cnt-1)=%.1f  ref(expect)=%.1f   jset_odd=%u\n",
                            static_cast<double>(dCnt), static_cast<double>(dCntM1), static_cast<double>(dExp),
                            jsetOdd);
            } else {
                // body 3：行前代参考（就地更新；用 expect 界）
                std::memcpy(xRef, xInit, GM_X_ELEMS * sizeof(float));
                for (uint32_t i = 0; i < rows; ++i) {
                    const uint32_t t = ExpCnt(i, rows);
                    for (uint32_t lane = 0; lane < VL; ++lane) {
                        xRef[i * VL + lane] = xRef[i * VL + lane] - RefAcc1(i, lane, t, xRef);
                    }
                }
                float mxAbs = 0.0f;
                float mxRel = 0.0f;
                for (uint32_t i = 0; i < rows; ++i) {
                    for (uint32_t lane = 0; lane < VL; ++lane) {
                        const float g = xHost[i * VL + lane];
                        const float w = xRef[i * VL + lane];
                        const float d = (g > w) ? (g - w) : (w - g);
                        if (d > mxAbs) {
                            mxAbs = d;
                        }
                        if (w != 0.0f) {
                            const float r = d / ((w > 0.0f) ? w : -w);
                            if (r > mxRel) {
                                mxRel = r;
                            }
                        }
                    }
                }
                std::printf("    x_maxabs_vs_ref=%.6g  x_maxrel=%.6g  jset_odd=%u（参考=用 expect 界的行前代）\n",
                            static_cast<double>(mxAbs), static_cast<double>(mxRel), jsetOdd);
            }
        }

#if PROBE_BODY == 4
        // 仪器无关读数：标记矩阵逐槽位 —— '#' = 该 j 执行过；数字 = 槽位里的序号（第几次执行）
        {
            const float* mk = oHost + 4 * RMAX * VL;
            uint32_t mkOdd = 0;
            for (uint32_t i = 0; i < rows && i < MKROWS; ++i) {
                char line[ROW_W + 1];
                for (uint32_t j = 0; j < ROW_W; ++j) {
                    const float v = mk[(i * ROW_W + j) * VL];
                    line[j] = (v != 0.0f) ? '#' : '.';
                }
                line[ROW_W] = '\0';
                std::printf("    mk[%u] %s\n", i, line);
                // 序号一致性：第 k 个非零槽位的值应为 k（内层从 j=0 起 ⇒ 槽位 j 的值 = j+1）
                uint32_t ord = 0;
                for (uint32_t j = 0; j < ROW_W; ++j) {
                    const float v = mk[(i * ROW_W + j) * VL];
                    if (v != 0.0f) {
                        ++ord;
                        if (static_cast<uint32_t>(v) != ord) {
                            ++mkOdd;
                            std::printf("      MK-ORD-ODD i=%u j=%u 槽位序号=%.0f（该行第 %u 个非零槽位）\n", i, j,
                                        static_cast<double>(v), ord);
                        }
                    }
                }
                if (ord != static_cast<uint32_t>(cnt[i * VL])) {
                    ++mkOdd;
                    std::printf("      MK-COUNT-ODD i=%u 非零槽位=%u 但 cnt=%u\n", i, ord,
                                static_cast<uint32_t>(cnt[i * VL]));
                }
                // 首个未执行槽位（丢的是不是「最后一项」）
                uint32_t firstZero = ROW_W;
                for (uint32_t j = 0; j < ROW_W; ++j) {
                    if (mk[(i * ROW_W + j) * VL] == 0.0f) {
                        firstZero = j;
                        break;
                    }
                }
                char fz[16];
                if (firstZero == ROW_W) {
                    std::snprintf(fz, sizeof(fz), "-");
                } else {
                    std::snprintf(fz, sizeof(fz), "%u", firstZero);
                }
                if (ord == 0) {
                    std::printf("      i=%u 执行槽位 = (空)，首个空槽=%s，期望 0..%u\n", i, fz, ExpCnt(i, rows));
                } else {
                    std::printf("      i=%u 执行槽位 0..%u，首个空槽=%s，期望 0..%u\n", i, ord - 1, fz,
                                ExpCnt(i, rows));
                }
            }
            if (mkOdd != 0) {
                ++failRows;
                std::printf("    rows=%u verdict=FAIL(MK)\n", rows);
            }
        }
#endif

        const uint32_t hash = Fnv1a(oHost, GM_O_ELEMS);
        std::printf("    lane_mismatch=%u  tri_odd=%u  少一次的行数=%u/%u  hash=0x%08x\n", laneBad, triBad,
                    shortByOne, rows, hash);
        const bool pass = (mism == 0) && (laneBad == 0) && (triBad == 0);
        std::printf("    rows=%u verdict=%s\n", rows, pass ? "PASS" : "FAIL");
        if (!pass) {
            ++failRows;
        }
    }

    std::printf("[probe vf nest] tag=%s %s  (rows 档位 %u，失败 %u)\n", PROBE_STR(PROBE_TAG),
                failRows == 0 ? "RUN PASS" : "RUN FAIL", nRows, failRows);

    if (dumpDir != nullptr && runIdx == 0) {
        char path[512];
        std::snprintf(path, sizeof(path), "%s/nest_%s.txt", dumpDir, PROBE_STR(PROBE_TAG));
        FILE* f = std::fopen(path, "w");
        if (f != nullptr) {
            std::fprintf(f, "# tag=%s outer=%d inner=%d body=%d ct_rows=%d rows_lo=%u rows_hi=%u pass=%u\n",
                         PROBE_STR(PROBE_TAG), PROBE_OUTER, PROBE_INNER, PROBE_BODY, PROBE_CT_ROWS,
                         rowsList[0], rowsList[1], failRows);
            std::fclose(f);
        }
    }

    aclrtFree(aDev);
    aclrtFree(xDev);
    aclrtFree(oDev);
    delete[] aHost;
    delete[] xHost;
    delete[] xInit;
    delete[] oHost;
    delete[] xRef;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (failRows == 0) ? 0 : 1;
}
