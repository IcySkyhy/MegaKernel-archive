/**
 * probe_arange_gather.asc —— 探针：finding 里的两条次要项（只给事实，不归因）
 *
 *   ① `AscendC::Reg::Arange` 是否真的不支持 uint32_t？（取证 static_assert 的 SupportType 列表）
 *      并验证绕法「`Arange<int32_t>` + reinterpret 成 `RegTensor<uint32_t>` 交给 `Gather`」是否可行。
 *      静态取证（CANN 9.1.0 头文件原文，dav_3510 路径）：
 *        .../reg_compute/dav_3510/kernel_reg_compute_vec_arange_impl.h:47
 *        static_assert((SupportType<ActualT, int8_t, int16_t, int32_t, float, half, int64_t>()),
 *                      "current Arange data type is not supported on current device!");
 *      ⇒ 列表里没有 uint8/16/32/64；`Arange<uint32_t>` 触发该 static_assert（AG_FORM=1 归档原文）。
 *
 *   ② `Reg::Gather(dst, __ubuf__ base, indexReg, mask)`（vgather2，DataCopyGatherImpl）的
 *      **可寻址范围**：按元素索引，用递进索引扫上限，给出「能寻到多大 / 在哪里失败」。
 *      AG_FORM=0 的可执行程序就是这条：host 用 kernel 实参传 start/stride，
 *      内核用 `Arange<int32_t>`（绕法）+ 可选 `Muls` 步长 + `Adds` 偏移构造索引后 Gather，
 *      落到 GM 由 host 逐 lane 比对 ⇒ 每个 (start,stride) 档位一条读数。
 *      索引语义：idx[lane] = start + lane*stride（元素）；源数组 NEL=16384 fp32（64KB，UB 偏移 0）。
 *      实测结果（run_probes.sh 全档，见 README §②）：
 *        · 数组内（idx ≤ 16383）任意 start/stride 全部逐 lane 正确（含 8191/8192/8193、
 *          任意非对齐 start、stride ∈ {1,2,8,64,128}）⇒ **没有 ≤8191 这类索引窗口限制**；
 *        · 越出数组但仍在 UB 物理窗口内（16384 ≤ idx ≤ 65535）：**不报错**，读到该处 UB 现有内容
 *          （未初始化区为 0），host 判定对越界 lane 只报事实（oob 计数）不参与 verdict；
 *        · idx*4 ≥ 256KB（fp32、base=0 ⇒ start+lane*stride ≥ 65536）→ **aclError=507035**
 *          （vector core exception）。实测边界：start=65472（max_idx=65535）正常，
 *          start=65473（max_idx=65536）即异常 —— 阈值恰好是 UB 物理容量 256KB。
 *      ⇒ 结论：可寻址范围 = 「base 起、落在本核 UB 窗口内的元素」（我们的 base 在 UB 内，
 *        窗口即整个 UB）；越界不静默回绕成 0，而是先读到 UB 内容、再越出 UB 时异常。
 *
 * 同步：BufferID（同 probe_vf_nest.asc）。1 次 launch 只测一组 (start, stride)，
 * 便于「每个档位一个独立进程」归档（越界时 stream 报错后 context 不可再用，必须换进程）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

#ifndef AG_FORM
#define AG_FORM 0
#endif
#ifndef AG_NEL
#define AG_NEL 16384        // 源数组元素数（fp32，64KB UB）
#endif
#ifndef AG_TAG
#define AG_TAG probe_ag_custom
#endif

#define AG_STR_(x) #x
#define AG_STR(x) AG_STR_(x)

namespace {

using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t VL = 64;
constexpr uint32_t NEL = AG_NEL;
constexpr uint32_t UB_SRC = 0;                    // fp32[NEL] = 64KB
constexpr uint32_t UB_DST = NEL * 4;              // fp32[VL]  = 256B
constexpr uint32_t UB_END = UB_DST + VL * 4;
static_assert(UB_END <= 248 * 1024, "UB footprint too large");

constexpr AscendC::MutexID BUF_IN = 0;
constexpr AscendC::MutexID BUF_OUT = 1;

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}
__aicore__ inline LocalTensor<float> Lt(uint32_t byteOff, uint32_t count)
{
    return LocalTensor<float>(TPosition::VECCALC, byteOff, count);
}
__aicore__ inline __ubuf__ float* P(uint32_t byteOff)
{
    return reinterpret_cast<__ubuf__ float*>(byteOff);
}

// AG_FORM=0：Arange<int32_t> → reinterpret<RegTensor<uint32_t>> → Gather(vgather2)
// 索引语义与 host 判读严格对齐：idx[lane] = start + lane*stride（先乘步长再加偏移）
__simd_vf__ inline void GatherSweepVF(__ubuf__ float* srcP, __ubuf__ float* dstP, uint32_t start, uint32_t stride)
{
    RegTensor<int32_t> idxI;
    RegTensor<float> v;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    MaskReg allI = CreateMask<int32_t, MaskPattern::ALL>();
    Arange(idxI, static_cast<int32_t>(0));
    if (stride != 1u) {
        Muls<int32_t>(idxI, idxI, static_cast<int32_t>(stride), allI);
    }
    Adds<int32_t>(idxI, idxI, static_cast<int32_t>(start), allI);
    Gather<float>(v, srcP, reinterpret_cast<RegTensor<uint32_t>&>(idxI), allF);
    StoreAlign(dstP, v, allF);
}

#if AG_FORM == 1
// AG_FORM=1：Arange<uint32_t>（预期触发 static_assert：current Arange data type is not supported
//            on current device!）——归档靶子，不参与正常运行。
__simd_vf__ inline void ArangeU32VF(__ubuf__ float* dstP)
{
    RegTensor<uint32_t> idxU;
    RegTensor<float> v;
    MaskReg allF = CreateMask<float, MaskPattern::ALL>();
    Arange(idxU, 0u);
    Gather<float>(v, dstP, idxU, allF);
    StoreAlign(dstP, v, allF);
}
#endif

class AgProbe {
public:
    __aicore__ inline void Init(GM_ADDR src, GM_ADDR out)
    {
        sGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(src), NEL);
        oGm_.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(out), VL);
    }

    __aicore__ inline void Process(uint32_t start, uint32_t stride)
    {
        BufAcquire<PIPE_MTE2>(BUF_IN);
        DataCopy(Lt(UB_SRC, NEL), sGm_[0], NEL);
        BufRelease<PIPE_MTE2>(BUF_IN);

        BufAcquire<PIPE_V>(BUF_IN);
#if AG_FORM == 1
        ArangeU32VF(P(UB_DST));
#else
        GatherSweepVF(P(UB_SRC), P(UB_DST), start, stride);
#endif
        BufRelease<PIPE_V>(BUF_IN);

        BufAcquire<PIPE_V>(BUF_OUT);
        BufRelease<PIPE_V>(BUF_OUT);

        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(oGm_[0], Lt(UB_DST, VL), VL);
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    GlobalTensor<float> sGm_, oGm_;
};

}   // namespace

__vector__ __global__ void probe_ag_kernel(GM_ADDR src, GM_ADDR out, uint32_t start, uint32_t stride)
{
    AgProbe op;
    op.Init(src, out);
    op.Process(start, stride);
}

int main(int argc, char** argv)
{
    const char* dumpDir = (argc >= 2) ? argv[1] : nullptr;
    const uint32_t start = (argc >= 3) ? static_cast<uint32_t>(std::strtoul(argv[2], nullptr, 0)) : 0;
    const uint32_t stride = (argc >= 4) ? static_cast<uint32_t>(std::strtoul(argv[3], nullptr, 0)) : 1;

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    float* sHost = new float[NEL];
    float* oHost = new float[VL];
    for (uint32_t i = 0; i < NEL; ++i) {
        sHost[i] = 1000.0f + static_cast<float>(i);   // ≤ 17383，fp32 精确
    }
    void* sDev = nullptr;
    void* oDev = nullptr;
    aclrtMalloc(&sDev, NEL * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&oDev, VL * sizeof(float), ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(sDev, NEL * sizeof(float), sHost, NEL * sizeof(float), ACL_MEMCPY_HOST_TO_DEVICE);

    std::printf("[probe ag] tag=%s form=%d nel=%u start=%u stride=%u\n", AG_STR(AG_TAG), AG_FORM, NEL, start,
                stride);

    aclrtMemset(oDev, VL * sizeof(float), 0, VL * sizeof(float));
    probe_ag_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(sDev), reinterpret_cast<uint8_t*>(oDev), start,
                                      stride);
    const aclError e = aclrtSynchronizeStream(stream);
    int rc = 0;
    if (e != ACL_SUCCESS) {
        std::printf("[probe ag] tag=%s RUN FAIL：aclError=%d (start=%u stride=%u)\n", AG_STR(AG_TAG),
                    static_cast<int>(e), start, stride);
        rc = 2;
    } else {
        aclrtMemcpy(oHost, VL * sizeof(float), oDev, VL * sizeof(float), ACL_MEMCPY_DEVICE_TO_HOST);
        uint32_t bad = 0;      // 源数组范围内（idx < NEL）不符的 lane —— 判定用
        uint32_t oob = 0;      // 越出源数组但未异常（idx >= NEL）—— 只报事实，不判定
        uint32_t oobZero = 0;
        float oobFirst = 0.0f;
        uint32_t firstBad = 0;
        float got = 0.0f;
        float want = 0.0f;
        for (uint32_t lane = 0; lane < VL; ++lane) {
            const uint64_t idx = static_cast<uint64_t>(start) + static_cast<uint64_t>(lane) * stride;
            if (idx < NEL) {
                if (oHost[lane] != sHost[idx]) {
                    if (bad == 0) {
                        firstBad = lane;
                        got = oHost[lane];
                        want = sHost[idx];
                    }
                    ++bad;
                }
            } else {
                if (oob == 0) {
                    oobFirst = oHost[lane];
                }
                ++oob;
                if (oHost[lane] == 0.0f) {
                    ++oobZero;
                }
            }
        }
        const uint64_t maxIdx = static_cast<uint64_t>(start) + static_cast<uint64_t>(VL - 1) * stride;
        std::printf("[probe ag] tag=%s start=%-8u stride=%-5u max_idx=%-9llu in_rng_bad=%u oob_lanes=%u "
                    "oob_zero=%u oob_first=%g",
                    AG_STR(AG_TAG), start, stride, static_cast<unsigned long long>(maxIdx), bad, oob, oobZero,
                    static_cast<double>(oobFirst));
        if (bad != 0) {
            std::printf("  首个不符 lane=%u got=%g want=%g（idx=%llu）", firstBad,
                        static_cast<double>(got), static_cast<double>(want),
                        static_cast<unsigned long long>(static_cast<uint64_t>(start) +
                                                        static_cast<uint64_t>(firstBad) * stride));
        }
        std::printf("  %s\n", bad == 0 ? "RUN PASS" : "RUN FAIL");
        rc = (bad == 0) ? 0 : 1;
    }

    if (dumpDir != nullptr) {
        char path[512];
        std::snprintf(path, sizeof(path), "%s/ag_%s_s%u_x%u.bin", dumpDir, AG_STR(AG_TAG), start, stride);
        FILE* f = std::fopen(path, "wb");
        if (f != nullptr) {
            std::fwrite(oHost, 1, VL * sizeof(float), f);
            std::fclose(f);
        }
    }

    aclrtFree(sDev);
    aclrtFree(oDev);
    delete[] sHost;
    delete[] oHost;
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return rc;
}
