/**
 * probe_mask_lanes.asc —— M94：`CreateMask<T, MaskPattern::ALL>()` 的**实测语义**（dav-3510 / Ascend950PR）
 *
 * ============================ 这个探针要裁决什么 ============================
 *
 * 悬案（两种说法互相矛盾，必须由读数定）：
 *   ① `m17_moe_real/m17_moe_layer.asc:1136-1147` 的注释：「int32 的 ALL mask 是 **128 lane** ⇒
 *      每行 store **512B**、跨行越界（RT_IDS 行距只有 256B）⇒ 必须换成 `UpdateMask<int32_t>(64)`」。
 *   ② 人类的原则（逐字）：「SIMD API 固定的是 VL 256B，不同数据类型的 VL 一致，element 的数量不同」
 *      ⇒ 若 VL 恒 256B，int32 的 ALL 应为 **64 lane**（64×4B = 256B），512B 的说法不成立。
 *   被审的落点是 `m15_layer_loop/m15_moe_layer.h` 的 `SoftmaxTopkRow`：
 *      `MaskReg maskAllI = CreateMask<int32_t, MaskPattern::ALL>();`
 *      `StoreAlign(idsUb, idxs, maskAllI);`  // idsUb = UB_RT_IDS + r*64*4 ⇒ **行距 256B**
 *
 * ============================ 本探针测什么（三件套） ============================
 *   A. **dtype → mask 有效元素数 → 单次 store 实际落盘字节**（任务 1）：九种 dtype 各自用自己的
 *      ALL mask 做一次最小宽度 store，扫哨兵被改写的字节范围。
 *   B. **mask 的位编码**（任务 2 的机理）：同一个 mask 用**别的位宽**的 store 落盘时，能激活多少 lane。
 *      这条能把「128」这个数字的来源钉死：若 mask 寄存器按「b8=1bit/元素、b16=2bit/元素、b32=4bit/元素」
 *      编码（`asc_create_mask` 的官方表），则 `CreateMask<int32_t,...>` 的 64 个 b32 组 = 64 lane，
 *      而 **128 正是 b16 的 lane 数**（`CreateMask<bfloat16_t, ...>`）。
 *   C. **行距语义**（任务 2/3）：复刻 `SoftmaxTopkRow` 的 UB 布局（i32[16][64] ids 区 @0、fp32[16][64]
 *      ws 区 @4096，行距各 256B），逐行跑「ids store + ws store」，然后**整段扫**哪些字节被写。
 *      判据 = 「被写字节 ⊆ 各行窗口的并集」+「每个窗口都被写满」；负向对照的造法是**把行距缩小**
 *      （256B → 192B；以及 b16 落盘行距 128B）—— **mask 不变**。这样落盘（1 VL = 256B）必然超出本行槽
 *      ⇒ 必须被检出越界。（原任务书建议的「用比行距更大的 mask」在本架构上不可构造：带掩码的单寄存器
 *      落盘上限就是 1 VL，512B 需要双寄存器 intlv 形态、且那个形态不接受掩码 —— 见 §B/dual 组。）
 *
 * ============================ 方法（为什么这么做） ============================
 *  * **一个变体 = 一次 launch + 一次进程**：故障/挂死不污染后续变体；每条变体有独立 aclError。
 *  * **探针只报事实，判据在 host 侧独立脚本**（`tools/check_mask_lanes.py`）：本文件**不含**任何
 *    「期望值」常量 ⇒ 判据模型与设备代码不共享代码路径（docs/17 §1.2 反自指）。
 *  * **被写字节 = 与哨兵不同的字节**：哨兵由 host 侧 `aclrtMemset(dArena, ARENA, 0xA5, ARENA)` 在**设备侧**
 *    灌入 GM arena；kernel 只把该 arena 原样 MTE2 搬进 UB（不重新填充），V 段只写它该写的窗口，
 *    再 MTE3 搬回 GM，host D2H 回读后逐字节扫 ⇒ 「写没写、写到哪、写超了多少」全在 dump 里可见，
 *    且**非哨兵字节必为设备侧写入**（docs/17 **T1**：逐位）。
 *  * **lane 身份靠图案**：`LoadAlign` 从图案 buffer 载入 `pat[i]`（i = 窗口内字节偏移），
 *    再带 mask 落盘 ⇒ 落盘的字节值直接给出「哪条 lane 被写」。图案选
 *    `patA[i] = 0x5A ^ ((i+1) & 0xFF)`（b8 下只在 lane 255 与哨兵同值，1 字节盲点，
 *    由第二图案 `patB[i] = 0xC3 ^ ((i+2) & 0xFF)`（盲点 lane 100）覆盖 —— 见 README §4）。
 *  * **每次落盘跑两遍**（图案 A @+0、图案 B @+1024）：同一 launch 内的重复测量，兼作稳定性证据。
 *  * **行距组用「每 (区,行) 一个常数字节」图案**：让被写字节的**值**直接标出是哪一个 (区,行) 写的
 *    ⇒ 若第 r 行的 store 溢出到别的行，能被指认是谁写的（`pat` slot = idx*256B，字节值 0x11+idx）。
 *
 * ============================ 读数口径 ============================
 *  `VARIANT` 变体参数；`LAUNCH aclError=` 本次 launch 的同步返回；`WRANGES` 与哨兵不同的字节区间
 *  （左闭右开，逗号分隔）；`FNV` 整段 arena 的 FNV-1a 指纹；`AREABYTES` arena 字节数。
 *  dump：`<dumpdir>/ml_<op>_r<rep>.bin`（12288B）= 逐字节原始证据。
 *  退出码（docs/17 §8.3 三态）：0=事实已打印 / 2=故障或挂死（无事实可比）。
 *
 * 用法：`./probe_mask_lanes list` 打印变体矩阵；`./probe_mask_lanes run <op> [dumpdir]` 跑一条。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace {

using namespace AscendC;
using namespace AscendC::Reg;

// ------------------------------------------------------------------
// 几何常量
// ------------------------------------------------------------------
constexpr uint32_t ARENA = 12288;                 // 观察窗：足够装 IDS(4096)+WS(4096)+尾哨兵 256B
constexpr uint32_t UB_ARENA = 0;
constexpr uint32_t UB_PAT = UB_ARENA + ARENA;     // 图案区（lane 图案 + 32 个「(区,行)」槽）
constexpr uint32_t PAT_BYTES = 8704;              // 32*256 = 8192 行槽 + 512 lane 图案
constexpr uint32_t PAT_LANE_A = 8192;
constexpr uint32_t PAT_LANE_B = 8448;
constexpr uint32_t PAT_SLOT = 256;
constexpr uint32_t IDS_OFF = 0;                   // ids 区基址（复刻 UB_RT_IDS 相对布局）
constexpr uint32_t WS_OFF = 4096;                 // ws 区基址（复刻 UB_RT_WS 相对布局）
constexpr uint8_t SENTINEL = 0xA5;
constexpr int32_t SYNC_TIMEOUT_MS = 120000;       // 设备共享：其它 agent 的 kernel 会长期占核
constexpr AscendC::MutexID BUF_IO = 0;            // MTE2 -> V -> MTE3
constexpr uint32_t MAX_OPS = 128;

// 挂死类错误码（rt_error_codes.h：107020 task timeout / 507046 stream sync timeout / 507034 AIV timeout）
constexpr int32_t ERR_TASK_TIMEOUT = 107020;
constexpr int32_t ERR_STREAM_SYNC_TIMEOUT = 507046;
constexpr int32_t ERR_VECTOR_CORE_TIMEOUT = 507034;

// ------------------------------------------------------------------
// 变体表
// ------------------------------------------------------------------
// store dtype 码（决定 RegTensor<T> 与落盘粒度）
enum : uint32_t { SD_S8 = 0, SD_U8, SD_S16, SD_U16, SD_F16, SD_BF16, SD_F32, SD_S32, SD_U32, SD_N };
// mask 位宽码（决定 CreateMask<MD, ...> 的位宽模式；代表类型见 MDTypeImpl）
enum : uint32_t { MW_M8 = 0, MW_M16, MW_M32, MW_N };
// pattern 码
enum : uint32_t { PT_ALL = 0, PT_VL1, PT_VL2, PT_VL4, PT_VL8, PT_VL16, PT_VL32, PT_VL64, PT_VL128, PT_H, PT_Q,
                  PT_M3, PT_M4, PT_N };
// ids mask 取法（行距组）
enum : uint32_t { IM_OWN_ALL = 0, IM_UPD64, IM_B16ALL, IM_B8ALL };
// 变体种类
enum : uint32_t { K_LANE = 0, K_MASKTYPE, K_DUAL, K_ROW };

const char* const kStoreName[SD_N] = {"s8", "u8", "s16", "u16", "f16", "bf16", "f32", "s32", "u32"};
const char* const kMaskName[MW_N] = {"m8", "m16", "m32"};
const char* const kPatName[PT_N] = {"all",  "vl1",  "vl2",  "vl4",   "vl8", "vl16", "vl32",
                                    "vl64", "vl128", "h", "q", "m3", "m4"};

struct Op {
    char name[56];
    uint32_t kind;
    uint32_t sd;      // K_LANE/K_MASKTYPE/K_DUAL: store dtype；K_ROW: ids 落盘 dtype
    uint32_t md;      // K_LANE/K_ROW: mask 位宽；K_MASKTYPE: 未用
    uint32_t pat;     // K_LANE: pattern
    uint32_t rows;    // K_ROW
    uint32_t pitchI;
    uint32_t pitchW;
    uint32_t im;      // K_ROW: ids mask 取法
    uint32_t group;   // 分组标签（0 = lane_own, 1 = lane_cross, 2 = lane_enc, 3 = masktype, 4 = dual, 5 = row）
};

const char* const kGroupName[6] = {"lane-own", "lane-cross", "lane-enc", "masktype", "dual", "row"};

// lane 组：显式三元组（store dtype, mask 位宽, pattern）。own = 同宽；cross = 异宽；enc = 同宽部分掩码。
struct LaneSpec {
    uint32_t sd, md, pat, group;
};
const LaneSpec kLaneSpecs[] = {
    // ---- own-width ALL：九种 dtype 各自用自己的位宽 ALL mask（任务 1 的主表）----
    {SD_S8, MW_M8, PT_ALL, 0},   {SD_U8, MW_M8, PT_ALL, 0},
    {SD_S16, MW_M16, PT_ALL, 0}, {SD_U16, MW_M16, PT_ALL, 0},
    {SD_F16, MW_M16, PT_ALL, 0}, {SD_BF16, MW_M16, PT_ALL, 0},
    {SD_F32, MW_M32, PT_ALL, 0}, {SD_S32, MW_M32, PT_ALL, 0},
    {SD_U32, MW_M32, PT_ALL, 0},
    // ---- cross-width ALL：同一 ALL 图案用在别的位宽 store 上 ----
    {SD_S32, MW_M16, PT_ALL, 1}, {SD_S32, MW_M8, PT_ALL, 1},
    {SD_F32, MW_M16, PT_ALL, 1}, {SD_S16, MW_M32, PT_ALL, 1},
    {SD_S8, MW_M32, PT_ALL, 1},  {SD_U8, MW_M16, PT_ALL, 1},
    // ---- 同宽部分掩码：位编码的逐步读数 ----
    {SD_S32, MW_M32, PT_VL1, 2},  {SD_S32, MW_M32, PT_VL2, 2},  {SD_S32, MW_M32, PT_VL4, 2},
    {SD_S32, MW_M32, PT_VL8, 2},  {SD_S32, MW_M32, PT_VL16, 2}, {SD_S32, MW_M32, PT_VL32, 2},
    {SD_S32, MW_M32, PT_VL64, 2}, {SD_S32, MW_M32, PT_H, 2},    {SD_S32, MW_M32, PT_Q, 2},
    {SD_S32, MW_M32, PT_M3, 2},   {SD_S32, MW_M32, PT_M4, 2},
    {SD_S32, MW_M16, PT_VL1, 2},  {SD_S32, MW_M16, PT_VL2, 2},  {SD_S32, MW_M16, PT_VL4, 2},
    {SD_S32, MW_M16, PT_VL8, 2},  {SD_S32, MW_M16, PT_H, 2},
    {SD_S32, MW_M8, PT_VL1, 2},   {SD_S32, MW_M8, PT_VL4, 2},   {SD_S32, MW_M8, PT_VL8, 2},
    {SD_S16, MW_M16, PT_VL1, 2},  {SD_S16, MW_M16, PT_VL2, 2},  {SD_S16, MW_M16, PT_VL8, 2},
    {SD_S16, MW_M16, PT_VL64, 2}, {SD_S16, MW_M16, PT_VL128, 2}, {SD_S16, MW_M16, PT_H, 2},
    {SD_S16, MW_M32, PT_VL1, 2},  {SD_S16, MW_M32, PT_VL2, 2},  {SD_S16, MW_M32, PT_VL8, 2},
    {SD_S16, MW_M8, PT_VL1, 2},   {SD_S16, MW_M8, PT_VL8, 2},
    {SD_S8, MW_M8, PT_VL1, 2},    {SD_S8, MW_M8, PT_VL4, 2},    {SD_S8, MW_M8, PT_VL8, 2},
    {SD_S8, MW_M16, PT_VL1, 2},   {SD_S8, MW_M16, PT_VL2, 2},
    {SD_S8, MW_M32, PT_VL1, 2},
    {SD_BF16, MW_M16, PT_VL1, 2}, {SD_BF16, MW_M16, PT_VL2, 2},
    {SD_BF16, MW_M32, PT_VL1, 2},
};
constexpr uint32_t kNumLaneSpecs = sizeof(kLaneSpecs) / sizeof(kLaneSpecs[0]);

// masktype 组：**同一位宽、不同 C++ 类型**的 mask —— 检验「位宽模式决定语义、具体类型不影响」
struct MaskTypeSpec {
    uint32_t sd;      // store dtype
    uint32_t which;   // 0 = 左列类型（见 README §3 表），1 = 右列类型
};
const MaskTypeSpec kMaskTypeSpecs[] = {
    {SD_F16, 0},  {SD_F16, 1},   // mask = half    vs bfloat16_t（都是 b16）
    {SD_S16, 0},  {SD_S16, 1},   // mask = int16_t vs uint16_t（都是 b16）
    {SD_F32, 0},  {SD_F32, 1},   // mask = float   vs int32_t（都是 b32）
    {SD_U8, 0},   {SD_U8, 1},    // mask = uint8_t vs int8_t（都是 b8）
};
constexpr uint32_t kNumMaskTypeSpecs = sizeof(kMaskTypeSpecs) / sizeof(kMaskTypeSpecs[0]);

// dual 组：双寄存器 store（vst dual，2×VL）——「>256B 的单次落盘**只有**这一种形态」的证据
struct DualSpec {
    uint32_t sd;
};
const DualSpec kDualSpecs[] = {{SD_S32}, {SD_S16}, {SD_S8}};
constexpr uint32_t kNumDualSpecs = sizeof(kDualSpecs) / sizeof(kDualSpecs[0]);

// row 组：复刻 SoftmaxTopkRow 的 ids/ws 落盘（行距 256B），+ 越界负向对照
struct RowSpec {
    const char* name;
    uint32_t rows;
    uint32_t pitchI;
    uint32_t pitchW;
    uint32_t sdi;     // ids 落盘 dtype
    uint32_t mdi;     // ids mask 位宽
    uint32_t im;      // ids mask 取法
};
const RowSpec kRowSpecs[] = {
    // 正例：m15 tip 形态（ids mask = <int32_t, ALL>，行距 256B）；rows = 1/8/15/16
    {"row_m1_cur", 1, 256, 256, SD_S32, MW_M32, IM_OWN_ALL},
    {"row_m8_cur", 8, 256, 256, SD_S32, MW_M32, IM_OWN_ALL},
    {"row_m15_cur", 15, 256, 256, SD_S32, MW_M32, IM_OWN_ALL},
    {"row_m16_cur", 16, 256, 256, SD_S32, MW_M32, IM_OWN_ALL},
    // m17 的形态（ids mask = UpdateMask<int32_t>(64)）
    {"row_m16_upd64", 16, 256, 256, SD_S32, MW_M32, IM_UPD64},
    // 「128 lane 前提」的两种外推：把 b16/b8 的 ALL mask 喂给 int32 store
    {"row_m16_b16mask", 16, 256, 256, SD_S32, MW_M16, IM_B16ALL},
    {"row_m16_b8mask", 16, 256, 256, SD_S32, MW_M8, IM_B8ALL},
    // 负向对照 1：**同 dtype、同 mask**，只把行距缩到 192B（< 256B）⇒ 越界必被检出
    {"row_nc_p192", 16, 192, 256, SD_S32, MW_M32, IM_OWN_ALL},
    // 负向对照 2：b16 落盘 + 行距 128B（32 个 lane 的 4 行装不满一次 VL 落盘）⇒ 越界必被检出
    {"row_nc_p128_b16", 4, 128, 256, SD_S16, MW_M16, IM_OWN_ALL},
    // 正对照 3：稀疏行距 512B（窗口之间留 256B 空洞）⇒ 空洞必须保持哨兵（并集判据非空洞）
    {"row_sparse4_p512", 4, 512, 256, SD_S32, MW_M32, IM_OWN_ALL},
};
constexpr uint32_t kNumRowSpecs = sizeof(kRowSpecs) / sizeof(kRowSpecs[0]);

uint32_t BuildOps(Op* ops)
{
    uint32_t n = 0;
    for (uint32_t i = 0; i < kNumLaneSpecs; ++i) {
        const LaneSpec& s = kLaneSpecs[i];
        Op& o = ops[n++];
        std::snprintf(o.name, sizeof(o.name), "lane_%s_%s_%s", kStoreName[s.sd], kMaskName[s.md], kPatName[s.pat]);
        o.kind = K_LANE;
        o.sd = s.sd;
        o.md = s.md;
        o.pat = s.pat;
        o.rows = o.pitchI = o.pitchW = o.im = 0;
        o.group = s.group;
    }
    for (uint32_t i = 0; i < kNumMaskTypeSpecs; ++i) {
        const MaskTypeSpec& s = kMaskTypeSpecs[i];
        Op& o = ops[n++];
        std::snprintf(o.name, sizeof(o.name), "mt_%s_%s", kStoreName[s.sd], (s.which == 0) ? "tA" : "tB");
        o.kind = K_MASKTYPE;
        o.sd = s.sd;
        o.md = s.which;
        o.pat = PT_ALL;
        o.rows = o.pitchI = o.pitchW = o.im = 0;
        o.group = 3;
    }
    for (uint32_t i = 0; i < kNumDualSpecs; ++i) {
        Op& o = ops[n++];
        std::snprintf(o.name, sizeof(o.name), "dual_%s", kStoreName[kDualSpecs[i].sd]);
        o.kind = K_DUAL;
        o.sd = kDualSpecs[i].sd;
        o.md = o.pat = 0;
        o.rows = o.pitchI = o.pitchW = o.im = 0;
        o.group = 4;
    }
    for (uint32_t i = 0; i < kNumRowSpecs; ++i) {
        const RowSpec& s = kRowSpecs[i];
        Op& o = ops[n++];
        std::snprintf(o.name, sizeof(o.name), "%s", s.name);
        o.kind = K_ROW;
        o.sd = s.sdi;
        o.md = s.mdi;
        o.pat = 0;
        o.rows = s.rows;
        o.pitchI = s.pitchI;
        o.pitchW = s.pitchW;
        o.im = s.im;
        o.group = 5;
    }
    return n;
}

}   // namespace

// ============================================================
// 设备侧
// ============================================================
namespace {

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// pattern 码 -> MaskPattern
template <uint32_t P>
struct PatOf {
    static constexpr MaskPattern v = MaskPattern::ALL;
};
template <>
struct PatOf<PT_VL1> {
    static constexpr MaskPattern v = MaskPattern::VL1;
};
template <>
struct PatOf<PT_VL2> {
    static constexpr MaskPattern v = MaskPattern::VL2;
};
template <>
struct PatOf<PT_VL4> {
    static constexpr MaskPattern v = MaskPattern::VL4;
};
template <>
struct PatOf<PT_VL8> {
    static constexpr MaskPattern v = MaskPattern::VL8;
};
template <>
struct PatOf<PT_VL16> {
    static constexpr MaskPattern v = MaskPattern::VL16;
};
template <>
struct PatOf<PT_VL32> {
    static constexpr MaskPattern v = MaskPattern::VL32;
};
template <>
struct PatOf<PT_VL64> {
    static constexpr MaskPattern v = MaskPattern::VL64;
};
template <>
struct PatOf<PT_VL128> {
    static constexpr MaskPattern v = MaskPattern::VL128;
};
template <>
struct PatOf<PT_H> {
    static constexpr MaskPattern v = MaskPattern::H;
};
template <>
struct PatOf<PT_Q> {
    static constexpr MaskPattern v = MaskPattern::Q;
};
template <>
struct PatOf<PT_M3> {
    static constexpr MaskPattern v = MaskPattern::M3;
};
template <>
struct PatOf<PT_M4> {
    static constexpr MaskPattern v = MaskPattern::M4;
};

class MaskLaneProbe {
public:
    __aicore__ inline void Init(GM_ADDR arena, GM_ADDR pat, uint32_t kind, uint32_t sd, uint32_t md, uint32_t pt,
                                uint32_t rows, uint32_t pitchI, uint32_t pitchW, uint32_t im)
    {
        opId_ = kind;
        sd_ = sd;
        md_ = md;
        pat_ = pt;
        rows_ = rows;
        pitchI_ = pitchI;
        pitchW_ = pitchW;
        im_ = im;
        arenaGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(arena), ARENA);
        patGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(pat), PAT_BYTES);
    }

    __aicore__ inline void Process()
    {
        LocalTensor<uint8_t> are(TPosition::VECCALC, UB_ARENA, ARENA);
        LocalTensor<uint8_t> pat(TPosition::VECCALC, UB_PAT, PAT_BYTES);

        BufAcquire<PIPE_MTE2>(BUF_IO);
        DataCopy(are, arenaGm_[0], ARENA);
        DataCopy(pat, patGm_[0], PAT_BYTES);
        BufRelease<PIPE_MTE2>(BUF_IO);

        __ubuf__ uint8_t* base = reinterpret_cast<__ubuf__ uint8_t*>(are.GetPhyAddr());
        __ubuf__ uint8_t* patBase = reinterpret_cast<__ubuf__ uint8_t*>(pat.GetPhyAddr());

        BufAcquire<PIPE_V>(BUF_IO);
        Run(base, patBase);
        BufRelease<PIPE_V>(BUF_IO);

        BufAcquire<PIPE_MTE3>(BUF_IO);
        DataCopy(arenaGm_[0], are, ARENA);
        BufRelease<PIPE_MTE3>(BUF_IO);
    }

private:
    __aicore__ inline void Run(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat)
    {
        switch (opId_) {
            case K_LANE:
                RunLaneDispatch(base, pat);
                return;
            case K_MASKTYPE:
                RunMaskTypeDispatch(base, pat);
                return;
            case K_DUAL:
                RunDualDispatch(base, pat);
                return;
            case K_ROW:
                RunRowDispatch(base, pat);
                return;
            default:
                return;
        }
    }

    // -------- 单次带 mask 落盘：图案 A @+0，图案 B @+1024 --------
    template <typename SD, typename MD, uint32_t P>
    __aicore__ inline void DoLane(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat)
    {
        __VEC_SCOPE__
        {
            RegTensor<SD> r;
            MaskReg m = CreateMask<MD, PatOf<P>::v>();
            LoadAlign(r, reinterpret_cast<__ubuf__ SD*>(pat + PAT_LANE_A));
            StoreAlign(reinterpret_cast<__ubuf__ SD*>(base + 0), r, m);
            LoadAlign(r, reinterpret_cast<__ubuf__ SD*>(pat + PAT_LANE_B));
            StoreAlign(reinterpret_cast<__ubuf__ SD*>(base + 1024), r, m);
        }
    }

    // 每个 (store dtype, mask 位宽) 组合列出全部用到的 pattern，避免按 id 分段（见 probe_v_align 的教训）
#define ML_PAT_CASES(SDT, MDT)                                                              \
    case PT_ALL: DoLane<SDT, MDT, PT_ALL>(base, pat); break;                                \
    case PT_VL1: DoLane<SDT, MDT, PT_VL1>(base, pat); break;                                \
    case PT_VL2: DoLane<SDT, MDT, PT_VL2>(base, pat); break;                                \
    case PT_VL4: DoLane<SDT, MDT, PT_VL4>(base, pat); break;                                \
    case PT_VL8: DoLane<SDT, MDT, PT_VL8>(base, pat); break;                                \
    case PT_VL16: DoLane<SDT, MDT, PT_VL16>(base, pat); break;                              \
    case PT_VL32: DoLane<SDT, MDT, PT_VL32>(base, pat); break;                              \
    case PT_VL64: DoLane<SDT, MDT, PT_VL64>(base, pat); break;                              \
    case PT_VL128: DoLane<SDT, MDT, PT_VL128>(base, pat); break;                             \
    case PT_H: DoLane<SDT, MDT, PT_H>(base, pat); break;                                     \
    case PT_Q: DoLane<SDT, MDT, PT_Q>(base, pat); break;                                     \
    case PT_M3: DoLane<SDT, MDT, PT_M3>(base, pat); break;                                   \
    case PT_M4: DoLane<SDT, MDT, PT_M4>(base, pat); break

#define ML_MD_CASES(SDT)                                                     \
    case MW_M8: switch (pat_) { ML_PAT_CASES(SDT, int8_t); } break;          \
    case MW_M16: switch (pat_) { ML_PAT_CASES(SDT, bfloat16_t); } break;     \
    case MW_M32: switch (pat_) { ML_PAT_CASES(SDT, int32_t); } break

    __aicore__ inline void RunLaneDispatch(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat)
    {
        switch (sd_) {
            case SD_S8: switch (md_) { ML_MD_CASES(int8_t); } break;
            case SD_U8: switch (md_) { ML_MD_CASES(uint8_t); } break;
            case SD_S16: switch (md_) { ML_MD_CASES(int16_t); } break;
            case SD_U16: switch (md_) { ML_MD_CASES(uint16_t); } break;
            case SD_F16: switch (md_) { ML_MD_CASES(half); } break;
            case SD_BF16: switch (md_) { ML_MD_CASES(bfloat16_t); } break;
            case SD_F32: switch (md_) { ML_MD_CASES(float); } break;
            case SD_S32: switch (md_) { ML_MD_CASES(int32_t); } break;
            case SD_U32: switch (md_) { ML_MD_CASES(uint32_t); } break;
            default: break;
        }
    }

    // -------- mask 类型对照（同宽不同 C++ 类型）--------
#define ML_MT_CASE(SDT, MDT)                                                                     \
    case 0: {                                                                                    \
        __VEC_SCOPE__                                                                            \
        {                                                                                        \
            RegTensor<SDT> r;                                                                    \
            MaskReg m = CreateMask<MDT, MaskPattern::ALL>();                                     \
            LoadAlign(r, reinterpret_cast<__ubuf__ SDT*>(pat + PAT_LANE_A));                     \
            StoreAlign(reinterpret_cast<__ubuf__ SDT*>(base + 0), r, m);                         \
            LoadAlign(r, reinterpret_cast<__ubuf__ SDT*>(pat + PAT_LANE_B));                     \
            StoreAlign(reinterpret_cast<__ubuf__ SDT*>(base + 1024), r, m);                      \
        }                                                                                        \
    } break

    __aicore__ inline void RunMaskTypeDispatch(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat)
    {
        switch (sd_) {
            case SD_F16:   // tA: mask=half ; tB: mask=bfloat16_t
                if (md_ == 0) switch (0) { ML_MT_CASE(half, half); }
                else switch (0) { ML_MT_CASE(half, bfloat16_t); }
                break;
            case SD_S16:   // tA: mask=int16_t ; tB: mask=uint16_t
                if (md_ == 0) switch (0) { ML_MT_CASE(int16_t, int16_t); }
                else switch (0) { ML_MT_CASE(int16_t, uint16_t); }
                break;
            case SD_F32:   // tA: mask=float ; tB: mask=int32_t
                if (md_ == 0) switch (0) { ML_MT_CASE(float, float); }
                else switch (0) { ML_MT_CASE(float, int32_t); }
                break;
            case SD_U8:    // tA: mask=uint8_t ; tB: mask=int8_t
                if (md_ == 0) switch (0) { ML_MT_CASE(uint8_t, uint8_t); }
                else switch (0) { ML_MT_CASE(uint8_t, int8_t); }
                break;
            default: break;
        }
    }

    // -------- 双寄存器 store（vst dual，`asc_storealign_intlv`）：唯一能一次落盘 2×VL 的形态 --------
    //   注意 dist 必须是 DIST_INTLV_*（vsts 的 dual 形态只接受 intlv 距离，见编译器静态断言：
    //   "The 4th argument of vst is not valid"）⇒ **带掩码的单寄存器落盘最大就是 1×VL**。
    template <typename SD, StoreDist D>
    __aicore__ inline void DoDual(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat)
    {
        __VEC_SCOPE__
        {
            RegTensor<SD> r0, r1;
            MaskReg m = CreateMask<SD, MaskPattern::ALL>();
            LoadAlign(r0, reinterpret_cast<__ubuf__ SD*>(pat + PAT_LANE_A));
            LoadAlign(r1, reinterpret_cast<__ubuf__ SD*>(pat + PAT_LANE_B));
            StoreAlign<SD, D>(reinterpret_cast<__ubuf__ SD*>(base + 0), r0, r1, m);
        }
    }

    __aicore__ inline void RunDualDispatch(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat)
    {
        switch (sd_) {
            case SD_S32: DoDual<int32_t, StoreDist::DIST_INTLV_B32>(base, pat); break;
            case SD_S16: DoDual<int16_t, StoreDist::DIST_INTLV_B16>(base, pat); break;
            case SD_S8: DoDual<int8_t, StoreDist::DIST_INTLV_B8>(base, pat); break;
            default: break;
        }
    }

    // -------- 行距组：复刻 SoftmaxTopkRow 的 ids/ws 落盘 --------
    //   图案槽 idx = 区(0=ids,1=ws)*16 + 行 ⇒ 被写字节的**值** = 0x11+idx，直接标出是谁写的。
    //   MODE: 0 = CreateMask<MT, ALL>（m15 tip 形态）；1 = UpdateMask<MT>(64)（m17 形态）。
    template <typename IT, typename MT, uint32_t MODE>
    __aicore__ inline void RunRowTyped(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat, uint32_t rows,
                                       uint32_t pitchI, uint32_t pitchW)
    {
        for (uint32_t r = 0; r < rows; ++r) {
            __VEC_SCOPE__
            {
                LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
                RegTensor<IT> ri;
                MaskReg mi;
                if constexpr (MODE == 1) {
                    uint32_t n64 = 64;
                    mi = UpdateMask<MT>(n64);
                } else {
                    mi = CreateMask<MT, MaskPattern::ALL>();
                }
                LoadAlign(ri, reinterpret_cast<__ubuf__ IT*>(pat + r * PAT_SLOT));
                StoreAlign(reinterpret_cast<__ubuf__ IT*>(base + IDS_OFF + r * pitchI), ri, mi);

                RegTensor<float> rw;
                MaskReg mw = CreateMask<float, MaskPattern::ALL>();
                LoadAlign(rw, reinterpret_cast<__ubuf__ float*>(pat + (16u + r) * PAT_SLOT));
                StoreAlign(reinterpret_cast<__ubuf__ float*>(base + WS_OFF + r * pitchW), rw, mw);
            }
        }
    }

    __aicore__ inline void RunRowDispatch(__ubuf__ uint8_t* base, __ubuf__ uint8_t* pat)
    {
        const uint32_t rows = rows_;
        const uint32_t pi = pitchI_;
        const uint32_t pw = pitchW_;
        switch (sd_) {
            case SD_S32:
                switch (im_) {
                    case IM_OWN_ALL: RunRowTyped<int32_t, int32_t, 0>(base, pat, rows, pi, pw); break;
                    case IM_UPD64: RunRowTyped<int32_t, int32_t, 1>(base, pat, rows, pi, pw); break;
                    case IM_B16ALL: RunRowTyped<int32_t, bfloat16_t, 0>(base, pat, rows, pi, pw); break;
                    case IM_B8ALL: RunRowTyped<int32_t, int8_t, 0>(base, pat, rows, pi, pw); break;
                    default: break;
                }
                break;
            case SD_S16:
                switch (im_) {
                    case IM_OWN_ALL: RunRowTyped<int16_t, int16_t, 0>(base, pat, rows, pi, pw); break;
                    default: break;
                }
                break;
            default:
                break;
        }
    }

public:
    uint32_t opId_ = K_LANE;
    uint32_t sd_ = SD_S32;
    uint32_t md_ = MW_M32;
    uint32_t pat_ = PT_ALL;
    uint32_t rows_ = 16;
    uint32_t pitchI_ = 256;
    uint32_t pitchW_ = 256;
    uint32_t im_ = IM_OWN_ALL;
    AscendC::GlobalTensor<uint8_t> arenaGm_;
    AscendC::GlobalTensor<uint8_t> patGm_;
};

}   // namespace

__vector__ __global__ void probe_mask_lanes_kernel(GM_ADDR arena, GM_ADDR pat, uint32_t kind, uint32_t sd, uint32_t md,
                                                   uint32_t pt, uint32_t rows, uint32_t pitchI, uint32_t pitchW,
                                                   uint32_t im)
{
    MaskLaneProbe probe;
    probe.Init(arena, pat, kind, sd, md, pt, rows, pitchI, pitchW, im);
    probe.Process();
}

// ============================================================
// host 侧
// ============================================================
namespace {

void PrintList()
{
    Op ops[MAX_OPS];
    const uint32_t n = BuildOps(ops);
    std::printf("# name kind group sd md pat rows pitchI pitchW im\n");
    for (uint32_t i = 0; i < n; ++i) {
        const Op& o = ops[i];
        std::printf("%s %u %s %s %s %s %u %u %u %u\n", o.name, o.kind, kGroupName[o.group], kStoreName[o.sd],
                    kMaskName[o.md], kPatName[o.pat], o.rows, o.pitchI, o.pitchW, o.im);
    }
    std::printf("# count=%u\n", n);
}

// 与哨兵不同的字节区间（左闭右开）
void PrintRanges(const uint8_t* got, uint32_t n, uint32_t* nzOut, uint32_t* firstOut, uint32_t* lastOut)
{
    uint32_t i = 0, nr = 0, nz = 0, first = 0xFFFFFFFFu, last = 0;
    std::printf("WRANGES ");
    while (i < n) {
        if (got[i] == SENTINEL) {
            ++i;
            continue;
        }
        const uint32_t s = i;
        while (i < n && got[i] != SENTINEL) ++i;
        std::printf("%s%u-%u", (nr != 0) ? "," : "", s, i);
        ++nr;
        nz += (i - s);
        if (first == 0xFFFFFFFFu) first = s;
        last = i;
    }
    if (nr == 0) {
        std::printf("(none)");
        first = 0;
    }
    std::printf("\n");
    *nzOut = nz;
    *firstOut = first;
    *lastOut = last;
}

}   // namespace

int main(int argc, char** argv)
{
    if (argc >= 2 && std::strcmp(argv[1], "list") == 0) {
        PrintList();
        return 0;
    }
    if (argc < 3 || std::strcmp(argv[1], "run") != 0) {
        std::fprintf(stderr, "usage: %s list | run <op> [dumpdir]\n", argv[0]);
        return 2;
    }
    Op ops[MAX_OPS];
    const uint32_t nOps = BuildOps(ops);
    const Op* op = nullptr;
    for (uint32_t i = 0; i < nOps; ++i) {
        if (std::strcmp(ops[i].name, argv[2]) == 0) {
            op = &ops[i];
            break;
        }
    }
    if (op == nullptr) {
        std::fprintf(stderr, "unknown op %s\n", argv[2]);
        return 2;
    }
    const char* dumpDir = (argc >= 4) ? argv[3] : nullptr;

    std::printf("VARIANT name=%s kind=%u group=%s sd=%s md=%s pat=%s rows=%u pitchI=%u pitchW=%u im=%u\n", op->name,
                op->kind, kGroupName[op->group], kStoreName[op->sd], kMaskName[op->md], kPatName[op->pat], op->rows,
                op->pitchI, op->pitchW, op->im);

    static uint8_t got[ARENA];
    static uint8_t patHost[PAT_BYTES];
    // 图案：lane 图案 A/B（值 = f(i)，i = 窗口内字节偏移）+ 32 个「(区,行)」常数槽
    for (uint32_t i = 0; i < 256; ++i) {
        patHost[PAT_LANE_A + i] = static_cast<uint8_t>(0x5A ^ ((i + 1) & 0xFF));
        patHost[PAT_LANE_B + i] = static_cast<uint8_t>(0xC3 ^ ((i + 2) & 0xFF));
    }
    for (uint32_t idx = 0; idx < 32; ++idx) {
        std::memset(&patHost[idx * PAT_SLOT], static_cast<int>(0x11 + idx), PAT_SLOT);
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    void* dArena = nullptr;
    void* dPat = nullptr;
    aclrtMalloc(&dArena, ARENA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dPat, PAT_BYTES, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dArena, ARENA, SENTINEL, ARENA);
    aclrtMemcpy(dPat, PAT_BYTES, patHost, PAT_BYTES, ACL_MEMCPY_HOST_TO_DEVICE);

    probe_mask_lanes_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(dArena),
                                              reinterpret_cast<uint8_t*>(dPat), op->kind, op->sd, op->md, op->pat,
                                              op->rows, op->pitchI, op->pitchW, op->im);
    const aclError err = aclrtSynchronizeStreamWithTimeout(stream, SYNC_TIMEOUT_MS);
    std::printf("LAUNCH aclError=%d (sync timeout=%dms)\n", static_cast<int>(err), SYNC_TIMEOUT_MS);

    int rc = 2;
    if (err != ACL_SUCCESS) {
        const char* msg = aclGetRecentErrMsg();
        std::printf("FAULT_CODE %d\n", static_cast<int>(err));
        std::printf("FAULT_MSG %s\n", (msg != nullptr) ? msg : "(null)");
        const char* kind = (err == ERR_VECTOR_CORE_TIMEOUT || err == ERR_TASK_TIMEOUT) ? "HANG" :
                           (err == ERR_STREAM_SYNC_TIMEOUT) ? "NOSYNC" : "FAULT";
        std::printf("OUTCOME: %s\n", kind);
    } else {
        aclrtMemcpy(got, ARENA, dArena, ARENA, ACL_MEMCPY_DEVICE_TO_HOST);
        if (dumpDir != nullptr) {
            char path[512];
            std::snprintf(path, sizeof(path), "%s/ml_%s.bin", dumpDir, op->name);
            FILE* f = std::fopen(path, "wb");
            if (f != nullptr) {
                std::fwrite(got, 1, ARENA, f);
                std::fclose(f);
            }
        }
        uint64_t h = 1469598103934665603ULL;
        for (uint32_t i = 0; i < ARENA; ++i) {
            h ^= got[i];
            h *= 1099511628211ULL;
        }
        uint32_t nz = 0, first = 0, last = 0;
        std::printf("AREABYTES %u\n", ARENA);
        PrintRanges(got, ARENA, &nz, &first, &last);
        std::printf("NZ bytes_written=%u first_off=%u last_off=%u\n", nz, first, last);
        std::printf("FNV 0x%016llx\n", static_cast<unsigned long long>(h));
        std::printf("OUTCOME: RAN\n");
        rc = 0;
    }

    aclrtFree(dArena);
    aclrtFree(dPat);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return rc;
}
