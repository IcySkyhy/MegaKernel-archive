/**
 * probe_v_align.asc —— M57：逐 API 的 UB 偏移/长度对齐要求探针（dav-3510 / Ascend950PR）
 *
 * ============================ 这个探针要回答什么 ============================
 *
 * 用户 2026-09-26 的结论（本探针把它变成实测，逐条落到 README 的总表）：
 *   ① 「UB 偏移非 32B 对齐 -> 507035」：多数 API 限 32B 对齐，但**部分** SIMD Vector function
 *      的 load/store API 支持非 32B 对齐（gather/scatter、unaligned load/store、1 element load/store）。
 *   ② 「SIMD API 固定的是 VL 256B，不同数据类型的 VL 一致，element 的数量不同」（F32/S32=64、S16=128）。
 *   ③ 「load unalign 和 store unalign 都是有状态的操作…多数场景你不应该用 unaligned 系列」。
 *   ④ 「LocalMemBar 须在 __VEC_SCOPE__ 内」。
 *   ⑤ 「不同位宽之间转换会从 1 个寄存器变成 2 个（或反过来）…FP32→BF16 要么 interleave 再 cast
 *      到 even/odd、要么 select+mask merge、要么用 store 的 **pack b16** 模式（pack b16 需你确认）」。
 *
 * 每条 API 的实测三件套：**最小 UB 偏移对齐 / 最小长度对齐 / 不合规时的具体错误码**。
 *
 * ============================ 方法（为什么这么做） ============================
 *
 * * **一个变体 = 一次 launch**：对齐违规是设备侧异常（aclError=507035），一次 launch 里串多个 op
 *   就无法把故障归因到某个 op，也分不清"前一个 op 静默写坏、后一个 op 才报错"。
 * * **一个变体 = 一次进程**：故障/挂死不污染后续变体；每条变体的 aclError 独立归档。
 * * **被探地址不是编译期常量**：地址 = `GetPhyAddr(arena) + 偏移`，偏移是**运行时 kernel 实参**
 *   ⇒ 探到的是硬件对运行期地址的行为，不是编译器常量折叠出来的东西。
 * * **逐字节模型**：OUT arena 先被 0xA5 sentinel 填满（GM→UB 纯搬运），op 只写它该写的窗口，
 *   最后整段 1024B 回 GM ⇒ "写没写、写到哪、写超了多少"全在 dump 里可见，host 逐字节比对
 *   （docs/17 **T1**：整数/位域逐位，无容差）。
 * * **IN arena 是 `f(i) = i + 0.5` 的字节模式**：1B/2B 非对齐读出的浮点是无意义的位模式，
 *   但本探针**只搬不算**（除显式算术 op）⇒ 模型仍逐位可判。
 * * **同步批处理形状逐字照抄 `probe_sync_quirks/probe_b_vec_idx.asc`**：V 段**不跨计算持有**
 *   OUT 的 BufferID。实测记录：把 `Acquire(PIPE_V,BUF_OUT)` 移到计算之前、与 `Acquire(PIPE_V,BUF_IN)`
 *   成对持有（其余代码逐字不变、地址全对齐），单 AIV 单次 launch 下**挂死**；改成 probe_b 的形状后
 *   同一段计算立刻 PASS。本条是**方法学记录**（一次对照，见 README §7），不作平台断言。
 *
 * ============================ 结果口径 ============================
 *   `OUTCOME: OK`    —— 无故障且 dump 逐字节等于模型（该对齐/长度被接受）
 *   `OUTCOME: WRONG` —— 无故障但 dump 与模型不符（**静默错**，最危险的一类）
 *   `OUTCOME: FAULT` —— 同步返回非 0 aclError（原文归档；507035 = errcode 340
 *                       "The address for VEC to access UB is not aligned"）
 *   `OUTCOME: HANG`  —— 带超时同步仍未返回（run_probes.sh 会单独标注）
 *   退出码（docs/17 §8.3 三态）：0=比过通过 / 1=比过有差异 / 2=没得比（故障或挂死）
 *
 * 用法：`./probe_v_align list` 打印矩阵；`./probe_v_align run <op> <a> <b> <n> [dumpdir]` 跑一条。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

// ============================================================
// 共享常量 / op 表
// ============================================================
namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t VLB = 256;                   // 向量寄存器宽度（字节）——固定 VL
constexpr uint32_t VL_F32 = 64;                 // 256B / 4B
constexpr uint32_t VL_B16 = 128;                // 256B / 2B
constexpr uint32_t VL_B8 = 256;                 // 256B / 1B
constexpr uint32_t ARENA = 1024;                // 每个 arena 1024B（= 4 个 VL），留越界观察窗
constexpr uint32_t UB_IN = 2048;
constexpr uint32_t UB_OUT = UB_IN + ARENA;
constexpr uint8_t SENTINEL = 0xA5;
constexpr int32_t SYNC_TIMEOUT_MS = 120000;     // 设备共享（其它 agent 的 kernel 长期占核）
                                               // ⇒ 排队延迟不是挂死；本超时只防"永不返回"，
                                               // 真正的设备侧挂死会以 507034 报出
constexpr float FILL_CONST = 7.0f;              // Duplicate 常量（dupreg/dupub）

constexpr AscendC::MutexID BUF_IN = 0;          // MTE2 -> V
constexpr AscendC::MutexID BUF_OUT = 1;         // V -> MTE3

enum OpId : uint32_t {
    OP_VNOOP = 0,
    OP_LS = 1,          // LoadAlign(IN+a) -> StoreAlign(OUT+b)，全掩码（vlds/vsts）
    OP_LSN = 2,         // 全对齐 load + UpdateMask(n) 的 StoreAlign(OUT+b)
    OP_LDBRC = 3,       // LoadAlign<float, DIST_BRC_B32>(IN+a)（单元素广播 load）
    OP_STFIRST = 4,     // StoreAlign<float, DIST_FIRST_ELEMENT_B32>(OUT+b, mask=1)（单元素 store）
    OP_STPACK = 5,      // f32->bf16 Cast + StoreAlign<bfloat16_t, DIST_PACK_B32>(OUT+b)（pack b16）
    OP_STPACK4 = 6,     // bf16->fp4 Cast + StoreAlign<int8_t, DIST_PACK4_B32>(OUT+b)
    OP_VLD = 7,         // LoadAlign(reg, IN+a, AddrReg)（vld：地址寄存器寻址）
    OP_VLDAS = 8,       // LoadUnAlignPre + LoadUnAlign（vldas/vldus，有状态）
    OP_VSTUS = 9,       // StoreUnAlign + StoreUnAlignPost（vstus/vstas，有状态）
    OP_LOAD1 = 10,      // Reg::Load（= vldas + vldus）
    OP_STORE1 = 11,     // Reg::Store（= vstus + vstas）
    OP_GATHER = 12,     // vgather2（UB base + 索引寄存器）
    OP_GATHERB = 13,    // vgatherb（位索引）
    OP_SCATTER = 14,    // vscatter（UB base）
    OP_PLD = 15,        // LoadAlign(MaskReg, IN+a) + StoreAlign(OUT+b, MaskReg)（plds/psts）
    OP_DUPUB = 16,      // 经典 memory-based Duplicate(UB dst @ OUT+b)（507015 历史现场）
    OP_BRCB = 17,       // 经典 Brcb(UB dst @ OUT+b)（3510 无 Reg 版 Brcb）
    OP_DUPREG = 18,     // Reg::Duplicate（目的在寄存器）+ StoreAlign(OUT+b)
    OP_ADD = 19,
    OP_MUL = 20,
    OP_EXP = 21,
    OP_REDSUM = 22,     // Reduce<SUM> -> 广播落盘
    OP_REDMAX = 23,     // Reduce<MAX> -> 广播落盘
    OP_CMPSEL = 24,     // Compares + Select
    OP_ARANGE = 25,     // Arange<float>
    OP_F32BF16_NORM = 26,   // Cast<bf16,float> + NORM 落盘（看 even/odd 落位）
    OP_F32BF16_PACK = 27,   // Cast<bf16,float> + DIST_PACK_B32 落盘（看 pack b16 是否紧凑）
    OP_BF16F32_NORM = 28,   // LoadAlign<bf16,NORM> + Cast<float>（看是否只换 even lane）
    OP_BF16F32_UNPK = 29,   // LoadAlign<bf16,UNPACK_B16> + Cast<float>（正解写法）
    OP_LMBAR_IN = 30,       // LocalMemBar 在 __VEC_SCOPE__ 内（控制组）
    OP_LMBAR_OUT = 31,      // LocalMemBar 在 __VEC_SCOPE__ 外（用户结论 ④ 的靶子）
    OP_WIDTH_F32 = 32,      // Duplicate 常量 + 全掩码落盘：量"一个 VL 到底写多少字节"
    OP_WIDTH_BF16 = 33,
    OP_WIDTH_S16 = 34,
    OP_WIDTH_S8 = 35,
    OP_ARANGE_S32 = 36,     // Arange 各 dtype 填多少 lane（用户结论 ② 的靶子）
    OP_ARANGE_S16 = 37,
    OP_ARANGE_S8 = 38,
    OP_F32BF16_NORMB16 = 39,  // 同上但落盘用 bf16 ALL 掩码（看奇数 16-bit lane 是否被写）
    OP_VLDAS_NOPRE = 40,      // **负向对照**：有状态 load 缺 init（只用 vldus，不先 vldas）
    OP_VSTUS_NOPOST = 41,     // **负向对照**：有状态 store 缺 post（只用 vstus，不补 vstas）
    OP_PSTS = 42,             // 谓词落盘（psts）：全 1 掩码 + StoreAlign，探"谓词 store 的地址要求"
};

// 输出模型
enum ModelId : uint32_t {
    M_NONE = 0,         // 不比对（控制组）
    M_BYTESHIFT = 1,    // OUT[b, b+window) 逐字节等于 IN[a, a+window)，其余为 sentinel
    M_CONSTF32 = 2,     // OUT[b, b+window) = FILL_CONST 铺满（fp32）
    M_NONEMPTY = 3,     // OUT[b, b+window) 内至少 1 字节非 sentinel 且首字节被写过
    M_BRC = 4,          // OUT[b, b+window) = IN[a] 处 fp32 值铺满 64 lane
    M_ADD = 5,          // OUT[b, b+window)[i] = ramp[i] + ramp[i+32]
    M_MUL = 6,          // OUT[b, b+window)[i] = ramp[i] * ramp[i+32]
    M_ARANGE_F32 = 7,   // OUT[b..b+256) = i (fp32)
    M_F32BF16_NORM = 8, // 256B：even 16-bit lane = RNE_bf16(ramp[i])，odd lane 由观测记录
    M_F32BF16_PACK = 9, // 128B：紧凑 64 个 RNE_bf16(ramp[i])
    M_BF16F32_NORM = 10,// 256B：out_f32[j] = 源 bf16 的第 2j 个元素
    M_BF16F32_UNPK = 11,// 256B：out_f32[j] = 源 bf16 的第 j 个元素
    M_CMPSEL = 12,      // Compares(LE, 16.0) 后 Select
    M_EXP = 13,         // 结构性 + 数值报告（超越函数，docs/17 T3）
    M_RED = 14,         // 结构性：一个值广播满 64 lane
    M_F32BF16_NORMB16 = 15,  // 偶数 16-bit lane 判位，奇数 lane 只报告
};

struct OpSpec {
    const char* name;
    uint32_t id;
    uint32_t window;    // 期望被写的字节数（**基线值**；n 相关或与基线不同的 op 由 WindowOf 覆盖）
    uint32_t model;
};
const OpSpec kOps[] = {
    {"vnoop", OP_VNOOP, 0, M_NONE},
    {"ls", OP_LS, VLB, M_BYTESHIFT},
    {"lsn", OP_LSN, 0, M_BYTESHIFT},          // window = 4*n，host 侧按 n 算
    {"ldbrc", OP_LDBRC, VLB, M_BRC},
    {"stfirst", OP_STFIRST, 4, M_BYTESHIFT},
    {"stpack", OP_STPACK, VLB / 2, M_F32BF16_PACK},
    {"stpack4", OP_STPACK4, VLB / 4, M_NONEMPTY},   // 实测写出 64B（128 个 fp4 nibble 打包），不是 32B
    {"vld", OP_VLD, VLB, M_NONEMPTY},
    {"vldas", OP_VLDAS, VLB, M_BYTESHIFT},
    {"vstus", OP_VSTUS, VLB, M_BYTESHIFT},
    {"load1", OP_LOAD1, VLB, M_BYTESHIFT},
    {"store1", OP_STORE1, VLB, M_BYTESHIFT},
    {"gather", OP_GATHER, VLB, M_NONEMPTY},
    {"gatherb", OP_GATHERB, VLB, M_NONEMPTY},
    {"scatter", OP_SCATTER, VLB, M_NONEMPTY},
    {"pld", OP_PLD, 32, M_NONEMPTY},
    {"dupub", OP_DUPUB, VLB, M_CONSTF32},
    {"brcb", OP_BRCB, VLB, M_NONEMPTY},
    {"dupreg", OP_DUPREG, VLB, M_CONSTF32},
    {"add", OP_ADD, VLB, M_ADD},
    {"mul", OP_MUL, VLB, M_MUL},
    {"exp", OP_EXP, VLB, M_EXP},
    {"redsum", OP_REDSUM, 4, M_RED},          // 实测写出 4B：VL1 掩码只落 lane0（归约值在 lane0）
    {"redmax", OP_REDMAX, 4, M_RED},          // 同上
    {"cmpsel", OP_CMPSEL, VLB, M_CMPSEL},
    {"arange", OP_ARANGE, VLB, M_ARANGE_F32},
    {"f32bf16norm", OP_F32BF16_NORM, VLB, M_F32BF16_NORM},
    {"f32bf16pack", OP_F32BF16_PACK, VLB / 2, M_F32BF16_PACK},
    {"bf16f32norm", OP_BF16F32_NORM, VLB, M_BF16F32_NORM},
    {"bf16f32unpk", OP_BF16F32_UNPK, VLB, M_BF16F32_UNPK},
    {"lmbarin", OP_LMBAR_IN, VLB, M_NONEMPTY},
    {"lmbarout", OP_LMBAR_OUT, VLB, M_NONEMPTY},
    {"widthf32", OP_WIDTH_F32, VLB, M_NONEMPTY},
    {"widthbf16", OP_WIDTH_BF16, VLB, M_NONEMPTY},
    {"widths16", OP_WIDTH_S16, VLB, M_NONEMPTY},
    {"widths8", OP_WIDTH_S8, VLB, M_NONEMPTY},
    {"arangef32", OP_ARANGE, VLB, M_ARANGE_F32},
    {"aranges32", OP_ARANGE_S32, VLB, M_NONEMPTY},
    {"aranges16", OP_ARANGE_S16, VLB, M_NONEMPTY},
    {"aranges8", OP_ARANGE_S8, VLB, M_NONEMPTY},
    {"f32bf16nb16", OP_F32BF16_NORMB16, VLB, M_F32BF16_NORMB16},
    {"psts", OP_PSTS, 32, M_NONEMPTY},
    {"vldasnopre", OP_VLDAS_NOPRE, VLB, M_BYTESHIFT},
    {"vstusnopost", OP_VSTUS_NOPOST, VLB, M_BYTESHIFT},
};

// window 有**两个来源层级**，别把它当成字面意义上的"单一来源"：
//   ① `WindowOfImpl`（定义在 OpSpec 之后）—— `VARIANT` 行的打印、以及模型里 M_BYTESHIFT / M_RED 两支走它，
//      并负责 `lsn`(4n) / `store1`(VLB) / 归约(4) 这三个特例；
//   ② 其余 **12 处**模型分支仍自带字面量：`*window = VLB` ×9、`*window = VL_F32 * 2` ×1、`*window = 0` ×2
//      （复算：`grep -c '\*window = ' probe_v_align.asc` = 15，减去 3 处走 WindowOfImpl/`op.window`）。
// 两层之间"VARIANT 声明值 == COMPARE 实际值"由**守卫检查 ④**在每次运行时强制核对
// （`tools/check_archive_matches_list.py`，当前 84 条 / 冲突 0），不靠字面共享。
// 该不一致曾出现于 redsum/redmax/lsn：声明值与模型值各写一次。

const OpSpec* FindOp(const char* name, unsigned long len)
{
    for (const OpSpec& s : kOps) {
        if (std::strlen(s.name) == len && std::strncmp(s.name, name, len) == 0) return &s;
    }
    return nullptr;
}

// CastTrait 必须是命名空间作用域的 constexpr（局部 constexpr 作模板实参在本编译器上匹配不到重载）
constexpr CastTrait castB322B16 = {RegLayout::ZERO, SatMode::NO_SAT, MaskMergeMode::ZEROING, RoundMode::CAST_RINT};
constexpr CastTrait castB162B32 = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING, RoundMode::UNKNOWN};
constexpr CastTrait castFp4Round = {RegLayout::ZERO, SatMode::UNKNOWN, MaskMergeMode::ZEROING, RoundMode::CAST_ROUND};

// 变体参数（host 侧解析 argv 得到）
struct VariantArgs {
    const char* op;
    uint32_t a;
    uint32_t b;
    uint32_t n;
};

// window 的有效值（打印 + 两个模型分支 + 三个特例走这里；其余 12 处模型分支的字面量由守卫检查 ④ 兜住）
inline uint32_t WindowOfImpl(const OpSpec& op, uint32_t n)
{
    if (op.id == OP_LSN) return 4 * n;    // 掩码长度相关：n 个 f32 = 4n 字节
    if (op.id == OP_STORE1) return VLB;   // Reg::Store 整寄存器写
    if (op.model == M_RED) return 4;      // 归约只落 lane0
    return op.window;
}

// 挂死类错误码（acl/error_codes/rt_error_codes.h：107020 task timeout / 507046 stream sync timeout）
constexpr int32_t ERR_TASK_TIMEOUT = 107020;
constexpr int32_t ERR_STREAM_SYNC_TIMEOUT = 507046;
constexpr int32_t ERR_VECTOR_CORE_TIMEOUT = 507034;
constexpr int32_t ERR_VECTOR_CORE_EXCEPTION = 507035;
}   // namespace

// ============================================================
// 设备侧
// ============================================================
namespace {

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

// op 分组（显式列举；见 Run() 里的教训）
__aicore__ inline bool IsWidthOp(uint32_t op)
{
    return op >= OP_WIDTH_F32 && op <= OP_ARANGE_S8;
}
__aicore__ inline bool IsClassicOp(uint32_t op)
{
    return op == OP_PLD || op == OP_PSTS || op == OP_DUPUB || op == OP_BRCB;
}
__aicore__ inline bool IsMoveOp(uint32_t op)
{
    switch (op) {
        case OP_LS: case OP_LSN: case OP_LDBRC: case OP_STFIRST: case OP_STPACK: case OP_STPACK4:
        case OP_VLD: case OP_VLDAS: case OP_VSTUS: case OP_LOAD1: case OP_STORE1:
        case OP_GATHER: case OP_GATHERB: case OP_SCATTER:
        case OP_VLDAS_NOPRE: case OP_VSTUS_NOPOST:
            return true;
        default:
            return false;
    }
}

class VAlignProbe {
public:
    __aicore__ inline void Init(GM_ADDR src, GM_ADDR sent, GM_ADDR out, uint32_t op, uint32_t a, uint32_t b,
                                uint32_t n)
    {
        op_ = op;
        a_ = a;
        b_ = b;
        n_ = n;
        srcGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(src), ARENA);
        sentGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(sent), ARENA);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(out), ARENA);
    }

    __aicore__ inline void Process()
    {
        LocalTensor<uint8_t> inL(TPosition::VECCALC, UB_IN, ARENA);
        LocalTensor<uint8_t> outL(TPosition::VECCALC, UB_OUT, ARENA);

        BufAcquire<PIPE_MTE2>(BUF_IN);
        DataCopy(inL, srcGm_[0], ARENA);
        DataCopy(outL, sentGm_[0], ARENA);
        BufRelease<PIPE_MTE2>(BUF_IN);

        __ubuf__ uint8_t* inBase = reinterpret_cast<__ubuf__ uint8_t*>(inL.GetPhyAddr());
        __ubuf__ uint8_t* outBase = reinterpret_cast<__ubuf__ uint8_t*>(outL.GetPhyAddr());
        __ubuf__ float* srcF = reinterpret_cast<__ubuf__ float*>(inBase + a_);
        __ubuf__ float* dstF = reinterpret_cast<__ubuf__ float*>(outBase + b_);

        BufAcquire<PIPE_V>(BUF_IN);
        BufAcquire<PIPE_V>(BUF_OUT);
        Run(srcF, dstF, inBase, outBase);
        BufRelease<PIPE_V>(BUF_IN);
        BufRelease<PIPE_V>(BUF_OUT);

        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(outGm_[0], outL, ARENA);
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    __aicore__ inline void Run(__ubuf__ float* srcF, __ubuf__ float* dstF, __ubuf__ uint8_t* inBase,
                               __ubuf__ uint8_t* outBase)
    {
        if (op_ == OP_VNOOP) return;
        // **注意**：分派必须按 op **显式列举**，不能按 id 大小分段——新增 op 一旦取到比
        // OP_DUPREG 大的编号就会掉进 RunArith 而静默变成 no-op（本探针初版就是这样把
        // vldasnopre/vstusnopost/psts 三个变体跑成"0 字节落盘"的：无故障、无输出，
        // 看起来像"缺 init 就会不写"，其实是分派根本没进那段代码）。该教训写进 README §9。
        if (IsWidthOp(op_)) {
            RunWidth(inBase, outBase);
        } else if (IsClassicOp(op_)) {
            RunClassic(inBase, outBase);
        } else if (IsMoveOp(op_)) {
            RunMove(srcF, dstF, inBase, outBase);
        } else {
            RunArith(dstF, srcF);
        }
    }

    // ---------------- 搬移/访存族 ----------------
    __aicore__ inline void RunMove(__ubuf__ float* srcF, __ubuf__ float* dstF, __ubuf__ uint8_t* inBase,
                                   __ubuf__ uint8_t* outBase)
    {
        switch (op_) {
            case OP_LS: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_LSN: {
                uint32_t cnt = n_;
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg m = UpdateMask<float>(cnt);
                    LoadAlign(v, srcF);
                    StoreAlign(dstF, v, m);
                }
                break;
            }
            case OP_VLDAS_NOPRE: {
                // 负向对照：**缺** `LoadUnAlignPre`（init），直接 `LoadUnAlign`（vldus）
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    UnalignRegForLoad ureg;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadUnAlign(v, ureg, srcF);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_VSTUS_NOPOST: {
                // 负向对照：**缺** `StoreUnAlignPost`（post）——有状态 store 只发 vstus
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    UnalignRegForStore ureg;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    StoreUnAlign(dstF, v, ureg, VL_F32);
                }
                break;
            }
            case OP_LDBRC: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign<float, LoadDist::DIST_BRC_B32>(v, srcF);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_STFIRST: {
                uint32_t one = 1;
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg m = UpdateMask<float>(one);
                    LoadAlign(v, srcF);
                    StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(dstF, v, m);
                }
                break;
            }
            case OP_STPACK: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    RegTensor<bfloat16_t> vb;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    Cast<bfloat16_t, float, castB322B16>(vb, v, full);
                    StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(reinterpret_cast<__ubuf__ bfloat16_t*>(dstF), vb,
                                                                     full);
                }
                break;
            }
            case OP_STPACK4: {
                __VEC_SCOPE__
                {
                    RegTensor<bfloat16_t> vb;
                    RegTensor<fp4x2_e2m1_t> v4;
                    MaskReg full = CreateMask<bfloat16_t, MaskPattern::ALL>();
                    LoadAlign<bfloat16_t, LoadDist::DIST_NORM>(vb, reinterpret_cast<__ubuf__ bfloat16_t*>(srcF));
                    Cast<fp4x2_e2m1_t, bfloat16_t, castFp4Round>(v4, vb, full);
                    StoreAlign<int8_t, StoreDist::DIST_PACK4_B32>(reinterpret_cast<__ubuf__ int8_t*>(dstF),
                                                                  (RegTensor<int8_t>&)v4, full);
                }
                break;
            }
            case OP_VLD: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    // 后端硬约束：VAG intrinsic 只能在循环里发射（否则 "VAG intrinsic can only be used in loop!"）
                    for (uint16_t i = 0; i < 1; ++i) {
                        AddrReg areg = CreateAddrReg<float>(0, 1);
                        LoadAlign(v, srcF, areg);
                        StoreAlign(dstF, v, full);
                    }
                }
                break;
            }
            case OP_VLDAS: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    UnalignRegForLoad ureg;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadUnAlignPre(ureg, srcF);
                    LoadUnAlign(v, ureg, srcF);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_VSTUS: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    UnalignRegForStore ureg;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    StoreUnAlign(dstF, v, ureg, VL_F32);
                    StoreUnAlignPost(dstF, ureg, VL_F32);
                }
                break;
            }
            case OP_LOAD1: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    Load(v, srcF);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_STORE1: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    LoadAlign(v, srcF);
                    Store(dstF, v, n_);
                }
                break;
            }
            case OP_GATHER: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    RegTensor<int32_t> idxI;
                    RegTensor<uint32_t>& idx = reinterpret_cast<RegTensor<uint32_t>&>(idxI);
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    Arange(idxI, static_cast<int32_t>(0));
                    Gather(v, srcF, idx, full);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_GATHERB: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    RegTensor<int32_t> idxI;
                    RegTensor<uint32_t>& idx = reinterpret_cast<RegTensor<uint32_t>&>(idxI);
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    Arange(idxI, static_cast<int32_t>(0));
                    GatherB(v, srcF, idx, full);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_SCATTER: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    RegTensor<int32_t> idxI;
                    RegTensor<uint32_t>& idx = reinterpret_cast<RegTensor<uint32_t>&>(idxI);
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    Arange(idxI, static_cast<int32_t>(0));
                    LoadAlign(v, srcF);
                    Scatter(dstF, v, idx, full);
                }
                break;
            }
            default:
                break;
        }
    }

    // ---------------- 谓词 / 经典 memory-based 族 ----------------
    __aicore__ inline void RunClassic(__ubuf__ uint8_t* inBase, __ubuf__ uint8_t* outBase)
    {
        __ubuf__ float* dstF = reinterpret_cast<__ubuf__ float*>(outBase + b_);
        __ubuf__ float* srcF = reinterpret_cast<__ubuf__ float*>(inBase + a_);
        switch (op_) {
            case OP_DUPUB: {
                // 例外（docs/18 §6.1 / docs/17 §1.1）：被探对象**就是**经典 memory-based Duplicate
                // 的 UB 目的地址对齐要求（507015 历史现场）；寄存器侧 Duplicate 目的在寄存器，
                // 不存在 UB 对齐问题 ⇒ 该问题无法用 VF 形式覆盖。
                LocalTensor<float> dst(TPosition::VECCALC, UB_OUT + b_, VL_F32);
                AscendC::Duplicate(dst, FILL_CONST, VL_F32);
                break;
            }
            case OP_BRCB: {
                // 例外：3510 的 Reg 侧**没有** Brcb（穷举 grep 0 命中），只有经典 API；
                // 被探对象是经典的 UB 目的对齐要求。
                // **实测教训（修复前的归档行，已按 §10 的口径从归档里删除、不留同名旧文件）**：
                // 初版把源也取在 OUT arena 且 a==b==0 ⇒ 源与目的同址，
                // `Brcb` 内部 `ASCENDC_DEBUG_ASSERT(src0.GetPhyAddr() != dst.GetPhyAddr())` 判定失败，
                // 结果是**无故障但 0 字节落盘**（当时记为 OUTCOME: WRONG）。现在源固定取 IN arena
                //（与目的不同址），a 只用于探源地址；本 commit 的归档里 brcb 的 b=0 点是 OK（窗口 256B）。
                LocalTensor<float> dst(TPosition::VECCALC, UB_OUT + b_, VL_F32);
                LocalTensor<float> src(TPosition::VECCALC, UB_IN + a_, VL_F32);
                BrcbRepeatParams rp{1, 8};
                AscendC::Brcb(dst, src, 1, rp);
                break;
            }
            case OP_PSTS: {
                // 谓词落盘（psts）：先造一个全 1 掩码，再按被探偏移落盘 —— 这是"谓词 store 的地址要求"
                // 的干净靶子（此前 pld 的 load→store 往返因为源数据产生的掩码位太少而 0 字节落盘）
                __VEC_SCOPE__
                {
                    MaskReg m = CreateMask<float, MaskPattern::ALL>();
                    StoreAlign<float, MaskDist::DIST_NORM>(dstF, m);
                }
                break;
            }
            case OP_PLD: {
                // 谓词 load（plds）：从被探偏移取掩码，再落盘到**32B 对齐**处观察
                __VEC_SCOPE__
                {
                    MaskReg m;
                    LoadAlign<float, MaskDist::DIST_NORM>(m, srcF);
                    StoreAlign<float, MaskDist::DIST_NORM>(dstF, m);
                }
                break;
            }
            default:
                break;
        }
    }

    // ---------------- 算术 / 类型转换族（无 UB 地址操作数）----------------
    // 这些 op 的 VB 地址只有"相邻 load/store"那一处 ⇒ 探针把被探偏移放在**落盘地址 b** 上：
    // b=0 通过、b=4 报 507035 ⇒ 证明该要求属于 store，而不属于算子本身。
    __aicore__ inline void RunArith(__ubuf__ float* dstF, __ubuf__ float* srcF)
    {
        switch (op_) {
            case OP_DUPREG: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    Duplicate(v, FILL_CONST);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_ADD: {
                __VEC_SCOPE__
                {
                    RegTensor<float> x, y, v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(x, srcF);
                    LoadAlign(y, srcF + 32);
                    Add(v, x, y, full);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_MUL: {
                __VEC_SCOPE__
                {
                    RegTensor<float> x, y, v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(x, srcF);
                    LoadAlign(y, srcF + 32);
                    Mul(v, x, y, full);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_EXP: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    Exp(v, v, full);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_REDSUM:
            case OP_REDMAX: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v, r;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    MaskReg one = CreateMask<float, MaskPattern::VL1>();
                    LoadAlign(v, srcF);
                    if (op_ == OP_REDSUM) {
                        Reduce<ReduceType::SUM>(r, v, full);
                    } else {
                        Reduce<ReduceType::MAX>(r, v, full);
                    }
                    // 实测：归约结果落在 lane0；用 VL1 掩码只落 lane0，其余 lane 不作断言
                    StoreAlign(dstF, r, one);
                }
                break;
            }
            case OP_CMPSEL: {
                __VEC_SCOPE__
                {
                    RegTensor<float> x, v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    MaskReg cmp = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(x, srcF);
                    Compares<float, CMPMODE::LE>(cmp, x, 16.0f, full);
                    Duplicate(v, -1.0f);
                    Select<float>(v, x, v, cmp);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_ARANGE: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    Arange(v, 0.0f);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_F32BF16_NORM: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    RegTensor<bfloat16_t> vb;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    Cast<bfloat16_t, float, castB322B16>(vb, v, full);
                    StoreAlign(reinterpret_cast<__ubuf__ bfloat16_t*>(dstF), vb, full);
                }
                break;
            }
            case OP_F32BF16_NORMB16: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    RegTensor<bfloat16_t> vb;
                    MaskReg fullF = CreateMask<float, MaskPattern::ALL>();
                    MaskReg fullB = CreateMask<bfloat16_t, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    Cast<bfloat16_t, float, castB322B16>(vb, v, fullF);
                    StoreAlign(reinterpret_cast<__ubuf__ bfloat16_t*>(dstF), vb, fullB);
                }
                break;
            }
            case OP_F32BF16_PACK: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    RegTensor<bfloat16_t> vb;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    Cast<bfloat16_t, float, castB322B16>(vb, v, full);
                    StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(reinterpret_cast<__ubuf__ bfloat16_t*>(dstF), vb,
                                                                     full);
                }
                break;
            }
            case OP_BF16F32_NORM: {
                __VEC_SCOPE__
                {
                    RegTensor<bfloat16_t> vb;
                    RegTensor<float> v;
                    MaskReg full = CreateMask<bfloat16_t, MaskPattern::ALL>();
                    LoadAlign<bfloat16_t, LoadDist::DIST_NORM>(vb, reinterpret_cast<__ubuf__ bfloat16_t*>(srcF));
                    Cast<float, bfloat16_t, castB162B32>(v, vb, full);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_BF16F32_UNPK: {
                __VEC_SCOPE__
                {
                    RegTensor<bfloat16_t> vb;
                    RegTensor<float> v;
                    MaskReg full = CreateMask<bfloat16_t, MaskPattern::ALL>();
                    LoadAlign<bfloat16_t, LoadDist::DIST_UNPACK_B16>(vb,
                                                                     reinterpret_cast<__ubuf__ bfloat16_t*>(srcF));
                    Cast<float, bfloat16_t, castB162B32>(v, vb, full);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_LMBAR_IN: {
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            case OP_LMBAR_OUT: {
                // 用户结论 ④ 的靶子：LocalMemBar 在 __VEC_SCOPE__ **外**（标量相位）
                LocalMemBar<MemType::VEC_STORE, MemType::VEC_LOAD>();
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(v, srcF);
                    StoreAlign(dstF, v, full);
                }
                break;
            }
            default:
                break;
        }
    }

    // ---------------- 位宽 / lane 数标定 ----------------
    __aicore__ inline void RunWidth(__ubuf__ uint8_t* inBase, __ubuf__ uint8_t* outBase)
    {
        switch (op_) {
            case OP_WIDTH_F32: {
                __ubuf__ float* d = reinterpret_cast<__ubuf__ float*>(outBase);
                __VEC_SCOPE__
                {
                    RegTensor<float> v;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    Duplicate(v, FILL_CONST);
                    StoreAlign(d, v, full);
                }
                break;
            }
            case OP_WIDTH_BF16: {
                __ubuf__ bfloat16_t* d = reinterpret_cast<__ubuf__ bfloat16_t*>(outBase);
                __VEC_SCOPE__
                {
                    RegTensor<bfloat16_t> v;
                    MaskReg full = CreateMask<bfloat16_t, MaskPattern::ALL>();
                    Duplicate(v, FILL_CONST);
                    StoreAlign(d, v, full);
                }
                break;
            }
            case OP_WIDTH_S16: {
                __ubuf__ int16_t* d = reinterpret_cast<__ubuf__ int16_t*>(outBase);
                __VEC_SCOPE__
                {
                    RegTensor<int16_t> v;
                    MaskReg full = CreateMask<int16_t, MaskPattern::ALL>();
                    Duplicate(v, static_cast<int16_t>(7));
                    StoreAlign(d, v, full);
                }
                break;
            }
            case OP_WIDTH_S8: {
                __ubuf__ int8_t* d = reinterpret_cast<__ubuf__ int8_t*>(outBase);
                __VEC_SCOPE__
                {
                    RegTensor<int8_t> v;
                    MaskReg full = CreateMask<int8_t, MaskPattern::ALL>();
                    Duplicate(v, static_cast<int8_t>(7));
                    StoreAlign(d, v, full);
                }
                break;
            }
            case OP_ARANGE_S32: {
                __ubuf__ int32_t* d = reinterpret_cast<__ubuf__ int32_t*>(outBase);
                __VEC_SCOPE__
                {
                    RegTensor<int32_t> v;
                    MaskReg full = CreateMask<int32_t, MaskPattern::ALL>();
                    Arange(v, static_cast<int32_t>(0));
                    StoreAlign(d, v, full);
                }
                break;
            }
            case OP_ARANGE_S16: {
                __ubuf__ int16_t* d = reinterpret_cast<__ubuf__ int16_t*>(outBase);
                __VEC_SCOPE__
                {
                    RegTensor<int16_t> v;
                    MaskReg full = CreateMask<int16_t, MaskPattern::ALL>();
                    Arange(v, static_cast<int16_t>(0));
                    StoreAlign(d, v, full);
                }
                break;
            }
            case OP_ARANGE_S8: {
                __ubuf__ int8_t* d = reinterpret_cast<__ubuf__ int8_t*>(outBase);
                __VEC_SCOPE__
                {
                    RegTensor<int8_t> v;
                    MaskReg full = CreateMask<int8_t, MaskPattern::ALL>();
                    Arange(v, static_cast<int8_t>(0));
                    StoreAlign(d, v, full);
                }
                break;
            }
            default:
                break;
        }
        (void)inBase;
    }

    uint32_t op_ = 0;
    uint32_t a_ = 0;
    uint32_t b_ = 0;
    uint32_t n_ = VL_F32;
    GlobalTensor<uint8_t> srcGm_;
    GlobalTensor<uint8_t> sentGm_;
    GlobalTensor<uint8_t> outGm_;
};

}   // namespace

__vector__ __global__ void probe_v_align_kernel(GM_ADDR src, GM_ADDR sent, GM_ADDR out, uint32_t op, uint32_t a,
                                                uint32_t b, uint32_t n)
{
    VAlignProbe probe;
    probe.Init(src, sent, out, op, a, b, n);
    probe.Process();
}

// ============================================================
// host 侧
// ============================================================
namespace {

// ============================================================
// 变体矩阵：分三种生成策略（都由 `list` 打印，第三列起是参数，最后是分组标签 group）
//   full：**完整扫描** {0,1,2,4,8,16,24,32} —— 主族 vlds/vsts 的完整性证据（不提前停）
//   ad  ：**自适应降序** {0,16,8,4,2,1}，runner 在**首个故障**处停止该组 —— 由"对齐要求必是
//         32 的 2 幂因子（1/2/4/8/16/32）"这一分类假设，降序首个故障点即给出最小对齐：
//           16 故障 ⇒ 32B（8 的倍数都会通过 16，故 16 故障排除 1..16）
//           16 通过、8 故障 ⇒ 16B；8 通过、4 故障 ⇒ 8B；…；1 也通过 ⇒ 1B
//   len ：**长度维度**（地址固定 32B 对齐） —— 掩码长度 n 是否影响落盘字节数/地址要求
//   pt  ：固定单点（位宽/lane 标定）
// ============================================================
const uint32_t SWEEP_FULL[8] = {0, 1, 2, 4, 8, 16, 24, 32};
const uint32_t SWEEP_AD[6] = {0, 16, 8, 4, 2, 1};

struct AxisSpec {
    const char* op;
    uint32_t axis;      // 1 = 扫源地址 a，2 = 扫目的地址 b
    uint32_t n;
};

// full：vlds/vsts 主族（完整性证据：所有 <32B 的偏移逐点实测）
const AxisSpec kFullAxes[] = {
    {"ls", 1, VL_F32},
    {"ls", 2, VL_F32},
    // `vld` 是唯一与直觉分组相反的结论（AddrReg 形态看着像 unaligned，实测仍严格 32B）⇒ 值得完整扫描；
    // `gather` 一并升格，确证它的 4B 是真 4B 而不是 2B 处换了一种故障模式。
    // （两条都是为了让"完整扫描 / 降序推断"在总表里逐行可辨，见 README §3 的「判定方式」列。）
    {"vld", 1, VL_F32},
    {"gather", 1, VL_F32},
};

// ad：其余访存族 + 寄存器族（寄存器族只探落盘地址：0 通过 / 首个非对齐故障 ⇒ 要求属于 store）
const AxisSpec kAdAxes[] = {
    // 单元素 / 广播 / pack
    {"ldbrc", 1, VL_F32},
    {"stfirst", 2, VL_F32},
    {"stpack", 2, VL_F32},
    {"stpack4", 2, VL_F32},
    // 非对齐 / 有状态族（vld 已升为 full 组）
    {"vldas", 1, VL_F32},
    {"vstus", 2, VL_F32},
    {"load1", 1, VL_F32},
    {"store1", 2, VL_F32},
    // gather / scatter（gather 已升为 full 组）
    {"gatherb", 1, VL_F32},
    {"scatter", 2, VL_F32},
    // 谓词 load/store（源、目的两侧）
    {"pld", 1, VL_F32},
    // 经典 memory-based（目的地址）
    {"dupub", 2, VL_F32},
    {"brcb", 2, VL_F32},
    // 寄存器族：落盘地址
    {"dupreg", 2, VL_F32},
    {"add", 2, VL_F32},
    {"mul", 2, VL_F32},
    {"exp", 2, VL_F32},
    {"redsum", 2, VL_F32},
    {"redmax", 2, VL_F32},
    {"cmpsel", 2, VL_F32},
    {"arange", 2, VL_F32},
    {"f32bf16norm", 2, VL_F32},
    {"f32bf16nb16", 2, VL_F32},
    {"f32bf16pack", 2, VL_F32},
    {"bf16f32norm", 2, VL_F32},
    {"bf16f32unpk", 2, VL_F32},
    {"lmbarin", 2, VL_F32},
    {"lmbarout", 2, VL_F32},
};

// nc：负向对照（定点单跑）——有状态族**缺** init/post 时的表现（偏移取 1B：vldas/vstus 本身接受 1B，
//     所以"缺 init/post 后结果还对不对"才是被观测量；若放在降序组里，store 侧会先在对齐点停组测不到 1B）
struct NcSpec {
    const char* op;
    uint32_t a;
    uint32_t b;
    uint32_t n;
};
const NcSpec kNcAxes[] = {
    {"vldasnopre", 1, 0, VL_F32},
    {"vstusnopost", 0, 1, VL_F32},
    {"psts", 0, 0, VL_F32},        // 谓词落盘：32B 对齐对照
    {"psts", 0, 16, VL_F32},       // 谓词落盘：16B 非对齐（探它的地址要求）
};

// len：长度维度（地址固定 32B 对齐）——掩码长度 n 是否改变落盘字节数
const AxisSpec kLenAxes[] = {
    {"lsn", 0, 1},
    {"lsn", 0, 3},
    {"lsn", 0, 7},
    {"lsn", 0, 8},
    {"lsn", 0, 63},
    {"lsn", 0, 64},
};

// pt：位宽/lane 标定（32B 对齐、单点）
const AxisSpec kPointAxes[] = {
    {"widthf32", 0, VL_F32},
    {"widthbf16", 0, VL_F32},
    {"widths16", 0, VL_F32},
    {"widths8", 0, VL_F32},
    {"aranges32", 0, VL_F32},
    {"aranges16", 0, VL_F32},
    {"aranges8", 0, VL_F32},
    {"vnoop", 0, VL_F32},
};

const OpSpec* OpByName(const char* name)
{
    return FindOp(name, std::strlen(name));
}

void PrintList()
{
    uint32_t total = 0;
    for (const AxisSpec& ax : kFullAxes) total += 8;
    for (const AxisSpec& ax : kAdAxes) total += 6;
    for (const AxisSpec& ax : kLenAxes) total += 1;
    for (const AxisSpec& ax : kPointAxes) total += 1;
    total += sizeof(kNcAxes) / sizeof(kNcAxes[0]);
    std::printf("# probe_v_align：full %lu 组 x8 + ad %lu 组 x6 + pt %lu 组 x1 => 上限 %u 条"
                "（ad 组在首个故障处停，实际条数更少）\n",
                static_cast<unsigned long>(sizeof(kFullAxes) / sizeof(kFullAxes[0])),
                static_cast<unsigned long>(sizeof(kAdAxes) / sizeof(kAdAxes[0])),
                static_cast<unsigned long>(sizeof(kPointAxes) / sizeof(kPointAxes[0])), total);
    const uint32_t nlen = 1;
    (void)nlen;
    for (const AxisSpec& ax : kFullAxes) {
        for (uint32_t off : SWEEP_FULL) {
            const uint32_t a = (ax.axis == 1) ? off : 0;
            const uint32_t b = (ax.axis == 2) ? off : 0;
            std::printf("%s %u %u %u full:%s:%u\n", ax.op, a, b, ax.n, ax.op, ax.axis);
        }
    }
    for (const AxisSpec& ax : kAdAxes) {
        for (uint32_t off : SWEEP_AD) {
            const uint32_t a = (ax.axis == 1) ? off : 0;
            const uint32_t b = (ax.axis == 2) ? off : 0;
            std::printf("%s %u %u %u ad:%s:%u:%u\n", ax.op, a, b, ax.n, ax.op, ax.axis, ax.n);
        }
    }
    for (const AxisSpec& ax : kLenAxes) {
        std::printf("%s 0 0 %u len:%s:%u\n", ax.op, ax.n, ax.op, ax.n);
    }
    for (const AxisSpec& ax : kPointAxes) {
        std::printf("%s 0 0 %u pt:%s\n", ax.op, ax.n, ax.op);
    }
    for (const NcSpec& ax : kNcAxes) {
        std::printf("%s %u %u %u nc:%s\n", ax.op, ax.a, ax.b, ax.n, ax.op);
    }
}

void FillSrc(uint8_t* src, size_t bytes)
{
    float* f = reinterpret_cast<float*>(src);
    for (size_t i = 0; i < bytes / sizeof(float); ++i) {
        f[i] = static_cast<float>(i) + 0.5f;
    }
}

// bf16 RNE（尾数 8 位；与仓库 host 侧参考同式）
uint16_t Bf16Rne(float x)
{
    uint32_t bits;
    std::memcpy(&bits, &x, 4);
    const uint32_t lsb = (bits >> 16) & 1u;
    bits += 0x7FFFu + lsb;
    return static_cast<uint16_t>(bits >> 16);
}

// 期望模型：返回 0=完全匹配，1=有差异（并把首个差异偏移写入 firstBad）
int CompareModel(const OpSpec& op, const VariantArgs& v, const uint8_t* src, const uint8_t* got,
                 uint32_t* firstBad, uint32_t* window, uint32_t* outsideWritten)
{
    uint8_t want[ARENA];
    std::memset(want, SENTINEL, ARENA);
    const uint32_t b = v.b;
    const uint32_t a = v.a;
    uint32_t win = WindowOfImpl(op, v.n);

    switch (op.model) {
        case M_NONE:
            *window = 0;
            *outsideWritten = 0;
            return -1;   // 不判（控制组）
        case M_BYTESHIFT: {
            win = WindowOfImpl(op, v.n);
            for (uint32_t i = 0; i < win; ++i) want[b + i] = src[a + i];
            *window = win;
            break;
        }
        case M_CONSTF32: {
            float* w = reinterpret_cast<float*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) w[i] = FILL_CONST;
            *window = VLB;
            break;
        }
        case M_BRC: {
            float sv;
            std::memcpy(&sv, src + a, 4);
            float* w = reinterpret_cast<float*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) w[i] = sv;
            *window = VLB;
            break;
        }
        case M_ADD:
        case M_MUL: {
            const float* s = reinterpret_cast<const float*>(src);
            float* w = reinterpret_cast<float*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) {
                w[i] = (op.model == M_ADD) ? (s[i] + s[i + 32]) : (s[i] * s[i + 32]);
            }
            *window = VLB;
            break;
        }
        case M_ARANGE_F32: {
            float* w = reinterpret_cast<float*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) w[i] = static_cast<float>(i);
            *window = VLB;
            break;
        }
        case M_F32BF16_PACK: {
            const float* s = reinterpret_cast<const float*>(src);
            uint16_t* w = reinterpret_cast<uint16_t*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) w[i] = Bf16Rne(s[i]);
            *window = VL_F32 * 2;
            break;
        }
        case M_F32BF16_NORM: {
            const float* s = reinterpret_cast<const float*>(src);
            uint16_t* w = reinterpret_cast<uint16_t*>(want + b);
            // 实测（dump 逐字节）：Cast<bf16,float> 后的落盘把第 i 个值放在**偶数** 16-bit lane
            // （= 每个 32-bit lane 的低半，字节 4i..4i+2），奇数 16-bit lane（字节 4i+2..4i+4）保持
            // sentinel ⇒ "每 32-bit lane 一个 bf16"的展开（unpacked）布局。
            for (uint32_t i = 0; i < VL_F32; ++i) {
                w[2 * i] = Bf16Rne(s[i]);
            }
            *window = VLB;
            break;
        }
        case M_BF16F32_NORM: {
            const uint16_t* s = reinterpret_cast<const uint16_t*>(src + a);
            float* w = reinterpret_cast<float*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) {
                const uint32_t bits = static_cast<uint32_t>(s[(2 * i) % VL_B16]) << 16;
                std::memcpy(&w[i], &bits, 4);
            }
            *window = VLB;
            break;
        }
        case M_BF16F32_UNPK: {
            const uint16_t* s = reinterpret_cast<const uint16_t*>(src + a);
            float* w = reinterpret_cast<float*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) {
                const uint32_t bits = static_cast<uint32_t>(s[i % VL_B16]) << 16;
                std::memcpy(&w[i], &bits, 4);
            }
            *window = VLB;
            break;
        }
        case M_F32BF16_NORMB16: {
            const float* s = reinterpret_cast<const float*>(src);
            uint16_t* w = reinterpret_cast<uint16_t*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) w[2 * i] = Bf16Rne(s[i]);   // 偶数 lane 判位
            *window = VLB;
            uint32_t bad = 0;
            for (uint32_t i = 0; i < VL_F32; ++i) {
                if (got[b + 4 * i] != want[b + 4 * i] || got[b + 4 * i + 1] != want[b + 4 * i + 1]) {
                    if (bad == 0) *firstBad = b + 4 * i;
                    ++bad;
                }
            }
            uint32_t oddWritten = 0;
            for (uint32_t i = 0; i < VL_F32; ++i) {
                if (got[b + 4 * i + 2] != SENTINEL || got[b + 4 * i + 3] != SENTINEL) ++oddWritten;
            }
            *outsideWritten = oddWritten;   // 报告项：奇数 16-bit lane 被写的个数
            return (bad == 0) ? 0 : 1;
        }
        case M_CMPSEL: {
            const float* s = reinterpret_cast<const float*>(src + a);
            float* w = reinterpret_cast<float*>(want + b);
            for (uint32_t i = 0; i < VL_F32; ++i) {
                w[i] = (s[i] <= 16.0f) ? s[i] : -1.0f;
            }
            *window = VLB;
            break;
        }
        case M_RED: {
            // 归约结果只写 lane0（设备侧用 VL1 掩码落盘，写出字节数 = WindowOf）；值是精确可算的：
            //   redsum: Σ f(i) = Σ (i+0.5), i<64 = 2048；redmax: max = 63.5
            const float* s = reinterpret_cast<const float*>(src + a);
            double acc = 0.0;
            float mx = s[0];
            for (uint32_t i = 0; i < VL_F32; ++i) {
                acc += static_cast<double>(s[i]);
                if (s[i] > mx) mx = s[i];
            }
            const float want0 = (op.id == OP_REDSUM) ? static_cast<float>(acc) : mx;
            std::memcpy(&want[b], &want0, 4);
            *window = WindowOfImpl(op, v.n);
            break;
        }
        case M_EXP:
        case M_NONEMPTY: {
            *window = op.window;
            // 结构性：窗口首字节必须被写过；窗口内至少 4 个 lane 非 sentinel
            if (got[b] == SENTINEL) {
                *firstBad = b;
                return 1;
            }
            uint32_t nz = 0;
            for (uint32_t i = 0; i < op.window; ++i) {
                if (got[b + i] != SENTINEL) ++nz;
            }
            if (nz < 4) {
                *firstBad = b;
                return 1;
            }
            uint32_t out = 0;
            for (uint32_t i = 0; i < ARENA; ++i) {
                if (i < b || i >= b + op.window) {
                    if (op.model == M_NONEMPTY && got[i] != SENTINEL) ++out;
                }
            }
            *outsideWritten = out;
            (void)want;
            return 0;
        }
        default:
            *window = 0;
            *outsideWritten = 0;
            return -1;
    }

    uint32_t bad = 0;
    for (uint32_t i = 0; i < ARENA; ++i) {
        if (got[i] != want[i]) {
            if (bad == 0) *firstBad = i;
            ++bad;
        }
    }
    {   // 窗口外被写：单独报告（掩码 store 是否静默写整 32B 块，就看这个数）
        uint32_t out = 0;
        for (uint32_t i = 0; i < ARENA; ++i) {
            if ((i < b || i >= b + *window) && got[i] != SENTINEL) ++out;
        }
        *outsideWritten = out;
    }
    return (bad == 0) ? 0 : 1;
}

}   // namespace

int main(int argc, char** argv)
{
    if (argc >= 2 && std::strcmp(argv[1], "list") == 0) {
        PrintList();
        return 0;
    }
    if (argc < 6 || std::strcmp(argv[1], "run") != 0) {
        std::fprintf(stderr, "usage: %s list | run <op> <a> <b> <n> [dumpdir]\n", argv[0]);
        return 2;
    }
    const char* dumpDir = (argc >= 7) ? argv[6] : nullptr;
    VariantArgs v{argv[2], static_cast<uint32_t>(std::atoi(argv[3])), static_cast<uint32_t>(std::atoi(argv[4])),
                  static_cast<uint32_t>(std::atoi(argv[5]))};
    const OpSpec* op = OpByName(v.op);
    if (op == nullptr) {
        std::fprintf(stderr, "unknown op %s\n", v.op);
        return 2;
    }
    std::printf("VARIANT op=%s(id=%u) a=%u b=%u n=%u model=%u window=%u\n", v.op, op->id, v.a, v.b, v.n, op->model,
                WindowOfImpl(*op, v.n));

    static uint8_t srcHost[ARENA];
    static uint8_t got[ARENA];
    FillSrc(srcHost, ARENA);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    void* dSrc = nullptr;
    void* dSent = nullptr;
    void* dOut = nullptr;
    aclrtMalloc(&dSrc, ARENA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dSent, ARENA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOut, ARENA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(dSrc, ARENA, srcHost, ARENA, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dSent, ARENA, SENTINEL, ARENA);
    aclrtMemset(dOut, ARENA, 0x00, ARENA);

    probe_v_align_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(dSrc),
                                           reinterpret_cast<uint8_t*>(dSent),
                                           reinterpret_cast<uint8_t*>(dOut), op->id, v.a, v.b, v.n);
    const aclError err = aclrtSynchronizeStreamWithTimeout(stream, SYNC_TIMEOUT_MS);
    std::printf("LAUNCH aclError=%d (sync timeout=%dms)\n", static_cast<int>(err), SYNC_TIMEOUT_MS);

    int rc = 2;
    if (err != ACL_SUCCESS) {
        const char* msg = aclGetRecentErrMsg();
        std::printf("FAULT_CODE %d\n", static_cast<int>(err));
        std::printf("FAULT_MSG %s\n", (msg != nullptr) ? msg : "(null)");
        // 507046 = **host 侧同步窗口到期**（共享设备上可能只是排队，不构成设备侧结论）
        // 507034 / 107020 = 设备侧超时（向量核自身挂死）
        const char* kind = (err == ERR_VECTOR_CORE_TIMEOUT || err == ERR_TASK_TIMEOUT) ? "HANG" :
                           (err == ERR_STREAM_SYNC_TIMEOUT) ? "NOSYNC" : "FAULT";
        std::printf("OUTCOME: %s\n", kind);
        std::printf("RESULT: SKIPPED (%s, rc=%d)\n", kind, static_cast<int>(err));
    } else {
        aclrtMemcpy(got, ARENA, dOut, ARENA, ACL_MEMCPY_DEVICE_TO_HOST);
        if (dumpDir != nullptr) {
            char path[512];
            std::snprintf(path, sizeof(path), "%s/va_%s_a%u_b%u_n%u.bin", dumpDir, v.op, v.a, v.b, v.n);
            FILE* f = std::fopen(path, "wb");
            if (f != nullptr) {
                std::fwrite(got, 1, ARENA, f);
                std::fclose(f);
            }
        }
        // 指纹（便于 review 快速比对；完整证据是 .bin dump）
        uint64_t h = 1469598103934665603ULL;
        for (uint32_t i = 0; i < ARENA; ++i) {
            h ^= got[i];
            h *= 1099511628211ULL;
        }
        uint32_t w0[8];
        std::memcpy(w0, got, sizeof(w0));
        std::printf("DUMP_FNV 0x%016llx\n", static_cast<unsigned long long>(h));
        std::printf("HEAD32 %08x %08x %08x %08x\n", w0[0], w0[1], w0[2], w0[3]);

        uint32_t firstBad = 0, window = 0, outside = 0;
        const int cmp = CompareModel(*op, v, srcHost, got, &firstBad, &window, &outside);
        std::printf("COMPARE window_bytes=%u bytes_outside_window_written=%u\n", window, outside);
        if (cmp < 0) {
            std::printf("OUTCOME: OK\n");
            std::printf("RESULT: OK (no model: control variant, %u bytes dumped)\n", ARENA);
            rc = 0;
        } else if (cmp == 0) {
            // 文案按**模型档位**分：字节模型才说 "bitwise model match"；
            // 结构性模型说清它到底检查了什么（docs/17 §2.1 + 广播规则"运行时断言文字必须与同 commit 事实一致"）
            const bool byteModel = (op->model == M_BYTESHIFT || op->model == M_CONSTF32 || op->model == M_BRC ||
                                    op->model == M_ADD || op->model == M_MUL || op->model == M_ARANGE_F32 ||
                                    op->model == M_F32BF16_PACK || op->model == M_F32BF16_NORM ||
                                    op->model == M_BF16F32_NORM || op->model == M_BF16F32_UNPK ||
                                    op->model == M_CMPSEL || op->model == M_RED);
            uint32_t winNz = 0;
            for (uint32_t i = 0; i < window && i < ARENA; ++i) {
                if (got[i] != SENTINEL) ++winNz;
            }
            std::printf("OUTCOME: OK\n");
            if (byteModel) {
                std::printf("RESULT: OK (bitwise model match over %u bytes; %u/%u bytes compared)\n", ARENA, ARENA,
                            ARENA);
            } else if (op->model == M_F32BF16_NORMB16) {
                std::printf("RESULT: OK (partial bitwise: even 16-bit lanes == model; odd lanes report-only; "
                            "%u bytes compared)\n", window);
            } else {
                std::printf("RESULT: OK (structural only: model=%u; window %uB non-empty, %u non-sentinel bytes, "
                            "%u bytes written outside window)\n", op->model, window, winNz, outside);
            }
            rc = 0;
        } else {
            std::printf("MISMATCH first_bad_off=%u\n", firstBad);
            std::printf("OUTCOME: WRONG\n");
            std::printf("RESULT: FAIL (first mismatch at byte %u of %u)\n", firstBad, ARENA);
            rc = 1;
        }
    }

    aclrtFree(dSrc);
    aclrtFree(dSent);
    aclrtFree(dOut);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return rc;
}
