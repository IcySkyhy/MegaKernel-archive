/**
 * probe_v_ildl.asc —— M57 附：`Reg::Interleave` / `Reg::DeInterleave` 的**精确语义**实测
 * （M35 交接的悬案：元素级还是 block 级、对源/目标对齐的要求、是否配对使用、
 *   窄位宽(b16)与宽位宽(f32)两条方向的差异；每条给出**可判定的正例 + 反例**）
 *
 * 为什么需要实测：CANN 9.1.0 里 `vintlv`/`vdintlv` 是**编译器/硬件内建**，头文件里没有任何
 * lane 映射说明（只有 `doxygen` 一句 "Interleave src0 and src1 to dst0 and dst1"），
 * `sizeLine` 这个符号在整个 CANN 树里 **0 命中**。⇒ 语义只能实测标定。
 * 本文件的实测口径 = 逐 lane 的**值级/位级**比对（docs/17 T1），不是"看起来对"。
 *
 * 数据契约（host 生成，可复算）：
 *   f32 用例：IN arena 的 fp32 窗口 s0[i] = i + 0.5（i∈[0,64)）、s1[i] = 64.5 + i
 *   b16 用例：IN arena 的 u16 窗口 s0[i] = i（i∈[0,128)）、s1[i] = 128 + i
 *   ⇒ 任一 lane 的值都能唯一反推它的来源 lane，映射关系可从 dump 逐 lane 读出。
 *
 * OUT arena（1024B，先用 sentinel 0xA5 打底）：d0 落 [0,256)、d1 落 [256,512)。
 *
 * 用例（argv）：
 *   intlv_f32        Interleave(d0,d1,s0,s1)           —— 宽位宽方向的映射
 *   dintlv_f32       DeInterleave(d0,d1,s0,s1)         —— 宽位宽反方向的映射
 *   inv_f32          正例：DeInterleave(Interleave(s0,s1)) 还原 (s0,s1)（配对性）
 *   intlv_f32_neg    反例：不正例化，直接对 Interleave 的**输出**再 Interleave（应当不还原）
 *   same_f32         仓库惯用法：DeInterleave(d0,d1,s,s)（源寄存器同一个，m3/m22/m19 都这么写）
 *   intlv_b16        窄位宽方向（128 lane / 寄存器）
 *   dintlv_b16       窄位宽反方向
 *   intlv_misalign   对齐要求：Interleave 本体不变，只把**落盘地址**移 4B ⇒ 报 507035
 *                    （证明"对齐要求属于相邻 store，不属于 Interleave 本身"）
 *
 * 用法：./probe_v_ildl list          # 打印用例
 *       ./probe_v_ildl run <case> [dumpdir]
 * 退出码：0=比过通过 / 1=比过有差异 / 2=没得比（故障或挂起）
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t VLB = 256;
constexpr uint32_t ARENA = 1024;
constexpr uint32_t UB_IN = 2048;
constexpr uint32_t UB_OUT = 4096;
constexpr uint8_t SENTINEL = 0xA5;
constexpr int32_t SYNC_TIMEOUT_MS = 120000;
constexpr AscendC::MutexID BUF_IN = 0;
constexpr AscendC::MutexID BUF_OUT = 1;

enum CaseId : uint32_t {
    C_INTLV_F32 = 1,
    C_DINTLV_F32 = 2,
    C_INV_F32 = 3,
    C_INTLV_F32_NEG = 4,
    C_SAME_F32 = 5,
    C_INTLV_B16 = 6,
    C_DINTLV_B16 = 7,
    C_INTLV_MISALIGN = 8,
};

struct CaseSpec {
    const char* name;
    uint32_t id;
    uint32_t misalign;      // 落盘地址偏移（字节）
    bool isB16;             // 输入模式：false=fp32 ramp(i+0.5)，true=u16 ramp(i)
};
const CaseSpec kCases[] = {
    {"intlv_f32", C_INTLV_F32, 0, false},
    {"dintlv_f32", C_DINTLV_F32, 0, false},
    {"inv_f32", C_INV_F32, 0, false},
    {"intlv_f32_neg", C_INTLV_F32_NEG, 0, false},
    {"same_f32", C_SAME_F32, 0, false},
    {"intlv_b16", C_INTLV_B16, 0, true},
    {"dintlv_b16", C_DINTLV_B16, 0, true},
    {"intlv_misalign", C_INTLV_F32, 4, false},   // 与 intlv_f32 只差落盘地址
};

const CaseSpec* FindCase(const char* n)
{
    for (const CaseSpec& c : kCases) {
        if (std::strcmp(c.name, n) == 0) return &c;
    }
    return nullptr;
}
}   // namespace

namespace {

template <pipe_t pipe>
__aicore__ inline void BufAcquire(AscendC::MutexID id)
{
    AscendC::GetBufInternal<pipe, false>(id);
}
template <pipe_t pipe>
__aicore__ inline void BufRelease(AscendC::MutexID id)
{
    AscendC::RlsBufInternal<pipe, false>(id);
}

class IldlProbe {
public:
    __aicore__ inline void Init(GM_ADDR in, GM_ADDR sent, GM_ADDR out, uint32_t cid, uint32_t mis)
    {
        cid_ = cid;
        mis_ = mis;
        inGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(in), ARENA);
        sentGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(sent), ARENA);
        outGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(out), ARENA);
    }

    __aicore__ inline void Process()
    {
        LocalTensor<uint8_t> inL(TPosition::VECCALC, UB_IN, ARENA);
        LocalTensor<uint8_t> outL(TPosition::VECCALC, UB_OUT, ARENA);
        BufAcquire<PIPE_MTE2>(BUF_IN);
        DataCopy(inL, inGm_[0], ARENA);
        DataCopy(outL, sentGm_[0], ARENA);
        BufRelease<PIPE_MTE2>(BUF_IN);

        __ubuf__ uint8_t* inB = reinterpret_cast<__ubuf__ uint8_t*>(inL.GetPhyAddr());
        __ubuf__ uint8_t* outB = reinterpret_cast<__ubuf__ uint8_t*>(outL.GetPhyAddr());

        BufAcquire<PIPE_V>(BUF_IN);
        Run(inB, outB);
        BufRelease<PIPE_V>(BUF_IN);
        BufAcquire<PIPE_V>(BUF_OUT);
        BufRelease<PIPE_V>(BUF_OUT);

        BufAcquire<PIPE_MTE3>(BUF_OUT);
        DataCopy(outGm_[0], outL, ARENA);
        BufRelease<PIPE_MTE3>(BUF_OUT);
    }

private:
    __aicore__ inline void Run(__ubuf__ uint8_t* inB, __ubuf__ uint8_t* outB)
    {
        __ubuf__ float* s0 = reinterpret_cast<__ubuf__ float*>(inB);
        __ubuf__ float* s1 = reinterpret_cast<__ubuf__ float*>(inB + VLB);
        __ubuf__ float* d0 = reinterpret_cast<__ubuf__ float*>(outB + mis_);
        __ubuf__ float* d1 = reinterpret_cast<__ubuf__ float*>(outB + VLB);
        __ubuf__ uint16_t* h0 = reinterpret_cast<__ubuf__ uint16_t*>(inB);
        __ubuf__ uint16_t* h1 = reinterpret_cast<__ubuf__ uint16_t*>(inB + VLB);
        __ubuf__ uint16_t* e0 = reinterpret_cast<__ubuf__ uint16_t*>(outB + mis_);
        __ubuf__ uint16_t* e1 = reinterpret_cast<__ubuf__ uint16_t*>(outB + VLB);

        switch (cid_) {
            case C_INTLV_MISALIGN:
            case C_INTLV_F32: {
                __VEC_SCOPE__
                {
                    RegTensor<float> a, b, x, y;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(a, s0);
                    LoadAlign(b, s1);
                    Interleave(x, y, a, b);
                    StoreAlign(d0, x, full);
                    StoreAlign(d1, y, full);
                }
                break;
            }
            case C_DINTLV_F32: {
                __VEC_SCOPE__
                {
                    RegTensor<float> a, b, x, y;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(a, s0);
                    LoadAlign(b, s1);
                    DeInterleave(x, y, a, b);
                    StoreAlign(d0, x, full);
                    StoreAlign(d1, y, full);
                }
                break;
            }
            case C_INV_F32: {
                // 正例：DeInterleave(Interleave(a,b)) 应当逐 lane 还原 (a,b)
                __VEC_SCOPE__
                {
                    RegTensor<float> a, b, x, y, z, w;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(a, s0);
                    LoadAlign(b, s1);
                    Interleave(x, y, a, b);
                    DeInterleave(z, w, x, y);
                    StoreAlign(d0, z, full);
                    StoreAlign(d1, w, full);
                }
                break;
            }
            case C_INTLV_F32_NEG: {
                // 反例：把 Interleave 的输出再 Interleave 一次（不是逆操作）⇒ 应当与 (a,b) 不同
                __VEC_SCOPE__
                {
                    RegTensor<float> a, b, x, y, z, w;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(a, s0);
                    LoadAlign(b, s1);
                    Interleave(x, y, a, b);
                    Interleave(z, w, x, y);
                    StoreAlign(d0, z, full);
                    StoreAlign(d1, w, full);
                }
                break;
            }
            case C_SAME_F32: {
                // 仓库惯用法（m3:281 / m22:391 / m19:114）：同一个寄存器同时当两个源
                __VEC_SCOPE__
                {
                    RegTensor<float> a, x, y;
                    MaskReg full = CreateMask<float, MaskPattern::ALL>();
                    LoadAlign(a, s0);
                    DeInterleave(x, y, a, a);
                    StoreAlign(d0, x, full);
                    StoreAlign(d1, y, full);
                }
                break;
            }
            case C_INTLV_B16: {
                __VEC_SCOPE__
                {
                    RegTensor<uint16_t> a, b, x, y;
                    MaskReg full = CreateMask<uint16_t, MaskPattern::ALL>();
                    LoadAlign(a, h0);
                    LoadAlign(b, h1);
                    Interleave(x, y, a, b);
                    StoreAlign(e0, x, full);
                    StoreAlign(e1, y, full);
                }
                break;
            }
            case C_DINTLV_B16: {
                __VEC_SCOPE__
                {
                    RegTensor<uint16_t> a, b, x, y;
                    MaskReg full = CreateMask<uint16_t, MaskPattern::ALL>();
                    LoadAlign(a, h0);
                    LoadAlign(b, h1);
                    DeInterleave(x, y, a, b);
                    StoreAlign(e0, x, full);
                    StoreAlign(e1, y, full);
                }
                break;
            }
            default:
                break;
        }
    }

    uint32_t cid_ = 0;
    uint32_t mis_ = 0;
    GlobalTensor<uint8_t> inGm_;
    GlobalTensor<uint8_t> sentGm_;
    GlobalTensor<uint8_t> outGm_;
};

}   // namespace

__vector__ __global__ void probe_v_ildl_kernel(GM_ADDR in, GM_ADDR sent, GM_ADDR out, uint32_t cid, uint32_t mis)
{
    IldlProbe probe;
    probe.Init(in, sent, out, cid, mis);
    probe.Process();
}

// ============================================================
// host：只做 launch / 落盘 / 结构性自检；**权威判定在 check_ref_ildl.py**
// ============================================================
namespace {
void FillIn(uint8_t* in, bool isB16)
{
    if (isB16) {
        uint16_t* h = reinterpret_cast<uint16_t*>(in);
        for (uint32_t i = 0; i < ARENA / 2; ++i) h[i] = static_cast<uint16_t>(i);
    } else {
        float* f = reinterpret_cast<float*>(in);
        for (uint32_t i = 0; i < ARENA / 4; ++i) f[i] = static_cast<float>(i) + 0.5f;
    }
}
}   // namespace

int main(int argc, char** argv)
{
    if (argc >= 2 && std::strcmp(argv[1], "list") == 0) {
        for (const CaseSpec& c : kCases) std::printf("%s\n", c.name);
        return 0;
    }
    if (argc < 3 || std::strcmp(argv[1], "run") != 0) {
        std::fprintf(stderr, "usage: %s list | run <case> [dumpdir]\n", argv[0]);
        return 2;
    }
    const char* dumpDir = (argc >= 4) ? argv[3] : nullptr;
    const CaseSpec* c = FindCase(argv[2]);
    if (c == nullptr) {
        std::fprintf(stderr, "unknown case %s\n", argv[2]);
        return 2;
    }
    std::printf("CASE %s id=%u misalign=%u pattern=%s\n", c->name, c->id, c->misalign,
                c->isB16 ? "u16-ramp" : "f32-ramp(i+0.5)");

    static uint8_t inHost[ARENA];
    static uint8_t got[ARENA];
    FillIn(inHost, c->isB16);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    void* dIn = nullptr;
    void* dSent = nullptr;
    void* dOut = nullptr;
    aclrtMalloc(&dIn, ARENA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dSent, ARENA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&dOut, ARENA, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemcpy(dIn, ARENA, inHost, ARENA, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemset(dSent, ARENA, SENTINEL, ARENA);
    aclrtMemset(dOut, ARENA, 0x00, ARENA);

    probe_v_ildl_kernel<<<1, 0, stream>>>(reinterpret_cast<uint8_t*>(dIn), reinterpret_cast<uint8_t*>(dSent),
                                          reinterpret_cast<uint8_t*>(dOut), c->id, c->misalign);
    const aclError err = aclrtSynchronizeStreamWithTimeout(stream, SYNC_TIMEOUT_MS);
    std::printf("LAUNCH aclError=%d (sync timeout=%dms)\n", static_cast<int>(err), SYNC_TIMEOUT_MS);
    int rc = 2;
    if (err != ACL_SUCCESS) {
        const char* msg = aclGetRecentErrMsg();
        std::printf("FAULT_CODE %d\n", static_cast<int>(err));
        std::printf("FAULT_MSG %s\n", (msg != nullptr) ? msg : "(null)");
        std::printf("OUTCOME: %s\n", (err == 107020 || err == 507034) ? "HANG" :
                                         (err == 507046) ? "NOSYNC" : "FAULT");
        std::printf("RESULT: SKIPPED (device fault, rc=%d)\n", static_cast<int>(err));
    } else {
        aclrtMemcpy(got, ARENA, dOut, ARENA, ACL_MEMCPY_DEVICE_TO_HOST);
        if (dumpDir != nullptr) {
            char path[512];
            std::snprintf(path, sizeof(path), "%s/il_%s.bin", dumpDir, c->name);
            FILE* f = std::fopen(path, "wb");
            if (f != nullptr) {
                std::fwrite(got, 1, ARENA, f);
                std::fclose(f);
            }
        }
        // 结构性自检：d0/d1 两个窗口都必须有实质内容（否则"什么都没做也能过"）
        const uint32_t base = c->misalign;
        uint32_t nz0 = 0, nz1 = 0;
        for (uint32_t i = 0; i < VLB; ++i) {
            if (got[base + i] != SENTINEL) ++nz0;
            if (got[VLB + i] != SENTINEL) ++nz1;
        }
        std::printf("NONZERO d0=%u d1=%u (of %u bytes each)\n", nz0, nz1, VLB);
        uint32_t h = 2166136261u;
        for (uint32_t i = 0; i < ARENA; ++i) {
            h = (h ^ got[i]) * 16777619u;
        }
        std::printf("DUMP_FNV32 0x%08x\n", h);
        if (nz0 >= 4 && nz1 >= 4) {
            std::printf("OUTCOME: OK\n");
            std::printf("RESULT: OK (structural: d0 %u/%u bytes nonzero, d1 %u/%u；逐 lane 语义由 check_ref_ildl.py 判)\n",
                        nz0, VLB, nz1, VLB);
            rc = 0;
        } else {
            std::printf("OUTCOME: WRONG\n");
            std::printf("RESULT: FAIL (structural: d0 %u, d1 %u nonzero bytes)\n", nz0, nz1);
            rc = 1;
        }
    }
    aclrtFree(dIn);
    aclrtFree(dSent);
    aclrtFree(dOut);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return rc;
}
