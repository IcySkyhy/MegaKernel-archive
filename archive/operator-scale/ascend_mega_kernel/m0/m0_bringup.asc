/**
 * m0_bringup.asc —— Mega kernel M0  bring-up（设计见 docs/05-megakernel-design.md）
 *
 * 一次 mix(1,2) 启动内验证五件事：
 *   1. 核角色/配对探测：AIV 经 GM 数据交接记录自身角色，验证 28 AIC + 56 AIV、AIV=2×blockDim；
 *   2. BufferID 核内同步：AIV 内 MTE2(生产) ↔ VEC(消费) 以 Mutex::Lock/Unlock 做乒乓有界 buffer 累加；
 *   3. CrossCore mode 0：全体 AIV 经 GM 交换数据（all-to-all 屏障，验证 GM 交接同步路径）；
 *   4. CrossCore mode 2：AIC 做 16x16 Mmad → FIXP 写 GM → 配对的 2 个 AIV 读回 +1 写回
 *      （验证 AIC↔AIV(1:2) 同步路径与 cube 基本链路）；
 *   5. 同 pipe BufferID 重获取实证（用户提出的疑问）：
 *      同一 buffer id 连续两轮 get_buf→MTE2→rls_buf（中间无其它 pipe 参与），
 *      验证不挂死且第二轮读到的数据正确。
 *
 * 约束遵守：不用 TPipe/TBuf/TQue/AllocTensor；BufferID/flagId/地址全部编译期静态。
 * 核内同步 = BufferID（占有/释放互斥）+ 硬件事件 SetFlag/WaitFlag（跨 pipe 数据可见性）
 * + PipeBarrier（标量等 pipe 退休）；核间 = CrossCoreSetFlag/WaitFlag（Wait 挂数据 pipe，非 PIPE_S）。
 *
 * —— 950 实测结论（docs/06 §4/§5 详述；round-2 决定性数据：无排空 60/60 轮有错、有排空 0/60）——
 *   a) 同 pipe 背靠背 MTE2 DataCopy 不保序（完成序可颠倒：实测 ~20% AIV-轮受影响、错元素恒等于
 *      第一轮数据、呈 32B burst 粒度交错），两轮之间必须 PipeBarrier<PIPE_MTE2>；
 *      BufferID get/rls 任意 mode 均不保序（drain mode 实测无效）；
 *   b) 跨 pipe 消费 UB 数据（如 MTE3 读出）必须用 X_Y 事件；PipeBarrier 不保证跨 pipe 数据路径可见；
 *   c) 标量(S 管) GM 写在 kernel 退出时可见性无保证 → 元数据一律走 MTE3 DMA，核尾 MTE3_S 事件排空。
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstring>
#include <cmath>
#include <cstdlib>

// ============================================================
// 静态资源表（编译期分配）
// ============================================================

// ---- BufferID（MutexID 有效范围 0..27，静态分配）----
constexpr AscendC::MutexID BUF_ID_PING = 0;      // 乒乓 buffer 0（AIV UB）
constexpr AscendC::MutexID BUF_ID_PONG = 1;      // 乒乓 buffer 1（AIV UB）
constexpr AscendC::MutexID BUF_ID_PARTIAL = 2;   // mode0 GM 槽位写读交接（MTE3 → MTE2）
constexpr AscendC::MutexID BUF_ID_CHECK5 = 3;    // 检查5 同 buffer 重获取

// ---- CrossCore flagId（有效窗口 0..10，静态分配）----
constexpr uint16_t FLAG_MODE0_AIV_BARRIER = 0;   // 全体 AIV all-to-all 屏障
constexpr uint16_t FLAG_MODE2_AIC2AIV = 1;       // AIC → 其配对 2 个 AIV

constexpr uint32_t N_ITERS = 8;                  // BufferID 乒乓迭代次数
constexpr uint32_t TILE_LEN = 1024;              // 乒乓 tile：1024 float = 4KB
constexpr uint32_t MODE0_CHUNK = 16;             // mode0 每核参与汇总的 float 数
constexpr uint32_t ROLE_REC_FLOATS = 8;          // 角色记录：8 float（32B 对齐）

// ---- AIV UB 静态布局（LocalTensor 的 addr 参数单位是 BYTE；size 单位是元素）----
constexpr uint32_t TILE_BYTES = TILE_LEN * 4;              // 4096B
constexpr uint32_t PARTIAL_READ_LEN = 1024;             // mode0 读回缓冲：56 核 × 16 float = 896 ≤ 1024
constexpr uint32_t PARTIAL_READ_BYTES = PARTIAL_READ_LEN * 4;
constexpr uint32_t UB_OFF_BUF0 = 0;                        // 检查2 大 staging 区（N_ITERS 个 tile 连续）
constexpr uint32_t UB_OFF_ACCA = UB_OFF_BUF0 + N_ITERS * TILE_BYTES;
constexpr uint32_t UB_OFF_ACCB = UB_OFF_ACCA + TILE_BYTES;
constexpr uint32_t UB_OFF_PARTIAL_RD = UB_OFF_ACCB + TILE_BYTES;
constexpr uint32_t UB_OFF_ROLE = UB_OFF_PARTIAL_RD + PARTIAL_READ_BYTES;       // 8 float = 32B
// DemoB AIV 读 16x16 half 结果（in/out 各 256 half = 512B）
constexpr uint32_t UB_OFF_DEMOB_HALF = UB_OFF_ROLE + 8 * 4;
constexpr uint32_t UB_OFF_DEMOB_OUT = UB_OFF_DEMOB_HALF + 256 * 2;
// 检查5 乒乓缓冲（4KB）
constexpr uint32_t UB_OFF_CHECK5 = UB_OFF_DEMOB_OUT + 256 * 2;
constexpr uint32_t AIV_UB_BYTES = UB_OFF_CHECK5 + TILE_BYTES;                  // 总预算 ~47KB « 248KB

// ---- DemoB：AIC 16x16 half matmul 静态布局 ----
constexpr uint32_t MAT_DIM = 16;                 // CUBE_BLOCK
constexpr uint32_t MAT_ELEMS = MAT_DIM * MAT_DIM;           // 256
constexpr uint32_t L1_OFF_A = 0;                            // L1（字节地址）：A @0
constexpr uint32_t L1_OFF_B = MAT_ELEMS * 2;                // B @512B（256 half）
constexpr uint32_t L0_OFF_AB = 0;                           // L0A/L0B 各 256
constexpr uint32_t L0C_OFF_C = 0;                           // L0C float 256

// ============================================================
// Kernel 实现
// ============================================================

class M0Bringup {
public:
    __aicore__ inline M0Bringup() {}

    __aicore__ inline void Init(
        __gm__ uint32_t* roleOut, __gm__ float* roleIn, __gm__ float* dataIn, __gm__ float* sumOut, __gm__ float* partialOut,
        __gm__ float* totalOut, __gm__ uint16_t* demoBInA, __gm__ uint16_t* demoBInB, __gm__ uint16_t* demoBC,
        __gm__ uint16_t* demoBOut, __gm__ float* check5Out)
    {
        roleOutGM.SetGlobalBuffer(reinterpret_cast<__gm__ float*>(roleOut));
        roleInGM.SetGlobalBuffer(roleIn);
        dataInGM.SetGlobalBuffer(dataIn);
        sumOutGM.SetGlobalBuffer(sumOut);
        partialOutGM.SetGlobalBuffer(partialOut);
        totalOutGM.SetGlobalBuffer(totalOut);
        demoBInAGM.SetGlobalBuffer(demoBInA);
        demoBInBGM.SetGlobalBuffer(demoBInB);
        demoBCGM.SetGlobalBuffer(demoBC);
        demoBOutGM.SetGlobalBuffer(demoBOut);
        check5OutGM.SetGlobalBuffer(check5Out);
    }

    __aicore__ inline void ProcessAiv()
    {
        const uint32_t bid = AscendC::GetBlockIdx();       // 0 .. 2*numBlocks-1
        const uint32_t numBlocks = AscendC::GetBlockNum(); // = AIC 数
        const uint32_t numAiv = numBlocks * 2;

        // ---- 1. 角色探测：一次 MTE2 读（偏移含 GetBlockNum，可验证其值）→ 一次 MTE3 写 ----
        {
            AscendC::LocalTensor<float> roleStg(
                AscendC::TPosition::VECCALC, UB_OFF_ROLE, ROLE_REC_FLOATS);
            AscendC::DataCopy(roleStg, roleInGM[bid * ROLE_REC_FLOATS], ROLE_REC_FLOATS);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            AscendC::DataCopy(roleOutGM[bid * ROLE_REC_FLOATS], roleStg, ROLE_REC_FLOATS);
            AscendC::PipeBarrier<PIPE_MTE3>();     // 排空再进入下一阶段（避免背靠背 MTE2 串地址）
        }

        // ---- 2. BufferID 核内乒乓（MTE2 生产 → VEC 消费，累加 N_ITERS 个 tile）----
        AscendC::LocalTensor<float> big(
            AscendC::TPosition::VECCALC, UB_OFF_BUF0, N_ITERS * TILE_LEN);   // 8 tile 连续（字节地址）
        AscendC::LocalTensor<float> accA(
            AscendC::TPosition::VECCALC, UB_OFF_ACCA, TILE_LEN);
        AscendC::LocalTensor<float> accB(
            AscendC::TPosition::VECCALC, UB_OFF_ACCB, TILE_LEN);
        AscendC::LocalTensor<float> t0(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 0 * TILE_BYTES, TILE_LEN);
        AscendC::LocalTensor<float> t1(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 1 * TILE_BYTES, TILE_LEN);
        AscendC::LocalTensor<float> t2(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 2 * TILE_BYTES, TILE_LEN);
        AscendC::LocalTensor<float> t3(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 3 * TILE_BYTES, TILE_LEN);
        AscendC::LocalTensor<float> t4(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 4 * TILE_BYTES, TILE_LEN);
        AscendC::LocalTensor<float> t5(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 5 * TILE_BYTES, TILE_LEN);
        AscendC::LocalTensor<float> t6(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 6 * TILE_BYTES, TILE_LEN);
        AscendC::LocalTensor<float> t7(AscendC::TPosition::VECCALC, UB_OFF_BUF0 + 7 * TILE_BYTES, TILE_LEN);

        // BufferID 乒乓协议：MTE2 侧 get/rel 大 staging 区，VEC 侧 get/rel 消费
        AscendC::Mutex::Lock<PIPE_MTE2>(BUF_ID_PING);
        AscendC::DataCopy(big, dataInGM[bid * N_ITERS * TILE_LEN], N_ITERS * TILE_LEN); // 一次大拷贝
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        AscendC::Mutex::Unlock<PIPE_MTE2>(BUF_ID_PING);
        AscendC::Mutex::Lock<PIPE_V>(BUF_ID_PING);
        AscendC::Copy(accA, t0, TILE_LEN);
        AscendC::Add(accB, accA, t1, TILE_LEN);
        AscendC::Add(accA, accB, t2, TILE_LEN);
        AscendC::Add(accB, accA, t3, TILE_LEN);
        AscendC::Add(accA, accB, t4, TILE_LEN);
        AscendC::Add(accB, accA, t5, TILE_LEN);
        AscendC::Add(accA, accB, t6, TILE_LEN);
        AscendC::Add(accB, accA, t7, TILE_LEN);
        AscendC::Copy(accA, accB, TILE_LEN);
        // accA(V) → sumOut(GM)：跨 pipe UB 交接必须用 event（PipeBarrier 不能保证数据路径可见）
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
        AscendC::DataCopy(sumOutGM[bid * TILE_LEN], accA, TILE_LEN);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);   // 排空 MTE3，再进 CrossCore 阶段
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);

        // ---- 3. CrossCore mode 0：全体 AIV 经 GM 的 all-to-all 汇总 ----
        AscendC::Mutex::Lock<PIPE_MTE3>(BUF_ID_PARTIAL);     // 首轮立即成功
        AscendC::DataCopy(partialOutGM[bid * MODE0_CHUNK], accA, MODE0_CHUNK);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);   // GM 写真正落盘再广播
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);
        AscendC::Mutex::Unlock<PIPE_MTE3>(BUF_ID_PARTIAL);
        AscendC::CrossCoreSetFlag<0x0, PIPE_MTE3>(FLAG_MODE0_AIV_BARRIER); // 写完成 → 广播

        AscendC::LocalTensor<float> partialRd(
            AscendC::TPosition::VECCALC, UB_OFF_PARTIAL_RD, PARTIAL_READ_LEN);
        AscendC::CrossCoreWaitFlag<0x0, PIPE_MTE2>(FLAG_MODE0_AIV_BARRIER); // 等全体写完成
        AscendC::Mutex::Lock<PIPE_MTE2>(BUF_ID_PARTIAL);     // 槽位读保护
        AscendC::DataCopy(partialRd, partialOutGM[0], numAiv * MODE0_CHUNK); // 一次读回全体
        AscendC::Mutex::Unlock<PIPE_MTE2>(BUF_ID_PARTIAL);
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);   // 读完成交给 V
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);

        // 汇总（56 路 × 16 float 出位交替相加）
        AscendC::LocalTensor<float> redA(
            AscendC::TPosition::VECCALC, UB_OFF_PARTIAL_RD + PARTIAL_READ_BYTES - 2 * MODE0_CHUNK * 4, MODE0_CHUNK);
        AscendC::LocalTensor<float> redB(
            AscendC::TPosition::VECCALC, UB_OFF_PARTIAL_RD + PARTIAL_READ_BYTES - MODE0_CHUNK * 4, MODE0_CHUNK);
        AscendC::Copy(redA, partialRd, MODE0_CHUNK);
        for (uint32_t c = 1; c < numAiv; ++c) {
            if ((c & 1) == 1) {
                AscendC::Add(redB, redA, partialRd[c * MODE0_CHUNK], MODE0_CHUNK);
            } else {
                AscendC::Add(redA, redB, partialRd[c * MODE0_CHUNK], MODE0_CHUNK);
            }
        }
        if ((numAiv & 1) == 0) {
            AscendC::Copy(redA, redB, MODE0_CHUNK);
        }
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);   // 汇总结果写 GM
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
        AscendC::DataCopy(totalOutGM[bid * MODE0_CHUNK], redA, MODE0_CHUNK);
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);

        // ---- 4. CrossCore mode 2：等待配对 AIC 的 FIXP 结果 → 读回 +1 写回 ----
        const uint32_t aicBid = bid / 2;
        AscendC::LocalTensor<uint16_t> cHalf(
            AscendC::TPosition::VECCALC, UB_OFF_DEMOB_HALF, MAT_ELEMS);
        AscendC::CrossCoreWaitFlag<0x2, PIPE_MTE2>(FLAG_MODE2_AIC2AIV);
        AscendC::DataCopyPad<uint16_t>(
            cHalf, demoBCGM[aicBid * MAT_ELEMS],
            AscendC::DataCopyExtParams{MAT_DIM, MAT_DIM * sizeof(uint16_t), 0, 0, 0},
            AscendC::DataCopyPadExtParams<uint16_t>{false, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);   // C 读回交给 V
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_V>(EVENT_ID0);
        // 3510 的 Adds 只支持 half 等类型：uint16 同址换型视图后出位 +1.0
        AscendC::LocalTensor<half> cHalfH = cHalf.ReinterpretCast<half>();
        AscendC::LocalTensor<half> outHalf(
            AscendC::TPosition::VECCALC, UB_OFF_DEMOB_OUT, MAT_ELEMS);
        AscendC::Adds<half>(outHalf, cHalfH, half(1.0f), static_cast<int32_t>(MAT_ELEMS));
        AscendC::SetFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
        AscendC::WaitFlag<AscendC::HardEvent::V_MTE3>(EVENT_ID1);
        AscendC::LocalTensor<uint16_t> outU16(
            AscendC::TPosition::VECCALC, UB_OFF_DEMOB_OUT, MAT_ELEMS);   // 同址 uint16 视图写出
        AscendC::DataCopyPad<uint16_t>(   // 3510 上 GM 目的 DataCopyPad 只有 3 参重载
            demoBOutGM[bid * MAT_ELEMS], outU16,
            AscendC::DataCopyExtParams{MAT_DIM, MAT_DIM * sizeof(uint16_t), 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);
        AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);

        // ---- 5. 同 pipe BufferID 重获取实证：get→MTE2→rls→get→MTE2→rls（同 id，中间无其它 pipe）----
        {
            AscendC::LocalTensor<float> c5buf(
                AscendC::TPosition::VECCALC, UB_OFF_CHECK5, TILE_LEN);
            const uint32_t c5base = bid * N_ITERS * TILE_LEN;
            AscendC::Mutex::Lock<PIPE_MTE2>(BUF_ID_CHECK5);
            AscendC::DataCopy(c5buf, dataInGM[c5base + 2 * TILE_LEN], TILE_LEN); // 第一轮
            AscendC::Mutex::Unlock<PIPE_MTE2>(BUF_ID_CHECK5);
            AscendC::PipeBarrier<PIPE_MTE2>();   // 必须排空：否则第二轮拷贝源地址被串（实测）
            const uint32_t c5tile = numBlocks % N_ITERS;   // GetBlockNum 派生：28%8=4
            AscendC::Mutex::Lock<PIPE_MTE2>(BUF_ID_CHECK5);
            AscendC::DataCopy(c5buf, dataInGM[c5base + c5tile * TILE_LEN], TILE_LEN); // 第二轮（同 buffer id）
            AscendC::Mutex::Unlock<PIPE_MTE2>(BUF_ID_CHECK5);
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID4); // 第二轮 DMA 完成 → 读出
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID4);
            AscendC::DataCopy(check5OutGM[bid * TILE_LEN], c5buf, TILE_LEN);     // 读出第二轮数据
            AscendC::SetFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);
            AscendC::WaitFlag<AscendC::HardEvent::MTE3_S>(EVENT_ID2);
        }
    }

    __aicore__ inline void ProcessAic()
    {
        const uint32_t bid = AscendC::GetBlockIdx(); // 0 .. numBlocks-1

        // GM→L1（Nd2Nz），静态偏移；两条 MTE2 之间必须排空（工具链事实(a)）
        AscendC::LocalTensor<uint16_t> a1(AscendC::TPosition::A1, L1_OFF_A, MAT_ELEMS);
        AscendC::LocalTensor<uint16_t> b1(AscendC::TPosition::B1, L1_OFF_B, MAT_ELEMS);
        AscendC::DataCopy(a1, demoBInAGM[bid * MAT_ELEMS], AscendC::Nd2NzParams{1, MAT_DIM, MAT_DIM, 0, MAT_DIM, MAT_DIM, 1, 0});
        AscendC::DataCopy(b1, demoBInBGM[bid * MAT_ELEMS], AscendC::Nd2NzParams{1, MAT_DIM, MAT_DIM, 0, MAT_DIM, MAT_DIM, 1, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);   // GM→L1 完成再 LoadData
        AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE1>(EVENT_ID0);

        // L1→L0（3510: Nz 直搬；LoadData 2D 仅支持 half 等类型，uint16 同址换型视图）
        AscendC::LocalTensor<half> a1h = a1.ReinterpretCast<half>();
        AscendC::LocalTensor<half> b1h = b1.ReinterpretCast<half>();
        AscendC::LocalTensor<half> a2(AscendC::TPosition::A2, L0_OFF_AB, MAT_ELEMS);
        AscendC::LocalTensor<half> b2(AscendC::TPosition::B2, L0_OFF_AB, MAT_ELEMS);
        AscendC::LoadData(
            a2, a1h, AscendC::LoadData2DParamsV2{0, 0, MAT_DIM / 16, MAT_DIM / 16, MAT_DIM / 16, MAT_DIM / 16, false, 0});
        // B 矩阵 nz→zn 需转置（ifTranspose=true），否则 Mmad 拿到错误排布
        AscendC::LoadData(
            b2, b1h, AscendC::LoadData2DParamsV2{0, 0, MAT_DIM / 16, MAT_DIM / 16, MAT_DIM / 16, MAT_DIM / 16, true, 0});
        AscendC::SetFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);       // L1→L0 完成再 Mmad
        AscendC::WaitFlag<AscendC::HardEvent::MTE1_M>(EVENT_ID1);

        // Mmad → L0C（fp32 累加）
        AscendC::LocalTensor<float> cL0C(AscendC::TPosition::CO1, L0C_OFF_C, MAT_ELEMS);
        AscendC::Mmad(cL0C, a2, b2, AscendC::MmadParams{MAT_DIM, MAT_DIM, MAT_DIM, 0, false, true});
        AscendC::SetFlag<AscendC::HardEvent::M_FIX>(EVENT_ID2);        // M 完成再 FIXP
        AscendC::WaitFlag<AscendC::HardEvent::M_FIX>(EVENT_ID2);

        // FIXP：L0C → GM（F32→F16），完成后 CrossCore mode 2 通知配对 AIV
        // 3510 Fixpipe dst 仅支持 half 等类型：GM uint16 缓冲同址换型视图
        AscendC::Fixpipe(
            demoBCGM[bid * MAT_ELEMS].ReinterpretCast<half>(), cL0C,
            AscendC::FixpipeParamsV220{MAT_DIM, MAT_DIM, MAT_DIM, MAT_DIM, false, QuantMode_t::F322F16, 0, 1, 0, 0, 0});
        AscendC::SetFlag<AscendC::HardEvent::FIX_S>(EVENT_ID3);        // FIXP 写完再通知 AIV
        AscendC::WaitFlag<AscendC::HardEvent::FIX_S>(EVENT_ID3);
        AscendC::CrossCoreSetFlag<0x2, PIPE_FIX>(FLAG_MODE2_AIC2AIV);
    }

private:
    AscendC::GlobalTensor<float> roleOutGM;
    AscendC::GlobalTensor<float> roleInGM;
    AscendC::GlobalTensor<float> dataInGM;
    AscendC::GlobalTensor<float> sumOutGM;
    AscendC::GlobalTensor<float> partialOutGM;
    AscendC::GlobalTensor<float> totalOutGM;
    AscendC::GlobalTensor<uint16_t> demoBInAGM;
    AscendC::GlobalTensor<uint16_t> demoBInBGM;
    AscendC::GlobalTensor<uint16_t> demoBCGM;
    AscendC::GlobalTensor<uint16_t> demoBOutGM;
    AscendC::GlobalTensor<float> check5OutGM;
};

__global__ __mix__(1, 2) void m0_bringup_kernel(
    __gm__ uint32_t* roleOut, __gm__ float* roleIn, __gm__ float* dataIn, __gm__ float* sumOut, __gm__ float* partialOut,
    __gm__ float* totalOut, __gm__ uint16_t* demoBInA, __gm__ uint16_t* demoBInB, __gm__ uint16_t* demoBC,
    __gm__ uint16_t* demoBOut, __gm__ float* check5Out)
{
    AscendC::InitSocState();
    M0Bringup op;
    op.Init(roleOut, roleIn, dataIn, sumOut, partialOut, totalOut, demoBInA, demoBInB, demoBC, demoBOut, check5Out);
    if ASCEND_IS_AIV {
        op.ProcessAiv();
    }
    if ASCEND_IS_AIC {
        op.ProcessAic();
    }
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧
// ============================================================

static float DataFormula(uint32_t bid, uint32_t it, uint32_t i)
{
    return static_cast<float>((bid * 131u + it * 17u + i) % 1024u) * 0.25f;
}

static uint16_t FloatToHalf(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    uint32_t sign = (x >> 16) & 0x8000u;
    int exp = static_cast<int>((x >> 23) & 0xFFu) - 127 + 15;
    uint32_t mant = x & 0x7FFFFFu;
    if (exp <= 0) { return static_cast<uint16_t>(sign); }
    if (exp >= 31) { return static_cast<uint16_t>(sign | 0x7C00u); }
    return static_cast<uint16_t>(sign | (static_cast<uint32_t>(exp) << 10) | (mant >> 13));
}

static float HalfToFloat(uint16_t h)
{
    uint32_t sign = (h & 0x8000u) << 16;
    uint32_t exp = (h >> 10) & 0x1Fu;
    uint32_t mant = h & 0x3FFu;
    uint32_t x;
    if (exp == 0) { x = sign; }
    else if (exp == 31) { x = sign | 0x7F800000u | (mant << 13); }
    else { x = sign | ((exp - 15 + 127) << 23) | (mant << 13); }
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

int32_t main()
{
    int64_t aicNum = 0;
    int64_t aivNum = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum) != ACL_SUCCESS || aicNum <= 0) {
        printf("[M0] aclrtGetDeviceInfo(AICORE_CORE_NUM) failed, fallback 28\n");
        aicNum = 28;
    }
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum);
    const uint32_t numBlocks = static_cast<uint32_t>(aicNum); // mix(1,2): blockDim = AIC 数
    const uint32_t numAiv = numBlocks * 2;
    printf("[M0] AICORE=%ld VECTOR=%ld -> numBlocks=%u (expect VECTOR=2*AICORE)\n", aicNum, aivNum, numBlocks);

    const size_t roleSize = numAiv * ROLE_REC_FLOATS * sizeof(uint32_t);
    const size_t dataSize = static_cast<size_t>(numAiv) * N_ITERS * TILE_LEN * sizeof(float);
    const size_t sumSize = static_cast<size_t>(numAiv) * TILE_LEN * sizeof(float);
    const size_t partialSize = static_cast<size_t>(numAiv) * MODE0_CHUNK * sizeof(float);
    const size_t totalSize = static_cast<size_t>(numAiv) * MODE0_CHUNK * sizeof(float);
    const size_t demoBSize = static_cast<size_t>(numBlocks) * MAT_ELEMS * sizeof(uint16_t);
    const size_t demoBOutSize = static_cast<size_t>(numAiv) * MAT_ELEMS * sizeof(uint16_t);
    const size_t check5Size = static_cast<size_t>(numAiv) * TILE_LEN * sizeof(float);

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    uint32_t* roleHost = nullptr; uint32_t* roleDev = nullptr;
    float* roleInHost = nullptr; float* roleInDev = nullptr;
    float* dataHost = nullptr; float* dataDev = nullptr;
    float* sumHost = nullptr; float* sumDev = nullptr;
    float* partialHost = nullptr; float* partialDev = nullptr;
    float* totalHost = nullptr; float* totalDev = nullptr;
    uint16_t* demoBAHost = nullptr; uint16_t* demoBADev = nullptr;
    uint16_t* demoBBHost = nullptr; uint16_t* demoBBDev = nullptr;
    uint16_t* demoBCHost = nullptr; uint16_t* demoBCDev = nullptr;
    uint16_t* demoBOutHost = nullptr; uint16_t* demoBOutDev = nullptr;
    float* check5Host = nullptr; float* check5Dev = nullptr;

    aclrtMallocHost(reinterpret_cast<void**>(&roleHost), roleSize);
    aclrtMalloc(reinterpret_cast<void**>(&roleDev), roleSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&roleInHost), roleSize);
    aclrtMalloc(reinterpret_cast<void**>(&roleInDev), roleSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&dataHost), dataSize);
    aclrtMalloc(reinterpret_cast<void**>(&dataDev), dataSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&sumHost), sumSize);
    aclrtMalloc(reinterpret_cast<void**>(&sumDev), sumSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&partialHost), partialSize);
    aclrtMalloc(reinterpret_cast<void**>(&partialDev), partialSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&totalHost), totalSize);
    aclrtMalloc(reinterpret_cast<void**>(&totalDev), totalSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&demoBAHost), demoBSize);
    aclrtMalloc(reinterpret_cast<void**>(&demoBADev), demoBSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&demoBBHost), demoBSize);
    aclrtMalloc(reinterpret_cast<void**>(&demoBBDev), demoBSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&demoBCHost), demoBSize);
    aclrtMalloc(reinterpret_cast<void**>(&demoBCDev), demoBSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&demoBOutHost), demoBOutSize);
    aclrtMalloc(reinterpret_cast<void**>(&demoBOutDev), demoBOutSize, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMallocHost(reinterpret_cast<void**>(&check5Host), check5Size);
    aclrtMalloc(reinterpret_cast<void**>(&check5Dev), check5Size, ACL_MEM_MALLOC_HUGE_FIRST);

    // 角色探测输入：每核 8 float 唯一值（验证 bid 与 DMA 交接）
    for (uint32_t b = 0; b < numAiv; ++b)
        for (uint32_t i = 0; i < ROLE_REC_FLOATS; ++i)
            roleInHost[b * ROLE_REC_FLOATS + i] = b * 0.5f + i * 0.001f;
    aclrtMemcpy(roleInDev, roleSize, roleInHost, roleSize, ACL_MEMCPY_HOST_TO_DEVICE);

    // 填充输入
    for (uint32_t b = 0; b < numAiv; ++b)
        for (uint32_t it = 0; it < N_ITERS; ++it)
            for (uint32_t i = 0; i < TILE_LEN; ++i)
                dataHost[(b * N_ITERS + it) * TILE_LEN + i] = DataFormula(b, it, i);
    for (uint32_t k = 0; k < numBlocks; ++k) {
        for (uint32_t i = 0; i < MAT_DIM; ++i)
            for (uint32_t j = 0; j < MAT_DIM; ++j) {
                demoBAHost[k * MAT_ELEMS + i * MAT_DIM + j] = FloatToHalf(static_cast<float>((i + j) % 5 + 1) * 0.5f);
                demoBBHost[k * MAT_ELEMS + i * MAT_DIM + j] = FloatToHalf(static_cast<float>((i * 3 + j) % 7 + 1) * 0.25f);
            }
    }

    aclrtMemcpy(dataDev, dataSize, dataHost, dataSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(demoBADev, demoBSize, demoBAHost, demoBSize, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(demoBBDev, demoBSize, demoBBHost, demoBSize, ACL_MEMCPY_HOST_TO_DEVICE);

    m0_bringup_kernel<<<numBlocks, 0, stream>>>(
        roleDev, roleInDev, dataDev, sumDev, partialDev, totalDev, demoBADev, demoBBDev, demoBCDev, demoBOutDev, check5Dev);
    const aclError launchErr = aclrtSynchronizeStream(stream);
    printf("[M0] kernel launch+sync: %s\n", launchErr == ACL_SUCCESS ? "OK" : "FAILED");
    if (launchErr != ACL_SUCCESS) {
        printf("[M0] ABORT: kernel failed on device (sync error %d)\n", static_cast<int>(launchErr));
        return 2;
    }

    aclrtMemcpy(roleHost, roleSize, roleDev, roleSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(sumHost, sumSize, sumDev, sumSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(totalHost, totalSize, totalDev, totalSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(demoBOutHost, demoBOutSize, demoBOutDev, demoBOutSize, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(check5Host, check5Size, check5Dev, check5Size, ACL_MEMCPY_DEVICE_TO_HOST);

    // ---- 校验 1：角色探测（56 条 AIV 记录，经 DMA 交接验证 bid 与 GetBlockNum）----
    bool roleOk = true;
    int roleBad = 0;
    for (uint32_t b = 0; b < numAiv; ++b) {
        for (uint32_t i = 0; i < ROLE_REC_FLOATS; ++i) {
            const float expect = roleInHost[b * ROLE_REC_FLOATS + i];
            if (reinterpret_cast<float*>(roleHost)[b * ROLE_REC_FLOATS + i] != expect) {
                if (roleBad < 3)
                    printf("[M0][FAIL] roleOut[aiv=%u][%u] got %f expect %f\n", b, i,
                           reinterpret_cast<float*>(roleHost)[b * ROLE_REC_FLOATS + i], expect);
                roleOk = false;
                ++roleBad;
            }
        }
    }
    printf("[M0] %s role probe: %u AIVs DMA-transfer their bid-tagged slice\n", roleOk ? "PASS" : "FAIL", numAiv);

    // ---- 校验 2：BufferID 乒乓累加 ----
    bool sumOk = true;
    for (uint32_t b = 0; b < numAiv && sumOk; ++b) {
        for (uint32_t i = 0; i < TILE_LEN; ++i) {
            float expect = 0.f;
            for (uint32_t it = 0; it < N_ITERS; ++it) expect += DataFormula(b, it, i);
            float got = sumHost[b * TILE_LEN + i];
            if (fabsf(got - expect) > 1e-4f * (fabsf(expect) + 1.f)) {
                printf("[M0][FAIL] sumOut[aiv=%u][%u] got %f expect %f\n", b, i, got, expect);
                sumOk = false;
                break;
            }
        }
    }
    printf("[M0] %s BufferID ping-pong accumulation (%u iters, %u AIVs)\n", sumOk ? "PASS" : "FAIL", N_ITERS, numAiv);

    // ---- 校验 3：mode 0 全体汇总 ----
    bool totalOk = true;
    float expectTotal[MODE0_CHUNK] = {0.f};
    for (uint32_t b = 0; b < numAiv; ++b)
        for (uint32_t it = 0; it < N_ITERS; ++it)
            for (uint32_t c = 0; c < MODE0_CHUNK; ++c) expectTotal[c] += DataFormula(b, it, c);
    for (uint32_t b = 0; b < numAiv && totalOk; ++b) {
        for (uint32_t c = 0; c < MODE0_CHUNK; ++c) {
            if (fabsf(totalHost[b * MODE0_CHUNK + c] - expectTotal[c]) > 1e-3f * (fabsf(expectTotal[c]) + 1.f)) {
                printf("[M0][FAIL] totalOut[aiv=%u][%u] got %f expect %f\n", b, c, totalHost[b * MODE0_CHUNK + c], expectTotal[c]);
                totalOk = false;
                break;
            }
        }
    }
    printf("[M0] %s CrossCore mode0 all-AIV reduction\n", totalOk ? "PASS" : "FAIL");

    // ---- 校验 4：mode 2 AIC→AIV（Mmad + FIXP + 配对同步）----
    bool demoBOk = true;
    for (uint32_t k = 0; k < numBlocks && demoBOk; ++k) {
        float expectC[MAT_ELEMS];
        for (uint32_t i = 0; i < MAT_DIM; ++i)
            for (uint32_t j = 0; j < MAT_DIM; ++j) {
                float acc = 0.f;
                for (uint32_t kk = 0; kk < MAT_DIM; ++kk)
                    acc += HalfToFloat(demoBAHost[k * MAT_ELEMS + i * MAT_DIM + kk]) *
                           HalfToFloat(demoBBHost[k * MAT_ELEMS + kk * MAT_DIM + j]);
                expectC[i * MAT_DIM + j] = acc;
            }
        for (uint32_t half_i = 0; half_i < 2 && demoBOk; ++half_i) {
            uint32_t aiv = k * 2 + half_i;
            for (uint32_t e = 0; e < MAT_ELEMS; ++e) {
                float got = HalfToFloat(demoBOutHost[aiv * MAT_ELEMS + e]);
                float expect = expectC[e] + 1.0f;   // half 舍入容差
                if (fabsf(got - expect) > 2e-3f * (fabsf(expect) + 1.f)) {
                    printf("[M0][FAIL] demoBOut[aiv=%u][%u] got %f expect~%f\n", aiv, e, got, expect);
                    demoBOk = false;
                    break;
                }
            }
        }
    }
    printf("[M0] %s CrossCore mode2 AIC(Mmad+FIXP)->AIV(+1) (%u pairs)\n", demoBOk ? "PASS" : "FAIL", numBlocks);

    // ---- 校验 5：同 pipe BufferID 重获取（第二轮数据正确 = 不重挂死且语义正确）----
    bool check5Ok = true;
    for (uint32_t b = 0; b < numAiv && check5Ok; ++b) {
        for (uint32_t i = 0; i < TILE_LEN; ++i) {
            const float expect = DataFormula(b, numBlocks % N_ITERS, i);   // 第二轮 tile = GetBlockNum%8
            if (check5Host[b * TILE_LEN + i] != expect) {
                printf("[M0][FAIL] check5Out[aiv=%u][%u] got %f expect %f\n", b, i, check5Host[b * TILE_LEN + i], expect);
                check5Ok = false;
                break;
            }
        }
    }
    printf("[M0] %s same-pipe BufferID re-acquire (get/MTE2/rls/get/MTE2/rls, 2nd round data correct)\n",
           check5Ok ? "PASS" : "FAIL");

    const bool allOk = roleOk && sumOk && totalOk && demoBOk && check5Ok;
    printf("[M0] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtFree(roleDev); aclrtFreeHost(roleHost);
    aclrtFree(roleInDev); aclrtFreeHost(roleInHost);
    aclrtFree(dataDev); aclrtFreeHost(dataHost);
    aclrtFree(sumDev); aclrtFreeHost(sumHost);
    aclrtFree(partialDev); aclrtFreeHost(partialHost);
    aclrtFree(totalDev); aclrtFreeHost(totalHost);
    aclrtFree(demoBADev); aclrtFreeHost(demoBAHost);
    aclrtFree(demoBBDev); aclrtFreeHost(demoBBHost);
    aclrtFree(demoBCDev); aclrtFreeHost(demoBCHost);
    aclrtFree(demoBOutDev); aclrtFreeHost(demoBOutHost);
    aclrtFree(check5Dev); aclrtFreeHost(check5Host);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
