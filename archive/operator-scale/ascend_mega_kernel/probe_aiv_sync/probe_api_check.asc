/**
 * probe_api_check.asc —— 临时 API 可用性检查（不属于交付物，编译通过后删除或保留为编译靶子）
 * 目的：在主探针动笔前，确认下列 API 在 dav-3510 + ASC 15.0.5 上真的存在且类型可实例化：
 *   RegBase(int32)：LoadAlign / StoreAlign / Duplicate / CompareScalar / Compare / Reduce<SUM,int32>
 *   事件：MTE2_S、MTE3_S、S_MTE3、V_S
 *   跨核：CrossCoreSetFlag/WaitFlag<0|1|2, PIPE_MTE3|MTE2|V|S>
 *   缓存：DataCacheCleanAndInvalid<int32, SINGLE_CACHE_LINE, CACHELINE_OUT>
 *   屏障：DataSyncBarrier<MemDsbT::ALL>
 *   计数器：GetSystemCycle()
 *   搬运：DataCopyPad int32（UB->GM 3 参 / GM->UB 4 参）
 * 编译命令（本目录）：
 *   source /usr/local/Ascend/ascend-toolkit/set_env.sh
 *   bisheng -DNPU_ARCH_DAV_3510 -std=c++17 --npu-arch=dav-3510 -O3 -DNDEBUG \
 *           -c --asc-aicore-lang probe_api_check.asc -o /tmp/api_check.o
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdint>
#include <cstdio>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t UB_A = 0;
constexpr uint32_t UB_B = 256;
constexpr uint32_t UB_C = 512;

__aicore__ inline void ApiCheck(__gm__ uint8_t* gm, uint32_t n)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(gm));
    LocalTensor<int32_t> a(TPosition::VECCALC, UB_A, 64);
    LocalTensor<int32_t> b(TPosition::VECCALC, UB_B, 64);
    LocalTensor<int32_t> c(TPosition::VECCALC, UB_C, 64);

    Mutex::Lock<PIPE_MTE2>(0);
    DataCopyPad(a, g[0], DataCopyExtParams{1, 256, 0, 0, 0},
                DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
    Mutex::Unlock<PIPE_MTE2>(0);
    SetFlag<HardEvent::MTE2_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE2_S>(EVENT_ID0);
    const int32_t v0 = a.GetValue(0);

    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    Mutex::Lock<PIPE_MTE3>(0);
    DataCopyPad(g[0], a, DataCopyExtParams{1, 256, 0, 0, 0});
    PipeBarrier<PIPE_MTE3>();
    Mutex::Unlock<PIPE_MTE3>(0);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID0);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID0);

    Mutex::Lock<PIPE_V>(0);
    __VEC_SCOPE__ {
        MaskReg full = CreateMask<int32_t, MaskPattern::ALL>();
        MaskReg mk;
        RegTensor<int32_t> va, vb, ones, cnt;
        LoadAlign(va, reinterpret_cast<__ubuf__ int32_t*>(UB_A));
        Duplicate(vb, static_cast<int32_t>(v0 + n));
        Duplicate(ones, 1);
        CompareScalar<int32_t, CMPMODE::EQ>(mk, va, static_cast<int32_t>(n), full);
        Compare<int32_t, CMPMODE::EQ>(mk, va, vb, mk);
        Reduce<ReduceType::SUM, int32_t>(cnt, ones, mk);
        StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_B), cnt, full);
    }
    Mutex::Unlock<PIPE_V>(0);
    SetFlag<HardEvent::V_S>(EVENT_ID0);
    WaitFlag<HardEvent::V_S>(EVENT_ID0);
    const int32_t cnt = b.GetValue(0);

    if (cnt >= 0) {
        CrossCoreSetFlag<0x0, PIPE_MTE3>(1);
        CrossCoreWaitFlag<0x0, PIPE_MTE2>(1);
        CrossCoreSetFlag<0x0, PIPE_MTE3>(2);
        CrossCoreWaitFlag<0x0, PIPE_S>(2);
        CrossCoreSetFlag<0x0, PIPE_V>(3);
        CrossCoreWaitFlag<0x0, PIPE_V>(3);
        CrossCoreSetFlag<0x1, PIPE_MTE3>(4);
        CrossCoreWaitFlag<0x1, PIPE_MTE2>(4);
        CrossCoreSetFlag<0x2, PIPE_MTE3>(5);
        CrossCoreWaitFlag<0x2, PIPE_MTE2>(5);
    }

    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(g[0]);
    DataSyncBarrier<MemDsbT::ALL>();

    const int64_t cyc = GetSystemCycle();
    c.SetValue(0, static_cast<int32_t>(cyc & 0xFFFFFFFF));
    SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
    Mutex::Lock<PIPE_MTE3>(0);
    DataCopyPad(g[64], c, DataCopyExtParams{1, 4, 0, 0, 0});
    PipeBarrier<PIPE_MTE3>();
    Mutex::Unlock<PIPE_MTE3>(0);
}
}  // namespace


__aicore__ inline void ApiCheck2(__gm__ uint8_t* gm, uint32_t st, uint32_t naiv, uint32_t T)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(gm));
    LocalTensor<int32_t> a(TPosition::VECCALC, UB_A, 1024);
    LocalTensor<int32_t> b(TPosition::VECCALC, UB_B, 1024);
    Mutex::Lock<PIPE_V>(0);
    __VEC_SCOPE__ {
        MaskReg full = CreateMask<int32_t, MaskPattern::ALL>();
        MaskReg mHead, mRank, mEq, mAll;
        RegTensor<int32_t> idx, v, rank, pos, ticket, ones, cnt, zero, base, tmp;
        Duplicate(ones, 1);
        Duplicate(zero, 0);
        Duplicate(base, static_cast<int32_t>((0x5153 << 16) | ((T & 0xFF) << 8)));
        Arange(idx, 0);
        ShiftRights(rank, idx, static_cast<int16_t>(st == 1 ? 0 : (st == 8 ? 3 : 4)), full);
        ShiftLefts(tmp, rank, static_cast<int16_t>(st == 1 ? 0 : (st == 8 ? 3 : 4)), full);
        Sub(pos, idx, tmp, full);
        CompareScalar<int32_t, CMPMODE::EQ>(mHead, pos, 0, full);
        CompareScalar<int32_t, CMPMODE::LT>(mRank, rank, static_cast<int32_t>(naiv), full);
        Add(ticket, base, rank, full);
        Select(ticket, ticket, zero, mRank);
        MaskAnd(mAll, mHead, mRank, full);
        LoadAlign(v, reinterpret_cast<__ubuf__ int32_t*>(UB_A));
        Compare<int32_t, CMPMODE::EQ>(mEq, v, ticket, full);
        MaskAnd(mEq, mEq, mAll, full);
        ReduceSum<int32_t>(cnt, ticket, mEq);
        StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_B), cnt, full);
    }
    Mutex::Unlock<PIPE_V>(0);
    SetFlag<HardEvent::V_S>(EVENT_ID0);
    WaitFlag<HardEvent::V_S>(EVENT_ID0);
    const int32_t c = a.GetValue(0);
    if (c < 0) {
        b.SetValue(0, c);
    }
}

__global__ __mix__(1, 2) void api_check2_kernel(__gm__ uint8_t* gm, uint32_t st, uint32_t naiv)
{
    InitSocState();
    if ASCEND_IS_AIV {
        ApiCheck2(gm, st, naiv, 3);
    }
    PipeBarrier<PIPE_ALL>();
}

__global__ __mix__(1, 2) void api_check_kernel(__gm__ uint8_t* gm, uint32_t n)
{
    InitSocState();
    if ASCEND_IS_AIV {
        ApiCheck(gm, n);
    }
    PipeBarrier<PIPE_ALL>();
}

int32_t main()
{
    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t* d = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&d), 1024, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(d, 1024, 0, 1024);
    api_check_kernel<<<28, 0, stream>>>(d, 7);
    const aclError err = aclrtSynchronizeStream(stream);
    printf("[api_check] launch: %s\n", err == ACL_SUCCESS ? "OK" : "FAILED");
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return err == ACL_SUCCESS ? 0 : 1;
}
