/**
 * probe_aic_aiv.asc —— M64：AIC↔AIV 对照（mode2 点对点 vs mode0 all-to-all 的语义与陷阱）
 *
 * 为什么单独一个工程：mission 的隔离矩阵要求"以及 AIC↔AIV 对照"，而 AIV 侧探针无法覆盖。
 * 本探针不需要 AIC 写 GM（AIC 写 GM 只能走 Fixpipe，脚手架大），只测**跨类型会合的语义与陷阱**：
 *
 *   v0 chain_mix_standard（预期正常返回）：
 *      AIV：写第 1 轮 ticket → **mode0 AIV 全核会合(flag3)** → mode2 set<MTE3>(flag4) 通知配对 AIC
 *           → mode2 wait<MTE2>(flag5) 等配对 AIC → 写第 2 轮 ticket → 读回整表
 *      AIC：mode2 wait<PIPE_S>(flag4)  [每核等自己那 2 个 AIV] → **mode0 AIC 全核会合(flag6)**
 *           → mode2 set<PIPE_FIX>(flag5) 通知配对 AIV
 *      ⇒ 这就是 docs/05 §2 给的"跨类型 all-to-all 标准组合"（AIVs→AIC(mode2)→AIC barrier(mode0)→AIC→AIVs(mode2)）。
 *      host 判据：56 核都写出并读回第 2 轮 ticket（rc=0）。
 *
 *   v1 aic_set_wrong_pipe（预期挂死）：
 *      AIC 把 mode0 的 set 挂到 **PIPE_MTE3** —— AIC 上不存在 MTE3（`IsSplitCubePipe` 不含 MTE3，
 *      见 impl/basic_api/kernel_event.h:264），该指令**根本不发射**（静默空操作），
 *      于是 AIC 随后的 `wait<PIPE_S>(flag6)` 永远等不到 → 对侧永久挂死。
 *      ⇒ 复现 docs/05 的硬规则"M24/M17 挂死根因：AIC 侧同步不得挂 PIPE_MTE3"。
 *
 *   v2 cross_group_mode2_wait（预期挂死）：mode2 是**点对点**（AI Core 内 AIC ↔ 其 2 个 AIV）：
 *      只有 AIC 0 会 set flag5，而**全体 56 个 AIV 都在等 flag5**；若 mode2 真是点对点，
 *      则只有 AIC 0 的 2 个 AIV 被放行、其余 54 个永久挂死 ⇒ kernel 不返回；
 *      若 kernel 正常返回，反而说明 mode2 存在 all-to-all 语义（与文档矛盾）。二值可判。
 *
 * 用法：./probe_aic_aiv <variant> <runNo> [outdir]
 * 退出码：0 = 比过且全核通过；1 = 比过有差异；2 = launch 失败/没得比；超时(124) = HANG（预期，记录之）
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

namespace {
using namespace AscendC;

constexpr uint32_t NAIVMAX = 64;
constexpr uint32_t MAGIC16 = 0x5153;
constexpr uint32_t UB_REG = 0;
constexpr uint32_t UB_STG = 4096;
constexpr uint32_t UB_TMP = 4160;
constexpr MutexID BUF_D = 0;

// 全部用普通 id（3/4/5/6），避开 docs 里 SyncAll/Matmul 占用的 0-2/11-14
constexpr uint16_t F_AV_BAR = 3;    // mode0：AIV 全核会合
constexpr uint16_t F_A2C = 4;       // mode2：AIV → 配对 AIC
constexpr uint16_t F_C2A = 5;       // mode2：AIC → 配对 AIV
constexpr uint16_t F_AIC_BAR = 6;   // mode0：AIC 全核会合
constexpr uint16_t F_AV_BAR2 = 7;  // mode0：AIV 全核会合（发布第 2 轮产物后再读回）

__aicore__ inline int32_t Ticket(uint32_t T, uint32_t rank)
{
    return static_cast<int32_t>((MAGIC16 << 16) | ((T & 0xFFu) << 8) | (rank & 0xFFu));
}

static inline int32_t HostTicket(uint32_t T, uint32_t rank)
{
    return static_cast<int32_t>((MAGIC16 << 16) | ((T & 0xFFu) << 8) | (rank & 0xFFu));
}

template <pipe_t pipe>
__aicore__ inline void BufAcq(MutexID id) { GetBufInternal<pipe, false>(id); }
template <pipe_t pipe>
__aicore__ inline void BufRel(MutexID id) { RlsBufInternal<pipe, false>(id); }

__aicore__ inline void WriteSlot(__gm__ int32_t* tab, uint32_t rank, uint32_t T, uint32_t st)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(tab);
    LocalTensor<int32_t> stg(TPosition::VECCALC, UB_STG, 32);
    const int32_t tk = Ticket(T, rank);
    for (uint32_t j = 0; j < st; ++j) {
        stg.SetValue(j, tk);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    BufAcq<PIPE_MTE3>(BUF_D);
    DataCopyPad(g[rank * st], stg, DataCopyExtParams{1, st * 4u, 0, 0, 0});
    PipeBarrier<PIPE_MTE3>();
    BufRel<PIPE_MTE3>(BUF_D);
    SetFlag<HardEvent::MTE3_S>(EVENT_ID1);
    WaitFlag<HardEvent::MTE3_S>(EVENT_ID1);
}
}  // namespace

__global__ __mix__(1, 2) void probe_aic_aiv_kernel(__gm__ uint8_t* tab, __gm__ uint8_t* obs, __gm__ uint8_t* dump,
                                                   uint32_t naiv, uint32_t st, uint32_t variant)
{
    using namespace AscendC;
    InitSocState();
    __gm__ int32_t* tabI = reinterpret_cast<__gm__ int32_t*>(tab);
    const uint32_t words = NAIVMAX * st;

    if ASCEND_IS_AIV {
        const uint32_t rank = GetBlockIdx();
        const uint32_t grp = rank / 2;
        LocalTensor<int32_t> o(TPosition::VECCALC, UB_TMP, 8);
        for (uint32_t j = 0; j < 8; ++j) o.SetValue(j, -7);
        const int64_t t0 = GetSystemCycle();
        WriteSlot(tabI, rank, 1, st);
        // ① AIV 全核 mode0 会合
        CrossCoreSetFlag<0x0, PIPE_MTE3>(F_AV_BAR);
        CrossCoreWaitFlag<0x0, PIPE_MTE2>(F_AV_BAR);
        const int64_t t1 = GetSystemCycle();
        if (variant == 0 || variant == 5) {
            CrossCoreSetFlag<0x2, PIPE_MTE3>(F_A2C);      // 通知配对 AIC（mode2，1 set 配 2 wait）
            CrossCoreWaitFlag<0x2, PIPE_MTE2>(F_C2A);     // 等配对 AIC（它做完 AIC 全核会合后才 set）
            const int64_t t2 = GetSystemCycle();
            WriteSlot(tabI, rank, 2, st);                 // 第 2 段：被 AIC 会合门控
            CrossCoreSetFlag<0x0, PIPE_MTE3>(F_AV_BAR2);  // 发布第 2 轮产物（否则读回窗口未关）
            CrossCoreWaitFlag<0x0, PIPE_MTE2>(F_AV_BAR2);
            o.SetValue(1, static_cast<int32_t>(t1 & 0xFFFFFFFF));
            o.SetValue(2, static_cast<int32_t>(t2 & 0xFFFFFFFF));
        } else if (variant == 1) {
            CrossCoreSetFlag<0x2, PIPE_MTE3>(F_A2C);      // 同上（AIC 侧会挂死，本核也等不到回通知）
            CrossCoreWaitFlag<0x2, PIPE_MTE2>(F_C2A);
            WriteSlot(tabI, rank, 2, st);
        } else if (variant == 3 || variant == 4) {
            WriteSlot(tabI, rank, 2, st);                 // 只做 AIV 全核会合，不碰 mode2
            CrossCoreSetFlag<0x0, PIPE_MTE3>(F_AV_BAR2);
            CrossCoreWaitFlag<0x0, PIPE_MTE2>(F_AV_BAR2);
        } else {                                          // v2：全体 AIV 都等 mode2 flag5
            if (grp == 0) {
                CrossCoreSetFlag<0x2, PIPE_MTE3>(F_A2C);  // 只有 AIC 0 的配对 AIV 会 set
            }
            CrossCoreWaitFlag<0x2, PIPE_MTE2>(F_C2A);     // 跨组等：点对点语义下永不满足
            WriteSlot(tabI, rank, 2, st);
        }
        const int64_t t3 = GetSystemCycle();
        // 读回整表，数第 2 轮 ticket 命中
        GlobalTensor<int32_t> g;
        g.SetGlobalBuffer(tabI);
        BufAcq<PIPE_MTE2>(BUF_D);
        DataCopyPad(LocalTensor<int32_t>(TPosition::VECCALC, UB_REG, words), g[0],
                    DataCopyExtParams{1, words * 4u, 0, 0, 0}, DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
        PipeBarrier<PIPE_MTE2>();
        BufRel<PIPE_MTE2>(BUF_D);
        SetFlag<HardEvent::MTE2_S>(EVENT_ID2);
        WaitFlag<HardEvent::MTE2_S>(EVENT_ID2);
        int32_t hit = 0;
        LocalTensor<int32_t> rl(TPosition::VECCALC, UB_REG, words);
        for (uint32_t i = 0; i < naiv; ++i) {
            if (rl.GetValue(i * st) == Ticket(2, i)) ++hit;
        }
        o.SetValue(0, hit);
        o.SetValue(3, static_cast<int32_t>(t0 & 0xFFFFFFFF));
        o.SetValue(4, static_cast<int32_t>(t3 & 0xFFFFFFFF));
        o.SetValue(5, 0x5A5A);
        o.SetValue(6, static_cast<int32_t>(rank));
        SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
        GlobalTensor<int32_t> og;
        og.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(obs));
        BufAcq<PIPE_MTE3>(BUF_D);
        DataCopyPad(og[rank * 8], o, DataCopyExtParams{1, 32, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(BUF_D);
        PipeBarrier<PIPE_ALL>();
    }

    if ASCEND_IS_AIC {
        if (variant == 5) {
            CrossCoreWaitFlag<0x2, PIPE_S>(F_A2C);
            CrossCoreSetFlag<0x2, PIPE_FIX>(F_C2A);       // 不做 AIC 全核会合，只中继
        } else if (variant == 3) {
            // AIC 空闲（对照）
        } else if (variant == 0) {
            CrossCoreWaitFlag<0x2, PIPE_S>(F_A2C);                       // 等本 AI Core 的 2 个 AIV
            CrossCoreSetFlag<0x0, PIPE_FIX>(F_AIC_BAR);                  // AIC 全核 mode0 会合
            CrossCoreWaitFlag<0x0, PIPE_S>(F_AIC_BAR);
            CrossCoreSetFlag<0x2, PIPE_FIX>(F_C2A);                      // 通知配对 AIV（2 wait 配 1 set）
        } else if (variant == 1) {
            CrossCoreWaitFlag<0x2, PIPE_S>(F_A2C);
            CrossCoreSetFlag<0x0, PIPE_MTE3>(F_AIC_BAR);   // **错挂**：AIC 上无 MTE3 ⇒ 静默空操作
            CrossCoreWaitFlag<0x0, PIPE_S>(F_AIC_BAR);     // ⇒ 永久等待（预期挂死）
            CrossCoreSetFlag<0x2, PIPE_FIX>(F_C2A);
        } else if (variant == 4) {
            CrossCoreSetFlag<0x0, PIPE_FIX>(F_AIC_BAR);   // 隔离 AIC 侧：只做 AIC 全核 mode0 会合
            CrossCoreWaitFlag<0x0, PIPE_S>(F_AIC_BAR);
        } else {
            if (GetBlockIdx() == 0) {
                CrossCoreWaitFlag<0x2, PIPE_S>(F_A2C);
                CrossCoreSetFlag<0x2, PIPE_FIX>(F_C2A);    // 只发给 AI Core 0 的 2 个 AIV（点对点）
            }
        }
        PipeBarrier<PIPE_ALL>();
    }
    PipeBarrier<PIPE_ALL>();
}

struct AicVar {
    const char* name;
    uint32_t variant, st;
    const char* expect;
};
static const AicVar AV[] = {
    {"v0_chain_mix_standard", 0, 16, "正常返回，56 核读出第 2 轮 ticket（rc=0）"},
    {"v1_aic_set_wrong_pipe", 1, 16, "挂死（AIC 侧 set 挂 PIPE_MTE3 = 静默空操作）"},
    {"v2_cross_group_mode2_wait", 2, 16, "挂死（mode2 点对点：别组的 set 满足不了我的 wait）"},
    {"v3_aiv_only", 3, 16, "隔离用：AIV 只做全核 mode0 会合、AIC 空闲"},
    {"v4_aic_only", 4, 16, "隔离用：AIC 只做全核 mode0 会合、AIV 只做自身会合"},
    {"v5_aic_relay_nobar", 5, 16, "对照 v0：AIC 不做全核会合，只把 mode2 直通中继"},
};
static const uint32_t NAV = 6;

int main(int argc, char** argv)
{
    if (argc < 3) {
        fprintf(stderr, "usage: %s <variant|idx> <runNo> [outdir]\n", argv[0]);
        for (uint32_t i = 0; i < NAV; ++i) printf("  %u  %-26s %s\n", i, AV[i].name, AV[i].expect);
        return 2;
    }
    int vi = -1;
    for (uint32_t i = 0; i < NAV; ++i) {
        if (strcmp(argv[1], AV[i].name) == 0) vi = static_cast<int>(i);
    }
    if (vi < 0) vi = atoi(argv[1]);
    if (vi < 0 || vi >= static_cast<int>(NAV)) return 2;
    const int runNo = atoi(argv[2]);
    const AicVar& V = AV[vi];

    aclInit(nullptr);
    aclrtSetDevice(0);
    int64_t aicNum = 0;
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    const uint32_t naiv = 2u * static_cast<uint32_t>(aicNum);
    const uint32_t words = NAIVMAX * V.st;
    const size_t tabBytes = static_cast<size_t>(words) * 4u;
    const size_t obsBytes = static_cast<size_t>(NAIVMAX) * 8 * 4u;
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t *dTab = nullptr, *dObs = nullptr, *dD = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&dTab), tabBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dObs), obsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dD), 256, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dTab, tabBytes, 0, tabBytes);
    aclrtMemset(dObs, obsBytes, 0x5A, obsBytes);
    aclrtMemset(dD, 256, 0, 256);
    probe_aic_aiv_kernel<<<static_cast<uint32_t>(aicNum), 0, stream>>>(dTab, dObs, dD, naiv, V.st, V.variant);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("SUMMARY variant=%s run=%d launch=FAILED err=%d rc=2\n", V.name, runNo, static_cast<int>(err));
        return 2;
    }
    std::vector<int32_t> hObs(obsBytes / 4, 0), hTab(words, 0);
    aclrtMemcpy(hObs.data(), obsBytes, dObs, obsBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hTab.data(), tabBytes, dTab, tabBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    int nRow = 0, hitMin = 1 << 20, nFull = 0;
    for (uint32_t c = 0; c < naiv; ++c) {
        const int32_t* row = &hObs[c * 8];
        if (row[5] != 0x5A5A) continue;
        ++nRow;
        if (row[0] < hitMin) hitMin = row[0];
        if (row[0] == static_cast<int32_t>(naiv)) ++nFull;
    }
    uint32_t finalOK = 0;
    for (uint32_t c = 0; c < naiv; ++c) {
        if (hTab[c * V.st] == HostTicket(2, c)) ++finalOK;
    }
    if (hitMin > 1 << 19) hitMin = -1;
    const bool ok = (V.variant == 0 || V.variant == 3 || V.variant == 4 || V.variant == 5)
                        ? (nFull == static_cast<int>(naiv) && finalOK == naiv)
                                                       : true;
    printf("SUMMARY variant=%s run=%d vi=%d st=%u naiv=%u obs_rows=%d hit_min=%d hit_full=%d/%u "
           "final_head_ok=%u rc=%d\n",
           V.name, runNo, vi, V.st, naiv, nRow, hitMin, nFull, naiv, finalOK, ok ? 0 : 1);
    return ok ? 0 : 1;
}
