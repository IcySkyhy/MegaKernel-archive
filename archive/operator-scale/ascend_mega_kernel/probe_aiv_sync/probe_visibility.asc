/**
 * probe_visibility.asc —— M64：跨核 GM 可见性最小实验（把「屏障」与「可见性」两件事拆开测）
 *
 * 动机（M53 读数）：不挂 flag、纯轮询 4096 次也读不到对端的写（0/56 收敛）。这一条与"屏障语义"无关，
 * 它指向"跨核 GM 写→读 的可见性本身需要额外动作"。官方跨核交接代码（KFP/KFC、HCCL 消息区）里
 * 写方在通知前一律做 `DataCacheCleanAndInvalid<..., CACHELINE_OUT>` + `DataSyncBarrier<ALL>`，
 * 而本仓所有跨核交接（m19/m15/m20/m0）都没有这一步。本探针就是把这一步隔离出来验。
 *
 * 结构（每个变体一次独立进程、一次 launch）：
 *   ① 全体 AIV mode0 起点屏障（对齐相位；不是被测对象）
 *   ② 发布：按变体选 单写者(核0) / 全体各写自家槽；发布动作按变体选
 *        M0 = MTE3 写 + MTE3_S 排空        （本仓现行）
 *        M1 = M0 + DCCI(clean) + DSB       （官方 KFC/HCCL 范式）
 *        M2 = 标量直写 GM + DCCI            （SuperKernel 自动同步范式）
 *        M3 = MTE3 写 + PipeBarrier<MTE3>（M53 探针用的排空形态）
 *   ③ **不挂任何 flag**，纯轮询读回整区（上界 PBOUND），记录第几次看到全量 / 最多看到几格
 *   ④ 之后再来一次 mode0 屏障 + 一次读回：若 ④ 能读到全量而 ③ 读不到，说明"可见性由屏障触发"
 *   （读侧另有变体在读前插 DCCI）
 *
 * 读数（设备侧）：每核一行 obs = {rank, seenAt(轮询第几次收敛,-1=未收敛), bestSeen, finalSeen, ...}
 * host 侧另外**直接读最终 region**，判"写是否落盘"（写丢失 vs 读不到 的分界）。
 * 退出码：0 = 该变体所有核 finalSeen == naiv（数据最终可见）；1 = 有核不可见；2 = launch 失败。
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <vector>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

constexpr uint32_t NAIVMAX = 64;
constexpr uint32_t OBSW = 8;
constexpr uint32_t MAGIC16 = 0x5153;
constexpr uint32_t PBOUND = 4096;

constexpr uint32_t UB_REG = 0;      // 4KB 读回区
constexpr uint32_t UB_A0 = 4096;    // 读回来的全量（行1）
constexpr uint32_t UB_STG = 8192;   // 写暂存
constexpr uint32_t UB_TMP = 8256;
constexpr uint32_t UB_OBS = 8512;
constexpr uint32_t UB_END = 9024;
constexpr MutexID BUF_D = 0;

// 发布方式
enum MKind { MK_MTE3_MTE3S = 0, MK_MTE3_DCCI = 1, MK_SCALAR_DCCI = 2, MK_MTE3_PIPEBAR = 3 };

__aicore__ inline int32_t Ticket(uint32_t rank) { return static_cast<int32_t>((MAGIC16 << 16) | 0x0100 | (rank & 0xFF)); }
static inline int32_t HostTicket(uint32_t rank) { return static_cast<int32_t>((MAGIC16 << 16) | 0x0100 | (rank & 0xFF)); }

template <pipe_t pipe>
__aicore__ inline void BufAcq(MutexID id) { GetBufInternal<pipe, false>(id); }
template <pipe_t pipe>
__aicore__ inline void BufRel(MutexID id) { RlsBufInternal<pipe, false>(id); }

__aicore__ inline void RegionFlush(__gm__ int32_t* region)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(region);
    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(g);
    DataSyncBarrier<MemDsbT::ALL>();
}

__aicore__ inline void ReadRegion(__gm__ int32_t* region, uint32_t words)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(region);
    BufAcq<PIPE_MTE2>(BUF_D);
    DataCopyPad(LocalTensor<int32_t>(TPosition::VECCALC, UB_REG, words), g[0],
                DataCopyExtParams{1, words * 4u, 0, 0, 0}, DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
    PipeBarrier<PIPE_MTE2>();
    BufRel<PIPE_MTE2>(BUF_D);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID2);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
}

// 数「槽位 head 命中当前 ticket 的个数」（st = 槽跨度 word 数）
__aicore__ inline int32_t CountHeads(uint32_t words, uint32_t st, uint32_t naiv)
{
    const int16_t sh = static_cast<int16_t>(st == 1 ? 0 : (st == 8 ? 3 : 4));
    int32_t out = 0;
    BufAcq<PIPE_V>(BUF_D);
    __VEC_SCOPE__ {
        MaskReg full = CreateMask<int32_t, MaskPattern::ALL>();
        MaskReg mHead, mRank, mEq;
        RegTensor<int32_t> idx, v, rankv, pos, ticket, base, ones, acc, cnt, tmp;
        Duplicate(base, static_cast<int32_t>(MAGIC16 << 16) + 0x0100);
        Duplicate(ones, 1);
        Duplicate(acc, 0);
        const uint16_t nChunk = static_cast<uint16_t>(words >> 6);
        for (uint16_t c = 0; c < nChunk; ++c) {
            Arange(idx, static_cast<int32_t>(c) * 64);
            ShiftRights(rankv, idx, sh, full);
            ShiftLefts(tmp, rankv, sh, full);
            Sub(pos, idx, tmp, full);
            CompareScalar<int32_t, CMPMODE::EQ>(mHead, pos, 0, full);
            CompareScalar<int32_t, CMPMODE::LT>(mRank, rankv, static_cast<int32_t>(naiv), full);
            MaskAnd(mHead, mHead, mRank, full);
            Add(ticket, base, rankv, full);
            LoadAlign(v, reinterpret_cast<__ubuf__ int32_t*>(UB_REG + c * 256));
            Compare<int32_t, CMPMODE::EQ>(mEq, v, ticket, full);
            MaskAnd(mEq, mEq, mHead, full);
            ReduceSum<int32_t>(cnt, ones, mEq);
            Add(acc, acc, cnt, full);
        }
        StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_TMP), acc, full);
    }
    BufRel<PIPE_V>(BUF_D);
    SetFlag<HardEvent::V_S>(EVENT_ID7);
    WaitFlag<HardEvent::V_S>(EVENT_ID7);
    out = LocalTensor<int32_t>(TPosition::VECCALC, UB_TMP, 64).GetValue(0);
    return out;
}

__aicore__ inline void Publish(__gm__ int32_t* region, uint32_t rank, uint32_t st, uint32_t mk)
{
    const int32_t tk = Ticket(rank);
    if (mk == MK_SCALAR_DCCI) {
        *reinterpret_cast<__gm__ int32_t*>(region + rank * st) = tk;   // 标量直写 GM
        RegionFlush(region + rank * st);
        return;
    }
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(region);
    LocalTensor<int32_t> stg(TPosition::VECCALC, UB_STG, 16);
    for (uint32_t j = 0; j < st; ++j) {
        stg.SetValue(j, tk);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    BufAcq<PIPE_MTE3>(BUF_D);
    DataCopyPad(g[rank * st], stg, DataCopyExtParams{1, st * 4u, 0, 0, 0});
    PipeBarrier<PIPE_MTE3>();
    BufRel<PIPE_MTE3>(BUF_D);
    if (mk == MK_MTE3_MTE3S) {
        SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
    } else if (mk == MK_MTE3_DCCI) {
        SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
        RegionFlush(region + rank * st);
    } else {
        // MK_MTE3_PIPEBAR：只靠 PipeBarrier<MTE3>
    }
}
}  // namespace

__global__ __mix__(1, 2) void probe_visibility_kernel(__gm__ uint8_t* region, __gm__ uint8_t* obs,
                                                      __gm__ uint8_t* dump, uint32_t naiv, uint32_t st,
                                                      uint32_t mk, uint32_t allWriters, uint32_t rdFlush,
                                                      uint32_t tailBarrier)
{
    using namespace AscendC;
    InitSocState();
    __gm__ int32_t* regionI = reinterpret_cast<__gm__ int32_t*>(region);
    const uint32_t words = NAIVMAX * st;

    if ASCEND_IS_AIV {
        const uint32_t rank = GetBlockIdx();
        LocalTensor<int32_t> obsUB(TPosition::VECCALC, UB_OBS, OBSW);
        for (uint32_t j = 0; j < OBSW; ++j) {
            obsUB.SetValue(j, -7);
        }
        int32_t seenAt = -1, bestSeen = 0, finalSeen = 0;
        const int64_t t0 = GetSystemCycle();
        if (rank < naiv) {
            // ① 起点屏障（全体 AIV mode0，对齐相位；不是被测对象）
            CrossCoreSetFlag<0x0, PIPE_MTE3>(1);
            CrossCoreWaitFlag<0x0, PIPE_MTE2>(1);
            // ② 发布
            if (allWriters == 1 || rank == 0) {
                Publish(regionI, rank, st, mk);
            }
            const int64_t t1 = GetSystemCycle();
            // ③ 纯轮询（不挂 flag）
            for (uint32_t k = 0; k < PBOUND; ++k) {
                if (rdFlush) RegionFlush(regionI);
                ReadRegion(regionI, words);
                const int32_t c = CountHeads(words, st, naiv);
                if (c > bestSeen) bestSeen = c;
                if (c >= static_cast<int32_t>(naiv)) {
                    seenAt = static_cast<int32_t>(k);
                    break;
                }
            }
            const int64_t t2 = GetSystemCycle();
            // ④ 尾屏障 + 再读一次
            if (tailBarrier) {
                CrossCoreSetFlag<0x0, PIPE_MTE3>(1);
                CrossCoreWaitFlag<0x0, PIPE_MTE2>(1);
            }
            ReadRegion(regionI, words);
            finalSeen = CountHeads(words, st, naiv);
            obsUB.SetValue(0, static_cast<int32_t>(rank));
            obsUB.SetValue(1, seenAt);
            obsUB.SetValue(2, bestSeen);
            obsUB.SetValue(3, finalSeen);
            obsUB.SetValue(4, static_cast<int32_t>(t0 & 0xFFFFFFFF));
            obsUB.SetValue(5, static_cast<int32_t>(t1 & 0xFFFFFFFF));
            obsUB.SetValue(6, static_cast<int32_t>(t2 & 0xFFFFFFFF));
            obsUB.SetValue(7, 0x5A5A);
        }
        SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
        GlobalTensor<int32_t> og;
        og.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(obs));
        BufAcq<PIPE_MTE3>(BUF_D);
        DataCopyPad(og[rank * OBSW], obsUB, DataCopyExtParams{1, OBSW * 4u, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(BUF_D);
        PipeBarrier<PIPE_ALL>();
    }
    PipeBarrier<PIPE_ALL>();
}

static const char* MKNAME[4] = {"MTE3+MTE3_S", "MTE3+DCCI+DSB", "SCALAR+DCCI", "MTE3+PipeBarrier"};

struct VisVar {
    const char* name;
    uint32_t mk, allWriters, rdFlush, tailBarrier, st, blocks;
};

static const VisVar VV[] = {
    // allWriters=1：全体 56 核各写自家 64B 槽；allWriters=0：只有 rank0 写（单写者可见性对照）
    {"v0_wall_M0_R0_tail1", MK_MTE3_MTE3S, 1, 0, 1, 16, 28},
    {"v1_wall_M1_R0_tail1", MK_MTE3_DCCI, 1, 0, 1, 16, 28},
    {"v2_wall_M0_R1_tail1", MK_MTE3_MTE3S, 1, 1, 1, 16, 28},
    {"v3_wall_M2_R0_tail1", MK_SCALAR_DCCI, 1, 0, 1, 16, 28},
    {"v4_wall_M3_R0_tail1", MK_MTE3_PIPEBAR, 1, 0, 1, 16, 28},
    {"v5_wall_dense_M1_R0_tail1", MK_MTE3_DCCI, 1, 0, 1, 1, 28},
    {"v6_wall_M0_R0_tail0", MK_MTE3_MTE3S, 1, 0, 0, 16, 28},
    {"v7_w1_M0_R0_tail1", MK_MTE3_MTE3S, 0, 0, 1, 16, 28},
    {"v8_w1_M1_R0_tail0", MK_MTE3_DCCI, 0, 0, 0, 16, 28},
    {"v9_wall_M0_R0_28aiv", MK_MTE3_MTE3S, 1, 0, 1, 16, 14},
};
static const uint32_t NVV = static_cast<uint32_t>(sizeof(VV) / sizeof(VV[0]));

int main(int argc, char** argv)
{
    if (argc < 3) {
        fprintf(stderr, "usage: %s <variantIdx|name> <runNo> [outdir]\n", argv[0]);
        for (uint32_t i = 0; i < NVV; ++i) printf("  %2u  %s\n", i, VV[i].name);
        return 2;
    }
    int vi = -1;
    for (uint32_t i = 0; i < NVV; ++i) {
        if (strcmp(argv[1], VV[i].name) == 0) vi = static_cast<int>(i);
    }
    if (vi < 0 && argv[1][0] >= '0' && argv[1][0] <= '9') vi = atoi(argv[1]);
    if (vi < 0 || vi >= static_cast<int>(NVV)) {
        fprintf(stderr, "unknown variant %s\n", argv[1]);
        return 2;
    }
    const int runNo = atoi(argv[2]);
    const VisVar& V = VV[vi];

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    const uint32_t naiv = 2u * V.blocks;
    const uint32_t words = NAIVMAX * V.st;
    const size_t regBytes = static_cast<size_t>(words) * 4u;
    const size_t obsBytes = static_cast<size_t>(NAIVMAX) * OBSW * 4u;
    uint8_t *dReg = nullptr, *dObs = nullptr, *dDump = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&dReg), regBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dObs), obsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dDump), 256, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dReg, regBytes, 0, regBytes);
    aclrtMemset(dObs, obsBytes, 0x5A, obsBytes);
    aclrtMemset(dDump, 256, 0, 256);
    probe_visibility_kernel<<<V.blocks, 0, stream>>>(dReg, dObs, dDump, naiv, V.st, V.mk, V.allWriters,
                                                     V.rdFlush, V.tailBarrier);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("[vis] variant=%s run=%d launch=FAILED err=%d\n", V.name, runNo, static_cast<int>(err));
        return 2;
    }
    std::vector<int32_t> hObs(obsBytes / 4, 0), hReg(words, 0);
    aclrtMemcpy(hObs.data(), obsBytes, dObs, obsBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hReg.data(), regBytes, dReg, regBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    uint32_t hostHeadOK = 0, hostZero = 0, hostOther = 0;
    for (uint32_t c = 0; c < naiv; ++c) {
        const int32_t v = hReg[c * V.st];
        if (v == HostTicket(c)) ++hostHeadOK;
        else if (v == 0) ++hostZero;
        else ++hostOther;
    }
    int nSeen = 0, nFinal = 0, minSeen = 1 << 20, maxSeen = -1, nObs = 0;
    int32_t maxBest = 0;
    int64_t itSum = 0;
    for (uint32_t c = 0; c < naiv; ++c) {
        const int32_t* row = &hObs[c * OBSW];
        if (row[7] != 0x5A5A) continue;
        ++nObs;
        if (row[1] >= 0) {
            ++nSeen;
            itSum += row[1];
            if (row[1] < minSeen) minSeen = row[1];
            if (row[1] > maxSeen) maxSeen = row[1];
        }
        if (row[3] >= static_cast<int32_t>(naiv)) ++nFinal;
        if (row[2] > maxBest) maxBest = row[2];
    }
    if (maxSeen < 0) maxSeen = -1;
    if (minSeen > 1 << 19) minSeen = -1;
    // 判据随单写者/全体写者切换：全体写 ⇒ 56 槽都应可见；单写者 ⇒ 只有 1 槽可见（其余必须为 0）
    const bool ok = (V.allWriters == 1) ? ((nFinal == static_cast<int>(naiv)) && (hostHeadOK == naiv))
                                        : ((hostHeadOK == 1u) && (hostZero == naiv - 1u));
    printf("SUMMARY variant=%s run=%d vi=%d mk=%s(%u) allWriters=%u rdFlush=%u tailBarrier=%u st=%u naiv=%u "
           "poll_converged=%d/%u iter_min=%d iter_max=%d maxBestSeen=%d final_seen=%d/%u host_head_ok=%u "
           "host_zero=%u host_other=%u obs_rows=%d rc=%d\n",
           V.name, runNo, vi, MKNAME[V.mk], V.mk, V.allWriters, V.rdFlush, V.tailBarrier, V.st, naiv, nSeen,
           naiv, minSeen, maxSeen, maxBest, nFinal, naiv, hostHeadOK, hostZero, hostOther, nObs, ok ? 0 : 1);
    return ok ? 0 : 1;
}
