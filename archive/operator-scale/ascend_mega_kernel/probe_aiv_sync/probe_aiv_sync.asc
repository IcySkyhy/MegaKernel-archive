/**
 * probe_aiv_sync.asc —— M64：AIV↔AIV 核间屏障语义与可靠性探针（独立工程，自管资源）
 *
 * 背景（用户触发事件，逐字见 mission M64）：M53 在 m19 里实测 AIV 间「写 GM → 屏障 → 全核读回」
 * 交换，多种写法都读到残缺计数（19~40/56 核），于是把选择段退成单核串行。本探针要把它定性到底：
 *   「屏障不可靠」是平台行为，还是我们用法不对（用户铁律：默认假设是后者）。
 *
 * 读数方式（mission 硬要求）：每核写一张**可校验的序号表**（本核 rank/轮次），屏障后每核读回整张表，
 * 直接判屏障正确性 —— 不靠下游数值反推；读数给**分布**（多少核残缺、几次运行收敛），不是单点。
 * 本探针把**设备侧观测**（每核读到的表）快照回 GM，host 逐词归因（缺失/陈旧/未写/越界）。
 *
 * v2 起新增两条关键轴（v1 单跑已定位到它们）：
 *   ⑨ **收尾屏障（close barrier）**：写完 set/wait 只是「发布写」，它并不阻止**跑在前面的核**
 *      把下一轮的写压进 MTE3 队列 —— 于是慢核读本轮表时，表已被快核的下一轮写覆盖。
 *      这一条与"M53 读到残缺计数"的现象完全吻合，必须在协议里补一次「读完后才允许覆写」的会合。
 *      本探针用 close = set<MTE2>(等我的读做完) + wait<MTE3>(挡住我下一轮的写) 表达。
 *   ⑩ **每轮独立窗口（sep windows）**：表不复用同样能消掉覆盖（用内存换会合）。
 *
 * 表（region）几何可参数化（隔离变量）：
 *   st = 每核槽跨度（int32 字数：1/8/16 ⇒ 4B/32B/64B）；wl = 每核写入字节数（4/32/64）
 *   st=1,wl=4 复刻 M53 probe_aiv_barrier.asc 与 m19 WriteToken（56 核 4B 挤在 224B 内）
 *   槽位 i 的每个「已写词」= TICKET(T,i) = (MAGIC16<<16)|((T&0xFF)<<8)|(i&0xFF)，T=轮次(1..rounds)
 *   未触碰位置期望 0（host 预清）。
 *
 * 变体轴全部由 host 侧表驱动（变体 struct），设备侧按 (open kind, close kind, drain, fid 策略,
 * 几何, 偏斜, 轮询, sep windows) 执行同一份骨架代码；mode/pipe 用编译期模板分发（硬件指令入参）。
 *
 * 约束（mission 硬要求）：基础 API；无 TPipe/TBuf/TQue/AllocTensor；BufferID/地址编译期静态；
 * 计算路径走 __VEC_SCOPE__（RegBase）；除有值依赖（轮询判收敛、读秒）外不挂 PIPE_S 同步。
 * 设备侧计时用 SYS_CNT（GetSystemCycle）；host 时钟不作证据。
 *
 * 用法：./probe_aiv_sync <variantIdx|name> <runNo> [outdir] [--snap] [--trace]
 * 退出码：0 = 比过且全部核/全部轮次精确匹配；1 = 比过有差异；2 = 没得比（launch 失败/输入缺失）
 */
#include "acl/acl.h"
#include "kernel_operator.h"
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

namespace {
using namespace AscendC;
using namespace AscendC::Reg;

// ---------------- 常量（编译期静态） ----------------
constexpr uint32_t NAIVMAX = 64;     // 表槽位数上限
constexpr uint32_t RNDMAX = 16;      // 轮次上限
constexpr uint32_t OBSW = 16;        // 每 (核,轮) 观测行 word 数
constexpr uint32_t MAGIC16 = 0x5153;
constexpr uint32_t SKEW_MULT = 8;    // 偏斜：每核每轮 (aiv%8)*8 次 32B 空转 DMA
constexpr uint32_t POLL_BOUND = 4096;

// UB 布局（字节；32B 对齐）
constexpr uint32_t UB_REG = 0;       // 读回区（≤ 4096B）
constexpr uint32_t UB_STG = 4096;    // ticket 写暂存
constexpr uint32_t UB_OBS = 4160;    // 观测行累积 1024B
constexpr uint32_t UB_TMP = 5184;    // VF 结果落点 512B
constexpr uint32_t UB_SKEW = 5696;   // 偏斜 DMA 落点 256B
constexpr uint32_t UB_END = 5952;

constexpr MutexID BUF_D = 0;

// 屏障 kind（mode 0/1/2 对应 FFTS 的 mode 字段；pipe 是硬件指令入参 ⇒ 必须模板常量）
enum BKind {
    BK_NONE = 0,
    BK_M0_ME3_ME2,     // mode0 SET=MTE3 WAIT=MTE2（M53/m19/m15/m20 现行）
    BK_M0_ME3_S,       // mode0 WAIT=PIPE_S（官方样例写法：整条 scalar 都被挡住）
    BK_M0_ME3_V,       // mode0 WAIT=PIPE_V（错挂：挡不住后续 MTE2 读）
    BK_M0_ME3_ME3,     // mode0 WAIT=PIPE_MTE3（错挂：同上）
    BK_M0_V_ME2,       // mode0 SET=PIPE_V（错挂：通知早于 MTE3 落盘）
    BK_M0_ME2_ME2,     // mode0 SET=PIPE_MTE2（错挂：同上）
    BK_M1_ME3_ME2,     // mode1（仅同一 AI Core 内 2 个 AIV）
    BK_M2_ME3_ME2,     // mode2（AIC↔组内 AIV；AIV 自 set/自 wait 属语义外用法）
    BK_KIND_MAX
};

// 收尾屏障 kind
enum CKind {
    CK_NONE = 0,
    CK_ME2_ME3 = 1,    // SET=MTE2（等读做完）+ WAIT=MTE3（挡下一轮写）—— 本探针候选配方
    CK_ME2_ME2 = 2,    // SET=MTE2 + WAIT=MTE2（挡不住 MTE3 写 ⇒ 应仍重叠）
    CK_ME3_ME3 = 3,    // SET=MTE3（不等读做完）+ WAIT=MTE3（错挂用法对照）
    CK_KIND_MAX
};

enum DKind { DK_NONE = 0, DK_PIPEBAR = 1, DK_MTE3_S = 2, DK_MTE3_S_DCCI = 3, DK_KIND_MAX };

enum FKind { FK_ROT7 = 0, FK_PAIR16 = 1, FK_FIXED1 = 2, FK_SAME1 = 3, FK_KIND_MAX };

__aicore__ inline int32_t Ticket(uint32_t T, uint32_t rank)
{
    return static_cast<int32_t>((MAGIC16 << 16) | ((T & 0xFFu) << 8) | (rank & 0xFFu));
}

template <pipe_t pipe>
__aicore__ inline void BufAcq(MutexID id) { GetBufInternal<pipe, false>(id); }
template <pipe_t pipe>
__aicore__ inline void BufRel(MutexID id) { RlsBufInternal<pipe, false>(id); }

__aicore__ inline void BarPair(uint32_t bk, uint16_t fid)
{
    switch (bk) {
        case BK_M0_ME3_ME2:
            CrossCoreSetFlag<0x0, PIPE_MTE3>(fid); CrossCoreWaitFlag<0x0, PIPE_MTE2>(fid); break;
        case BK_M0_ME3_S:
            CrossCoreSetFlag<0x0, PIPE_MTE3>(fid); CrossCoreWaitFlag<0x0, PIPE_S>(fid); break;
        case BK_M0_ME3_V:
            CrossCoreSetFlag<0x0, PIPE_MTE3>(fid); CrossCoreWaitFlag<0x0, PIPE_V>(fid); break;
        case BK_M0_ME3_ME3:
            CrossCoreSetFlag<0x0, PIPE_MTE3>(fid); CrossCoreWaitFlag<0x0, PIPE_MTE3>(fid); break;
        case BK_M0_V_ME2:
            CrossCoreSetFlag<0x0, PIPE_V>(fid); CrossCoreWaitFlag<0x0, PIPE_MTE2>(fid); break;
        case BK_M0_ME2_ME2:
            CrossCoreSetFlag<0x0, PIPE_MTE2>(fid); CrossCoreWaitFlag<0x0, PIPE_MTE2>(fid); break;
        case BK_M1_ME3_ME2:
            CrossCoreSetFlag<0x1, PIPE_MTE3>(fid); CrossCoreWaitFlag<0x1, PIPE_MTE2>(fid); break;
        case BK_M2_ME3_ME2:
            CrossCoreSetFlag<0x2, PIPE_MTE3>(fid); CrossCoreWaitFlag<0x2, PIPE_MTE2>(fid); break;
        default: break;
    }
}

__aicore__ inline void CloseBar(uint32_t ck, uint16_t fid)
{
    switch (ck) {
        case CK_ME2_ME3:
            CrossCoreSetFlag<0x0, PIPE_MTE2>(fid); CrossCoreWaitFlag<0x0, PIPE_MTE3>(fid); break;
        case CK_ME2_ME2:
            CrossCoreSetFlag<0x0, PIPE_MTE2>(fid); CrossCoreWaitFlag<0x0, PIPE_MTE2>(fid); break;
        case CK_ME3_ME3:
            CrossCoreSetFlag<0x0, PIPE_MTE3>(fid); CrossCoreWaitFlag<0x0, PIPE_MTE3>(fid); break;
        default: break;
    }
}

__aicore__ inline void DrainStep(uint32_t dk, __gm__ int32_t* slot)
{
    if (dk == DK_PIPEBAR) {
        PipeBarrier<PIPE_MTE3>();
    } else if (dk == DK_MTE3_S) {
        SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
    } else if (dk == DK_MTE3_S_DCCI) {
        SetFlag<HardEvent::MTE3_S>(EVENT_ID2);
        WaitFlag<HardEvent::MTE3_S>(EVENT_ID2);
        GlobalTensor<int32_t> g;
        g.SetGlobalBuffer(slot);
        DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(g);
        DataSyncBarrier<MemDsbT::ALL>();
    }
}

__aicore__ inline void ReaderFlush(__gm__ int32_t* region)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(region);
    DataCacheCleanAndInvalid<int32_t, CacheLine::SINGLE_CACHE_LINE, DcciDst::CACHELINE_OUT>(g);
    DataSyncBarrier<MemDsbT::ALL>();
}

__aicore__ inline void SkewDma(uint32_t aiv, __gm__ int32_t* dummy)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(dummy);
    const uint32_t n = (aiv % 8u) * SKEW_MULT;
    for (uint32_t j = 0; j < n; ++j) {
        DataCopy(LocalTensor<int32_t>(TPosition::VECCALC, UB_SKEW, 8), g[0], 8);
    }
    PipeBarrier<PIPE_MTE2>();
}

__aicore__ inline void WriteTicket(__gm__ int32_t* tab, uint32_t wordOff, uint32_t T, uint32_t rank, uint32_t wl)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(tab);
    LocalTensor<int32_t> stg(TPosition::VECCALC, UB_STG, 16);
    const int32_t tk = Ticket(T, rank);
    for (uint32_t j = 0; j < (wl >> 2); ++j) {
        stg.SetValue(j, tk);
    }
    SetFlag<HardEvent::S_MTE3>(EVENT_ID0);
    WaitFlag<HardEvent::S_MTE3>(EVENT_ID0);
    BufAcq<PIPE_MTE3>(BUF_D);
    DataCopyPad(g[wordOff], stg, DataCopyExtParams{1, wl, 0, 0, 0});
    PipeBarrier<PIPE_MTE3>();
    BufRel<PIPE_MTE3>(BUF_D);
}

__aicore__ inline void ReadRegion(__gm__ int32_t* tab, uint32_t wordOff, uint32_t words)
{
    GlobalTensor<int32_t> g;
    g.SetGlobalBuffer(tab);
    BufAcq<PIPE_MTE2>(BUF_D);
    DataCopyPad(LocalTensor<int32_t>(TPosition::VECCALC, UB_REG, words), g[wordOff],
                DataCopyExtParams{1, words * 4u, 0, 0, 0}, DataCopyPadExtParams<int32_t>{false, 0, 0, 0});
    PipeBarrier<PIPE_MTE2>();
    BufRel<PIPE_MTE2>(BUF_D);
    SetFlag<HardEvent::MTE2_V>(EVENT_ID2);
    WaitFlag<HardEvent::MTE2_V>(EVENT_ID2);
}

// __VEC_SCOPE__ 里数 head 命中 / 已写词命中（当前轮 ticket）；返回 headOK*1000000 + wordOK
__aicore__ inline int64_t CountMatches(uint32_t words, uint32_t st, uint32_t wl, uint32_t naiv, uint32_t T,
                                       uint32_t selfonly, uint32_t rank)
{
    const int16_t sh = static_cast<int16_t>(st == 1 ? 0 : (st == 8 ? 3 : 4));
    const uint32_t wlw = wl >> 2;
    BufAcq<PIPE_V>(BUF_D);
    __VEC_SCOPE__ {
        MaskReg full = CreateMask<int32_t, MaskPattern::ALL>();
        MaskReg mHead, mRank, mW, mEq, mTmp;
        RegTensor<int32_t> idx, v, rankv, pos, ticket, base, ones, accH, accW, cnt, tmp;
        Duplicate(ones, 1);
        Duplicate(base, static_cast<int32_t>(MAGIC16 << 16) + ((T & 0xFFu) << 8));
        Duplicate(accH, 0);
        Duplicate(accW, 0);
        const uint16_t nChunk = static_cast<uint16_t>(words >> 6);
        for (uint16_t c = 0; c < nChunk; ++c) {
            Arange(idx, static_cast<int32_t>(c) * 64);
            ShiftRights(rankv, idx, sh, full);
            ShiftLefts(tmp, rankv, sh, full);
            Sub(pos, idx, tmp, full);
            CompareScalar<int32_t, CMPMODE::EQ>(mHead, pos, 0, full);
            CompareScalar<int32_t, CMPMODE::LT>(mRank, rankv, static_cast<int32_t>(naiv), full);
            CompareScalar<int32_t, CMPMODE::LT>(mW, pos, static_cast<int32_t>(wlw), full);
            MaskAnd(mW, mW, mRank, full);
            Add(ticket, base, rankv, full);
            LoadAlign(v, reinterpret_cast<__ubuf__ int32_t*>(UB_REG + c * 256));
            Compare<int32_t, CMPMODE::EQ>(mEq, v, ticket, full);
            MaskAnd(mTmp, mEq, mHead, full);
            MaskAnd(mTmp, mTmp, mRank, full);
            if (selfonly) {
                CompareScalar<int32_t, CMPMODE::EQ>(mRank, rankv, static_cast<int32_t>(rank), full);
                MaskAnd(mTmp, mTmp, mRank, full);
            }
            ReduceSum<int32_t>(cnt, ones, mTmp);
            Add(accH, accH, cnt, full);
            MaskAnd(mTmp, mEq, mW, full);
            if (selfonly) {
                CompareScalar<int32_t, CMPMODE::EQ>(mRank, rankv, static_cast<int32_t>(rank), full);
                MaskAnd(mTmp, mTmp, mRank, full);
            }
            ReduceSum<int32_t>(cnt, ones, mTmp);
            Add(accW, accW, cnt, full);
        }
        StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_TMP), accH, full);
        StoreAlign(reinterpret_cast<__ubuf__ int32_t*>(UB_TMP + 256), accW, full);
    }
    BufRel<PIPE_V>(BUF_D);
    SetFlag<HardEvent::V_S>(EVENT_ID7);
    WaitFlag<HardEvent::V_S>(EVENT_ID7);
    const int64_t h = LocalTensor<int32_t>(TPosition::VECCALC, UB_TMP, 64).GetValue(0);
    const int64_t w = LocalTensor<int32_t>(TPosition::VECCALC, UB_TMP + 256, 64).GetValue(0);
    return h * 1000000 + w;
}
}  // namespace

__global__ __mix__(1, 2) void probe_aiv_sync_kernel(
    __gm__ uint8_t* tab, __gm__ uint8_t* obs, __gm__ uint8_t* snap, __gm__ uint8_t* dump, __gm__ uint8_t* dummy,
    uint32_t naiv, uint32_t rounds, uint32_t st, uint32_t wl, uint32_t bk, uint32_t ck, uint32_t dk, uint32_t fk,
    uint32_t skew, uint32_t poll, uint32_t rdcci, uint32_t selfonly, uint32_t snapOn, uint32_t setpart,
    uint32_t sepreads, uint32_t traceOn)
{
    using namespace AscendC;
    InitSocState();
    __gm__ int32_t* tabI = reinterpret_cast<__gm__ int32_t*>(tab);
    const uint32_t words = NAIVMAX * st;

    if ASCEND_IS_AIV {
        const uint32_t rank = GetBlockIdx();
        const int64_t tStart = GetSystemCycle();
        LocalTensor<int32_t> obsUB(TPosition::VECCALC, UB_OBS, RNDMAX * OBSW);
        for (uint32_t r = 0; r < RNDMAX * OBSW; ++r) {
            obsUB.SetValue(r, 0);
        }
        if (rank < naiv) {
            for (uint32_t r = 0; r < rounds; ++r) {
                const uint32_t T = r + 1;
                uint16_t fidOpen = 1, fidClose = 2;
                if (fk == FK_PAIR16) {
                    fidOpen = static_cast<uint16_t>(2 * (r % 8));
                    fidClose = static_cast<uint16_t>(2 * (r % 8) + 1);
                } else if (fk == FK_ROT7) {
                    fidOpen = static_cast<uint16_t>(1 + (r % 7));
                    fidClose = static_cast<uint16_t>(8 + (r % 7));
                } else if (fk == FK_SAME1) {
                    fidOpen = 1;
                    fidClose = 1;      // **同一个 id** 既做发布会合又做收尾会合（测"一个 id 够不够"）
                } else {
                    fidOpen = 1;
                    fidClose = 2;
                }
                const uint32_t wordOff = sepreads ? ((r * NAIVMAX + rank) * st) : (rank * st);
                const uint32_t readOff = sepreads ? (r * words) : 0u;
                const uint32_t sl = sepreads ? (r * NAIVMAX * st + rank * st) : (rank * st);

                if (skew) SkewDma(rank, reinterpret_cast<__gm__ int32_t*>(dummy));
                WriteTicket(tabI, wordOff, T, rank, wl);
                const int64_t tWr = GetSystemCycle();
                DrainStep(dk, tabI + sl);
                const int64_t tDr = GetSystemCycle();
                if (setpart == 0 || rank < (naiv / 2)) {
                    BarPair(bk, fidOpen);
                }
                const int64_t tRel = GetSystemCycle();
                if (rdcci) ReaderFlush(tabI + readOff);

                int32_t pollIters = 0;
                if (poll) {
                    for (uint32_t k = 0; k < POLL_BOUND; ++k) {
                        ReadRegion(tabI, readOff, words);
                        const int64_t m = CountMatches(words, st, wl, naiv, T, selfonly, rank);
                        pollIters = static_cast<int32_t>(k) + 1;
                        if ((m / 1000000) >= static_cast<int64_t>(naiv)) {
                            pollIters = -pollIters;
                            break;
                        }
                    }
                }
                ReadRegion(tabI, readOff, words);
                const int64_t m = CountMatches(words, st, wl, naiv, T, selfonly, rank);
                const int64_t tRd = GetSystemCycle();
                if (ck != CK_NONE) {
                    CloseBar(ck, fidClose);          // ⑨ 收尾会合：读完了才允许别人覆写
                }

                __ubuf__ int32_t* row = reinterpret_cast<__ubuf__ int32_t*>(obsUB.GetPhyAddr()) + r * OBSW;
                row[0] = static_cast<int32_t>(T);
                row[1] = static_cast<int32_t>(m / 1000000);
                row[2] = static_cast<int32_t>(m % 1000000);
                row[3] = static_cast<int32_t>(tWr & 0xFFFFFFFF);
                row[4] = static_cast<int32_t>(tDr & 0xFFFFFFFF);
                row[5] = static_cast<int32_t>(tRel & 0xFFFFFFFF);
                row[6] = static_cast<int32_t>(tRd & 0xFFFFFFFF);
                row[7] = pollIters;
                row[8] = static_cast<int32_t>(words);
                row[11] = static_cast<int32_t>(naiv);
                row[15] = 0x5A5A;

                if (snapOn) {
                    SetFlag<HardEvent::V_MTE3>(EVENT_ID3);
                    WaitFlag<HardEvent::V_MTE3>(EVENT_ID3);
                    GlobalTensor<int32_t> sg;
                    sg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(snap));
                    BufAcq<PIPE_MTE3>(BUF_D);
                    DataCopyPad(sg[rank * (RNDMAX * words) + r * words],
                                LocalTensor<int32_t>(TPosition::VECCALC, UB_REG, words),
                                DataCopyExtParams{1, words * 4u, 0, 0, 0});
                    PipeBarrier<PIPE_MTE3>();
                    BufRel<PIPE_MTE3>(BUF_D);
                }
            }
        }
        if (rank < naiv) {
            SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
            WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
            GlobalTensor<int32_t> og;
            og.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(obs));
            BufAcq<PIPE_MTE3>(BUF_D);
            DataCopyPad(og[rank * (RNDMAX * OBSW)], obsUB, DataCopyExtParams{1, (rounds * OBSW) * 4u, 0, 0, 0});
            PipeBarrier<PIPE_MTE3>();
            BufRel<PIPE_MTE3>(BUF_D);
        }
        LocalTensor<int32_t> md(TPosition::VECCALC, UB_STG, 16);
        md.SetValue(0, static_cast<int32_t>(tStart & 0xFFFFFFFF));
        md.SetValue(1, static_cast<int32_t>(GetSystemCycle() & 0xFFFFFFFF));
        md.SetValue(2, static_cast<int32_t>(GetBlockNum()));
        md.SetValue(3, static_cast<int32_t>(naiv));
        SetFlag<HardEvent::S_MTE3>(EVENT_ID1);
        WaitFlag<HardEvent::S_MTE3>(EVENT_ID1);
        GlobalTensor<int32_t> dg;
        dg.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(dump));
        BufAcq<PIPE_MTE3>(BUF_D);
        DataCopyPad(dg[rank * 8], md, DataCopyExtParams{1, 16, 0, 0, 0});
        PipeBarrier<PIPE_MTE3>();
        BufRel<PIPE_MTE3>(BUF_D);
        PipeBarrier<PIPE_ALL>();
    }
    PipeBarrier<PIPE_ALL>();
}

// ============================ host 侧 ============================
static inline int32_t HostTicket(uint32_t T, uint32_t rank)
{
    return static_cast<int32_t>((MAGIC16 << 16) | ((T & 0xFFu) << 8) | (rank & 0xFFu));
}

struct Variant {
    const char* name;
    uint32_t bk, ck, dk, fk;
    uint32_t st, wl, rounds;
    uint32_t skew, poll, rdcci, selfonly, snap, blocks, setpart, sepreads;
    const char* note;
};

// 轴 A：屏障配方（几何 st=16,wl=64）。轴 B：写几何（配方取 A 组候选）。轴 C：核数/参与度。N：负向对照。
static const Variant VARIANTS[] = {
    // ---- 轴 A：屏障配方 ----
    {"A0_none_readonce",   BK_NONE,         CK_NONE,     DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "对照：无屏障，写完即读一次（M53 v0 同形）"},
    {"A1_poll_nobarrier",  BK_NONE,         CK_NONE,     DK_MTE3_S,      FK_PAIR16, 16, 64,  4, 1, 1, 0, 0, 1, 0, 0, 0,
     "M53 v2：不挂 flag 纯轮询（上界 4096）"},
    {"A2_open_only",       BK_M0_ME3_ME2,   CK_NONE,     DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "**M53 v1 / m19-m15-m20 现行**：只有发布屏障（写→set<MTE3>/wait<MTE2>→读）"},
    {"A3_open_close",      BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "候选配方：发布屏障 + 收尾屏障（set<MTE2>/wait<MTE3>）"},
    {"A4_open_only_waits", BK_M0_ME3_S,     CK_NONE,     DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "只有发布屏障，wait 挂 PIPE_S（官方样例写法）"},
    {"A5_close_waits",     BK_M0_ME3_S,     CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "候选配方 2：wait 挂 PIPE_S 的发布屏障 + 收尾屏障"},
    {"A6_open_close_waitV",BK_M0_ME3_V,     CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "错挂 wait=PIPE_V：挡不住后续 MTE2 读（读早于会合）"},
    {"A7_open_close_waitE3",BK_M0_ME3_ME3,  CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "错挂 wait=PIPE_MTE3：同上"},
    {"A8_setV_close",      BK_M0_V_ME2,     CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "错挂 set=PIPE_V：通知早于 MTE3 落盘"},
    {"A9_setE2_close",     BK_M0_ME2_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "错挂 set=PIPE_MTE2：同上"},
    {"A10_nodrain_close",  BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_NONE,        FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "④ 不排空（set 前无任何 drain）"},
    {"A11_pipebar_close",  BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_PIPEBAR,     FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "④ PipeBarrier<MTE3>（M53 探针的排空形态）"},
    {"A12_dcci_close",     BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S_DCCI, FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "写侧 DCCI(clean)+DSB（官方 KFC/HCCL 交接范式）"},
    {"A13_dcci_close_rd",  BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S_DCCI, FK_PAIR16, 16, 64, 16, 1, 0, 1, 0, 1, 0, 0, 0,
     "A12 + 读侧读前 DCCI"},
    {"A14_m1_close",       BK_M1_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "mode1：语义只覆盖同一 AI Core 内 2 个 AIV"},
    {"A15_m2_close",       BK_M2_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "mode2：语义是 AIC↔组内 AIV 点对点（AIV 自 set/wait 属语义外）"},
    {"A16_fid_fixed_close",BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_FIXED1, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "② flagId 复用：16 轮固定同一对 id（1/2）"},
    {"A17_fid_rot7_close", BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_ROT7,   16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "② flagId 池：7 对 id 轮换（1..7/8..14），第 8 轮起复用"},
    {"A18_noskew_close",   BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 0, 0, 0, 0, 1, 0, 0, 0,
     "⑤ 无偏斜（同 A3，去掉到达时间差）"},
    {"A19_poll_hybrid_close",BK_M0_ME3_ME2, CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64,  4, 1, 1, 0, 0, 1, 0, 0, 0,
     "M53 v3：发布屏障后 bounded 轮询到齐 + 收尾"},
    {"A20_sepwins",        BK_M0_ME3_ME2,   CK_NONE,     DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 1,
     "候选配方 3：不要收尾屏障，改**每轮独立窗口**（用内存换会合）"},
    {"A21_28aiv_close",    BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 14, 0, 0,
     "⑦ 核数轴：blockDim=14 ⇒ 28 AIV（同 A3 配方）"},
    {"A22_close_closepipeE2",BK_M0_ME3_ME2, CK_ME2_ME2,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "收尾屏障 wait 错挂 PIPE_MTE2（挡不住下一轮 MTE3 写）"},
    {"A23_close_closesetE3",BK_M0_ME3_ME2,  CK_ME3_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "收尾屏障 set 错挂 PIPE_MTE3（不等我的读做完）"},
    {"A26_fid_same_id",    BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_SAME1,  16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "② 用户猜想实测：**同一个 flagId（1）**既做发布会合又做收尾会合，16 轮反复用"},
    {"A27_fid_same_id_sep",BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_SAME1,  16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 1,
     "A26 + 每轮独立窗口（若 A26 有残余竞态，这里应干净）"},
    {"A24_poll_sepwins",   BK_NONE,         CK_NONE,     DK_MTE3_S,      FK_PAIR16, 16, 64,  4, 1, 1, 0, 0, 1, 0, 0, 1,
     "把 M53 v2 的「纯轮询 0 核收敛」放到**不复用的窗口**里重测（预期收敛）"},
    {"A25_sepwins_dense4", BK_M0_ME3_ME2,   CK_NONE,     DK_MTE3_S,      FK_PAIR16,  1,  4, 16, 1, 0, 0, 0, 1, 0, 0, 1,
     "几何 × 候选配方 3：M53 的 4B 密排形状 + 每轮独立窗口"},
    // ---- 轴 B：写几何（配方 = A3 候选） ----
    {"B0_geom_dense4",     BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16,  1,  4, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "几何：st=1,wl=4 —— 复刻 M53 探针/m19 WriteToken（56 核 4B 挤在 224B）"},
    {"B1_geom_align4",     BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16,  8,  4, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "几何：st=8,wl=4 —— 窄写但每核独占 32B 扇区"},
    {"B2_geom_align32",    BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16,  8, 32, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "几何：st=8,wl=32 —— 每核独占扇区且写满"},
    {"B3_geom_align64",    BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "几何：st=16,wl=64（= A3 基线）"},
    {"B4_dense4_openonly", BK_M0_ME3_ME2,   CK_NONE,     DK_MTE3_S,      FK_PAIR16,  1,  4, 16, 1, 0, 0, 0, 1, 0, 0, 0,
     "几何 × 现行配方：st=1,wl=4 只有发布屏障（M53 条件的逐项复刻）"},
    {"B5_dense4_28aiv",    BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16,  1,  4, 16, 1, 0, 0, 0, 1, 14, 0, 0,
     "几何 × 核数：st=1,wl=4 在 28 AIV 上（M0 bring-up 的 56 核 16float 是另一种几何）"},
    // ---- 轴 C：参与度 ----
    {"C0_halfset",         BK_M0_ME3_ME2,   CK_ME2_ME3,  DK_MTE3_S,      FK_PAIR16, 16, 64,  2, 1, 0, 0, 0, 1, 28, 1, 0,
     "⑦ 是否全体 set：只让前一半核参与会合（预期死锁；run_probe.sh 用 timeout 跑，置于末尾）"},
    // ---- 负向对照 ----
    {"N0_negctrl_selfonly",BK_NONE,         CK_NONE,     DK_MTE3_S,      FK_PAIR16, 16, 64, 16, 1, 0, 0, 1, 1, 0, 0, 0,
     "⑧ 负向对照：无屏障，只校验自己那一格 ⇒ 读数恒 PASS（本探针方法的已知盲区）"},
};
static const uint32_t NVAR = static_cast<uint32_t>(sizeof(VARIANTS) / sizeof(VARIANTS[0]));

int FindVariant(const char* s)
{
    for (uint32_t i = 0; i < NVAR; ++i) {
        if (strcmp(s, VARIANTS[i].name) == 0) return static_cast<int>(i);
    }
    char* end = nullptr;
    const long v = strtol(s, &end, 10);
    if (end != s && v >= 0 && v < static_cast<long>(NVAR)) return static_cast<int>(v);
    return -1;
}

int main(int argc, char** argv)
{
    if (argc < 3) {
        fprintf(stderr, "usage: %s <variantIdx|name> <runNo> [outdir] [--snap] [--trace]\n", argv[0]);
        printf("variants:\n");
        for (uint32_t i = 0; i < NVAR; ++i) {
            printf("  %2u  %-24s  %s\n", i, VARIANTS[i].name, VARIANTS[i].note);
        }
        return 2;
    }
    const int vi = FindVariant(argv[1]);
    if (vi < 0) {
        fprintf(stderr, "unknown variant: %s\n", argv[1]);
        return 2;
    }
    const int runNo = atoi(argv[2]);
    const char* outdir = (argc >= 4 && argv[3][0] != '-') ? argv[3] : ".";
    bool snapFlag = false, traceFlag = false;
    for (int i = 1; i < argc; ++i) {
        if (strcmp(argv[i], "--snap") == 0) snapFlag = true;
        if (strcmp(argv[i], "--trace") == 0) traceFlag = true;
    }
    const Variant& V = VARIANTS[vi];

    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[probe] variant=%s run=%d aclInit FAILED\n", V.name, runNo);
        return 2;
    }
    aclrtSetDevice(0);
    int64_t aicNum = 0, aivNum = 0;
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum);
    const uint32_t blocks = (V.blocks != 0) ? V.blocks : static_cast<uint32_t>(aicNum);
    const uint32_t naiv = 2u * blocks;
    const uint32_t words = NAIVMAX * V.st;
    const uint32_t tabWords = V.sepreads ? (V.rounds * words) : words;
    const size_t tabBytes = static_cast<size_t>(tabWords) * 4u;
    const size_t obsBytes = static_cast<size_t>(NAIVMAX) * RNDMAX * OBSW * 4u;
    const size_t snapBytes = static_cast<size_t>(NAIVMAX) * RNDMAX * words * 4u;
    const size_t dumpBytes = static_cast<size_t>(NAIVMAX) * 8 * 4u;
    const bool wantSnap = snapFlag && V.snap != 0;

    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);
    uint8_t *dTab = nullptr, *dObs = nullptr, *dSnap = nullptr, *dDump = nullptr, *dDummy = nullptr;
    aclrtMalloc(reinterpret_cast<void**>(&dTab), tabBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dObs), obsBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dSnap), wantSnap ? snapBytes : 256, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dDump), dumpBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(reinterpret_cast<void**>(&dDummy), 4096, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMemset(dTab, tabBytes, 0, tabBytes);
    aclrtMemset(dObs, obsBytes, 0x5A, obsBytes);
    aclrtMemset(dDump, dumpBytes, 0x5A, dumpBytes);
    aclrtMemset(dDummy, 4096, 0x11, 4096);
    if (wantSnap) aclrtMemset(dSnap, snapBytes, 0xEE, snapBytes);

    probe_aiv_sync_kernel<<<blocks, 0, stream>>>(
        dTab, dObs, dSnap, dDump, dDummy, naiv, V.rounds, V.st, V.wl, V.bk, V.ck, V.dk, V.fk, V.skew, V.poll, V.rdcci,
        V.selfonly, wantSnap ? 1u : 0u, V.setpart, V.sepreads, traceFlag ? 1u : 0u);
    const aclError err = aclrtSynchronizeStream(stream);
    if (err != ACL_SUCCESS) {
        printf("SUMMARY variant=%s run=%d launch=FAILED err=%d rc=2\n", V.name, runNo, static_cast<int>(err));
        return 2;
    }

    std::vector<int32_t> hTab(tabWords, 0), hObs(obsBytes / 4, 0), hDump(dumpBytes / 4, 0);
    aclrtMemcpy(hTab.data(), tabBytes, dTab, tabBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hObs.data(), obsBytes, dObs, obsBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    aclrtMemcpy(hDump.data(), dumpBytes, dDump, dumpBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::vector<int32_t> hSnap;
    if (wantSnap) {
        hSnap.assign(snapBytes / 4, 0);
        aclrtMemcpy(hSnap.data(), snapBytes, dSnap, snapBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    }
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    // ---- 设备侧读数（每核每轮的 head 命中）----
    const uint32_t seqWords = V.wl >> 2;
    std::vector<int32_t> headOK(NAIVMAX * RNDMAX, -1), wordOK(NAIVMAX * RNDMAX, -1);
    std::vector<int32_t> tWr(NAIVMAX * RNDMAX, 0), tRel(NAIVMAX * RNDMAX, 0), tRd(NAIVMAX * RNDMAX, 0);
    std::vector<int32_t> pollIt(NAIVMAX * RNDMAX, 0);
    int missingRows = 0;
    for (uint32_t c = 0; c < NAIVMAX; ++c) {
        for (uint32_t r = 0; r < V.rounds; ++r) {
            const int32_t* row = &hObs[(c * RNDMAX + r) * OBSW];
            if (row[15] != 0x5A5A || row[0] != static_cast<int32_t>(r + 1)) {
                if (c < naiv) ++missingRows;
                continue;
            }
            headOK[c * RNDMAX + r] = row[1];
            wordOK[c * RNDMAX + r] = row[2];
            tWr[c * RNDMAX + r] = row[3];
            tRel[c * RNDMAX + r] = row[5];
            tRd[c * RNDMAX + r] = row[6];
            pollIt[c * RNDMAX + r] = row[7];
        }
    }

    // ---- host 侧独立判据：region 最终态（写丢失 vs 读不到 的分界）----
    // sepreads 时看最后一轮的窗口
    const uint32_t lastWin = V.sepreads ? ((V.rounds - 1) * words) : 0u;
    uint32_t finalHeadOK = 0, finalHeadStale = 0, finalHeadZero = 0, finalHeadOther = 0;
    for (uint32_t c = 0; c < naiv; ++c) {
        const int32_t v = hTab[lastWin + c * V.st];
        if (v == HostTicket(V.rounds, c)) ++finalHeadOK;
        else if (v == 0) ++finalHeadZero;
        else if ((((v >> 16) & 0xFFFF) == static_cast<int32_t>(MAGIC16)) && ((v & 0xFF) == static_cast<int32_t>(c)))
            ++finalHeadStale;
        else ++finalHeadOther;
    }
    uint32_t scribble = 0;
    for (uint32_t c = naiv; c < NAIVMAX; ++c) {
        for (uint32_t j = 0; j < V.st; ++j) {
            if (hTab[lastWin + c * V.st + j] != 0) ++scribble;
        }
    }

    // ---- 汇总 ----
    int nViolCoreRound = 0, nCoreClean = 0, nHeadMin = 1 << 20, nRoundsClean = 0, nViolSelf = 0;
    std::vector<int32_t> coreViol(NAIVMAX, 0);
    int64_t relSpreadMax = 0;
    for (uint32_t r = 0; r < V.rounds; ++r) {
        bool roundClean = true;
        int32_t rmin = 1 << 20;
        int64_t rminT = (1LL << 40), rmaxT = -(1LL << 40);
        for (uint32_t c = 0; c < naiv; ++c) {
            const int32_t h = headOK[c * RNDMAX + r];
            if (h < 0) { roundClean = false; continue; }
            if (h < rmin) rmin = h;
            if (h != static_cast<int32_t>(naiv)) { ++nViolCoreRound; ++coreViol[c]; roundClean = false; }
            if (h < 1) ++nViolSelf;   // ="我只校验自己那格"这种自证判据下的违规数（负向对照用）
            const int64_t t = static_cast<int64_t>(static_cast<uint32_t>(tRel[c * RNDMAX + r]));
            if (t < rminT) rminT = t;
            if (t > rmaxT) rmaxT = t;
        }
        if (roundClean) ++nRoundsClean;
        if (rmin < nHeadMin) nHeadMin = rmin;
        const int64_t spread = rmaxT - rminT;
        if (spread > relSpreadMax) relSpreadMax = spread;
    }
    for (uint32_t c = 0; c < naiv; ++c) {
        if (coreViol[c] == 0) ++nCoreClean;
    }
    // 负向对照（selfonly）：判据刻意换成"只校验自己那格"——这正是要被证明"会被漏掉"的那条判据
    const bool allClean = (missingRows == 0) && (V.selfonly ? (nViolSelf == 0) : (nViolCoreRound == 0));
    const int rc = allClean ? 0 : 1;

    printf("SUMMARY variant=%s run=%d vi=%d bk=%u ck=%u dk=%u fk=%u st=%u wl=%u sep=%u rounds=%u naiv=%u blocks=%u "
           "cores_clean=%d/%u core_round_clean=%d/%u rounds_clean=%d/%u headOK_min=%d viol=%d "
           "final_head_ok=%u stale=%u zero=%u other=%u scribble=%u rel_spread_max=%lld missing_rows=%d "
           "snap=%d rc=%d negctrl_selfonly=%u viol_under_selfonly_criterion=%d\n",
           V.name, runNo, vi, V.bk, V.ck, V.dk, V.fk, V.st, V.wl, V.sepreads, V.rounds, naiv, blocks, nCoreClean,
           naiv, static_cast<int>(naiv * V.rounds) - nViolCoreRound, naiv * V.rounds, nRoundsClean, V.rounds,
           (nHeadMin > 1 << 19) ? -1 : nHeadMin, nViolCoreRound, finalHeadOK, finalHeadStale, finalHeadZero,
           finalHeadOther, scribble, static_cast<long long>(relSpreadMax), missingRows, wantSnap ? 1 : 0, rc,
           V.selfonly, nViolSelf);
    for (uint32_t r = 0; r < V.rounds; ++r) {
        int32_t rmin = 1 << 20, rmax = -1, ncl = 0, npoll = 0;
        for (uint32_t c = 0; c < naiv; ++c) {
            const int32_t h = headOK[c * RNDMAX + r];
            if (h < 0) continue;
            if (h < rmin) rmin = h;
            if (h > rmax) rmax = h;
            if (h == static_cast<int32_t>(naiv)) ++ncl;
            if (pollIt[c * RNDMAX + r] < 0) ++npoll;
        }
        printf("ROUND variant=%s run=%d round=%u headOK_min=%d headOK_max=%d cores_clean=%d/%u converged=%d\n",
               V.name, runNo, r, rmin, rmax, ncl, naiv, npoll);
    }
    printf("COREVIOL variant=%s run=%d ", V.name, runNo);
    for (uint32_t c = 0; c < naiv; ++c) printf("%d%s", coreViol[c], (c + 1 == naiv) ? "\n" : ",");
    printf("CYCLE variant=%s run=%d ", V.name, runNo);
    for (uint32_t c = 0; c < naiv; ++c) printf("%d%s", hDump[c * 8], (c + 1 == naiv) ? "\n" : ",");
    if (traceFlag) {
        for (uint32_t c = 0; c < naiv; ++c) {
            for (uint32_t r = 0; r < V.rounds; ++r) {
                printf("TRACE variant=%s run=%d core=%u round=%u T=%u headOK=%d wordOK=%d tWr=%d tRel=%d tRd=%d "
                       "poll=%d\n",
                       V.name, runNo, c, r, r + 1, headOK[c * RNDMAX + r], wordOK[c * RNDMAX + r],
                       tWr[c * RNDMAX + r], tRel[c * RNDMAX + r], tRd[c * RNDMAX + r], pollIt[c * RNDMAX + r]);
            }
        }
    }

    if (wantSnap) {
        char path[1024];
        snprintf(path, sizeof(path), "%s/snap_%s_run%d.bin", outdir, V.name, runNo);
        FILE* fb = fopen(path, "wb");
        if (fb != nullptr) {
            const int32_t hdr[8] = {static_cast<int32_t>(NAIVMAX), static_cast<int32_t>(RNDMAX),
                                    static_cast<int32_t>(naiv), static_cast<int32_t>(V.rounds),
                                    static_cast<int32_t>(V.st), static_cast<int32_t>(V.wl),
                                    static_cast<int32_t>(words), 0x5A5A5A5A};
            fwrite(hdr, sizeof(int32_t), 8, fb);
            fwrite(hSnap.data(), 4, hSnap.size(), fb);
            fclose(fb);
        }
    }
    (void)seqWords;
    return rc;
}
