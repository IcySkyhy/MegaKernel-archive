/**
 * m29_ple_unit.asc —— **M161：PLE 单元级链路**（新目录，不接 m15_layer_loop，不做生产路径）
 *
 * 语义权威 = `m15_layer_loop/ple/PLE_SPEC.md` 与 `m15_layer_loop/m15_ple.asc`（本文件是它的
 * **单元化改写 + 两项缺口补做**）。本文件自带入口 kernel 与 host main（形态照 m15_ple.asc）。
 *
 * ============================================================
 * 本单元相对 m15_ple.asc 的**增量**（mission 任务 2/3/4）
 * ============================================================
 *  · **G3 多槽滑窗 + 跨分片 64 位取模**（任务 3）：② gather 不再只认「一个连续窗口 +
 *    `row = id - winBase`」（那要求窗口落在单分片内）。本单元把表建模为**槽表**：
 *    设备对每个 id 先做 `shard = id / 2,500,012`、`local = id % 2,500,012`（**设备端 64 位除法/取模**，
 *    `UDivMod64` 移位-减法），再在槽表里找覆盖 `(shard, local)` 的槽，`row = 槽内行基 + (local - 槽内行基)`。
 *    这样：① 同一个窗口装得下**多个分片**的行（多槽）；② 能查**横跨分片边界**或落在别的分片的 id。
 *    槽表由 host 一次注册的匿名 staging 窗口承载（`aclrtHostRegisterV2(MAPPED)`，同 M92/M86）。
 *  · **G2 跨 step short-conv 状态**（任务 4）：host 跑 **≥2 个 step**，把 step k 的 `state_out`
 *    搬成 step k+1 的 `state_in`（同一块 GM 平面），参考逐 step 对拍。
 *  · **G6 段内同步合规**（任务 2）：核内跨 pipe 交接**一律 BufferID 阻塞释放**（照
 *    `m15_hc_layer.h::CombineStage` 的正对照），同 pipe 背靠背用 `PipeBarrier<PIPE_*>`，
 *    **段内不使用 PIPE_ALL 档屏障**（跨 pipe 一律 BufferID 阻塞释放）；核间用 `CrossCoreSetFlag/WaitFlag`；**不使用
 *    `SetFlag/WaitFlag` 系列**（人类逐字约束）。UB 按**段分域**（gather / gate / conv 各占
 *    不相交的地址区），所以跨段不需要任何 UB 复用屏障。
 *
 * ============================================================
 * 架构约束（人类逐字）与本文件的实际状态
 * ============================================================
 *  · 「矩阵乘法 ⇒ 必须 cube 做」：③ kv 投影 `kv = emb @ wcatᵀ`（M=n_tok、K=2560、N=12800）
 *    走 AIC `Mmad`（lift 自 m15_ple.asc:576-708 / m15_gdn_layer.h:Bf16Gemm）。
 *  · 「其余的都用 VF 做，不要用 scalar 做计算，scalar 只做控制流」：④ 门控 + 分组归一、⑤ 膨胀卷积 +
 *    SiLU + 残差 + 状态移位全部 `__VEC_SCOPE__` VF；① 的 id 算术与 ② 的 shard/local 换算是
 *    **gather 索引/地址**（`docs/21` §3.2 的 I 类），scalar 只做它们与循环控制。
 *  · 「不要使用 set flag/wait flag 系列的同步，核内 pipeline 需要使用 buffer id，核间使用 set cross
 *    core 系列」：见上。
 *
 * ============================================================
 * 用法
 * ============================================================
 *   source /usr/local/Ascend/ascend-toolkit/set_env.sh
 *   cmake -B m29_ple_unit/build -S m29_ple_unit -DCMAKE_BUILD_TYPE=Release
 *   cmake --build m29_ple_unit/build -j4
 *   python3 m29_ple_unit/gen_unit_data.py --mode synth   # 合成缩减表档（档 A）
 *   python3 m29_ple_unit/gen_unit_data.py --mode real    # 真实表多槽档（档 B）
 *   M29_OUT=<outdir> M29_DATA=<datadir> ./m29_ple_unit/build/m29_ple_unit
 *   （step 数由数据目录 `unit_meta.txt` 的 `n_steps` 决定；无 M29_STEPS 这个 env）
 *   python3 m29_ple_unit/check_ref.py <outdir> <datadir> [--neg-table|--neg-state]
 *
 * ============================================================
 * 边界（写窄）
 * ============================================================
 *  · 本文件是**单元级**验证：只跑 PLE 段体自身，不接 `m15_layer_loop/**`、不是生产路径、
 *    不算 prefill/T>1 完成。详见 README.md。
 *  · 表窗口是 host 注册的一块匿名内存；本单元只演示「多槽 + 跨分片取数」，**不做**驻留/LRU 策略
 *    （那属于 REAL_TABLE.md §9 U-A 的 host 侧管理，本单元用 host 事先把测试 id 需要的行摆好）。
 */

#include "acl/acl.h"
#include "kernel_operator.h"
#include "c_api/asc_simd.h"
#include "reg_compute/kernel_reg_compute_intf.h"

#include <chrono>
#include <cmath>
#include <cstdint>
#include <cstdio>
#include <cstdlib>
#include <cstring>
#include <string>
#include <vector>

// M92：file mmap（按需页）+ 匿名 staging 窗口 + 一次性 ACL 注册
#include <fcntl.h>
#include <sys/mman.h>
#include <sys/stat.h>
#include <unistd.h>

#include "m29_ple_support.h"

namespace M29P {

using namespace AscendC;
using namespace AscendC::Reg;
using namespace M29S;
using M29S::AlignUp;
using M29S::BarrierAic;
using M29S::BarrierAiv;
using M29S::Block1;
using M29S::BufAcquire;
using M29S::BufRelease;
using M29S::CC_MODE0;
using M29S::CC_MODE2;
using M29S::ExtBlock1;
using M29S::MutexLock;
using M29S::MutexUnlock;

// ============================================================
// §FLAG：本 kernel 自己的 cross-core flag id（独立启动，无并发）
//   AIV：12 ②→③（mode2 set MTE3）／13 ③→④（mode2 wait MTE2）／14 ④→⑤（mode0 全体 AIV）
//   AIC：12/13 与配对 AIV 的 mode2；14/15 全体 AIC 的 mode0（③ 入口/出口）
//   （编号沿用 m15_ple.asc:62-76 的结论；AIC 上 set 不得挂 PIPE_S/PIPE_MTE3 —— docs/05 §6.2）
// ============================================================
constexpr uint16_t FLAG_B2 = 12;
constexpr uint16_t FLAG_B3 = 13;
constexpr uint16_t FLAG_B4 = 14;
constexpr uint16_t FLAG_CUBE_IN = 14;
constexpr uint16_t FLAG_CUBE_OUT = 15;

// ============================================================
// §BUF：核内 BufferID（MutexID 0..27；本单元独立启动 ⇒ 整段自用）
//   **段分域**：UB 按 gather / gate / conv 三段各自不相交（见 §UB），故每段的 BufferID 只在本段内配对。
//   gather：15 行入（MTE2）／16 行出（MTE3）／17 计数（S→MTE3）
//   gate  ：0..5 六个 MTE2 入 / 6,7 两个 V→MTE3 出
//   conv  ：8..12 五个 MTE2 入 / 13,14 两个 V→MTE3 出
//   ids 落盘：20（S→MTE3）
// ============================================================
constexpr MutexID BUF_G_ROW = static_cast<MutexID>(15);
constexpr MutexID BUF_G_CNT = static_cast<MutexID>(17);
constexpr MutexID BUF_K_IN0 = static_cast<MutexID>(0);
constexpr MutexID BUF_K_IN1 = static_cast<MutexID>(1);
constexpr MutexID BUF_K_IN2 = static_cast<MutexID>(2);
constexpr MutexID BUF_K_IN3 = static_cast<MutexID>(3);
constexpr MutexID BUF_K_IN4 = static_cast<MutexID>(4);
constexpr MutexID BUF_K_IN5 = static_cast<MutexID>(5);
constexpr MutexID BUF_K_GOUT = static_cast<MutexID>(6);
constexpr MutexID BUF_K_NOUT = static_cast<MutexID>(7);
constexpr MutexID BUF_C_ST = static_cast<MutexID>(8);
constexpr MutexID BUF_C_IN0 = static_cast<MutexID>(9);
constexpr MutexID BUF_C_IN1 = static_cast<MutexID>(10);
constexpr MutexID BUF_C_IN2 = static_cast<MutexID>(11);
constexpr MutexID BUF_C_W = static_cast<MutexID>(12);
constexpr MutexID BUF_C_OUT = static_cast<MutexID>(13);
constexpr MutexID BUF_C_NST = static_cast<MutexID>(14);
constexpr MutexID BUF_PLE_IDS = static_cast<MutexID>(20);

// ============================================================
// §UB 布局（字节偏移）：**段分域**，三段不相交
//   gather [512, 1024)   gate [4096, 55328)   conv [57344, 60800)   sink/ids [62000, 62240)
// ============================================================
constexpr uint32_t UB_ROW = 512;        // bf16[HDIM=160]  ② 行暂存
// gate：10 个 HID bf16 缓冲 + 8 fp32 归约
constexpr uint32_t UB_KB = 4096;
constexpr uint32_t UB_QB = 9216;
constexpr uint32_t UB_NKB = 14336;
constexpr uint32_t UB_NQB = 19456;
constexpr uint32_t UB_NCB = 24576;
constexpr uint32_t UB_KNB = 29696;
constexpr uint32_t UB_QNB = 34816;
constexpr uint32_t UB_VB = 39936;
constexpr uint32_t UB_GB = 45056;
constexpr uint32_t UB_NRB = 50176;
constexpr uint32_t UB_RS2 = 55296;      // fp32[8]
// conv
constexpr uint32_t UB_CW = 57344;       // bf16[4*VL]
constexpr uint32_t UB_CST = 57856;      // bf16[9*VL]
constexpr uint32_t UB_CIN = 59136;      // bf16[VL]（normed 卷积输入）
constexpr uint32_t UB_CG = 59264;       // bf16[VL]（gated）
constexpr uint32_t UB_CXIN = 59392;     // bf16[VL]（hid 输入）
constexpr uint32_t UB_CX = 59520;       // bf16[VL]（out 落点）
constexpr uint32_t UB_NST = 59648;      // bf16[9*VL]（新状态落点）
// 落盘暂存
constexpr uint32_t UB_IDS = 62016;      // int64[NG]=128B（32B 对齐）
constexpr uint32_t UB_SINK = 62144;     // uint32[8]=32B
constexpr uint32_t UB_END = 62176;

// ============================================================
// §1 ① n-gram id（int64 位运算 + floor-mod + 偏移）—— lift 自 m15_ple.asc:277-408
// ============================================================
__aicore__ inline uint64_t UMod64(uint64_t x, uint64_t d)
{
    uint64_t r = 0;
    for (int32_t i = 63; i >= 0; --i) {
        r = (r << 1) | ((x >> static_cast<uint32_t>(i)) & 1ULL);
        if (r >= d) {
            r -= d;
        }
    }
    return r;
}

// 设备端 64 位除+模（移位-减法，一次循环出商与余；回避设备端 int64 除法指令）
__aicore__ inline void UDivMod64(uint64_t x, uint64_t d, uint64_t& q, uint64_t& r)
{
    q = 0;
    r = 0;
    for (int32_t i = 63; i >= 0; --i) {
        r = (r << 1) | ((x >> static_cast<uint32_t>(i)) & 1ULL);
        if (r >= d) {
            r -= d;
            q |= (1ULL << static_cast<uint32_t>(i));
        }
    }
}

__aicore__ inline uint64_t FloorMod64(int64_t x, int64_t d)
{
    const uint64_t ux = static_cast<uint64_t>(x);
    const uint64_t mag = (x < 0) ? (~ux + 1ULL) : ux;
    uint64_t r = UMod64(mag, static_cast<uint64_t>(d));
    if ((x < 0) && (r != 0ULL)) {
        r = static_cast<uint64_t>(d) - r;
    }
    return r;
}

__aicore__ inline uint32_t ReqOf(int32_t t, GlobalTensor<int32_t>& qsl, uint32_t nReq)
{
    uint32_t r = 0;
    for (uint32_t i = 0; i + 1 <= nReq; ++i) {
        if (qsl.GetValue(i) <= t) {
            r = i;
        }
    }
    return r;
}

__aicore__ inline uint32_t IdsOneToken(uint32_t t, GlobalTensor<int32_t>& idsG, GlobalTensor<int32_t>& qslG,
                                       GlobalTensor<int32_t>& ctxG, GlobalTensor<int64_t>& mG,
                                       GlobalTensor<int64_t>& szG, GlobalTensor<int64_t>& ofG,
                                       GlobalTensor<int64_t>& outG, uint32_t nReq, uint32_t negMask,
                                       uint32_t* rangeFail)
{
    LocalTensor<int64_t> idsL(TPosition::VECCALC, UB_IDS, NG);
    BufAcquire<PIPE_S>(BUF_PLE_IDS);
    const uint32_t r = ReqOf(static_cast<int32_t>(t), qslG, nReq);
    const int32_t c = static_cast<int32_t>(t) - qslG.GetValue(r);
    const int64_t cur = static_cast<int64_t>(idsG.GetValue(t));
    const int32_t col1 = static_cast<int32_t>(NC) - 1 + c;
    const int32_t col2 = static_cast<int32_t>(NC) - 2 + c;
    const int32_t col1m = ((negMask & 2u) != 0u) ? static_cast<int32_t>(NC) - 1 : col1;
    const int32_t col2m = ((negMask & 2u) != 0u) ? static_cast<int32_t>(NC) - 2 : col2;
    const int64_t p1 = (c >= 1) ? static_cast<int64_t>(idsG.GetValue(t - 1))
                                : static_cast<int64_t>(ctxG.GetValue(r * NC + col1m));
    const int64_t p2raw = (c >= 2) ? static_cast<int64_t>(idsG.GetValue(t - 2))
                                   : static_cast<int64_t>(ctxG.GetValue(r * NC + col2m));
    const bool crossed1 = (p1 == static_cast<int64_t>(EOS));
    const int64_t p2 = crossed1 ? static_cast<int64_t>(EOS) : p2raw;
    const int64_t m0 = mG.GetValue(0);
    const int64_t m1 = mG.GetValue(1);
    const int64_t m2 = mG.GetValue(2);
    const int64_t base = cur * m0;
    const int64_t t1v = p1 * m1;
    const int64_t t2v = p2 * m2;
    uint32_t bad = 0;
    for (uint32_t g = 0; g < NG; ++g) {
        const uint32_t order = g / P + 2;
        int64_t mixed = base;
        if (order > 1) {
            mixed ^= t1v;
        }
        if (order > 2) {
            mixed ^= t2v;
        }
        const int64_t size = szG.GetValue(g);
        const uint64_t r0 = FloorMod64(mixed, size);
        const int64_t off = ofG.GetValue(g);
        int64_t id;
        if ((negMask & 1024u) != 0u) {
            id = mixed;
        } else {
            const uint64_t rr = ((negMask & 1u) != 0u)
                                    ? ((static_cast<uint64_t>(size) - r0) % static_cast<uint64_t>(size))
                                    : r0;
            id = static_cast<int64_t>(rr) + off;
        }
        idsL.SetValue(g, id);
        if ((id < 0) || (id >= VOCAB_ROWS)) {
            bad++;
        }
    }
    *rangeFail += bad;
    BufRelease<PIPE_S>(BUF_PLE_IDS);
    BufAcquire<PIPE_MTE3>(BUF_PLE_IDS);
    AscendC::DataCopy(outG[static_cast<uint64_t>(t) * NG], idsL, Block1(NG * 8));
    BufRelease<PIPE_MTE3>(BUF_PLE_IDS);
    return bad;
}

// ============================================================
// §2 ② 行 gather：**多槽滑窗 + 跨分片 64 位取模**（本单元的增量）
// ============================================================
struct BodyGm {
    GlobalTensor<int64_t> ids;
    GlobalTensor<bfloat16_t> table;    // 平坦表（mode=flat）或注册窗口（mode=multi-slot）
    GlobalTensor<int32_t> slotShard;   // [NSLOTS] 槽所在分片号（-1 = 空槽）
    GlobalTensor<int32_t> slotLocal0;  // [NSLOTS] 槽在分片内的起始局部行
    GlobalTensor<int32_t> slotRows;    // [NSLOTS] 槽行数
    GlobalTensor<int32_t> slotWin;     // [NSLOTS] 槽在窗口内的起始行（= s*slotRows）
    GlobalTensor<bfloat16_t> wcat;     // [12800,2560] = [key ; value]
    GlobalTensor<bfloat16_t> wtap;     // [4,10240] conv 权重（tap-major）
    GlobalTensor<bfloat16_t> nk;
    GlobalTensor<bfloat16_t> nq;
    GlobalTensor<bfloat16_t> ncw;
    GlobalTensor<bfloat16_t> hid;
    GlobalTensor<bfloat16_t> stIn;
    GlobalTensor<bfloat16_t> stOut;
    GlobalTensor<int32_t> sidx;
    GlobalTensor<bfloat16_t> emb;
    GlobalTensor<bfloat16_t> kv;
    GlobalTensor<bfloat16_t> gated;
    GlobalTensor<bfloat16_t> normed;
    GlobalTensor<bfloat16_t> out;
    GlobalTensor<uint32_t> fail;
    uint32_t nSlots = 0;               // 0 = flat 模式
    uint32_t negMask = 0;              // kernel 变异掩码（bit14=0x4000 用于多槽路径负向对照）
};

// 设备侧：在槽表里找覆盖 (shard, local) 的槽，返回窗口行号；找不到返回 false。
__aicore__ inline bool SlotRowOf(BodyGm& G, int64_t id, uint64_t& row)
{
    uint64_t shard = 0;
    uint64_t local = 0;
    UDivMod64(static_cast<uint64_t>(id), static_cast<uint64_t>(ROWS_PER_SHARD), shard, local);
    for (uint32_t s = 0; s < G.nSlots; ++s) {
        const int32_t sh = G.slotShard.GetValue(s);
        if (sh < 0 || static_cast<uint64_t>(sh) != shard) {
            continue;
        }
        const uint32_t l0 = static_cast<uint32_t>(G.slotLocal0.GetValue(s));
        const uint32_t ln = static_cast<uint32_t>(G.slotRows.GetValue(s));
        if (local >= l0 && local < static_cast<uint64_t>(l0) + ln) {
            uint64_t off = local - l0;
            // 变异 bit14（=0x4000）：**多槽路径**的负向对照 —— 槽内行偏移错（+1 环绕）
            //   ⇒ 设备取到「同一槽里的邻行」，行内容错但覆盖不变 ⇒ B2.emb/B3.kv 必红、B2.miss 不变。
            if ((G.negMask & 16384u) != 0u) {
                off = (off + 1u >= ln) ? 0u : (off + 1u);
            }
            row = static_cast<uint64_t>(G.slotWin.GetValue(s)) + off;
            return true;
        }
    }
    return false;
}

__aicore__ inline void PleGather(uint32_t bid, uint32_t nblk, BodyGm& G, uint32_t nTok)
{
    LocalTensor<bfloat16_t> rowL(TPosition::VECCALC, UB_ROW, HDIM);
    LocalTensor<uint32_t> sinkL(TPosition::VECCALC, UB_SINK, 8);
    const uint64_t n = static_cast<uint64_t>(nTok) * NG;
    uint32_t miss = 0;
    uint32_t oob = 0;
    for (uint64_t idx = bid; idx < n; idx += nblk) {
        const uint32_t t = static_cast<uint32_t>(idx / NG);
        const uint32_t g = static_cast<uint32_t>(idx - static_cast<uint64_t>(t) * NG);
        int64_t id = G.ids.GetValue(idx);
        if ((id < 0) || (id >= VOCAB_ROWS)) {
            oob++;
            continue;
        }
        uint64_t row = 0;
        if (G.nSlots != 0u) {
            if (!SlotRowOf(G, id, row)) {
                miss++;               // 该 id 的 (shard, local) 不被任何槽覆盖 ⇒ 越窗
                continue;
            }
        } else {
            row = static_cast<uint64_t>(id);   // flat 缩减表：行号 = id
        }
        // MTE2 取行 → MTE3 落 emb（跨 pipe：BufferID 阻塞释放交接，不用 PIPE_ALL 档屏障）
        BufAcquire<PIPE_MTE2>(BUF_G_ROW);
        AscendC::DataCopy(rowL, G.table[row * HDIM], Block1(HDIM * 2));
        BufRelease<PIPE_MTE2>(BUF_G_ROW);
        BufAcquire<PIPE_MTE3>(BUF_G_ROW);
        AscendC::DataCopy(G.emb[static_cast<uint64_t>(t) * HE + static_cast<uint64_t>(g) * HDIM], rowL,
                          Block1(HDIM * 2));
        BufRelease<PIPE_MTE3>(BUF_G_ROW);
    }
    (void)miss;
    // 设备侧计数（越窗 miss / 词表外 oob）经 UB → MTE3 DataCopyPad 落 G.fail[bid]；
    //   0 也写（「0」是真核过的读数，不是没写）。写侧成对（docs/05 §6.1 ⓔ）。
    BufAcquire<PIPE_S>(BUF_G_CNT);
    sinkL.SetValue(0, oob);
    sinkL.SetValue(1, miss);
    BufRelease<PIPE_S>(BUF_G_CNT);
    BufAcquire<PIPE_MTE3>(BUF_G_CNT);
    AscendC::DataCopyPad(G.fail[static_cast<uint64_t>(bid) * 2u], sinkL, ExtBlock1(8));
    BufRelease<PIPE_MTE3>(BUF_G_CNT);
}

// ============================================================
// §3 ③ kv 投影：cube bf16 mmad（lift 自 m15_ple.asc:576-708）
// ============================================================
__aicore__ inline void PleCubeGemv(uint32_t aBid, uint32_t nAic, BodyGm& G, uint32_t nTok)
{
    if (nTok == 0u) {
        return;
    }
    const uint32_t curM = (nTok < BASE_M) ? nTok : BASE_M;
    const uint32_t calcM = (curM < 2u) ? 2u : curM;
    const uint32_t calcMAlign = AlignUp(calcM, CUBE_BLOCK);

    AscendC::LocalTensor<bfloat16_t> a1Ping(AscendC::TPosition::A1, L1_OFF_A0, L1_A_ELEMS);
    AscendC::LocalTensor<bfloat16_t> a1Pong(AscendC::TPosition::A1, L1_OFF_A1, L1_A_ELEMS);
    AscendC::LocalTensor<bfloat16_t> b1Ping(AscendC::TPosition::B1, L1_OFF_B0, L1_B_ELEMS);
    AscendC::LocalTensor<bfloat16_t> b1Pong(AscendC::TPosition::B1, L1_OFF_B1, L1_B_ELEMS);
    AscendC::LocalTensor<bfloat16_t> a2Ping(AscendC::TPosition::A2, L0_OFF_0, BASE_M * BASE_K);
    AscendC::LocalTensor<bfloat16_t> a2Pong(AscendC::TPosition::A2, L0_OFF_1, BASE_M * BASE_K);
    AscendC::LocalTensor<bfloat16_t> b2Ping(AscendC::TPosition::B2, L0_OFF_0, BASE_K * BASE_N);
    AscendC::LocalTensor<bfloat16_t> b2Pong(AscendC::TPosition::B2, L0_OFF_1, BASE_K * BASE_N);
    AscendC::LocalTensor<float> cL0C(AscendC::TPosition::CO1, 0, BASE_M * BASE_N);

    for (uint32_t nt = aBid; nt < NTILES; nt += nAic) {
        MutexLock<PIPE_M>(BUF_AIC_L0C);
        for (uint32_t kb = 0; kb < KLOOP; ++kb) {
            const uint32_t p = kb & 1u;
            const AscendC::MutexID bufA = p ? BUF_AIC_A1 : BUF_AIC_A0;
            const AscendC::MutexID bufB = p ? BUF_AIC_B1 : BUF_AIC_B0;
            const AscendC::MutexID bufL0 = p ? BUF_AIC_L01 : BUF_AIC_L00;
            AscendC::LocalTensor<bfloat16_t> a1 = p ? a1Pong : a1Ping;
            AscendC::LocalTensor<bfloat16_t> b1 = p ? b1Pong : b1Ping;
            AscendC::LocalTensor<bfloat16_t> a2 = p ? a2Pong : a2Ping;
            AscendC::LocalTensor<bfloat16_t> b2 = p ? b2Pong : b2Ping;
            MutexLock<PIPE_MTE2>(bufA);
            {
                AscendC::Nd2NzParams par = {};
                par.ndNum = 1;
                par.nValue = calcM;
                par.dValue = BASE_K;
                par.srcNdMatrixStride = 0;
                par.srcDValue = HE;
                par.dstNzC0Stride = BASE_M;
                par.dstNzNStride = 1;
                par.dstNzMatrixStride = 0;
                AscendC::DataCopy(a1, G.emb[kb * BASE_K], par);
            }
            MutexUnlock<PIPE_MTE2>(bufA);
            MutexLock<PIPE_MTE2>(bufB);
            {
                AscendC::Nd2NzParams par = {};
                par.ndNum = 1;
                par.nValue = BASE_N;
                par.dValue = BASE_K;
                par.srcNdMatrixStride = 0;
                par.srcDValue = HE;
                par.dstNzC0Stride = BASE_N;
                par.dstNzNStride = 1;
                par.dstNzMatrixStride = 0;
                AscendC::DataCopy(b1, G.wcat[nt * BASE_N * HE + kb * BASE_K], par);
            }
            MutexUnlock<PIPE_MTE2>(bufB);
            MutexLock<PIPE_MTE1>(bufL0);
            MutexLock<PIPE_MTE1>(bufA);
            MutexLock<PIPE_MTE1>(bufB);
            {
                AscendC::LoadData2DParamsV2 lp = {};
                lp.mStartPosition = 0;
                lp.kStartPosition = 0;
                lp.mStep = calcMAlign / CUBE_BLOCK;
                lp.kStep = BASE_K / CUBE_BLOCK;
                lp.srcStride = BASE_M / CUBE_BLOCK;
                lp.dstStride = calcMAlign / CUBE_BLOCK;
                lp.sid = 0;
                lp.ifTranspose = false;
                AscendC::LoadData(a2, a1[0], lp);
            }
            {
                AscendC::LoadData2DParamsV2 lp = {};
                lp.mStartPosition = 0;
                lp.kStartPosition = 0;
                lp.mStep = BASE_N / CUBE_BLOCK;
                lp.kStep = BASE_K / CUBE_BLOCK;
                lp.srcStride = BASE_N / CUBE_BLOCK;
                lp.dstStride = BASE_N / CUBE_BLOCK;
                lp.sid = 0;
                lp.ifTranspose = false;
                AscendC::LoadData(b2, b1[0], lp);
            }
            MutexUnlock<PIPE_MTE1>(bufA);
            MutexUnlock<PIPE_MTE1>(bufB);
            MutexUnlock<PIPE_MTE1>(bufL0);
            MutexLock<PIPE_M>(bufL0);
            AscendC::MmadParams mp = {};
            mp.m = calcM;
            mp.n = BASE_N;
            mp.k = BASE_K;
            mp.cmatrixInitVal = (kb == 0);
            AscendC::Mmad(cL0C, a2, b2, mp);
            MutexUnlock<PIPE_M>(bufL0);
        }
        MutexUnlock<PIPE_M>(BUF_AIC_L0C);
        MutexLock<PIPE_FIX>(BUF_AIC_L0C);
        {
            AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp = {};
            fp.nSize = BASE_N;
            fp.mSize = curM;
            fp.srcStride = calcMAlign;
            fp.dstStride = KVW;
            fp.quantPre = QuantMode_t::F322BF16;
            fp.reluScalar = 0;
            fp.vectorRelu = 0;
            fp.deqScalar = 0;
            AscendC::Fixpipe(G.kv[static_cast<uint64_t>(nt) * BASE_N], cL0C, fp);
        }
        MutexUnlock<PIPE_FIX>(BUF_AIC_L0C);
    }
}

// AIV/AIC 两臂：跨核型交接（AIVs→AIC mode2 → 全体 AIC mode0 → AIC→AIVs mode2）
__aicore__ inline void PleGemv(uint32_t nTok, BodyGm& G)
{
    if ASCEND_IS_AIV {
        AscendC::CrossCoreSetFlag<CC_MODE2, PIPE_MTE3>(FLAG_B2);
        AscendC::CrossCoreWaitFlag<CC_MODE2, PIPE_MTE2>(FLAG_B3);
        return;
    }
    if ASCEND_IS_AIC {
        const uint32_t aBid = AscendC::GetBlockIdx();
        const uint32_t nAic = AscendC::GetBlockNum();
        AscendC::CrossCoreWaitFlag<CC_MODE2, PIPE_S>(FLAG_B2);
        BarrierAic<PIPE_S, PIPE_MTE2, FLAG_CUBE_IN>();
        PleCubeGemv(aBid, nAic, G, nTok);
        BarrierAic<PIPE_S, PIPE_FIX, FLAG_CUBE_OUT>();
        AscendC::CrossCoreSetFlag<CC_MODE2, PIPE_MTE2>(FLAG_B3);
    }
}

// ============================================================
// §4 ④ 门控 + 分组归一（逐 (token,stream)）—— lift 自 m15_ple.asc:766-994
//   同步：6 个 MTE2 入缓冲 + 2 个 V→MTE3 出缓冲各配 BufferID；V 内部 pass 之间用
//   `PipeBarrier<PIPE_V>`（同 pipe 背靠背，docs/05 §6.2 第 1 条）。**无 PIPE_ALL 档屏障**。
// ============================================================
__aicore__ inline void PleGateItem(uint32_t t, uint32_t s, BodyGm& G, uint32_t negMask)
{
    LocalTensor<bfloat16_t> kL(TPosition::VECCALC, UB_KB, HID);
    LocalTensor<bfloat16_t> qL(TPosition::VECCALC, UB_QB, HID);
    LocalTensor<bfloat16_t> nkL(TPosition::VECCALC, UB_NKB, HID);
    LocalTensor<bfloat16_t> nqL(TPosition::VECCALC, UB_NQB, HID);
    LocalTensor<bfloat16_t> ncL(TPosition::VECCALC, UB_NCB, HID);
    LocalTensor<bfloat16_t> knL(TPosition::VECCALC, UB_KNB, HID);
    LocalTensor<bfloat16_t> qnL(TPosition::VECCALC, UB_QNB, HID);
    LocalTensor<bfloat16_t> vL(TPosition::VECCALC, UB_VB, HID);
    LocalTensor<bfloat16_t> gL(TPosition::VECCALC, UB_GB, HID);
    LocalTensor<bfloat16_t> nrL(TPosition::VECCALC, UB_NRB, HID);
    LocalTensor<float> rsL(TPosition::VECCALC, UB_RS2, 8);
    __ubuf__ bfloat16_t* kUb = reinterpret_cast<__ubuf__ bfloat16_t*>(kL.GetPhyAddr());
    __ubuf__ bfloat16_t* qUb = reinterpret_cast<__ubuf__ bfloat16_t*>(qL.GetPhyAddr());
    __ubuf__ bfloat16_t* nkUb = reinterpret_cast<__ubuf__ bfloat16_t*>(nkL.GetPhyAddr());
    __ubuf__ bfloat16_t* nqUb = reinterpret_cast<__ubuf__ bfloat16_t*>(nqL.GetPhyAddr());
    __ubuf__ bfloat16_t* ncUb = reinterpret_cast<__ubuf__ bfloat16_t*>(ncL.GetPhyAddr());
    __ubuf__ bfloat16_t* knUb = reinterpret_cast<__ubuf__ bfloat16_t*>(knL.GetPhyAddr());
    __ubuf__ bfloat16_t* qnUb = reinterpret_cast<__ubuf__ bfloat16_t*>(qnL.GetPhyAddr());
    __ubuf__ bfloat16_t* vUb = reinterpret_cast<__ubuf__ bfloat16_t*>(vL.GetPhyAddr());
    __ubuf__ bfloat16_t* gUb = reinterpret_cast<__ubuf__ bfloat16_t*>(gL.GetPhyAddr());
    __ubuf__ bfloat16_t* nrUb = reinterpret_cast<__ubuf__ bfloat16_t*>(nrL.GetPhyAddr());
    __ubuf__ float* rsUb = reinterpret_cast<__ubuf__ float*>(rsL.GetPhyAddr());

    const uint64_t kvBase = static_cast<uint64_t>(t) * KVW + static_cast<uint64_t>(s) * HID;
    const uint64_t hBase = static_cast<uint64_t>(t) * HYPER + static_cast<uint64_t>(s) * HID;
    PipeBarrier<PIPE_MTE2>();   // 同 pipe 复用同一批 UB 输入缓冲
    BufAcquire<PIPE_MTE2>(BUF_K_IN0);
    AscendC::DataCopy(kL, G.kv[kvBase], Block1(HID * 2));
    BufRelease<PIPE_MTE2>(BUF_K_IN0);
    BufAcquire<PIPE_MTE2>(BUF_K_IN1);
    AscendC::DataCopy(qL, G.hid[hBase], Block1(HID * 2));
    BufRelease<PIPE_MTE2>(BUF_K_IN1);
    BufAcquire<PIPE_MTE2>(BUF_K_IN2);
    AscendC::DataCopy(vL, G.kv[static_cast<uint64_t>(t) * KVW + HYPER], Block1(HID * 2));   // value 4 流共享
    BufRelease<PIPE_MTE2>(BUF_K_IN2);
    BufAcquire<PIPE_MTE2>(BUF_K_IN3);
    AscendC::DataCopy(nkL, G.nk[s * HID], Block1(HID * 2));
    BufRelease<PIPE_MTE2>(BUF_K_IN3);
    BufAcquire<PIPE_MTE2>(BUF_K_IN4);
    AscendC::DataCopy(nqL, G.nq[s * HID], Block1(HID * 2));
    BufRelease<PIPE_MTE2>(BUF_K_IN4);
    BufAcquire<PIPE_MTE2>(BUF_K_IN5);
    AscendC::DataCopy(ncL, G.ncw[s * HID], Block1(HID * 2));
    BufRelease<PIPE_MTE2>(BUF_K_IN5);

    BufAcquire<PIPE_V>(BUF_K_IN0);
    BufAcquire<PIPE_V>(BUF_K_IN1);
    BufAcquire<PIPE_V>(BUF_K_IN2);
    BufAcquire<PIPE_V>(BUF_K_IN3);
    BufAcquire<PIPE_V>(BUF_K_IN4);
    BufAcquire<PIPE_V>(BUF_K_IN5);
    BufAcquire<PIPE_V>(BUF_K_GOUT);
    BufAcquire<PIPE_V>(BUF_K_NOUT);

    // pass A：k / q 的平方和
    __VEC_SCOPE__
    {
        RegTensor<float> a1, a2, xr, t1;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
        RegTensor<float> r1, r2;
        Duplicate(a1, 0.0f, maskAll);
        Duplicate(a2, 0.0f, maskAll);
        for (uint16_t c = 0; c < NCH_H; ++c) {
            NormDonor::LoadRegForDtype<bfloat16_t>(kUb, xr, maskAll, c * VL);
            Mul(t1, xr, xr, maskAll);
            Add(a1, a1, t1, maskAll);
            NormDonor::LoadRegForDtype<bfloat16_t>(qUb, xr, maskAll, c * VL);
            Mul(t1, xr, xr, maskAll);
            Add(a2, a2, t1, maskAll);
        }
        Reduce<ReduceType::SUM>(r1, a1, maskAll);
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 0, r1, maskOne);
        Reduce<ReduceType::SUM>(r2, a2, maskAll);
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 1, r2, maskOne);
    }
    PipeBarrier<PIPE_V>();
    // pass A2：rstd = NR rsqrt(mean + eps)
    __VEC_SCOPE__
    {
        RegTensor<float> v, rstd;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
        LoadAlign<float, LoadDist::DIST_BRC_B32>(v, rsUb + 0);
        Muls(v, v, 1.0f / static_cast<float>(HID), maskAll);
        NormDonor::ComputeRstdNewtonRaphsonReg(v, rstd, maskAll, EPS);
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 2, rstd, maskOne);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(v, rsUb + 1);
        Muls(v, v, 1.0f / static_cast<float>(HID), maskAll);
        NormDonor::ComputeRstdNewtonRaphsonReg(v, rstd, maskAll, EPS);
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 3, rstd, maskOne);
    }
    PipeBarrier<PIPE_V>();
    // pass B：k_n / q_n = bf16(x·rstd·(1+w))
    __VEC_SCOPE__
    {
        RegTensor<float> rk, rq, xr, wr, pr;
        RegTensor<bfloat16_t> yb;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        LoadAlign<float, LoadDist::DIST_BRC_B32>(rk, rsUb + 2);
        LoadAlign<float, LoadDist::DIST_BRC_B32>(rq, rsUb + 3);
        for (uint16_t c = 0; c < NCH_H; ++c) {
            NormDonor::LoadRegForDtype<bfloat16_t>(kUb, xr, maskAll, c * VL);
            NormDonor::LoadRegForDtype<bfloat16_t>(nkUb, wr, maskAll, c * VL);
            Mul(pr, xr, rk, maskAll);
            Mul(xr, pr, wr, maskAll);
            Add(pr, pr, xr, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, pr, maskAll);
            StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(knUb + c * VL, yb, maskAll);
            NormDonor::LoadRegForDtype<bfloat16_t>(qUb, xr, maskAll, c * VL);
            NormDonor::LoadRegForDtype<bfloat16_t>(nqUb, wr, maskAll, c * VL);
            Mul(pr, xr, rq, maskAll);
            Mul(xr, pr, wr, maskAll);
            Add(pr, pr, xr, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, pr, maskAll);
            StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(qnUb + c * VL, yb, maskAll);
        }
    }
    PipeBarrier<PIPE_V>();
    // pass C：dot = fp32( bf16( Σ bf16(k_n·q_n) ) )
    __VEC_SCOPE__
    {
        RegTensor<float> acc, a, b, p, red;
        RegTensor<bfloat16_t> pb;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
        Duplicate(acc, 0.0f, maskAll);
        for (uint16_t c = 0; c < NCH_H; ++c) {
            NormDonor::LoadRegForDtype<bfloat16_t>(knUb, a, maskAll, c * VL);
            NormDonor::LoadRegForDtype<bfloat16_t>(qnUb, b, maskAll, c * VL);
            Mul(p, a, b, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(pb, p, maskAll);
            Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(p, pb, maskAll);
            Add(acc, acc, p, maskAll);
        }
        Reduce<ReduceType::SUM>(red, acc, maskAll);
        if ((negMask & 4u) == 0u) {   // bit2：跳过 dot 和的 bf16 物化（= D4 缺陷）
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(pb, red, maskAll);
            Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(red, pb, maskAll);
        }
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 4, red, maskOne);
    }
    PipeBarrier<PIPE_V>();
    // pass D：门控标量 g = bf16(sigmoid(sign(d)·bf16(sqrt(max(|d|,1e-6)))))
    __VEC_SCOPE__
    {
        RegTensor<float> d, ab, ng, one, neg1, mag, sgn;
        RegTensor<bfloat16_t> db;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
        MaskReg mNeg, mPos;
        LoadAlign<float, LoadDist::DIST_BRC_B32>(d, rsUb + 4);
        Muls(d, d, 1.0f / 50.59644256269407f, maskAll);   // 1/sqrt(2560)
        Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(db, d, maskAll);
        Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(d, db, maskAll);
        Compares<float, CMPMODE::LT>(mNeg, d, 0.0f, maskAll);
        Compares<float, CMPMODE::GT>(mPos, d, 0.0f, maskAll);
        Muls(ng, d, -1.0f, maskAll);
        Select(ab, ng, d, mNeg);
        Maxs(ab, ab, 1e-6f, maskAll);
        Sqrt(mag, ab, maskAll);
        Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(db, mag, maskAll);
        Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(mag, db, maskAll);
        Duplicate(sgn, 0.0f, maskAll);
        Duplicate(neg1, -1.0f, maskAll);
        Duplicate(one, 1.0f, maskAll);
        Select(sgn, neg1, sgn, mNeg);
        Select(sgn, one, sgn, mPos);
        Mul(d, sgn, mag, maskAll);
        Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(db, d, maskAll);
        Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(d, db, maskAll);
        NormDonor::SigmoidReg(d, d, one, maskAll);
        Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(db, d, maskAll);
        Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(d, db, maskAll);
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 6, d, maskOne);
    }
    PipeBarrier<PIPE_V>();
    // pass E：gated = bf16(g·v)
    __VEC_SCOPE__
    {
        RegTensor<float> gg, vr, p;
        RegTensor<bfloat16_t> pb;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        LoadAlign<float, LoadDist::DIST_BRC_B32>(gg, rsUb + 6);
        for (uint16_t c = 0; c < NCH_H; ++c) {
            NormDonor::LoadRegForDtype<bfloat16_t>(vUb, vr, maskAll, c * VL);
            Mul(p, gg, vr, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(pb, p, maskAll);
            StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(gUb + c * VL, pb, maskAll);
        }
    }
    PipeBarrier<PIPE_V>();
    // pass F：gated 的平方和 → rstd → normed = bf16(gated·rstd·(1+ncw))
    __VEC_SCOPE__
    {
        RegTensor<float> acc, xr, t1, red;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
        Duplicate(acc, 0.0f, maskAll);
        for (uint16_t c = 0; c < NCH_H; ++c) {
            NormDonor::LoadRegForDtype<bfloat16_t>(gUb, xr, maskAll, c * VL);
            Mul(t1, xr, xr, maskAll);
            Add(acc, acc, t1, maskAll);
        }
        Reduce<ReduceType::SUM>(red, acc, maskAll);
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 7, red, maskOne);
    }
    PipeBarrier<PIPE_V>();
    __VEC_SCOPE__
    {
        RegTensor<float> v, rstd;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        MaskReg maskOne = CreateMask<float, MaskPattern::VL1>();
        LoadAlign<float, LoadDist::DIST_BRC_B32>(v, rsUb + 7);
        Muls(v, v, 1.0f / static_cast<float>(HID), maskAll);
        NormDonor::ComputeRstdNewtonRaphsonReg(v, rstd, maskAll, EPS);
        StoreAlign<float, StoreDist::DIST_FIRST_ELEMENT_B32>(rsUb + 5, rstd, maskOne);
    }
    PipeBarrier<PIPE_V>();
    __VEC_SCOPE__
    {
        RegTensor<float> rstd, xr, wr, pr;
        RegTensor<bfloat16_t> yb;
        MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
        LoadAlign<float, LoadDist::DIST_BRC_B32>(rstd, rsUb + 5);
        for (uint16_t c = 0; c < NCH_H; ++c) {
            NormDonor::LoadRegForDtype<bfloat16_t>(gUb, xr, maskAll, c * VL);
            NormDonor::LoadRegForDtype<bfloat16_t>(ncUb, wr, maskAll, c * VL);
            Mul(pr, xr, rstd, maskAll);
            Mul(xr, pr, wr, maskAll);
            Add(pr, pr, xr, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, pr, maskAll);
            StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(nrUb + c * VL, yb, maskAll);
        }
    }
    BufRelease<PIPE_V>(BUF_K_IN0);
    BufRelease<PIPE_V>(BUF_K_IN1);
    BufRelease<PIPE_V>(BUF_K_IN2);
    BufRelease<PIPE_V>(BUF_K_IN3);
    BufRelease<PIPE_V>(BUF_K_IN4);
    BufRelease<PIPE_V>(BUF_K_IN5);
    BufRelease<PIPE_V>(BUF_K_GOUT);
    BufRelease<PIPE_V>(BUF_K_NOUT);

    BufAcquire<PIPE_MTE3>(BUF_K_GOUT);
    AscendC::DataCopy(G.gated[hBase], gL, Block1(HID * 2));
    BufRelease<PIPE_MTE3>(BUF_K_GOUT);
    BufAcquire<PIPE_MTE3>(BUF_K_NOUT);
    AscendC::DataCopy(G.normed[hBase], nrL, Block1(HID * 2));
    BufRelease<PIPE_MTE3>(BUF_K_NOUT);
}

// ============================================================
// §5 ⑤ 膨胀深度卷积 + SiLU + 残差 + 状态移位 —— lift 自 m15_ple.asc:997-1156
//   分段：MTE2 入 5 缓冲 / V 产出 2 缓冲。状态移位用 VF（bf16→bf16 精确）⇒ 纯 V pipe。
// ============================================================
__aicore__ inline void PleConvItem(uint32_t t, BodyGm& G, uint32_t negMask)
{
    LocalTensor<bfloat16_t> wL(TPosition::VECCALC, UB_CW, KCONV * VL);
    LocalTensor<bfloat16_t> stL(TPosition::VECCALC, UB_CST, STLEN * VL);
    LocalTensor<bfloat16_t> cinL(TPosition::VECCALC, UB_CIN, VL);
    LocalTensor<bfloat16_t> gdL(TPosition::VECCALC, UB_CG, VL);
    LocalTensor<bfloat16_t> xinL(TPosition::VECCALC, UB_CXIN, VL);
    LocalTensor<bfloat16_t> xL(TPosition::VECCALC, UB_CX, VL);
    LocalTensor<bfloat16_t> nbL(TPosition::VECCALC, UB_NST, STLEN * VL);
    __ubuf__ bfloat16_t* wUb = reinterpret_cast<__ubuf__ bfloat16_t*>(wL.GetPhyAddr());
    __ubuf__ bfloat16_t* stUb = reinterpret_cast<__ubuf__ bfloat16_t*>(stL.GetPhyAddr());
    __ubuf__ bfloat16_t* cinUb = reinterpret_cast<__ubuf__ bfloat16_t*>(cinL.GetPhyAddr());
    __ubuf__ bfloat16_t* gdUb = reinterpret_cast<__ubuf__ bfloat16_t*>(gdL.GetPhyAddr());
    __ubuf__ bfloat16_t* xinUb = reinterpret_cast<__ubuf__ bfloat16_t*>(xinL.GetPhyAddr());
    __ubuf__ bfloat16_t* xUb = reinterpret_cast<__ubuf__ bfloat16_t*>(xL.GetPhyAddr());
    __ubuf__ bfloat16_t* nbUb = reinterpret_cast<__ubuf__ bfloat16_t*>(nbL.GetPhyAddr());

    const int32_t slot = G.sidx.GetValue(t);
    const bool nullSlot = (slot < 0);
    const uint32_t bid = AscendC::GetBlockIdx();
    const uint32_t nblk = AscendC::GetBlockNum() * 2u;
    if (nullSlot) {
        for (uint32_t c0 = bid * VL; c0 < HYPER; c0 += nblk * VL) {
            PipeBarrier<PIPE_MTE2>();
            BufAcquire<PIPE_MTE2>(BUF_C_IN1);
            AscendC::DataCopy(gdL, G.gated[static_cast<uint64_t>(t) * HYPER + c0], Block1(VL * 2));
            BufRelease<PIPE_MTE2>(BUF_C_IN1);
            BufAcquire<PIPE_MTE2>(BUF_C_IN2);
            AscendC::DataCopy(xinL, G.hid[static_cast<uint64_t>(t) * HYPER + c0], Block1(VL * 2));
            BufRelease<PIPE_MTE2>(BUF_C_IN2);
            BufAcquire<PIPE_V>(BUF_C_IN1);
            BufAcquire<PIPE_V>(BUF_C_IN2);
            BufAcquire<PIPE_V>(BUF_C_OUT);
            __VEC_SCOPE__
            {
                RegTensor<float> gr, hr, pr;
                RegTensor<bfloat16_t> yb;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                NormDonor::LoadRegForDtype<bfloat16_t>(gdUb, gr, maskAll, 0);
                NormDonor::LoadRegForDtype<bfloat16_t>(xinUb, hr, maskAll, 0);
                Add(pr, hr, gr, maskAll);
                Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, pr, maskAll);
                StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(xUb, yb, maskAll);
            }
            BufRelease<PIPE_V>(BUF_C_IN1);
            BufRelease<PIPE_V>(BUF_C_IN2);
            BufRelease<PIPE_V>(BUF_C_OUT);
            BufAcquire<PIPE_MTE3>(BUF_C_OUT);
            AscendC::DataCopy(G.out[static_cast<uint64_t>(t) * HYPER + c0], xL, Block1(VL * 2));
            BufRelease<PIPE_MTE3>(BUF_C_OUT);
        }
        return;
    }
    for (uint32_t c0 = bid * VL; c0 < HYPER; c0 += nblk * VL) {
        const uint64_t stBase = static_cast<uint64_t>(slot) * STLEN * HYPER;
        PipeBarrier<PIPE_MTE2>();
        BufAcquire<PIPE_MTE2>(BUF_C_ST);
        for (uint32_t h = 0; h < STLEN; ++h) {
            AscendC::DataCopy(LocalTensor<bfloat16_t>(TPosition::VECCALC, UB_CST + h * VL * 2, VL),
                              G.stIn[stBase + static_cast<uint64_t>(h) * HYPER + c0], Block1(VL * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_C_ST);
        BufAcquire<PIPE_MTE2>(BUF_C_IN0);
        AscendC::DataCopy(cinL, G.normed[static_cast<uint64_t>(t) * HYPER + c0], Block1(VL * 2));
        BufRelease<PIPE_MTE2>(BUF_C_IN0);
        BufAcquire<PIPE_MTE2>(BUF_C_IN1);
        AscendC::DataCopy(gdL, G.gated[static_cast<uint64_t>(t) * HYPER + c0], Block1(VL * 2));
        BufRelease<PIPE_MTE2>(BUF_C_IN1);
        BufAcquire<PIPE_MTE2>(BUF_C_IN2);
        AscendC::DataCopy(xinL, G.hid[static_cast<uint64_t>(t) * HYPER + c0], Block1(VL * 2));
        BufRelease<PIPE_MTE2>(BUF_C_IN2);
        BufAcquire<PIPE_MTE2>(BUF_C_W);
        for (uint32_t k = 0; k < KCONV; ++k) {
            AscendC::DataCopy(LocalTensor<bfloat16_t>(TPosition::VECCALC, UB_CW + k * VL * 2, VL),
                              G.wtap[static_cast<uint64_t>(k) * HYPER + c0], Block1(VL * 2));
        }
        BufRelease<PIPE_MTE2>(BUF_C_W);

        BufAcquire<PIPE_V>(BUF_C_ST);
        BufAcquire<PIPE_V>(BUF_C_IN0);
        BufAcquire<PIPE_V>(BUF_C_IN1);
        BufAcquire<PIPE_V>(BUF_C_IN2);
        BufAcquire<PIPE_V>(BUF_C_W);
        BufAcquire<PIPE_V>(BUF_C_OUT);
        BufAcquire<PIPE_V>(BUF_C_NST);
        __VEC_SCOPE__
        {
            RegTensor<float> acc, wr, sr, pr;
            RegTensor<bfloat16_t> yb;
            MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
            for (uint16_t k = 0; k < KCONV; ++k) {
                NormDonor::LoadRegForDtype<bfloat16_t>(wUb, wr, maskAll, k * VL);
                if (k < KCONV - 1) {
                    NormDonor::LoadRegForDtype<bfloat16_t>(stUb, sr, maskAll, k * 3 * VL);
                } else {
                    NormDonor::LoadRegForDtype<bfloat16_t>(cinUb, sr, maskAll, 0);
                }
                Mul(pr, wr, sr, maskAll);
                if (k == 0) {
                    Duplicate(acc, 0.0f, maskAll);
                }
                Add(acc, acc, pr, maskAll);
            }
            RegTensor<float> one, cvt;
            Duplicate(one, 1.0f, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, acc, maskAll);
            Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(cvt, yb, maskAll);
            NormDonor::SigmoidReg(pr, cvt, one, maskAll);
            Mul(cvt, cvt, pr, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, cvt, maskAll);   // conv_output = bf16(y)
            RegTensor<float> gr, cr, hr, qr;
            NormDonor::LoadRegForDtype<bfloat16_t>(gdUb, gr, maskAll, 0);
            Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(cr, yb, maskAll);
            NormDonor::LoadRegForDtype<bfloat16_t>(xinUb, hr, maskAll, 0);
            Add(pr, gr, cr, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, pr, maskAll);
            Cast<float, bfloat16_t, NormDonor::castTraitB162B32>(qr, yb, maskAll);
            Add(pr, hr, qr, maskAll);
            Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, pr, maskAll);
            StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(xUb, yb, maskAll);
        }
        PipeBarrier<PIPE_V>();
        // 状态移位（VF）：new[i] = old[i+1] (i<8)；new[8] = 当前卷积输入
        // 变异 bit8：方向反转；变异 bit12：活跃行不写回
        if ((negMask & 4096u) == 0u) {
            __VEC_SCOPE__
            {
                RegTensor<float> xr;
                RegTensor<bfloat16_t> yb;
                MaskReg maskAll = CreateMask<float, MaskPattern::ALL>();
                if ((negMask & 256u) != 0u) {
                    NormDonor::LoadRegForDtype<bfloat16_t>(cinUb, xr, maskAll, 0);
                    Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, xr, maskAll);
                    StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(nbUb, yb, maskAll);
                    for (uint16_t i = 1; i < STLEN; ++i) {
                        NormDonor::LoadRegForDtype<bfloat16_t>(stUb, xr, maskAll, (i - 1) * VL);
                        Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, xr, maskAll);
                        StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(nbUb + i * VL, yb, maskAll);
                    }
                } else {
                    for (uint16_t i = 0; i < STLEN - 1; ++i) {
                        NormDonor::LoadRegForDtype<bfloat16_t>(stUb, xr, maskAll, (i + 1) * VL);
                        Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, xr, maskAll);
                        StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(nbUb + i * VL, yb, maskAll);
                    }
                    NormDonor::LoadRegForDtype<bfloat16_t>(cinUb, xr, maskAll, 0);
                    Cast<bfloat16_t, float, NormDonor::castTraitB322B16>(yb, xr, maskAll);
                    StoreAlign<bfloat16_t, StoreDist::DIST_PACK_B32>(nbUb + (STLEN - 1) * VL, yb, maskAll);
                }
            }
        }
        BufRelease<PIPE_V>(BUF_C_ST);
        BufRelease<PIPE_V>(BUF_C_IN0);
        BufRelease<PIPE_V>(BUF_C_IN1);
        BufRelease<PIPE_V>(BUF_C_IN2);
        BufRelease<PIPE_V>(BUF_C_W);
        BufRelease<PIPE_V>(BUF_C_OUT);
        BufRelease<PIPE_V>(BUF_C_NST);
        BufAcquire<PIPE_MTE3>(BUF_C_OUT);
        AscendC::DataCopy(G.out[static_cast<uint64_t>(t) * HYPER + c0], xL, Block1(VL * 2));
        BufRelease<PIPE_MTE3>(BUF_C_OUT);
        if ((negMask & 4096u) == 0u) {
            BufAcquire<PIPE_MTE3>(BUF_C_NST);
            for (uint32_t h = 0; h < STLEN; ++h) {
                AscendC::DataCopy(G.stOut[stBase + static_cast<uint64_t>(h) * HYPER + c0],
                                  LocalTensor<bfloat16_t>(TPosition::VECCALC, UB_NST + h * VL * 2, VL),
                                  Block1(VL * 2));
            }
            BufRelease<PIPE_MTE3>(BUF_C_NST);
        }
    }
}

// ============================================================
// 入口 kernel
// ============================================================
__global__ __mix__(1, 2) void m29_ple_ids_kernel(
    __gm__ uint8_t* idsIn, __gm__ uint8_t* qslIn, __gm__ uint8_t* ctxIn,
    __gm__ uint8_t* mIn, __gm__ uint8_t* szIn, __gm__ uint8_t* ofIn,
    __gm__ uint8_t* idsOut, __gm__ uint8_t* failOut,
    uint32_t nTok, uint32_t nReq, uint32_t negMask)
{
    AscendC::InitSocState();
    if ASCEND_IS_AIV {
        using namespace M29P;
        AscendC::GlobalTensor<int32_t> idsG, qslG, ctxG;
        AscendC::GlobalTensor<int64_t> mG, szG, ofG, outG;
        AscendC::GlobalTensor<uint32_t> failG;
        idsG.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(idsIn), nTok);
        qslG.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(qslIn), nReq + 1);
        ctxG.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(ctxIn), nReq * NC);
        mG.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(mIn), 3);
        szG.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(szIn), NG);
        ofG.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(ofIn), NG);
        outG.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(idsOut), static_cast<uint64_t>(nTok) * NG);
        failG.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(failOut), FAIL_SLOTS);
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t nblk = AscendC::GetBlockNum() * 2u;
        uint32_t bad = 0;
        for (uint32_t t = bid; t < nTok; t += nblk) {
            IdsOneToken(t, idsG, qslG, ctxG, mG, szG, ofG, outG, nReq, negMask, &bad);
        }
        if (bad > 0u) {
            LocalTensor<uint32_t> failL(TPosition::VECCALC, UB_SINK, 8);
            BufAcquire<PIPE_S>(BUF_PLE_IDS);
            failL.SetValue(0, bad);
            BufRelease<PIPE_S>(BUF_PLE_IDS);
            BufAcquire<PIPE_MTE3>(BUF_PLE_IDS);
            AscendC::DataCopyPad(failG[static_cast<uint64_t>(bid)], failL, ExtBlock1(4));
            BufRelease<PIPE_MTE3>(BUF_PLE_IDS);
        }
    }
}

__global__ __mix__(1, 2) void m29_ple_body_kernel(
    __gm__ uint8_t* idsIn, __gm__ uint8_t* tableIn, uint32_t tableRows,
    __gm__ uint8_t* slotShardIn, __gm__ uint8_t* slotLocal0In, __gm__ uint8_t* slotRowsIn,
    __gm__ uint8_t* slotWinIn, uint32_t nSlots,
    __gm__ uint8_t* wcatIn, __gm__ uint8_t* wtapIn, __gm__ uint8_t* nkIn, __gm__ uint8_t* nqIn,
    __gm__ uint8_t* ncwIn, __gm__ uint8_t* hidIn, __gm__ uint8_t* stIn, __gm__ uint8_t* stOut,
    __gm__ uint8_t* sidxIn, __gm__ uint8_t* embOut, __gm__ uint8_t* kvOut, __gm__ uint8_t* gatedOut,
    __gm__ uint8_t* normedOut, __gm__ uint8_t* outOut, __gm__ uint8_t* failOut,
    uint32_t nTok, uint32_t stageMask, uint32_t negMask)
{
    AscendC::InitSocState();
    const uint32_t stateSlots = 64u;
    if ASCEND_IS_AIV {
        using namespace M29P;
        BodyGm G;
        G.ids.SetGlobalBuffer(reinterpret_cast<__gm__ int64_t*>(idsIn), static_cast<uint64_t>(nTok) * NG);
        G.table.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(tableIn),
                                static_cast<uint64_t>(tableRows) * HDIM);
        G.slotShard.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(slotShardIn), nSlots);
        G.slotLocal0.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(slotLocal0In), nSlots);
        G.slotRows.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(slotRowsIn), nSlots);
        G.slotWin.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(slotWinIn), nSlots);
        G.nSlots = nSlots;
        G.negMask = negMask;
        G.wcat.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(wcatIn), static_cast<uint64_t>(KVW) * HE);
        G.wtap.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(wtapIn), static_cast<uint64_t>(KCONV) * HYPER);
        G.nk.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(nkIn), HYPER);
        G.nq.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(nqIn), HYPER);
        G.ncw.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(ncwIn), HYPER);
        G.hid.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(hidIn), static_cast<uint64_t>(nTok) * HYPER);
        G.stIn.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(stIn),
                               static_cast<uint64_t>(stateSlots) * STLEN * HYPER);
        G.stOut.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(stOut),
                                static_cast<uint64_t>(stateSlots) * STLEN * HYPER);
        G.sidx.SetGlobalBuffer(reinterpret_cast<__gm__ int32_t*>(sidxIn), nTok);
        G.emb.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(embOut), static_cast<uint64_t>(nTok) * HE);
        G.kv.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(kvOut), static_cast<uint64_t>(nTok) * KVW);
        G.gated.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(gatedOut), static_cast<uint64_t>(nTok) * HYPER);
        G.normed.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(normedOut),
                                 static_cast<uint64_t>(nTok) * HYPER);
        G.out.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(outOut), static_cast<uint64_t>(nTok) * HYPER);
        G.fail.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(failOut), FAIL_SLOTS * 2u);
        const uint32_t bid = AscendC::GetBlockIdx();
        const uint32_t nblk = AscendC::GetBlockNum() * 2u;
        if ((stageMask & 1u) != 0u) {
            PleGather(bid, nblk, G, nTok);
        }
        if ((stageMask & 2u) != 0u) {
            PleGemv(nTok, G);   // AIV 臂：只做核间握手
        }
        if ((stageMask & 4u) != 0u) {
            const uint32_t nItems = nTok * HC;
            for (uint32_t i = bid; i < nItems; i += nblk) {
                PleGateItem(i / HC, i % HC, G, negMask);
            }
            BarrierAiv<PIPE_MTE2, FLAG_B4>();
        }
        if ((stageMask & 8u) != 0u) {
            for (uint32_t t = 0; t < nTok; ++t) {
                PleConvItem(t, G, negMask);
            }
        }
    }
    if ASCEND_IS_AIC {
        using namespace M29P;
        if ((stageMask & 2u) != 0u) {
            BodyGm G;
            G.emb.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(embOut), static_cast<uint64_t>(nTok) * HE);
            G.wcat.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(wcatIn), static_cast<uint64_t>(KVW) * HE);
            G.kv.SetGlobalBuffer(reinterpret_cast<__gm__ bfloat16_t*>(kvOut), static_cast<uint64_t>(nTok) * KVW);
            PleGemv(nTok, G);   // AIC 臂：cube mmad
        }
    }
}

// ============================================================
// host：main()（单元 harness：≥2 step + 状态搬运 + 表 staging）
// ============================================================
namespace {

struct Ctx {
    aclrtStream stream = nullptr;
    uint32_t aic = 0;
    uint32_t aiv = 0;
    std::string outDir;
    std::string dataDir;
    uint32_t mut = 0;      // kernel 变异掩码
    uint32_t neg = 0;      // 0=正跑；1=表基址错；2=不搬状态
    uint32_t fails = 0;
};

bool LoadFile(const std::string& path, std::vector<uint8_t>& out)
{
    FILE* f = fopen(path.c_str(), "rb");
    if (f == nullptr) {
        printf("[m29][FAIL] cannot open %s\n", path.c_str());
        return false;
    }
    fseek(f, 0, SEEK_END);
    const long n = ftell(f);
    fseek(f, 0, SEEK_SET);
    out.resize(static_cast<size_t>(n));
    if (n > 0 && fread(out.data(), 1, static_cast<size_t>(n), f) != static_cast<size_t>(n)) {
        fclose(f);
        printf("[m29][FAIL] short read %s\n", path.c_str());
        return false;
    }
    fclose(f);
    return true;
}

bool WriteFile(const std::string& dir, const std::string& name, const void* d, size_t n)
{
    const std::string p = dir + "/" + name;
    FILE* f = fopen(p.c_str(), "wb");
    if (f == nullptr) {
        printf("[m29][FAIL] cannot write %s\n", p.c_str());
        return false;
    }
    if (n > 0 && fwrite(d, 1, n, f) != n) {
        fclose(f);
        printf("[m29][FAIL] short write %s\n", p.c_str());
        return false;
    }
    fclose(f);
    return true;
}

struct DevBuf {
    void* dev = nullptr;
    size_t bytes = 0;
    bool Alloc(size_t n)
    {
        bytes = n;
        return aclrtMalloc(&dev, n, ACL_MEM_MALLOC_HUGE_FIRST) == ACL_SUCCESS;
    }
    bool Up(const std::vector<uint8_t>& h)
    {
        return aclrtMemcpy(dev, bytes, h.data(), h.size(), ACL_MEMCPY_HOST_TO_DEVICE) == ACL_SUCCESS;
    }
    bool Down(std::vector<uint8_t>& h) const
    {
        return aclrtMemcpy(h.data(), h.size(), dev, h.size(), ACL_MEMCPY_DEVICE_TO_HOST) == ACL_SUCCESS;
    }
};

struct UMeta {
    std::string mode = "flat";
    uint32_t nTok = 2, nSteps = 1, nReq = 2, tableRows = 0, nSlots = 0;
    std::string tableFile;
    struct Slot { int shard; int local0; int rows; int win; std::string file; };
    std::vector<Slot> slots;
};

bool LoadMeta(const std::string& path, UMeta& m)
{
    std::vector<uint8_t> raw;
    if (!LoadFile(path, raw)) {
        return false;
    }
    std::string s(raw.begin(), raw.end());
    size_t pos = 0;
    while (pos < s.size()) {
        size_t e = s.find('\n', pos);
        if (e == std::string::npos) {
            e = s.size();
        }
        std::string l = s.substr(pos, e - pos);
        pos = e + 1;
        char buf[4096];
        unsigned a = 0, b = 0, c = 0;
        if (sscanf(l.c_str(), "mode %40s", buf) == 1) {
            m.mode = buf;
        } else if (sscanf(l.c_str(), "n_tok %u", &a) == 1) {
            m.nTok = a;
        } else if (sscanf(l.c_str(), "n_steps %u", &a) == 1) {
            m.nSteps = a;
        } else if (sscanf(l.c_str(), "n_req %u", &a) == 1) {
            m.nReq = a;
        } else if (sscanf(l.c_str(), "table_rows %u", &a) == 1) {
            m.tableRows = a;
        } else if (sscanf(l.c_str(), "n_slots %u", &a) == 1) {
            m.nSlots = a;
        } else if (sscanf(l.c_str(), "table_file %4000s", buf) == 1) {
            m.tableFile = buf;
        } else {
            UMeta::Slot sl;
            int sh = 0, l0 = 0, rw = 0, wn = 0;
            if (sscanf(l.c_str(), "slot %*u shard %d local0 %d rows %d win %d file %4000s", &sh, &l0, &rw,
                       &wn, buf) == 5) {
                sl.shard = sh;
                sl.local0 = l0;
                sl.rows = rw;
                sl.win = wn;
                sl.file = buf;
                m.slots.push_back(sl);
            }
        }
    }
    return (m.nTok > 0u) && (m.nSteps > 0u);
}

std::string D(const Ctx& C, const std::string& n) { return C.dataDir + "/" + n; }

// 跑一个 step：① ids → ②③④⑤ body；stD/stoD 由调用方给出并搬运
bool RunStep(Ctx& C, const UMeta& meta, uint32_t step, DevBuf& idsD, DevBuf& qslD, DevBuf& ctxD, DevBuf& mD,
             DevBuf& szD, DevBuf& ofD, DevBuf& wcatD, DevBuf& wtapD, DevBuf& nkD, DevBuf& nqD, DevBuf& ncwD,
             DevBuf& hidD, DevBuf& sidxD, DevBuf& slotShardD, DevBuf& slotLocalD, DevBuf& slotRowsD,
             DevBuf& slotWinD, void* tableDev, uint32_t tableRows, DevBuf& idsOutD, DevBuf& embD, DevBuf& kvD,
             DevBuf& gatD, DevBuf& norD, DevBuf& outD, DevBuf& stD, DevBuf& stoD, DevBuf& failIdsD,
             DevBuf& failBodyD)
{
    using namespace M29P;
    const std::string tag = "s" + std::to_string(step);
    const uint32_t nTok = meta.nTok;

    // ---- ① ----
    m29_ple_ids_kernel<<<C.aic, 0, C.stream>>>(
        reinterpret_cast<uint8_t*>(idsD.dev), reinterpret_cast<uint8_t*>(qslD.dev),
        reinterpret_cast<uint8_t*>(ctxD.dev), reinterpret_cast<uint8_t*>(mD.dev),
        reinterpret_cast<uint8_t*>(szD.dev), reinterpret_cast<uint8_t*>(ofD.dev),
        reinterpret_cast<uint8_t*>(idsOutD.dev), reinterpret_cast<uint8_t*>(failIdsD.dev), nTok, meta.nReq,
        C.mut);
    if (aclrtSynchronizeStream(C.stream) != ACL_SUCCESS) {
        printf("[m29][FAIL] step %u: ids sync (%s)\n", step, aclGetRecentErrMsg());
        C.fails++;
        return false;
    }
    // ---- ②③④⑤ ----
    m29_ple_body_kernel<<<C.aic, 0, C.stream>>>(
        reinterpret_cast<uint8_t*>(idsOutD.dev), reinterpret_cast<uint8_t*>(tableDev), tableRows,
        reinterpret_cast<uint8_t*>(slotShardD.dev), reinterpret_cast<uint8_t*>(slotLocalD.dev),
        reinterpret_cast<uint8_t*>(slotRowsD.dev), reinterpret_cast<uint8_t*>(slotWinD.dev), meta.nSlots,
        reinterpret_cast<uint8_t*>(wcatD.dev), reinterpret_cast<uint8_t*>(wtapD.dev),
        reinterpret_cast<uint8_t*>(nkD.dev), reinterpret_cast<uint8_t*>(nqD.dev),
        reinterpret_cast<uint8_t*>(ncwD.dev), reinterpret_cast<uint8_t*>(hidD.dev),
        reinterpret_cast<uint8_t*>(stD.dev), reinterpret_cast<uint8_t*>(stoD.dev),
        reinterpret_cast<uint8_t*>(sidxD.dev), reinterpret_cast<uint8_t*>(embD.dev),
        reinterpret_cast<uint8_t*>(kvD.dev), reinterpret_cast<uint8_t*>(gatD.dev),
        reinterpret_cast<uint8_t*>(norD.dev), reinterpret_cast<uint8_t*>(outD.dev),
        reinterpret_cast<uint8_t*>(failBodyD.dev), nTok, 15u, C.mut);
    if (aclrtSynchronizeStream(C.stream) != ACL_SUCCESS) {
        printf("[m29][FAIL] step %u: body sync (%s)\n", step, aclGetRecentErrMsg());
        C.fails++;
        return false;
    }
    // ---- dump ----
    std::vector<uint8_t> idsH(static_cast<size_t>(nTok) * NG * 8u, 0u);
    std::vector<uint8_t> embH(static_cast<size_t>(nTok) * HE * 2u, 0u);
    std::vector<uint8_t> kvH(static_cast<size_t>(nTok) * KVW * 2u, 0u);
    std::vector<uint8_t> gatH(static_cast<size_t>(nTok) * HYPER * 2u, 0u);
    std::vector<uint8_t> norH(static_cast<size_t>(nTok) * HYPER * 2u, 0u);
    std::vector<uint8_t> outH(static_cast<size_t>(nTok) * HYPER * 2u, 0u);
    std::vector<uint8_t> stoH(static_cast<size_t>(64) * STLEN * HYPER * 2u, 0u);
    std::vector<uint8_t> f1(FAIL_SLOTS * 4u, 0u), f2(FAIL_SLOTS * 2u * 4u, 0u);
    if (!idsOutD.Down(idsH) || !embD.Down(embH) || !kvD.Down(kvH) || !gatD.Down(gatH) || !norD.Down(norH) ||
        !outD.Down(outH) || !stoD.Down(stoH) || !failIdsD.Down(f1) || !failBodyD.Down(f2)) {
        printf("[m29][FAIL] step %u: D2H\n", step);
        C.fails++;
        return false;
    }
    WriteFile(C.outDir, tag + "_ids.bin", idsH.data(), idsH.size());
    WriteFile(C.outDir, tag + "_emb.bin", embH.data(), embH.size());
    WriteFile(C.outDir, tag + "_kv.bin", kvH.data(), kvH.size());
    WriteFile(C.outDir, tag + "_gated.bin", gatH.data(), gatH.size());
    WriteFile(C.outDir, tag + "_normed.bin", norH.data(), norH.size());
    WriteFile(C.outDir, tag + "_out.bin", outH.data(), outH.size());
    WriteFile(C.outDir, tag + "_state_out.bin", stoH.data(), stoH.size());
    WriteFile(C.outDir, tag + "_fail_ids.bin", f1.data(), f1.size());
    WriteFile(C.outDir, tag + "_fail_body.bin", f2.data(), f2.size());
    // 设备侧 ② 的越窗/词表外计数（每核 [oob,miss]）
    uint32_t oob = 0, miss = 0;
    const uint32_t* fb = reinterpret_cast<const uint32_t*>(f2.data());
    for (uint32_t i = 0; i < 2u * C.aic && i < FAIL_SLOTS; ++i) {
        oob += fb[i * 2 + 0];
        miss += fb[i * 2 + 1];
    }
    char metaTxt[512];
    snprintf(metaTxt, sizeof(metaTxt),
             "step %u\nn_tok %u\nn_req %u\nmode %s\ntable_rows %u\nn_slots %u\ndev_oob %u\ndev_miss %u\n"
             "mut %u\nneg %u\n",
             step, nTok, meta.nReq, meta.mode.c_str(), tableRows, meta.nSlots, oob, miss, C.mut, C.neg);
    WriteFile(C.outDir, tag + "_meta.txt", metaTxt, strlen(metaTxt));
    printf("[m29] step %u: %u tok | dev_oob=%u dev_miss=%u -> %s_*.bin\n", step, nTok, oob, miss, tag.c_str());
    return true;
}

}  // namespace

}  // namespace M29P

int32_t main(int32_t argc, char** argv)
{
    using namespace M29P;
    using namespace M29S;
    Ctx C;
    C.outDir = (getenv("M29_OUT") != nullptr) ? getenv("M29_OUT") : "m29_out";
    C.dataDir = (getenv("M29_DATA") != nullptr) ? getenv("M29_DATA") : "m29_ple_unit/data";
    C.mut = (getenv("M29_MUT") != nullptr) ? static_cast<uint32_t>(strtoul(getenv("M29_MUT"), nullptr, 0)) : 0u;
    if (getenv("M29_NEG_TABLE") != nullptr) {
        C.neg = 1u;
    }
    if (getenv("M29_NEG_STATE") != nullptr) {
        C.neg = 2u;
    }
    (void)argc;
    (void)argv;
    if (aclInit(nullptr) != ACL_SUCCESS) {
        printf("[m29][FAIL] aclInit\n");
        return 2;
    }
    if (aclrtSetDevice(0) != ACL_SUCCESS) {
        printf("[m29][FAIL] aclrtSetDevice\n");
        return 2;
    }
    int64_t aic = 0;
    if (aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aic) != ACL_SUCCESS || aic <= 0) {
        aic = 28;
    }
    C.aic = static_cast<uint32_t>(aic);
    C.aiv = 2u * C.aic;
    if (aclrtCreateStream(&C.stream) != ACL_SUCCESS) {
        printf("[m29][FAIL] aclrtCreateStream\n");
        return 2;
    }
    printf("[m29] M161 PLE 单元 | aic=%u aiv=%u | out=%s data=%s neg=%u mut=%u\n", C.aic, C.aiv,
           C.outDir.c_str(), C.dataDir.c_str(), C.neg, C.mut);

    UMeta meta;
    if (!LoadMeta(D(C, "unit_meta.txt"), meta)) {
        printf("[m29][FAIL] 读不到 unit_meta.txt\n");
        return 2;
    }
    const uint32_t nTok = meta.nTok;
    const uint32_t steps = meta.nSteps;

    // ---- 权重 ----
    std::vector<uint8_t> keyH, valH, tapH, nkH, nqH, ncwH, mH, szH, ofH, st0H;
    if (!LoadFile(D(C, "w_key_proj.bin"), keyH) || !LoadFile(D(C, "w_value_proj.bin"), valH) ||
        !LoadFile(D(C, "w_conv1d_tap.bin"), tapH) || !LoadFile(D(C, "w_norm_key.bin"), nkH) ||
        !LoadFile(D(C, "w_norm_query.bin"), nqH) || !LoadFile(D(C, "w_norm_conv.bin"), ncwH) ||
        !LoadFile(D(C, "m.bin"), mH) || !LoadFile(D(C, "sizes.bin"), szH) ||
        !LoadFile(D(C, "offsets.bin"), ofH) || !LoadFile(D(C, "state_0.bin"), st0H)) {
        printf("[m29][FAIL] 权重/常量装载失败\n");
        return 2;
    }
    std::vector<uint8_t> wcatH(keyH.size() + valH.size());
    memcpy(wcatH.data(), keyH.data(), keyH.size());
    memcpy(wcatH.data() + keyH.size(), valH.data(), valH.size());

    DevBuf wcatD, tapD, nkD, nqD, ncwD, mD, szD, ofD, stD, stoD;
    const size_t stBytes = static_cast<size_t>(64) * STLEN * HYPER * 2u;
    if (!wcatD.Alloc(wcatH.size()) || !tapD.Alloc(tapH.size()) || !nkD.Alloc(nkH.size()) ||
        !nqD.Alloc(nqH.size()) || !ncwD.Alloc(ncwH.size()) || !mD.Alloc(mH.size()) || !szD.Alloc(szH.size()) ||
        !ofD.Alloc(ofH.size()) || !stD.Alloc(stBytes) || !stoD.Alloc(stBytes)) {
        printf("[m29][FAIL] aclrtMalloc(权重)\n");
        return 2;
    }
    {
        std::vector<uint8_t> stFill(stBytes, 0u);
        memcpy(stFill.data(), st0H.data(), std::min(st0H.size(), stBytes));
        if (!wcatD.Up(wcatH) || !tapD.Up(tapH) || !nkD.Up(nkH) || !nqD.Up(nqH) || !ncwD.Up(ncwH) ||
            !mD.Up(mH) || !szD.Up(szH) || !ofD.Up(ofH) || !stD.Up(stFill)) {
            printf("[m29][FAIL] H2D(权重)\n");
            return 2;
        }
    }

    // ---- 表：flat（读文件）或 multi-slot（staging + 一次性注册）----
    void* win = nullptr;
    void* tableDev = nullptr;
    size_t winBytes = 0;
    uint32_t tableRows = 0;
    std::vector<uint8_t> slotShardH, slotLocalH, slotRowsH, slotWinH, tableH;
    {
        if (meta.mode == "flat") {
            if (!LoadFile(D(C, meta.tableFile), tableH)) {
                printf("[m29][FAIL] 读不到 %s\n", meta.tableFile.c_str());
                return 2;
            }
            tableRows = static_cast<uint32_t>(tableH.size() / (HDIM * 2u));
        } else {
            // 每个槽的 slot 文件 = 该槽在窗口里的连续行（host 从真实分片抽出的行段）
            uint32_t acc = 0;
            std::vector<std::vector<uint8_t>> slotBytes(meta.slots.size());
            for (size_t s = 0; s < meta.slots.size(); ++s) {
                if (!LoadFile(D(C, meta.slots[s].file), slotBytes[s])) {
                    printf("[m29][FAIL] 读不到槽文件 %s\n", meta.slots[s].file.c_str());
                    return 2;
                }
                acc += static_cast<uint32_t>(slotBytes[s].size() / (HDIM * 2u));
            }
            tableRows = acc;
            winBytes = static_cast<size_t>(acc) * HDIM * 2u;
            win = ::mmap(nullptr, winBytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
            if (win == MAP_FAILED) {
                printf("[m29][FAIL] mmap(anon)\n");
                return 2;
            }
            uint32_t off = 0;
            for (size_t s = 0; s < meta.slots.size(); ++s) {
                memcpy(reinterpret_cast<char*>(win) + static_cast<size_t>(off) * HDIM * 2u, slotBytes[s].data(),
                       slotBytes[s].size());
                UMeta::Slot& sl = meta.slots[s];
                sl.win = static_cast<int>(off);
                // 负向对照：表基址偏 1 行（设备会取邻行）
                int l0 = sl.local0 + ((C.neg == 1u) ? 1 : 0);
                slotShardH.resize((s + 1) * 4);
                slotLocalH.resize((s + 1) * 4);
                slotRowsH.resize((s + 1) * 4);
                slotWinH.resize((s + 1) * 4);
                *reinterpret_cast<int32_t*>(&slotShardH[s * 4]) = sl.shard;
                *reinterpret_cast<int32_t*>(&slotLocalH[s * 4]) = l0;
                *reinterpret_cast<int32_t*>(&slotRowsH[s * 4]) = sl.rows;
                *reinterpret_cast<int32_t*>(&slotWinH[s * 4]) = sl.win;
                off += static_cast<uint32_t>(slotBytes[s].size() / (HDIM * 2u));
            }
            aclError hrc = aclrtHostRegisterV2(win, winBytes, ACL_HOST_REG_MAPPED);
            aclError grc = (hrc == ACL_SUCCESS) ? aclrtHostGetDevicePointer(win, &tableDev, 0) : (aclError)-1;
            printf("[m29] multi-slot: n_slots=%zu rows=%u win=%zu B | register rc=%d getDevPtr rc=%d win=%p dev=%p\n",
                   meta.slots.size(), tableRows, winBytes, (int)hrc, (int)grc, win, tableDev);
            if (hrc != ACL_SUCCESS || grc != ACL_SUCCESS) {
                printf("[m29][FAIL] host register/getDevPtr\n");
                return 2;
            }
        }
    }

    DevBuf tableD;
    DevBuf slotShardD, slotLocalD, slotRowsD, slotWinD;
    if (meta.mode == "flat") {
        // 多留一行，供负向对照「表基址偏 1 行」时不越界
        std::vector<uint8_t> padH = tableH;
        padH.resize(tableH.size() + HDIM * 2u, 0u);
        if (!tableD.Alloc(padH.size()) || !tableD.Up(padH)) {
            printf("[m29][FAIL] flat table H2D\n");
            return 2;
        }
        tableDev = (C.neg == 1u) ? (static_cast<char*>(tableD.dev) + HDIM * 2u) : tableD.dev;
    } else {
        if (!slotShardD.Alloc(slotShardH.size()) || !slotLocalD.Alloc(slotLocalH.size()) ||
            !slotRowsD.Alloc(slotRowsH.size()) || !slotWinD.Alloc(slotWinH.size()) || !slotShardD.Up(slotShardH) ||
            !slotLocalD.Up(slotLocalH) || !slotRowsD.Up(slotRowsH) || !slotWinD.Up(slotWinH)) {
            printf("[m29][FAIL] slot table H2D\n");
            return 2;
        }
    }

    // ---- 每 step 的输入 ----
    std::vector<DevBuf> idsD(steps), qslD(steps), ctxD(steps), hidD(steps), sidxD(steps);
    std::vector<std::vector<uint8_t>> idsH(steps), qslH(steps), ctxH(steps), hidHH(steps), sidxH(steps);
    bool okAll = true;
    for (uint32_t k = 0; k < steps; ++k) {
        const std::string tg = "s" + std::to_string(k);
        if (!LoadFile(D(C, tg + "_ids.bin"), idsH[k]) || !LoadFile(D(C, tg + "_qsl.bin"), qslH[k]) ||
            !LoadFile(D(C, tg + "_ctx.bin"), ctxH[k]) || !LoadFile(D(C, tg + "_hidden.bin"), hidHH[k]) ||
            !LoadFile(D(C, tg + "_sidx.bin"), sidxH[k])) {
            printf("[m29][FAIL] 读不到 step %u 输入\n", k);
            return 2;
        }
        if (!idsD[k].Alloc(idsH[k].size()) || !qslD[k].Alloc(qslH[k].size()) || !ctxD[k].Alloc(ctxH[k].size()) ||
            !hidD[k].Alloc(hidHH[k].size()) || !sidxD[k].Alloc(sidxH[k].size()) || !idsD[k].Up(idsH[k]) ||
            !qslD[k].Up(qslH[k]) || !ctxD[k].Up(ctxH[k]) || !hidD[k].Up(hidHH[k]) || !sidxD[k].Up(sidxH[k])) {
            printf("[m29][FAIL] step %u 输入 H2D\n", k);
            return 2;
        }
    }

    // ---- 输出缓冲 ----
    DevBuf idsOutD, embD, kvD, gatD, norD, outD, failIdsD, failBodyD;
    const size_t embDevBytes = static_cast<size_t>((nTok < 2u) ? 2u : nTok) * HE * 2u;
    if (!idsOutD.Alloc(static_cast<size_t>(nTok) * NG * 8u) || !embD.Alloc(embDevBytes) ||
        !kvD.Alloc(static_cast<size_t>(nTok) * KVW * 2u) || !gatD.Alloc(static_cast<size_t>(nTok) * HYPER * 2u) ||
        !norD.Alloc(static_cast<size_t>(nTok) * HYPER * 2u) ||
        !outD.Alloc(static_cast<size_t>(nTok) * HYPER * 2u) || !failIdsD.Alloc(FAIL_SLOTS * 4u) ||
        !failBodyD.Alloc(FAIL_SLOTS * 2u * 4u)) {
        printf("[m29][FAIL] aclrtMalloc(输出)\n");
        return 2;
    }
    {
        std::vector<uint8_t> z1(FAIL_SLOTS * 4u, 0u), z2(FAIL_SLOTS * 2u * 4u, 0u);
        failIdsD.Up(z1);
        failBodyD.Up(z2);
    }

    // ---- 逐 step 跑；state_out → state_in 搬运（跨 step 状态，任务 4）----
    for (uint32_t k = 0; k < steps; ++k) {
        if (!RunStep(C, meta, k, idsD[k], qslD[k], ctxD[k], mD, szD, ofD, wcatD, tapD, nkD, nqD, ncwD, hidD[k],
                     sidxD[k], slotShardD, slotLocalD, slotRowsD, slotWinD, tableDev, tableRows, idsOutD, embD,
                     kvD, gatD, norD, outD, stD, stoD, failIdsD, failBodyD)) {
            okAll = false;
            break;
        }
        if (k + 1 < steps) {
            if (C.neg == 2u) {
                printf("[m29] NEG_STATE: 不搬状态（step %u 沿用 step 0 的 state_in）\n", k + 1);
            } else {
                // state_out → state_in（D2D 搬运同一块 64-slot 平面）
                if (aclrtMemcpy(stD.dev, stD.bytes, stoD.dev, stD.bytes, ACL_MEMCPY_DEVICE_TO_DEVICE) !=
                    ACL_SUCCESS) {
                    printf("[m29][FAIL] state carry D2D\n");
                    okAll = false;
                    break;
                }
            }
        }
    }

    if (win != nullptr) {
        aclrtHostUnregister(win);
        ::munmap(win, winBytes);
    }
    printf("[m29] ===== %s =====\n", (okAll && C.fails == 0u) ? "kernel-side OK" : "FAILURES PRESENT");
    aclrtDestroyStream(C.stream);
    aclrtResetDevice(0);
    aclFinalize();
    return (okAll && C.fails == 0u) ? 0 : 1;
}
