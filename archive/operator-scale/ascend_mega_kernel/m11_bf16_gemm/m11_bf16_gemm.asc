/**
 * m11_bf16_gemm.asc —— Mega kernel M11：bf16 GEMM 单 AIC 核（GDN 层 in_proj/out_proj 缺口算件）
 * （设计约束见 docs/05-megakernel-design.md / docs/12-layer-integration.md §8；
 *  流水结构复用 m1_mxfp4_gemm（main 已合并），非 MX 路径参数对齐 asc-devkit
 *  matmul_basic_api_high_performance/mmad.asc 的 3510 分支）
 *
 * 功能：单 AIC 核完成 C(m×N, bf16) = A(m×K, bf16) × B(N×K, bf16)^T，其中
 *   - B 按模型原始权重 layout 以 [N, K] 存放（行主序，每行 K×2 字节），kernel 内按 B^T 消费
 *   - m 为运行时动态值，支持 1..64：M 方向 tile 静态（baseM=64），尾块用 curM mask
 *   - 编译期模板参数 <K, N> 取模型真实形状（两实例）：
 *       in_proj  (K=2560, N=16480)、out_proj (K=6144, N=2560)
 *
 * 数据通路（全部基础 API，无高阶 API / TPipe / TBuf / TQue；与 m1 相同的三级流水）：
 *   GM --DataCopy(Nd2Nz, MTE2)--> L1 --LoadData(LoadData2DParamsV2, MTE1)--> L0A/L0B
 *   L0 --Mmad(M)--> L0C(fp32 累加) --Fixpipe(FIXP, F322BF16)--> GM
 *   （相对 m1 的非 MX 改造：去掉 scale 的 Dn2Nz 搬运与 LoadData2DMxParams/MmadMx，
 *     A/B 均 bf16 直接 Nd2Nz；LoadData/Mmad 换非 MX 重载）
 *
 * M16 latent 加固（code review 点）：本 kernel 不存在任何元素计数 DataCopy 重载
 * （输入 Nd2Nz、输出 Fixpipe，均不走 DataCopyParams）；全部 params 结构体显式零初始化——
 * Nd2NzParams/LoadData2DParamsV2/MmadParams 的所有字段在 CANN 9.1.0 均带 NSDMI 默认值 0，
 * 逐一显式赋值；FixpipeParamsArch3510 仅 reluScalar/vectorRelu/deqScalar 三个成员无默认初始化，
 * 均显式清零，其余字段 NSDMI 为 0/false（params=Nz2NdParams 默认 ndNum=1 即单矩阵语义）。
 *
 * 同步：只用 BufferID（Mutex::Lock/Unlock，编译期静态 ID，共 7 个，与 m1 同编号），L1/L0 双缓冲：
 *   BUF_A0/1、BUF_B0/1 : MTE2 生产 L1 大包 -> MTE1 消费（full/empty 交接）
 *   BUF_L0_0/1          : MTE1 生产 L0 -> M 消费
 *   BUF_L0C             : M 累加完成 -> FIXP 读回写 GM（同时挡住下一 tile 的 Mmad 覆盖 L0C）
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstdint>
#include <cstdlib>

// ============================================================
// 编译期常量：tile 与静态资源表（地址/BufferID 全部编译期静态分配）
// ============================================================

__aicore__ __inline__ constexpr uint32_t CeilDiv(uint32_t a, uint32_t b) { return (a + b - 1) / b; }
__aicore__ __inline__ constexpr uint32_t AlignUp(uint32_t a, uint32_t b) { return CeilDiv(a, b) * b; }
__aicore__ __inline__ constexpr uint32_t MinU32(uint32_t a, uint32_t b) { return a < b ? a : b; }

constexpr uint32_t CUBE_BLOCK = 16;  // cube 分形边长（bf16: 16 元素 = 32B）
constexpr uint32_t BASE_M = 64;      // M 方向 tile（静态）；m ∈ [1, 64] 单 tile，尾块用 curM mask
constexpr uint32_t BASE_K = 64;      // K 方向 tile（K 必须能被 BASE_K 整除）
constexpr uint32_t BASE_N = 160;     // N 方向 tile（N 必须能被 BASE_N 整除）
// BASE_K/BASE_N 取值依据：L0B ping-pong 各 32KB（bf16 2B/元素）→ BASE_K×BASE_N ≤ 16384 元素；
// BASE_N 须为 16 的倍数且同时整除 in_proj N=16480 与 out_proj N=2560（gcd=160）→ 取最大 160。

// ---- L1 静态布局（字节偏移；A 区 [0,256KB)，B 区 [256KB,512KB)，与 m1/donor 一致）----
constexpr uint32_t L1_A_ELEMS = BASE_M * BASE_K;  // 一个 A 大包：64×64 = 4096 元素 = 8KB
constexpr uint32_t L1_B_ELEMS = BASE_N * BASE_K;  // 一个 B 大包：160×64 = 10240 元素 = 20KB
constexpr uint32_t L1_OFF_A0 = 0;
constexpr uint32_t L1_OFF_A1 = L1_OFF_A0 + L1_A_ELEMS * 2;
constexpr uint32_t L1_B_REGION = 256 * 1024;
constexpr uint32_t L1_OFF_B0 = L1_B_REGION;
constexpr uint32_t L1_OFF_B1 = L1_B_REGION + L1_B_ELEMS * 2;
static_assert(L1_B_REGION + 2 * L1_B_ELEMS * 2 <= 512 * 1024, "A/B ping-pong L1 footprint exceeds 512KB");

// ---- L0 静态布局（字节偏移；L0A/L0B 各 64KB，ping/pong 各 32KB）----
constexpr uint32_t L0_PP_BYTES = 32 * 1024;
constexpr uint32_t L0_OFF_0 = 0;
constexpr uint32_t L0_OFF_1 = L0_PP_BYTES;
static_assert(BASE_M * BASE_K * 2 <= L0_PP_BYTES, "A2 tile exceeds L0A half");  // bf16: 64×64 = 8KB
static_assert(BASE_K * BASE_N * 2 <= L0_PP_BYTES, "B2 tile exceeds L0B half");  // bf16: 64×160 = 20KB
// L0C（CO1）：64×160 fp32 = 40KB（≤ 256KB），偏移 0

// ---- BufferID（MutexID 有效范围 0..27，静态分配；单 AIC 核内同步；编号与 m1 一致）----
constexpr AscendC::MutexID BUF_A0 = 0;     // A1 ping: MTE2 -> MTE1
constexpr AscendC::MutexID BUF_A1 = 1;     // A1 pong
constexpr AscendC::MutexID BUF_B0 = 2;     // B1 ping: MTE2 -> MTE1
constexpr AscendC::MutexID BUF_B1 = 3;     // B1 pong
constexpr AscendC::MutexID BUF_L0_0 = 4;   // L0A/L0B ping: MTE1 -> M
constexpr AscendC::MutexID BUF_L0_1 = 5;   // L0A/L0B pong
constexpr AscendC::MutexID BUF_L0C = 6;    // L0C: M -> FIXP

// ============================================================
// Kernel 实现
// ============================================================

template <uint32_t K, uint32_t N>
class Bf16Gemm {
    static_assert(K % BASE_K == 0, "K must be divisible by BASE_K");
    static_assert(N % BASE_N == 0, "N must be divisible by BASE_N");

public:
    __aicore__ inline Bf16Gemm() {}

    __aicore__ inline void Init(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, uint32_t m)
    {
        aGMOri.SetGlobalBuffer((__gm__ bfloat16_t*)a);
        bGMOri.SetGlobalBuffer((__gm__ bfloat16_t*)b);
        cGMOri.SetGlobalBuffer((__gm__ bfloat16_t*)c);
        mTotal = m;
    }

    __aicore__ inline void Process()
    {
        const uint32_t mLoop = CeilDiv(mTotal, BASE_M);  // m ≤ 64 时为 1
        const uint32_t nLoop = N / BASE_N;
        const uint32_t kLoop = K / BASE_K;

        // L1 / L0 / L0C 静态 tensor（position + 字节偏移 + 元素数，自管理地址；
        // 注意 LocalTensor(position, addr, size) 的 addr 单位是字节、size 单位是元素）
        AscendC::LocalTensor<bfloat16_t> a1Ping(AscendC::TPosition::A1, L1_OFF_A0, L1_A_ELEMS);
        AscendC::LocalTensor<bfloat16_t> a1Pong(AscendC::TPosition::A1, L1_OFF_A1, L1_A_ELEMS);
        AscendC::LocalTensor<bfloat16_t> b1Ping(AscendC::TPosition::B1, L1_OFF_B0, L1_B_ELEMS);
        AscendC::LocalTensor<bfloat16_t> b1Pong(AscendC::TPosition::B1, L1_OFF_B1, L1_B_ELEMS);

        AscendC::LocalTensor<bfloat16_t> a2Ping(AscendC::TPosition::A2, L0_OFF_0, BASE_M * BASE_K);
        AscendC::LocalTensor<bfloat16_t> a2Pong(AscendC::TPosition::A2, L0_OFF_1, BASE_M * BASE_K);
        AscendC::LocalTensor<bfloat16_t> b2Ping(AscendC::TPosition::B2, L0_OFF_0, BASE_K * BASE_N);
        AscendC::LocalTensor<bfloat16_t> b2Pong(AscendC::TPosition::B2, L0_OFF_1, BASE_K * BASE_N);

        AscendC::LocalTensor<float> cL0C(AscendC::TPosition::CO1, 0, BASE_M * BASE_N);

        for (uint32_t mBlock = 0; mBlock < mLoop; ++mBlock) {
            const uint32_t curM = MinU32(mTotal - mBlock * BASE_M, BASE_M);  // 尾块 mask（动态 m 的核心处理）
            // 3510 实测（m1 契约）：Nd2Nz 行数为 1 时不做 NZ 切分（退化为 1D 拷贝），导致 m=1 数据错位。
            // 计算侧统一提升为 >=2 行（多读的 1 行由 host 保证可读，结果行不写出），仅在 Fixpipe 用 curM mask。
            const uint32_t calcM = curM < 2 ? 2 : curM;
            const uint32_t calcMAlign = AlignUp(calcM, CUBE_BLOCK);
            for (uint32_t nBlock = 0; nBlock < nLoop; ++nBlock) {
                // M 先取 L0C 所有权：挡住上一 tile 的 Fixpipe 读、允许本 tile 累加
                AscendC::Mutex::Lock<PIPE_M>(BUF_L0C);
                for (uint32_t kBlock = 0; kBlock < kLoop; ++kBlock) {
                    const uint32_t p = kBlock & 1;
                    const AscendC::MutexID bufA = p ? BUF_A1 : BUF_A0;
                    const AscendC::MutexID bufB = p ? BUF_B1 : BUF_B0;
                    const AscendC::MutexID bufL0 = p ? BUF_L0_1 : BUF_L0_0;
                    AscendC::LocalTensor<bfloat16_t> a1 = p ? a1Pong : a1Ping;
                    AscendC::LocalTensor<bfloat16_t> b1 = p ? b1Pong : b1Ping;
                    AscendC::LocalTensor<bfloat16_t> a2 = p ? a2Pong : a2Ping;
                    AscendC::LocalTensor<bfloat16_t> b2 = p ? b2Pong : b2Ping;

                    // ---- MTE2：GM -> L1（Nd2Nz 数据），大包生产 ----
                    AscendC::Mutex::Lock<PIPE_MTE2>(bufA);
                    CopyInA(a1, kBlock, mBlock, calcM);
                    AscendC::Mutex::Unlock<PIPE_MTE2>(bufA);
                    AscendC::Mutex::Lock<PIPE_MTE2>(bufB);
                    CopyInB(b1, kBlock, nBlock);
                    AscendC::Mutex::Unlock<PIPE_MTE2>(bufB);

                    // ---- MTE1：L1 -> L0（LoadData 非 MX），消费 L1、生产 L0 ----
                    AscendC::Mutex::Lock<PIPE_MTE1>(bufL0);   // 等 M 释放 L0 缓冲
                    AscendC::Mutex::Lock<PIPE_MTE1>(bufA);    // 等 MTE2 数据就绪
                    AscendC::Mutex::Lock<PIPE_MTE1>(bufB);
                    LoadA(a1, a2, calcMAlign);
                    LoadB(b1, b2);
                    AscendC::Mutex::Unlock<PIPE_MTE1>(bufA);  // L1 可复用
                    AscendC::Mutex::Unlock<PIPE_MTE1>(bufB);
                    AscendC::Mutex::Unlock<PIPE_MTE1>(bufL0); // L0 数据就绪

                    // ---- M：Mmad 累加（L0C fp32），消费 L0 ----
                    AscendC::Mutex::Lock<PIPE_M>(bufL0);
                    AscendC::MmadParams mmadParams = {};    // 全字段 NSDMI 零初始化（M16 加固）
                    mmadParams.m = calcM;
                    mmadParams.n = BASE_N;
                    mmadParams.k = BASE_K;
                    mmadParams.cmatrixInitVal = (kBlock == 0);
                    AscendC::Mmad(cL0C, a2, b2, mmadParams);
                    AscendC::Mutex::Unlock<PIPE_M>(bufL0);
                }
                // ---- FIXP：L0C -> GM（F322BF16）----
                AscendC::Mutex::Unlock<PIPE_M>(BUF_L0C);      // L0C 累加结果就绪
                AscendC::Mutex::Lock<PIPE_FIX>(BUF_L0C);
                CopyOut(cL0C, mBlock, nBlock, curM, calcMAlign);
                AscendC::Mutex::Unlock<PIPE_FIX>(BUF_L0C);
            }
        }
    }

private:
    // GM -> L1：A 的一个 baseK 大包（calcM 行 × BASE_K bf16），Nd2Nz 落 L1（NZ 布局按满 tile 行距）
    __aicore__ inline void CopyInA(
        AscendC::LocalTensor<bfloat16_t>& a1, uint32_t kBlock, uint32_t mBlock, uint32_t curM)
    {
        AscendC::Nd2NzParams par = {};  // 全字段 NSDMI 零初始化后逐一赋值（M16 加固）
        par.ndNum = 1;
        par.nValue = curM;          // 行数（调用侧传 calcM≥2：3510 行数=1 退化 quirk，契约同 m1）
        par.dValue = BASE_K;        // 每行元素数（bf16 按元素计）
        par.srcNdMatrixStride = 0;
        par.srcDValue = K;
        par.dstNzC0Stride = BASE_M; // L1 NZ 布局按满 tile 行距（与 LoadA 的 srcStride 配套）
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(a1, aGMOri[kBlock * BASE_K + mBlock * K * BASE_M], par);
    }

    // GM -> L1：B 按模型权重原始 layout [N, K] 存放，本次搬 baseN 行 × BASE_K bf16
    __aicore__ inline void CopyInB(AscendC::LocalTensor<bfloat16_t>& b1, uint32_t kBlock, uint32_t nBlock)
    {
        AscendC::Nd2NzParams par = {};
        par.ndNum = 1;
        par.nValue = BASE_N;        // N 编译期整除 BASE_N，无尾块
        par.dValue = BASE_K;
        par.srcNdMatrixStride = 0;
        par.srcDValue = K;
        par.dstNzC0Stride = BASE_N;
        par.dstNzNStride = 1;
        par.dstNzMatrixStride = 0;
        AscendC::DataCopy(b1, bGMOri[kBlock * BASE_K + nBlock * BASE_N * K], par);
    }

    // L1 -> L0：A tile（非 MX 路径）
    __aicore__ inline void LoadA(
        AscendC::LocalTensor<bfloat16_t>& a1, AscendC::LocalTensor<bfloat16_t>& a2, uint32_t calcMAlign)
    {
        AscendC::LoadData2DParamsV2 lp = {};  // 全字段 NSDMI 零初始化后逐一赋值（M16 加固）
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = calcMAlign / CUBE_BLOCK;   // M 轴分形数
        lp.kStep = BASE_K / CUBE_BLOCK;       // K 轴分形数（bf16: 16 元素 = 32B）
        lp.srcStride = BASE_M / CUBE_BLOCK;   // 源 K 方向相邻分形间隔（对应 Nd2Nz dstNzC0Stride=BASE_M）
        lp.dstStride = calcMAlign / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData(a2, a1[0], lp);
    }

    // L1 -> L0：B tile（N 轴 baseN 行，非 MX 路径）
    __aicore__ inline void LoadB(AscendC::LocalTensor<bfloat16_t>& b1, AscendC::LocalTensor<bfloat16_t>& b2)
    {
        AscendC::LoadData2DParamsV2 lp = {};
        lp.mStartPosition = 0;
        lp.kStartPosition = 0;
        lp.mStep = BASE_N / CUBE_BLOCK;       // N 轴分形数
        lp.kStep = BASE_K / CUBE_BLOCK;
        lp.srcStride = BASE_N / CUBE_BLOCK;
        lp.dstStride = BASE_N / CUBE_BLOCK;
        lp.sid = 0;
        lp.ifTranspose = false;
        AscendC::LoadData(b2, b1[0], lp);
    }

    // L0C -> GM：bf16 写回（curM 行 mask，尾块不越界）
    __aicore__ inline void CopyOut(
        AscendC::LocalTensor<float>& cL0C, uint32_t mBlock, uint32_t nBlock, uint32_t curM, uint32_t calcMAlign)
    {
        AscendC::FixpipeParamsArch3510<AscendC::CO2Layout::ROW_MAJOR> fp = {};
        // 该结构体仅 reluScalar/vectorRelu/deqScalar 三个成员无 NSDMI，均显式清零（M16 加固）；
        // 其余字段 NSDMI 为 0/false，params=Nz2NdParams 默认（ndNum=1 即单矩阵语义）。
        fp.nSize = BASE_N;
        fp.mSize = curM;
        fp.srcStride = calcMAlign;
        fp.dstStride = N;
        fp.quantPre = QuantMode_t::F322BF16;
        fp.reluScalar = 0;
        fp.vectorRelu = 0;
        fp.deqScalar = 0;
        AscendC::Fixpipe(cGMOri[mBlock * BASE_M * N + nBlock * BASE_N], cL0C, fp);
    }

private:
    AscendC::GlobalTensor<bfloat16_t> aGMOri;
    AscendC::GlobalTensor<bfloat16_t> bGMOri;
    AscendC::GlobalTensor<bfloat16_t> cGMOri;
    uint32_t mTotal;
};

template <uint32_t K, uint32_t N>
__global__ __cube__ void bf16_gemm_kernel(__gm__ uint8_t* a, __gm__ uint8_t* b, __gm__ uint8_t* c, uint32_t m)
{
    AscendC::InitSocState();
    Bf16Gemm<K, N> op;
    op.Init(a, b, c, m);
    op.Process();
    AscendC::PipeBarrier<PIPE_ALL>();
}

// ============================================================
// Host 侧：确定性随机输入生成 + fp32 参考逐位校验
// ============================================================

// ---- bf16 编解码（RNE，与硬件 F322BF16 同网格；m1 同款，已实证）----
static uint16_t FloatToBf16(float f)
{
    uint32_t x;
    __builtin_memcpy(&x, &f, 4);
    uint32_t roundingBias = ((x >> 16) & 1) + 0x7FFF;
    return (uint16_t)((x + roundingBias) >> 16);
}

static float Bf16ToFloat(uint16_t h)
{
    uint32_t x = ((uint32_t)h) << 16;
    float f;
    __builtin_memcpy(&f, &x, 4);
    return f;
}

// ---- 确定性伪随机（与 m0/m1 的 DataFormula 同风格：纯公式，无 rand 状态）----
static uint32_t Hash3(uint32_t i, uint32_t j, uint32_t salt)
{
    uint32_t h = i * 2654435761u + j * 40503u + salt * 97u + 0x9E3779B9u;
    h ^= h >> 16;
    h *= 2246822519u;
    h ^= h >> 13;
    return h;
}

struct GemmShape {
    const char* name;
    uint32_t k;
    uint32_t n;
};

// 生成 bf16 数据：值域 [-8, 8] 的小整数（bf16 精确表示）。
// 选型理由（数值校验的"精确整数域"）：A/B 元素为 ≤4 位尾数整数 → 乘积 ≤16 位尾数，
// K ≤ 6144 的累加和 |sum| ≤ 6144×64 = 393216 < 2^24，fp32 任意累加次序均精确无舍入，
// 因此硬件 cube 累加次序、host fp32 参考、numpy fp32 参考三者结果逐位一致，
// F322BF16（RNE）后比对 bf16 比特即构成严格逐位校验。
static void GenBf16(uint16_t* bits, uint32_t rows, uint32_t k, uint32_t salt)
{
    for (uint32_t i = 0; i < rows; ++i) {
        for (uint32_t j = 0; j < k; ++j) {
            const int v = (int)(Hash3(i, j, salt) % 17u) - 8;  // [-8, 8]
            bits[(size_t)i * k + j] = FloatToBf16((float)v);
        }
    }
}

// ---- 可选：dump 模式（与 check_ref.py 的 numpy 参考交叉验证用，接口同 m2）----
static bool WriteBin(const char* path, const void* buf, size_t n)
{
    FILE* f = fopen(path, "wb");
    if (f == nullptr) return false;
    const size_t w = fwrite(buf, 1, n, f);
    fclose(f);
    return w == n;
}

// 校验一个 shape × m 组合；返回 true = PASS（device 输出与 fp32 参考 RNE 后逐位一致）
static bool RunCase(aclrtStream stream, const GemmShape& shape, uint32_t m, bool dump)
{
    const uint32_t k = shape.k;
    const uint32_t n = shape.n;
    const uint32_t mAlloc = m < 2 ? 2 : m;  // kernel 对 m=1 提升为 2 行计算（多读 1 行，不写出）
    const size_t aBytes = (size_t)mAlloc * k * 2;
    const size_t bBytes = (size_t)n * k * 2;
    const size_t cBytes = (size_t)m * n * 2;

    uint16_t *aHost = nullptr, *bHost = nullptr, *cHost = nullptr;
    uint8_t *aDev = nullptr, *bDev = nullptr, *cDev = nullptr;
    aclrtMallocHost((void**)&aHost, aBytes);
    aclrtMallocHost((void**)&bHost, bBytes);
    aclrtMallocHost((void**)&cHost, cBytes);
    aclrtMalloc((void**)&aDev, aBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&bDev, bBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc((void**)&cDev, cBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    // 确定性随机输入（A 按 mAlloc 行生成：m=1 时第 2 行被 kernel 多读但不写出，需保证可读且为合法 bf16）
    GenBf16(aHost, mAlloc, k, 11);
    GenBf16(bHost, n, k, 23);
    aclrtMemcpy(aDev, aBytes, aHost, aBytes, ACL_MEMCPY_HOST_TO_DEVICE);
    aclrtMemcpy(bDev, bBytes, bHost, bBytes, ACL_MEMCPY_HOST_TO_DEVICE);

    uint32_t mDev = m;
    if (k == 2560 && n == 16480) {
        bf16_gemm_kernel<2560, 16480><<<1, 0, stream>>>(aDev, bDev, cDev, mDev);
    } else {
        bf16_gemm_kernel<6144, 2560><<<1, 0, stream>>>(aDev, bDev, cDev, mDev);
    }
    const aclError launchErr = aclrtSynchronizeStream(stream);
    if (launchErr != ACL_SUCCESS) {
        printf("[M11][FAIL] %s m=%u kernel launch/sync error %d\n", shape.name, m, (int)launchErr);
        aclrtFree(aDev); aclrtFreeHost(aHost);
        aclrtFree(bDev); aclrtFreeHost(bHost);
        aclrtFree(cDev); aclrtFreeHost(cHost);
        return false;
    }
    aclrtMemcpy(cHost, cBytes, cDev, cBytes, ACL_MEMCPY_DEVICE_TO_HOST);

    if (dump) {  // 供 check_ref.py：a.bin 为 mAlloc 行（kernel 真实输入），c_device.bin 为 m 行输出
        bool ok = WriteBin("a.bin", aHost, aBytes) && WriteBin("b.bin", bHost, bBytes) &&
                  WriteBin("c_device.bin", cHost, cBytes);
        printf("[M11] dump %s m=%u -> %s\n", shape.name, m, ok ? "ok" : "write failed");
    }

    // ---- host 参考：bf16 解为 fp32 后点积（精确整数域，fp32 无舍入，与 numpy fp32 参考同结果），
    //      RNE 到 bf16 网格后与硬件输出比对 bf16 比特（严格逐位，非容差）----
    float* aF32 = new float[(size_t)mAlloc * k];
    float* bF32 = new float[(size_t)n * k];
    for (size_t i = 0; i < (size_t)mAlloc * k; ++i) aF32[i] = Bf16ToFloat(aHost[i]);
    for (size_t i = 0; i < (size_t)n * k; ++i) bF32[i] = Bf16ToFloat(bHost[i]);

    bool pass = true;
    uint32_t failCount = 0;
    for (uint32_t i = 0; i < m && failCount < 5; ++i) {
        for (uint32_t j = 0; j < n; ++j) {
            float acc = 0.0f;
            for (uint32_t kk = 0; kk < k; ++kk) {
                acc += aF32[(size_t)i * k + kk] * bF32[(size_t)j * k + kk];
            }
            const uint16_t expect = FloatToBf16(acc);
            const uint16_t got = cHost[(size_t)i * n + j];
            if (expect != got) {
                printf("[M11][FAIL] %s m=%u C[%u][%u] got 0x%04x (%f) expect 0x%04x (%f)\n",
                    shape.name, m, i, j, got, Bf16ToFloat(got), expect, Bf16ToFloat(expect));
                pass = false;
                if (++failCount >= 5) break;
            }
        }
    }
    printf("[M11] %s m=%-3u K=%u N=%u : %s (bit-exact)\n", shape.name, m, k, n, pass ? "PASS" : "FAIL");

    delete[] aF32;
    delete[] bF32;
    aclrtFree(aDev); aclrtFreeHost(aHost);
    aclrtFree(bDev); aclrtFreeHost(bHost);
    aclrtFree(cDev); aclrtFreeHost(cHost);
    return pass;
}

int32_t main(int32_t argc, char* argv[])
{
    // dump 模式：./m11_bf16_gemm dump <K> <N> <m> 写出 a.bin/b.bin/c_device.bin（check_ref.py 用）
    if (argc >= 5 && argv[1][0] == 'd') {
        const uint32_t k = (uint32_t)atoi(argv[2]);
        const uint32_t n = (uint32_t)atoi(argv[3]);
        const uint32_t m = (uint32_t)atoi(argv[4]);
        const GemmShape shape = {(k == 2560) ? "in_proj" : "out_proj", k, n};
        aclInit(nullptr);
        aclrtSetDevice(0);
        aclrtStream stream = nullptr;
        aclrtCreateStream(&stream);
        const bool ok = RunCase(stream, shape, m, true);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        return ok ? 0 : 1;
    }

    aclInit(nullptr);
    aclrtSetDevice(0);
    aclrtStream stream = nullptr;
    aclrtCreateStream(&stream);

    const GemmShape shapes[] = {
        {"in_proj  (K=2560 N=16480)", 2560, 16480},
        {"out_proj (K=6144 N=2560)", 6144, 2560},
    };
    // 覆盖：m=1（decode + 3510 行数=1 quirk 提升路径）、m=2、非 16 对齐尾块、任务书验收 m=33、满 tile
    const uint32_t ms[] = {1, 2, 17, 33, 64};

    bool allOk = true;
    for (const auto& shape : shapes) {
        for (uint32_t m : ms) {
            allOk &= RunCase(stream, shape, m, false);
        }
    }
    printf("[M11] ===== %s =====\n", allOk ? "ALL PASS" : "FAILURES PRESENT");

    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();
    return allOk ? 0 : 1;
}
