/**
 * probe_host_dma.asc —— M86：AIV kernel 经 MTE2/DataCopy 直接读 host 内存的最小探针
 *
 * 任务书（人类原话）：探索「使用 datacopy 在 AIV kernel 直接读取 host memory」；
 *      ngram 权重在 host 侧，每次用 pcie through 方式使用 MTE2 直接访问 host 读。
 *
 * 本探针要回答的最小问题：
 *   Q1 能力面：CANN 9.1 / Ascend950PR 上有哪些「host 内存映射成 device 地址」的正规 API，
 *              各自返回什么 rc？（mode=caps）
 *   Q2 正向：把 host 内存 register 成 mapped 后拿到 device 指针，AIV kernel 用 DataCopy
 *            （MTE2）能不能逐字节读对？（mode=read，host 侧逐字节校验）
 *   Q3 对照：同形状同大小的 HBM 读、以及空 kernel 各跑一次 → 区分「空跑基线 / 实际搬运」；
 *            记录 host 墙钟与设备 SYS_CNT 周期。（mode=hbm / mode=empty）
 *   Q4 负向对照：
 *      - mode=unreg  ：把**未注册**的 host malloc 指针当 GM 地址喂给 kernel（实测 aclError=507035）
 *      - mode=page   ：注册区比实际分配区小 → 后段读**未注册的 host VA**（实测 507035，首个坏字节
 *                      恰在注册边界）
 *      - mode=align  ：host-mapped device 指针 + 非 32B 偏移（**实测不是故障**：DataCopy 对
 *                      uint8_t 是**字节粒度**的，off=1/32 都逐字节读对；`hbm --off 1` 同样通过
 *                      ⇒ 这不是 host 路径特有，见 README。故 align 只作「偏移被如实应用」的正对照）
 *
 * 判据纪律：每个 mode 一次独立进程；正例做逐字节比对（无容差）；负例记录 aclError / 设备异常原文。
 * 不写「已全部/无残留/0 命中」类绝对断言。
 *
 * 关键实现约束（沿用 m0_bringup / probe_sync_quirks 的实测经验）：
 *   - 标量(GM)写在 kernel 退出时可见性无保证 ⇒ 周期元数据走 UB→MTE3 DMA；
 *   - 同 pipe 背靠背 MTE2 DataCopy 不保序 ⇒ 读循环结束用 MTE2_MTE3 事件排空后再写回；
 *   - UB 地址/长度一律 32B 对齐。
 */

#include "acl/acl.h"
#include "kernel_operator.h"

#include <cstdio>
#include <cstring>
#include <cstdlib>
#include <cstdint>
#include <chrono>
#include <string>
#include <vector>
#include <algorithm>
#include <cerrno>
#include <fcntl.h>
#include <unistd.h>
#include <sys/mman.h>
#include <sys/stat.h>

// ============================================================
// 设备侧 kernel
// ============================================================
namespace {

constexpr uint32_t UB_CYC_OFF = 0;                 // 周期元数据（8 × uint32 = 32B）
constexpr uint32_t UB_DATA_OFF = 32;               // 数据 tile 基址（32B 对齐）

enum HdMode : uint32_t {
    HD_MODE_EMPTY = 0,   // 空 kernel：只落周期标记（空跑基线）
    HD_MODE_READ  = 1,   // 读 repeats 个 tile（MTE2）→ 排空 → 写回（MTE3）
};

class HdProbe {
public:
    __aicore__ inline HdProbe() {}

    __aicore__ inline void Init(GM_ADDR src, GM_ADDR dst, GM_ADDR cyc,
                                uint32_t tileBytes, uint32_t repeats, uint32_t mode)
    {
        srcGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(src));
        dstGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint8_t*>(dst));
        cycGm_.SetGlobalBuffer(reinterpret_cast<__gm__ uint32_t*>(cyc));
        tileBytes_ = tileBytes;
        repeats_ = repeats;
        mode_ = mode;
    }

    __aicore__ inline void Process()
    {
        const uint32_t b = AscendC::GetBlockIdx();
        const int64_t t0 = AscendC::GetSystemCycle();

        if (mode_ == HD_MODE_READ) {
            // ---- MTE2 读循环：从（host-mapped 或 HBM 的）GM 取 repeats 个 tile 到 UB ----
            for (uint32_t r = 0; r < repeats_; ++r) {
                AscendC::LocalTensor<uint8_t> ub(AscendC::TPosition::VECCALC,
                                                 UB_DATA_OFF + r * tileBytes_, tileBytes_);
                AscendC::DataCopy(ub, srcGm_[(b * repeats_ + r) * tileBytes_], tileBytes_);
            }
            // 同 pipe 背靠背 MTE2 不保序 ⇒ 读循环全部发起后用事件排空，再进入写回
            AscendC::SetFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            AscendC::WaitFlag<AscendC::HardEvent::MTE2_MTE3>(EVENT_ID0);
            for (uint32_t r = 0; r < repeats_; ++r) {
                AscendC::LocalTensor<uint8_t> ub(AscendC::TPosition::VECCALC,
                                                 UB_DATA_OFF + r * tileBytes_, tileBytes_);
                AscendC::DataCopy(dstGm_[(b * repeats_ + r) * tileBytes_], ub, tileBytes_);
            }
            AscendC::PipeBarrier<PIPE_MTE3>();
        }

        const int64_t t1 = AscendC::GetSystemCycle();

        // ---- 周期元数据：标量写 UB → S_MTE3 事件 → MTE3 DMA 落 GM ----
        AscendC::LocalTensor<uint32_t> cycUb(AscendC::TPosition::VECCALC, UB_CYC_OFF, 8);
        cycUb.SetValue(0, static_cast<uint32_t>(t0 & 0xFFFFFFFFu));
        cycUb.SetValue(1, static_cast<uint32_t>((static_cast<uint64_t>(t0) >> 32) & 0xFFFFFFFFu));
        cycUb.SetValue(2, static_cast<uint32_t>(t1 & 0xFFFFFFFFu));
        cycUb.SetValue(3, static_cast<uint32_t>((static_cast<uint64_t>(t1) >> 32) & 0xFFFFFFFFu));
        cycUb.SetValue(4, 0xA5A5A5A5u);
        cycUb.SetValue(5, 0xA5A5A5A5u);
        cycUb.SetValue(6, 0xA5A5A5A5u);
        cycUb.SetValue(7, 0xA5A5A5A5u);
        AscendC::SetFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::WaitFlag<AscendC::HardEvent::S_MTE3>(EVENT_ID0);
        AscendC::DataCopy(cycGm_[b * 8], cycUb, 8);
        AscendC::PipeBarrier<PIPE_MTE3>();
    }

private:
    AscendC::GlobalTensor<uint8_t> srcGm_;
    AscendC::GlobalTensor<uint8_t> dstGm_;
    AscendC::GlobalTensor<uint32_t> cycGm_;
    uint32_t tileBytes_ = 0;
    uint32_t repeats_ = 0;
    uint32_t mode_ = HD_MODE_EMPTY;
};

}  // namespace

__vector__ __global__ void hd_kernel(GM_ADDR src, GM_ADDR dst, GM_ADDR cyc,
                                     uint32_t tileBytes, uint32_t repeats, uint32_t mode)
{
    HdProbe probe;
    probe.Init(src, dst, cyc, tileBytes, repeats, mode);
    probe.Process();
}

// ============================================================
// host 侧
// ============================================================
namespace {

constexpr uint32_t CYC_STRIDE = 32;   // 每 block 的周期元数据字节数（8 uint32）

// 输入/期望字节的确定性模型（与 tile/offset 无关，只依赖全局线性字节下标）
inline uint8_t ByteModel(uint64_t i)
{
    return static_cast<uint8_t>((i * 131u + (i >> 7) * 17u + 0x5Au) & 0xFFu);
}

void FillModel(uint8_t* p, size_t n)
{
    for (size_t i = 0; i < n; ++i) p[i] = ByteModel(static_cast<uint64_t>(i));
}

void FillModelWritable(uint8_t* p, size_t n, bool writable)
{
    if (writable) FillModel(p, n);
    else std::printf("[PREP] mapping is read-only -> skip FillModel (file already holds the model)\n");
}

const char* HacName(aclrtHacType t)
{
    switch (t) {
        case ACL_RT_HAC_TYPE_STARS:   return "STARS";
        case ACL_RT_HAC_TYPE_AICPU:   return "AICPU";
        case ACL_RT_HAC_TYPE_AIC:     return "AIC";
        case ACL_RT_HAC_TYPE_AIV:     return "AIV";
        case ACL_RT_HAC_TYPE_PCIEDMA: return "PCIEDMA";
        case ACL_RT_HAC_TYPE_RDMA:    return "RDMA";
        case ACL_RT_HAC_TYPE_SDMA:    return "SDMA";
        case ACL_RT_HAC_TYPE_DVPP:    return "DVPP";
        case ACL_RT_HAC_TYPE_UDMA:    return "UDMA";
        case ACL_RT_HAC_TYPE_CCU:     return "CCU";
        default:                      return "?";
    }
}

struct Cfg {
    std::string mode = "caps";
    uint32_t tileBytes = 8192;   // 每 tile 字节（32B 对齐）
    uint32_t repeats = 8;        // 每 block 的 tile 数
    uint32_t blocks = 0;         // 0 = 用设备核数
    uint32_t launches = 20;      // 计时用的 launch 次数
    uint32_t alignOff = 0;       // mode=align 的源偏移（默认 0；align mode 下若为 0 则取 1）
    std::string path = "/tmp/m86_ngram.bin";   // mode=filemmap 的 backing 文件
    std::string mapmode = "file";              // filemmap: file|anon|malloc
    bool mlock = false;                        // filemmap: 注册前先 mlock(整区)
    bool warmup = true;
};

uint64_t RssKb()
{
    FILE* f = std::fopen("/proc/self/status", "r");
    if (!f) return 0;
    char line[256];
    uint64_t kb = 0;
    while (std::fgets(line, sizeof(line), f)) {
        if (std::strncmp(line, "VmRSS:", 6) == 0) { kb = std::strtoull(line + 6, nullptr, 10); break; }
    }
    std::fclose(f);
    return kb;
}

uint64_t NowNs()
{
    using namespace std::chrono;
    return static_cast<uint64_t>(duration_cast<nanoseconds>(steady_clock::now().time_since_epoch()).count());
}

void PrintPtrAttrs(const char* tag, void* p)
{
    aclrtPtrAttributes attr;
    std::memset(&attr, 0, sizeof(attr));
    aclError rc = aclrtPointerGetAttributes(p, &attr);
    if (rc != ACL_SUCCESS) {
        std::printf("[ATTR] %-18s ptr=%p rc=%d (aclrtPointerGetAttributes failed)\n", tag, p, (int)rc);
        return;
    }
    const char* loc = "?";
    switch (attr.location.type) {
        case ACL_MEM_LOCATION_TYPE_HOST:         loc = "HOST"; break;
        case ACL_MEM_LOCATION_TYPE_DEVICE:       loc = "DEVICE"; break;
        case ACL_MEM_LOCATION_TYPE_UNREGISTERED: loc = "UNREGISTERED"; break;
        case ACL_MEM_LOCATION_TYPE_MANAGED:      loc = "MANAGED"; break;
        case ACL_MEM_LOCATION_TYPE_HOST_NUMA:    loc = "HOST_NUMA"; break;
        default: break;
    }
    std::printf("[ATTR] %-18s ptr=%p rc=0 location.type=%d(%s) id=%d pageSize=%u\n",
                tag, p, (int)attr.location.type, loc, (int)attr.location.id, attr.pageSize);
}

// 运行一次 kernel 计时批次：K 次 launch + 一次同步。返回每 launch 纳秒数（用总时间/K）。
double TimeLaunches(aclrtStream stream, uint8_t* src, uint8_t* dst, uint8_t* cyc,
                    uint32_t tileBytes, uint32_t repeats, uint32_t mode,
                    uint32_t blocks, uint32_t launches, aclError* firstErr)
{
    if (firstErr) *firstErr = ACL_SUCCESS;
    // warmup（第一次 launch 含 module load 等一次性开销）
    hd_kernel<<<blocks, 0, stream>>>(src, dst, cyc, tileBytes, repeats, mode);
    aclError rc = aclrtSynchronizeStream(stream);
    if (rc != ACL_SUCCESS) { if (firstErr) *firstErr = rc; return -1.0; }

    const uint64_t t0 = NowNs();
    for (uint32_t k = 0; k < launches; ++k) {
        hd_kernel<<<blocks, 0, stream>>>(src, dst, cyc, tileBytes, repeats, mode);
    }
    rc = aclrtSynchronizeStream(stream);
    const uint64_t t1 = NowNs();
    if (rc != ACL_SUCCESS) { if (firstErr) *firstErr = rc; return -1.0; }
    return static_cast<double>(t1 - t0) / static_cast<double>(launches);
}

}  // namespace

// ============================================================
// 入口
// ============================================================
int32_t main(int32_t argc, char** argv)
{
    Cfg cfg;
    for (int32_t i = 1; i < argc; ++i) {
        const std::string a = argv[i];
        auto next = [&](uint32_t& out) { if (i + 1 < argc) out = static_cast<uint32_t>(std::strtoul(argv[++i], nullptr, 0)); };
        if (a == "caps" || a == "read" || a == "hbm" || a == "empty" ||
            a == "unreg" || a == "align" || a == "page" || a == "filemmap" || a == "regbench") {
            cfg.mode = a;
        } else if (a == "--tile") { next(cfg.tileBytes); }
        else if (a == "--repeats") { next(cfg.repeats); }
        else if (a == "--blocks") { next(cfg.blocks); }
        else if (a == "--launches") { next(cfg.launches); }
        else if (a == "--off") { next(cfg.alignOff); }
        else if (a == "--path") { if (i + 1 < argc) cfg.path = argv[++i]; }
        else if (a == "--mapmode") { if (i + 1 < argc) cfg.mapmode = argv[++i]; }
        else if (a == "--mlock") { cfg.mlock = true; }
        else {
            std::printf("[USAGE] %s {caps|read|hbm|empty|unreg|align|page|filemmap} "
                        "[--tile B] [--repeats N] [--blocks N] [--launches N] [--off B] [--path P] "
                        "[--mapmode file|anon|malloc] [--mlock]\n", argv[0]);
            return 64;
        }
    }

    std::printf("== probe_host_dma mode=%s tile=%u repeats=%u launches=%u alignOff=%u ==\n",
                cfg.mode.c_str(), cfg.tileBytes, cfg.repeats, cfg.launches, cfg.alignOff);

    aclError rc = aclInit(nullptr);
    std::printf("[INIT] aclInit rc=%d\n", (int)rc);
    rc = aclrtSetDevice(0);
    std::printf("[INIT] aclrtSetDevice(0) rc=%d\n", (int)rc);
    aclrtStream stream = nullptr;
    rc = aclrtCreateStream(&stream);
    std::printf("[INIT] aclrtCreateStream rc=%d\n", (int)rc);

    int64_t aicNum = 0, aivNum = 0;
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_AICORE_CORE_NUM, &aicNum);
    aclrtGetDeviceInfo(0, ACL_DEV_ATTR_VECTOR_CORE_NUM, &aivNum);
    const uint32_t blocks = (cfg.blocks != 0) ? cfg.blocks : static_cast<uint32_t>(aivNum > 0 ? aivNum : 1);
    std::printf("[DEV ] AICORE=%lld VECTOR=%lld -> blocks=%u\n",
                (long long)aicNum, (long long)aivNum, blocks);

    // ---------------- caps：能力面普查（不落 kernel） ----------------
    if (cfg.mode == "caps") {
        const aclrtHacType hacs[] = {
            ACL_RT_HAC_TYPE_STARS, ACL_RT_HAC_TYPE_AICPU, ACL_RT_HAC_TYPE_AIC, ACL_RT_HAC_TYPE_AIV,
            ACL_RT_HAC_TYPE_PCIEDMA, ACL_RT_HAC_TYPE_RDMA, ACL_RT_HAC_TYPE_SDMA,
            ACL_RT_HAC_TYPE_DVPP, ACL_RT_HAC_TYPE_UDMA, ACL_RT_HAC_TYPE_CCU,
        };
        for (aclrtHacType h : hacs) {
            aclrtHostMemMapCapability cap = ACL_RT_HOST_MEM_MAP_NOT_SUPPORTED;
            aclError crc = aclrtHostMemMapCapabilities(0, h, &cap);
            std::printf("[CAPS] aclrtHostMemMapCapabilities(hac=%-8s) rc=%d capability=%d(%s)\n",
                        HacName(h), (int)crc, (int)cap,
                        cap == ACL_RT_HOST_MEM_MAP_SUPPORTED ? "SUPPORTED" : "NOT_SUPPORTED");
        }

        const size_t bytes = 1u << 20;   // 1 MiB
        void* hostPtr = nullptr;
        rc = aclrtMallocHost(&hostPtr, bytes);
        std::printf("[CAPS] aclrtMallocHost(%zu) rc=%d ptr=%p\n", bytes, (int)rc, hostPtr);
        if (rc != ACL_SUCCESS) { std::printf("[CAPS] ABORT: aclrtMallocHost failed\n"); aclrtResetDevice(0); aclFinalize(); return 2; }
        PrintPtrAttrs("mallocHost", hostPtr);

        rc = aclrtHostRegisterV2(hostPtr, bytes, ACL_HOST_REG_MAPPED);
        std::printf("[CAPS] aclrtHostRegisterV2(MAPPED=0x%lx) rc=%d\n", (unsigned long)ACL_HOST_REG_MAPPED, (int)rc);

        void* devPtr = nullptr;
        rc = aclrtHostGetDevicePointer(hostPtr, &devPtr, 0);
        std::printf("[CAPS] aclrtHostGetDevicePointer rc=%d hostPtr=%p devPtr=%p\n", (int)rc, hostPtr, devPtr);
        if (devPtr) PrintPtrAttrs("mappedDev", devPtr);

        // 对照：普通 device 分配
        void* plainDev = nullptr;
        rc = aclrtMalloc(&plainDev, bytes, ACL_MEM_MALLOC_HUGE_FIRST);
        std::printf("[CAPS] aclrtMalloc(%zu) rc=%d ptr=%p\n", bytes, (int)rc, plainDev);
        if (plainDev) PrintPtrAttrs("plainDev", plainDev);

        // 对照：未注册 host 指针
        void* raw = std::malloc(bytes);
        std::printf("[CAPS] std::malloc(%zu) ptr=%p (never registered)\n", bytes, raw);
        PrintPtrAttrs("rawMalloc", raw);

        // 清理
        if (devPtr) { rc = aclrtHostUnregister(hostPtr); std::printf("[CAPS] aclrtHostUnregister rc=%d\n", (int)rc); }
        aclrtFreeHost(hostPtr);
        if (plainDev) aclrtFree(plainDev);
        std::free(raw);
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        std::printf("[CAPS] done\n");
        return 0;
    }

    // ---------------- regbench：注册/注销代价（用于选窗口大小） ----------------
    if (cfg.mode == "regbench") {
        const size_t sizes[] = {4u << 20, 64u << 20, 256u << 20};
        for (size_t sz : sizes) {
            void* p = ::mmap(nullptr, sz, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
            if (p == MAP_FAILED) { std::printf("[REGBENCH] mmap(%zu) failed\n", sz); continue; }
            std::memset(p, 0x5A, sz);
            const uint64_t t0 = NowNs();
            aclError r1 = aclrtHostRegisterV2(p, sz, ACL_HOST_REG_MAPPED);
            const uint64_t t1 = NowNs();
            void* d = nullptr;
            aclError r2 = (r1 == ACL_SUCCESS) ? aclrtHostGetDevicePointer(p, &d, 0) : (aclError)-1;
            const uint64_t t2 = NowNs();
            aclError r3 = (r1 == ACL_SUCCESS) ? aclrtHostUnregister(p) : (aclError)-1;
            const uint64_t t3 = NowNs();
            std::printf("[REGBENCH] size=%6zu MB register rc=%d %.3f ms | getDevPtr rc=%d %.3f ms | unregister rc=%d %.3f ms\n",
                        sz >> 20, (int)r1, (t1 - t0) / 1e6, (int)r2, (t2 - t1) / 1e6, (int)r3, (t3 - t2) / 1e6);
            ::munmap(p, sz);
        }
        aclrtDestroyStream(stream);
        aclrtResetDevice(0);
        aclFinalize();
        std::printf("== done mode=regbench ==\n");
        return 0;
    }

    // ---------------- 其余 mode：先准备内存 ----------------
    if (cfg.mode == "align" && cfg.alignOff == 0) cfg.alignOff = 1;
    // tileBytes 需 32B 对齐；repeats 的 UB 预算 = repeats*tileBytes + 32 ≤ 192KB
    if (cfg.tileBytes % 32 != 0) { std::printf("[PREP] ABORT: tileBytes must be 32B aligned\n"); return 64; }
    if (static_cast<uint64_t>(cfg.repeats) * cfg.tileBytes + UB_DATA_OFF > 192u * 1024u) {
        std::printf("[PREP] ABORT: repeats*tileBytes exceeds UB budget\n"); return 64;
    }

    const size_t regionBytes = static_cast<size_t>(blocks) * cfg.repeats * cfg.tileBytes;
    const size_t cycBytes = static_cast<size_t>(blocks) * CYC_STRIDE;
    std::printf("[PREP] region=%zu bytes (%zu per block) cyc=%zu blocks=%u\n",
                regionBytes, static_cast<size_t>(cfg.repeats) * cfg.tileBytes, cycBytes, blocks);

    // dst（总是真 device 内存）与 cyc
    void* dstDev = nullptr;
    void* cycDev = nullptr;
    aclrtMalloc(&dstDev, regionBytes, ACL_MEM_MALLOC_HUGE_FIRST);
    aclrtMalloc(&cycDev, cycBytes, ACL_MEM_MALLOC_HUGE_FIRST);

    // src 选择
    void* srcForKernel = nullptr;   // 喂给 kernel 的地址
    void* srcOwnedHost = nullptr;   // 需要 HostUnregister 的注册基址
    void* srcAllocBase = nullptr;   // 需要 aclrtFree 的 device 基址（可能被 --off 平移）
    void* mmapBase = nullptr;       // mode=filemmap 的 mmap 基址
    int   mmapFd = -1;
    bool  mmapIsMalloc = false;
    bool  freeHostViaAcl = false;   // srcOwnedHost 是否由 aclrtMallocHost 而来
    bool mustUnregister = false;
    const char* srcKind = "?";

    if (cfg.mode == "read" || cfg.mode == "page") {
        // host 侧分配 + 注册为 mapped + 取 device 指针
        rc = aclrtMallocHost(&srcOwnedHost, regionBytes);
        std::printf("[PREP] aclrtMallocHost(%zu) rc=%d ptr=%p\n", regionBytes, (int)rc, srcOwnedHost);
        if (rc != ACL_SUCCESS) { std::printf("[PREP] ABORT: aclrtMallocHost failed\n"); return 2; }
        freeHostViaAcl = true;
        FillModel(reinterpret_cast<uint8_t*>(srcOwnedHost), regionBytes);

        size_t regBytes = regionBytes;
        const char* regTag = "full";
        if (cfg.mode == "page") {
            // 故意只注册「最后一个 tile 之前」的部分 ⇒ 最后一段是未注册 host VA
            regBytes = regionBytes - cfg.tileBytes;
            regTag = "partial(-1 tile)";
        }
        rc = aclrtHostRegisterV2(srcOwnedHost, regBytes, ACL_HOST_REG_MAPPED);
        std::printf("[PREP] aclrtHostRegisterV2(%zu bytes, %s) rc=%d\n", regBytes, regTag, (int)rc);
        if (rc != ACL_SUCCESS) { std::printf("[PREP] ABORT: HostRegisterV2 failed\n"); return 2; }
        mustUnregister = true;

        void* dev = nullptr;
        rc = aclrtHostGetDevicePointer(srcOwnedHost, &dev, 0);
        std::printf("[PREP] aclrtHostGetDevicePointer rc=%d host=%p dev=%p\n", (int)rc, srcOwnedHost, dev);
        if (rc != ACL_SUCCESS || dev == nullptr) { std::printf("[PREP] ABORT: HostGetDevicePointer failed\n"); return 2; }
        PrintPtrAttrs("srcMappedDev", dev);
        srcForKernel = dev;
        srcKind = "host-mapped(MAPPED)";
    } else if (cfg.mode == "hbm" || cfg.mode == "empty") {
        // 真 device 内存，填充同一模型（用于与 host 读对照）
        // 若带 --off，则源取 dev+off（用于对照 host-mapped 的非对齐读是否同样被接受）
        void* srcHost = nullptr;
        const size_t allocBytes = regionBytes + 4096;
        aclrtMallocHost(&srcHost, allocBytes);
        FillModel(reinterpret_cast<uint8_t*>(srcHost), allocBytes);
        aclrtMalloc(&srcForKernel, allocBytes, ACL_MEM_MALLOC_HUGE_FIRST);
        srcAllocBase = srcForKernel;
        aclrtMemcpy(srcForKernel, allocBytes, srcHost, allocBytes, ACL_MEMCPY_HOST_TO_DEVICE);
        aclrtFreeHost(srcHost);
        PrintPtrAttrs("srcHbmDev", srcForKernel);
        if (cfg.alignOff > 0) {
            srcForKernel = reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(srcForKernel) + cfg.alignOff);
            std::printf("[PREP] hbm source offset by %u -> %p\n", cfg.alignOff, srcForKernel);
        }
        srcKind = "HBM(aclrtMalloc)";
    } else if (cfg.mode == "filemmap") {
        // 【ngram 的真实路径】把一段 host 内存注册成 mapped，再让 AIV 直接读。
        // mapmode 决定这段内存的**来源**，用来回答「哪种 host 内存可注册」：
        //   file  : mmap 一个**文件**（MAP_SHARED）—— 最贴近「权重常驻磁盘、按需页」
        //   anon  : MAP_PRIVATE|MAP_ANONYMOUS —— 匿名页（等价于普通 malloc 的 vm 形态）
        //   malloc: posix_memalign 出来的 glibc 堆页
        const uint64_t rss0 = RssKb();
        int fd = -1;
        void* m = nullptr;
        bool writable = (cfg.mapmode != "filerd" && cfg.mapmode != "filepriv");
        if (cfg.mapmode == "file" || cfg.mapmode == "filerd" || cfg.mapmode == "filepriv") {
            fd = ::open(cfg.path.c_str(), O_RDWR | O_CREAT | O_TRUNC, 0644);
            if (fd < 0) { std::printf("[PREP] ABORT: open(%s) failed: %s\n", cfg.path.c_str(), std::strerror(errno)); return 2; }
            if (::ftruncate(fd, static_cast<off_t>(regionBytes)) != 0) {
                std::printf("[PREP] ABORT: ftruncate failed\n"); ::close(fd); return 2;
            }
            // 先往文件里写模型（用 MAP_SHARED|PROT_WRITE 的临时映射），再按目标模式重新映射
            void* w = ::mmap(nullptr, regionBytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
            if (w == MAP_FAILED) { std::printf("[PREP] ABORT: mmap(file,rw) failed\n"); ::close(fd); return 2; }
            FillModel(reinterpret_cast<uint8_t*>(w), regionBytes);
            ::msync(w, regionBytes, MS_SYNC);
            ::munmap(w, regionBytes);

            if (cfg.mapmode == "file") {
                m = ::mmap(nullptr, regionBytes, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0);
                std::printf("[PREP] mmap(FILE MAP_SHARED PROT_READ|WRITE) ptr=%p pageAligned=%d\n",
                            m, (reinterpret_cast<uintptr_t>(m) % 4096) == 0);
            } else if (cfg.mapmode == "filerd") {
                m = ::mmap(nullptr, regionBytes, PROT_READ, MAP_SHARED, fd, 0);
                std::printf("[PREP] mmap(FILE MAP_SHARED PROT_READ) ptr=%p pageAligned=%d\n",
                            m, (reinterpret_cast<uintptr_t>(m) % 4096) == 0);
            } else {  // filepriv
                m = ::mmap(nullptr, regionBytes, PROT_READ, MAP_PRIVATE, fd, 0);
                std::printf("[PREP] mmap(FILE MAP_PRIVATE PROT_READ) ptr=%p pageAligned=%d\n",
                            m, (reinterpret_cast<uintptr_t>(m) % 4096) == 0);
            }
            if (m == MAP_FAILED) { std::printf("[PREP] ABORT: mmap(file) failed\n"); ::close(fd); return 2; }
        } else if (cfg.mapmode == "anon") {
            m = ::mmap(nullptr, regionBytes, PROT_READ | PROT_WRITE, MAP_PRIVATE | MAP_ANONYMOUS, -1, 0);
            if (m == MAP_FAILED) { std::printf("[PREP] ABORT: mmap(anon) failed\n"); return 2; }
            std::printf("[PREP] mmap(ANON %zu B, MAP_PRIVATE|MAP_ANONYMOUS) ptr=%p pageAligned=%d\n",
                        regionBytes, m, (reinterpret_cast<uintptr_t>(m) % 4096) == 0);
        } else if (cfg.mapmode == "malloc") {
            if (posix_memalign(&m, 4096, regionBytes) != 0 || m == nullptr) {
                std::printf("[PREP] ABORT: posix_memalign failed\n"); return 2;
            }
            std::printf("[PREP] posix_memalign(4096, %zu) ptr=%p pageAligned=%d\n",
                        regionBytes, m, (reinterpret_cast<uintptr_t>(m) % 4096) == 0);
        } else {
            std::printf("[PREP] ABORT: unknown --mapmode %s\n", cfg.mapmode.c_str()); return 64;
        }
        FillModelWritable(reinterpret_cast<uint8_t*>(m), regionBytes, writable);
        if (cfg.mlock) {
            const int mrc = ::mlock(m, regionBytes);
            std::printf("[PREP] mlock(%zu) rc=%d (errno=%d)\n", regionBytes, mrc, mrc == 0 ? 0 : errno);
        }
        // RSS 三点：mmap 前 / touch(填充) 后 register 前 / register 后
        // ⇒ 把「touch 造成的常驻」与「register 造成的常驻（pin）」分开
        const uint64_t rss_pre = RssKb();
        std::printf("[PREP] RSS: before-mmap=%llu kB | after-touch(before-register)=%llu kB | region=%zu B\n",
                    (unsigned long long)rss0, (unsigned long long)rss_pre, regionBytes);

        rc = aclrtHostRegisterV2(m, regionBytes, ACL_HOST_REG_MAPPED);
        std::printf("[PREP] aclrtHostRegisterV2(mapmode=%s region, MAPPED) rc=%d\n", cfg.mapmode.c_str(), (int)rc);
        const uint64_t rss1 = RssKb();
        std::printf("[PREP] RSS: after-register=%llu kB (delta vs after-touch = %lld kB)\n",
                    (unsigned long long)rss1, (long long)rss1 - (long long)rss_pre);
        if (rc != ACL_SUCCESS) {
            std::printf("[PREP] HostRegisterV2 FAILED (rc=%d) for mapmode=%s -> this host-memory type is NOT "
                        "registerable here; probe aborts cleanly.\n", (int)rc, cfg.mapmode.c_str());
            std::printf("== done mode=%s overall=REGISTER-REJECTED ==\n", cfg.mode.c_str());
            if (fd >= 0) ::close(fd);
            ::munmap(m, regionBytes);
            if (cfg.mapmode == "malloc") std::free(m);
            aclrtFree(dstDev); aclrtFree(cycDev);
            aclrtDestroyStream(stream); aclrtResetDevice(0); aclFinalize();
            return 3;
        }
        mustUnregister = true;

        void* dev = nullptr;
        rc = aclrtHostGetDevicePointer(m, &dev, 0);
        std::printf("[PREP] aclrtHostGetDevicePointer rc=%d map=%p dev=%p\n", (int)rc, m, dev);
        if (rc != ACL_SUCCESS || dev == nullptr) { std::printf("[PREP] ABORT: HostGetDevicePointer failed\n"); return 2; }
        srcForKernel = dev;
        srcOwnedHost = m;   // 复用作 HostUnregister 的基址
        mmapBase = m;
        mmapFd = fd;
        mmapIsMalloc = (cfg.mapmode == "malloc");
        srcKind = "host-mapped(MAPPED) of mmap'd FILE/ANON/HEAP";
    } else if (cfg.mode == "unreg") {
        // 未注册的 host 指针（page-aligned 的 std::malloc），直接当 GM 地址
        void* raw = nullptr;
        if (posix_memalign(&raw, 4096, regionBytes) != 0 || raw == nullptr) {
            std::printf("[PREP] ABORT: posix_memalign failed\n"); return 2;
        }
        FillModel(reinterpret_cast<uint8_t*>(raw), regionBytes);
        PrintPtrAttrs("srcUnregistered", raw);
        srcForKernel = raw;
        srcKind = "host-UNREGISTERED(posix_memalign)";
    } else if (cfg.mode == "align") {
        // 注册一个足够大的 host 区，然后把 device 指针 + alignOff 当源
        const size_t allocBytes = regionBytes + 4096;
        rc = aclrtMallocHost(&srcOwnedHost, allocBytes);
        std::printf("[PREP] aclrtMallocHost(%zu) rc=%d ptr=%p\n", allocBytes, (int)rc, srcOwnedHost);
        if (rc != ACL_SUCCESS) { std::printf("[PREP] ABORT: aclrtMallocHost failed\n"); return 2; }
        freeHostViaAcl = true;
        FillModel(reinterpret_cast<uint8_t*>(srcOwnedHost), allocBytes);
        rc = aclrtHostRegisterV2(srcOwnedHost, allocBytes, ACL_HOST_REG_MAPPED);
        std::printf("[PREP] aclrtHostRegisterV2(%zu, MAPPED) rc=%d\n", allocBytes, (int)rc);
        if (rc != ACL_SUCCESS) { std::printf("[PREP] ABORT: HostRegisterV2 failed\n"); return 2; }
        mustUnregister = true;
        void* dev = nullptr;
        rc = aclrtHostGetDevicePointer(srcOwnedHost, &dev, 0);
        std::printf("[PREP] aclrtHostGetDevicePointer rc=%d dev=%p\n", (int)rc, dev);
        if (rc != ACL_SUCCESS || dev == nullptr) { std::printf("[PREP] ABORT: HostGetDevicePointer failed\n"); return 2; }
        srcForKernel = reinterpret_cast<void*>(reinterpret_cast<uintptr_t>(dev) + cfg.alignOff);
        srcKind = "host-mapped + non-32B offset";
        std::printf("[PREP] align offset=%u -> srcForKernel=%p (dev base=%p)\n", cfg.alignOff, srcForKernel, dev);
    }

    std::printf("[PREP] srcKind=%s srcForKernel=%p dst=%p cyc=%p\n", srcKind, srcForKernel, dstDev, cycDev);

    // ---------------- 计时 + 校验 ----------------
    aclError firstErr = ACL_SUCCESS;
    void* srcToUse = srcForKernel;
    if (cfg.mode == "empty") srcToUse = srcForKernel;   // 空 kernel 不用 src，但传一个合法值

    const uint32_t kernelMode = (cfg.mode == "empty") ? HD_MODE_EMPTY : HD_MODE_READ;
    const double perLaunchNs = TimeLaunches(stream, reinterpret_cast<uint8_t*>(srcToUse),
                                            reinterpret_cast<uint8_t*>(dstDev),
                                            reinterpret_cast<uint8_t*>(cycDev),
                                            cfg.tileBytes, cfg.repeats, kernelMode,
                                            blocks, cfg.launches, &firstErr);
    std::printf("[TIME] launches=%u perLaunch=%.1f ns aclError_after_last=%d\n",
                cfg.launches, perLaunchNs, (int)firstErr);

    // ---------------- 异步语义 ----------------
    // (a) 核内：MTE2 的 repeats 个 DataCopy 是**背靠背无中间等待**下发的（读循环），kernel 内只
    //     在进入 MTE3 写回前排空一次 ⇒ 读本身是异步流水。
    // (b) host 侧：launch 之后立刻查 stream 状态，观察是否 NOT_READY（异步发射）。
    {
        hd_kernel<<<blocks, 0, stream>>>(reinterpret_cast<uint8_t*>(srcToUse),
                                         reinterpret_cast<uint8_t*>(dstDev),
                                         reinterpret_cast<uint8_t*>(cycDev),
                                         cfg.tileBytes, cfg.repeats, kernelMode);
        aclrtStreamStatus st = ACL_STREAM_STATUS_COMPLETE;
        aclError qrc = aclrtStreamQuery(stream, &st);
        std::printf("[ASYNC] aclrtStreamQuery immediately after launch: rc=%d status=%d(%s)\n",
                    (int)qrc, (int)st,
                    st == ACL_STREAM_STATUS_NOT_READY ? "NOT_READY" : "COMPLETE");
        aclError src2 = aclrtSynchronizeStream(stream);
        std::printf("[ASYNC] aclrtSynchronizeStream rc=%d (device-side MTE2 read loop is back-to-back, "
                    "no per-tile wait)\n", (int)src2);
    }

    // 拷回
    std::vector<uint8_t> dstHost(regionBytes, 0);
    aclError cpyRc = aclrtMemcpy(dstHost.data(), regionBytes, dstDev, regionBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::printf("[COPY] aclrtMemcpy(D2H result) rc=%d\n", (int)cpyRc);

    std::vector<uint32_t> cycHost(blocks * 8, 0);
    aclError cycRc = aclrtMemcpy(cycHost.data(), cycBytes, cycDev, cycBytes, ACL_MEMCPY_DEVICE_TO_HOST);
    std::printf("[COPY] aclrtMemcpy(D2H cycles) rc=%d\n", (int)cycRc);

    // 逐字节校验（T1，无容差）
    uint64_t mismatches = 0;
    uint64_t firstBad = 0;
    bool haveFirstBad = false;
    if (kernelMode == HD_MODE_READ) {
        for (size_t i = 0; i < regionBytes; ++i) {
            const uint8_t expect = ByteModel(static_cast<uint64_t>(i));
            if (dstHost[i] != expect) {
                if (!haveFirstBad) { firstBad = i; haveFirstBad = true; }
                ++mismatches;
            }
        }
        const uint64_t total = regionBytes;
        std::printf("[VERIFY] bytes=%llu mismatches=%llu firstBadOff=%llu (expect=%u got=%u)\n",
                    (unsigned long long)total, (unsigned long long)mismatches,
                    (unsigned long long)(haveFirstBad ? firstBad : 0),
                    (unsigned)(haveFirstBad ? ByteModel(firstBad) : 0),
                    (unsigned)(haveFirstBad ? dstHost[firstBad] : 0));
        std::printf("[VERIFY] %s\n", mismatches == 0 ? "PASS: all bytes match model" : "FAIL: byte mismatch");

        // mode=align / hbm+off：源被平移了 alignOff 字节 ⇒ 与 Model(i+off) 对拍即为「偏移被如实应用」的正对照
        if (cfg.alignOff > 0) {
            uint64_t shiftedMis = 0, firstShift = 0;
            bool haveShift = false;
            for (size_t i = 0; i + cfg.alignOff < regionBytes; ++i) {
                const uint8_t expect = ByteModel(static_cast<uint64_t>(i + cfg.alignOff));
                if (dstHost[i] != expect) {
                    if (!haveShift) { firstShift = i; haveShift = true; }
                    ++shiftedMis;
                }
            }
            std::printf("[VERIFY-SHIFT] vs Model(i+%u): mismatches=%llu firstBadOff=%llu\n",
                        cfg.alignOff, (unsigned long long)shiftedMis, (unsigned long long)firstShift);
        }
    }

    // 周期统计（跨 block：取所有 block 的 [t0,t1] 并集的跨度）
    uint64_t gmin = ~0ull, gmax = 0;
    uint64_t sumSpan = 0;
    uint32_t validBlocks = 0;
    for (uint32_t b = 0; b < blocks; ++b) {
        const uint64_t lo = static_cast<uint64_t>(cycHost[b * 8 + 0]) | (static_cast<uint64_t>(cycHost[b * 8 + 1]) << 32);
        const uint64_t hi = static_cast<uint64_t>(cycHost[b * 8 + 2]) | (static_cast<uint64_t>(cycHost[b * 8 + 3]) << 32);
        const bool sent = (cycHost[b * 8 + 4] == 0xA5A5A5A5u) && (cycHost[b * 8 + 7] == 0xA5A5A5A5u);
        if (!sent) continue;
        if (hi >= lo) { sumSpan += (hi - lo); ++validBlocks; }
        if (lo < gmin) gmin = lo;
        if (hi > gmax) gmax = hi;
    }
    const uint64_t aggSpan = (validBlocks > 0 && gmax >= gmin) ? (gmax - gmin) : 0;
    std::printf("[CYCLE] validBlocks=%u avgSpanPerBlock=%llu aggSpan(all blocks)=%llu syscnt\n",
                validBlocks, (unsigned long long)(validBlocks ? sumSpan / validBlocks : 0),
                (unsigned long long)aggSpan);

    // 带宽（host 墙钟口径，含 launch+sync 摊销）
    if (kernelMode == HD_MODE_READ && perLaunchNs > 0.0) {
        const double bw = static_cast<double>(regionBytes) / (perLaunchNs * 1e-9) / 1e9;
        std::printf("[BANDWIDTH] host-wall: %.2f GB/s (bytes=%zu perLaunch=%.1f ns)\n",
                    bw, regionBytes, perLaunchNs);
    }

    // 清理
    if (mustUnregister && srcOwnedHost) {
        aclError urc = aclrtHostUnregister(srcOwnedHost);
        std::printf("[CLEAN] aclrtHostUnregister rc=%d\n", (int)urc);
    }
    if (freeHostViaAcl && srcOwnedHost) aclrtFreeHost(srcOwnedHost);
    if (cfg.mode == "unreg" && srcForKernel) std::free(srcForKernel);
    if (srcAllocBase) aclrtFree(srcAllocBase);
    if (mmapBase) {
        if (mmapIsMalloc) std::free(mmapBase);
        else ::munmap(mmapBase, regionBytes);
        if (mmapFd >= 0) ::close(mmapFd);
        std::printf("[CLEAN] mmap/malloc release done\n");
    }
    aclrtFree(dstDev);
    aclrtFree(cycDev);
    aclrtDestroyStream(stream);
    aclrtResetDevice(0);
    aclFinalize();

    const bool ok = (firstErr == ACL_SUCCESS);
    std::printf("== done mode=%s overall=%s ==\n", cfg.mode.c_str(), ok ? "OK" : "DEVICE-ERROR");
    return ok ? 0 : 1;
}
