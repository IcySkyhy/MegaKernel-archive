class BinOpTest(PILTestCase):

    def test_add(self):
        _pil_287 = Expr.int
        _pil_288 = _pil_287(0)
        _pil_289 = Expr.int
        _pil_290 = _pil_289(1)
        _pil_291 = Expr.int
        _pil_292 = _pil_291(2)
        _pil_293 = _pil_290 * _pil_292
        _pil_294 = _pil_288 + _pil_293
        _var_x = _pil_294
        _pil_295 = Expr.int
        _pil_296 = _pil_295(0)
        _pil_297 = Expr.int
        _pil_298 = _pil_297(1)
        _pil_299 = Expr.int
        _pil_300 = _pil_299(2)
        _pil_301 = _pil_298 // _pil_300
        _pil_302 = _pil_296 - _pil_301
        _var_y = _pil_302
        _pil_303 = self.assertEqual
        _pil_304 = Expr.trace
        _pil_306 = ('int', 0)
        _pil_307 = ('int', 1)
        _pil_308 = ('int', 2)
        _pil_309 = ('int', 0)
        _pil_310 = ('int', 1)
        _pil_311 = ('int', 2)
        _pil_305 = [_pil_306, _pil_307, _pil_308, _pil_309, _pil_310, _pil_311]
        _pil_312 = _pil_303(_pil_304, _pil_305)
        _pil_313 = self.assertEqual
        _pil_314 = self.get_var
        _pil_315 = locals()
        _pil_316 = _pil_314(_pil_315)
        _pil_317 = {}
        _pil_318 = _pil_313(_pil_316, _pil_317)

