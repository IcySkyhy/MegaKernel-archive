        _pil_1487 = _pil_1486(var_x)
        _pil_1488 = self.assertEqual
        _pil_1489 = Expr.trace
        _pil_1491 = ('init', 0)
        _pil_1492 = ('int', 2)
        _pil_1493 = ('setattr', 0, 'val', 2)
