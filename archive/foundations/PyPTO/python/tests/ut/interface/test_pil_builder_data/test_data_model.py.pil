from .test_pil_builder_utils import Expr
from .test_pil_builder_utils import PILTestCase

class ConstantTest(PILTestCase):

    def test_const_binop_left(self):
        _pil_0 = Expr.int
        _pil_1 = _pil_0(0)
        _pil_2 = 2 + _pil_1
        var_x = _pil_2
        _pil_3 = Expr.str
        _pil_4 = _pil_3(var_x)
        _pil_5 = self.assertEqual
        _pil_6 = Expr.trace
        _pil_8 = ('int', 0)
        _pil_9 = ('str', 2)
        _pil_7 = [_pil_8, _pil_9]
        _pil_10 = _pil_5(_pil_6, _pil_7)
        _pil_11 = self.assertEqual
        _pil_12 = self.get_var
        _pil_13 = locals()
        _pil_14 = _pil_12(_pil_13)
        _pil_15 = {'var_x': 2}
        _pil_16 = _pil_11(_pil_14, _pil_15)

