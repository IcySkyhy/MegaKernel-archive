        _pil_143 = ('setattr', 0, 'val', 1)
        _pil_144 = ('getattr', 0, 'val')
        _pil_145 = ('str', 1)
        _pil_132 = [_pil_133, _pil_134, _pil_136, _pil_138, _pil_139, _pil_140, _pil_141, _pil_142, _pil_143, _pil_144, _pil_145]
        _pil_146 = _pil_130(_pil_131, _pil_132)
