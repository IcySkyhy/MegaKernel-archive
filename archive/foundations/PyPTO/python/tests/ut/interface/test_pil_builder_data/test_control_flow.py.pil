class ForTest(PILTestCase):

    def test_for_simple_name(self):
        _pil_1 = Expr.int
        _pil_2 = _pil_1(0)
        _pil_3 = Expr.int
        _pil_4 = _pil_3(1)
        _pil_5 = Expr.int
        _pil_6 = _pil_5(2)
        _pil_0 = [_pil_2, _pil_4, _pil_6]
        for _pil_7 in _pil_0:
            var_x = _pil_7
            _pil_8 = Expr.str
            _pil_9 = _pil_8(var_x)
        _pil_10 = self.assertEqual
        _pil_11 = Expr.trace
        _pil_13 = ('int', 0)
        _pil_14 = ('int', 1)
        _pil_15 = ('int', 2)
        _pil_16 = ('str', 0)
        _pil_17 = ('str', 1)
        _pil_18 = ('str', 2)
        _pil_12 = [_pil_13, _pil_14, _pil_15, _pil_16, _pil_17, _pil_18]
        _pil_19 = _pil_10(_pil_11, _pil_12)
        _pil_20 = self.assertEqual
        _pil_21 = self.get_var
        _pil_22 = locals()
        _pil_23 = _pil_21(_pil_22)
        _pil_24 = {'var_x': 2}
        _pil_25 = _pil_20(_pil_23, _pil_24)

