class WhileTest(PILTestCase):

    def test_while_false_no_body(self):
        _pil_417 = Expr.false
        _pil_418 = _pil_417(0)
        while _pil_418:
            _pil_419 = Expr.str
            _pil_420 = _pil_419(1)
            _pil_421 = Expr.false
            _pil_422 = _pil_421(0)
            _pil_418 = _pil_422
        _pil_423 = self.assertEqual
        _pil_424 = Expr.trace
        _pil_426 = ('false', 0)
        _pil_425 = [_pil_426]
        _pil_427 = _pil_423(_pil_424, _pil_425)
        _pil_428 = self.assertEqual
