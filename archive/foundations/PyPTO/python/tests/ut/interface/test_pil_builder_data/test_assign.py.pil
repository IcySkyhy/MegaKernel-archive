    def test_named_expr_while(self):
        _pil_151 = Expr.int
        _pil_152 = _pil_151(0)
        _pil_153 = Expr.int
        _pil_154 = _pil_153(1)
        _pil_155 = Expr.int
        _pil_156 = _pil_155(2)
        _pil_150 = [_pil_152, _pil_154, _pil_156]
        var_items = _pil_150
        _pil_157 = [0]
        var_i = _pil_157
        _pil_158 = var_i[0]
        _pil_159 = len(var_items)
        _pil_160 = _pil_158 < _pil_159
        var_n = _pil_160
        while var_n:
            _pil_161 = Expr.str
            _pil_162 = var_i[0]
            _pil_163 = var_items[_pil_162]
            _pil_164 = _pil_161(_pil_163)
            _pil_165 = var_i[0]
            _pil_166 = _pil_165 + 1
            var_i[0] = _pil_166
            _pil_167 = var_i[0]
            _pil_168 = len(var_items)
            _pil_169 = _pil_167 < _pil_168
            var_n = _pil_169
            var_n = var_n
        _pil_170 = Expr.str
        _pil_171 = _pil_170(var_n)
        _pil_172 = self.assertEqual
        _pil_173 = Expr.trace
        _pil_175 = ('int', 0)
        _pil_176 = ('int', 1)
        _pil_177 = ('int', 2)
        _pil_178 = ('str', 0)
        _pil_179 = ('str', 1)
        _pil_180 = ('str', 2)
        _pil_181 = ('str', False)
        _pil_174 = [_pil_175, _pil_176, _pil_177, _pil_178, _pil_179, _pil_180, _pil_181]
        _pil_182 = _pil_172(_pil_173, _pil_174)
        _pil_183 = self.assertEqual
        _pil_184 = self.get_var
        _pil_185 = locals()
        _pil_186 = _pil_184(_pil_185)
        _pil_187 = [0, 1, 2]
        _pil_188 = [3]
        _pil_189 = {'var_items': _pil_187, 'var_i': _pil_188, 'var_n': False}
        _pil_190 = _pil_183(_pil_186, _pil_189)

