        var_x = _pil_37
        _pil_38 = Expr.str
        _pil_39 = _pil_38(var_x)
        _pil_40 = Expr.str
        _pil_41 = _pil_40(var_a)
        _pil_42 = Expr.str
        _pil_43 = _pil_42(var_b)
        _pil_44 = self.assertEqual
        _pil_45 = Expr.trace
