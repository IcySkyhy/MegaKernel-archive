    def test_named_expr_slice_bound(self):
        _pil_403 = Expr.int
        _pil_404 = _pil_403(0)
        _pil_405 = Expr.int
        _pil_406 = _pil_405(1)
        _pil_407 = Expr.int
        _pil_408 = _pil_407(2)
        _pil_402 = [_pil_404, _pil_406, _pil_408]
        var_l = _pil_402
        _pil_409 = Expr.int
        _pil_410 = _pil_409(1)
        var_lo = _pil_410
        _pil_411 = Expr.int
        _pil_412 = _pil_411(3)
        var_hi = _pil_412
        _pil_413 = var_l[var_lo:var_hi]
        var_s = _pil_413
        _pil_414 = Expr.str
        _pil_415 = var_s[0]
        _pil_416 = _pil_414(_pil_415)
        _pil_417 = Expr.str
        _pil_418 = _pil_417(var_lo)
        _pil_419 = Expr.str
        _pil_420 = _pil_419(var_hi)
        _pil_421 = self.assertEqual
        _pil_422 = Expr.trace
        _pil_424 = ('int', 0)
        _pil_425 = ('int', 1)
