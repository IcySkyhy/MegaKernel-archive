from .test_pil_builder_utils import Expr
from .test_pil_builder_utils import PILTestCase

class ExprTest(PILTestCase):

    def test_expr_binop(self):
        _pil_0 = Expr.int
        _pil_1 = _pil_0(0)
        _pil_2 = Expr.int
        _pil_3 = _pil_2(1)
        _pil_4 = _pil_1 + _pil_3
        _pil_5 = self.assertEqual
        _pil_6 = Expr.trace
        _pil_8 = ('int', 0)
        _pil_9 = ('int', 1)
        _pil_7 = [_pil_8, _pil_9]
        _pil_10 = _pil_5(_pil_6, _pil_7)
        _pil_11 = self.assertEqual
        _pil_12 = self.get_var
        _pil_13 = locals()
        _pil_14 = _pil_12(_pil_13)
        _pil_15 = {}
        _pil_16 = _pil_11(_pil_14, _pil_15)

    def test_expr_named_expr(self):
        _pil_17 = Expr.int
        _pil_18 = _pil_17(0)
        var_a = _pil_18
        _pil_19 = Expr.str
        _pil_20 = _pil_19(var_a)
        _pil_21 = self.assertEqual
        _pil_22 = Expr.trace
        _pil_24 = ('int', 0)
        _pil_25 = ('str', 0)
        _pil_23 = [_pil_24, _pil_25]
        _pil_26 = _pil_21(_pil_22, _pil_23)
        _pil_27 = self.assertEqual
        _pil_28 = self.get_var
        _pil_29 = locals()
        _pil_30 = _pil_28(_pil_29)
        _pil_31 = {'var_a': 0}
        _pil_32 = _pil_27(_pil_30, _pil_31)

class NamedExprTest(PILTestCase):

    def test_named_expr_binop(self):
