from .test_pil_builder_utils import Expr
from .test_pil_builder_utils import PILTestCase

class FunctionDefTest(PILTestCase):

    def test_three_level_nesting(self):

        def outer():

            def middle():

                def inner():
                    _pil_0 = Expr.str
                    _pil_1 = _pil_0(0)
                _pil_2 = inner()
            _pil_3 = middle()
        _pil_4 = outer()
        _pil_5 = self.assertEqual
        _pil_6 = Expr.trace
        _pil_8 = ('str', 0)
        _pil_7 = [_pil_8]
        _pil_9 = _pil_5(_pil_6, _pil_7)
        _pil_10 = self.assertEqual
        _pil_11 = self.get_var
        _pil_12 = locals()
        _pil_13 = _pil_11(_pil_12)
        _pil_14 = {}
        _pil_15 = _pil_10(_pil_13, _pil_14)

    def test_three_level_nesting_with_return_values(self):

        def outer():

            def middle():

                def inner():
                    _pil_16 = Expr.str
                    _pil_17 = _pil_16(0)
                    _pil_18 = Expr.str
                    _pil_19 = _pil_18(1)
                _pil_20 = inner()
                _pil_21 = Expr.str
                _pil_22 = _pil_21(2)
            _pil_23 = middle()
            _pil_24 = Expr.str
            _pil_25 = _pil_24(3)
        _pil_26 = outer()
        _pil_27 = self.assertEqual
        _pil_28 = Expr.trace
        _pil_30 = ('str', 0)
        _pil_31 = ('str', 1)
        _pil_32 = ('str', 2)
        _pil_33 = ('str', 3)
        _pil_29 = [_pil_30, _pil_31, _pil_32, _pil_33]
        _pil_34 = _pil_27(_pil_28, _pil_29)
        _pil_35 = self.assertEqual
        _pil_36 = self.get_var
        _pil_37 = locals()
        _pil_38 = _pil_36(_pil_37)
        _pil_39 = {}
        _pil_40 = _pil_35(_pil_38, _pil_39)

    def test_function_with_decorator(self):
        _pil_41 = Expr(0)
        var_e = _pil_41
        _pil_42 = var_e.decorate
        _pil_43 = _pil_42(1)

        @_pil_43
        def func():
            _pil_44 = Expr.str
            _pil_45 = _pil_44(2)
        _pil_46 = func()
        _pil_47 = self.assertEqual
        _pil_48 = Expr.trace
        _pil_50 = ('init', 0)
        _pil_51 = ('decorate', 1)
        _pil_52 = ('decorate.wrapper', 1)
        _pil_53 = ('str', 2)
        _pil_49 = [_pil_50, _pil_51, _pil_52, _pil_53]
        _pil_54 = _pil_47(_pil_48, _pil_49)
        _pil_55 = self.assertEqual
        _pil_56 = self.get_var
        _pil_57 = locals()
        _pil_58 = _pil_56(_pil_57)
        _pil_59 = {}
        _pil_60 = {}
        _pil_61 = Expr(0, _pil_59, _pil_60)
        _pil_62 = {'var_e': _pil_61}
        _pil_63 = _pil_55(_pil_58, _pil_62)

