            _pil_1299 = Expr.int
            _pil_1300 = _pil_1299(0)
            _pil_1301 = Expr.int
            _pil_1302 = _pil_1301(1)
            _pil_1298 = [_pil_1300, _pil_1302]
            return _pil_1298

        def middle(a, b):
            _pil_1304 = Expr.int
            _pil_1305 = _pil_1304(3)
            _pil_1303 = (a, b, _pil_1305)
            return _pil_1303
        _pil_1306 = inner()
        _pil_1307 = middle(*_pil_1306)
        _pil_1308 = self.assertEqual
        _pil_1309 = Expr.trace
        _pil_1311 = ('int', 0)
        _pil_1312 = ('int', 1)
        _pil_1313 = ('int', 3)
        _pil_1310 = [_pil_1311, _pil_1312, _pil_1313]
        _pil_1314 = _pil_1308(_pil_1309, _pil_1310)
        _pil_1315 = self.assertEqual
        _pil_1316 = self.get_var
        _pil_1317 = locals()
        _pil_1318 = _pil_1316(_pil_1317)
        _pil_1319 = {}
        _pil_1320 = _pil_1315(_pil_1318, _pil_1319)
