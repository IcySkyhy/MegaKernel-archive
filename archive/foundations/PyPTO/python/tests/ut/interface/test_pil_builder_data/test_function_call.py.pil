    def test_three_level_nesting_with_decorator_and_default(self):
        _pil_130 = Expr(0)
        var_e = _pil_130
        _pil_131 = var_e.decorate
        _pil_132 = _pil_131(1)

        @_pil_132
        def outer(x=Expr.int(2)):
            _pil_133 = var_e.decorate
            _pil_134 = _pil_133(3)

            @_pil_134
            def middle(y=Expr.int(4)):

                def inner():
                    _pil_135 = Expr.str
                    _pil_136 = _pil_135(x)
                    _pil_137 = Expr.str
                    _pil_138 = _pil_137(y)
                _pil_139 = inner()
            _pil_140 = middle()
        _pil_141 = outer()
        _pil_142 = self.assertEqual
        _pil_143 = Expr.trace
        _pil_145 = ('init', 0)
        _pil_146 = ('decorate', 1)
        _pil_147 = ('int', 2)
        _pil_148 = ('decorate.wrapper', 1)
        _pil_149 = ('decorate', 3)
        _pil_150 = ('int', 4)
        _pil_151 = ('decorate.wrapper', 3)
        _pil_152 = ('str', 2)
        _pil_153 = ('str', 4)
        _pil_144 = [_pil_145, _pil_146, _pil_147, _pil_148, _pil_149, _pil_150, _pil_151, _pil_152, _pil_153]
        _pil_154 = _pil_142(_pil_143, _pil_144)
        _pil_155 = self.assertEqual
        _pil_156 = self.get_var
        _pil_157 = locals()
        _pil_158 = _pil_156(_pil_157)
        _pil_159 = {}
        _pil_160 = {}
        _pil_161 = Expr(0, _pil_159, _pil_160)
        _pil_162 = {'var_e': _pil_161}
        _pil_163 = _pil_155(_pil_158, _pil_162)

