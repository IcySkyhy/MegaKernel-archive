    def test_lambda_as_argument(self):

        def apply(fn, val):
            _pil_415 = fn(val)
            return _pil_415

        def _pil_418(x):
            _pil_416 = Expr.int
            _pil_417 = _pil_416(x)
            return _pil_417
        _pil_419 = Expr.int
        _pil_420 = _pil_419(0)
        _pil_421 = apply(_pil_418, _pil_420)
        var_r = _pil_421
        _pil_422 = Expr.str
        _pil_423 = _pil_422(var_r)
        _pil_424 = self.assertEqual
        _pil_425 = Expr.trace
        _pil_427 = ('int', 0)
        _pil_428 = ('int', 0)
        _pil_429 = ('str', 0)
