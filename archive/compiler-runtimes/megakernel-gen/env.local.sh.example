# Copy to env.local.sh and edit.  env.sh sources it before applying any default,
# so anything set here wins.  env.local.sh is untracked on purpose: it is the one
# file that knows about your filesystem, and nothing else in the tree does.

# Where everything derived goes: caches, candidate build trees, checkpoints,
# results, slurm logs.  Never the repository, never $HOME -- on a cluster $HOME
# is usually quota-limited and read-only from the compute nodes.
export MKGEN_WORK="$SCRATCH/mkgen"

# Checkpoints.  MKGEN_MODEL_120B is separate only because gpt-oss-120b is often
# staged somewhere else; it defaults to $MKGEN_MODELS/gpt-oss-120b.
export MKGEN_MODELS="$MKGEN_WORK/models"
#export MKGEN_MODEL_120B="$MKGEN_MODELS/gpt-oss-120b"

# The interpreter with torch + transformers (and, for the baselines, vllm and
# sglang).  Defaults to $MKGEN_WORK/venv/bin/python.
export MKGEN_PY="$MKGEN_WORK/venv/bin/python"

# Slurm accounting string, if your cluster needs one.  Exported as
# SBATCH_ACCOUNT, which sbatch reads natively, so no batch script hardcodes it.
#export MKGEN_ACCOUNT=

# Only if your toolchain is not in the usual place.
#export CARGO_HOME="$MKGEN_WORK/cargo"
#export RUSTUP_HOME="$MKGEN_WORK/rustup"
#export CUDA_HOME=/usr/local/cuda

# The baseline engines, each in its own environment (they pin conflicting torch
# versions).  Only needed to reproduce the head-to-head table.
#export MKGEN_VLLM_PY="$MKGEN_WORK/venv-vllm/bin/python"
#export MKGEN_SGLANG_PY="$MKGEN_WORK/venv-sgl/bin/python"
